static func has_mesh_for(sub_template: String) -> bool:
	return sub_template in SUPPORTED

## True if the hand-built mesh for [sub_template] draws its own face
## (eyes / mouth / etc.). The dispatcher uses this to SKIP the procedural
## PartBuilders.build_face pass — otherwise a second set of eyes lands on
## top of the hand-built ones, causing visible duplication (the user-reported
## "satyr eyes floating above the head" bug was the procedural eyes landing
## at the wrong head_anchor while my hand-built ones were on the cranium).
##
## Wolf used to opt OUT and leave face rendering to PartBuilders, but the
## procedural head_anchor doesn't track the wolf's hand-built cranium
## perfectly — especially once per-individual body_size_jitter is applied.
## The user reported eyes "not lining up" on most wolves. Wolf now draws
## its own eyes (anchored to the actual cranium dimensions) like every
## other hand-built creature.
static func draws_own_face(sub_template: String) -> bool:
	return sub_template in SUPPORTED

## True if the hand-built mesh for [sub_template] draws its own ornaments
## (tail / wings / flowers / horns / etc.). The dispatcher uses this to SKIP
## the procedural PartBuilders.build_ornament pass — otherwise the procedural
## ornament builders pile a SECOND tail on the pig (cylinder on top of my
## curly tail), 3-5 huge pink "flower" spheres on the pixie (from the Fey
## template's flowering_accents tag), and a CapsuleMesh "extra cylinder"
## tail on the wolf (next to my hand-built bushy tail — user spotted that
## the wolf had a stray cylinder protruding from the hip).
##
## All hand-built creatures including wolf now own their full silhouette.
static func draws_own_ornaments(sub_template: String) -> bool:
	return sub_template in SUPPORTED

static func build_for(sub_template: String, plan: Dictionary, root: Node3D) -> void:
	match sub_template:
		"wolf_like": _build_wolf(plan, root)
		"bear_like": _build_bear(plan, root)
		"small_humanoid": _build_goblin(plan, root)
		"adult_dragon", "young_dragon", "ancient_dragon", "wyrmling", "wyvern":
			_build_dragon(plan, root)
		"insect_like": _build_spider(plan, root)
		"dinosaur_like": _build_dinosaur(plan, root)
		"serpent_like", "serpent_humanoid": _build_snake(plan, root)
		"brute_humanoid": _build_brute_humanoid(plan, root)
		"warrior_humanoid": _build_warrior(plan, root)
		"caster_humanoid": _build_caster(plan, root)
