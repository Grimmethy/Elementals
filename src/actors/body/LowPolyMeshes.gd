		"bird_like", "bird_like_humanoid": _build_bird(plan, root)
		"skeleton": _build_skeleton(plan, root)
		"zombie": _build_zombie(plan, root)
		"floating_eye": _build_beholder(plan, root)
		"wraith_floating", "tiny_floating": _build_wraith(plan, root)
		"elemental_humanoid": _build_elemental(plan, root)
		"swine_like": _build_swine(plan, root)
		"tiny_fey": _build_pixie(plan, root)
		"small_animal", "small_quadruped": _build_small_animal(plan, root)
		"lizard_like": _build_crocodile(plan, root)
		"treant": _build_treant(plan, root)
		"aboleth": _build_aboleth(plan, root)
		"abominable_yeti": _build_abominable_yeti(plan, root)
		"adult_oblex": _build_adult_oblex(plan, root)
		"air_elemental": _build_air_elemental(plan, root)
		"air_elemental_myrmidon": _build_air_myrmidon(plan, root)
