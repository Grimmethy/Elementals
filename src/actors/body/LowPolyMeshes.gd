# ============================================================================
# Wolf — lean elongated quadruped with pointed muzzle and bushy tail
# ============================================================================
##
## Anatomy proportions (from real wolves):
##   body length ≈ 2 × body height
##   head ≈ 0.4 × body length, tapered to a point
##   legs lean and proportional to body height
##   tail ≈ 0.35 × body length, drooping
##   ears triangular, ~0.5 × head height
##
## Color regions:
##   primary: main coat (grey for wolf, tawny for lion via Lion's modifiers)
##   secondary: darker shadow (back / muzzle top)
##   accent: belly + inner ear

static func _build_wolf(plan: Dictionary, root: Node3D) -> void:
	var base: Dictionary = plan.get("base", {})
	var palette: Dictionary = plan.get("palette", {})
	var limbs: Dictionary = plan.get("limbs", {})

	var w: float = _axis(base, "width", 0.55)
	var h: float = _axis(base, "height", 0.45)
	var d: float = _axis(base, "depth", 1.30)
	var leg_length: float = float(limbs.get("leg_length", 0.40))
	var clearance: float = leg_length

	# PER-INDIVIDUAL VARIATION — deterministic per render_seed. Each wolf gets
	# different body proportions and a different fur tint so populations look
	# like a real pack, not a herd of clones.
	var meta: Dictionary = plan.get("meta", {})
	var species: String = String(meta.get("species", "Wolf"))
	var render_seed: int = int(meta.get("render_seed", 0))
	var rng := RandomNumberGenerator.new()
	rng.seed = render_seed if render_seed != 0 else hash(species)
	# Body proportion jitter — applied via uniform multiplier on w/h/d.
	var body_size_jitter: float = rng.randf_range(0.85, 1.20)
	var leg_len_jitter: float = rng.randf_range(0.80, 1.25)
	var ear_size_jitter: float = rng.randf_range(0.75, 1.35)   # used below
	# Apply size jitter to base dimensions BEFORE rings are built.
	w *= body_size_jitter
	h *= body_size_jitter
	d *= body_size_jitter
	leg_length *= leg_len_jitter
	clearance = leg_length

	# FUR COLOR VARIETY — real wolves: gray, black, white (arctic), tawny
	# (timber), reddish-brown, dark chocolate. Pull from a curated palette
	# rather than the BeastData-fixed primary.
	var wolf_color_options := [
		Color(0.45, 0.42, 0.40),   # classic gray
		Color(0.30, 0.28, 0.26),   # dark gray
		Color(0.18, 0.15, 0.13),   # near-black timber
		Color(0.88, 0.82, 0.74),   # arctic white
		Color(0.62, 0.50, 0.36),   # tawny / brown
		Color(0.50, 0.38, 0.28),   # reddish brown
		Color(0.38, 0.32, 0.24),   # chocolate
		Color(0.72, 0.65, 0.55),   # silver
	]
	# Species-name biased picks (Arctic Wolf → white, Timber → dark, etc.)
	var species_lower: String = species.to_lower()
	var color_idx: int
	if "arctic" in species_lower or "snow" in species_lower or "polar" in species_lower:
		color_idx = 3
	elif "timber" in species_lower or "dire" in species_lower:
		color_idx = rng.randi_range(1, 2)
	elif "fox" in species_lower:
		color_idx = rng.randi_range(4, 5)
	else:
		color_idx = rng.randi() % wolf_color_options.size()
	var primary: Color = wolf_color_options[color_idx]
	var belly: Color = palette.get("secondary", primary.lightened(0.25))
	var dark: Color = primary.darkened(0.30)
	var muzzle_dark: Color = primary.darkened(0.45)
	var paw_dark: Color = primary.darkened(0.35)

	# ============================================================================
	# BODY TRUNK — 4 cross-sections along the body length for proper curvature
	# ============================================================================
	# Each cross-section is a 6-vertex hexagon (3 top + 3 bottom for rounded look)
	# 4 sections × 6 verts = 24 trunk vertices total.
	# This gives the body real volume curvature instead of one flat-sided box.

	# ----- 5 cross-section rings along the body — gives proper wolf bulk -----
	# Z positions: front chest swell → shoulders → mid-back (dip) → hip rise → rear taper
	var ring_z := [d * 0.46, d * 0.30, d * 0.05, -d * 0.18, -d * 0.42]
	# Half-width at each ring — CHEST WIDE (wolf has broad chest), shoulders wide,
	# slight narrowing mid, hips slightly narrower, rear narrows for taper.
	var ring_w := [w * 0.52, w * 0.58, w * 0.52, w * 0.50, w * 0.40]
	# Top-of-back: WOLVES have pronounced shoulder hump, then back slopes down to hips.
	var ring_top := [
		clearance + h * 0.85,   # chest top (slightly lower than shoulder)
		clearance + h * 1.00,   # SHOULDER HUMP (highest point)
		clearance + h * 0.88,   # mid-back (slight dip behind shoulders)
		clearance + h * 0.82,   # hip rise
		clearance + h * 0.68,   # rear taper toward tail
	]
	# Belly y — body has chest mass and tucks slightly at the rear.
	var ring_bot := [
		clearance + h * 0.25,   # chest bottom (lower for chest mass)
		clearance + h * 0.20,
		clearance + h * 0.14,   # belly tucks
		clearance + h * 0.16,
		clearance + h * 0.22,   # haunches
	]
	# Side-bulge — chest swells, mid-body is barrel-shaped, hips are muscular.
	var ring_bulge := [1.10, 1.15, 1.00, 1.05, 0.85]

	# Build trunk rings — each is now an 8-vertex octagon for more rounded volume.
	var rings: Array = []
	for i in range(ring_z.size()):
		var rw: float = ring_w[i] * ring_bulge[i]
		var top_y: float = ring_top[i]
		var bot_y: float = ring_bot[i]
		var height_span: float = top_y - bot_y
		var z: float = ring_z[i]
		# 8 vertices around the ring at 45° intervals: 0=top, 1=upper-right, 2=right,
		# 3=lower-right, 4=bottom, 5=lower-left, 6=left, 7=upper-left
		var v: Array = [
			Vector3(0, top_y, z),                                                       # 0 top
			Vector3(rw * 0.71, top_y - height_span * 0.15, z),                          # 1 upper-right
			Vector3(rw, bot_y + height_span * 0.50, z),                                 # 2 right (widest)
			Vector3(rw * 0.71, bot_y + height_span * 0.15, z),                          # 3 lower-right
			Vector3(0, bot_y, z),                                                       # 4 bottom
			Vector3(-rw * 0.71, bot_y + height_span * 0.15, z),                         # 5 lower-left
			Vector3(-rw, bot_y + height_span * 0.50, z),                                # 6 left (widest)
			Vector3(-rw * 0.71, top_y - height_span * 0.15, z),                         # 7 upper-left
		]
		rings.append(v)

	# ----- Body main surface (back + sides) -----
	var st_body := SurfaceTool.new()
	st_body.begin(Mesh.PRIMITIVE_TRIANGLES)
	# Connect each pair of adjacent rings. Upper segments (back + flanks) only;
	# lower segments (belly) get the secondary color in a separate mesh below.
	for r in range(rings.size() - 1):
		var rA: Array = rings[r]
		var rB: Array = rings[r + 1]
		# Upper 5 segments: 0→1, 1→2, 2→3 (right flank top to widest to lower)
		# and 7→0, 6→7, 5→6 (left flank)
		for k in [0, 1, 2, 5, 6, 7]:
			_add_quad(st_body, rA[k], rA[(k + 1) % 8], rB[(k + 1) % 8], rB[k])

	# Cap the rear with a triangle fan (closing the body behind).
	var last: Array = rings[rings.size() - 1]
	var center_back := Vector3(0, (last[0].y + last[4].y) * 0.5, last[0].z - 0.03)
	for k in range(8):
		_add_tri(st_body, last[k], last[(k + 1) % 8], center_back)

	# ============================================================================
	# HEAD — wider, bulkier cranium + robust muzzle for proper WOLF mass
	# ============================================================================
	# Key wolf vs fox differences:
	#   wolf head is WIDER and HEAVIER relative to body
	#   muzzle is SHORTER and THICKER (no dainty fox snout)
	#   cranium has prominent brow ridges and cheek/jaw bulges

	# Cranium (back of head) — wider, taller, more massive.
	var cran_back_z: float = d * 0.52                # forward of chest ring (0.46)
	var cran_front_z: float = d * 0.74               # longer cranium
	var cran_w: float = w * 0.40                     # wider (was 0.32)
	var cran_top_y: float = clearance + h * 1.02     # taller head
	var cran_bot_y: float = clearance + h * 0.45
	# 8 corners of cranium
	var cBTL := Vector3(-cran_w, cran_top_y, cran_back_z)
	var cBTR := Vector3( cran_w, cran_top_y, cran_back_z)
	var cBBL := Vector3(-cran_w, cran_bot_y, cran_back_z)
	var cBBR := Vector3( cran_w, cran_bot_y, cran_back_z)
	var cFTL := Vector3(-cran_w * 0.88, cran_top_y - h * 0.05, cran_front_z)
	var cFTR := Vector3( cran_w * 0.88, cran_top_y - h * 0.05, cran_front_z)
	var cFBL := Vector3(-cran_w * 0.88, cran_bot_y + h * 0.05, cran_front_z)
	var cFBR := Vector3( cran_w * 0.88, cran_bot_y + h * 0.05, cran_front_z)

	# Cranium top + sides (NOT bottom — jaw separate)
	_add_quad(st_body, cBTL, cBTR, cFTR, cFTL)        # top of skull
	_add_quad(st_body, cBTL, cFTL, cFBL, cBBL)        # left side of skull
	_add_quad(st_body, cFTR, cBTR, cBBR, cFBR)        # right side of skull

	# BROW RIDGE — small raised wedge over the eye line, gives wolf its severe look.
	var brow_back_z: float = cran_back_z + (cran_front_z - cran_back_z) * 0.55
	var brow_front_z: float = cran_front_z - 0.01
	var brow_y: float = cran_top_y - h * 0.10
	var brow_top_y: float = cran_top_y + h * 0.06     # protrudes above cranium top
	for side in [-1, 1]:
		var bx_inner: float = cran_w * 0.10 * side
		var bx_outer: float = cran_w * 0.85 * side
		var brBL := Vector3(bx_inner, brow_y, brow_back_z)
		var brBR := Vector3(bx_outer, brow_y, brow_back_z)
		var brFL := Vector3(bx_inner, brow_y, brow_front_z)
		var brFR := Vector3(bx_outer, brow_y, brow_front_z)
		var brTB := Vector3((bx_inner + bx_outer) * 0.5, brow_top_y, brow_back_z + (brow_front_z - brow_back_z) * 0.3)
		var brTF := Vector3((bx_inner + bx_outer) * 0.5, brow_top_y, brow_back_z + (brow_front_z - brow_back_z) * 0.7)
		# Two triangles forming a small wedge ridge above the eyes
		_add_tri(st_body, brBL, brBR, brTB)
		_add_tri(st_body, brTB, brBR, brTF)
		_add_tri(st_body, brTF, brBR, brFR)
		_add_tri(st_body, brTF, brFR, brFL)
		_add_tri(st_body, brTB, brTF, brFL)
		_add_tri(st_body, brBL, brTB, brFL)

	# CHEEK BULGES — small spheres-ish on sides of cranium (jaw muscle mass).
	for side in [-1, 1]:
		var cheek_z: float = cran_back_z + (cran_front_z - cran_back_z) * 0.65
		var cheek_y: float = cran_bot_y + h * 0.10
		var cheek_w: float = cran_w * 1.12               # bulges out past cranium
		var ck_back: float = cheek_z - 0.05
		var ck_front: float = cheek_z + 0.05
		var ckBL := Vector3(side * cran_w * 0.95, cheek_y + 0.05, ck_back)
		var ckBR := Vector3(side * cheek_w, cheek_y, ck_back)
		var ckFL := Vector3(side * cran_w * 0.95, cheek_y + 0.05, ck_front)
		var ckFR := Vector3(side * cheek_w, cheek_y, ck_front)
		var ckBot := Vector3(side * cran_w * 0.85, cheek_y - 0.06, cheek_z)
		# Outer face of cheek
		_add_tri(st_body, ckBL, ckBR, ckFR)
		_add_tri(st_body, ckBL, ckFR, ckFL)
		# Bottom slope back into jaw
		_add_tri(st_body, ckBR, ckBot, ckFR)

	# Muzzle — shorter, wider, more robust (wolf snout, not fox snout).
	var muzz_back_z: float = cran_front_z
	var muzz_tip_z: float = d * 0.95
	var muzz_back_top_y: float = cran_top_y - h * 0.22
	var muzz_back_bot_y: float = cran_bot_y + h * 0.08
	var muzz_back_w: float = cran_w * 0.80           # was 0.70 — meatier connection
	var muzz_tip_top_y: float = muzz_back_top_y - h * 0.12
	var muzz_tip_bot_y: float = muzz_back_bot_y + h * 0.04
	var muzz_tip_w: float = w * 0.16                 # was 0.09 — wider tip, less delicate

	var mBTL := Vector3(-muzz_back_w, muzz_back_top_y, muzz_back_z)
	var mBTR := Vector3( muzz_back_w, muzz_back_top_y, muzz_back_z)
	var mBBL := Vector3(-muzz_back_w, muzz_back_bot_y, muzz_back_z)
	var mBBR := Vector3( muzz_back_w, muzz_back_bot_y, muzz_back_z)
	var mFTL := Vector3(-muzz_tip_w, muzz_tip_top_y, muzz_tip_z)
	var mFTR := Vector3( muzz_tip_w, muzz_tip_top_y, muzz_tip_z)
	var mFBL := Vector3(-muzz_tip_w, muzz_tip_bot_y, muzz_tip_z)
	var mFBR := Vector3( muzz_tip_w, muzz_tip_bot_y, muzz_tip_z)

	_add_quad(st_body, mBTL, mBTR, mFTR, mFTL)        # muzzle top
	_add_quad(st_body, mBTL, mFTL, mFBL, mBBL)        # muzzle left
	_add_quad(st_body, mFTR, mBTR, mBBR, mFBR)        # muzzle right
	# (muzzle bottom is drawn as the belly piece below — keeps the
	# underside lighter-colored matching wolf coat)

	# Cranium-to-muzzle connection.
	_add_quad(st_body, cFTL, cFTR, mBTR, mBTL)        # top
	_add_quad(st_body, cFTL, mBTL, mBBL, cFBL)        # left
	_add_quad(st_body, cFTR, cFBR, mBBR, mBTR)        # right

	# ----- NECK — thick, seamless connection from chest to cranium back -----
	# Wolves have minimal neck distinction — thick muscular junction.
	# Chest ring is rings[0] with 8 vertices (0=top, 1=UR, 2=R, 3=LR, 4=B, 5=LL, 6=L, 7=UL).
	var front_ring: Array = rings[0]
	# Neck top — chest top edge to cranium back top edge
	_add_quad(st_body, front_ring[0], front_ring[1], cBTR, cBTL)  # chest top edge → cranium top edge
	_add_tri(st_body, front_ring[7], front_ring[0], cBTL)          # upper-left vertex → cranium top-left
	# Neck right side — upper-right + right flank to cranium back-right
	_add_quad(st_body, front_ring[1], front_ring[2], cBBR, cBTR)
	# Neck left side — left flank + upper-left to cranium back-left
	_add_quad(st_body, cBTL, cBBL, front_ring[6], front_ring[7])

	st_body.generate_normals()
	var body_mesh: ArrayMesh = st_body.commit()
	var mi_body := MeshInstance3D.new()
	mi_body.mesh = body_mesh
	var mat_body := StandardMaterial3D.new()
	mat_body.albedo_color = primary
	mat_body.roughness = 0.90
	mat_body.cull_mode = BaseMaterial3D.CULL_DISABLED
	mi_body.material_override = mat_body
	root.add_child(mi_body)

	# ============================================================================
	# BELLY — lighter underside, ring-segment lower halves (8-vertex layout)
	# ============================================================================
	# In the new 8-vertex layout: 3=lower-right, 4=bottom-center, 5=lower-left.
	# Belly spans segments 3→4 (lower-right to bottom) and 4→5 (bottom to lower-left).
	var st_belly := SurfaceTool.new()
	st_belly.begin(Mesh.PRIMITIVE_TRIANGLES)
	for r in range(rings.size() - 1):
		var rA: Array = rings[r]
		var rB: Array = rings[r + 1]
		for k in [3, 4]:                              # lower-right→bottom, bottom→lower-left
			_add_quad(st_belly, rA[k], rA[k + 1], rB[k + 1], rB[k])
	# Neck underside — chest belly to cranium bottom (cBBL/cBBR).
	# Front ring index 3 = lower-right, 4 = bottom, 5 = lower-left.
	_add_quad(st_belly, front_ring[3], cBBR, cBBL, front_ring[5])
	_add_tri(st_belly, front_ring[3], front_ring[4], cBBR)
	_add_tri(st_belly, front_ring[4], front_ring[5], cBBL)
	# Cranium underside between cranium back and muzzle back.
	_add_quad(st_belly, cFBL, cFBR, cBBR, cBBL)
	# Muzzle base underside connection.
	_add_quad(st_belly, mBBL, mBBR, cFBR, cFBL)
	# Muzzle underside (lower jaw).
	_add_quad(st_belly, mFBL, mFBR, mBBR, mBBL)
	st_belly.generate_normals()
	var belly_mesh: ArrayMesh = st_belly.commit()
	var mi_belly := MeshInstance3D.new()
	mi_belly.mesh = belly_mesh
	var mat_belly := StandardMaterial3D.new()
	mat_belly.albedo_color = belly
	mat_belly.roughness = 0.92
	mat_belly.cull_mode = BaseMaterial3D.CULL_DISABLED
	mi_belly.material_override = mat_belly
	root.add_child(mi_belly)

	# ============================================================================
	# MUZZLE FRONT (nose) — darker than body, with raised nose bump
	# ============================================================================
	var st_nose := SurfaceTool.new()
	st_nose.begin(Mesh.PRIMITIVE_TRIANGLES)
	# Nose tip face (closing the muzzle front).
	_add_quad(st_nose, mFTL, mFTR, mFBR, mFBL)
	# Small nose bump — raised triangle on top of muzzle tip.
	var nose_back_z: float = muzz_tip_z - 0.06
	var nose_top_y: float = muzz_tip_top_y + 0.04
	var nose_back_w: float = muzz_tip_w * 1.4
	var noseT := Vector3(0, nose_top_y, nose_back_z + 0.02)
	var noseBL := Vector3(-nose_back_w, muzz_tip_top_y, nose_back_z)
	var noseBR := Vector3( nose_back_w, muzz_tip_top_y, nose_back_z)
	var noseFL := Vector3(-muzz_tip_w * 0.5, muzz_tip_top_y + 0.01, muzz_tip_z)
	var noseFR := Vector3( muzz_tip_w * 0.5, muzz_tip_top_y + 0.01, muzz_tip_z)
	_add_tri(st_nose, noseBL, noseT, noseFL)
	_add_tri(st_nose, noseFL, noseT, noseFR)
	_add_tri(st_nose, noseFR, noseT, noseBR)
	st_nose.generate_normals()
	var nose_mesh: ArrayMesh = st_nose.commit()
	var mi_nose := MeshInstance3D.new()
	mi_nose.mesh = nose_mesh
	var mat_nose := StandardMaterial3D.new()
	mat_nose.albedo_color = muzzle_dark
	mat_nose.roughness = 0.40   # wet shiny nose
	mat_nose.metallic = 0.05
	mat_nose.cull_mode = BaseMaterial3D.CULL_DISABLED
	mi_nose.material_override = mat_nose
	root.add_child(mi_nose)

	# ============================================================================
	# EYES — anchored to the actual cranium dimensions so they line up even
	# after body_size_jitter / leg_len_jitter change the head proportions.
	# Procedural face previously couldn't track these and put eyes in random
	# places on most wolves. Two amber/yellow boxes set INTO the cranium
	# upper-front, slightly above muzzle line.
	var wolf_eye_color: Color = palette.get("eye", Color(0.92, 0.78, 0.20))
	var eye_z: float = cran_front_z - h * 0.04        # just behind the muzzle joint
	var eye_y: float = cran_top_y - h * 0.20          # upper third of the cranium
	var eye_outer_x: float = cran_w * 0.95            # on the cranium surface
	for side in [-1, 1]:
		_build_box(
			root,
			Vector3(side * eye_outer_x - w * 0.005, eye_y - h * 0.05, eye_z - 0.015),
			Vector3(side * eye_outer_x + w * 0.060, eye_y + h * 0.05, eye_z + 0.020),
			wolf_eye_color, 0.25
		)
		# Tiny pupil slit
		_build_box(
			root,
			Vector3(side * eye_outer_x + w * 0.020, eye_y - h * 0.025, eye_z + 0.018),
			Vector3(side * eye_outer_x + w * 0.040, eye_y + h * 0.025, eye_z + 0.024),
			Color(0.05, 0.04, 0.03), 0.30
		)

	# ============================================================================
	# LOWER JAW — separate wedge that hangs slightly below the muzzle bottom,
	# offset back so it reads as a real jaw articulation. Plus a row of 4
	# small white teeth between the upper jaw and lower jaw (the canines that
	# wolves are known for).
	# ============================================================================
	# Upper jaw bottom is at muzz_back_bot_y / muzz_tip_bot_y. Lower jaw sits
	# JUST below it, slightly narrower, with the back end against the cheek
	# and the front coming up to meet the muzzle tip's bottom corner.
	# Per-individual jaw size / drop / width variation so no two wolves have
	# identical jaws. Drop range (h*0.08..0.20) controls how far the lower
	# jaw hangs from the muzzle.
	var jaw_drop: float = h * rng.randf_range(0.08, 0.20)
	var jaw_w_jitter: float = rng.randf_range(0.75, 1.00)
	var lj_back_top_y: float = muzz_back_bot_y - h * 0.01
	var lj_back_bot_y: float = muzz_back_bot_y - jaw_drop
	var lj_tip_top_y: float = muzz_tip_bot_y - h * 0.01
	var lj_tip_bot_y: float = muzz_tip_bot_y - jaw_drop * 0.55
	var lj_back_w: float = muzz_back_w * (0.78 + 0.12 * jaw_w_jitter)
	var lj_tip_w: float = muzz_tip_w * (0.85 + 0.10 * jaw_w_jitter)
	var ljBTL := Vector3(-lj_back_w, lj_back_top_y, muzz_back_z)
	var ljBTR := Vector3( lj_back_w, lj_back_top_y, muzz_back_z)
	var ljBBL := Vector3(-lj_back_w, lj_back_bot_y, muzz_back_z)
	var ljBBR := Vector3( lj_back_w, lj_back_bot_y, muzz_back_z)
	var ljFTL := Vector3(-lj_tip_w, lj_tip_top_y, muzz_tip_z - 0.02)
	var ljFTR := Vector3( lj_tip_w, lj_tip_top_y, muzz_tip_z - 0.02)
	var ljFBL := Vector3(-lj_tip_w, lj_tip_bot_y, muzz_tip_z - 0.02)
	var ljFBR := Vector3( lj_tip_w, lj_tip_bot_y, muzz_tip_z - 0.02)
	var st_jaw := SurfaceTool.new()
	st_jaw.begin(Mesh.PRIMITIVE_TRIANGLES)
	# Top (chin biting surface), bottom (jaw underside), sides, front and back
	_add_quad(st_jaw, ljBTL, ljBTR, ljFTR, ljFTL)     # top
	_add_quad(st_jaw, ljBBR, ljBBL, ljFBL, ljFBR)     # bottom (reversed winding)
	_add_quad(st_jaw, ljBTL, ljFTL, ljFBL, ljBBL)     # left
	_add_quad(st_jaw, ljFTR, ljBTR, ljBBR, ljFBR)     # right
	_add_quad(st_jaw, ljBTR, ljBTL, ljBBL, ljBBR)     # back
	_add_quad(st_jaw, ljFTL, ljFTR, ljFBR, ljFBL)     # front
	st_jaw.generate_normals()
	var mi_jaw := MeshInstance3D.new()
	mi_jaw.mesh = st_jaw.commit()
	var mat_jaw := StandardMaterial3D.new()
	mat_jaw.albedo_color = belly.darkened(0.05)       # match underside but slightly darker
	mat_jaw.roughness = 0.92
	mat_jaw.cull_mode = BaseMaterial3D.CULL_DISABLED
	mi_jaw.material_override = mat_jaw
	root.add_child(mi_jaw)

	# TEETH — count and size vary per individual (some wolves 3 teeth/side,
	# some 5, some larger fangs, some tighter rows). Random tooth count gives
	# visibly different mouths across the pack.
	var tooth_color := Color(0.95, 0.92, 0.85)
	var tooth_y_top: float = muzz_back_bot_y - h * 0.005
	var tooth_y_bot: float = lj_back_top_y - h * 0.07
	var tooth_count: int = rng.randi_range(3, 6)
	var tooth_size_jitter: float = rng.randf_range(0.80, 1.40)
	for ti in range(tooth_count):
		var tt: float = float(ti) / float(tooth_count - 1) if tooth_count > 1 else 0.5
		var tz: float = lerpf(muzz_back_z + 0.04, muzz_tip_z - 0.04, tt)
		var tw_local: float = lerpf(lj_back_w, lj_tip_w, tt) * 0.85
		for side_t in [-1, 1]:
			var tx: float = side_t * tw_local
			# Front teeth (canines) are bigger; jitter scales everything.
			var tooth_w: float = w * lerpf(0.025, 0.045, tt) * tooth_size_jitter
			_build_box(
				root,
				Vector3(tx - tooth_w * 0.5, tooth_y_bot, tz - tooth_w * 0.5),
				Vector3(tx + tooth_w * 0.5, tooth_y_top, tz + tooth_w * 0.5),
				tooth_color, 0.40
			)

	# ============================================================================
	# EARS — Smaller, more wolf-proportioned (NOT giant fox ears)
	# ============================================================================
	# Wolf ear height ≈ 1/3 head height (fox ears are closer to 1/2).
	# Ear positions — width and height now driven by per-individual ear_size_jitter
	# so different wolves have visibly different ear proportions.
	var ear_outer_x: float = cran_w * 0.78 * ear_size_jitter
	var ear_inner_x: float = cran_w * 0.30
	var ear_base_y: float = cran_top_y - 0.02
	var ear_base_z_front: float = cran_back_z + (cran_front_z - cran_back_z) * 0.42
	var ear_base_z_back: float = cran_back_z + (cran_front_z - cran_back_z) * 0.08
	var ear_tip_y: float = ear_base_y + h * 0.35 * ear_size_jitter
	var ear_tip_z: float = ear_base_z_back - 0.02
	for side in [-1, 1]:
		var ear_out_front := Vector3(side * ear_outer_x, ear_base_y, ear_base_z_front)
		var ear_out_back := Vector3(side * ear_outer_x, ear_base_y, ear_base_z_back)
		var ear_in_front := Vector3(side * ear_inner_x, ear_base_y, ear_base_z_front + 0.02)
		var ear_in_back := Vector3(side * ear_inner_x, ear_base_y, ear_base_z_back + 0.02)
		var ear_tip := Vector3(side * ear_outer_x * 0.75, ear_tip_y, ear_tip_z)
		# Outer face — primary color
		var st_ear := SurfaceTool.new()
		st_ear.begin(Mesh.PRIMITIVE_TRIANGLES)
		_add_tri(st_ear, ear_out_back, ear_tip, ear_out_front)
		st_ear.generate_normals()
		var ear_outer_mesh: ArrayMesh = st_ear.commit()
		var mi_ear_outer := MeshInstance3D.new()
		mi_ear_outer.mesh = ear_outer_mesh
		var mat_ear_outer := StandardMaterial3D.new()
		mat_ear_outer.albedo_color = primary
		mat_ear_outer.roughness = 0.92
		mat_ear_outer.cull_mode = BaseMaterial3D.CULL_DISABLED
		mi_ear_outer.material_override = mat_ear_outer
		root.add_child(mi_ear_outer)
		# Inner face — pink/lighter (using belly color as proxy)
		var st_ear_in := SurfaceTool.new()
		st_ear_in.begin(Mesh.PRIMITIVE_TRIANGLES)
		_add_tri(st_ear_in, ear_in_front, ear_tip, ear_in_back)
		st_ear_in.generate_normals()
		var ear_inner_mesh: ArrayMesh = st_ear_in.commit()
		var mi_ear_inner := MeshInstance3D.new()
		mi_ear_inner.mesh = ear_inner_mesh
		var mat_ear_inner := StandardMaterial3D.new()
		mat_ear_inner.albedo_color = belly
		mat_ear_inner.roughness = 0.95
		mat_ear_inner.cull_mode = BaseMaterial3D.CULL_DISABLED
		mi_ear_inner.material_override = mat_ear_inner
		root.add_child(mi_ear_inner)
		# Front/back side panels closing the ear
		var st_ear_side := SurfaceTool.new()
		st_ear_side.begin(Mesh.PRIMITIVE_TRIANGLES)
		_add_tri(st_ear_side, ear_out_front, ear_tip, ear_in_front)
		_add_tri(st_ear_side, ear_in_back, ear_tip, ear_out_back)
		# Base quad bridging outer to inner at the base.
		_add_quad(st_ear_side, ear_in_front, ear_out_front, ear_out_back, ear_in_back)
		st_ear_side.generate_normals()
		var ear_side_mesh: ArrayMesh = st_ear_side.commit()
		var mi_ear_side := MeshInstance3D.new()
		mi_ear_side.mesh = ear_side_mesh
		var mat_ear_side := StandardMaterial3D.new()
		mat_ear_side.albedo_color = dark
		mat_ear_side.roughness = 0.92
		mat_ear_side.cull_mode = BaseMaterial3D.CULL_DISABLED
		mi_ear_side.material_override = mat_ear_side
		root.add_child(mi_ear_side)

	# ============================================================================
	# TAIL — bushy drooping wolf tail with smooth curve and octagonal cross-section
	# ============================================================================
	# Real wolf tails hang DOWN at rest under gravity, are bushy throughout
	# (not just thick at base), and span ~35-40% of body length. Previous
	# version used square 4-vertex cross-sections which made the tail look
	# like a brick on a stick. Rebuilt with 8-vert circular cross-sections
	# (via _swept_body) following a 6-point drooping curve.
	#
	# Path: starts INSIDE the rear ring (so it visually fuses with the body),
	# rises slightly to suggest the base joint, then arcs back and DOWN to a
	# point near the floor behind the wolf.
	var rear_z: float = ring_z[4]
	var rear_top_y: float = ring_top[4]
	# Wild-wolf-alert tail: curves UP and BACK like a raised brush. The
	# previous drooping version + _swept_body's back-cap created a visible
	# "spike" pointing up-forward from the tail base (the cap's centroid push
	# of 0.05 absolute units), making the silhouette look like the tail
	# split into two pieces. Two fixes:
	#   1. Curve UP from base, not down — Y monotonically INCREASES from
	#      section 0 toward the tip, plateauing at section 4.
	#   2. cap_ends = false so there's no back-cap "spike". The back ring
	#      sits INSIDE the body geometry (rear_z + 0.04 is INSIDE the rear
	#      ring at rear_z) so the open ring is hidden by the body mesh, and
	#      the tip ring is small enough that its open face barely shows.
	var tail_sections: Array = [
		# Section 0 — INSIDE the rear ring (hidden by body mesh).
		{"center": Vector3(0, rear_top_y - h * 0.05, rear_z + 0.05),
		 "w": w * 0.20, "h": w * 0.20},
		# Section 1 — emerges from the body at hip-top level.
		{"center": Vector3(0, rear_top_y - h * 0.02, rear_z - d * 0.02),
		 "w": w * 0.22, "h": w * 0.22},
		# Section 2 — starting to lift above body top.
		{"center": Vector3(0, rear_top_y + h * 0.12, rear_z - d * 0.10),
		 "w": w * 0.20, "h": w * 0.20},
		# Section 3 — clearly raised above body, bushy.
		{"center": Vector3(0, rear_top_y + h * 0.28, rear_z - d * 0.16),
		 "w": w * 0.18, "h": w * 0.18},
		# Section 4 — near peak, narrowing slightly.
		{"center": Vector3(0, rear_top_y + h * 0.40, rear_z - d * 0.18),
		 "w": w * 0.13, "h": w * 0.13},
		# Section 5 — tip held high.
		{"center": Vector3(0, rear_top_y + h * 0.48, rear_z - d * 0.18),
		 "w": w * 0.06, "h": w * 0.06},
	]
	# cap_ends=false: the back ring is hidden inside the body, and the tip
	# ring is small. Avoids the "spike on the back cap" artifact.
	_swept_body(root, tail_sections, 8, dark, Color(0, 0, 0, 0), 0.95, false)

	# ============================================================================
	# LEGS — articulated, attached INTO the body so they connect properly
	# ============================================================================
	# Front legs sit under the shoulder ring (rings[1] at z=d*0.30).
	# Back legs sit under the hip ring (rings[3] at z=-d*0.18).
	# Leg tops penetrate UP into the body so they visually attach to the body
	# bottom — without this they hang in mid-air below the belly.
	var leg_offset_x: float = w * 0.34
	var fl_z: float = d * 0.25
	var bl_z: float = -d * 0.20
	# Hip Y — well INTO the body bottom (not just at clearance). The shoulder
	# ring bottom is at ring_bot[1] = clearance + h*0.20; we push the leg top
	# slightly higher to be inside the body silhouette.
	var front_hip_y: float = clearance + h * 0.35     # poke up into shoulder mass
	var back_hip_y: float = clearance + h * 0.32      # poke up into hip mass
	# Each leg has front/back distinction for natural knee bend.
	var leg_specs: Array = [
		{"x": -leg_offset_x, "z": fl_z, "front": true,  "hip_y": front_hip_y},
		{"x":  leg_offset_x, "z": fl_z, "front": true,  "hip_y": front_hip_y},
		{"x": -leg_offset_x, "z": bl_z, "front": false, "hip_y": back_hip_y},
		{"x":  leg_offset_x, "z": bl_z, "front": false, "hip_y": back_hip_y},
	]
	for spec in leg_specs:
		_build_wolf_leg_articulated(
			root,
			float(spec.x), float(spec.z),
			float(spec.hip_y), w * 0.10,
			bool(spec.front),
			primary, dark, paw_dark
		)

## Articulated wolf leg — upper segment + lower segment + paw, with proper
## bend at the knee. Front legs bend forward; back legs bend backward.
## The leg's TOP (hip/shoulder joint) is at `hip_y` so it penetrates UP into
## the body — paws sit at y=0 (ground) regardless of how high the hip is.
static func _build_wolf_leg_articulated(root: Node3D, x: float, z: float, hip_y: float, radius: float, is_front: bool, fur: Color, fur_dark: Color, paw_color: Color) -> void:
	var paw_y: float = 0.0
	var length: float = hip_y - paw_y                 # total visible leg length
	var knee_y: float = paw_y + length * 0.45         # knee at 45% from foot

	# Z offsets at each joint for natural bend.
	# Front legs: shoulder, knee slightly back, paw forward of knee.
	# Back legs: hip, knee forward, paw back.
	var knee_z_offset: float = -length * 0.06 if is_front else length * 0.08
	var paw_z_offset: float = length * 0.04 if is_front else -length * 0.10

	var hip_z: float = z
	var knee_z: float = z + knee_z_offset
	var paw_z: float = z + paw_z_offset

	# Upper leg — tapered from hip to knee.
	var r_hip: float = radius
	var r_knee: float = radius * 0.78
	_add_leg_segment(root, x, hip_y, hip_z, r_hip, knee_y, knee_z, r_knee, fur)
	# Lower leg — tapered from knee to ankle (paw top).
	var r_paw_top: float = radius * 0.6
	_add_leg_segment(root, x, knee_y, knee_z, r_knee, paw_y + radius * 0.55, paw_z, r_paw_top, fur_dark)
	# Paw — small flattened box at ground.
	_add_paw(root, x, paw_y, paw_z, radius * 0.85, paw_color)

## Build a tapered prism segment between two endpoints with different radii.
## Each endpoint defines a square cross-section; segment connects them.
static func _add_leg_segment(root: Node3D, x1: float, y1: float, z1: float, r1: float, y2: float, z2: float, r2: float, color: Color) -> void:
	var st := SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	# 4 corners at top
	var tFL := Vector3(x1 - r1, y1, z1 + r1)
	var tFR := Vector3(x1 + r1, y1, z1 + r1)
	var tBL := Vector3(x1 - r1, y1, z1 - r1)
	var tBR := Vector3(x1 + r1, y1, z1 - r1)
	# 4 corners at bottom
	var bFL := Vector3(x1 - r2, y2, z2 + r2)
	var bFR := Vector3(x1 + r2, y2, z2 + r2)
	var bBL := Vector3(x1 - r2, y2, z2 - r2)
	var bBR := Vector3(x1 + r2, y2, z2 - r2)
	_add_quad(st, tFL, tFR, bFR, bFL)  # front
	_add_quad(st, tBR, tBL, bBL, bBR)  # back
	_add_quad(st, tBL, tFL, bFL, bBL)  # left
	_add_quad(st, tFR, tBR, bBR, bFR)  # right
	st.generate_normals()
	var mesh: ArrayMesh = st.commit()
	var mi := MeshInstance3D.new()
	mi.mesh = mesh
	var mat := StandardMaterial3D.new()
	mat.albedo_color = color
	mat.roughness = 0.88
	mat.cull_mode = BaseMaterial3D.CULL_DISABLED
	mi.material_override = mat
	root.add_child(mi)

## Build a small flattened box for a paw at ground level.
static func _add_paw(root: Node3D, x: float, y: float, z: float, size: float, color: Color) -> void:
	var st := SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	var sx: float = size * 1.1
	var sz: float = size * 1.3
	var sy: float = size * 0.45
	var tFL := Vector3(x - sx, y + sy, z + sz)
	var tFR := Vector3(x + sx, y + sy, z + sz)
	var tBL := Vector3(x - sx, y + sy, z - sz)
	var tBR := Vector3(x + sx, y + sy, z - sz)
	var bFL := Vector3(x - sx, y, z + sz)
	var bFR := Vector3(x + sx, y, z + sz)
	var bBL := Vector3(x - sx, y, z - sz)
	var bBR := Vector3(x + sx, y, z - sz)
	_add_quad(st, tFL, tFR, bFR, bFL)  # front
	_add_quad(st, tBR, tBL, bBL, bBR)  # back
	_add_quad(st, tBL, tFL, bFL, bBL)  # left
	_add_quad(st, tFR, tBR, bBR, bFR)  # right
	_add_quad(st, tBL, tBR, tFR, tFL)  # top
	_add_quad(st, bFL, bFR, bBR, bBL)  # bottom
	st.generate_normals()
	var mesh: ArrayMesh = st.commit()
	var mi := MeshInstance3D.new()
	mi.mesh = mesh
	var mat := StandardMaterial3D.new()
	mat.albedo_color = color
	mat.roughness = 0.90
	mat.cull_mode = BaseMaterial3D.CULL_DISABLED
	mi.material_override = mat
	root.add_child(mi)

# ============================================================================
# SurfaceTool helpers
# ============================================================================

## Add a quad as two triangles (a,b,c) + (a,c,d). Counter-clockwise winding
## when viewed from outside — generate_normals() will produce outward normals.
static func _add_quad(st: SurfaceTool, a: Vector3, b: Vector3, c: Vector3, d: Vector3) -> void:
	_add_tri(st, a, b, c)
	_add_tri(st, a, c, d)

## Add a single triangle. Three vertices, no index buffer (so generate_normals
## produces flat shading per face — desired low-poly look).
static func _add_tri(st: SurfaceTool, a: Vector3, b: Vector3, c: Vector3) -> void:
	st.add_vertex(a)
	st.add_vertex(b)
	st.add_vertex(c)

## Read a float axis from a dict with a fallback.
static func _axis(d: Dictionary, key: String, fallback: float) -> float:
	if d.has(key) and (d[key] is float or d[key] is int):
		return float(d[key])
	return fallback

## Common helper — build a tapered cylinder/prism between two ring positions.
## Produces a single MeshInstance3D and parents to root.
static func _build_tapered_segment(root: Node3D, p1: Vector3, r1: float, p2: Vector3, r2: float, color: Color, roughness: float = 0.85, metallic: float = 0.0) -> void:
	var st := SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	# Build a 4-sided box-like segment from p1 to p2 (along Y if vertical-ish).
	var tFL := Vector3(p1.x - r1, p1.y, p1.z + r1)
	var tFR := Vector3(p1.x + r1, p1.y, p1.z + r1)
	var tBL := Vector3(p1.x - r1, p1.y, p1.z - r1)
	var tBR := Vector3(p1.x + r1, p1.y, p1.z - r1)
	var bFL := Vector3(p2.x - r2, p2.y, p2.z + r2)
	var bFR := Vector3(p2.x + r2, p2.y, p2.z + r2)
	var bBL := Vector3(p2.x - r2, p2.y, p2.z - r2)
	var bBR := Vector3(p2.x + r2, p2.y, p2.z - r2)
	_add_quad(st, tFL, tFR, bFR, bFL)
	_add_quad(st, tBR, tBL, bBL, bBR)
	_add_quad(st, tBL, tFL, bFL, bBL)
	_add_quad(st, tFR, tBR, bBR, bFR)
	st.generate_normals()
	var mi := MeshInstance3D.new()
	mi.mesh = st.commit()
	var mat := StandardMaterial3D.new()
	mat.albedo_color = color
	mat.roughness = roughness
	mat.metallic = metallic
	mat.cull_mode = BaseMaterial3D.CULL_DISABLED
	mi.material_override = mat
	root.add_child(mi)

## Common helper — build a simple flat-shaded box (6 faces, 12 tris).
static func _build_box(root: Node3D, min_corner: Vector3, max_corner: Vector3, color: Color, roughness: float = 0.85, metallic: float = 0.0) -> void:
	var st := SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	var a := Vector3(min_corner.x, min_corner.y, min_corner.z)
	var b := Vector3(max_corner.x, min_corner.y, min_corner.z)
	var c := Vector3(max_corner.x, max_corner.y, min_corner.z)
	var dv := Vector3(min_corner.x, max_corner.y, min_corner.z)
	var e := Vector3(min_corner.x, min_corner.y, max_corner.z)
	var f := Vector3(max_corner.x, min_corner.y, max_corner.z)
	var g := Vector3(max_corner.x, max_corner.y, max_corner.z)
	var hv := Vector3(min_corner.x, max_corner.y, max_corner.z)
	_add_quad(st, a, b, c, dv)   # back  (-Z)
	_add_quad(st, f, e, hv, g)   # front (+Z)
	_add_quad(st, e, a, dv, hv)  # left  (-X)
	_add_quad(st, b, f, g, c)    # right (+X)
	_add_quad(st, dv, c, g, hv)  # top   (+Y)
	_add_quad(st, e, f, b, a)    # bottom (-Y)
	st.generate_normals()
	var mi := MeshInstance3D.new()
	mi.mesh = st.commit()
	var mat := StandardMaterial3D.new()
	mat.albedo_color = color
	mat.roughness = roughness
	mat.metallic = metallic
	mat.cull_mode = BaseMaterial3D.CULL_DISABLED
	mi.material_override = mat
	root.add_child(mi)

# ============================================================================
# BEAR — bulky quadruped, short legs, ROUND head, no muzzle taper
# ============================================================================
##
## Key bear traits (vs wolf):
##   STOCKY: width ≈ depth (not depth >> width like wolf)
##   SHORTER LEGS (proportionally), THICKER legs
##   ROUND HEAD: no pointed muzzle, just a short snout bump
##   SMALL ROUNDED EARS (not perky pointed)
##   PRONOUNCED SHOULDER HUMP (especially Brown Bear)
##   STUB TAIL (almost invisible)

static func _build_bear(plan: Dictionary, root: Node3D) -> void:
	var base: Dictionary = plan.get("base", {})
	var palette: Dictionary = plan.get("palette", {})
	var limbs: Dictionary = plan.get("limbs", {})

	var w: float = _axis(base, "width", 0.95)
	var h: float = _axis(base, "height", 0.70)
	var d: float = _axis(base, "depth", 1.20)
	var leg_length: float = float(limbs.get("leg_length", 0.32))
	var clearance: float = leg_length

	var primary: Color = palette.get("primary", Color(0.32, 0.20, 0.10))
	var belly: Color = palette.get("secondary", primary.lightened(0.18))
	var dark: Color = primary.darkened(0.30)
	var paw_dark: Color = primary.darkened(0.50)
	var nose_color: Color = Color(0.10, 0.08, 0.07)

	# ----- Body: 5 rings, BIG SHOULDER HUMP, stout taper -----
	var ring_z := [d * 0.42, d * 0.22, -d * 0.02, -d * 0.24, -d * 0.46]
	var ring_w := [w * 0.50, w * 0.62, w * 0.58, w * 0.55, w * 0.42]
	# Bear has a famously pronounced shoulder hump (bigger than wolf's).
	var ring_top := [
		clearance + h * 0.78,        # chest top (lower than shoulder)
		clearance + h * 1.05,        # SHOULDER HUMP (highest point — bear signature)
		clearance + h * 0.92,        # mid (slight dip)
		clearance + h * 0.86,        # hip
		clearance + h * 0.70,        # rear
	]
	var ring_bot := [
		clearance + h * 0.22,
		clearance + h * 0.18,
		clearance + h * 0.14,
		clearance + h * 0.16,
		clearance + h * 0.22,
	]
	var ring_bulge := [1.05, 1.15, 1.10, 1.10, 0.90]

	var rings: Array = []
	for i in range(ring_z.size()):
		var rw: float = ring_w[i] * ring_bulge[i]
		var top_y: float = ring_top[i]
		var bot_y: float = ring_bot[i]
		var height_span: float = top_y - bot_y
		var z: float = ring_z[i]
		rings.append([
			Vector3(0, top_y, z),
			Vector3(rw * 0.71, top_y - height_span * 0.15, z),
			Vector3(rw, bot_y + height_span * 0.50, z),
			Vector3(rw * 0.71, bot_y + height_span * 0.15, z),
			Vector3(0, bot_y, z),
			Vector3(-rw * 0.71, bot_y + height_span * 0.15, z),
			Vector3(-rw, bot_y + height_span * 0.50, z),
			Vector3(-rw * 0.71, top_y - height_span * 0.15, z),
		])

	var st_body := SurfaceTool.new()
	st_body.begin(Mesh.PRIMITIVE_TRIANGLES)
	for r in range(rings.size() - 1):
		var rA: Array = rings[r]
		var rB: Array = rings[r + 1]
		for k in [0, 1, 2, 5, 6, 7]:
			_add_quad(st_body, rA[k], rA[(k + 1) % 8], rB[(k + 1) % 8], rB[k])
	var last: Array = rings[4]
	var center_back := Vector3(0, (last[0].y + last[4].y) * 0.5, last[0].z - 0.03)
	for k in range(8):
		_add_tri(st_body, last[k], last[(k + 1) % 8], center_back)

	# ----- ROUND HEAD (no extended muzzle) -----
	# Bear head is a flat-fronted ovoid with a short stub snout.
	var head_back_z: float = d * 0.52
	var head_front_z: float = d * 0.78
	var head_w: float = w * 0.40
	var head_top_y: float = clearance + h * 0.92
	var head_bot_y: float = clearance + h * 0.40
	var head_mid_z: float = (head_back_z + head_front_z) * 0.5
	# 12 vertices for a more rounded head (3-ring layout)
	var head_back := [
		Vector3(-head_w * 0.85, head_top_y - h * 0.05, head_back_z),
		Vector3( head_w * 0.85, head_top_y - h * 0.05, head_back_z),
		Vector3( head_w * 0.85, head_bot_y + h * 0.05, head_back_z),
		Vector3(-head_w * 0.85, head_bot_y + h * 0.05, head_back_z),
	]
	var head_mid := [
		Vector3(-head_w, head_top_y, head_mid_z),
		Vector3( head_w, head_top_y, head_mid_z),
		Vector3( head_w, head_bot_y, head_mid_z),
		Vector3(-head_w, head_bot_y, head_mid_z),
	]
	var head_front := [
		Vector3(-head_w * 0.65, head_top_y - h * 0.08, head_front_z),
		Vector3( head_w * 0.65, head_top_y - h * 0.08, head_front_z),
		Vector3( head_w * 0.65, head_bot_y + h * 0.10, head_front_z),
		Vector3(-head_w * 0.65, head_bot_y + h * 0.10, head_front_z),
	]
	# Back→mid quads (top, bottom, sides)
	for i in range(4):
		var j: int = (i + 1) % 4
		_add_quad(st_body, head_back[i], head_back[j], head_mid[j], head_mid[i])
		_add_quad(st_body, head_mid[i], head_mid[j], head_front[j], head_front[i])
	# Front face — flat ovoid with stub snout
	_add_quad(st_body, head_front[0], head_front[1], head_front[2], head_front[3])
	# Connect head back to body front ring (neck)
	var front_ring: Array = rings[0]
	_add_quad(st_body, front_ring[0], front_ring[1], head_back[1], head_back[0])
	_add_quad(st_body, front_ring[7], front_ring[0], head_back[0], head_back[0])  # collapses to tri
	_add_quad(st_body, front_ring[1], front_ring[2], head_back[2], head_back[1])
	_add_quad(st_body, head_back[0], head_back[3], front_ring[5], front_ring[7])
	_add_quad(st_body, front_ring[3], front_ring[4], front_ring[5], head_back[3])

	st_body.generate_normals()
	var mi_body := MeshInstance3D.new()
	mi_body.mesh = st_body.commit()
	var mat_body := StandardMaterial3D.new()
	mat_body.albedo_color = primary
	mat_body.roughness = 0.94                                # shaggy fur look
	mat_body.cull_mode = BaseMaterial3D.CULL_DISABLED
	mi_body.material_override = mat_body
	root.add_child(mi_body)

	# ----- Stub snout — small box poking out the front of head -----
	var snout_back_z: float = head_front_z - 0.02
	var snout_tip_z: float = head_front_z + h * 0.18
	var snout_w: float = head_w * 0.45
	var snout_top_y: float = head_top_y - h * 0.22
	var snout_bot_y: float = head_bot_y + h * 0.05
	_build_box(
		root,
		Vector3(-snout_w, snout_bot_y, snout_back_z),
		Vector3( snout_w, snout_top_y, snout_tip_z),
		dark, 0.88
	)
	# Nose — small dark glossy bump at tip
	_build_box(
		root,
		Vector3(-snout_w * 0.55, snout_top_y - h * 0.08, snout_tip_z - 0.01),
		Vector3( snout_w * 0.55, snout_top_y + h * 0.02, snout_tip_z + h * 0.04),
		nose_color, 0.35, 0.05
	)

	# ----- Belly (lighter underside) -----
	var st_belly := SurfaceTool.new()
	st_belly.begin(Mesh.PRIMITIVE_TRIANGLES)
	for r in range(rings.size() - 1):
		var rA: Array = rings[r]
		var rB: Array = rings[r + 1]
		for k in [3, 4]:
			_add_quad(st_belly, rA[k], rA[(k + 1) % 8], rB[(k + 1) % 8], rB[k])
	# Head underside
	_add_quad(st_belly, head_back[3], head_back[2], head_mid[2], head_mid[3])
	_add_quad(st_belly, head_mid[3], head_mid[2], head_front[2], head_front[3])
	st_belly.generate_normals()
	var mi_belly := MeshInstance3D.new()
	mi_belly.mesh = st_belly.commit()
	var mat_belly := StandardMaterial3D.new()
	mat_belly.albedo_color = belly
	mat_belly.roughness = 0.92
	mat_belly.cull_mode = BaseMaterial3D.CULL_DISABLED
	mi_belly.material_override = mat_belly
	root.add_child(mi_belly)

	# ----- Small rounded ears (NOT tall pointed like wolf) -----
	var ear_x: float = head_w * 0.70
	var ear_y: float = head_top_y + h * 0.04
	var ear_z: float = head_mid_z + 0.02
	for side in [-1, 1]:
		_build_box(
			root,
			Vector3(side * (ear_x - h * 0.06), head_top_y - h * 0.04, ear_z - h * 0.05),
			Vector3(side * (ear_x + h * 0.06), ear_y + h * 0.07, ear_z + h * 0.05),
			primary, 0.92
		)

	# ----- Stub tail (almost invisible — bears barely have tails) -----
	var tail_z: float = ring_z[4] - 0.04
	var tail_y: float = ring_top[4] - h * 0.10
	_build_box(
		root,
		Vector3(-w * 0.06, tail_y - w * 0.06, tail_z - w * 0.10),
		Vector3( w * 0.06, tail_y + w * 0.04, tail_z),
		dark, 0.92
	)

	# ----- Short THICK legs (4 of them, with knee bend) -----
	var leg_r: float = w * 0.13                       # thick bear legs
	var leg_offset_x: float = w * 0.32
	var front_hip_y: float = clearance + h * 0.40
	var back_hip_y: float = clearance + h * 0.36
	var leg_specs: Array = [
		{"x": -leg_offset_x, "z": d * 0.22, "front": true,  "hip_y": front_hip_y},
		{"x":  leg_offset_x, "z": d * 0.22, "front": true,  "hip_y": front_hip_y},
		{"x": -leg_offset_x, "z": -d * 0.24, "front": false, "hip_y": back_hip_y},
		{"x":  leg_offset_x, "z": -d * 0.24, "front": false, "hip_y": back_hip_y},
	]
	for spec in leg_specs:
		_build_wolf_leg_articulated(
			root,
			float(spec.x), float(spec.z),
			float(spec.hip_y), leg_r,
			bool(spec.front),
			primary, dark, paw_dark
		)

# ============================================================================
# GOBLIN — small biped, BIG HEAD, long pointed ears, HUNCHED posture
# ============================================================================

static func _build_goblin(plan: Dictionary, root: Node3D) -> void:
	var base: Dictionary = plan.get("base", {})
	var palette: Dictionary = plan.get("palette", {})
	var limbs: Dictionary = plan.get("limbs", {})

	var w: float = _axis(base, "width", 0.50)
	var h: float = _axis(base, "height", 0.85)
	var leg_length: float = float(limbs.get("leg_length", 0.40))
	var clearance: float = leg_length

	var skin: Color = palette.get("primary", Color(0.42, 0.55, 0.32))
	var skin_dark: Color = skin.darkened(0.30)
	var loincloth: Color = palette.get("secondary", Color(0.32, 0.20, 0.12))
	var nail: Color = Color(0.30, 0.25, 0.18)
	var teeth: Color = Color(0.92, 0.88, 0.78)

	# ----- Torso: squat with POT BELLY -----
	# Upper torso narrow (shoulders), middle wide (belly), lower narrow (hips).
	var torso_bot_y: float = clearance
	var torso_top_y: float = clearance + h * 0.65
	var shoulder_y: float = clearance + h * 0.55
	var belly_y: float = clearance + h * 0.30
	var hip_y: float = clearance + h * 0.05
	var sh_w: float = w * 0.42
	var belly_w: float = w * 0.55                       # WIDEST — pot belly
	var hip_w: float = w * 0.38
	var t_depth: float = w * 0.30                       # torso depth (front-to-back)

	# 4 levels × 4 corners = 16 verts for torso
	var lvl_top := [
		Vector3(-sh_w, torso_top_y, t_depth * 0.5),
		Vector3( sh_w, torso_top_y, t_depth * 0.5),
		Vector3( sh_w, torso_top_y, -t_depth * 0.5),
		Vector3(-sh_w, torso_top_y, -t_depth * 0.5),
	]
	var lvl_shoulder := [
		Vector3(-sh_w * 1.05, shoulder_y, t_depth * 0.5),
		Vector3( sh_w * 1.05, shoulder_y, t_depth * 0.5),
		Vector3( sh_w * 1.05, shoulder_y, -t_depth * 0.5),
		Vector3(-sh_w * 1.05, shoulder_y, -t_depth * 0.5),
	]
	var lvl_belly := [
		Vector3(-belly_w, belly_y, t_depth * 0.65),       # pot belly bulges forward
		Vector3( belly_w, belly_y, t_depth * 0.65),
		Vector3( belly_w, belly_y, -t_depth * 0.5),
		Vector3(-belly_w, belly_y, -t_depth * 0.5),
	]
	var lvl_hip := [
		Vector3(-hip_w, hip_y, t_depth * 0.45),
		Vector3( hip_w, hip_y, t_depth * 0.45),
		Vector3( hip_w, hip_y, -t_depth * 0.4),
		Vector3(-hip_w, hip_y, -t_depth * 0.4),
	]
	var st_torso := SurfaceTool.new()
	st_torso.begin(Mesh.PRIMITIVE_TRIANGLES)
	# Connect rings
	for i in range(4):
		var j: int = (i + 1) % 4
		_add_quad(st_torso, lvl_top[i], lvl_top[j], lvl_shoulder[j], lvl_shoulder[i])
		_add_quad(st_torso, lvl_shoulder[i], lvl_shoulder[j], lvl_belly[j], lvl_belly[i])
		_add_quad(st_torso, lvl_belly[i], lvl_belly[j], lvl_hip[j], lvl_hip[i])
	# Top + bottom caps
	_add_quad(st_torso, lvl_top[3], lvl_top[2], lvl_top[1], lvl_top[0])
	_add_quad(st_torso, lvl_hip[0], lvl_hip[1], lvl_hip[2], lvl_hip[3])
	st_torso.generate_normals()
	var mi_torso := MeshInstance3D.new()
	mi_torso.mesh = st_torso.commit()
	var mat_torso := StandardMaterial3D.new()
	mat_torso.albedo_color = skin
	mat_torso.roughness = 0.85
	mat_torso.cull_mode = BaseMaterial3D.CULL_DISABLED
	mi_torso.material_override = mat_torso
	root.add_child(mi_torso)

	# ----- Loincloth (small band over the hip area) -----
	_build_box(
		root,
		Vector3(-hip_w * 1.05, hip_y - 0.02, -t_depth * 0.45),
		Vector3( hip_w * 1.05, hip_y + h * 0.10, t_depth * 0.50),
		loincloth, 0.92
	)

	# ----- BIG HEAD (oversized relative to body — signature goblin trait) -----
	var head_w: float = w * 0.45                        # huge head
	var head_h: float = h * 0.40
	var head_center_y: float = torso_top_y + head_h * 0.55
	var head_center_z: float = t_depth * 0.10           # juts forward (hunched)
	# Head as low-poly ovoid using 2 rings (4 each) for a simple stylized head
	var hb := [   # back ring
		Vector3(-head_w * 0.82, head_center_y + head_h * 0.45, head_center_z - head_w * 0.55),
		Vector3( head_w * 0.82, head_center_y + head_h * 0.45, head_center_z - head_w * 0.55),
		Vector3( head_w * 0.82, head_center_y - head_h * 0.45, head_center_z - head_w * 0.55),
		Vector3(-head_w * 0.82, head_center_y - head_h * 0.45, head_center_z - head_w * 0.55),
	]
	var hm := [   # mid ring (widest)
		Vector3(-head_w, head_center_y + head_h * 0.50, head_center_z),
		Vector3( head_w, head_center_y + head_h * 0.50, head_center_z),
		Vector3( head_w, head_center_y - head_h * 0.50, head_center_z),
		Vector3(-head_w, head_center_y - head_h * 0.50, head_center_z),
	]
	var hf := [   # front ring (tapered for chin/forehead)
		Vector3(-head_w * 0.65, head_center_y + head_h * 0.30, head_center_z + head_w * 0.55),
		Vector3( head_w * 0.65, head_center_y + head_h * 0.30, head_center_z + head_w * 0.55),
		Vector3( head_w * 0.65, head_center_y - head_h * 0.35, head_center_z + head_w * 0.55),
		Vector3(-head_w * 0.65, head_center_y - head_h * 0.35, head_center_z + head_w * 0.55),
	]
	var st_head := SurfaceTool.new()
	st_head.begin(Mesh.PRIMITIVE_TRIANGLES)
	for i in range(4):
		var j: int = (i + 1) % 4
		_add_quad(st_head, hb[i], hb[j], hm[j], hm[i])
		_add_quad(st_head, hm[i], hm[j], hf[j], hf[i])
	# Back face (close skull)
	_add_quad(st_head, hb[3], hb[2], hb[1], hb[0])
	# Front face (closes the chin/forehead — face)
	_add_quad(st_head, hf[0], hf[1], hf[2], hf[3])
	st_head.generate_normals()
	var mi_head := MeshInstance3D.new()
	mi_head.mesh = st_head.commit()
	mi_head.material_override = mat_torso
	root.add_child(mi_head)

	# ----- Hooked nose (small triangular wedge on front of head) -----
	var nose_back := Vector3(0, head_center_y - head_h * 0.05, head_center_z + head_w * 0.5)
	var nose_tip := Vector3(0, head_center_y - head_h * 0.20, head_center_z + head_w * 0.78)
	var nose_top := Vector3(0, head_center_y + head_h * 0.10, head_center_z + head_w * 0.62)
	var nose_BL := Vector3(-head_w * 0.18, head_center_y - head_h * 0.05, head_center_z + head_w * 0.5)
	var nose_BR := Vector3( head_w * 0.18, head_center_y - head_h * 0.05, head_center_z + head_w * 0.5)
	var st_nose := SurfaceTool.new()
	st_nose.begin(Mesh.PRIMITIVE_TRIANGLES)
	_add_tri(st_nose, nose_BL, nose_BR, nose_tip)
	_add_tri(st_nose, nose_BL, nose_tip, nose_top)
	_add_tri(st_nose, nose_BR, nose_top, nose_tip)
	_add_tri(st_nose, nose_BL, nose_top, nose_BR)
	st_nose.generate_normals()
	var mi_nose := MeshInstance3D.new()
	mi_nose.mesh = st_nose.commit()
	var mat_nose := StandardMaterial3D.new()
	mat_nose.albedo_color = skin_dark
	mat_nose.roughness = 0.85
	mat_nose.cull_mode = BaseMaterial3D.CULL_DISABLED
	mi_nose.material_override = mat_nose
	root.add_child(mi_nose)

	# ----- LONG POINTED EARS (signature goblin trait) -----
	for side in [-1, 1]:
		var ear_base := Vector3(side * head_w * 0.95, head_center_y + head_h * 0.10, head_center_z - head_w * 0.10)
		var ear_tip := Vector3(side * head_w * 1.55, head_center_y + head_h * 0.30, head_center_z - head_w * 0.45)
		var ear_b1 := Vector3(side * head_w * 0.90, head_center_y + head_h * 0.25, head_center_z + 0.02)
		var ear_b2 := Vector3(side * head_w * 0.90, head_center_y - head_h * 0.05, head_center_z - head_w * 0.15)
		var st_ear := SurfaceTool.new()
		st_ear.begin(Mesh.PRIMITIVE_TRIANGLES)
		_add_tri(st_ear, ear_b1, ear_base, ear_tip)
		_add_tri(st_ear, ear_b2, ear_tip, ear_base)
		_add_tri(st_ear, ear_b1, ear_tip, ear_b2)
		st_ear.generate_normals()
		var mi_ear := MeshInstance3D.new()
		mi_ear.mesh = st_ear.commit()
		var mat_ear := StandardMaterial3D.new()
		mat_ear.albedo_color = skin_dark
		mat_ear.roughness = 0.92
		mat_ear.cull_mode = BaseMaterial3D.CULL_DISABLED
		mi_ear.material_override = mat_ear
		root.add_child(mi_ear)

	# ----- Two short bent legs -----
	var leg_top_y: float = clearance + h * 0.05
	var leg_knee_y: float = leg_length * 0.50
	var leg_paw_y: float = 0.0
	var leg_r: float = w * 0.10
	for side in [-1, 1]:
		var hip_x: float = side * w * 0.18
		# Upper leg (thigh)
		_build_tapered_segment(
			root,
			Vector3(hip_x, leg_top_y, 0.02), leg_r,
			Vector3(hip_x + side * 0.02, leg_knee_y, 0.06), leg_r * 0.85,
			skin, 0.88
		)
		# Lower leg (shin)
		_build_tapered_segment(
			root,
			Vector3(hip_x + side * 0.02, leg_knee_y, 0.06), leg_r * 0.85,
			Vector3(hip_x, leg_paw_y + 0.04, 0.04), leg_r * 0.65,
			skin_dark, 0.88
		)
		# Big foot
		_build_box(
			root,
			Vector3(hip_x - leg_r * 0.9, leg_paw_y, -0.04),
			Vector3(hip_x + leg_r * 0.9, leg_paw_y + 0.06, 0.12),
			skin_dark, 0.92
		)

	# ----- Two long lanky arms (hanging) -----
	var arm_top_y: float = shoulder_y - 0.02
	var arm_elbow_y: float = arm_top_y - h * 0.30
	var arm_hand_y: float = arm_top_y - h * 0.62        # arms reach below the loincloth
	var arm_r: float = w * 0.08
	for side in [-1, 1]:
		var shoulder_x: float = side * sh_w * 1.10
		# Upper arm
		_build_tapered_segment(
			root,
			Vector3(shoulder_x, arm_top_y, 0.0), arm_r,
			Vector3(shoulder_x + side * 0.02, arm_elbow_y, 0.02), arm_r * 0.85,
			skin, 0.88
		)
		# Forearm
		_build_tapered_segment(
			root,
			Vector3(shoulder_x + side * 0.02, arm_elbow_y, 0.02), arm_r * 0.85,
			Vector3(shoulder_x, arm_hand_y, 0.04), arm_r * 0.7,
			skin_dark, 0.88
		)
		# 3-finger hand (small box for now)
		_build_box(
			root,
			Vector3(shoulder_x - arm_r * 1.1, arm_hand_y - 0.06, -0.02),
			Vector3(shoulder_x + arm_r * 1.1, arm_hand_y + 0.02, 0.10),
			skin_dark, 0.92
		)

# ============================================================================
# DRAGON — winged quadruped, horned wedge head, scaled body, spike ridge
# ============================================================================

static func _build_dragon(plan: Dictionary, root: Node3D) -> void:
	var base: Dictionary = plan.get("base", {})
	var palette: Dictionary = plan.get("palette", {})
	var limbs: Dictionary = plan.get("limbs", {})

	var w: float = _axis(base, "width", 0.85)
	var h: float = _axis(base, "height", 0.70)
	var d: float = _axis(base, "depth", 1.50)
	var leg_length: float = float(limbs.get("leg_length", 0.50))
	var clearance: float = leg_length

	var scales: Color = palette.get("primary", Color(0.65, 0.10, 0.05))
	var belly: Color = palette.get("accent", Color(0.95, 0.78, 0.25))
	var dark: Color = scales.darkened(0.40)
	var wing_color: Color = scales.darkened(0.20)
	var wing_membrane: Color = scales.lerp(Color(0.20, 0.10, 0.05), 0.4)

	# Body — long, with shoulder bulk + barrel torso + tapered hips
	var ring_z := [d * 0.45, d * 0.25, 0.00, -d * 0.25, -d * 0.50]
	var ring_w := [w * 0.50, w * 0.60, w * 0.55, w * 0.48, w * 0.32]
	var ring_top := [
		clearance + h * 0.85,
		clearance + h * 1.05,                              # shoulder hump
		clearance + h * 0.95,
		clearance + h * 0.85,
		clearance + h * 0.65,
	]
	var ring_bot := [
		clearance + h * 0.18,
		clearance + h * 0.12,
		clearance + h * 0.08,                              # belly low
		clearance + h * 0.12,
		clearance + h * 0.22,
	]
	var ring_bulge := [1.05, 1.20, 1.10, 1.05, 0.80]
	var rings: Array = []
	for i in range(5):
		var rw: float = ring_w[i] * ring_bulge[i]
		var top_y: float = ring_top[i]
		var bot_y: float = ring_bot[i]
		var hs: float = top_y - bot_y
		var z: float = ring_z[i]
		rings.append([
			Vector3(0, top_y, z),
			Vector3(rw * 0.71, top_y - hs * 0.15, z),
			Vector3(rw, bot_y + hs * 0.50, z),
			Vector3(rw * 0.71, bot_y + hs * 0.15, z),
			Vector3(0, bot_y, z),
			Vector3(-rw * 0.71, bot_y + hs * 0.15, z),
			Vector3(-rw, bot_y + hs * 0.50, z),
			Vector3(-rw * 0.71, top_y - hs * 0.15, z),
		])

	var st_body := SurfaceTool.new()
	st_body.begin(Mesh.PRIMITIVE_TRIANGLES)
	for r in range(4):
		var rA: Array = rings[r]
		var rB: Array = rings[r + 1]
		for k in [0, 1, 2, 5, 6, 7]:
			_add_quad(st_body, rA[k], rA[(k + 1) % 8], rB[(k + 1) % 8], rB[k])

	# Wedge HEAD — angular, with sloped brow and tapered snout
	var hd_back_z: float = d * 0.50
	var hd_front_z: float = d * 0.92
	var hd_top_y: float = clearance + h * 1.00
	var hd_bot_y: float = clearance + h * 0.50
	var hd_w_back: float = w * 0.32
	var hd_w_front: float = w * 0.16
	# 4 verts back of head, 4 verts front of snout
	var dhBTL := Vector3(-hd_w_back, hd_top_y, hd_back_z)
	var dhBTR := Vector3( hd_w_back, hd_top_y, hd_back_z)
	var dhBBL := Vector3(-hd_w_back, hd_bot_y, hd_back_z)
	var dhBBR := Vector3( hd_w_back, hd_bot_y, hd_back_z)
	var dhFTL := Vector3(-hd_w_front, hd_top_y - h * 0.18, hd_front_z)
	var dhFTR := Vector3( hd_w_front, hd_top_y - h * 0.18, hd_front_z)
	var dhFBL := Vector3(-hd_w_front, hd_bot_y + h * 0.06, hd_front_z)
	var dhFBR := Vector3( hd_w_front, hd_bot_y + h * 0.06, hd_front_z)
	_add_quad(st_body, dhBTL, dhBTR, dhFTR, dhFTL)              # top of snout
	_add_quad(st_body, dhBTL, dhFTL, dhFBL, dhBBL)              # left
	_add_quad(st_body, dhFTR, dhBTR, dhBBR, dhFBR)              # right
	_add_quad(st_body, dhFTL, dhFTR, dhFBR, dhFBL)              # nose face
	# Connect head back to body front ring
	var front_ring: Array = rings[0]
	_add_quad(st_body, front_ring[0], front_ring[1], dhBTR, dhBTL)
	_add_tri(st_body, front_ring[7], front_ring[0], dhBTL)
	_add_quad(st_body, front_ring[1], front_ring[2], dhBBR, dhBTR)
	_add_quad(st_body, dhBTL, dhBBL, front_ring[6], front_ring[7])

	# SPIKE RIDGE down the spine (a series of triangular ridges)
	var spine_count: int = 7
	for i in range(spine_count):
		var t: float = float(i) / float(spine_count - 1)
		var sp_z: float = lerpf(d * 0.40, -d * 0.45, t)
		var sp_y_base: float = lerpf(ring_top[1], ring_top[4], t)
		var sp_y_tip: float = sp_y_base + h * (0.25 - t * 0.15)
		var sp_w: float = w * 0.04
		var sp_L: float = w * 0.10
		var sp_B := Vector3(-sp_w, sp_y_base, sp_z + sp_L * 0.3)
		var sp_R := Vector3( sp_w, sp_y_base, sp_z + sp_L * 0.3)
		var sp_K := Vector3( 0, sp_y_base, sp_z - sp_L * 0.7)
		var sp_T := Vector3( 0, sp_y_tip, sp_z)
		_add_tri(st_body, sp_B, sp_R, sp_T)
		_add_tri(st_body, sp_R, sp_K, sp_T)
		_add_tri(st_body, sp_K, sp_B, sp_T)

	st_body.generate_normals()
	var mi_body := MeshInstance3D.new()
	mi_body.mesh = st_body.commit()
	var mat_body := StandardMaterial3D.new()
	mat_body.albedo_color = scales
	mat_body.roughness = 0.55                                  # slightly shiny scales
	mat_body.metallic = 0.10
	mat_body.cull_mode = BaseMaterial3D.CULL_DISABLED
	mi_body.material_override = mat_body
	root.add_child(mi_body)

	# Belly (lighter, gold for Red Dragon canon)
	var st_belly := SurfaceTool.new()
	st_belly.begin(Mesh.PRIMITIVE_TRIANGLES)
	for r in range(4):
		var rA: Array = rings[r]
		var rB: Array = rings[r + 1]
		for k in [3, 4]:
			_add_quad(st_belly, rA[k], rA[(k + 1) % 8], rB[(k + 1) % 8], rB[k])
	# Head underside (jaw)
	_add_quad(st_belly, dhBBL, dhBBR, dhFBR, dhFBL)
	# Neck underside
	_add_quad(st_belly, front_ring[3], dhBBR, dhBBL, front_ring[5])
	_add_tri(st_belly, front_ring[3], front_ring[4], dhBBR)
	_add_tri(st_belly, front_ring[4], front_ring[5], dhBBL)
	st_belly.generate_normals()
	var mi_belly := MeshInstance3D.new()
	mi_belly.mesh = st_belly.commit()
	var mat_belly := StandardMaterial3D.new()
	mat_belly.albedo_color = belly
	mat_belly.roughness = 0.50
	mat_belly.metallic = 0.20
	mat_belly.cull_mode = BaseMaterial3D.CULL_DISABLED
	mi_belly.material_override = mat_belly
	root.add_child(mi_belly)

	# HORNS — two large back-swept cones on top of head
	for side in [-1, 1]:
		var hb_p := Vector3(side * hd_w_back * 0.70, hd_top_y + 0.02, hd_back_z + 0.05)
		var ht_p := Vector3(side * hd_w_back * 1.20, hd_top_y + h * 0.65, hd_back_z - h * 0.30)
		var hbl := Vector3(side * hd_w_back * 0.55, hd_top_y - 0.02, hd_back_z + 0.10)
		var hbr := Vector3(side * hd_w_back * 0.85, hd_top_y - 0.02, hd_back_z - 0.02)
		var hbb := Vector3(side * hd_w_back * 0.70, hd_top_y - 0.02, hd_back_z - 0.10)
		var st_horn := SurfaceTool.new()
		st_horn.begin(Mesh.PRIMITIVE_TRIANGLES)
		_add_tri(st_horn, hbl, hbr, ht_p)
		_add_tri(st_horn, hbr, hbb, ht_p)
		_add_tri(st_horn, hbb, hbl, ht_p)
		st_horn.generate_normals()
		var mi_horn := MeshInstance3D.new()
		mi_horn.mesh = st_horn.commit()
		var mat_horn := StandardMaterial3D.new()
		mat_horn.albedo_color = dark
		mat_horn.roughness = 0.70
		mat_horn.cull_mode = BaseMaterial3D.CULL_DISABLED
		mi_horn.material_override = mat_horn
		root.add_child(mi_horn)

	# WINGS — two large triangular sheets folded back along the body
	for side in [-1, 1]:
		var w_root := Vector3(side * w * 0.55, clearance + h * 1.05, d * 0.10)
		var w_elbow := Vector3(side * w * 1.30, clearance + h * 1.55, d * 0.20)
		var w_finger1 := Vector3(side * w * 1.90, clearance + h * 1.40, -d * 0.10)
		var w_finger2 := Vector3(side * w * 1.70, clearance + h * 0.95, -d * 0.30)
		var w_finger3 := Vector3(side * w * 1.30, clearance + h * 0.60, -d * 0.45)
		var w_inner := Vector3(side * w * 0.50, clearance + h * 0.75, -d * 0.25)
		var st_wing := SurfaceTool.new()
		st_wing.begin(Mesh.PRIMITIVE_TRIANGLES)
		# Wing surface — fan of triangles from elbow
		_add_tri(st_wing, w_root, w_elbow, w_finger1)
		_add_tri(st_wing, w_elbow, w_finger2, w_finger1)
		_add_tri(st_wing, w_elbow, w_finger3, w_finger2)
		_add_tri(st_wing, w_elbow, w_inner, w_finger3)
		_add_tri(st_wing, w_root, w_inner, w_elbow)
		# Back side same triangles, opposite winding (so visible from behind)
		_add_tri(st_wing, w_finger1, w_elbow, w_root)
		_add_tri(st_wing, w_finger1, w_finger2, w_elbow)
		_add_tri(st_wing, w_finger2, w_finger3, w_elbow)
		_add_tri(st_wing, w_finger3, w_inner, w_elbow)
		_add_tri(st_wing, w_elbow, w_inner, w_root)
		st_wing.generate_normals()
		var mi_wing := MeshInstance3D.new()
		mi_wing.mesh = st_wing.commit()
		var mat_wing := StandardMaterial3D.new()
		mat_wing.albedo_color = wing_membrane
		mat_wing.roughness = 0.85
		mat_wing.cull_mode = BaseMaterial3D.CULL_DISABLED
		mi_wing.material_override = mat_wing
		root.add_child(mi_wing)

	# Long tapered TAIL (much longer than wolf)
	var tail_segs: int = 5
	var tail_start_z: float = ring_z[4]
	var tail_end_z: float = ring_z[4] - d * 0.80                # very long tail
	var tail_start_y: float = ring_top[4] - 0.04
	var tail_end_y: float = clearance + h * 0.10
	var prev_pos: Vector3 = Vector3(0, tail_start_y, tail_start_z + 0.03)
	var prev_r: float = w * 0.18
	for i in range(1, tail_segs + 1):
		var t: float = float(i) / float(tail_segs)
		var next_pos := Vector3(0, lerpf(tail_start_y, tail_end_y, t), lerpf(tail_start_z, tail_end_z, t))
		var next_r: float = lerpf(0.18, 0.03, t) * w
		_build_tapered_segment(root, prev_pos, prev_r, next_pos, next_r, scales, 0.55, 0.10)
		prev_pos = next_pos
		prev_r = next_r

	# 4 STRONG LEGS with talons
	var leg_offset_x: float = w * 0.36
	var fl_z: float = d * 0.25
	var bl_z: float = -d * 0.20
	var front_hip_y: float = clearance + h * 0.45
	var back_hip_y: float = clearance + h * 0.40
	for spec in [
		{"x": -leg_offset_x, "z": fl_z, "front": true,  "hip_y": front_hip_y},
		{"x":  leg_offset_x, "z": fl_z, "front": true,  "hip_y": front_hip_y},
		{"x": -leg_offset_x, "z": bl_z, "front": false, "hip_y": back_hip_y},
		{"x":  leg_offset_x, "z": bl_z, "front": false, "hip_y": back_hip_y},
	]:
		_build_wolf_leg_articulated(
			root,
			float(spec.x), float(spec.z),
			float(spec.hip_y), w * 0.13,
			bool(spec.front),
			scales, dark, Color(0.15, 0.10, 0.05)
		)
		# Add a talon — small dark cone at the paw
		var paw_x: float = float(spec.x)
		var paw_z: float = float(spec.z) + (0.06 if bool(spec.front) else -0.10)
		_build_box(
			root,
			Vector3(paw_x - w * 0.06, 0.0, paw_z + 0.05),
			Vector3(paw_x + w * 0.06, 0.04, paw_z + 0.12),
			Color(0.10, 0.08, 0.06), 0.50, 0.20
		)

# ============================================================================
# SPIDER — bulbous abdomen, separate cephalothorax, 8 legs, eye cluster
# ============================================================================

static func _build_spider(plan: Dictionary, root: Node3D) -> void:
	var base: Dictionary = plan.get("base", {})
	var palette: Dictionary = plan.get("palette", {})
	var limbs: Dictionary = plan.get("limbs", {})

	var w: float = _axis(base, "width", 0.65)
	var h: float = _axis(base, "height", 0.40)
	var d: float = _axis(base, "depth", 0.85)
	var leg_length: float = float(limbs.get("leg_length", 0.35))
	var clearance: float = leg_length

	var chitin: Color = palette.get("primary", Color(0.10, 0.08, 0.06))
	var chitin_light: Color = palette.get("secondary", chitin.lightened(0.15))
	var marking: Color = palette.get("accent", Color(0.55, 0.05, 0.10))
	var eye_color: Color = palette.get("eye", Color(0.95, 0.20, 0.10))

	# ----- Abdomen (rear bulb — round, large) -----
	var ab_center := Vector3(0, clearance + h * 0.50, -d * 0.18)
	var ab_r: float = w * 0.45
	# Build as 2 stacked rings (4 verts each) for a chunky sphere look
	var ab_top := [
		Vector3(ab_center.x - ab_r * 0.6, ab_center.y + ab_r * 0.8, ab_center.z - ab_r * 0.6),
		Vector3(ab_center.x + ab_r * 0.6, ab_center.y + ab_r * 0.8, ab_center.z - ab_r * 0.6),
		Vector3(ab_center.x + ab_r * 0.6, ab_center.y + ab_r * 0.8, ab_center.z + ab_r * 0.6),
		Vector3(ab_center.x - ab_r * 0.6, ab_center.y + ab_r * 0.8, ab_center.z + ab_r * 0.6),
	]
	var ab_mid := [
		Vector3(ab_center.x - ab_r, ab_center.y, ab_center.z - ab_r),
		Vector3(ab_center.x + ab_r, ab_center.y, ab_center.z - ab_r),
		Vector3(ab_center.x + ab_r, ab_center.y, ab_center.z + ab_r),
		Vector3(ab_center.x - ab_r, ab_center.y, ab_center.z + ab_r),
	]
	var ab_bot := [
		Vector3(ab_center.x - ab_r * 0.55, ab_center.y - ab_r * 0.7, ab_center.z - ab_r * 0.55),
		Vector3(ab_center.x + ab_r * 0.55, ab_center.y - ab_r * 0.7, ab_center.z - ab_r * 0.55),
		Vector3(ab_center.x + ab_r * 0.55, ab_center.y - ab_r * 0.7, ab_center.z + ab_r * 0.55),
		Vector3(ab_center.x - ab_r * 0.55, ab_center.y - ab_r * 0.7, ab_center.z + ab_r * 0.55),
	]
	var st_ab := SurfaceTool.new()
	st_ab.begin(Mesh.PRIMITIVE_TRIANGLES)
	for i in range(4):
		var j: int = (i + 1) % 4
		_add_quad(st_ab, ab_top[i], ab_top[j], ab_mid[j], ab_mid[i])
		_add_quad(st_ab, ab_mid[i], ab_mid[j], ab_bot[j], ab_bot[i])
	_add_quad(st_ab, ab_top[3], ab_top[2], ab_top[1], ab_top[0])
	_add_quad(st_ab, ab_bot[0], ab_bot[1], ab_bot[2], ab_bot[3])
	st_ab.generate_normals()
	var mi_ab := MeshInstance3D.new()
	mi_ab.mesh = st_ab.commit()
	var mat_ab := StandardMaterial3D.new()
	mat_ab.albedo_color = chitin
	mat_ab.roughness = 0.50                                    # chitinous sheen
	mat_ab.metallic = 0.15
	mat_ab.cull_mode = BaseMaterial3D.CULL_DISABLED
	mi_ab.material_override = mat_ab
	root.add_child(mi_ab)

	# ----- Hourglass marking on top of abdomen (small red bar) -----
	_build_box(
		root,
		Vector3(-ab_r * 0.20, ab_center.y + ab_r * 0.79, ab_center.z - ab_r * 0.30),
		Vector3( ab_r * 0.20, ab_center.y + ab_r * 0.81, ab_center.z + ab_r * 0.30),
		marking, 0.40, 0.20
	)

	# ----- Cephalothorax (front bulb — smaller, head + thorax combined) -----
	var ct_center := Vector3(0, clearance + h * 0.40, d * 0.18)
	var ct_r: float = w * 0.30
	_build_box(
		root,
		Vector3(ct_center.x - ct_r, ct_center.y - ct_r * 0.6, ct_center.z - ct_r * 0.9),
		Vector3(ct_center.x + ct_r, ct_center.y + ct_r * 0.5, ct_center.z + ct_r * 0.9),
		chitin, 0.50, 0.15
	)

	# ----- 8 eyes in a 2-row cluster on front of cephalothorax -----
	var eye_z: float = ct_center.z + ct_r * 0.9
	for row in range(2):
		var eye_y: float = ct_center.y + ct_r * 0.30 - row * ct_r * 0.25
		for col in range(4):
			var eye_x: float = (col - 1.5) * ct_r * 0.30
			var eye_r: float = ct_r * (0.13 if col == 1 or col == 2 else 0.10)
			var st_eye := SurfaceTool.new()
			st_eye.begin(Mesh.PRIMITIVE_TRIANGLES)
			# Simple sphere as 4-sided box for low-poly
			_build_box(
				root,
				Vector3(eye_x - eye_r, eye_y - eye_r, eye_z),
				Vector3(eye_x + eye_r, eye_y + eye_r, eye_z + eye_r * 0.6),
				eye_color, 0.30, 0.10
			)

	# ----- Fangs / pedipalps — two small fangs hanging from front -----
	for side in [-1, 1]:
		var fang_root := Vector3(side * ct_r * 0.35, ct_center.y - ct_r * 0.45, ct_center.z + ct_r * 0.7)
		var fang_tip := Vector3(side * ct_r * 0.45, clearance + h * 0.15, ct_center.z + ct_r * 0.9)
		var fang_b1 := Vector3(side * ct_r * 0.25, ct_center.y - ct_r * 0.5, ct_center.z + ct_r * 0.55)
		var fang_b2 := Vector3(side * ct_r * 0.45, ct_center.y - ct_r * 0.5, ct_center.z + ct_r * 0.85)
		var st_fang := SurfaceTool.new()
		st_fang.begin(Mesh.PRIMITIVE_TRIANGLES)
		_add_tri(st_fang, fang_root, fang_b1, fang_tip)
		_add_tri(st_fang, fang_b1, fang_b2, fang_tip)
		_add_tri(st_fang, fang_b2, fang_root, fang_tip)
		st_fang.generate_normals()
		var mi_fang := MeshInstance3D.new()
		mi_fang.mesh = st_fang.commit()
		var mat_fang := StandardMaterial3D.new()
		mat_fang.albedo_color = chitin_light
		mat_fang.roughness = 0.40
		mat_fang.metallic = 0.20
		mat_fang.cull_mode = BaseMaterial3D.CULL_DISABLED
		mi_fang.material_override = mat_fang
		root.add_child(mi_fang)

	# ----- 8 LEGS — articulated, splayed outward from cephalothorax -----
	# Spider legs angle UP and OUT from the body, then DOWN to the floor.
	# 4 legs per side, distributed front-to-back along the cephalothorax.
	var leg_r: float = w * 0.040
	for side in [-1, 1]:
		for pair in range(4):
			# Z position varies — front pair forward, back pair behind cephalothorax.
			var leg_pair_t: float = float(pair) / 3.0           # 0..1
			var leg_z_offset: float = lerpf(ct_r * 0.7, -ct_r * 0.5, leg_pair_t)
			var hip_x: float = side * ct_r * 0.85
			var hip_y_leg: float = ct_center.y + ct_r * 0.10
			var hip_z: float = ct_center.z + leg_z_offset
			# Leg goes hip → high knuckle (above body) → low knuckle → foot on ground
			var arch_x: float = side * (ct_r + w * 0.30)
			var arch_y: float = clearance + h * 1.10              # raised arch above body
			var arch_z: float = ct_center.z + leg_z_offset * 1.3
			var foot_x: float = side * (ct_r + w * 0.55)
			var foot_y: float = 0.0
			var foot_z: float = ct_center.z + leg_z_offset * 1.6
			# Femur (hip → arch)
			_build_tapered_segment(
				root,
				Vector3(hip_x, hip_y_leg, hip_z), leg_r,
				Vector3(arch_x, arch_y, arch_z), leg_r * 0.85,
				chitin, 0.45, 0.20
			)
			# Tibia (arch → foot)
			_build_tapered_segment(
				root,
				Vector3(arch_x, arch_y, arch_z), leg_r * 0.85,
				Vector3(foot_x, foot_y, foot_z), leg_r * 0.50,
				chitin.darkened(0.20), 0.45, 0.20
			)

# ============================================================================
# DINOSAUR (T-Rex / Raptor) — bipedal carnivore, huge head, tiny arms,
# heavy counterbalance tail, raptor stance leaning forward at the hips
# ============================================================================
##
## Key traits:
##   FORWARD-LEANING BODY (horizontal, not vertical like humanoid)
##   HEAVY THICK TAIL counterbalances head (spine horizontal at hips)
##   HUGE HEAD with long toothy jaw
##   TINY VESTIGIAL ARMS at chest
##   POWERFUL THICK LEGS with reverse-knee digitigrade stance
##   3 large clawed toes per foot

static func _build_dinosaur(plan: Dictionary, root: Node3D) -> void:
	var base: Dictionary = plan.get("base", {})
	var palette: Dictionary = plan.get("palette", {})
	var limbs: Dictionary = plan.get("limbs", {})

	var w: float = _axis(base, "width", 0.70)
	var h: float = _axis(base, "height", 0.85)
	var d: float = _axis(base, "depth", 1.40)
	var leg_length: float = float(limbs.get("leg_length", 0.75))
	var clearance: float = leg_length

	var scale_color: Color = palette.get("primary", Color(0.38, 0.32, 0.22))
	var belly_color: Color = palette.get("secondary", Color(0.55, 0.50, 0.38))
	var claw_color: Color = Color(0.10, 0.08, 0.06)
	var eye_color: Color = palette.get("eye", Color(0.85, 0.65, 0.10))
	var tooth_color: Color = Color(0.92, 0.86, 0.72)

	# ----- Torso: 5 rings along the SPINE which is roughly horizontal at hip height.
	# Hip at z=0 is the anchor; chest leans forward (+z), tail base at -z.
	var hip_y: float = clearance + h * 0.30
	# Spine goes from tail base (back, slightly lower) through hip → chest → neck base (forward, slightly higher)
	# but stays close to horizontal — Trex profile.
	var spine := [
		Vector3(0, hip_y - h * 0.10, -d * 0.45),  # 0 — tail-base attach
		Vector3(0, hip_y, -d * 0.20),             # 1 — hip
		Vector3(0, hip_y + h * 0.05, d * 0.05),   # 2 — mid back
		Vector3(0, hip_y + h * 0.10, d * 0.30),   # 3 — chest / shoulder
		Vector3(0, hip_y + h * 0.20, d * 0.55),   # 4 — base of neck
	]
	var spine_r := [w * 0.32, w * 0.45, w * 0.42, w * 0.40, w * 0.30]

	var st := SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	# Build 8-vertex rings around each spine point on YZ-perpendicular plane.
	# Since spine is mostly along Z, ring is in XY plane (oblong: tall rather than wide).
	var rings: Array = []
	for i in range(spine.size()):
		var c: Vector3 = spine[i]
		var r: float = spine_r[i]
		var verts: Array = []
		for j in range(8):
			var ang: float = TAU * float(j) / 8.0
			# Width on X, height on Y; flatten slightly on top/bottom
			verts.append(Vector3(c.x + cos(ang) * r * 0.95,
								  c.y + sin(ang) * r * 1.05,
								  c.z))
		rings.append(verts)
	for i in range(spine.size() - 1):
		var ring_a: Array = rings[i]
		var ring_b: Array = rings[i + 1]
		for j in range(8):
			var k: int = (j + 1) % 8
			_add_quad(st, ring_a[j], ring_a[k], ring_b[k], ring_b[j])
	st.generate_normals()
	var mi := MeshInstance3D.new()
	mi.mesh = st.commit()
	var mat := StandardMaterial3D.new()
	mat.albedo_color = scale_color
	mat.roughness = 0.75
	mat.cull_mode = BaseMaterial3D.CULL_DISABLED
	mi.material_override = mat
	root.add_child(mi)

	# ----- Belly stripe (lighter underbelly) -----
	for i in range(spine.size() - 1):
		var ra: Array = rings[i]
		var rb: Array = rings[i + 1]
		# Bottom strip uses vertices roughly at indices 5,6,7 (lower half)
		var st_b := SurfaceTool.new()
		st_b.begin(Mesh.PRIMITIVE_TRIANGLES)
		_add_quad(st_b, ra[5], ra[6], rb[6], rb[5])
		_add_quad(st_b, ra[6], ra[7], rb[7], rb[6])
		st_b.generate_normals()
		var mi_b := MeshInstance3D.new()
		mi_b.mesh = st_b.commit()
		var mat_b := StandardMaterial3D.new()
		mat_b.albedo_color = belly_color
		mat_b.roughness = 0.85
		mat_b.cull_mode = BaseMaterial3D.CULL_DISABLED
		mi_b.material_override = mat_b
		root.add_child(mi_b)

	# ----- Tail — 5 tapered segments curving back and slightly down -----
	var tail_segments := 5
	var tail_start: Vector3 = spine[0]
	var tail_start_r: float = spine_r[0]
	for i in range(tail_segments):
		var t0: float = float(i) / float(tail_segments)
		var t1: float = float(i + 1) / float(tail_segments)
		var p0 := Vector3(0, tail_start.y - t0 * h * 0.18, tail_start.z - t0 * d * 0.95)
		var p1 := Vector3(0, tail_start.y - t1 * h * 0.18, tail_start.z - t1 * d * 0.95)
		var r0: float = tail_start_r * (1.0 - t0 * 0.85)
		var r1: float = tail_start_r * (1.0 - t1 * 0.85)
		_build_tapered_segment(root, p0, r0, p1, r1, scale_color, 0.75)

	# ----- Neck — short segment from spine[4] to head base -----
	var neck_base: Vector3 = spine[4]
	var head_base := Vector3(0, neck_base.y + h * 0.10, neck_base.z + d * 0.18)
	_build_tapered_segment(root, neck_base, spine_r[4], head_base, w * 0.28, scale_color, 0.75)

	# ----- HEAD — wide jaw, narrow snout. Built as two boxes (cranium + jaw). -----
	var head_w: float = w * 0.40
	var head_h: float = h * 0.30
	var head_d: float = d * 0.32
	# Cranium (upper)
	_build_box(
		root,
		Vector3(head_base.x - head_w * 0.45, head_base.y - head_h * 0.05, head_base.z),
		Vector3(head_base.x + head_w * 0.45, head_base.y + head_h * 0.55, head_base.z + head_d * 0.80),
		scale_color, 0.70
	)
	# Snout (forward of cranium, narrower)
	_build_box(
		root,
		Vector3(head_base.x - head_w * 0.32, head_base.y - head_h * 0.10, head_base.z + head_d * 0.55),
		Vector3(head_base.x + head_w * 0.32, head_base.y + head_h * 0.35, head_base.z + head_d * 1.05),
		scale_color, 0.70
	)
	# Lower jaw — opens slightly downward
	_build_box(
		root,
		Vector3(head_base.x - head_w * 0.32, head_base.y - head_h * 0.25, head_base.z + head_d * 0.20),
		Vector3(head_base.x + head_w * 0.32, head_base.y - head_h * 0.05, head_base.z + head_d * 1.00),
		scale_color.darkened(0.15), 0.70
	)
	# Teeth strip — small upper teeth row
	var tooth_y: float = head_base.y - head_h * 0.05
	for i in range(6):
		var tx: float = lerpf(-head_w * 0.28, head_w * 0.28, float(i) / 5.0)
		_build_box(
			root,
			Vector3(head_base.x + tx - head_w * 0.04, tooth_y - head_h * 0.10, head_base.z + head_d * 0.60),
			Vector3(head_base.x + tx + head_w * 0.04, tooth_y, head_base.z + head_d * 1.02),
			tooth_color, 0.50
		)
	# Eyes — set high & forward on cranium for binocular vision
	for side in [-1, 1]:
		_build_box(
			root,
			Vector3(head_base.x + side * head_w * 0.38, head_base.y + head_h * 0.30, head_base.z + head_d * 0.20),
			Vector3(head_base.x + side * head_w * 0.48, head_base.y + head_h * 0.45, head_base.z + head_d * 0.40),
			eye_color, 0.30, 0.10
		)
	# Brow ridges
	for side in [-1, 1]:
		_build_box(
			root,
			Vector3(head_base.x + side * head_w * 0.35, head_base.y + head_h * 0.48, head_base.z + head_d * 0.15),
			Vector3(head_base.x + side * head_w * 0.50, head_base.y + head_h * 0.60, head_base.z + head_d * 0.45),
			scale_color.darkened(0.30), 0.80
		)

	# ----- Tiny vestigial arms — two stubby segments at the chest -----
	for side in [-1, 1]:
		var shoulder := Vector3(side * w * 0.30, spine[3].y + h * 0.02, spine[3].z + d * 0.05)
		var elbow := Vector3(side * (w * 0.30 + w * 0.10), spine[3].y - h * 0.08, spine[3].z + d * 0.18)
		var hand := Vector3(side * (w * 0.30 + w * 0.15), spine[3].y - h * 0.18, spine[3].z + d * 0.25)
		_build_tapered_segment(root, shoulder, w * 0.08, elbow, w * 0.06, scale_color)
		_build_tapered_segment(root, elbow, w * 0.06, hand, w * 0.04, scale_color)
		# Two tiny claws
		for cside in [-1, 1]:
			var claw_root := Vector3(hand.x + cside * w * 0.015, hand.y, hand.z + 0.01)
			var claw_tip := Vector3(hand.x + cside * w * 0.025, hand.y - h * 0.04, hand.z + 0.04)
			_build_tapered_segment(root, claw_root, w * 0.012, claw_tip, w * 0.004, claw_color, 0.40)

	# ----- LEGS — bipedal, digitigrade (knee bends backward at "ankle") -----
	for side in [-1, 1]:
		var hip_x: float = side * w * 0.30
		var hip_pos := Vector3(hip_x, hip_y - h * 0.05, -d * 0.10)
		# Knee forward, ankle back (digitigrade)
		var knee := Vector3(hip_x, clearance * 0.55, d * 0.08)
		var ankle := Vector3(hip_x, clearance * 0.20, -d * 0.05)
		var foot := Vector3(hip_x, 0.0, d * 0.15)
		# Femur — thigh
		_build_tapered_segment(root, hip_pos, w * 0.18, knee, w * 0.14, scale_color, 0.78)
		# Tibia — shin
		_build_tapered_segment(root, knee, w * 0.13, ankle, w * 0.10, scale_color.darkened(0.10), 0.78)
		# Metatarsal — ankle to foot
		_build_tapered_segment(root, ankle, w * 0.10, foot, w * 0.09, scale_color.darkened(0.15), 0.78)
		# 3 large clawed toes
		for ti in range(3):
			var toe_offset: float = (ti - 1) * w * 0.07
			var toe_tip := Vector3(foot.x + toe_offset, 0.0, foot.z + w * 0.20)
			_build_tapered_segment(root, foot, w * 0.06, toe_tip, w * 0.03, scale_color.darkened(0.10), 0.70)
			# Claw at tip
			var claw_tip := Vector3(toe_tip.x, 0.01, toe_tip.z + w * 0.08)
			_build_tapered_segment(root, toe_tip, w * 0.03, claw_tip, w * 0.005, claw_color, 0.40)

# ============================================================================
# SNAKE — coiled segmented body, no limbs, raised head with fangs
# ============================================================================
##
## Key traits:
##   COILED BODY of 10+ ring segments curving along an S-curve
##   THICKER MID-BODY tapering to head and tail
##   RAISED HEAD held above coils
##   WIDE TRIANGULAR JAW with visible fangs
##   FORKED TONGUE

static func _build_snake(plan: Dictionary, root: Node3D) -> void:
	var base: Dictionary = plan.get("base", {})
	var palette: Dictionary = plan.get("palette", {})

	var w: float = _axis(base, "width", 0.60)
	var h: float = _axis(base, "height", 0.40)
	var d: float = _axis(base, "depth", 1.20)

	var scale_color: Color = palette.get("primary", Color(0.30, 0.55, 0.20))
	var belly_color: Color = palette.get("secondary", Color(0.85, 0.78, 0.55))
	var marking: Color = palette.get("accent", Color(0.15, 0.25, 0.10))
	var eye_color: Color = palette.get("eye", Color(0.90, 0.75, 0.10))
	var fang_color: Color = Color(0.92, 0.88, 0.72)
	var tongue_color: Color = Color(0.60, 0.10, 0.15)

	# ----- Body — 12 ring segments along an S-curve. The snake lies coiled
	# on the ground but with head raised up at the front (+z end).
	var seg_count: int = 12
	# Parametric path: (x(t), y(t), z(t))
	# t = 0 at tail tip (back), t = 1 at head base (front-raised)
	var path: Array = []
	for i in range(seg_count + 1):
		var t: float = float(i) / float(seg_count)
		# X: S-curve coil
		var x: float = sin(t * PI * 1.8) * w * 0.45
		# Y: stays low for most of body, rises sharply for head end
		var y: float = h * 0.18 + smoothstep(0.75, 1.0, t) * h * 0.85
		# Z: tail at -d, head at +d
		var z: float = lerpf(-d * 0.55, d * 0.55, t)
		path.append(Vector3(x, y, z))
	# Radius profile — narrow at both ends, thickest in middle 2/3
	var radii: Array = []
	for i in range(seg_count + 1):
		var t: float = float(i) / float(seg_count)
		var r: float = w * 0.18 * sin(t * PI)        # 0 at ends, peak at middle
		r = max(r, w * 0.07)                          # never thinner than this
		# Slightly larger head
		if t > 0.92:
			r = w * 0.20
		radii.append(r)

	# Build 6-vertex rings (hexagonal cross-section) along the path,
	# oriented perpendicular to the local path direction.
	var st := SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	var st_belly := SurfaceTool.new()
	st_belly.begin(Mesh.PRIMITIVE_TRIANGLES)
	var rings: Array = []
	for i in range(path.size()):
		var c: Vector3 = path[i]
		var r: float = radii[i]
		# Local forward direction (tangent)
		var fwd: Vector3
		if i == 0:
			fwd = (path[1] - path[0]).normalized()
		elif i == path.size() - 1:
			fwd = (path[i] - path[i - 1]).normalized()
		else:
			fwd = (path[i + 1] - path[i - 1]).normalized()
		# Build "up" perpendicular to fwd
		var up := Vector3.UP
		var right := fwd.cross(up).normalized()
		up = right.cross(fwd).normalized()
		var verts: Array = []
		for j in range(6):
			var ang: float = TAU * float(j) / 6.0
			var offset: Vector3 = right * cos(ang) * r + up * sin(ang) * r
			verts.append(c + offset)
		rings.append(verts)
	for i in range(rings.size() - 1):
		var ra: Array = rings[i]
		var rb: Array = rings[i + 1]
		for j in range(6):
			var k: int = (j + 1) % 6
			# Top half = scales, bottom half = belly
			if j < 3:
				_add_quad(st, ra[j], ra[k], rb[k], rb[j])
			else:
				_add_quad(st_belly, ra[j], ra[k], rb[k], rb[j])
	st.generate_normals()
	var mi := MeshInstance3D.new()
	mi.mesh = st.commit()
	var mat := StandardMaterial3D.new()
	mat.albedo_color = scale_color
	mat.roughness = 0.55
	mat.metallic = 0.10
	mat.cull_mode = BaseMaterial3D.CULL_DISABLED
	mi.material_override = mat
	root.add_child(mi)
	st_belly.generate_normals()
	var mi_belly := MeshInstance3D.new()
	mi_belly.mesh = st_belly.commit()
	var mat_belly := StandardMaterial3D.new()
	mat_belly.albedo_color = belly_color
	mat_belly.roughness = 0.85
	mat_belly.cull_mode = BaseMaterial3D.CULL_DISABLED
	mi_belly.material_override = mat_belly
	root.add_child(mi_belly)

	# ----- Diamond markings along the back -----
	for i in range(2, seg_count - 1, 2):
		var ra: Array = rings[i]
		var rb: Array = rings[i + 1]
		var st_m := SurfaceTool.new()
		st_m.begin(Mesh.PRIMITIVE_TRIANGLES)
		# Top vertex (ra[0] is at angle 0 = +right; ra at indices 0..2 are top half)
		# Use ring vertex 1 (top) and surrounding for diamond patch
		_add_tri(st_m, ra[1], rb[1], (ra[1] + rb[1]) * 0.5 + Vector3(0, 0.005, 0))
		st_m.generate_normals()
		var mi_m := MeshInstance3D.new()
		mi_m.mesh = st_m.commit()
		var mat_m := StandardMaterial3D.new()
		mat_m.albedo_color = marking
		mat_m.roughness = 0.50
		mat_m.cull_mode = BaseMaterial3D.CULL_DISABLED
		mi_m.material_override = mat_m
		root.add_child(mi_m)

	# ----- HEAD — wedge-shaped, wider than body, at end of path. -----
	var head_base: Vector3 = path[seg_count]
	var head_fwd: Vector3 = (path[seg_count] - path[seg_count - 1]).normalized()
	var head_right: Vector3 = head_fwd.cross(Vector3.UP).normalized()
	var head_up: Vector3 = head_right.cross(head_fwd).normalized()
	var head_w: float = w * 0.28
	var head_h: float = h * 0.18
	var head_d: float = d * 0.20
	# Build a 4-vertex back + 2-vertex front (wedge): wide at back narrowing to point.
	var hBL: Vector3 = head_base + head_right * (-head_w) + head_up * (-head_h * 0.6)
	var hBR: Vector3 = head_base + head_right * head_w + head_up * (-head_h * 0.6)
	var hTL: Vector3 = head_base + head_right * (-head_w * 0.6) + head_up * head_h
	var hTR: Vector3 = head_base + head_right * head_w * 0.6 + head_up * head_h
	var hFL: Vector3 = head_base + head_fwd * head_d + head_right * (-head_w * 0.15) + head_up * (-head_h * 0.20)
	var hFR: Vector3 = head_base + head_fwd * head_d + head_right * head_w * 0.15 + head_up * (-head_h * 0.20)
	var hFT: Vector3 = head_base + head_fwd * head_d * 0.95 + head_up * head_h * 0.3
	var st_head := SurfaceTool.new()
	st_head.begin(Mesh.PRIMITIVE_TRIANGLES)
	# Bottom (jaw)
	_add_quad(st_head, hBL, hBR, hFR, hFL)
	# Top — single triangle (apex at hFT)
	_add_tri(st_head, hTL, hTR, hFT)
	# Left side
	_add_quad(st_head, hBL, hFL, hFT, hTL)
	# Right side
	_add_quad(st_head, hBR, hTR, hFT, hFR)
	# Back (connects head to last body ring approximately)
	_add_quad(st_head, hBL, hTL, hTR, hBR)
	st_head.generate_normals()
	var mi_head := MeshInstance3D.new()
	mi_head.mesh = st_head.commit()
	var mat_head := StandardMaterial3D.new()
	mat_head.albedo_color = scale_color.darkened(0.05)
	mat_head.roughness = 0.60
	mat_head.cull_mode = BaseMaterial3D.CULL_DISABLED
	mi_head.material_override = mat_head
	root.add_child(mi_head)

	# ----- Eyes — small glowing on top sides of head -----
	for side_idx in range(2):
		var eside: float = -1.0 if side_idx == 0 else 1.0
		var eye_pos: Vector3 = head_base + head_fwd * head_d * 0.45 + head_right * eside * head_w * 0.55 + head_up * head_h * 0.55
		_build_box(
			root,
			eye_pos - head_right * head_w * 0.10 - head_up * head_h * 0.10,
			eye_pos + head_right * head_w * 0.10 + head_up * head_h * 0.10,
			eye_color, 0.20, 0.20
		)

	# ----- Two fangs hanging from front of jaw -----
	for side_idx in range(2):
		var fside: float = -1.0 if side_idx == 0 else 1.0
		var fang_top: Vector3 = head_base + head_fwd * head_d * 0.75 + head_right * fside * head_w * 0.30 + head_up * (-head_h * 0.3)
		var fang_tip: Vector3 = fang_top + head_up * (-head_h * 0.55) + head_fwd * 0.02
		_build_tapered_segment(root, fang_top, head_w * 0.05, fang_tip, head_w * 0.01, fang_color, 0.30)

	# ----- Forked tongue extending forward -----
	var tongue_root: Vector3 = head_base + head_fwd * head_d * 0.95 + head_up * (-head_h * 0.15)
	var tongue_mid: Vector3 = tongue_root + head_fwd * (d * 0.12)
	var tongue_fork_l: Vector3 = tongue_mid + head_fwd * (d * 0.06) + head_right * (-head_w * 0.10)
	var tongue_fork_r: Vector3 = tongue_mid + head_fwd * (d * 0.06) + head_right * head_w * 0.10
	_build_tapered_segment(root, tongue_root, w * 0.025, tongue_mid, w * 0.018, tongue_color, 0.30)
	_build_tapered_segment(root, tongue_mid, w * 0.014, tongue_fork_l, w * 0.005, tongue_color, 0.30)
	_build_tapered_segment(root, tongue_mid, w * 0.014, tongue_fork_r, w * 0.005, tongue_color, 0.30)

# ============================================================================
# BRUTE HUMANOID (Ogre / Giant / Bugbear / Hill Giant) — large, hunched,
# thick-limbed bipedal with prominent gut and oversized hands
# ============================================================================
##
## Key traits:
##   HUNCHED POSTURE — torso leans slightly forward
##   THICK BARREL CHEST + POT BELLY
##   OVERSIZED HANDS that hang past the knees
##   BLOCKY HEAD with low brow
##   SHORT THICK LEGS, big flat feet
##   No tail (humanoid)

static func _build_brute_humanoid(plan: Dictionary, root: Node3D) -> void:
	var base: Dictionary = plan.get("base", {})
	var palette: Dictionary = plan.get("palette", {})
	var limbs: Dictionary = plan.get("limbs", {})

	var w: float = _axis(base, "width", 0.85)
	var h: float = _axis(base, "height", 1.30)
	var d: float = _axis(base, "depth", 0.55)
	var leg_length: float = float(limbs.get("leg_length", 0.65))
	var clearance: float = leg_length

	var skin: Color = palette.get("primary", Color(0.55, 0.45, 0.35))
	var skin_dark: Color = skin.darkened(0.20)
	var belly_skin: Color = palette.get("secondary", skin.lightened(0.10))
	var hair_color: Color = palette.get("accent", Color(0.20, 0.15, 0.10))
	var eye_color: Color = palette.get("eye", Color(0.85, 0.75, 0.30))
	var tusk_color: Color = Color(0.95, 0.88, 0.70)
	var nail_color: Color = Color(0.25, 0.18, 0.12)

	# ----- Torso: 4 rings stacked, hunched forward at top -----
	# Hips (low), waist, chest, shoulder base. Shoulders lean forward.
	var hip_y: float = clearance
	var waist_y: float = clearance + h * 0.25
	var chest_y: float = clearance + h * 0.55
	var shoulder_y: float = clearance + h * 0.82
	# Z: hunched profile — chest leans forward, hips behind
	var torso_centers := [
		Vector3(0, hip_y, -d * 0.05),       # hips
		Vector3(0, waist_y, 0.0),            # waist (gut)
		Vector3(0, chest_y, d * 0.05),       # chest
		Vector3(0, shoulder_y, d * 0.10),    # shoulder
	]
	# Radius profile — gut is widest
	var torso_r := [
		Vector3(w * 0.45, h * 0.08, d * 0.50),  # hips
		Vector3(w * 0.55, h * 0.08, d * 0.60),  # gut (widest)
		Vector3(w * 0.52, h * 0.08, d * 0.50),  # chest
		Vector3(w * 0.50, h * 0.08, d * 0.42),  # shoulder
	]
	# Build 8-vert rings (oval cross-section per torso_r)
	var st := SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	var st_belly := SurfaceTool.new()
	st_belly.begin(Mesh.PRIMITIVE_TRIANGLES)
	var rings: Array = []
	for i in range(torso_centers.size()):
		var c: Vector3 = torso_centers[i]
		var rv: Vector3 = torso_r[i]
		var verts: Array = []
		for j in range(8):
			var ang: float = TAU * float(j) / 8.0
			verts.append(Vector3(c.x + cos(ang) * rv.x,
								  c.y,
								  c.z + sin(ang) * rv.z))
		rings.append(verts)
	for i in range(rings.size() - 1):
		var ra: Array = rings[i]
		var rb: Array = rings[i + 1]
		for j in range(8):
			var k: int = (j + 1) % 8
			# Front-belly facing strip (indices 1-3 face +z): use belly color
			if j == 1 or j == 2:
				_add_quad(st_belly, ra[j], ra[k], rb[k], rb[j])
			else:
				_add_quad(st, ra[j], ra[k], rb[k], rb[j])
	# Close top + bottom
	_add_quad(st, rings[3][0], rings[3][1], rings[3][2], rings[3][3])
	_add_quad(st, rings[3][4], rings[3][5], rings[3][6], rings[3][7])
	_add_quad(st, rings[0][3], rings[0][2], rings[0][1], rings[0][0])
	_add_quad(st, rings[0][7], rings[0][6], rings[0][5], rings[0][4])
	st.generate_normals()
	var mi := MeshInstance3D.new()
	mi.mesh = st.commit()
	var mat := StandardMaterial3D.new()
	mat.albedo_color = skin
	mat.roughness = 0.85
	mat.cull_mode = BaseMaterial3D.CULL_DISABLED
	mi.material_override = mat
	root.add_child(mi)
	st_belly.generate_normals()
	var mi_b := MeshInstance3D.new()
	mi_b.mesh = st_belly.commit()
	var mat_b := StandardMaterial3D.new()
	mat_b.albedo_color = belly_skin
	mat_b.roughness = 0.90
	mat_b.cull_mode = BaseMaterial3D.CULL_DISABLED
	mi_b.material_override = mat_b
	root.add_child(mi_b)

	# ----- NECK — short thick stub leaning forward -----
	var neck_base: Vector3 = torso_centers[3]
	var head_anchor: Vector3 = neck_base + Vector3(0, h * 0.15, d * 0.10)
	_build_tapered_segment(root, neck_base + Vector3(0, h * 0.02, 0), w * 0.22, head_anchor, w * 0.20, skin, 0.88)

	# ----- HEAD — blocky cranium with low forehead -----
	var head_w: float = w * 0.32
	var head_h: float = h * 0.20
	var head_d: float = d * 0.50
	# Cranium
	_build_box(
		root,
		Vector3(head_anchor.x - head_w, head_anchor.y - head_h * 0.05, head_anchor.z - head_d * 0.40),
		Vector3(head_anchor.x + head_w, head_anchor.y + head_h * 0.85, head_anchor.z + head_d * 0.40),
		skin, 0.88
	)
	# Jaw — protruding forward
	_build_box(
		root,
		Vector3(head_anchor.x - head_w * 0.85, head_anchor.y - head_h * 0.30, head_anchor.z - head_d * 0.20),
		Vector3(head_anchor.x + head_w * 0.85, head_anchor.y, head_anchor.z + head_d * 0.55),
		skin_dark, 0.88
	)
	# Heavy brow ridge
	_build_box(
		root,
		Vector3(head_anchor.x - head_w, head_anchor.y + head_h * 0.45, head_anchor.z + head_d * 0.30),
		Vector3(head_anchor.x + head_w, head_anchor.y + head_h * 0.65, head_anchor.z + head_d * 0.45),
		skin_dark, 0.85
	)
	# Eyes — under brow, small recessed
	for side_e in [-1, 1]:
		_build_box(
			root,
			Vector3(head_anchor.x + side_e * head_w * 0.30 - head_w * 0.10, head_anchor.y + head_h * 0.25, head_anchor.z + head_d * 0.35),
			Vector3(head_anchor.x + side_e * head_w * 0.30 + head_w * 0.10, head_anchor.y + head_h * 0.42, head_anchor.z + head_d * 0.45),
			eye_color, 0.30, 0.10
		)
	# Two protruding tusks (lower jaw)
	for side_t in [-1, 1]:
		var tusk_root := Vector3(head_anchor.x + side_t * head_w * 0.50, head_anchor.y - head_h * 0.05, head_anchor.z + head_d * 0.40)
		var tusk_tip := Vector3(head_anchor.x + side_t * head_w * 0.55, head_anchor.y + head_h * 0.20, head_anchor.z + head_d * 0.45)
		_build_tapered_segment(root, tusk_root, head_w * 0.10, tusk_tip, head_w * 0.025, tusk_color, 0.40)
	# Hair tuft on top
	_build_box(
		root,
		Vector3(head_anchor.x - head_w * 0.70, head_anchor.y + head_h * 0.80, head_anchor.z - head_d * 0.20),
		Vector3(head_anchor.x + head_w * 0.70, head_anchor.y + head_h * 1.10, head_anchor.z + head_d * 0.30),
		hair_color, 0.95
	)

	# ----- ARMS — thick, long (hands past knees) -----
	for side in [-1, 1]:
		var shoulder := Vector3(side * w * 0.55, shoulder_y, torso_centers[3].z)
		var elbow := Vector3(side * w * 0.70, clearance + h * 0.35, torso_centers[2].z + d * 0.10)
		var wrist := Vector3(side * w * 0.65, clearance - h * 0.05, torso_centers[1].z + d * 0.05)
		var hand_tip := Vector3(side * w * 0.65, clearance - h * 0.20, torso_centers[1].z + d * 0.05)
		# Upper arm — thick
		_build_tapered_segment(root, shoulder, w * 0.16, elbow, w * 0.14, skin, 0.85)
		# Forearm
		_build_tapered_segment(root, elbow, w * 0.13, wrist, w * 0.12, skin, 0.85)
		# Massive fist — box
		_build_box(
			root,
			Vector3(wrist.x - w * 0.16, wrist.y - h * 0.18, wrist.z - d * 0.15),
			Vector3(wrist.x + w * 0.16, wrist.y + h * 0.02, wrist.z + d * 0.15),
			skin_dark, 0.88
		)
		# Knuckle bumps
		for ki in range(3):
			var kx: float = lerpf(-w * 0.12, w * 0.12, float(ki + 1) / 4.0)
			_build_box(
				root,
				Vector3(wrist.x + side * 0 + kx - w * 0.04, wrist.y - h * 0.05, wrist.z + d * 0.12),
				Vector3(wrist.x + side * 0 + kx + w * 0.04, wrist.y + h * 0.02, wrist.z + d * 0.18),
				nail_color, 0.50
			)

	# ----- LEGS — short, thick. Front knees, big flat feet. -----
	for side in [-1, 1]:
		var hip_x: float = side * w * 0.25
		var hip_pos := Vector3(hip_x, hip_y + h * 0.05, torso_centers[0].z)
		var knee := Vector3(hip_x, clearance * 0.55, d * 0.06)
		var ankle := Vector3(hip_x, clearance * 0.10, 0.0)
		var foot_center := Vector3(hip_x, 0.0, d * 0.10)
		# Thigh
		_build_tapered_segment(root, hip_pos, w * 0.22, knee, w * 0.18, skin, 0.88)
		# Shin
		_build_tapered_segment(root, knee, w * 0.17, ankle, w * 0.13, skin, 0.88)
		# Big flat foot — box
		_build_box(
			root,
			Vector3(foot_center.x - w * 0.15, 0.0, foot_center.z - d * 0.20),
			Vector3(foot_center.x + w * 0.15, h * 0.05, foot_center.z + d * 0.25),
			skin_dark, 0.90
		)
		# Toe nails — 3 chunky
		for ti in range(3):
			var tx: float = lerpf(-w * 0.10, w * 0.10, float(ti) / 2.0)
			_build_box(
				root,
				Vector3(foot_center.x + tx - w * 0.025, h * 0.005, foot_center.z + d * 0.21),
				Vector3(foot_center.x + tx + w * 0.025, h * 0.04, foot_center.z + d * 0.26),
				nail_color, 0.55
			)

# ============================================================================
# BIRD (Eagle / Hawk / Raven) — streamlined body, large wings, sharp beak,
# long talons. Stands upright or perched.
# ============================================================================
##
## Key traits:
##   STREAMLINED OVAL BODY (egg-shaped)
##   LARGE TRIANGULAR WINGS folded against sides (or partial spread)
##   SHARP HOOKED BEAK (predator) or pointed straight beak
##   SMALL HEAD with prominent eyes
##   THIN STRONG LEGS ending in 4 talons each (3 forward, 1 back)
##   FAN TAIL

static func _build_bird(plan: Dictionary, root: Node3D) -> void:
	var base: Dictionary = plan.get("base", {})
	var palette: Dictionary = plan.get("palette", {})
	var limbs: Dictionary = plan.get("limbs", {})

	var w: float = _axis(base, "width", 0.45)
	var h: float = _axis(base, "height", 0.55)
	var d: float = _axis(base, "depth", 0.80)
	var leg_length: float = float(limbs.get("leg_length", 0.30))
	var clearance: float = leg_length

	var feather: Color = palette.get("primary", Color(0.45, 0.30, 0.18))
	var feather_dark: Color = feather.darkened(0.25)
	var belly: Color = palette.get("secondary", Color(0.85, 0.80, 0.70))
	var beak_color: Color = palette.get("accent", Color(0.95, 0.78, 0.20))
	var eye_color: Color = palette.get("eye", Color(0.95, 0.85, 0.10))
	var talon_color: Color = Color(0.15, 0.10, 0.05)

	# ----- BODY — 5 rings forming an oval/egg shape, tail behind -----
	var body_y: float = clearance + h * 0.30
	var body_centers := [
		Vector3(0, body_y, -d * 0.35),                  # 0 — tail base (back)
		Vector3(0, body_y + h * 0.05, -d * 0.15),       # 1 — rump
		Vector3(0, body_y + h * 0.10, d * 0.05),        # 2 — mid
		Vector3(0, body_y + h * 0.12, d * 0.20),        # 3 — chest
		Vector3(0, body_y + h * 0.15, d * 0.30),        # 4 — neck base (forward)
	]
	var body_r := [w * 0.18, w * 0.30, w * 0.40, w * 0.38, w * 0.28]

	var st := SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	var st_belly := SurfaceTool.new()
	st_belly.begin(Mesh.PRIMITIVE_TRIANGLES)
	var rings: Array = []
	for i in range(body_centers.size()):
		var c: Vector3 = body_centers[i]
		var r: float = body_r[i]
		var verts: Array = []
		for j in range(8):
			var ang: float = TAU * float(j) / 8.0
			verts.append(Vector3(c.x + cos(ang) * r,
								  c.y + sin(ang) * r * 1.10,
								  c.z))
		rings.append(verts)
	for i in range(rings.size() - 1):
		var ra: Array = rings[i]
		var rb: Array = rings[i + 1]
		for j in range(8):
			var k: int = (j + 1) % 8
			# Bottom 3 segments = belly
			if j >= 5:
				_add_quad(st_belly, ra[j], ra[k], rb[k], rb[j])
			else:
				_add_quad(st, ra[j], ra[k], rb[k], rb[j])
	st.generate_normals()
	var mi := MeshInstance3D.new()
	mi.mesh = st.commit()
	var mat := StandardMaterial3D.new()
	mat.albedo_color = feather
	mat.roughness = 0.80
	mat.cull_mode = BaseMaterial3D.CULL_DISABLED
	mi.material_override = mat
	root.add_child(mi)
	st_belly.generate_normals()
	var mi_b := MeshInstance3D.new()
	mi_b.mesh = st_belly.commit()
	var mat_b := StandardMaterial3D.new()
	mat_b.albedo_color = belly
	mat_b.roughness = 0.90
	mat_b.cull_mode = BaseMaterial3D.CULL_DISABLED
	mi_b.material_override = mat_b
	root.add_child(mi_b)

	# ----- FAN TAIL — wide flat triangular feathers fanning out behind -----
	var tail_root: Vector3 = body_centers[0] + Vector3(0, 0, -w * 0.05)
	var tail_count: int = 7
	for i in range(tail_count):
		var t: float = float(i) / float(tail_count - 1) - 0.5   # -0.5 .. 0.5
		var feather_dir: float = t * 1.4                          # spread angle
		var feather_tip := Vector3(
			tail_root.x + sin(feather_dir) * d * 0.45,
			tail_root.y - 0.02,
			tail_root.z - cos(feather_dir) * d * 0.45
		)
		var fc: Color = feather if (i % 2 == 0) else feather_dark
		_build_tapered_segment(root, tail_root, w * 0.05, feather_tip, w * 0.02, fc, 0.85)

	# ----- WINGS — large triangular shapes folded against sides -----
	# Each wing: shoulder → wingtip back, with secondaries
	for side in [-1, 1]:
		var shoulder := Vector3(side * w * 0.35, body_y + h * 0.18, body_centers[3].z)
		var wingtip := Vector3(side * w * 0.55, body_y, body_centers[1].z - d * 0.05)
		var primary_mid := Vector3(side * w * 0.50, body_y + h * 0.05, body_centers[2].z - d * 0.05)
		# Build wing as flat triangle fan
		var st_wing := SurfaceTool.new()
		st_wing.begin(Mesh.PRIMITIVE_TRIANGLES)
		var sh_top := shoulder + Vector3(0, 0.005, 0)
		var sh_bot := shoulder + Vector3(0, -0.005, 0)
		_add_tri(st_wing, sh_top, primary_mid, wingtip)
		_add_tri(st_wing, sh_bot, wingtip, primary_mid)
		# Trailing edge — connect wingtip back toward rump
		var trail := Vector3(side * w * 0.30, body_y - h * 0.05, body_centers[1].z)
		_add_tri(st_wing, sh_top, wingtip, trail)
		_add_tri(st_wing, sh_bot, trail, wingtip)
		st_wing.generate_normals()
		var mi_w := MeshInstance3D.new()
		mi_w.mesh = st_wing.commit()
		var mat_w := StandardMaterial3D.new()
		mat_w.albedo_color = feather_dark
		mat_w.roughness = 0.80
		mat_w.cull_mode = BaseMaterial3D.CULL_DISABLED
		mi_w.material_override = mat_w
		root.add_child(mi_w)
		# Primary feather details (3 longer feathers near tip)
		for i in range(3):
			var pft: float = float(i) / 2.0    # 0..1
			var p_start := primary_mid.lerp(wingtip, pft)
			var p_end := p_start + Vector3(side * w * 0.08, -h * 0.04, -d * 0.06)
			_build_tapered_segment(root, p_start, w * 0.018, p_end, w * 0.008, feather_dark.darkened(0.10), 0.85)

	# ----- NECK & HEAD -----
	var neck_base: Vector3 = body_centers[4]
	var head_anchor: Vector3 = neck_base + Vector3(0, h * 0.15, d * 0.10)
	_build_tapered_segment(root, neck_base, w * 0.18, head_anchor, w * 0.15, feather, 0.80)
	# Head — small rounded box
	var head_w: float = w * 0.22
	var head_h: float = h * 0.18
	var head_d: float = d * 0.20
	_build_box(
		root,
		Vector3(head_anchor.x - head_w, head_anchor.y - head_h * 0.4, head_anchor.z - head_d * 0.30),
		Vector3(head_anchor.x + head_w, head_anchor.y + head_h * 0.6, head_anchor.z + head_d * 0.50),
		feather, 0.80
	)
	# Eyes — large, on sides of head
	for side_e in [-1, 1]:
		_build_box(
			root,
			Vector3(head_anchor.x + side_e * head_w - 0.005, head_anchor.y, head_anchor.z + head_d * 0.10),
			Vector3(head_anchor.x + side_e * head_w + 0.005, head_anchor.y + head_h * 0.30, head_anchor.z + head_d * 0.30),
			eye_color, 0.20, 0.20
		)
		# Eye ring
		_build_box(
			root,
			Vector3(head_anchor.x + side_e * head_w * 0.95 - 0.008, head_anchor.y - head_h * 0.05, head_anchor.z + head_d * 0.05),
			Vector3(head_anchor.x + side_e * head_w * 1.05 + 0.008, head_anchor.y + head_h * 0.35, head_anchor.z + head_d * 0.35),
			feather_dark, 0.85
		)
	# Beak — hooked, two-piece (upper hooks down, lower flat)
	var beak_base: Vector3 = head_anchor + Vector3(0, head_h * 0.10, head_d * 0.45)
	var beak_tip: Vector3 = beak_base + Vector3(0, -head_h * 0.25, head_d * 0.45)
	# Upper beak — tapered curve via 2 segments
	var beak_mid: Vector3 = beak_base + Vector3(0, -head_h * 0.05, head_d * 0.30)
	_build_tapered_segment(root, beak_base, head_w * 0.45, beak_mid, head_w * 0.30, beak_color, 0.40)
	_build_tapered_segment(root, beak_mid, head_w * 0.30, beak_tip, head_w * 0.05, beak_color, 0.40)
	# Lower beak
	var lbeak_base: Vector3 = head_anchor + Vector3(0, -head_h * 0.05, head_d * 0.40)
	var lbeak_tip: Vector3 = lbeak_base + Vector3(0, -head_h * 0.05, head_d * 0.40)
	_build_tapered_segment(root, lbeak_base, head_w * 0.30, lbeak_tip, head_w * 0.05, beak_color.darkened(0.10), 0.40)

	# ----- LEGS — thin, jointed, with talons -----
	for side in [-1, 1]:
		var hip_x: float = side * w * 0.15
		var hip_pos := Vector3(hip_x, body_y - h * 0.05, body_centers[1].z)
		var knee := Vector3(hip_x, clearance * 0.55, d * 0.02)
		var ankle := Vector3(hip_x, clearance * 0.20, -d * 0.03)
		var foot_center := Vector3(hip_x, 0.0, d * 0.05)
		# Thigh (covered in feathers — slightly fatter)
		_build_tapered_segment(root, hip_pos, w * 0.10, knee, w * 0.06, feather, 0.85)
		# Shin (bare, scaly)
		_build_tapered_segment(root, knee, w * 0.05, ankle, w * 0.045, beak_color.darkened(0.40), 0.60)
		# Metatarsal
		_build_tapered_segment(root, ankle, w * 0.045, foot_center, w * 0.04, beak_color.darkened(0.45), 0.60)
		# 3 front talons + 1 back talon
		for ti in range(3):
			var toe_offset: float = (ti - 1) * w * 0.08
			var toe_tip := Vector3(foot_center.x + toe_offset, 0.0, foot_center.z + w * 0.18)
			_build_tapered_segment(root, foot_center, w * 0.025, toe_tip, w * 0.005, talon_color, 0.40)
		# Back talon
		var back_toe := Vector3(foot_center.x, 0.0, foot_center.z - w * 0.10)
		_build_tapered_segment(root, foot_center, w * 0.025, back_toe, w * 0.005, talon_color, 0.40)

# ============================================================================
# SKELETON — bony biped; visible ribs, skull head, gaps between bones
# ============================================================================
##
## Key traits:
##   THIN STICK-LIKE LIMBS (no muscle bulk)
##   VISIBLE RIB CAGE (multiple thin horizontal bars)
##   SKULL HEAD with empty eye sockets + jaw
##   PELVIS as a flat plate, not a sphere
##   No flesh — bone color throughout

static func _build_skeleton(plan: Dictionary, root: Node3D) -> void:
	var base: Dictionary = plan.get("base", {})
	var palette: Dictionary = plan.get("palette", {})
	var limbs: Dictionary = plan.get("limbs", {})

	var w: float = _axis(base, "width", 0.50)
	var h: float = _axis(base, "height", 1.10)
	var d: float = _axis(base, "depth", 0.35)
	var leg_length: float = float(limbs.get("leg_length", 0.55))
	var clearance: float = leg_length

	# Bone palette overrides skin — these creatures are literally bones.
	var bone: Color = palette.get("primary", Color(0.92, 0.88, 0.75))
	var bone_dark: Color = bone.darkened(0.30)
	var socket: Color = palette.get("eye", Color(0.05, 0.05, 0.05))
	var glow: Color = palette.get("accent", Color(0.30, 0.95, 0.30))

	# ----- Pelvis — flat butterfly plate -----
	var pelvis_y: float = clearance + h * 0.05
	_build_box(
		root,
		Vector3(-w * 0.30, pelvis_y, -d * 0.18),
		Vector3(w * 0.30, pelvis_y + h * 0.10, d * 0.18),
		bone_dark, 0.50
	)
	# Hip wings angling out
	for side in [-1, 1]:
		_build_box(
			root,
			Vector3(side * w * 0.30, pelvis_y - h * 0.02, -d * 0.12),
			Vector3(side * w * 0.45, pelvis_y + h * 0.12, d * 0.12),
			bone_dark, 0.50
		)

	# ----- Spine — thin vertical column of ~5 stacked vertebrae -----
	var spine_top: float = pelvis_y + h * 0.45
	var verts_n: int = 6
	for i in range(verts_n):
		var t: float = float(i) / float(verts_n - 1)
		var vy: float = lerpf(pelvis_y + h * 0.10, spine_top, t)
		_build_box(
			root,
			Vector3(-w * 0.07, vy, -d * 0.07),
			Vector3(w * 0.07, vy + h * 0.05, d * 0.07),
			bone, 0.55
		)

	# ----- Rib cage — 4 ribs as horizontal half-rings -----
	for ri in range(4):
		var rt: float = float(ri) / 3.0   # 0..1 from waist to chest
		var ry: float = lerpf(pelvis_y + h * 0.15, spine_top - h * 0.02, rt)
		var rw: float = lerpf(w * 0.22, w * 0.30, smoothstep(0.0, 1.0, 1.0 - abs(rt - 0.5) * 2.0))
		# Build as 3-segment arc using 4 boxes
		for j in range(-1, 2):  # -1, 0, 1
			var jx: float = float(j) * rw * 0.55
			var jz: float = sqrt(max(0.0, 1.0 - pow(float(j) * 0.55, 2.0))) * d * 0.20
			# Two boxes per rib (front and back arms)
			_build_box(
				root,
				Vector3(jx - w * 0.04, ry, jz - d * 0.05),
				Vector3(jx + w * 0.04, ry + h * 0.04, jz + d * 0.03),
				bone, 0.55
			)
			_build_box(
				root,
				Vector3(jx - w * 0.04, ry, -jz - d * 0.03),
				Vector3(jx + w * 0.04, ry + h * 0.04, -jz + d * 0.05),
				bone, 0.55
			)

	# ----- Shoulder bar -----
	_build_box(
		root,
		Vector3(-w * 0.45, spine_top, -d * 0.07),
		Vector3(w * 0.45, spine_top + h * 0.06, d * 0.07),
		bone_dark, 0.50
	)

	# ----- SKULL — round cranium + jaw + sockets -----
	var head_anchor: Vector3 = Vector3(0, spine_top + h * 0.18, d * 0.02)
	var skull_w: float = w * 0.30
	var skull_h: float = h * 0.20
	var skull_d: float = d * 0.55
	# Cranium
	_build_box(
		root,
		Vector3(-skull_w, head_anchor.y, head_anchor.z - skull_d * 0.40),
		Vector3(skull_w, head_anchor.y + skull_h * 0.70, head_anchor.z + skull_d * 0.45),
		bone, 0.50
	)
	# Eye sockets — dark recesses
	for side_e in [-1, 1]:
		_build_box(
			root,
			Vector3(side_e * skull_w * 0.55 - skull_w * 0.20, head_anchor.y + skull_h * 0.25, head_anchor.z + skull_d * 0.40),
			Vector3(side_e * skull_w * 0.55 + skull_w * 0.20, head_anchor.y + skull_h * 0.50, head_anchor.z + skull_d * 0.50),
			socket, 0.10
		)
		# Optional glow inside socket
		_build_box(
			root,
			Vector3(side_e * skull_w * 0.55 - skull_w * 0.07, head_anchor.y + skull_h * 0.32, head_anchor.z + skull_d * 0.44),
			Vector3(side_e * skull_w * 0.55 + skull_w * 0.07, head_anchor.y + skull_h * 0.42, head_anchor.z + skull_d * 0.49),
			glow, 0.10, 0.30
		)
	# Nasal cavity — small triangle
	_build_box(
		root,
		Vector3(-skull_w * 0.10, head_anchor.y + skull_h * 0.10, head_anchor.z + skull_d * 0.40),
		Vector3(skull_w * 0.10, head_anchor.y + skull_h * 0.22, head_anchor.z + skull_d * 0.50),
		socket, 0.10
	)
	# Jaw — narrower lower half
	_build_box(
		root,
		Vector3(-skull_w * 0.75, head_anchor.y - skull_h * 0.20, head_anchor.z - skull_d * 0.05),
		Vector3(skull_w * 0.75, head_anchor.y + skull_h * 0.02, head_anchor.z + skull_d * 0.50),
		bone_dark, 0.50
	)
	# Tooth row (4 small boxes along upper jaw)
	for ti in range(5):
		var tx: float = lerpf(-skull_w * 0.50, skull_w * 0.50, float(ti) / 4.0)
		_build_box(
			root,
			Vector3(tx - skull_w * 0.05, head_anchor.y - skull_h * 0.08, head_anchor.z + skull_d * 0.40),
			Vector3(tx + skull_w * 0.05, head_anchor.y, head_anchor.z + skull_d * 0.50),
			bone, 0.45
		)

	# ----- ARMS — thin stick-bones, two segments + finger cluster -----
	for side in [-1, 1]:
		var shoulder := Vector3(side * w * 0.40, spine_top + h * 0.02, 0.0)
		var elbow := Vector3(side * w * 0.50, clearance + h * 0.30, d * 0.05)
		var wrist := Vector3(side * w * 0.45, clearance + h * 0.05, d * 0.05)
		# Humerus
		_build_tapered_segment(root, shoulder, w * 0.05, elbow, w * 0.045, bone, 0.55)
		# Radius
		_build_tapered_segment(root, elbow, w * 0.045, wrist, w * 0.04, bone, 0.55)
		# Hand bones — 3 small finger stubs
		for fi in range(3):
			var fx: float = side * (w * 0.45 + fi * w * 0.03)
			var f_tip := Vector3(fx, wrist.y - h * 0.10, wrist.z + d * 0.02)
			_build_tapered_segment(root, wrist, w * 0.025, f_tip, w * 0.008, bone, 0.50)

	# ----- LEGS — thin stick-bones, two segments + foot bone -----
	for side in [-1, 1]:
		var hip_x: float = side * w * 0.20
		var hip_pos := Vector3(hip_x, pelvis_y + h * 0.02, 0.0)
		var knee := Vector3(hip_x, clearance * 0.55, d * 0.04)
		var ankle := Vector3(hip_x, clearance * 0.10, 0.0)
		# Femur
		_build_tapered_segment(root, hip_pos, w * 0.07, knee, w * 0.055, bone, 0.55)
		# Tibia
		_build_tapered_segment(root, knee, w * 0.05, ankle, w * 0.045, bone, 0.55)
		# Foot bones — flat box
		_build_box(
			root,
			Vector3(hip_x - w * 0.07, 0.0, -d * 0.05),
			Vector3(hip_x + w * 0.07, h * 0.04, d * 0.20),
			bone_dark, 0.50
		)

# ============================================================================
# ZOMBIE — like a brute humanoid, but tattered/rotting; hunched and lopsided
# ============================================================================
##
## We reuse the brute_humanoid shape with paler/greenish skin and add rotting
## detail (exposed ribs on one side). Keeps the file lean.

static func _build_zombie(plan: Dictionary, root: Node3D) -> void:
	# Reuse brute_humanoid; the palette controls the rotting look from the
	# species' body_plan_modifiers (greenish/grey primary, exposed bone accent).
	_build_brute_humanoid(plan, root)
	# Add a single exposed rib cage detail on the left side.
	var base: Dictionary = plan.get("base", {})
	var palette: Dictionary = plan.get("palette", {})
	var limbs: Dictionary = plan.get("limbs", {})
	var w: float = _axis(base, "width", 0.85)
	var h: float = _axis(base, "height", 1.30)
	var d: float = _axis(base, "depth", 0.55)
	var leg_length: float = float(limbs.get("leg_length", 0.65))
	var clearance: float = leg_length
	var bone: Color = palette.get("accent", Color(0.85, 0.80, 0.65))
	# 3 exposed ribs on left chest
	for ri in range(3):
		var ry: float = clearance + h * (0.55 + ri * 0.06)
		_build_box(
			root,
			Vector3(-w * 0.45, ry, d * 0.25),
			Vector3(-w * 0.15, ry + h * 0.03, d * 0.30),
			bone, 0.55
		)

# ============================================================================
# BEHOLDER — floating spherical body, huge central eye, multiple eyestalks
# ============================================================================
##
## Key traits:
##   ROUND CENTRAL BODY (spherical)
##   ONE MASSIVE CENTRAL EYE on front
##   WIDE FANGED MAW below central eye
##   ~10 EYESTALKS sprouting from the top, each ending in a small eye
##   No legs — it floats (positioned at clearance height anyway)

static func _build_beholder(plan: Dictionary, root: Node3D) -> void:
	var base: Dictionary = plan.get("base", {})
	var palette: Dictionary = plan.get("palette", {})
	var meta: Dictionary = plan.get("meta", {})
	var species: String = String(meta.get("species", "Beholder"))

	var w: float = _axis(base, "width", 0.95)
	var h: float = _axis(base, "height", 0.90)
	var d: float = _axis(base, "depth", 0.95)

	# Per-individual RNG (deterministic via render_seed) — avoids the
	# hardcoded palette.primary trap that made every beholder the same hue.
	var render_seed: int = int(meta.get("render_seed", 0))
	var rng := RandomNumberGenerator.new()
	rng.seed = render_seed if render_seed != 0 else hash(species)
	var size_jitter: float = rng.randf_range(0.92, 1.12)
	w *= size_jitter
	h *= size_jitter
	d *= size_jitter

	# Curated canon beholder hide palette — rust-brown, purple, dark red,
	# violet, dark green. Beholders feud over color; variation is canon.
	var hide_options := [
		Color(0.55, 0.30, 0.30),     # rust brown (classic)
		Color(0.42, 0.20, 0.35),     # deep purple
		Color(0.45, 0.18, 0.18),     # blood-red
		Color(0.30, 0.20, 0.40),     # violet
		Color(0.25, 0.32, 0.22),     # dark green
		Color(0.50, 0.38, 0.25),     # ochre tan
	]
	var hide: Color = hide_options[rng.randi() % hide_options.size()]
	var hide_dark: Color = hide.darkened(0.25)
	var maw_color := Color(0.20, 0.05, 0.05)
	var eye_color: Color = palette.get("eye", Color(0.95, 0.85, 0.10))
	var tooth_color: Color = Color(0.92, 0.86, 0.72)
	# Each eyestalk has its own magical color — 10 distinct hues (canon).
	var stalk_eye_palette := [
		Color(0.95, 0.85, 0.10),     # charm (yellow)
		Color(0.30, 0.80, 1.00),     # sleep (cyan)
		Color(0.60, 0.30, 0.95),     # telekinesis (purple)
		Color(1.00, 0.30, 0.30),     # fear (red)
		Color(0.10, 0.90, 0.40),     # slow (green)
		Color(0.95, 0.60, 0.10),     # enervation (orange)
		Color(0.55, 0.45, 1.00),     # paralysis (lavender)
		Color(1.00, 0.95, 0.85),     # petrify (pale)
		Color(0.20, 0.30, 0.85),     # disintegrate (deep blue)
		Color(0.90, 0.10, 0.55),     # death (magenta)
	]

	# ----- Floating body — spherical, built from 3 stacked octagonal rings -----
	var body_y: float = 1.20      # floats above ground
	var body_r: float = w * 0.50
	var ring_ys := [body_y - body_r * 0.65, body_y, body_y + body_r * 0.65]
	var ring_rs := [body_r * 0.55, body_r, body_r * 0.55]
	var rings: Array = []
	for i in range(3):
		var verts: Array = []
		for j in range(10):
			var ang: float = TAU * float(j) / 10.0
			verts.append(Vector3(cos(ang) * ring_rs[i], ring_ys[i], sin(ang) * ring_rs[i]))
		rings.append(verts)
	var st := SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	for i in range(2):
		var ra: Array = rings[i]
		var rb: Array = rings[i + 1]
		for j in range(10):
			var k: int = (j + 1) % 10
			_add_quad(st, ra[j], ra[k], rb[k], rb[j])
	# Top cap
	var top := Vector3(0, body_y + body_r * 0.95, 0)
	for j in range(10):
		var k: int = (j + 1) % 10
		_add_tri(st, rings[2][j], rings[2][k], top)
	# Bottom cap
	var bot := Vector3(0, body_y - body_r * 0.95, 0)
	for j in range(10):
		var k: int = (j + 1) % 10
		_add_tri(st, rings[0][k], rings[0][j], bot)
	st.generate_normals()
	var mi := MeshInstance3D.new()
	mi.mesh = st.commit()
	var mat := StandardMaterial3D.new()
	mat.albedo_color = hide
	mat.roughness = 0.70
	mat.cull_mode = BaseMaterial3D.CULL_DISABLED
	mi.material_override = mat
	root.add_child(mi)

	# ----- CENTRAL EYE — LARGE, taking ~38% of body radius per canon art.
	# Verify-agent fix: eye scaled up + maw raised so the eye-and-jaws-fused
	# horror read (Trampier/Reynolds) lands; previously read as cyclops-with-
	# separate-mouth.
	var eye_z: float = body_r * 1.00
	# Brow scowl ridge — heavy ridge ABOVE central eye for canon menace
	_build_box(
		root,
		Vector3(-body_r * 0.50, body_y + body_r * 0.48, eye_z - 0.05),
		Vector3(body_r * 0.50, body_y + body_r * 0.66, eye_z + 0.04),
		hide_dark, 0.70
	)
	# Lower eyelid ridge — just above the maw (sits at ~y - 0.22)
	_build_box(
		root,
		Vector3(-body_r * 0.48, body_y - body_r * 0.22, eye_z - 0.05),
		Vector3(body_r * 0.48, body_y - body_r * 0.10, eye_z + 0.04),
		hide_dark, 0.70
	)
	# White sclera — larger (radius ~0.42 of body)
	_build_box(
		root,
		Vector3(-body_r * 0.42, body_y - body_r * 0.10, eye_z - 0.02),
		Vector3(body_r * 0.42, body_y + body_r * 0.48, eye_z + 0.06),
		Color(0.95, 0.92, 0.85), 0.40
	)
	# Iris (color) — larger
	_build_box(
		root,
		Vector3(-body_r * 0.30, body_y - body_r * 0.02, eye_z + 0.04),
		Vector3(body_r * 0.30, body_y + body_r * 0.40, eye_z + 0.10),
		eye_color, 0.20, 0.20
	)
	# Pupil (dark center) — larger
	_build_box(
		root,
		Vector3(-body_r * 0.12, body_y + body_r * 0.10, eye_z + 0.08),
		Vector3(body_r * 0.12, body_y + body_r * 0.28, eye_z + 0.12),
		Color(0.05, 0.05, 0.05), 0.30
	)

	# ----- MAW — wide toothy mouth IMMEDIATELY below the lower eyelid -----
	# Verify-agent fix: was at y - 0.35 leaving a gap; now sits at y - 0.28
	# so the upper lip kisses the eyelid ridge.
	var maw_y: float = body_y - body_r * 0.28
	# Mouth interior (dark)
	_build_box(
		root,
		Vector3(-body_r * 0.45, maw_y - body_r * 0.20, eye_z - 0.05),
		Vector3(body_r * 0.45, maw_y + body_r * 0.10, eye_z + 0.05),
		maw_color, 0.50
	)
	# Upper teeth — 5
	for ti in range(5):
		var tx: float = lerpf(-body_r * 0.35, body_r * 0.35, float(ti) / 4.0)
		var tip := Vector3(tx, maw_y - body_r * 0.10, eye_z + 0.03)
		var root_v := Vector3(tx, maw_y + body_r * 0.08, eye_z + 0.03)
		_build_tapered_segment(root, root_v, body_r * 0.05, tip, body_r * 0.01, tooth_color, 0.40)
	# Lower teeth — 4
	for ti in range(4):
		var tx: float = lerpf(-body_r * 0.25, body_r * 0.25, float(ti) / 3.0)
		var root_v := Vector3(tx, maw_y - body_r * 0.20, eye_z + 0.03)
		var tip := Vector3(tx, maw_y - body_r * 0.05, eye_z + 0.03)
		_build_tapered_segment(root, root_v, body_r * 0.04, tip, body_r * 0.01, tooth_color, 0.40)

	# ----- EYESTALKS — 10 WRITHING stalks in wildly different directions -----
	# Verify-agent fix: canon stalks DON'T fan uniformly upward — some curl
	# forward over the eye, some droop sideways, some point back. We use
	# deterministic per-stalk RNG to keep determinism while breaking symmetry.
	var stalk_count: int = 10
	for si in range(stalk_count):
		var base_ang: float = TAU * float(si) / float(stalk_count)
		# Per-stalk yaw twist on top of the base distribution
		var yaw: float = base_ang + rng.randf_range(-0.45, 0.45)
		# Pitch: most go up, but some curl level or even forward over the eye
		var pitch: float = rng.randf_range(-0.25, 1.30)  # -15° to +75° in radians
		# Length variation (some stalks shorter than others)
		var stalk_len: float = body_r * rng.randf_range(0.85, 1.25)
		# Root on the top hemisphere
		var root_t: float = 0.5
		var stalk_root := Vector3(cos(base_ang) * body_r * root_t,
								   body_y + body_r * 0.75,
								   sin(base_ang) * body_r * root_t)
		# Tip position in spherical coords from the root
		var dir_horiz_x: float = cos(yaw) * cos(pitch)
		var dir_horiz_z: float = sin(yaw) * cos(pitch)
		var dir_up: float = sin(pitch)
		var stalk_tip := stalk_root + Vector3(
			dir_horiz_x * stalk_len,
			dir_up * stalk_len,
			dir_horiz_z * stalk_len
		)
		# Mid-segment kink — offset perpendicular to the root→tip axis by ±0.15
		var axis: Vector3 = (stalk_tip - stalk_root).normalized()
		# Pick a perpendicular vector (cross with world up; fallback if parallel)
		var perp: Vector3 = axis.cross(Vector3.UP)
		if perp.length() < 0.01:
			perp = axis.cross(Vector3.FORWARD)
		perp = perp.normalized() * body_r * rng.randf_range(-0.18, 0.18)
		var stalk_mid: Vector3 = stalk_root.lerp(stalk_tip, 0.55) + perp
		_build_tapered_segment(root, stalk_root, body_r * 0.08, stalk_mid, body_r * 0.06, hide_dark, 0.70)
		_build_tapered_segment(root, stalk_mid, body_r * 0.06, stalk_tip, body_r * 0.07, hide_dark, 0.70)
		# Small eyeball at the tip (cube)
		_build_box(
			root,
			stalk_tip + Vector3(-body_r * 0.07, -body_r * 0.07, -body_r * 0.07),
			stalk_tip + Vector3(body_r * 0.07, body_r * 0.07, body_r * 0.07),
			Color(0.95, 0.92, 0.85), 0.40
		)
		# Iris on tip eye — each stalk gets a DIFFERENT canon eye-ray color
		# (charm/sleep/fear/death/etc.) — beholders are walking spell-batteries.
		var iris_dir: Vector3 = (stalk_tip - Vector3(0, body_y, 0)).normalized()
		var iris_pos: Vector3 = stalk_tip + iris_dir * body_r * 0.06
		var stalk_color: Color = stalk_eye_palette[si % stalk_eye_palette.size()]
		_build_box(
			root,
			iris_pos + Vector3(-body_r * 0.025, -body_r * 0.025, -body_r * 0.025),
			iris_pos + Vector3(body_r * 0.025, body_r * 0.025, body_r * 0.025),
			stalk_color, 0.10, 0.0
		)
		# Tiny pupil dot inside each stalk eye
		_build_box(
			root,
			iris_pos + Vector3(-body_r * 0.010, -body_r * 0.010, -body_r * 0.010),
			iris_pos + Vector3(body_r * 0.010, body_r * 0.010, body_r * 0.010),
			Color(0.05, 0.04, 0.04), 0.30
		)

# ============================================================================
# WRAITH — floating spectral form; tattered cloak shape, no legs,
# faintly translucent body
# ============================================================================
##
## Key traits:
##   FLOATING (no legs)
##   TAPERED CLOAK SHAPE — wider at shoulders, narrows to ragged tail wisps
##   HOOD where the face would be (dark void with two glowing eyes)
##   THIN WISPY ARMS

static func _build_wraith(plan: Dictionary, root: Node3D) -> void:
	var base: Dictionary = plan.get("base", {})
	var palette: Dictionary = plan.get("palette", {})

	var w: float = _axis(base, "width", 0.60)
	var h: float = _axis(base, "height", 1.40)
	var d: float = _axis(base, "depth", 0.50)

	var cloak: Color = palette.get("primary", Color(0.10, 0.08, 0.15))
	var cloak_dark: Color = cloak.darkened(0.30)
	var glow: Color = palette.get("eye", Color(0.30, 0.85, 1.00))
	var void_color: Color = Color(0.02, 0.02, 0.04)

	# Floating body — center hovers above the ground.
	var float_y: float = h * 0.50
	# Build a tapered cloak: 5 rings, widest at top (shoulders), narrowing
	# to ragged tendrils below. Use 6-vert rings.
	var ring_ys := [
		float_y + h * 0.45,    # top — hood opening
		float_y + h * 0.20,    # shoulders (widest)
		float_y - h * 0.05,    # waist
		float_y - h * 0.30,    # below waist
		float_y - h * 0.55,    # frayed tail
	]
	var ring_rs := [w * 0.20, w * 0.50, w * 0.40, w * 0.25, w * 0.12]
	var rings: Array = []
	for i in range(5):
		var verts: Array = []
		for j in range(6):
			var ang: float = TAU * float(j) / 6.0
			# Bottom ring jitters slightly for ragged tail effect
			var rj: float = ring_rs[i]
			if i == 4:
				rj *= 1.0 + 0.20 * sin(float(j) * 2.4)
			verts.append(Vector3(cos(ang) * rj, ring_ys[i], sin(ang) * rj))
		rings.append(verts)
	var st := SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	for i in range(4):
		var ra: Array = rings[i]
		var rb: Array = rings[i + 1]
		for j in range(6):
			var k: int = (j + 1) % 6
			_add_quad(st, ra[j], ra[k], rb[k], rb[j])
	st.generate_normals()
	var mi := MeshInstance3D.new()
	mi.mesh = st.commit()
	var mat := StandardMaterial3D.new()
	mat.albedo_color = cloak
	mat.roughness = 0.95
	mat.cull_mode = BaseMaterial3D.CULL_DISABLED
	# Slight translucency for spectral feel
	mat.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	mat.albedo_color.a = 0.88
	mi.material_override = mat
	root.add_child(mi)

	# ----- HOOD — separate dark cone on top, forming the face cavity -----
	var hood_top := Vector3(0, float_y + h * 0.60, 0)
	var hood_ring_y: float = float_y + h * 0.40
	var hood_ring_r: float = w * 0.28
	var st_hood := SurfaceTool.new()
	st_hood.begin(Mesh.PRIMITIVE_TRIANGLES)
	for j in range(8):
		var ang0: float = TAU * float(j) / 8.0
		var ang1: float = TAU * float(j + 1) / 8.0
		var b0 := Vector3(cos(ang0) * hood_ring_r, hood_ring_y, sin(ang0) * hood_ring_r)
		var b1 := Vector3(cos(ang1) * hood_ring_r, hood_ring_y, sin(ang1) * hood_ring_r)
		_add_tri(st_hood, hood_top, b1, b0)
	st_hood.generate_normals()
	var mi_h := MeshInstance3D.new()
	mi_h.mesh = st_hood.commit()
	var mat_h := StandardMaterial3D.new()
	mat_h.albedo_color = cloak_dark
	mat_h.roughness = 0.95
	mat_h.cull_mode = BaseMaterial3D.CULL_DISABLED
	mi_h.material_override = mat_h
	root.add_child(mi_h)

	# ----- Face void inside hood -----
	_build_box(
		root,
		Vector3(-w * 0.15, float_y + h * 0.30, w * 0.15),
		Vector3(w * 0.15, float_y + h * 0.45, w * 0.30),
		void_color, 0.20
	)
	# Glowing eyes
	for side in [-1, 1]:
		var ex: float = side * w * 0.08
		_build_box(
			root,
			Vector3(ex - w * 0.04, float_y + h * 0.36, w * 0.21),
			Vector3(ex + w * 0.04, float_y + h * 0.42, w * 0.27),
			glow, 0.10, 0.30
		)

	# ----- Wispy arms — emerge from the cloak, end in claw-like fingers -----
	for side in [-1, 1]:
		var sh := Vector3(side * w * 0.40, float_y + h * 0.18, 0.0)
		var elbow := Vector3(side * w * 0.55, float_y - h * 0.05, d * 0.10)
		var wrist := Vector3(side * w * 0.50, float_y - h * 0.20, d * 0.20)
		_build_tapered_segment(root, sh, w * 0.06, elbow, w * 0.05, cloak_dark, 0.90)
		_build_tapered_segment(root, elbow, w * 0.04, wrist, w * 0.03, cloak_dark, 0.90)
		# 3 long claw-fingers
		for fi in range(3):
			var fx: float = side * (w * 0.50 + fi * w * 0.04)
			var f_tip := Vector3(fx, wrist.y - h * 0.15, wrist.z + d * 0.05)
			_build_tapered_segment(root, wrist, w * 0.02, f_tip, w * 0.005, glow.darkened(0.50), 0.40)

	# ----- Tail wisps — 3 trailing tendrils below the cloak -----
	for ti in range(3):
		var ang: float = TAU * float(ti) / 3.0 + 0.4
		var w_root := Vector3(cos(ang) * w * 0.10, float_y - h * 0.55, sin(ang) * w * 0.10)
		var w_tip := Vector3(cos(ang) * w * 0.18, float_y - h * 0.95, sin(ang) * w * 0.18)
		_build_tapered_segment(root, w_root, w * 0.06, w_tip, w * 0.01, cloak_dark, 0.95)

# ============================================================================
# WARRIOR HUMANOID — slim athletic biped, broad shoulders, helmet-ish head,
# armored chest plate. Distinct from BRUTE (which is hunched + pot belly).
# ============================================================================
##
## Key traits:
##   STRAIGHT UPRIGHT POSTURE
##   BROAD SHOULDERS, NARROWER WAIST (V-torso)
##   SQUARE HELMET head with visor slit
##   CHEST PLATE band across pectorals
##   Average-thickness limbs (not stick, not log)
##   Belt + simple sword silhouette at hip

static func _build_warrior(plan: Dictionary, root: Node3D) -> void:
	var base: Dictionary = plan.get("base", {})
	var palette: Dictionary = plan.get("palette", {})
	var limbs: Dictionary = plan.get("limbs", {})

	var w: float = _axis(base, "width", 0.55)
	var h: float = _axis(base, "height", 1.20)
	var d: float = _axis(base, "depth", 0.35)
	var leg_length: float = float(limbs.get("leg_length", 0.62))
	var clearance: float = leg_length

	var skin: Color = palette.get("primary", Color(0.78, 0.62, 0.50))
	var armor: Color = palette.get("secondary", Color(0.55, 0.55, 0.60))
	var accent: Color = palette.get("accent", Color(0.85, 0.30, 0.20))
	var eye_color: Color = palette.get("eye", Color(0.35, 0.55, 0.85))
	var leather: Color = Color(0.30, 0.20, 0.12)

	# ----- Torso: V-shape — narrow at waist, wide at shoulders -----
	var hip_y: float = clearance + h * 0.05
	var waist_y: float = clearance + h * 0.20
	var chest_y: float = clearance + h * 0.45
	var shoulder_y: float = clearance + h * 0.65
	var torso_centers := [
		Vector3(0, hip_y, 0),
		Vector3(0, waist_y, 0),
		Vector3(0, chest_y, 0),
		Vector3(0, shoulder_y, 0),
	]
	var torso_r := [
		Vector3(w * 0.32, 0, d * 0.50),
		Vector3(w * 0.28, 0, d * 0.42),   # narrower waist
		Vector3(w * 0.38, 0, d * 0.50),
		Vector3(w * 0.48, 0, d * 0.42),   # widest shoulders
	]
	var st := SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	var rings: Array = []
	for i in range(4):
		var c: Vector3 = torso_centers[i]
		var rv: Vector3 = torso_r[i]
		var verts: Array = []
		for j in range(8):
			var ang: float = TAU * float(j) / 8.0
			verts.append(Vector3(c.x + cos(ang) * rv.x, c.y, c.z + sin(ang) * rv.z))
		rings.append(verts)
	for i in range(3):
		for j in range(8):
			var k: int = (j + 1) % 8
			_add_quad(st, rings[i][j], rings[i][k], rings[i + 1][k], rings[i + 1][j])
	# Caps
	_add_quad(st, rings[3][0], rings[3][1], rings[3][2], rings[3][3])
	_add_quad(st, rings[3][4], rings[3][5], rings[3][6], rings[3][7])
	_add_quad(st, rings[0][3], rings[0][2], rings[0][1], rings[0][0])
	_add_quad(st, rings[0][7], rings[0][6], rings[0][5], rings[0][4])
	st.generate_normals()
	var mi := MeshInstance3D.new()
	mi.mesh = st.commit()
	var mat := StandardMaterial3D.new()
	mat.albedo_color = skin
	mat.roughness = 0.80
	mat.cull_mode = BaseMaterial3D.CULL_DISABLED
	mi.material_override = mat
	root.add_child(mi)

	# ----- CHEST PLATE — armor band across pectorals -----
	_build_box(
		root,
		Vector3(-w * 0.45, chest_y - h * 0.05, d * 0.30),
		Vector3(w * 0.45, chest_y + h * 0.15, d * 0.55),
		armor, 0.40, 0.45
	)
	# Pauldrons (shoulder caps)
	for side in [-1, 1]:
		_build_box(
			root,
			Vector3(side * w * 0.35, shoulder_y - h * 0.05, -d * 0.30),
			Vector3(side * w * 0.55, shoulder_y + h * 0.10, d * 0.30),
			armor.darkened(0.10), 0.40, 0.45
		)
	# Belt
	_build_box(
		root,
		Vector3(-w * 0.36, hip_y + h * 0.10, -d * 0.50),
		Vector3(w * 0.36, hip_y + h * 0.18, d * 0.55),
		leather, 0.85
	)
	# Belt buckle
	_build_box(
		root,
		Vector3(-w * 0.08, hip_y + h * 0.10, d * 0.50),
		Vector3(w * 0.08, hip_y + h * 0.20, d * 0.58),
		accent, 0.30, 0.50
	)

	# ----- NECK + HELMET HEAD -----
	var neck_base: Vector3 = torso_centers[3]
	var head_anchor: Vector3 = neck_base + Vector3(0, h * 0.18, 0)
	_build_tapered_segment(root, neck_base + Vector3(0, h * 0.05, 0), w * 0.16, head_anchor, w * 0.15, skin, 0.85)
	# Helmet — slightly trapezoidal (narrower on top)
	var hw: float = w * 0.28
	var hh: float = h * 0.18
	var hd: float = d * 0.55
	_build_box(
		root,
		Vector3(-hw, head_anchor.y - hh * 0.10, -hd * 0.45),
		Vector3(hw, head_anchor.y + hh * 0.90, hd * 0.50),
		armor, 0.45, 0.40
	)
	# Helmet crest/ridge along top
	_build_box(
		root,
		Vector3(-hw * 0.08, head_anchor.y + hh * 0.85, -hd * 0.40),
		Vector3(hw * 0.08, head_anchor.y + hh * 1.10, hd * 0.40),
		accent, 0.40
	)
	# Visor slit (dark band across face)
	_build_box(
		root,
		Vector3(-hw * 0.95, head_anchor.y + hh * 0.25, hd * 0.48),
		Vector3(hw * 0.95, head_anchor.y + hh * 0.40, hd * 0.55),
		Color(0.04, 0.04, 0.05), 0.20
	)
	# Glowing eye-slits inside visor
	for side_e in [-1, 1]:
		_build_box(
			root,
			Vector3(side_e * hw * 0.40 - hw * 0.12, head_anchor.y + hh * 0.28, hd * 0.50),
			Vector3(side_e * hw * 0.40 + hw * 0.12, head_anchor.y + hh * 0.36, hd * 0.54),
			eye_color, 0.20, 0.20
		)

	# ----- ARMS — proportional, with bracers -----
	for side in [-1, 1]:
		var shoulder := Vector3(side * w * 0.50, shoulder_y, 0)
		var elbow := Vector3(side * w * 0.55, clearance + h * 0.32, d * 0.05)
		var wrist := Vector3(side * w * 0.45, clearance + h * 0.05, d * 0.10)
		_build_tapered_segment(root, shoulder, w * 0.10, elbow, w * 0.08, skin, 0.85)
		_build_tapered_segment(root, elbow, w * 0.08, wrist, w * 0.07, skin, 0.85)
		# Bracer band on forearm
		_build_box(
			root,
			Vector3(wrist.x - w * 0.10, wrist.y + h * 0.05, wrist.z - d * 0.10),
			Vector3(wrist.x + w * 0.10, wrist.y + h * 0.15, wrist.z + d * 0.10),
			armor, 0.40, 0.45
		)
		# Fist
		_build_box(
			root,
			Vector3(wrist.x - w * 0.08, wrist.y - h * 0.08, wrist.z - d * 0.08),
			Vector3(wrist.x + w * 0.08, wrist.y + h * 0.02, wrist.z + d * 0.10),
			skin, 0.85
		)

	# ----- SWORD on right hip -----
	var sword_top := Vector3(w * 0.50, hip_y + h * 0.05, d * 0.05)
	var sword_tip := Vector3(w * 0.50, hip_y - h * 0.40, d * 0.05)
	# Blade
	_build_box(
		root,
		Vector3(sword_top.x - w * 0.03, sword_tip.y, sword_top.z - 0.005),
		Vector3(sword_top.x + w * 0.03, sword_top.y, sword_top.z + 0.005),
		Color(0.85, 0.88, 0.92), 0.30, 0.60
	)
	# Crossguard
	_build_box(
		root,
		Vector3(sword_top.x - w * 0.10, sword_top.y, sword_top.z - 0.015),
		Vector3(sword_top.x + w * 0.10, sword_top.y + h * 0.04, sword_top.z + 0.015),
		accent, 0.40, 0.50
	)
	# Hilt
	_build_box(
		root,
		Vector3(sword_top.x - w * 0.03, sword_top.y + h * 0.04, sword_top.z - 0.015),
		Vector3(sword_top.x + w * 0.03, sword_top.y + h * 0.14, sword_top.z + 0.015),
		leather, 0.80
	)

	# ----- LEGS — straight, greaves -----
	for side in [-1, 1]:
		var hip_x: float = side * w * 0.18
		var hip_pos := Vector3(hip_x, hip_y + h * 0.02, 0)
		var knee := Vector3(hip_x, clearance * 0.55, d * 0.02)
		var ankle := Vector3(hip_x, clearance * 0.08, 0)
		var foot := Vector3(hip_x, 0.0, d * 0.10)
		_build_tapered_segment(root, hip_pos, w * 0.13, knee, w * 0.10, skin, 0.85)
		_build_tapered_segment(root, knee, w * 0.10, ankle, w * 0.09, skin, 0.85)
		# Greave (shin armor)
		_build_box(
			root,
			Vector3(knee.x - w * 0.12, ankle.y, knee.z - d * 0.10),
			Vector3(knee.x + w * 0.12, knee.y, knee.z + d * 0.10),
			armor, 0.40, 0.45
		)
		# Boot
		_build_box(
			root,
			Vector3(foot.x - w * 0.10, 0.0, foot.z - d * 0.20),
			Vector3(foot.x + w * 0.10, h * 0.06, foot.z + d * 0.18),
			leather, 0.85
		)

# ============================================================================
# CASTER HUMANOID — robed mage/lich/priest. Hidden legs under a long robe.
# Hooded head shadowing the face. Wooden staff in one hand.
# ============================================================================
##
## Key traits:
##   LONG ROBE that flares out at the base, hiding the legs
##   HOOD covering the head, dark void with glowing eyes inside
##   ONE LIFTED ARM holding a wooden staff with an orb/crystal
##   THIN ARMS emerging from wide sleeves

static func _build_caster(plan: Dictionary, root: Node3D) -> void:
	var base: Dictionary = plan.get("base", {})
	var palette: Dictionary = plan.get("palette", {})
	var limbs: Dictionary = plan.get("limbs", {})

	var w: float = _axis(base, "width", 0.55)
	var h: float = _axis(base, "height", 1.30)
	var d: float = _axis(base, "depth", 0.35)
	var leg_length: float = float(limbs.get("leg_length", 0.55))
	var clearance: float = leg_length

	var robe: Color = palette.get("primary", Color(0.25, 0.18, 0.40))
	var robe_dark: Color = robe.darkened(0.30)
	var trim: Color = palette.get("accent", Color(0.85, 0.70, 0.25))
	var skin: Color = palette.get("secondary", Color(0.75, 0.62, 0.50))
	var glow: Color = palette.get("eye", Color(0.30, 0.90, 0.95))
	var staff_wood: Color = Color(0.30, 0.18, 0.10)

	# ----- ROBE — cone-ish: narrow at shoulders, wide at floor -----
	# Build as 6 stacked rings (8 verts), floor=widest, neck=narrower.
	var ring_ys := [
		0.0,                           # 0 — floor edge
		clearance * 0.30,              # 1
		clearance + h * 0.05,          # 2 — hip
		clearance + h * 0.30,          # 3 — waist
		clearance + h * 0.55,          # 4 — chest
		clearance + h * 0.70,          # 5 — neck base
	]
	var ring_rs := [
		w * 0.60,                      # widest at floor
		w * 0.55,
		w * 0.45,
		w * 0.40,
		w * 0.42,
		w * 0.28,
	]
	var rings: Array = []
	for i in range(ring_ys.size()):
		var verts: Array = []
		for j in range(8):
			var ang: float = TAU * float(j) / 8.0
			# Hint of fabric folds — slight radius wobble
			var fold: float = 1.0 + 0.05 * sin(float(j) * 2.0)
			verts.append(Vector3(cos(ang) * ring_rs[i] * fold, ring_ys[i], sin(ang) * ring_rs[i] * fold))
		rings.append(verts)
	var st := SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	for i in range(ring_ys.size() - 1):
		for j in range(8):
			var k: int = (j + 1) % 8
			_add_quad(st, rings[i][j], rings[i][k], rings[i + 1][k], rings[i + 1][j])
	# Cap top (neck opening) and bottom open (skirt hem stays open)
	st.generate_normals()
	var mi := MeshInstance3D.new()
	mi.mesh = st.commit()
	var mat := StandardMaterial3D.new()
	mat.albedo_color = robe
	mat.roughness = 0.95
	mat.cull_mode = BaseMaterial3D.CULL_DISABLED
	mi.material_override = mat
	root.add_child(mi)

	# ----- Gold trim along the hem -----
	for i in range(8):
		var ang: float = TAU * float(i) / 8.0
		var ang2: float = TAU * float(i + 1) / 8.0
		var st_t := SurfaceTool.new()
		st_t.begin(Mesh.PRIMITIVE_TRIANGLES)
		var hem_y: float = clearance * 0.05
		var p0a := Vector3(cos(ang) * ring_rs[0] * 1.01, hem_y, sin(ang) * ring_rs[0] * 1.01)
		var p1a := Vector3(cos(ang2) * ring_rs[0] * 1.01, hem_y, sin(ang2) * ring_rs[0] * 1.01)
		var p0b := Vector3(cos(ang) * ring_rs[0] * 1.02, 0.0, sin(ang) * ring_rs[0] * 1.02)
		var p1b := Vector3(cos(ang2) * ring_rs[0] * 1.02, 0.0, sin(ang2) * ring_rs[0] * 1.02)
		_add_quad(st_t, p0a, p1a, p1b, p0b)
		st_t.generate_normals()
		var mi_t := MeshInstance3D.new()
		mi_t.mesh = st_t.commit()
		var mat_t := StandardMaterial3D.new()
		mat_t.albedo_color = trim
		mat_t.roughness = 0.35
		mat_t.metallic = 0.65
		mat_t.cull_mode = BaseMaterial3D.CULL_DISABLED
		mi_t.material_override = mat_t
		root.add_child(mi_t)

	# Sash from shoulder to opposite hip (vertical trim band on front)
	_build_box(
		root,
		Vector3(-w * 0.05, clearance + h * 0.05, d * 0.42),
		Vector3(w * 0.05, clearance + h * 0.55, d * 0.45),
		trim, 0.40, 0.50
	)

	# ----- HOOD — wide opening, deep dark interior, peaked top -----
	var hood_base_y: float = clearance + h * 0.72
	var hood_top := Vector3(0, hood_base_y + h * 0.25, -d * 0.10)
	var hood_ring_r: float = w * 0.32
	# Hood shell — 8 triangles forming a cone with opening to the front (+z)
	var st_hood := SurfaceTool.new()
	st_hood.begin(Mesh.PRIMITIVE_TRIANGLES)
	var hood_verts: Array = []
	for j in range(8):
		var ang: float = TAU * float(j) / 8.0
		hood_verts.append(Vector3(cos(ang) * hood_ring_r, hood_base_y, sin(ang) * hood_ring_r))
	# Only build the back 5/8 of the cone — leave front open as face opening
	for j in range(8):
		if j == 6 or j == 7 or j == 0:    # front-facing segments — skip to leave opening
			continue
		var k: int = (j + 1) % 8
		_add_tri(st_hood, hood_top, hood_verts[k], hood_verts[j])
	st_hood.generate_normals()
	var mi_hood := MeshInstance3D.new()
	mi_hood.mesh = st_hood.commit()
	var mat_hood := StandardMaterial3D.new()
	mat_hood.albedo_color = robe_dark
	mat_hood.roughness = 0.95
	mat_hood.cull_mode = BaseMaterial3D.CULL_DISABLED
	mi_hood.material_override = mat_hood
	root.add_child(mi_hood)
	# Dark face void inside hood
	_build_box(
		root,
		Vector3(-w * 0.18, hood_base_y + h * 0.02, hood_ring_r * 0.20),
		Vector3(w * 0.18, hood_base_y + h * 0.20, hood_ring_r * 0.65),
		Color(0.02, 0.02, 0.03), 0.20
	)
	# Glowing eyes inside void
	for side_e in [-1, 1]:
		_build_box(
			root,
			Vector3(side_e * w * 0.10 - w * 0.04, hood_base_y + h * 0.08, hood_ring_r * 0.60),
			Vector3(side_e * w * 0.10 + w * 0.04, hood_base_y + h * 0.14, hood_ring_r * 0.70),
			glow, 0.15, 0.25
		)

	# ----- ARMS — emerge from wide sleeves. Left arm down, right raises staff. -----
	# Left arm — hanging
	var l_shoulder := Vector3(-w * 0.30, clearance + h * 0.62, 0.0)
	var l_elbow := Vector3(-w * 0.45, clearance + h * 0.30, d * 0.10)
	var l_wrist := Vector3(-w * 0.40, clearance + h * 0.05, d * 0.15)
	# Sleeve (wider than arm)
	_build_tapered_segment(root, l_shoulder, w * 0.18, l_elbow, w * 0.15, robe, 0.95)
	# Hand emerges
	_build_box(
		root,
		Vector3(l_wrist.x - w * 0.06, l_wrist.y - h * 0.06, l_wrist.z - d * 0.06),
		Vector3(l_wrist.x + w * 0.06, l_wrist.y + h * 0.02, l_wrist.z + d * 0.08),
		skin, 0.85
	)

	# Right arm — raised, holding staff
	var r_shoulder := Vector3(w * 0.30, clearance + h * 0.62, 0.0)
	var r_elbow := Vector3(w * 0.45, clearance + h * 0.55, d * 0.10)
	var r_hand := Vector3(w * 0.40, clearance + h * 0.45, d * 0.20)
	_build_tapered_segment(root, r_shoulder, w * 0.18, r_elbow, w * 0.15, robe, 0.95)
	_build_tapered_segment(root, r_elbow, w * 0.10, r_hand, w * 0.08, skin, 0.85)
	# Hand on staff
	_build_box(
		root,
		Vector3(r_hand.x - w * 0.07, r_hand.y - h * 0.05, r_hand.z - d * 0.07),
		Vector3(r_hand.x + w * 0.07, r_hand.y + h * 0.03, r_hand.z + d * 0.07),
		skin, 0.85
	)

	# ----- STAFF — wooden pole topped with glowing orb -----
	var staff_bot := Vector3(r_hand.x + w * 0.05, 0.0, r_hand.z + d * 0.05)
	var staff_top := Vector3(r_hand.x + w * 0.05, clearance + h * 1.05, r_hand.z + d * 0.05)
	_build_tapered_segment(root, staff_bot, w * 0.035, staff_top, w * 0.030, staff_wood, 0.85)
	# Orb at top
	_build_box(
		root,
		Vector3(staff_top.x - w * 0.08, staff_top.y - h * 0.04, staff_top.z - w * 0.08),
		Vector3(staff_top.x + w * 0.08, staff_top.y + h * 0.10, staff_top.z + w * 0.08),
		glow, 0.20, 0.40
	)
	# Claw mount around orb (4 small spikes)
	for ci in range(4):
		var ang: float = TAU * float(ci) / 4.0
		var c_base := Vector3(staff_top.x + cos(ang) * w * 0.06, staff_top.y - h * 0.04, staff_top.z + sin(ang) * w * 0.06)
		var c_tip := Vector3(staff_top.x + cos(ang) * w * 0.12, staff_top.y + h * 0.08, staff_top.z + sin(ang) * w * 0.12)
		_build_tapered_segment(root, c_base, w * 0.02, c_tip, w * 0.005, staff_wood.darkened(0.20), 0.85)

# ============================================================================
# SATYR — humanoid torso + digitigrade goat legs + curling horns + tail
# ============================================================================
##
## Key traits:
##   GOAT LEGS — digitigrade reverse-knee, ending in cloven hooves
##   FURRY LOWER HALF (different color from upper torso skin)
##   HUMAN-ISH UPPER (slim, athletic, exposed torso)
##   CURLING RAM HORNS on head
##   POINTED EARS
##   SHORT TAIL TUFT

static func _build_satyr(plan: Dictionary, root: Node3D) -> void:
	var base: Dictionary = plan.get("base", {})
	var palette: Dictionary = plan.get("palette", {})
	var limbs: Dictionary = plan.get("limbs", {})

	var w: float = _axis(base, "width", 0.50)
	var h: float = _axis(base, "height", 1.15)
	var d: float = _axis(base, "depth", 0.32)
	var leg_length: float = float(limbs.get("leg_length", 0.55))
	var clearance: float = leg_length

	var skin: Color = palette.get("primary", Color(0.82, 0.70, 0.55))
	var fur: Color = palette.get("secondary", Color(0.40, 0.28, 0.18))
	var fur_dark: Color = fur.darkened(0.20)
	var horn: Color = palette.get("accent", Color(0.45, 0.32, 0.20))
	var hoof: Color = Color(0.20, 0.14, 0.08)
	var hair: Color = palette.get("hair", fur)
	var eye_color: Color = palette.get("eye", Color(0.55, 0.40, 0.20))

	# ----- UPPER TORSO (human-ish) — 3 rings: hip / chest / shoulder -----
	var hip_y: float = clearance + h * 0.05
	var chest_y: float = clearance + h * 0.32
	var shoulder_y: float = clearance + h * 0.50
	var t_centers := [
		Vector3(0, hip_y, 0),
		Vector3(0, chest_y, 0),
		Vector3(0, shoulder_y, 0),
	]
	var t_radii := [
		Vector3(w * 0.28, 0, d * 0.40),
		Vector3(w * 0.34, 0, d * 0.45),
		Vector3(w * 0.40, 0, d * 0.38),
	]
	var st := SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	var rings: Array = []
	for i in range(3):
		var c: Vector3 = t_centers[i]
		var rv: Vector3 = t_radii[i]
		var verts: Array = []
		for j in range(8):
			var ang: float = TAU * float(j) / 8.0
			verts.append(Vector3(c.x + cos(ang) * rv.x, c.y, c.z + sin(ang) * rv.z))
		rings.append(verts)
	for i in range(2):
		for j in range(8):
			var k: int = (j + 1) % 8
			_add_quad(st, rings[i][j], rings[i][k], rings[i + 1][k], rings[i + 1][j])
	_add_quad(st, rings[2][0], rings[2][1], rings[2][2], rings[2][3])
	_add_quad(st, rings[2][4], rings[2][5], rings[2][6], rings[2][7])
	st.generate_normals()
	var mi := MeshInstance3D.new()
	mi.mesh = st.commit()
	var mat := StandardMaterial3D.new()
	mat.albedo_color = skin
	mat.roughness = 0.85
	mat.cull_mode = BaseMaterial3D.CULL_DISABLED
	mi.material_override = mat
	root.add_child(mi)

	# ----- FUR WAISTBAND (transition from skin to goat lower half) -----
	# Wide tufted band at hips
	for i in range(8):
		var ang: float = TAU * float(i) / 8.0
		var ang2: float = TAU * float(i + 1) / 8.0
		var ru: float = w * 0.30
		var rb: float = w * 0.36
		var st_f := SurfaceTool.new()
		st_f.begin(Mesh.PRIMITIVE_TRIANGLES)
		var p0u := Vector3(cos(ang) * ru, hip_y, sin(ang) * ru)
		var p1u := Vector3(cos(ang2) * ru, hip_y, sin(ang2) * ru)
		var p0d := Vector3(cos(ang) * rb, hip_y - h * 0.10, sin(ang) * rb)
		var p1d := Vector3(cos(ang2) * rb, hip_y - h * 0.10, sin(ang2) * rb)
		_add_quad(st_f, p0u, p1u, p1d, p0d)
		st_f.generate_normals()
		var mi_f := MeshInstance3D.new()
		mi_f.mesh = st_f.commit()
		var mat_f := StandardMaterial3D.new()
		mat_f.albedo_color = fur
		mat_f.roughness = 0.95
		mat_f.cull_mode = BaseMaterial3D.CULL_DISABLED
		mi_f.material_override = mat_f
		root.add_child(mi_f)

	# ----- NECK — tapered segment connecting torso shoulder ring to head.
	# Without this the head literally floats h*0.18 above the torso top.
	var head_anchor := Vector3(0, shoulder_y + h * 0.20, 0)
	var neck_base := Vector3(0, shoulder_y, 0)
	_build_tapered_segment(
		root,
		neck_base, w * 0.18,
		head_anchor + Vector3(0, -h * 0.02, 0), w * 0.16,
		skin, 0.85
	)
	# Cranium
	_build_box(
		root,
		Vector3(-w * 0.22, head_anchor.y - h * 0.02, -d * 0.40),
		Vector3(w * 0.22, head_anchor.y + h * 0.18, d * 0.45),
		skin, 0.85
	)
	# Jaw
	_build_box(
		root,
		Vector3(-w * 0.18, head_anchor.y - h * 0.10, -d * 0.20),
		Vector3(w * 0.18, head_anchor.y + h * 0.02, d * 0.42),
		skin.darkened(0.05), 0.85
	)
	# Eyes (yellow goat-like) — sit ON the cranium front face, not inside it.
	# Cranium front is at z = d*0.45; jaw front at z = d*0.42; so we anchor the
	# eye back at the cranium front and protrude slightly forward.
	for side_e in [-1, 1]:
		_build_box(
			root,
			Vector3(side_e * w * 0.13 - w * 0.05, head_anchor.y + h * 0.06, d * 0.46),
			Vector3(side_e * w * 0.13 + w * 0.05, head_anchor.y + h * 0.13, d * 0.51),
			eye_color, 0.25, 0.15
		)
		# Dark vertical goat-pupil slit centered in the eye
		_build_box(
			root,
			Vector3(side_e * w * 0.13 - w * 0.012, head_anchor.y + h * 0.07, d * 0.51),
			Vector3(side_e * w * 0.13 + w * 0.012, head_anchor.y + h * 0.12, d * 0.515),
			Color(0.05, 0.04, 0.03), 0.30
		)
	# Pointed ears
	for side in [-1, 1]:
		var ear_root := Vector3(side * w * 0.22, head_anchor.y + h * 0.10, 0)
		var ear_tip := Vector3(side * w * 0.40, head_anchor.y + h * 0.20, -d * 0.05)
		_build_tapered_segment(root, ear_root, w * 0.05, ear_tip, w * 0.005, skin, 0.85)

	# ----- CURLING RAM HORNS — built as series of segments curving back/down -----
	for side in [-1, 1]:
		var horn_base := Vector3(side * w * 0.18, head_anchor.y + h * 0.18, 0)
		# Curl: 4 segments, angle wrapping back
		var prev := horn_base
		var prev_r: float = w * 0.06
		for i in range(4):
			var t: float = float(i + 1) / 4.0
			var ang: float = t * PI * 0.85   # curls back and down by ~155deg
			var px: float = side * (w * 0.18 + sin(ang) * w * 0.18)
			var py: float = head_anchor.y + h * 0.18 + cos(ang) * h * 0.18 - h * 0.05
			var pz: float = -sin(ang) * d * 0.20
			var p := Vector3(px, py, pz)
			var r: float = prev_r * 0.80
			_build_tapered_segment(root, prev, prev_r, p, r, horn, 0.55)
			prev = p
			prev_r = r

	# ----- HAIR / BEARD tuft -----
	_build_box(
		root,
		Vector3(-w * 0.16, head_anchor.y + h * 0.16, -d * 0.35),
		Vector3(w * 0.16, head_anchor.y + h * 0.28, d * 0.10),
		hair, 0.95
	)
	# Goatee
	_build_box(
		root,
		Vector3(-w * 0.06, head_anchor.y - h * 0.12, d * 0.30),
		Vector3(w * 0.06, head_anchor.y - h * 0.02, d * 0.45),
		hair, 0.95
	)

	# ----- ARMS — slim humanoid -----
	for side in [-1, 1]:
		var sh := Vector3(side * w * 0.40, shoulder_y, 0)
		var elbow := Vector3(side * w * 0.50, clearance + h * 0.22, d * 0.05)
		var wrist := Vector3(side * w * 0.45, clearance + h * 0.02, d * 0.10)
		_build_tapered_segment(root, sh, w * 0.08, elbow, w * 0.07, skin, 0.85)
		_build_tapered_segment(root, elbow, w * 0.07, wrist, w * 0.06, skin, 0.85)
		_build_box(
			root,
			Vector3(wrist.x - w * 0.05, wrist.y - h * 0.06, wrist.z - d * 0.05),
			Vector3(wrist.x + w * 0.05, wrist.y + h * 0.02, wrist.z + d * 0.07),
			skin, 0.85
		)

	# ----- GOAT LEGS — digitigrade with hooves -----
	# Digitigrade = thigh forward, "knee" actually the ankle bending back, hoof
	# at the end. Two segments + hoof.
	for side in [-1, 1]:
		var hip_x: float = side * w * 0.16
		var hip_pos := Vector3(hip_x, hip_y - h * 0.05, 0)
		# Knee (reverse) — bends FORWARD then back to the heel above hoof
		var knee := Vector3(hip_x, clearance * 0.65, d * 0.10)
		var heel := Vector3(hip_x, clearance * 0.30, -d * 0.05)
		var hoof_top := Vector3(hip_x, clearance * 0.10, d * 0.02)
		# Thigh (covered in fur — slightly fatter)
		_build_tapered_segment(root, hip_pos, w * 0.16, knee, w * 0.12, fur, 0.95)
		# Shank
		_build_tapered_segment(root, knee, w * 0.11, heel, w * 0.08, fur_dark, 0.95)
		# Pastern (joins heel to hoof top)
		_build_tapered_segment(root, heel, w * 0.08, hoof_top, w * 0.07, fur_dark, 0.95)
		# Hoof — split cloven, two small boxes
		for hside in [-1, 1]:
			_build_box(
				root,
				Vector3(hoof_top.x + hside * w * 0.03 - w * 0.04, 0.0, hoof_top.z - d * 0.05),
				Vector3(hoof_top.x + hside * w * 0.03 + w * 0.04, h * 0.08, hoof_top.z + d * 0.12),
				hoof, 0.50
			)

	# ----- SHORT TAIL TUFT -----
	var tail_root := Vector3(0, hip_y - h * 0.05, -d * 0.45)
	var tail_tip := Vector3(0, hip_y + h * 0.02, -d * 0.65)
	_build_tapered_segment(root, tail_root, w * 0.06, tail_tip, w * 0.04, fur, 0.95)

# ============================================================================
# ELEMENTAL — branches on plan.meta.element_type:
#   "fire"   → tall flame column with arms
#   "ice" / "water" → flowing wave with crested top and arms (water uses ice)
#   "earth"  → blocky rock golem with crystal seams
#   "air"    → swirling vertical vortex with wispy limbs
#   default  → fire variant
# ============================================================================

static func _build_elemental(plan: Dictionary, root: Node3D) -> void:
	var meta: Dictionary = plan.get("meta", {})
	var element: String = String(meta.get("element_type", "fire"))
	match element:
		"fire":           _build_elemental_fire(plan, root)
		"ice", "water":   _build_elemental_water(plan, root)
		"earth", "stone": _build_elemental_earth(plan, root)
		"air", "lightning", "thunder": _build_elemental_air(plan, root)
		_:                _build_elemental_fire(plan, root)

# ----- Fire Elemental — flame column with raised arms ------------------------
static func _build_elemental_fire(plan: Dictionary, root: Node3D) -> void:
	var base: Dictionary = plan.get("base", {})
	var palette: Dictionary = plan.get("palette", {})
	var w: float = _axis(base, "width", 0.65)
	var h: float = _axis(base, "height", 1.50)

	var flame: Color = palette.get("primary", Color(1.0, 0.45, 0.10))
	var deep: Color = palette.get("secondary", Color(0.75, 0.15, 0.05))
	var core: Color = palette.get("accent", Color(1.0, 0.95, 0.55))
	var eye_color: Color = palette.get("eye", Color(1.0, 0.95, 0.35))

	# Tall undulating flame column — rings of 8 verts with jitter
	var n: int = 9
	var rings: Array = []
	for i in range(n):
		var t: float = float(i) / float(n - 1)
		var y: float = t * h * 1.55
		# Radius pulses — wide at base, narrow at top
		var r: float = lerpf(w * 0.55, w * 0.08, t) * (1.0 + 0.10 * sin(t * 8.0))
		var verts: Array = []
		for j in range(8):
			var ang: float = TAU * float(j) / 8.0
			# Flicker — radial jitter per vertex
			var jitter: float = 1.0 + 0.10 * sin(ang * 3.0 + t * 6.0)
			verts.append(Vector3(cos(ang) * r * jitter, y, sin(ang) * r * jitter))
		rings.append(verts)
	var st := SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	for i in range(n - 1):
		for j in range(8):
			var k: int = (j + 1) % 8
			_add_quad(st, rings[i][j], rings[i][k], rings[i + 1][k], rings[i + 1][j])
	# Pointed top — collapse to a single tip
	var top := Vector3(0, h * 1.70, 0)
	for j in range(8):
		var k: int = (j + 1) % 8
		_add_tri(st, rings[n - 1][j], rings[n - 1][k], top)
	st.generate_normals()
	var mi := MeshInstance3D.new()
	mi.mesh = st.commit()
	var mat := StandardMaterial3D.new()
	mat.albedo_color = flame
	mat.emission_enabled = true
	mat.emission = flame
	mat.emission_energy_multiplier = 0.6
	mat.roughness = 0.35
	mat.cull_mode = BaseMaterial3D.CULL_DISABLED
	mi.material_override = mat
	root.add_child(mi)

	# Hotter core inside — narrower flame column with bright yellow
	var n2: int = 7
	var rings_c: Array = []
	for i in range(n2):
		var t: float = float(i) / float(n2 - 1)
		var y: float = t * h * 1.35
		var r: float = lerpf(w * 0.30, w * 0.04, t)
		var verts: Array = []
		for j in range(6):
			var ang: float = TAU * float(j) / 6.0
			verts.append(Vector3(cos(ang) * r, y, sin(ang) * r))
		rings_c.append(verts)
	var st_c := SurfaceTool.new()
	st_c.begin(Mesh.PRIMITIVE_TRIANGLES)
	for i in range(n2 - 1):
		for j in range(6):
			var k: int = (j + 1) % 6
			_add_quad(st_c, rings_c[i][j], rings_c[i][k], rings_c[i + 1][k], rings_c[i + 1][j])
	st_c.generate_normals()
	var mi_c := MeshInstance3D.new()
	mi_c.mesh = st_c.commit()
	var mat_c := StandardMaterial3D.new()
	mat_c.albedo_color = core
	mat_c.emission_enabled = true
	mat_c.emission = core
	mat_c.emission_energy_multiplier = 1.5
	mat_c.roughness = 0.20
	mat_c.cull_mode = BaseMaterial3D.CULL_DISABLED
	mi_c.material_override = mat_c
	root.add_child(mi_c)

	# Two flame arms raised upward, made of 3 spike segments
	for side in [-1, 1]:
		var prev := Vector3(side * w * 0.40, h * 0.55, 0)
		var prev_r: float = w * 0.12
		for i in range(3):
			var t: float = float(i + 1) / 3.0
			var p := Vector3(
				side * (w * 0.40 + t * w * 0.45),
				h * 0.55 + t * h * 0.55,
				0
			)
			var r: float = prev_r * 0.65
			_build_tapered_segment(root, prev, prev_r, p, r, deep, 0.40)
			prev = p
			prev_r = r

	# Two eye flames
	for side in [-1, 1]:
		_build_box(
			root,
			Vector3(side * w * 0.10 - w * 0.05, h * 1.05, w * 0.12),
			Vector3(side * w * 0.10 + w * 0.05, h * 1.18, w * 0.25),
			eye_color, 0.20, 0.30
		)

# ----- Water Elemental — flowing wave with crest and arms --------------------
static func _build_elemental_water(plan: Dictionary, root: Node3D) -> void:
	var base: Dictionary = plan.get("base", {})
	var palette: Dictionary = plan.get("palette", {})
	var w: float = _axis(base, "width", 0.85)
	var h: float = _axis(base, "height", 1.30)

	var water: Color = palette.get("primary", Color(0.18, 0.35, 0.65))
	var crest: Color = palette.get("secondary", Color(0.55, 0.80, 0.95))
	var foam: Color = palette.get("accent", Color(0.92, 0.96, 1.0))
	var eye_color: Color = palette.get("eye", Color(0.50, 0.90, 1.0))

	# Wide rolling wave — wider at base, peaked top curling forward
	var n: int = 7
	var rings: Array = []
	for i in range(n):
		var t: float = float(i) / float(n - 1)
		var y: float = t * h * 1.20
		var r: float = lerpf(w * 0.65, w * 0.20, t)
		# Lean the top forward (+z) — wave curl
		var lean_z: float = smoothstep(0.5, 1.0, t) * w * 0.35
		var verts: Array = []
		for j in range(8):
			var ang: float = TAU * float(j) / 8.0
			verts.append(Vector3(cos(ang) * r, y, sin(ang) * r + lean_z))
		rings.append(verts)
	var st := SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	for i in range(n - 1):
		for j in range(8):
			var k: int = (j + 1) % 8
			_add_quad(st, rings[i][j], rings[i][k], rings[i + 1][k], rings[i + 1][j])
	st.generate_normals()
	var mi := MeshInstance3D.new()
	mi.mesh = st.commit()
	var mat := StandardMaterial3D.new()
	mat.albedo_color = water
	mat.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	mat.albedo_color.a = 0.78
	mat.metallic = 0.40
	mat.roughness = 0.20
	mat.cull_mode = BaseMaterial3D.CULL_DISABLED
	mi.material_override = mat
	root.add_child(mi)

	# Foam crest on top — small ring of jagged foam spikes
	for i in range(10):
		var ang: float = TAU * float(i) / 10.0
		var top_y: float = h * 1.20
		var spike_top := Vector3(cos(ang) * w * 0.22, top_y + h * (0.10 + 0.05 * sin(float(i) * 1.7)),
								  sin(ang) * w * 0.22 + w * 0.35)
		var spike_base := Vector3(cos(ang) * w * 0.20, top_y, sin(ang) * w * 0.20 + w * 0.35)
		_build_tapered_segment(root, spike_base, w * 0.05, spike_top, w * 0.01, foam, 0.30)

	# Two flowing arms — wave-like
	for side in [-1, 1]:
		var sh := Vector3(side * w * 0.55, h * 0.80, w * 0.10)
		var elbow := Vector3(side * w * 0.80, h * 0.50, w * 0.30)
		var hand := Vector3(side * w * 0.95, h * 0.30, w * 0.40)
		_build_tapered_segment(root, sh, w * 0.18, elbow, w * 0.14, water, 0.20, 0.40)
		_build_tapered_segment(root, elbow, w * 0.13, hand, w * 0.08, crest, 0.20, 0.40)

	# Two glowing eyes near top
	for side in [-1, 1]:
		_build_box(
			root,
			Vector3(side * w * 0.10 - w * 0.05, h * 0.95, w * 0.30),
			Vector3(side * w * 0.10 + w * 0.05, h * 1.05, w * 0.40),
			eye_color, 0.15, 0.30
		)

# ----- Earth Elemental — chunky boulder golem with crystal veins -------------
static func _build_elemental_earth(plan: Dictionary, root: Node3D) -> void:
	var base: Dictionary = plan.get("base", {})
	var palette: Dictionary = plan.get("palette", {})
	var w: float = _axis(base, "width", 0.95)
	var h: float = _axis(base, "height", 1.40)

	var rock: Color = palette.get("primary", Color(0.48, 0.42, 0.35))
	var rock_dark: Color = rock.darkened(0.25)
	var crystal: Color = palette.get("accent", Color(0.85, 0.70, 0.30))
	var eye_color: Color = palette.get("eye", Color(0.95, 0.70, 0.20))

	# Body — 4 stacked irregular boulders
	# Lower (legs/base) — wide flat
	_build_box(
		root,
		Vector3(-w * 0.55, 0, -w * 0.50),
		Vector3(w * 0.55, h * 0.30, w * 0.50),
		rock_dark, 0.95
	)
	# Mid torso — slightly narrower
	_build_box(
		root,
		Vector3(-w * 0.50, h * 0.25, -w * 0.45),
		Vector3(w * 0.50, h * 0.75, w * 0.45),
		rock, 0.95
	)
	# Chunky shoulders
	_build_box(
		root,
		Vector3(-w * 0.65, h * 0.70, -w * 0.40),
		Vector3(w * 0.65, h * 0.95, w * 0.40),
		rock, 0.95
	)
	# Head — small block
	_build_box(
		root,
		Vector3(-w * 0.25, h * 0.95, -w * 0.25),
		Vector3(w * 0.25, h * 1.20, w * 0.30),
		rock_dark, 0.95
	)
	# Glowing crystal eyes set into head
	for side_e in [-1, 1]:
		_build_box(
			root,
			Vector3(side_e * w * 0.12 - w * 0.06, h * 1.05, w * 0.28),
			Vector3(side_e * w * 0.12 + w * 0.06, h * 1.15, w * 0.34),
			eye_color, 0.20, 0.30
		)

	# Crystal growths protruding from shoulders and back
	for i in range(5):
		var t: float = float(i) / 4.0
		var cx: float = lerpf(-w * 0.50, w * 0.50, t)
		var ang_jit: float = sin(float(i) * 2.3)
		var base_p := Vector3(cx, h * (0.92 + ang_jit * 0.05), -w * 0.20)
		var tip_p := Vector3(cx + ang_jit * w * 0.10, h * (1.20 + ang_jit * 0.10), -w * (0.30 + abs(ang_jit) * 0.10))
		_build_tapered_segment(root, base_p, w * 0.06, tip_p, w * 0.015, crystal, 0.20, 0.40)

	# Heavy arms — boulder fists
	for side in [-1, 1]:
		var sh := Vector3(side * w * 0.65, h * 0.82, 0)
		var elbow := Vector3(side * w * 0.85, h * 0.45, w * 0.10)
		var fist := Vector3(side * w * 0.75, h * 0.10, w * 0.10)
		_build_tapered_segment(root, sh, w * 0.22, elbow, w * 0.20, rock, 0.95)
		_build_tapered_segment(root, elbow, w * 0.19, fist, w * 0.18, rock, 0.95)
		# Big rock fist
		_build_box(
			root,
			Vector3(fist.x - w * 0.25, fist.y - h * 0.20, fist.z - w * 0.22),
			Vector3(fist.x + w * 0.25, fist.y + h * 0.05, fist.z + w * 0.22),
			rock_dark, 0.95
		)

	# Stubby legs hidden inside base — visible foot blocks
	for side in [-1, 1]:
		_build_box(
			root,
			Vector3(side * w * 0.30 - w * 0.20, 0, -w * 0.30),
			Vector3(side * w * 0.30 + w * 0.20, h * 0.10, w * 0.35),
			rock_dark, 0.95
		)

# ----- Air Elemental — swirling vertical vortex with wispy limbs -------------
static func _build_elemental_air(plan: Dictionary, root: Node3D) -> void:
	var base: Dictionary = plan.get("base", {})
	var palette: Dictionary = plan.get("palette", {})
	var w: float = _axis(base, "width", 0.75)
	var h: float = _axis(base, "height", 1.60)

	var wind: Color = palette.get("primary", Color(0.80, 0.88, 0.95))
	var cloud: Color = palette.get("secondary", Color(0.65, 0.75, 0.88))
	var spark: Color = palette.get("accent", Color(1.0, 1.0, 0.85))
	var eye_color: Color = palette.get("eye", Color(0.95, 1.0, 1.0))

	# Vortex — 4 spiraling tubes building the funnel silhouette
	# Each spiral is a series of segments rotating around Y as Y rises.
	for s in range(4):
		var spiral_offset: float = TAU * float(s) / 4.0
		var prev: Vector3 = Vector3(cos(spiral_offset) * w * 0.50, 0.1, sin(spiral_offset) * w * 0.50)
		var prev_r: float = w * 0.10
		for i in range(8):
			var t: float = float(i + 1) / 8.0
			var ang: float = spiral_offset + t * TAU * 1.5    # 1.5 full turns
			var r: float = lerpf(w * 0.50, w * 0.15, t)
			var y: float = t * h * 1.35 + 0.1
			var p := Vector3(cos(ang) * r, y, sin(ang) * r)
			var thick: float = prev_r * (0.95 - t * 0.4)
			_build_tapered_segment(root, prev, prev_r, p, thick, wind, 0.30, 0.10)
			prev = p
			prev_r = thick

	# Translucent core wisp body
	var n: int = 7
	var rings: Array = []
	for i in range(n):
		var t: float = float(i) / float(n - 1)
		var y: float = t * h * 1.50
		var r: float = lerpf(w * 0.30, w * 0.06, t)
		var verts: Array = []
		for j in range(6):
			var ang: float = TAU * float(j) / 6.0
			verts.append(Vector3(cos(ang) * r, y, sin(ang) * r))
		rings.append(verts)
	var st := SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	for i in range(n - 1):
		for j in range(6):
			var k: int = (j + 1) % 6
			_add_quad(st, rings[i][j], rings[i][k], rings[i + 1][k], rings[i + 1][j])
	st.generate_normals()
	var mi := MeshInstance3D.new()
	mi.mesh = st.commit()
	var mat := StandardMaterial3D.new()
	mat.albedo_color = cloud
	mat.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	mat.albedo_color.a = 0.55
	mat.roughness = 0.30
	mat.cull_mode = BaseMaterial3D.CULL_DISABLED
	mi.material_override = mat
	root.add_child(mi)

	# Two flowing arms — like wind streaks
	for side in [-1, 1]:
		var prev := Vector3(side * w * 0.20, h * 0.85, 0)
		var prev_r: float = w * 0.10
		for i in range(4):
			var t: float = float(i + 1) / 4.0
			var p := Vector3(
				side * (w * 0.20 + sin(t * PI) * w * 0.60),
				h * 0.85 - t * h * 0.40,
				cos(t * PI) * w * 0.25
			)
			var r: float = prev_r * 0.75
			_build_tapered_segment(root, prev, prev_r, p, r, wind, 0.30, 0.10)
			prev = p
			prev_r = r

	# Glowing eyes inside the vortex
	for side in [-1, 1]:
		_build_box(
			root,
			Vector3(side * w * 0.10 - w * 0.05, h * 1.05, w * 0.10),
			Vector3(side * w * 0.10 + w * 0.05, h * 1.15, w * 0.22),
			eye_color, 0.10, 0.40
		)

	# Lightning spark cluster at top
	for i in range(5):
		var ang: float = TAU * float(i) / 5.0
		var p_base := Vector3(cos(ang) * w * 0.08, h * 1.45, sin(ang) * w * 0.08)
		var p_tip := Vector3(cos(ang) * w * 0.18, h * 1.65, sin(ang) * w * 0.18)
		_build_tapered_segment(root, p_base, w * 0.025, p_tip, w * 0.005, spark, 0.10, 0.50)

# ============================================================================
# Shared helper — build a swept ring-extruded body from a list of cross-sections.
# Applies the Rune Vision technique (extruded rectangles along a bone path).
# Each section is (center_pos, half_width, half_height, optional_color_override).
# Returns the rings array so callers can attach legs/head to specific sections.
# ============================================================================
##
## [sections] Array of Dictionaries with keys "center" (Vector3), "w" (float, half-width),
##            "h" (float, half-height), optional "color" (per-ring color override).
## [vertex_count] 8 by default. Use 6 for chunkier silhouettes, 10 for smoother.
## [primary_color] Default surface color when section has no override.
## [belly_color] If non-empty, ring-vertices at indices 4..ringN/2 are split into
##                their own MeshInstance with belly_color (lighter underside).
## [roughness] Material roughness (0..1).
## [cap_ends] If true, add a triangle fan at both ends to close the tube.
## Returns: Array of rings, each ring an Array[Vector3] of vertex_count entries.

static func _swept_body(root: Node3D, sections: Array, vertex_count: int,
		primary_color: Color, belly_color: Color, roughness: float,
		cap_ends: bool) -> Array:
	if sections.size() < 2:
		return []
	# CRITICAL: detect which world axis the sections are stacked along so the
	# CROSS-SECTION ring is built PERPENDICULAR to that axis.
	# Horizontal bodies (wolf, pig, dragon) stack along Z → rings in X-Y plane.
	# Vertical bodies (pixie, fire elemental, wraith) stack along Y → rings
	# in X-Z plane. Previously _swept_body always built rings in X-Y, so any
	# vertical body came out FLAT at z=0 (the user-reported "main body still
	# flat" pixie bug).
	var dz: float = abs(sections[sections.size() - 1]["center"].z - sections[0]["center"].z)
	var dy: float = abs(sections[sections.size() - 1]["center"].y - sections[0]["center"].y)
	var vertical: bool = dy > dz
	var rings: Array = []
	for sec in sections:
		var c: Vector3 = sec["center"]
		var hw: float = float(sec["w"])
		var hh: float = float(sec["h"])
		var verts: Array = []
		for j in range(vertex_count):
			var ang: float = TAU * float(j) / float(vertex_count)
			if vertical:
				# Vertical body — ring lies in the X-Z plane perpendicular to Y.
				# Width on X, "height" of the oval maps to depth on Z.
				verts.append(Vector3(c.x + cos(ang) * hw, c.y, c.z + sin(ang) * hh))
			else:
				# Horizontal body — ring lies in the X-Y plane perpendicular to Z.
				verts.append(Vector3(c.x + cos(ang) * hw, c.y + sin(ang) * hh, c.z))
		rings.append(verts)

	var has_belly: bool = belly_color.a > 0.0
	var st_top := SurfaceTool.new()
	st_top.begin(Mesh.PRIMITIVE_TRIANGLES)
	var st_belly := SurfaceTool.new()
	if has_belly:
		st_belly.begin(Mesh.PRIMITIVE_TRIANGLES)

	# Determine belly index range — bottom half: indices floor(N/4)+1 .. floor(3N/4)
	var belly_start: int = int(floor(float(vertex_count) * 0.625))
	var belly_end: int = int(floor(float(vertex_count) * 0.875))

	for i in range(rings.size() - 1):
		var ra: Array = rings[i]
		var rb: Array = rings[i + 1]
		for j in range(vertex_count):
			var k: int = (j + 1) % vertex_count
			if has_belly and j >= belly_start and j < belly_end:
				_add_quad(st_belly, ra[j], ra[k], rb[k], rb[j])
			else:
				_add_quad(st_top, ra[j], ra[k], rb[k], rb[j])

	if cap_ends:
		# Front cap (last ring) — fan to its centroid pushed slightly forward.
		# CRITICAL: the cap push distance is PROPORTIONAL to the cross-section
		# radius, not a fixed 0.05 world units. Previously the 0.05 cap was
		# huge relative to tiny creatures like the Pixie (effective scale
		# ~0.16×), creating spikes 25× wider than the eye / wider than the
		# body. By scaling to the section size we get a small dome cap on
		# big bodies and an even smaller dome cap on tiny ones.
		var last: Array = rings[rings.size() - 1]
		var sum_last := Vector3.ZERO
		for v in last:
			sum_last += v
		var front_center: Vector3 = sum_last / float(vertex_count)
		var last_r: float = max(float(sections[sections.size() - 1]["w"]), float(sections[sections.size() - 1]["h"]))
		var forward: Vector3 = sections[sections.size() - 1]["center"] - sections[sections.size() - 2]["center"]
		# Cap pushes out by ~30% of the ring's radius — looks like a dome,
		# never a spike, regardless of overall creature scale.
		front_center += forward.normalized() * (last_r * 0.30)
		for j in range(vertex_count):
			var k: int = (j + 1) % vertex_count
			_add_tri(st_top, last[j], last[k], front_center)
		# Back cap (first ring)
		var first: Array = rings[0]
		var sum_first := Vector3.ZERO
		for v in first:
			sum_first += v
		var back_center: Vector3 = sum_first / float(vertex_count)
		var first_r: float = max(float(sections[0]["w"]), float(sections[0]["h"]))
		var backward: Vector3 = sections[0]["center"] - sections[1]["center"]
		back_center += backward.normalized() * (first_r * 0.30)
		for j in range(vertex_count):
			var k: int = (j + 1) % vertex_count
			_add_tri(st_top, first[k], first[j], back_center)

	st_top.generate_normals()
	var mi := MeshInstance3D.new()
	mi.mesh = st_top.commit()
	var mat := StandardMaterial3D.new()
	mat.albedo_color = primary_color
	mat.roughness = roughness
	mat.cull_mode = BaseMaterial3D.CULL_DISABLED
	mi.material_override = mat
	root.add_child(mi)

	if has_belly:
		st_belly.generate_normals()
		var mi_b := MeshInstance3D.new()
		mi_b.mesh = st_belly.commit()
		var mat_b := StandardMaterial3D.new()
		mat_b.albedo_color = belly_color
		mat_b.roughness = min(1.0, roughness + 0.05)
		mat_b.cull_mode = BaseMaterial3D.CULL_DISABLED
		mi_b.material_override = mat_b
		root.add_child(mi_b)
	return rings

# ============================================================================
# PIG (swine_like) — barrel-shaped body, flat-disk snout, tiny curl tail
# ============================================================================
##
## Why this exists separately from _build_bear:
##   A Pig is NOT a small bear. Distinct silhouette features:
##     - BARREL TORSO: roughly cylindrical, very wide at belly, nearly as
##       wide as it is long. No shoulder hump.
##     - SHORT NECK transitioning directly to a large WEDGE HEAD.
##     - FLAT DISK SNOUT — the iconic round pink front face with two nostrils.
##     - SMALL UPRIGHT TRIANGULAR EARS pointing up & outward.
##     - 4 SHORT STUBBY LEGS ending in CLOVEN HOOVES (no claws).
##     - TINY CURL TAIL on the rear.
##
## Routed via CreatureSignatures: Pig/Boar/Dire Boar/Hog → swine_like.

static func _build_swine(plan: Dictionary, root: Node3D) -> void:
	var base: Dictionary = plan.get("base", {})
	var palette: Dictionary = plan.get("palette", {})
	var limbs: Dictionary = plan.get("limbs", {})
	var meta: Dictionary = plan.get("meta", {})
	var species: String = String(meta.get("species", ""))

	# Barrel proportions — width ≈ depth so the silhouette reads as a rounded
	# barrel, not an elongated wolf body.
	var w: float = _axis(base, "width", 0.85)
	var h: float = _axis(base, "height", 0.55)
	var d: float = _axis(base, "depth", 1.05)
	var leg_length: float = float(limbs.get("leg_length", 0.22))
	var clearance: float = leg_length

	# ============================================================================
	# PER-SPECIES VARIATION — different species mapped to swine_like should not
	# all look identical. We tune four scalars based on species name:
	#   ear_scale       — small (boars/hippos) → big (cows/elephants)
	#   body_fat        — 1.0 (pig) → 1.5 (hippo)
	#   tail_kind       — "curly" (pigs) or "whippy" (cows) or "stub" (boars)
	#   tusks           — none / small (warthog) / big (boar/dire boar)
	# ============================================================================
	var species_lower: String = species.to_lower()
	var ear_scale: float = 1.0
	var body_fat: float = 1.0
	var tail_kind: String = "curly"
	var tusk_size: float = 0.0       # 0 = none, 1 = boar, 1.4 = dire boar
	if "dire boar" in species_lower:
		ear_scale = 0.7
		body_fat = 1.15
		tail_kind = "stub"
		tusk_size = 1.4
	elif "boar" in species_lower or "warthog" in species_lower:
		ear_scale = 0.75
		body_fat = 1.05
		tail_kind = "stub"
		tusk_size = 1.0
	elif "hog" in species_lower:
		ear_scale = 0.9
		body_fat = 1.0
		tusk_size = 0.6
	elif "cow" in species_lower or "ox" in species_lower or "aurochs" in species_lower or "yak" in species_lower:
		ear_scale = 1.3
		body_fat = 1.10
		tail_kind = "whippy"
	elif "hippo" in species_lower:
		ear_scale = 0.5
		body_fat = 1.45
		tail_kind = "whippy"
	elif "mammoth" in species_lower or "elephant" in species_lower:
		ear_scale = 1.6
		body_fat = 1.25
		tail_kind = "whippy"
		tusk_size = 1.6
	elif "rhino" in species_lower:
		ear_scale = 0.8
		body_fat = 1.30
		tail_kind = "whippy"

	# ============================================================================
	# PER-INDIVIDUAL VARIATION — deterministic per render_seed, so the same
	# Pig with the same seed always looks identical, but DIFFERENT pigs look
	# different. Adds jitter to fatness, ear size, tail length, and spot count.
	# ============================================================================
	var render_seed: int = int(meta.get("render_seed", 0))
	var rng := RandomNumberGenerator.new()
	rng.seed = render_seed if render_seed != 0 else hash(species)
	body_fat *= rng.randf_range(0.85, 1.30)       # fat/skinny variation
	ear_scale *= rng.randf_range(0.55, 1.50)      # ear size variation (wider range)
	# Tail-length jitter has a WIDE range so different pigs sport very
	# different curls — from tiny stub-curl to long corkscrew.
	var tail_length_jitter: float = rng.randf_range(0.50, 2.20)
	var leg_length_jitter: float = rng.randf_range(0.65, 1.50)  # short/tall legs
	leg_length *= leg_length_jitter
	clearance = leg_length
	var spot_count: int = rng.randi_range(0, 5)   # 0-5 dark spots

	# COLOR VARIETY — real pigs come in pink, brown, black, white, ginger, and
	# spotted patterns. Override palette.primary with one of those rather than
	# always reading the FeyData/BeastData-set color (which is uniformly pink).
	# Boars / wild pigs lean dark; domestic pigs more pink/white.
	var pig_color_options := [
		Color(0.86, 0.65, 0.58),   # classic pink
		Color(0.92, 0.82, 0.74),   # pale pink-white
		Color(0.55, 0.38, 0.28),   # chocolate brown
		Color(0.32, 0.22, 0.18),   # near-black
		Color(0.78, 0.55, 0.35),   # ginger / red-brown
		Color(0.65, 0.55, 0.45),   # warm gray
		Color(0.40, 0.30, 0.22),   # dark brown
	]
	# Boars/dire-boars lean toward the dark end of the palette.
	var color_idx: int
	if "boar" in species_lower or "warthog" in species_lower or "wild" in species_lower:
		color_idx = rng.randi_range(2, 6)         # darks only
	elif "hippo" in species_lower or "rhino" in species_lower:
		color_idx = rng.randi_range(5, 6)         # grays
	elif "mammoth" in species_lower:
		color_idx = rng.randi_range(2, 4)         # brown/auburn
	else:
		color_idx = rng.randi() % pig_color_options.size()
	var primary: Color = pig_color_options[color_idx]
	var belly: Color = primary.lightened(0.20)
	# Snout color is always pinkish even on dark pigs — matches real life.
	var snout_color: Color = palette.get("accent", Color(0.98, 0.62, 0.58))
	var hoof: Color = Color(0.14, 0.10, 0.06)
	var eye_color: Color = palette.get("eye", Color(0.08, 0.05, 0.03))
	var nose_dark: Color = Color(0.42, 0.20, 0.20)
	var tusk_color := Color(0.95, 0.90, 0.78)

	# ----- BODY: 5 sections, widest in the middle (barrel). body_fat scales
	# the widths so a hippo (body_fat=1.45) looks visibly chunkier than a pig.
	var body_y: float = clearance + h * 0.55
	var sections: Array = [
		# Rear hip
		{"center": Vector3(0, body_y - h * 0.02, -d * 0.35), "w": w * 0.42 * body_fat, "h": h * 0.48 * body_fat},
		# Belly bulge — widest
		{"center": Vector3(0, body_y, -d * 0.10),            "w": w * 0.55 * body_fat, "h": h * 0.58 * body_fat},
		{"center": Vector3(0, body_y, d * 0.10),             "w": w * 0.55 * body_fat, "h": h * 0.58 * body_fat},
		# Shoulder
		{"center": Vector3(0, body_y + h * 0.02, d * 0.22),  "w": w * 0.48 * body_fat, "h": h * 0.52 * body_fat},
		# Neck stub — narrows toward head (also scales so the seam matches)
		{"center": Vector3(0, body_y + h * 0.05, d * 0.30),  "w": w * 0.34 * body_fat, "h": h * 0.36 * body_fat},
	]
	var rings: Array = _swept_body(root, sections, 8, primary, belly, 0.88, true)

	# ----- HEAD: chunky wedge clearly in FRONT of the body. -----
	# The head is positioned so head_back.z > body's last cap, meaning the head
	# silhouette protrudes forward and is visible as a distinct shape.
	#
	# Anchor everything in absolute Z, NOT relative to neck_end, so we control
	# exactly where the head starts (just past body section[4] = d*0.30).
	var neck_end: Vector3 = sections[4]["center"]
	# CRITICAL: head_back_z must OVERLAP the last body section's z so the head
	# mesh visually fuses with the body, not float in front of it. Body's last
	# section center is at d*0.30 (neck stub). We start the head INSIDE that
	# region (d*0.26) so the front rings of the body and the back rings of the
	# head intersect — the silhouette reads as one continuous pig.
	var head_back_z: float  = d * 0.26
	var head_mid_z: float   = d * 0.42
	var head_front_z: float = d * 0.56                      # front of cranium (before snout)
	# Match the back of the head's WIDTH and HEIGHT to the body neck-stub
	# section (w*0.34, h*0.36) so the cross-section is continuous at the seam.
	var head_back  := Vector3(0, neck_end.y, head_back_z)
	var head_mid   := Vector3(0, neck_end.y - h * 0.04, head_mid_z)
	var head_front := Vector3(0, neck_end.y - h * 0.08, head_front_z)
	var head_sections: Array = [
		{"center": head_back,  "w": w * 0.34, "h": h * 0.36},   # matches neck-stub
		{"center": head_mid,   "w": w * 0.42, "h": h * 0.40},   # widest at cheekbones
		{"center": head_front, "w": w * 0.34, "h": h * 0.30},
	]
	_swept_body(root, head_sections, 8, primary, belly, 0.88, false)

	# ----- SNOUT DISK: large bright-pink flat disk EXACTLY matching the head
	# front cross-section (so it doesn't read as a small ring with the head
	# wrapping around it — user feedback "nose is floating with the head
	# wrapped around it"). Disk's back ring matches head_front's oval
	# (w*0.34 × h*0.30) and merges flush; front ring is slightly smaller
	# circular for the iconic pink snout tip.
	# FLAT pig snout — disk depth is tiny (1.5% of body depth, was 6%) so it
	# reads as a flat sticker, not a 3D bulb. Front face is also WIDER than
	# tall (oval) for the iconic flat-pig-snout look.
	var disk_back: Vector3  = Vector3(0, head_front.y, head_front_z - d * 0.005)
	var disk_front: Vector3 = Vector3(0, head_front.y, head_front_z + d * 0.015)
	var disk_back_w: float = w * 0.34
	var disk_back_h: float = h * 0.30
	var disk_front_w: float = w * 0.32             # nearly as wide as back
	var disk_front_h: float = w * 0.20             # flatter (wider than tall)
	var disk_sections: Array = [
		{"center": disk_back,  "w": disk_back_w,  "h": disk_back_h},
		{"center": disk_front, "w": disk_front_w, "h": disk_front_h},
	]
	_swept_body(root, disk_sections, 12, snout_color, Color(0,0,0,0), 0.70, true)

	# Two ROUND FLAT NOSTRILS. _swept_body now puts a proportional cap dome
	# in front of disk_front by ~0.30 * max(disk_front_w, disk_front_h).
	# Previously the nostrils sat at disk_front.z + 0.001..0.006 which is
	# INSIDE that cap dome — totally hidden. Push them PAST the cap apex.
	var disk_cap_dist: float = max(disk_front_w, disk_front_h) * 0.30
	var nostril_z_base: float = disk_front.z + disk_cap_dist + 0.001
	var nostril_r: float = disk_front_w * 0.20
	for side in [-1, 1]:
		var nx: float = side * disk_front_w * 0.42
		var ny: float = disk_front.y - disk_front_h * 0.20
		_build_box(
			root,
			Vector3(nx - nostril_r, ny - nostril_r * 0.8, nostril_z_base),
			Vector3(nx + nostril_r, ny + nostril_r * 0.8, nostril_z_base + 0.005),
			nose_dark, 0.50
		)

	# ----- EYES: dark beads protruding OUT past the head surface so they're
	# visible against the pink/brown body. Previously the eye boxes sat at
	# x = ±w*0.32 with their outer face at ±w*0.35 — INSIDE the head's
	# outer surface (head_mid is w*0.42 wide), so the head occluded them.
	# Now the eye SURFACE sits at x = ±(w*0.42 + 0.01), past the head skin.
	for side in [-1, 1]:
		var head_surface_x: float = w * 0.42      # head_mid section's outer surface
		var ex: float = side * (head_surface_x + w * 0.025)   # OUTSIDE the head
		var ey: float = head_back.y + h * 0.06
		var ez: float = head_mid_z
		# Slim slab eye — wider in Y/Z (the face plane) than X (depth into head).
		_build_box(
			root,
			Vector3(ex - w * 0.025, ey - h * 0.05, ez - d * 0.025),
			Vector3(ex + w * 0.015, ey + h * 0.05, ez + d * 0.035),
			eye_color, 0.20
		)

	# ----- EARS: per-EAR independent jitter so individuals can have a crooked
	# ear, mismatched sizes, drooping ear, etc. Without this both ears were
	# always perfectly symmetric — every pig looked the same in that respect.
	for side in [-1, 1]:
		var this_ear_scale: float = ear_scale * rng.randf_range(0.65, 1.40)
		var droop: float = rng.randf_range(-h * 0.20, h * 0.10)  # negative = droopy ear
		var lean_x: float = rng.randf_range(-0.10, 0.20) * w     # outward/inward lean
		var lean_z: float = rng.randf_range(-d * 0.05, d * 0.05) # forward/backward
		var ear_w: float = w * 0.14 * this_ear_scale
		var ear_h: float = h * 0.25 * this_ear_scale
		var ear_base: Vector3  = Vector3(side * (w * 0.28 + ear_w * 0.30), head_back.y + h * 0.20, head_back_z + d * 0.04)
		var ear_tip: Vector3   = Vector3(side * (w * 0.28 + ear_w + lean_x), head_back.y + h * 0.20 + ear_h + droop, head_back_z + d * 0.02 + lean_z)
		var ear_inner: Vector3 = Vector3(side * w * 0.12, head_back.y + h * 0.30, head_back_z + d * 0.04)
		var st_ear := SurfaceTool.new()
		st_ear.begin(Mesh.PRIMITIVE_TRIANGLES)
		_add_tri(st_ear, ear_inner, ear_tip, ear_base)
		_add_tri(st_ear, ear_base, ear_tip, ear_inner)   # backface
		st_ear.generate_normals()
		var mi_ear := MeshInstance3D.new()
		mi_ear.mesh = st_ear.commit()
		var mat_ear := StandardMaterial3D.new()
		mat_ear.albedo_color = primary.darkened(0.10)
		mat_ear.roughness = 0.85
		mat_ear.cull_mode = BaseMaterial3D.CULL_DISABLED
		mi_ear.material_override = mat_ear
		root.add_child(mi_ear)

	# ----- TAIL: shape depends on species via tail_kind variable. -----
	# "curly" — iconic pig spiral (1.5 turns)
	# "whippy" — long straight whip-like tail (cow / hippo / elephant)
	# "stub"   — tiny stub poking out (boar)
	var rump_z: float = -d * 0.32                                # inside rear ring
	if tail_kind == "curly":
		var prev: Vector3 = Vector3(0, body_y + h * 0.18, rump_z)
		var prev_r: float = w * 0.045
		# tail_length_jitter affects how far back the spiral extends and how
		# many segments — short little nub vs long curly corkscrew.
		var spiral_radius_xy: float = w * 0.08
		var spiral_back_z: float = w * 0.16 * tail_length_jitter
		var n_seg: int = int(round(10.0 * tail_length_jitter))
		n_seg = clamp(n_seg, 6, 14)
		var spiral_center := Vector3(0, body_y + h * 0.22, rump_z - w * 0.10)
		for i in range(n_seg):
			var t: float = float(i + 1) / float(n_seg)
			var ang: float = t * TAU * 1.5 * tail_length_jitter
			var px: float = cos(ang) * spiral_radius_xy
			var py: float = spiral_center.y + sin(ang) * spiral_radius_xy
			var pz: float = spiral_center.z - t * spiral_back_z
			var p: Vector3 = Vector3(px, py, pz)
			var r: float = prev_r * 0.82
			_build_tapered_segment(root, prev, prev_r, p, r, primary, 0.85)
			prev = p
			prev_r = r
	elif tail_kind == "whippy":
		# Long straight tail drooping back and down — cow / elephant style.
		# Length scales with tail_length_jitter so individuals vary.
		var tail_len_d: float = d * 0.42 * tail_length_jitter
		var tail_base := Vector3(0, body_y + h * 0.10, rump_z)
		var tail_mid  := Vector3(0, body_y - h * 0.15, rump_z - tail_len_d * 0.50)
		var tail_tip  := Vector3(0, clearance + h * 0.05, rump_z - tail_len_d)
		_build_tapered_segment(root, tail_base, w * 0.05, tail_mid, w * 0.035, primary.darkened(0.10), 0.85)
		_build_tapered_segment(root, tail_mid, w * 0.035, tail_tip, w * 0.012, primary.darkened(0.10), 0.85)
		# Small tuft of darker color at the tip
		_build_tapered_segment(root, tail_tip, w * 0.04, tail_tip + Vector3(0, -h * 0.10, -d * 0.04),
			w * 0.005, Color(0.20, 0.15, 0.10), 0.95)
	else:    # "stub"
		var stub_base := Vector3(0, body_y + h * 0.20, rump_z)
		var stub_tip  := Vector3(0, body_y + h * 0.25, rump_z - w * 0.10 * tail_length_jitter)
		_build_tapered_segment(root, stub_base, w * 0.05, stub_tip, w * 0.02, primary.darkened(0.10), 0.85)

	# ----- LEGS: 4 short stubby with cloven-hoof feet. No knee bend (too short). -----
	var leg_r: float = w * 0.10
	var leg_pairs: Array = [
		{"x": -w * 0.28, "z": d * 0.30},   # front-left
		{"x":  w * 0.28, "z": d * 0.30},   # front-right
		{"x": -w * 0.28, "z": -d * 0.30},  # back-left
		{"x":  w * 0.28, "z": -d * 0.30},  # back-right
	]
	for leg in leg_pairs:
		var hip_pos := Vector3(leg["x"], body_y - h * 0.20, leg["z"])
		var ankle    := Vector3(leg["x"], h * 0.06, leg["z"])
		# Thigh + shin in one tapered segment (legs too short for visible knee)
		_build_tapered_segment(root, hip_pos, leg_r, ankle, leg_r * 0.85, primary.darkened(0.10), 0.85)
		# Cloven hoof — two small black boxes
		for hside in [-1, 1]:
			_build_box(
				root,
				Vector3(leg["x"] + hside * w * 0.035 - w * 0.045, 0.0, leg["z"] - w * 0.08),
				Vector3(leg["x"] + hside * w * 0.035 + w * 0.045, h * 0.08, leg["z"] + w * 0.10),
				hoof, 0.45
			)

	# ----- SPOTS — 0-4 dark patches on the body, placed at deterministic
	# positions from the per-individual RNG. Each spot is a tiny dark box
	# floating just outside the body surface on either left or right side.
	# Sized relative to body width so they read as visible markings.
	if spot_count > 0:
		var spot_color: Color = primary.darkened(0.30)
		for _i in range(spot_count):
			var sz: float = rng.randf_range(-d * 0.30, d * 0.20)            # along body length
			var s_side: float = 1.0 if rng.randf() > 0.5 else -1.0          # left or right flank
			var sy: float = body_y + rng.randf_range(-h * 0.15, h * 0.25)   # body sides
			var sx: float = s_side * w * 0.55 * body_fat
			var spot_r: float = w * rng.randf_range(0.06, 0.11)
			_build_box(
				root,
				Vector3(sx - 0.005, sy - spot_r, sz - spot_r),
				Vector3(sx + 0.005, sy + spot_r, sz + spot_r),
				spot_color, 0.90
			)

	# ----- TUSKS — gated by tusk_size (0 = none, 1.0 = boar, 1.4 = dire,
	# 1.6 = mammoth/elephant). Built as a 2-segment curved horn that emerges
	# from below the snout disk, curves UP and FORWARD past the snout, like
	# a real boar tusk. Previous version was too thin (w*0.008 tip) and too
	# short to be visible at typical preview zoom — now scaled to be obvious.
	if tusk_size > 0.01:
		var tusk_len: float = w * 0.50 * tusk_size
		var tusk_base_r: float = w * 0.08 * tusk_size
		var tusk_mid_r: float = w * 0.05 * tusk_size
		var tusk_tip_r: float = w * 0.018 * tusk_size
		# Anchor tusks to the new disk_front_w / disk_front_h (the snout's
		# front-face oval). disk_r no longer exists since the disk now has
		# separate width/height matched to the head cross-section.
		for side in [-1, 1]:
			# Tusk emerges from the LOWER JAW line, just below the snout disk.
			var tusk_root := Vector3(
				side * disk_front_w * 0.40,
				disk_front.y - disk_front_h * 0.55,
				disk_front.z - disk_front_w * 0.10
			)
			# Mid-curve point — outward and forward, slightly up.
			var tusk_mid := Vector3(
				side * (disk_front_w * 0.55 + tusk_len * 0.25),
				disk_front.y - disk_front_h * 0.15,
				disk_front.z + tusk_len * 0.30
			)
			# Tip — curving up past the snout, pointing forward.
			var tusk_tip := Vector3(
				side * (disk_front_w * 0.60 + tusk_len * 0.20),
				disk_front.y + disk_front_h * 0.45,
				disk_front.z + tusk_len * 0.55
			)
			_build_tapered_segment(root, tusk_root, tusk_base_r, tusk_mid, tusk_mid_r,
				tusk_color, 0.40)
			_build_tapered_segment(root, tusk_mid, tusk_mid_r, tusk_tip, tusk_tip_r,
				tusk_color, 0.40)

# ============================================================================
# PIXIE (tiny_fey) — tiny winged sprite humanoid
# ============================================================================
##
## Key traits:
##   TINY OVERALL (handled by size_class scale upstream + small base dims)
##   SLENDER HUMAN-PROPORTIONED TORSO
##   LARGE INSECT/FAIRY WINGS (two pairs — translucent)
##   POINTED EARS
##   TWO ANTENNAE on head (delicate, curving)
##   GLOWING DUST AURA via emission on accents
##   Bare feet (no boots)

static func _build_pixie(plan: Dictionary, root: Node3D) -> void:
	var base: Dictionary = plan.get("base", {})
	var palette: Dictionary = plan.get("palette", {})

	# Pixie dims (small humanoid). h is total figure height including legs.
	# depth isn't used — pixie is upright and slim, the silhouette is driven by
	# width and height only. Sub-template-aware scaling happens upstream.
	var w: float = _axis(base, "width", 0.32)
	var h: float = _axis(base, "height", 0.80)
	# Pixies float. With size_class scale (Tiny ≈ 0.45×) AND Pixie's own
	# base.scale = 0.35 in FeyData, every coordinate gets multiplied by ~0.16
	# before rendering. The OrbitPreviewContainer's camera pivot is fixed at
	# Y=0.7, so we need the pre-scale hover to be large enough that pixie
	# CENTER lands near Y=0.7 after that combined shrink. Empirically:
	#   want pixie_center_y_world ≈ 0.7
	#   pixie_center_y_local ≈ hover + h * 0.5
	#   scale_combined ≈ 0.16
	#   → hover ≈ 0.7 / 0.16 - h * 0.5 ≈ 4.4 - 0.4 ≈ 4.0
	# So hover at ~5×h gives a comfortable margin for orbit.
	var hover: float = h * 5.0

	# Color variety — Pixie's body_plan_modifiers in FeyData hardcodes
	# palette.primary to pale-pink, so every pixie comes out the same color.
	# Use render_seed to randomize a pastel hue, overriding the palette
	# primary so different individuals look distinct (green, lavender, peach,
	# mint, blue, etc.).
	var pixie_meta: Dictionary = plan.get("meta", {})
	var pixie_seed: int = int(pixie_meta.get("render_seed", 0))
	var pixie_rng := RandomNumberGenerator.new()
	pixie_rng.seed = pixie_seed if pixie_seed != 0 else hash(pixie_meta.get("species", "Pixie"))
	var skin_hue: float = pixie_rng.randf()           # full color wheel
	var skin: Color = Color.from_hsv(skin_hue, 0.30, 0.95)   # pastel saturated
	# Wings get a translucent variant of the same hue family for harmony.
	var wing: Color = palette.get("wing", Color.from_hsv(skin_hue, 0.15, 1.0))
	# Eye color contrasts with skin — pick the complementary hue.
	var eye_color: Color = palette.get("eye", Color.from_hsv(fposmod(skin_hue + 0.5, 1.0), 0.85, 0.60))
	# Keep these palette slots in scope so they don't trigger unused warnings.
	var _hair: Color = palette.get("secondary", skin.darkened(0.30))
	var _dress: Color = palette.get("accent", Color.from_hsv(fposmod(skin_hue + 0.3, 1.0), 0.6, 0.85))
	var _dust: Color = palette.get("dust", Color(1.0, 0.92, 0.55))

	# Radical simplification — the previous version had body + skirt + bodice
	# + hair + locks + ears + 4 wings + mouth + antennae bobble + dust flecks,
	# and the user called it "terrifying in 3D." Kept now: continuous tear-drop
	# body+head, two simple wings, two dark eye dots, dangling arms+legs.
	# Everything else is gone.

	var feet_y: float = hover                     # tiny feet hang here
	var hip_y: float = feet_y + h * 0.20           # very short legs
	var body_top_y: float = feet_y + h * 0.90      # head crown
	var head_y: float = feet_y + h * 0.72          # widest head section
	var chest_y: float = feet_y + h * 0.45         # wing attachment

	# ============================================================================
	# BODY+HEAD — one continuous tear-drop swept mesh (Rune Vision style).
	# Smooth, no separated head bump or narrow-neck stalk that read as a totem
	# pole. 5 sections only, monotonically tapering except for the head bulge
	# at the top.
	# ============================================================================
	var body_sections: Array = [
		{"center": Vector3(0, hip_y,       0), "w": w * 0.20, "h": w * 0.18},  # hip — bottom of egg
		{"center": Vector3(0, chest_y,     0), "w": w * 0.24, "h": w * 0.20},  # chest — widest body
		{"center": Vector3(0, head_y - w * 0.10, 0), "w": w * 0.18, "h": w * 0.18},  # neck transition
		{"center": Vector3(0, head_y,      0), "w": w * 0.26, "h": w * 0.28},  # head — widest head
		{"center": Vector3(0, body_top_y,  0), "w": w * 0.16, "h": w * 0.14},  # crown — tapers up
	]
	_swept_body(root, body_sections, 8, skin, Color(0, 0, 0, 0), 0.80, true)

	# ============================================================================
	# EYES — TRULY FLAT decals on the face. The cube-shaped eye was reading
	# as a 3D bead protruding from the head. We bury it into the head so only
	# the FRONT face is visible — total Z depth = 0.001 (essentially a sticker).
	# ============================================================================
	var face_z: float = w * 0.27        # head front face is at ~head_section.w
	var eye_y: float = head_y + w * 0.04
	for side in [-1, 1]:
		var ex: float = side * w * 0.08
		_build_box(
			root,
			Vector3(ex - w * 0.045, eye_y - w * 0.035, face_z),
			Vector3(ex + w * 0.045, eye_y + w * 0.035, face_z + 0.001),
			eye_color, 0.30
		)

	# ============================================================================
	# WINGS — variety via per-individual wing_kind. Each kind picks a different
	# pair count and shape, then each wing is built with 3D thickness (TWO
	# layered triangles + side quads = a slim wedge, not a paper-flat plane).
	# ============================================================================
	var wing_kinds := ["dragonfly", "butterfly", "moth", "single"]
	var wing_kind: String = wing_kinds[pixie_rng.randi() % wing_kinds.size()]
	# wing_thickness controls how 3D the wings read — proportional to body so
	# tiny pixies still get visible wing-edge bulk.
	var wing_thickness: float = w * 0.025

	# Build a SPEC for each wing kind: a list of (origin, tip, mid, hem) tuples
	# anchored at chest_y. Different kinds make different silhouettes.
	var wing_specs: Array = []
	for side in [-1, 1]:
		match wing_kind:
			"dragonfly":
				# Four thin elongated wings, 2 per side. Front large + back smaller.
				wing_specs.append({
					"o": Vector3(side * w * 0.10, chest_y + h * 0.05, -w * 0.06),
					"t": Vector3(side * w * 1.65, chest_y + h * 0.20, -w * 0.18),
					"m": Vector3(side * w * 1.20, chest_y + h * 0.35, -w * 0.16),
					"hm": Vector3(side * w * 0.50, chest_y + h * 0.05, -w * 0.18),
				})
				wing_specs.append({
					"o": Vector3(side * w * 0.08, chest_y + h * 0.02, -w * 0.20),
					"t": Vector3(side * w * 1.35, chest_y + h * 0.08, -w * 0.35),
					"m": Vector3(side * w * 0.95, chest_y + h * 0.18, -w * 0.32),
					"hm": Vector3(side * w * 0.40, chest_y + h * 0.05, -w * 0.32),
				})
			"butterfly":
				# Two GIANT rounded wings per pair, very wide. ONE per side.
				wing_specs.append({
					"o": Vector3(side * w * 0.12, chest_y + h * 0.05, -w * 0.10),
					"t": Vector3(side * w * 1.90, chest_y + h * 0.55, -w * 0.25),
					"m": Vector3(side * w * 1.45, chest_y + h * 0.75, -w * 0.22),
					"hm": Vector3(side * w * 1.00, chest_y + h * 0.00, -w * 0.30),
				})
			"moth":
				# Four wings but ROUND, similar-sized pairs (fuzzy moth feel).
				wing_specs.append({
					"o": Vector3(side * w * 0.10, chest_y + h * 0.05, -w * 0.06),
					"t": Vector3(side * w * 1.30, chest_y + h * 0.35, -w * 0.18),
					"m": Vector3(side * w * 1.10, chest_y + h * 0.55, -w * 0.16),
					"hm": Vector3(side * w * 0.50, chest_y + h * 0.10, -w * 0.18),
				})
				wing_specs.append({
					"o": Vector3(side * w * 0.08, chest_y + h * 0.02, -w * 0.22),
					"t": Vector3(side * w * 1.15, chest_y + h * 0.12, -w * 0.32),
					"m": Vector3(side * w * 0.95, chest_y + h * 0.25, -w * 0.28),
					"hm": Vector3(side * w * 0.42, chest_y + h * 0.05, -w * 0.32),
				})
			"single":
				# Single medium pair, simpler shape.
				wing_specs.append({
					"o": Vector3(side * w * 0.10, chest_y + h * 0.10, -w * 0.08),
					"t": Vector3(side * w * 1.30, chest_y + h * 0.30, -w * 0.22),
					"m": Vector3(side * w * 0.95, chest_y + h * 0.45, -w * 0.20),
					"hm": Vector3(side * w * 0.45, chest_y + h * 0.10, -w * 0.22),
				})

	# Render each wing as a slim 3D wedge — front face + back face offset by
	# `wing_thickness` along the wing's perpendicular, with quads around the
	# edges. No more paper-flat triangles.
	for spec in wing_specs:
		var o: Vector3 = spec["o"]
		var t: Vector3 = spec["t"]
		var m: Vector3 = spec["m"]
		var hm: Vector3 = spec["hm"]
		# Perpendicular to the wing's plane — used for the thickness offset.
		var perp: Vector3 = (t - o).cross(hm - o).normalized() * wing_thickness
		var o_f: Vector3 = o + perp
		var t_f: Vector3 = t + perp
		var m_f: Vector3 = m + perp
		var hm_f: Vector3 = hm + perp
		var o_b: Vector3 = o - perp
		var t_b: Vector3 = t - perp
		var m_b: Vector3 = m - perp
		var hm_b: Vector3 = hm - perp
		var st_w := SurfaceTool.new()
		st_w.begin(Mesh.PRIMITIVE_TRIANGLES)
		# Front face (2 tris)
		_add_tri(st_w, o_f, m_f, t_f)
		_add_tri(st_w, o_f, t_f, hm_f)
		# Back face (reversed winding)
		_add_tri(st_w, o_b, t_b, m_b)
		_add_tri(st_w, o_b, hm_b, t_b)
		# Edge quads connecting front and back perimeters
		_add_quad(st_w, o_f, m_f, m_b, o_b)
		_add_quad(st_w, m_f, t_f, t_b, m_b)
		_add_quad(st_w, t_f, hm_f, hm_b, t_b)
		_add_quad(st_w, hm_f, o_f, o_b, hm_b)
		st_w.generate_normals()
		var mi_w := MeshInstance3D.new()
		mi_w.mesh = st_w.commit()
		var mat_w := StandardMaterial3D.new()
		mat_w.albedo_color = wing
		mat_w.albedo_color.a = 0.72                  # less transparent — reads as solid
		mat_w.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
		mat_w.metallic = 0.35
		mat_w.roughness = 0.20
		mat_w.cull_mode = BaseMaterial3D.CULL_DISABLED
		mi_w.material_override = mat_w
		root.add_child(mi_w)

	# ============================================================================
	# ARMS + LEGS — very small, just so the pixie has visible limbs
	# ============================================================================
	for side in [-1, 1]:
		# Arm — single segment, slightly bent at the elbow
		var sh    := Vector3(side * w * 0.22, chest_y + h * 0.05, 0)
		var elbow := Vector3(side * w * 0.28, hip_y + h * 0.06, w * 0.04)
		var wrist := Vector3(side * w * 0.20, hip_y - h * 0.02, w * 0.06)
		_build_tapered_segment(root, sh, w * 0.045, elbow, w * 0.038, skin, 0.85)
		_build_tapered_segment(root, elbow, w * 0.038, wrist, w * 0.032, skin, 0.85)
		# Leg — single tapered segment to a small foot
		var hip_x: float = side * w * 0.06
		var hip_pos := Vector3(hip_x, hip_y, 0)
		var foot := Vector3(hip_x, feet_y, w * 0.04)
		_build_tapered_segment(root, hip_pos, w * 0.050, foot, w * 0.038, skin, 0.85)

	# Silence unused-var warnings — palette slots are read at the TOP of this
	# function under names prefixed with _ (e.g. _hair, _dress, _dust). Nothing
	# more to do here.
	pass

# ============================================================================
# SMALL ANIMAL (small_animal / small_quadruped)
# Covers Cat / Rat / Weasel / Squirrel / Hedgehog / Skunk / Mole / Ferret /
# Stoat / Mongoose / Vole / Lemur / Badger / etc. — tiny quadrupeds.
# ============================================================================
##
## Per-species variation built via plan.meta.species. The base mesh is a
## small sleek quadruped; species traits adjust:
##   body_long      — 1.0 (cat) → 1.6 (weasel/stoat — long thin tube)
##   body_round     — 1.0 (cat) → 1.6 (hedgehog — short round ball)
##   ear_kind       — "pointed" (cat) / "round" (rat/mole) / "tufted" (squirrel)
##   tail_kind      — "long_thin" (rat) / "long_sleek" (cat) / "bushy" (squirrel/skunk)
##                  / "stub" (hedgehog/mole) / "ringed" (lemur)
##   has_spikes     — Hedgehog → small dark spines on back
##   has_stripe     — Skunk → white stripe down back

static func _build_small_animal(plan: Dictionary, root: Node3D) -> void:
	var base: Dictionary = plan.get("base", {})
	var palette: Dictionary = plan.get("palette", {})
	var limbs: Dictionary = plan.get("limbs", {})
	var meta: Dictionary = plan.get("meta", {})
	var species: String = String(meta.get("species", "Cat"))

	# Base dims — small. The body is short and low compared to a wolf.
	var w: float = _axis(base, "width", 0.35)
	var h: float = _axis(base, "height", 0.22)
	var d: float = _axis(base, "depth", 0.70)
	var leg_length: float = float(limbs.get("leg_length", 0.18))
	var clearance: float = leg_length

	# Per-individual RNG (deterministic via render_seed).
	var render_seed: int = int(meta.get("render_seed", 0))
	var rng := RandomNumberGenerator.new()
	rng.seed = render_seed if render_seed != 0 else hash(species)

	# Per-species traits.
	var species_lower: String = species.to_lower()
	var body_long: float = 1.0
	var body_round: float = 1.0
	var ear_kind: String = "pointed"
	var tail_kind: String = "long_sleek"
	var has_spikes: bool = false
	var has_stripe: bool = false
	var fur_options := [
		Color(0.45, 0.40, 0.35),   # neutral gray-brown
		Color(0.85, 0.78, 0.65),   # tan/cream
		Color(0.20, 0.18, 0.16),   # near-black
		Color(0.55, 0.42, 0.28),   # brown
		Color(0.92, 0.88, 0.82),   # white
		Color(0.62, 0.55, 0.45),   # warm gray
		Color(0.70, 0.45, 0.25),   # ginger
	]
	if "weasel" in species_lower or "stoat" in species_lower or "ferret" in species_lower or "mongoose" in species_lower:
		body_long = 1.5
		ear_kind = "round"
		tail_kind = "long_thin"
	elif "rat" in species_lower or "vole" in species_lower:
		body_long = 1.2
		ear_kind = "round"
		tail_kind = "long_thin"
	elif "hedgehog" in species_lower:
		body_long = 0.85
		body_round = 1.50
		ear_kind = "round"
		tail_kind = "stub"
		has_spikes = true
	elif "mole" in species_lower:
		body_long = 0.9
		body_round = 1.40
		ear_kind = "round"
		tail_kind = "stub"
	elif "squirrel" in species_lower:
		body_long = 0.85
		ear_kind = "tufted"
		tail_kind = "bushy"
	elif "skunk" in species_lower:
		body_long = 1.0
		ear_kind = "round"
		tail_kind = "bushy"
		has_stripe = true
	elif "badger" in species_lower:
		body_long = 1.1
		body_round = 1.20
		ear_kind = "round"
		tail_kind = "stub"
		has_stripe = true
	elif "lemur" in species_lower:
		body_long = 0.95
		ear_kind = "round"
		tail_kind = "ringed"
	elif "cat" in species_lower or "kitten" in species_lower:
		body_long = 1.0
		ear_kind = "pointed"
		tail_kind = "long_sleek"

	# Per-individual jitter — overall size, leg height, ear scale per ear.
	var body_size_jitter: float = rng.randf_range(0.85, 1.20)
	body_long *= rng.randf_range(0.9, 1.10)
	body_round *= rng.randf_range(0.92, 1.10)
	var leg_jitter: float = rng.randf_range(0.75, 1.30)
	w *= body_size_jitter
	h *= body_size_jitter
	d *= body_size_jitter
	leg_length *= leg_jitter
	clearance = leg_length

	# Palette — pick from curated fur options, with species bias.
	var color_idx: int
	if "white" in species_lower or "arctic" in species_lower or "albino" in species_lower:
		color_idx = 4
	elif "black" in species_lower:
		color_idx = 2
	elif "ginger" in species_lower or "orange" in species_lower:
		color_idx = 6
	else:
		color_idx = rng.randi() % fur_options.size()
	var primary: Color = palette.get("primary", fur_options[color_idx])
	var belly: Color = primary.lightened(0.25)
	var dark: Color = primary.darkened(0.30)
	var nose_color := Color(0.20, 0.15, 0.13)
	var eye_color: Color = palette.get("eye", Color(0.30, 0.60, 0.45))

	# ----- BODY: 5 ring sections along Z, scaled by body_long + body_round.
	var body_y: float = clearance + h * 0.45
	var body_length: float = d * body_long
	# Ring radius profile — slight widen at chest + hip, taper at rear.
	var ring_zs := [-body_length * 0.42, -body_length * 0.20, 0.0, body_length * 0.20, body_length * 0.42]
	var ring_ws := [0.30, 0.42, 0.45, 0.42, 0.30]
	var ring_hs := [0.30, 0.42, 0.45, 0.40, 0.30]
	var body_sections: Array = []
	for i in range(5):
		body_sections.append({
			"center": Vector3(0, body_y, ring_zs[i]),
			"w": w * ring_ws[i] * body_round,
			"h": h * ring_hs[i] * body_round,
		})
	_swept_body(root, body_sections, 8, primary, belly, 0.85, true)

	# ----- HEAD: short wedge in front of the body, ending at a small muzzle.
	var head_back_z: float = body_length * 0.40              # overlaps last body section
	var head_front_z: float = body_length * 0.62
	var head_back  := Vector3(0, body_y + h * 0.05, head_back_z)
	var head_mid   := Vector3(0, body_y + h * 0.05, body_length * 0.50)
	var head_front := Vector3(0, body_y, head_front_z)
	var head_sections: Array = [
		{"center": head_back,  "w": w * 0.30 * body_round, "h": h * 0.32 * body_round},
		{"center": head_mid,   "w": w * 0.32 * body_round, "h": h * 0.34 * body_round},
		{"center": head_front, "w": w * 0.18, "h": h * 0.20},   # narrow muzzle tip
	]
	_swept_body(root, head_sections, 8, primary, belly, 0.85, false)

	# Nose at muzzle tip — small dark wet bump.
	_build_box(
		root,
		Vector3(-w * 0.06, head_front.y - h * 0.05, head_front_z + 0.005),
		Vector3(w * 0.06, head_front.y + h * 0.05, head_front_z + 0.030),
		nose_color, 0.30
	)

	# ----- EYES: ON the head surface (not inside it). Small forward-facing
	# beads slightly above and outward of the muzzle root.
	var eye_outer_x: float = w * 0.32 * body_round
	for side in [-1, 1]:
		_build_box(
			root,
			Vector3(side * eye_outer_x - w * 0.005, head_back.y + h * 0.08, head_back_z + d * 0.05),
			Vector3(side * eye_outer_x + w * 0.040, head_back.y + h * 0.18, head_back_z + d * 0.10),
			eye_color, 0.20
		)
		# Tiny pupil dot
		_build_box(
			root,
			Vector3(side * eye_outer_x + w * 0.010, head_back.y + h * 0.10, head_back_z + d * 0.09),
			Vector3(side * eye_outer_x + w * 0.025, head_back.y + h * 0.16, head_back_z + d * 0.11),
			Color(0.05, 0.04, 0.03), 0.30
		)

	# ----- EARS: shape varies by ear_kind, per-ear jitter for asymmetry.
	for side in [-1, 1]:
		var this_ear_scale: float = rng.randf_range(0.85, 1.20)
		var ear_lean_x: float = rng.randf_range(-0.05, 0.10) * w
		var ear_droop: float = rng.randf_range(-h * 0.05, h * 0.02)
		var ear_base_pos := Vector3(side * w * 0.22, head_back.y + h * 0.35, head_back_z + d * 0.02)
		if ear_kind == "pointed":
			# Sharp triangular cat-style ears
			var ear_tip := Vector3(side * (w * 0.32 + ear_lean_x), head_back.y + h * (0.65 + ear_droop) * this_ear_scale, head_back_z + d * 0.02)
			var ear_inner := Vector3(side * w * 0.12, head_back.y + h * 0.40, head_back_z + d * 0.04)
			_emit_ear_tri(root, ear_base_pos, ear_tip, ear_inner, primary.darkened(0.10))
		elif ear_kind == "tufted":
			# Squirrel — pointed ear with tuft of fur extending past tip
			var ear_tip := Vector3(side * (w * 0.34 + ear_lean_x), head_back.y + h * (0.55 + ear_droop) * this_ear_scale, head_back_z + d * 0.00)
			var ear_inner := Vector3(side * w * 0.10, head_back.y + h * 0.38, head_back_z + d * 0.03)
			_emit_ear_tri(root, ear_base_pos, ear_tip, ear_inner, primary.darkened(0.10))
			# Tuft hairs above tip
			for tuft_i in range(3):
				var tuft_offset: float = (float(tuft_i) - 1.0) * w * 0.02
				_build_tapered_segment(root,
					ear_tip + Vector3(tuft_offset, 0, 0),
					w * 0.012, ear_tip + Vector3(tuft_offset, h * 0.12, 0), w * 0.003,
					primary.darkened(0.05), 0.95)
		else:    # "round"
			# Rat/mole-style — small round flap of skin
			var ear_tip := Vector3(side * (w * 0.30 + ear_lean_x), head_back.y + h * (0.45 + ear_droop) * this_ear_scale, head_back_z + d * 0.02)
			var ear_inner := Vector3(side * w * 0.16, head_back.y + h * 0.38, head_back_z + d * 0.04)
			_emit_ear_tri(root, ear_base_pos, ear_tip, ear_inner, primary.darkened(0.10))

	# ----- TAIL: branches on tail_kind.
	var tail_root := Vector3(0, body_y + h * 0.05, -body_length * 0.46)
	if tail_kind == "long_sleek":    # cat
		var tail_mid := Vector3(0, body_y + h * 0.30, -body_length * 0.75)
		var tail_tip := Vector3(0, body_y + h * 0.15, -body_length * 1.05)
		_build_tapered_segment(root, tail_root, w * 0.08, tail_mid, w * 0.05, primary, 0.85)
		_build_tapered_segment(root, tail_mid, w * 0.05, tail_tip, w * 0.02, primary, 0.85)
	elif tail_kind == "long_thin":   # rat
		var tail_mid := Vector3(0, body_y - h * 0.05, -body_length * 0.85)
		var tail_tip := Vector3(0, body_y - h * 0.10, -body_length * 1.20)
		_build_tapered_segment(root, tail_root, w * 0.05, tail_mid, w * 0.03, primary.lightened(0.10), 0.60)
		_build_tapered_segment(root, tail_mid, w * 0.03, tail_tip, w * 0.012, primary.lightened(0.10), 0.60)
	elif tail_kind == "bushy":       # squirrel / skunk
		# Big fluffy tail held UP behind the body
		var tail_mid := Vector3(0, body_y + h * 0.50, -body_length * 0.55)
		var tail_tip := Vector3(0, body_y + h * 0.90, -body_length * 0.50)
		_build_tapered_segment(root, tail_root, w * 0.16, tail_mid, w * 0.22, primary, 0.95)
		_build_tapered_segment(root, tail_mid, w * 0.22, tail_tip, w * 0.18, primary, 0.95)
		# White stripe through bushy tail (skunk)
		if has_stripe:
			var stripe_base := Vector3(0.0, body_y + h * 0.45, -body_length * 0.50)
			var stripe_tip  := Vector3(0.0, body_y + h * 0.85, -body_length * 0.46)
			_build_tapered_segment(root, stripe_base, w * 0.08, stripe_tip, w * 0.06,
				Color(0.95, 0.92, 0.85), 0.95)
	elif tail_kind == "ringed":      # lemur
		var n_rings: int = 5
		var prev := tail_root
		for i in range(n_rings):
			var t: float = float(i + 1) / float(n_rings)
			var p := Vector3(0, body_y + sin(t * PI * 0.5) * h * 0.30, -body_length * (0.46 + t * 0.65))
			var ring_color: Color = Color(0.95, 0.90, 0.80) if i % 2 == 1 else primary.darkened(0.30)
			_build_tapered_segment(root, prev, w * 0.06, p, w * 0.05, ring_color, 0.85)
			prev = p
	else:    # "stub"
		var tail_tip := Vector3(0, body_y + h * 0.02, -body_length * 0.55)
		_build_tapered_segment(root, tail_root, w * 0.06, tail_tip, w * 0.025, primary, 0.85)

	# ----- LEGS: 4 thin tapered segments, short.
	var leg_r: float = w * 0.06
	var leg_pairs: Array = [
		{"x": -w * 0.22, "z": body_length * 0.28},   # front-left
		{"x":  w * 0.22, "z": body_length * 0.28},
		{"x": -w * 0.22, "z": -body_length * 0.30},  # back
		{"x":  w * 0.22, "z": -body_length * 0.30},
	]
	for leg in leg_pairs:
		var hip_pos := Vector3(leg["x"], body_y - h * 0.20, leg["z"])
		var foot := Vector3(leg["x"], 0.0, leg["z"] + w * 0.04)
		_build_tapered_segment(root, hip_pos, leg_r, foot, leg_r * 0.80, primary.darkened(0.05), 0.85)
		# Tiny paw box
		_build_box(
			root,
			Vector3(leg["x"] - w * 0.05, 0.0, leg["z"] - w * 0.05),
			Vector3(leg["x"] + w * 0.05, h * 0.06, leg["z"] + w * 0.10),
			dark, 0.85
		)

	# ----- HEDGEHOG SPIKES: small dark cones on the back when applicable.
	if has_spikes:
		var spike_color := Color(0.20, 0.15, 0.10)
		for spike_i in range(16):
			var sz: float = rng.randf_range(-body_length * 0.30, body_length * 0.35)
			var s_ang: float = rng.randf_range(-PI * 0.5, PI * 0.5)   # top hemisphere only
			var sr: float = w * 0.40 * body_round
			var sx: float = cos(s_ang) * sr
			var sy: float = body_y + sin(s_ang) * h * 0.45 * body_round
			var spike_base := Vector3(sx, sy, sz)
			var spike_tip := Vector3(sx * 1.2, sy + h * 0.12, sz)
			_build_tapered_segment(root, spike_base, w * 0.015, spike_tip, w * 0.002, spike_color, 0.85)

	# ----- BACK STRIPE: white stripe down the spine (skunk / badger).
	if has_stripe:
		var stripe_color := Color(0.95, 0.92, 0.85)
		for stripe_i in range(5):
			var t: float = float(stripe_i) / 4.0
			var sz: float = lerpf(-body_length * 0.40, body_length * 0.40, t)
			var ring_idx: int = clamp(int(round(t * 4.0)), 0, 4)
			var sy: float = body_y + h * ring_hs[ring_idx] * body_round - 0.005
			_build_box(root,
				Vector3(-w * 0.06, sy, sz - w * 0.06),
				Vector3(w * 0.06, sy + 0.005, sz + w * 0.06),
				stripe_color, 0.85
			)

# Helper for small_animal ears — flat triangle with a backface so it's
# visible from either side.
static func _emit_ear_tri(root: Node3D, base: Vector3, tip: Vector3, inner: Vector3, color: Color) -> void:
	var st_ear := SurfaceTool.new()
	st_ear.begin(Mesh.PRIMITIVE_TRIANGLES)
	_add_tri(st_ear, inner, tip, base)
	_add_tri(st_ear, base, tip, inner)   # backface
	st_ear.generate_normals()
	var mi := MeshInstance3D.new()
	mi.mesh = st_ear.commit()
	var mat := StandardMaterial3D.new()
	mat.albedo_color = color
	mat.roughness = 0.85
	mat.cull_mode = BaseMaterial3D.CULL_DISABLED
	mi.material_override = mat
	root.add_child(mi)

# ============================================================================
# CROCODILE / MONITOR LIZARD (lizard_like)
# Low to the ground, long flat-snout head with many teeth, ridged back,
# splayed reptile legs, long horizontal tail with vertical ridges.
# ============================================================================

static func _build_crocodile(plan: Dictionary, root: Node3D) -> void:
	var base: Dictionary = plan.get("base", {})
	var palette: Dictionary = plan.get("palette", {})
	var limbs: Dictionary = plan.get("limbs", {})
	var meta: Dictionary = plan.get("meta", {})
	var species: String = String(meta.get("species", "Crocodile"))

	var w: float = _axis(base, "width", 0.55)
	var h: float = _axis(base, "height", 0.28)
	var d: float = _axis(base, "depth", 1.50)
	var leg_length: float = float(limbs.get("leg_length", 0.18))
	var clearance: float = leg_length

	var render_seed: int = int(meta.get("render_seed", 0))
	var rng := RandomNumberGenerator.new()
	rng.seed = render_seed if render_seed != 0 else hash(species)

	var species_lower: String = species.to_lower()
	var jaw_length_factor: float = 1.0
	var ridge_count: int = 8
	var leg_splay: float = 1.15            # how far legs splay outward
	if "monitor" in species_lower:
		jaw_length_factor = 0.85
		ridge_count = 5
		leg_splay = 1.10
	elif "komodo" in species_lower:
		jaw_length_factor = 0.90
		ridge_count = 7
		leg_splay = 1.20
	elif "gecko" in species_lower or "iguana" in species_lower:
		jaw_length_factor = 0.75
		ridge_count = 4
	elif "giant" in species_lower or "dire" in species_lower:
		jaw_length_factor = 1.10
		ridge_count = 10
		leg_splay = 1.25

	# Per-individual jitter
	var body_size_jitter: float = rng.randf_range(0.85, 1.25)
	jaw_length_factor *= rng.randf_range(0.92, 1.12)
	w *= body_size_jitter
	h *= body_size_jitter
	d *= body_size_jitter

	# Scale color palette
	var scale_options := [
		Color(0.30, 0.42, 0.25),   # swamp green
		Color(0.40, 0.35, 0.22),   # mud brown
		Color(0.25, 0.30, 0.20),   # dark olive
		Color(0.55, 0.50, 0.32),   # tan
		Color(0.20, 0.22, 0.18),   # near-black
	]
	var primary: Color = palette.get("primary", scale_options[rng.randi() % scale_options.size()])
	var belly: Color = palette.get("secondary", Color(0.78, 0.72, 0.55))
	var dark: Color = primary.darkened(0.30)
	var tooth_color := Color(0.92, 0.88, 0.72)
	var eye_color: Color = palette.get("eye", Color(0.85, 0.70, 0.15))

	# ----- BODY: 5 sections, low and long. Cross-section is WIDER than TALL
	# (croc body is flat). The shape stays mostly the same Y throughout.
	var body_y: float = clearance + h * 0.40
	var body_sections: Array = [
		{"center": Vector3(0, body_y, -d * 0.45), "w": w * 0.32, "h": h * 0.42},  # rear hip
		{"center": Vector3(0, body_y, -d * 0.20), "w": w * 0.46, "h": h * 0.58},  # back
		{"center": Vector3(0, body_y, 0.0),       "w": w * 0.48, "h": h * 0.62},  # widest mid
		{"center": Vector3(0, body_y, d * 0.18),  "w": w * 0.44, "h": h * 0.55},  # shoulder
		{"center": Vector3(0, body_y - h * 0.05, d * 0.32), "w": w * 0.34, "h": h * 0.40},  # neck base
	]
	var _body_rings: Array = _swept_body(root, body_sections, 8, primary, belly, 0.65, true)

	# ----- HEAD: LONG FLAT JAW. Extends well past the body, narrower at the snout tip.
	var jaw_len: float = d * 0.45 * jaw_length_factor
	var head_back_z: float = d * 0.28
	var head_mid_z: float = head_back_z + jaw_len * 0.45
	var head_front_z: float = head_back_z + jaw_len
	var head_back  := Vector3(0, body_y - h * 0.05, head_back_z)
	var head_mid   := Vector3(0, body_y - h * 0.08, head_mid_z)
	var head_front := Vector3(0, body_y - h * 0.10, head_front_z)
	var head_sections: Array = [
		{"center": head_back,  "w": w * 0.32, "h": h * 0.40},  # matches neck base
		{"center": head_mid,   "w": w * 0.28, "h": h * 0.30},  # narrows
		{"center": head_front, "w": w * 0.14, "h": h * 0.16},  # snout tip
	]
	_swept_body(root, head_sections, 8, primary, belly, 0.65, true)

	# ----- TEETH: tooth row visible along the jaw on BOTH sides. 8-12 teeth.
	var tooth_count: int = rng.randi_range(8, 12)
	var tooth_y: float = body_y - h * 0.18
	for ti in range(tooth_count):
		var t: float = float(ti) / float(tooth_count - 1)
		var tz: float = lerpf(head_back_z + jaw_len * 0.05, head_front_z - jaw_len * 0.05, t)
		var tw_local: float = lerpf(w * 0.28, w * 0.13, t)
		for side_t in [-1, 1]:
			var tx: float = side_t * tw_local
			var tooth_w: float = w * lerpf(0.022, 0.030, t) * rng.randf_range(0.85, 1.20)
			# Top teeth (point down) and bottom teeth (point up) — interleaved for visible row.
			_build_box(
				root,
				Vector3(tx - tooth_w * 0.5, tooth_y - h * 0.05, tz - tooth_w * 0.5),
				Vector3(tx + tooth_w * 0.5, tooth_y + h * 0.04, tz + tooth_w * 0.5),
				tooth_color, 0.40
			)

	# ----- EYES: high on the head (croc eyes peek above the waterline). Yellow
	# slit-pupils, sit ON the dorsal side of the head.
	var eye_y: float = body_y + h * 0.10
	var eye_z: float = head_back_z + jaw_len * 0.15
	for side in [-1, 1]:
		_build_box(
			root,
			Vector3(side * w * 0.20, eye_y, eye_z - 0.02),
			Vector3(side * w * 0.28, eye_y + h * 0.10, eye_z + 0.02),
			eye_color, 0.25
		)
		# Vertical slit pupil
		_build_box(
			root,
			Vector3(side * w * 0.23, eye_y + h * 0.02, eye_z - 0.01),
			Vector3(side * w * 0.25, eye_y + h * 0.08, eye_z + 0.025),
			Color(0.05, 0.04, 0.03), 0.30
		)

	# ----- BACK RIDGES: row of osteoderm (scute) spikes along the spine.
	# Each ridge is a small darker triangular pyramid on top of the back.
	var ridge_color := primary.darkened(0.20)
	for ri in range(ridge_count):
		var t: float = float(ri) / float(ridge_count - 1)
		var rz: float = lerpf(-d * 0.45, d * 0.20, t)
		var ridge_y: float = body_y + h * 0.35
		var ridge_h: float = h * (0.18 + 0.10 * sin(t * PI))    # taller in mid back
		_build_box(
			root,
			Vector3(-w * 0.06, ridge_y, rz - w * 0.06),
			Vector3(w * 0.06, ridge_y + ridge_h, rz + w * 0.06),
			ridge_color, 0.65
		)

	# ----- TAIL: long, heavy, with vertical ridges. Tapers to a point.
	var tail_segs: Array = [
		{"center": Vector3(0, body_y, -d * 0.55),  "w": w * 0.26, "h": h * 0.45},
		{"center": Vector3(0, body_y, -d * 0.75),  "w": w * 0.22, "h": h * 0.50},
		{"center": Vector3(0, body_y, -d * 0.95),  "w": w * 0.18, "h": h * 0.50},
		{"center": Vector3(0, body_y - h * 0.05, -d * 1.15), "w": w * 0.12, "h": h * 0.40},
		{"center": Vector3(0, body_y - h * 0.10, -d * 1.30), "w": w * 0.04, "h": h * 0.15},
	]
	_swept_body(root, tail_segs, 8, primary, belly, 0.65, false)

	# Tail ridges — vertical fin-like ridges along the tail spine
	for ri in range(6):
		var t: float = float(ri) / 5.0
		var tz: float = lerpf(-d * 0.50, -d * 1.20, t)
		var fin_h: float = h * (0.28 + 0.15 * sin(t * PI * 0.7))
		_build_box(
			root,
			Vector3(-w * 0.03, body_y + h * 0.22, tz - w * 0.08),
			Vector3(w * 0.03, body_y + h * 0.22 + fin_h, tz + w * 0.08),
			ridge_color, 0.65
		)

	# ----- LEGS: 4 SHORT splayed legs (reptile sprawl). Each leg has 2 bends
	# (hip out, knee down, foot forward) to suggest the splayed stance.
	var leg_z_offsets := [d * 0.18, -d * 0.20]   # front, back
	for leg_z in leg_z_offsets:
		for side in [-1, 1]:
			var hip_x: float = side * w * 0.30
			var hip_pos := Vector3(hip_x, body_y - h * 0.10, leg_z)
			var knee_x: float = side * w * 0.38 * leg_splay
			var knee_y: float = clearance * 0.55
			var knee := Vector3(knee_x, knee_y, leg_z + (0.05 if leg_z > 0 else -0.05))
			var foot_x: float = side * w * 0.42 * leg_splay
			var foot_z: float = leg_z + (0.10 if leg_z > 0 else -0.10)
			var foot := Vector3(foot_x, 0.0, foot_z)
			_build_tapered_segment(root, hip_pos, w * 0.09, knee, w * 0.07, primary, 0.65)
			_build_tapered_segment(root, knee, w * 0.07, foot, w * 0.06, primary.darkened(0.10), 0.65)
			# 3 clawed toes spreading forward at the foot
			for ti in range(3):
				var toe_offset: float = (float(ti) - 1.0) * w * 0.04
				var toe_tip := Vector3(foot.x + toe_offset * 0.5, 0.0, foot.z + w * 0.10)
				_build_tapered_segment(root, foot, w * 0.025, toe_tip, w * 0.008, dark, 0.50)

# ============================================================================
# TREANT (walking tree)
# Bark-textured trunk body, gnarled root legs, branch arms, leaf canopy head.
# Per-individual variation in trunk girth, branch count, canopy size, season.
# ============================================================================

static func _build_treant(plan: Dictionary, root: Node3D) -> void:
	var base: Dictionary = plan.get("base", {})
	var palette: Dictionary = plan.get("palette", {})
	var limbs: Dictionary = plan.get("limbs", {})
	var meta: Dictionary = plan.get("meta", {})
	var species: String = String(meta.get("species", "Treant"))

	var w: float = _axis(base, "width", 0.95)
	var h: float = _axis(base, "height", 2.20)
	var d: float = _axis(base, "depth", 0.95)
	var _leg_length: float = float(limbs.get("leg_length", 0.40))

	var render_seed: int = int(meta.get("render_seed", 0))
	var rng := RandomNumberGenerator.new()
	rng.seed = render_seed if render_seed != 0 else hash(species)

	# Per-individual jitter — trunk girth, branch count, canopy size, season.
	var trunk_girth: float = rng.randf_range(0.85, 1.30)
	var branch_count_per_side: int = rng.randi_range(2, 4)
	var canopy_size: float = rng.randf_range(0.85, 1.30)
	var root_count: int = rng.randi_range(3, 5)
	# Season palette — green (summer), orange/red (autumn), bare (winter)
	var season_roll: float = rng.randf()
	var leaf_color: Color
	var has_leaves: bool = true
	if season_roll < 0.55:
		leaf_color = Color(0.20, 0.55, 0.25)        # summer green
	elif season_roll < 0.85:
		leaf_color = Color(0.85, 0.45, 0.18)        # autumn orange
	else:
		has_leaves = false                          # winter bare branches
		leaf_color = Color(0.0, 0.0, 0.0)

	var bark_options := [
		Color(0.32, 0.22, 0.14),   # dark brown
		Color(0.45, 0.30, 0.18),   # medium brown
		Color(0.55, 0.42, 0.28),   # warm tan bark
		Color(0.40, 0.36, 0.30),   # gray bark
		Color(0.28, 0.20, 0.12),   # almost black
	]
	var bark: Color = palette.get("primary", bark_options[rng.randi() % bark_options.size()])
	var bark_dark: Color = bark.darkened(0.30)
	var bark_inner: Color = palette.get("secondary", Color(0.62, 0.42, 0.22))
	var eye_color: Color = palette.get("eye", Color(0.65, 0.85, 0.30))

	# ----- TRUNK: vertical swept body with varying girth (knotty bumps).
	# Sections stacked along Y → _swept_body auto-detects vertical → X-Z rings.
	var ground_y: float = 0.0
	var trunk_top_y: float = h * 0.75
	var trunk_sections: Array = [
		{"center": Vector3(0, ground_y + h * 0.20, 0), "w": w * 0.45 * trunk_girth, "h": w * 0.45 * trunk_girth},
		{"center": Vector3(0, ground_y + h * 0.40, 0), "w": w * 0.40 * trunk_girth, "h": w * 0.40 * trunk_girth},
		{"center": Vector3(0, ground_y + h * 0.55, 0), "w": w * 0.42 * trunk_girth, "h": w * 0.42 * trunk_girth},   # knot bulge
		{"center": Vector3(0, trunk_top_y - h * 0.10, 0), "w": w * 0.38 * trunk_girth, "h": w * 0.38 * trunk_girth},
		{"center": Vector3(0, trunk_top_y, 0), "w": w * 0.32 * trunk_girth, "h": w * 0.32 * trunk_girth},
	]
	_swept_body(root, trunk_sections, 8, bark, Color(0, 0, 0, 0), 0.98, true)

	# ----- ROOT LEGS: 3-5 gnarled tapered roots splaying from the trunk base.
	# Each root goes outward and DOWN into the ground from trunk_base_y.
	for ri in range(root_count):
		var ang: float = TAU * float(ri) / float(root_count) + rng.randf_range(-0.20, 0.20)
		var root_hip := Vector3(
			cos(ang) * w * 0.30 * trunk_girth,
			ground_y + h * 0.15,
			sin(ang) * w * 0.30 * trunk_girth
		)
		var root_knee := Vector3(
			cos(ang) * w * 0.55,
			ground_y + h * 0.05,
			sin(ang) * w * 0.55
		)
		var root_tip := Vector3(
			cos(ang) * w * 0.75 * rng.randf_range(0.85, 1.20),
			ground_y,
			sin(ang) * w * 0.75 * rng.randf_range(0.85, 1.20)
		)
		_build_tapered_segment(root, root_hip, w * 0.14 * trunk_girth, root_knee, w * 0.11 * trunk_girth,
			bark_dark, 0.98)
		_build_tapered_segment(root, root_knee, w * 0.11 * trunk_girth, root_tip, w * 0.05,
			bark_dark, 0.98)

	# ----- BRANCH ARMS: 2-4 branches per side, sprouting from the upper trunk.
	# Each branch arcs outward and slightly up, with smaller twigs at the tip.
	for side in [-1, 1]:
		for bi in range(branch_count_per_side):
			var branch_t: float = float(bi) / float(max(branch_count_per_side - 1, 1))
			var branch_y_base: float = lerpf(h * 0.50, trunk_top_y - h * 0.05, branch_t)
			var branch_root := Vector3(
				side * w * 0.35 * trunk_girth,
				branch_y_base,
				rng.randf_range(-w * 0.15, w * 0.15)
			)
			var branch_lift: float = rng.randf_range(h * 0.05, h * 0.20)
			var branch_extend: float = rng.randf_range(w * 0.60, w * 0.95)
			var branch_mid := Vector3(
				side * (w * 0.55 + branch_extend * 0.5),
				branch_y_base + branch_lift * 0.6,
				rng.randf_range(-w * 0.20, w * 0.20)
			)
			var branch_tip := Vector3(
				side * (w * 0.55 + branch_extend),
				branch_y_base + branch_lift,
				rng.randf_range(-w * 0.30, w * 0.30)
			)
			_build_tapered_segment(root, branch_root, w * 0.10 * trunk_girth, branch_mid, w * 0.06,
				bark_dark, 0.98)
			_build_tapered_segment(root, branch_mid, w * 0.06, branch_tip, w * 0.025,
				bark_dark, 0.98)
			# Smaller twigs at the branch tip
			for twig_i in range(2):
				var twig_ang: float = rng.randf_range(-0.4, 0.4)
				var twig_tip := branch_tip + Vector3(
					side * cos(twig_ang) * w * 0.20,
					sin(twig_ang) * h * 0.10 + h * 0.05,
					rng.randf_range(-w * 0.12, w * 0.12)
				)
				_build_tapered_segment(root, branch_tip, w * 0.02, twig_tip, w * 0.008,
					bark_dark, 0.98)
				# Leaf cluster at twig tip (skip in winter)
				if has_leaves:
					_build_box(
						root,
						twig_tip + Vector3(-w * 0.10, -w * 0.10, -w * 0.10),
						twig_tip + Vector3(w * 0.10, w * 0.10, w * 0.10),
						leaf_color, 0.95
					)

	# ----- CANOPY: large leaf cluster on top of the trunk (skip in winter).
	if has_leaves:
		var canopy_y: float = trunk_top_y + h * 0.10
		var canopy_r: float = w * 0.50 * canopy_size
		# 4 overlapping leaf clusters for organic crown shape
		for ci in range(5):
			var c_ang: float = TAU * float(ci) / 5.0 + rng.randf_range(-0.3, 0.3)
			var c_r: float = canopy_r * rng.randf_range(0.75, 1.05)
			var c_pos := Vector3(
				cos(c_ang) * canopy_r * 0.45,
				canopy_y + rng.randf_range(-h * 0.05, h * 0.10),
				sin(c_ang) * canopy_r * 0.45
			)
			_build_box(
				root,
				c_pos - Vector3(c_r, c_r * 0.8, c_r),
				c_pos + Vector3(c_r, c_r * 0.8, c_r),
				leaf_color, 0.95
			)

	# ----- FACE on the trunk: two glowing eyes + a gnarled mouth carved
	# into the bark at chest height. Iconic treant marker.
	var face_y: float = h * 0.55
	var face_z: float = w * 0.40 * trunk_girth   # trunk's front face
	for side in [-1, 1]:
		_build_box(
			root,
			Vector3(side * w * 0.15 - w * 0.04, face_y, face_z),
			Vector3(side * w * 0.15 + w * 0.04, face_y + h * 0.06, face_z + 0.02),
			eye_color, 0.20, 0.10
		)
		# Eye socket recess (dark frame)
		_build_box(
			root,
			Vector3(side * w * 0.15 - w * 0.08, face_y - h * 0.02, face_z - 0.005),
			Vector3(side * w * 0.15 + w * 0.08, face_y + h * 0.10, face_z + 0.005),
			Color(0.08, 0.06, 0.04), 0.50
		)
	# Mouth — horizontal gnarled groove
	_build_box(
		root,
		Vector3(-w * 0.18, face_y - h * 0.10, face_z),
		Vector3(w * 0.18, face_y - h * 0.05, face_z + 0.02),
		Color(0.08, 0.06, 0.04), 0.50
	)

	# ----- KNOTS / MUSHROOMS on the trunk for character (deterministic).
	# 2-4 small circular knot bumps scattered on the trunk surface.
	var knot_count: int = rng.randi_range(2, 5)
	var knot_color := bark.darkened(0.40)
	for _ki in range(knot_count):
		var knot_y: float = ground_y + rng.randf_range(h * 0.20, h * 0.70)
		var knot_ang: float = rng.randf_range(0.0, TAU)
		var knot_r: float = w * rng.randf_range(0.04, 0.09)
		var knot_pos := Vector3(
			cos(knot_ang) * w * 0.40 * trunk_girth,
			knot_y,
			sin(knot_ang) * w * 0.40 * trunk_girth
		)
		_build_box(
			root,
			knot_pos - Vector3(knot_r, knot_r, knot_r),
			knot_pos + Vector3(knot_r, knot_r, knot_r),
			knot_color, 0.98
		)

# ============================================================================
# ABOLETH (aboleth)
# Iconic D&D aberration — a huge ancient aquatic horror.
# Anatomy reference (Monster Manual):
#   - Long EEL-like body, 20+ ft, sinuous swim shape
#   - Wide flat HEAD with 3 EYES STACKED VERTICALLY on the front face
#   - Round LAMPREY-style MAW underneath the head (no jaw — tooth ring)
#   - 4-6 long TENTACLES trailing from beneath the body
#   - Continuous DORSAL FIN running along the back spine
#   - Vertical FAN TAIL at the rear (eel-style propulsion)
#   - 4 BARBELS (whisker-tendrils) dangling near the maw
#   - SLIMY, mucous-coated skin — high metallic + low roughness material
#   - Mottled darker PATCHES across the dorsal surface (camouflage)
#   - BONY RIDGE bumps along the spine
#
# Per-individual variation: body length, tentacle count (4 / 5 / 6), patch
# count, color variant (teal / olive / deep blue / murky brown), eye glow
# color (red / amber / purple), barbel droop angle.
# ============================================================================

static func _build_aboleth(plan: Dictionary, root: Node3D) -> void:
	var base: Dictionary = plan.get("base", {})
	var palette: Dictionary = plan.get("palette", {})
	var limbs: Dictionary = plan.get("limbs", {})
	var meta: Dictionary = plan.get("meta", {})
	var species: String = String(meta.get("species", "Aboleth"))

	# Aboleth is a Huge creature — d is its LENGTH along the eel axis.
	var w: float = _axis(base, "width", 0.95)
	var h: float = _axis(base, "height", 0.60)
	var d: float = _axis(base, "depth", 3.20)
	var _leg_length: float = float(limbs.get("leg_length", 0.0))

	# Aboleths float / swim — they hover off the ground.
	var hover: float = h * 0.55
	var body_y: float = hover

	# Per-individual RNG
	var render_seed: int = int(meta.get("render_seed", 0))
	var rng := RandomNumberGenerator.new()
	rng.seed = render_seed if render_seed != 0 else hash(species)

	# Variation roll
	var body_long_jitter: float = rng.randf_range(0.88, 1.20)
	var tentacle_count: int = rng.randi_range(4, 6)
	var patch_count: int = rng.randi_range(4, 10)
	var barbel_droop: float = rng.randf_range(0.25, 0.55)   # tendril droop angle
	d *= body_long_jitter

	# Curated aboleth palette — slimy aquatic horror tones. Wide range so
	# different individuals look meaningfully different (per user feedback
	# "needs a few more colors / variations").
	var body_options := [
		Color(0.18, 0.45, 0.42),     # teal aqua
		Color(0.22, 0.32, 0.40),     # dark blue-green
		Color(0.30, 0.45, 0.32),     # olive
		Color(0.16, 0.28, 0.36),     # deep ocean blue
		Color(0.38, 0.40, 0.28),     # murky brown-green
		Color(0.12, 0.22, 0.28),     # near-black abyssal
		Color(0.45, 0.30, 0.55),     # bruised purple (mind-flayer cousin tone)
		Color(0.50, 0.18, 0.22),     # dried blood / liver red
		Color(0.28, 0.50, 0.55),     # turquoise reef
		Color(0.20, 0.20, 0.45),     # midnight indigo
		Color(0.45, 0.55, 0.20),     # toxic chartreuse
		Color(0.55, 0.45, 0.42),     # bone gray-pink
	]
	# Belly hue varies independently so different aboleths sport different
	# underbellies (orange / yellow / pale-blue / pink / cream / lavender).
	var belly_options := [
		Color(0.85, 0.55, 0.32),     # iconic orange-tan
		Color(0.92, 0.78, 0.42),     # mustard yellow
		Color(0.65, 0.78, 0.85),     # pale aquatic blue
		Color(0.95, 0.70, 0.78),     # pink salmon
		Color(0.88, 0.84, 0.70),     # cream
		Color(0.78, 0.65, 0.85),     # lavender
	]
	var eye_glow_options := [
		Color(0.95, 0.18, 0.10),     # iconic red
		Color(0.95, 0.55, 0.10),     # amber
		Color(0.75, 0.30, 0.95),     # psychic purple
		Color(0.20, 0.95, 0.85),     # cyan
		Color(0.40, 0.95, 0.20),     # toxic green
		Color(0.95, 0.85, 0.20),     # gold
		Color(0.95, 0.92, 0.95),     # ghostly white
	]
	# Pick color FROM the curated lists using the per-individual RNG rather
	# than reading palette.primary — the species data file (AberrationData.gd)
	# hardcodes palette.primary to a single deep-teal color, which made every
	# Aboleth the same color. Bypass that.
	var primary: Color = body_options[rng.randi() % body_options.size()]
	var belly: Color = belly_options[rng.randi() % belly_options.size()]
	var spine_dark: Color = primary.darkened(0.45)
	var patch_color: Color = primary.darkened(0.30)
	var slime_sheen: Color = primary.lightened(0.20)
	var eye_color: Color = eye_glow_options[rng.randi() % eye_glow_options.size()]
	var maw_color := Color(0.10, 0.06, 0.10)        # near-black throat
	var tooth_color := Color(0.92, 0.88, 0.70)
	var fin_color: Color = primary.darkened(0.15)

	# ============================================================================
	# BODY — 8-segment eel-like trunk with sinuous spine curve
	# Sections stacked along Z. Cross-sections are 12-vertex rings (higher
	# poly density than the wolf's 8 — gives the body a smoother fluid look).
	# Y curve uses sin(t) so the body undulates slightly mid-spine, suggesting
	# motion through water even when static.
	# ============================================================================
	var body_sections: Array = []
	var seg_n: int = 8
	for i in range(seg_n):
		var t: float = float(i) / float(seg_n - 1)        # 0..1, head=0, tail=1
		# Z runs from +d*0.42 (head joint) to -d*0.65 (just before fan tail)
		var sz: float = lerpf(d * 0.42, -d * 0.62, t)
		# Y undulation — gentle sine bend mid-body
		var sy: float = body_y + sin(t * PI) * h * 0.08
		# Width/height profile — wide flat eel: WIDER than TALL.
		# Profile widens at the body shoulder (t~0.2-0.3), peaks at mid (t~0.45),
		# tapers smoothly to the tail.
		var profile_w: float
		var profile_h: float
		if t < 0.15:
			# Head joint — slim to merge with the head behind
			profile_w = lerpf(0.32, 0.52, t / 0.15)
			profile_h = lerpf(0.38, 0.50, t / 0.15)
		elif t < 0.55:
			# Body middle — widest, flattest
			profile_w = lerpf(0.52, 0.62, (t - 0.15) / 0.40)
			profile_h = lerpf(0.50, 0.54, (t - 0.15) / 0.40)
		else:
			# Tail taper
			profile_w = lerpf(0.62, 0.08, (t - 0.55) / 0.45)
			profile_h = lerpf(0.54, 0.12, (t - 0.55) / 0.45)
		body_sections.append({
			"center": Vector3(0, sy, sz),
			"w": w * profile_w,
			"h": h * profile_h,
		})
	# 12-vertex rings for smoother eel curvature
	var body_rings: Array = _swept_body(root, body_sections, 12, primary, belly, 0.35, true)

	# ============================================================================
	# HEAD — wide flat wedge in FRONT of the body. Wider and slightly taller
	# than the body's front section so it reads as a distinct head, not a
	# body bulge. Three-section sweep tapering from a wide back to a narrower
	# front (where the maw is) — but ALSO bulging at the eye band where the
	# 3 stacked eyes sit.
	# ============================================================================
	var head_back_z: float = d * 0.36                    # OVERLAPS body section 0
	var head_eye_z: float = d * 0.56                     # widest at the eye band
	var head_front_z: float = d * 0.78                   # tapers toward the maw front
	var head_sections: Array = [
		{"center": Vector3(0, body_y + h * 0.05, head_back_z),
		 "w": w * 0.52, "h": h * 0.46},
		{"center": Vector3(0, body_y + h * 0.10, head_eye_z),
		 "w": w * 0.72, "h": h * 0.62},                  # widest — eye band
		{"center": Vector3(0, body_y + h * 0.05, head_front_z),
		 "w": w * 0.52, "h": h * 0.48},
	]
	_swept_body(root, head_sections, 12, primary, belly, 0.35, true)

	# ============================================================================
	# 3 STACKED EYES — the iconic Aboleth marker. Vertically aligned on the
	# FRONT face of the head, sizes decreasing top→bottom. Each eye has:
	#   - A dark recessed socket (slightly inset darker box)
	#   - A glowing iris disk (eye_color, emission)
	#   - A small dark pupil dot
	# ============================================================================
	var face_z: float = head_eye_z + w * 0.30           # head front face
	var eye_face_x: float = 0.0                          # centered horizontally
	# Y positions: top eye highest, bottom eye lowest. Centered around head Y.
	var eye_ys := [
		body_y + h * 0.42,                               # top eye
		body_y + h * 0.18,                               # middle eye
		body_y - h * 0.05,                               # bottom eye
	]
	var eye_sizes := [h * 0.16, h * 0.12, h * 0.09]      # decreasing sizes
	for ei in range(3):
		var er: float = eye_sizes[ei]
		var ey_y: float = eye_ys[ei]
		# Socket recess (dark frame around eye)
		_build_box(
			root,
			Vector3(eye_face_x - er * 1.30, ey_y - er * 1.10, face_z - 0.005),
			Vector3(eye_face_x + er * 1.30, ey_y + er * 1.10, face_z + 0.020),
			Color(0.05, 0.04, 0.06), 0.50
		)
		# Glowing iris disk
		var st_iris := SurfaceTool.new()
		st_iris.begin(Mesh.PRIMITIVE_TRIANGLES)
		# Build as 12-vertex disk via tri fan
		var iris_center := Vector3(eye_face_x, ey_y, face_z + 0.022)
		var iris_n: int = 12
		var iris_verts: Array = []
		for vi in range(iris_n):
			var iang: float = TAU * float(vi) / float(iris_n)
			iris_verts.append(Vector3(
				eye_face_x + cos(iang) * er,
				ey_y + sin(iang) * er,
				face_z + 0.018
			))
		for vi in range(iris_n):
			var vk: int = (vi + 1) % iris_n
			_add_tri(st_iris, iris_verts[vi], iris_verts[vk], iris_center)
		st_iris.generate_normals()
		var mi_iris := MeshInstance3D.new()
		mi_iris.mesh = st_iris.commit()
		var mat_iris := StandardMaterial3D.new()
		mat_iris.albedo_color = eye_color
		mat_iris.emission_enabled = true
		mat_iris.emission = eye_color
		mat_iris.emission_energy_multiplier = 1.4
		mat_iris.roughness = 0.20
		mat_iris.metallic = 0.30
		mat_iris.cull_mode = BaseMaterial3D.CULL_DISABLED
		mi_iris.material_override = mat_iris
		root.add_child(mi_iris)
		# Vertical slit pupil
		_build_box(
			root,
			Vector3(eye_face_x - er * 0.18, ey_y - er * 0.55, face_z + 0.023),
			Vector3(eye_face_x + er * 0.18, ey_y + er * 0.55, face_z + 0.028),
			Color(0.05, 0.03, 0.05), 0.30
		)

	# ============================================================================
	# LAMPREY MAW — circular mouth on the FRONT FACE of the head (below the
	# stacked eyes), opening FORWARD with the tooth ring radiating around the
	# rim like a real lamprey/aboleth illustration. Teeth point inward + slightly
	# forward (jutting OUT of the face plane, not down off the underside).
	# Ring is in the X-Y plane perpendicular to Z so the mouth faces +Z.
	# ============================================================================
	var maw_center := Vector3(0, body_y - h * 0.25, face_z)        # ON the face, below bottom eye
	var maw_r: float = w * 0.30                                     # slightly larger so it reads at a distance
	# Dark throat interior — recessed BACKWARD into the head (the mouth's
	# inside is behind the face plane, in -Z direction).
	var st_throat := SurfaceTool.new()
	st_throat.begin(Mesh.PRIMITIVE_TRIANGLES)
	var throat_n: int = 12
	var throat_verts: Array = []
	for ti in range(throat_n):
		var ang: float = TAU * float(ti) / float(throat_n)
		# Ring lies in the X-Y plane at the face Z, radius slightly inside the
		# tooth ring so the throat looks "swallowed" behind the teeth.
		throat_verts.append(Vector3(
			maw_center.x + cos(ang) * maw_r * 0.70,
			maw_center.y + sin(ang) * maw_r * 0.70,
			maw_center.z + 0.003                                    # just barely proud of the face
		))
	# Throat back point — recessed INTO the head along -Z
	var throat_back: Vector3 = maw_center + Vector3(0, 0, -maw_r * 0.55)
	for ti in range(throat_n):
		var tk: int = (ti + 1) % throat_n
		_add_tri(st_throat, throat_verts[tk], throat_verts[ti], throat_back)
	st_throat.generate_normals()
	var mi_throat := MeshInstance3D.new()
	mi_throat.mesh = st_throat.commit()
	var mat_throat := StandardMaterial3D.new()
	mat_throat.albedo_color = maw_color
	mat_throat.roughness = 0.95
	mat_throat.cull_mode = BaseMaterial3D.CULL_DISABLED
	mi_throat.material_override = mat_throat
	root.add_child(mi_throat)
	# Ring of teeth around the maw rim — each tooth is a tapered segment
	# rooted on the outer rim, tip pointing INWARD toward the throat center
	# AND slightly FORWARD (out of the face plane in +Z), making the maw read
	# as a wreath of fangs around a dark hole.
	var tooth_count: int = 14
	for ti in range(tooth_count):
		var ang: float = TAU * float(ti) / float(tooth_count)
		# Tooth root — on the outer ring, on the face plane
		var t_root := Vector3(
			maw_center.x + cos(ang) * maw_r,
			maw_center.y + sin(ang) * maw_r,
			maw_center.z + 0.005
		)
		# Tooth tip — inward (toward center) AND forward (+Z), giving the
		# wreath-of-fangs look pointing forward from the face.
		var t_tip := Vector3(
			maw_center.x + cos(ang) * maw_r * 0.40,
			maw_center.y + sin(ang) * maw_r * 0.40,
			maw_center.z + maw_r * 0.35
		)
		# Jitter tooth size for organic variation
		var tw_base: float = w * 0.040 * rng.randf_range(0.80, 1.30)
		_build_tapered_segment(root, t_root, tw_base, t_tip, tw_base * 0.15,
			tooth_color, 0.40)
	# Outer lip — a thin darker ring AROUND the maw on the face, suggests
	# the muscular seal that a real lamprey clamps with.
	for ti in range(throat_n):
		var ang: float = TAU * float(ti) / float(throat_n)
		var lip_root := Vector3(
			maw_center.x + cos(ang) * maw_r * 1.10,
			maw_center.y + sin(ang) * maw_r * 1.10,
			maw_center.z - 0.002
		)
		var lip_in := Vector3(
			maw_center.x + cos(ang) * maw_r * 1.02,
			maw_center.y + sin(ang) * maw_r * 1.02,
			maw_center.z + 0.004
		)
		_build_tapered_segment(root, lip_root, w * 0.012, lip_in, w * 0.008,
			primary.darkened(0.40), 0.50)

	# ============================================================================
	# BARBELS — 4 thin wispy tendrils drooping from BELOW the front-mounted
	# maw. Anchored on the face plane just below the maw's outer ring,
	# curving downward and slightly forward (out of the face plane in +Z).
	# ============================================================================
	var barbel_count: int = 4
	for bi in range(barbel_count):
		var bx_offset: float = (float(bi) - 1.5) * maw_r * 0.55
		var bar_root := Vector3(
			maw_center.x + bx_offset,
			maw_center.y - maw_r * 1.05,            # just below the maw rim
			maw_center.z + 0.005                    # on the face plane
		)
		var droop_y: float = h * barbel_droop * rng.randf_range(0.85, 1.20)
		var bar_mid := Vector3(
			bar_root.x + bx_offset * 0.15,
			bar_root.y - droop_y * 0.5,
			bar_root.z + w * 0.10
		)
		var bar_tip := Vector3(
			bar_root.x + bx_offset * 0.30,
			bar_root.y - droop_y,
			bar_root.z + w * 0.22
		)
		_build_tapered_segment(root, bar_root, w * 0.018, bar_mid, w * 0.012,
			primary.lightened(0.10), 0.50)
		_build_tapered_segment(root, bar_mid, w * 0.012, bar_tip, w * 0.004,
			primary.lightened(0.10), 0.50)

	# ============================================================================
	# DORSAL FIN — continuous low triangular fin running along the back from
	# behind the head to the tail base. Built as a strip of triangles along
	# the spine. Adds the signature undulating-fish-spine silhouette.
	# ============================================================================
	var fin_segs: int = 12
	var st_dorsal := SurfaceTool.new()
	st_dorsal.begin(Mesh.PRIMITIVE_TRIANGLES)
	for i in range(fin_segs):
		var t0: float = float(i) / float(fin_segs)
		var t1: float = float(i + 1) / float(fin_segs)
		# Spine path from head joint to tail base
		var z0: float = lerpf(d * 0.34, -d * 0.58, t0)
		var z1: float = lerpf(d * 0.34, -d * 0.58, t1)
		# Spine top Y — match the body's undulating sine curve
		var spine_t0: float = t0
		var spine_t1: float = t1
		var y_base0: float = body_y + sin(spine_t0 * PI) * h * 0.08 + h * 0.48
		var y_base1: float = body_y + sin(spine_t1 * PI) * h * 0.08 + h * 0.48
		# Fin height peaks in the mid-body, tapers at head/tail ends
		var fin_h0: float = h * (0.10 + 0.20 * sin(t0 * PI))
		var fin_h1: float = h * (0.10 + 0.20 * sin(t1 * PI))
		var base_l0 := Vector3(-0.005, y_base0, z0)
		var base_r0 := Vector3(0.005, y_base0, z0)
		var top0    := Vector3(0, y_base0 + fin_h0, z0)
		var base_l1 := Vector3(-0.005, y_base1, z1)
		var base_r1 := Vector3(0.005, y_base1, z1)
		var top1    := Vector3(0, y_base1 + fin_h1, z1)
		_add_tri(st_dorsal, base_l0, top0, base_l1)
		_add_tri(st_dorsal, top0, top1, base_l1)
		_add_tri(st_dorsal, base_r1, top1, top0)
		_add_tri(st_dorsal, base_r1, top0, base_r0)
	st_dorsal.generate_normals()
	var mi_dorsal := MeshInstance3D.new()
	mi_dorsal.mesh = st_dorsal.commit()
	var mat_dorsal := StandardMaterial3D.new()
	mat_dorsal.albedo_color = fin_color
	mat_dorsal.roughness = 0.30
	mat_dorsal.metallic = 0.40
	mat_dorsal.cull_mode = BaseMaterial3D.CULL_DISABLED
	mi_dorsal.material_override = mat_dorsal
	root.add_child(mi_dorsal)

	# ============================================================================
	# FAN TAIL — vertical fish tail at the rear. Two lobes (upper + lower)
	# forming a wide vertical fan, eel-style propulsion silhouette.
	# ============================================================================
	var tail_pivot := Vector3(0, body_y, -d * 0.62)
	var tail_outer_z: float = -d * 0.95
	var tail_top := Vector3(0, body_y + h * 0.85, tail_outer_z + d * 0.04)
	var tail_bot := Vector3(0, body_y - h * 0.85, tail_outer_z + d * 0.04)
	var tail_back := Vector3(0, body_y, tail_outer_z)
	var st_tail := SurfaceTool.new()
	st_tail.begin(Mesh.PRIMITIVE_TRIANGLES)
	# Upper lobe — triangle from tail base up to top
	_add_tri(st_tail, tail_pivot + Vector3(-0.005, 0, 0), tail_top, tail_back)
	_add_tri(st_tail, tail_pivot + Vector3(0.005, 0, 0), tail_back, tail_top)
	# Lower lobe
	_add_tri(st_tail, tail_pivot + Vector3(-0.005, 0, 0), tail_back, tail_bot)
	_add_tri(st_tail, tail_pivot + Vector3(0.005, 0, 0), tail_bot, tail_back)
	st_tail.generate_normals()
	var mi_tail := MeshInstance3D.new()
	mi_tail.mesh = st_tail.commit()
	var mat_tail := StandardMaterial3D.new()
	mat_tail.albedo_color = fin_color
	mat_tail.roughness = 0.30
	mat_tail.metallic = 0.40
	mat_tail.cull_mode = BaseMaterial3D.CULL_DISABLED
	mi_tail.material_override = mat_tail
	root.add_child(mi_tail)

	# Tail fin ribs — visible spline lines for poly detail
	for ri in range(5):
		var rib_t: float = float(ri + 1) / 6.0
		var rib_top := tail_pivot.lerp(tail_top, rib_t)
		var rib_bot := tail_pivot.lerp(tail_bot, rib_t)
		_build_tapered_segment(root, tail_pivot, w * 0.020, rib_top, w * 0.005,
			fin_color.darkened(0.20), 0.40)
		_build_tapered_segment(root, tail_pivot, w * 0.020, rib_bot, w * 0.005,
			fin_color.darkened(0.20), 0.40)

	# ============================================================================
	# TENTACLES — 4-6 long trailing tentacles emerging from the underside of
	# the body near the shoulder. Each has 4 segments tapering to a point,
	# arcing back and slightly down. Tentacles arranged asymmetrically with
	# different lengths / droops for organic variation.
	# ============================================================================
	for ti in range(tentacle_count):
		# Distribute tentacles along the body length on alternating sides
		var side_t: float = -1.0 if ti % 2 == 0 else 1.0
		var z_t: float = lerpf(d * 0.18, -d * 0.10, float(ti) / float(tentacle_count - 1))
		var t_root := Vector3(
			side_t * w * 0.45,
			body_y - h * 0.30,
			z_t
		)
		# Each tentacle has its own droop and trail distance
		var t_length: float = d * rng.randf_range(0.45, 0.70)
		var t_droop: float = rng.randf_range(0.40, 0.75)
		# 4-segment chain: root → mid1 → mid2 → tip
		var seg1 := Vector3(
			t_root.x + side_t * w * 0.20,
			t_root.y - h * t_droop * 0.30,
			z_t - t_length * 0.30
		)
		var seg2 := Vector3(
			t_root.x + side_t * w * 0.30,
			t_root.y - h * t_droop * 0.70,
			z_t - t_length * 0.60
		)
		var seg3 := Vector3(
			t_root.x + side_t * w * 0.25,
			t_root.y - h * t_droop,
			z_t - t_length * 0.90
		)
		var t_tip := Vector3(
			t_root.x + side_t * w * 0.15,
			t_root.y - h * t_droop * 1.20,
			z_t - t_length
		)
		_build_tapered_segment(root, t_root, w * 0.10, seg1, w * 0.085,
			primary, 0.40)
		_build_tapered_segment(root, seg1, w * 0.085, seg2, w * 0.065,
			primary, 0.40)
		_build_tapered_segment(root, seg2, w * 0.065, seg3, w * 0.045,
			primary, 0.40)
		_build_tapered_segment(root, seg3, w * 0.045, t_tip, w * 0.012,
			primary.darkened(0.15), 0.40)
		# Suckers along the underside — small darker bumps every other segment
		for sucker_i in range(3):
			var sucker_t: float = float(sucker_i + 1) / 4.0
			var sucker_pos := t_root.lerp(seg2, sucker_t)
			sucker_pos.y -= h * 0.04
			_build_box(
				root,
				sucker_pos - Vector3(w * 0.025, w * 0.015, w * 0.025),
				sucker_pos + Vector3(w * 0.025, w * 0.005, w * 0.025),
				primary.darkened(0.40), 0.50
			)

	# ============================================================================
	# DORSAL PATCHES — mottled darker spots scattered across the back.
	# Used for visual camouflage character and per-individual variety.
	# ============================================================================
	for _pi in range(patch_count):
		var patch_z: float = rng.randf_range(-d * 0.55, d * 0.30)
		var patch_side: float = 1.0 if rng.randf() > 0.5 else -1.0
		# Place on body surface — interpolate ring position for X
		var patch_t: float = (patch_z - d * 0.42) / (-d * 0.62 - d * 0.42)
		patch_t = clamp(patch_t, 0.0, 1.0)
		var ring_idx: int = clamp(int(round(patch_t * float(seg_n - 1))), 0, seg_n - 1)
		var ring_w_at: float = float(body_sections[ring_idx]["w"])
		var ring_h_at: float = float(body_sections[ring_idx]["h"])
		# Angle around the ring — pick mostly dorsal (top half)
		var p_ang: float = rng.randf_range(0.1, PI - 0.1)
		if patch_side < 0:
			p_ang = -p_ang
		var patch_x: float = cos(p_ang) * ring_w_at
		var patch_y: float = body_y + sin(patch_t * PI) * h * 0.08 + sin(p_ang) * ring_h_at
		var patch_r: float = w * rng.randf_range(0.05, 0.12)
		_build_box(
			root,
			Vector3(patch_x - patch_r, patch_y - patch_r * 0.3, patch_z - patch_r),
			Vector3(patch_x + patch_r, patch_y + patch_r * 0.3, patch_z + patch_r),
			patch_color, 0.50
		)

	# ============================================================================
	# BONY SPINE RIDGE — small darker bumps running along the dorsal centerline
	# BETWEEN the dorsal fin and the head. Suggests vertebrae beneath the skin.
	# ============================================================================
	for ri in range(10):
		var t: float = float(ri) / 9.0
		var bz: float = lerpf(d * 0.30, -d * 0.55, t)
		var by: float = body_y + sin(t * PI) * h * 0.08 + h * 0.44
		var bump_r: float = w * 0.025
		_build_box(
			root,
			Vector3(-bump_r, by, bz - bump_r),
			Vector3(bump_r, by + h * 0.05, bz + bump_r),
			spine_dark, 0.65
		)

	# Suppress unused-var warnings for color slots we keep around for caller
	# palette consistency.
	var _unused_slime := slime_sheen
	var _unused_rings := body_rings

# ============================================================================
# ABOMINABLE YETI (abominable_yeti)
# Large bipedal arctic ape — D&D Monster Manual. Anatomy:
#   - Tall ~10ft bipedal, slightly hunched gorilla-style stance
#   - Massive shaggy fur covering most of the body
#   - LONG arms reaching past the knees, ape-style
#   - Broad muscular chest, round belly
#   - Round head with prominent FANGS / TUSKS jutting from the lower jaw
#   - GLOWING ICY-BLUE EYES (signature — Cold Gaze ability)
#   - Big CLAWED hands (3 fingers) and feet
#   - Fur tufts on shoulders, elbows, knees, head crest
#   - Cold-themed icy-blue tinted color variants
#
# Per-individual variation: fur color (white / blue-white / pale-gray /
# cream / dirty-yellow / pale-blue), eye glow color, fang size, body bulk,
# extra fur tuft positions, ice crystal accents.
# ============================================================================

static func _build_abominable_yeti(plan: Dictionary, root: Node3D) -> void:
	var base: Dictionary = plan.get("base", {})
	var palette: Dictionary = plan.get("palette", {})
	var limbs: Dictionary = plan.get("limbs", {})
	var meta: Dictionary = plan.get("meta", {})
	var species: String = String(meta.get("species", "Abominable Yeti"))

	var w: float = _axis(base, "width", 1.10)
	var h: float = _axis(base, "height", 2.10)
	var d: float = _axis(base, "depth", 0.80)
	var leg_length: float = float(limbs.get("leg_length", 0.95))
	var clearance: float = leg_length

	var render_seed: int = int(meta.get("render_seed", 0))
	var rng := RandomNumberGenerator.new()
	rng.seed = render_seed if render_seed != 0 else hash(species)

	# Per-individual jitter
	var body_size_jitter: float = rng.randf_range(0.88, 1.20)
	var fang_size_jitter: float = rng.randf_range(0.75, 1.50)
	var bulk_jitter: float = rng.randf_range(0.92, 1.18)
	w *= body_size_jitter
	h *= body_size_jitter
	d *= body_size_jitter
	leg_length *= rng.randf_range(0.88, 1.10)
	clearance = leg_length

	# Curated fur palette — different yetis come in different cold colors.
	var fur_options := [
		Color(0.92, 0.93, 0.96),     # pure white
		Color(0.75, 0.83, 0.92),     # icy blue-white
		Color(0.85, 0.88, 0.90),     # pale gray
		Color(0.88, 0.85, 0.78),     # cream / dirty white
		Color(0.65, 0.75, 0.85),     # arctic blue
		Color(0.92, 0.86, 0.62),     # dirty yellow / old fur
		Color(0.55, 0.60, 0.70),     # storm-grey
		Color(0.78, 0.75, 0.92),     # frost lavender
	]
	# Eye glow — yeti's "Cold Gaze" is iconic icy blue, but variants exist
	var eye_options := [
		Color(0.40, 0.85, 1.00),     # icy cyan (iconic)
		Color(0.55, 0.95, 1.00),     # bright frost
		Color(0.20, 0.60, 0.95),     # deep blue
		Color(0.85, 0.95, 1.00),     # pale white-blue
		Color(0.65, 0.95, 0.95),     # mint
	]
	# Pick palette from RNG (NOT from palette.primary — species data hardcodes it)
	var fur: Color = fur_options[rng.randi() % fur_options.size()]
	var fur_dark: Color = fur.darkened(0.20)
	var skin: Color = Color(0.50, 0.55, 0.62)     # exposed face/palm skin
	var eye_color: Color = eye_options[rng.randi() % eye_options.size()]
	var fang_color := Color(0.95, 0.92, 0.85)
	var claw_color := Color(0.18, 0.20, 0.25)

	# ============================================================================
	# TORSO — broad barrel chest tapering to a slightly narrower waist + belly.
	# Sections stacked along Y (vertical body) so _swept_body auto-builds X-Z
	# perpendicular rings (real 3D bulk).
	# ============================================================================
	var hip_y: float = clearance
	var belly_y: float = clearance + h * 0.15
	var chest_y: float = clearance + h * 0.40
	var shoulder_y: float = clearance + h * 0.55
	var torso_sections: Array = [
		{"center": Vector3(0, hip_y,      0), "w": w * 0.42 * bulk_jitter, "h": d * 0.50 * bulk_jitter},
		{"center": Vector3(0, belly_y,    0), "w": w * 0.50 * bulk_jitter, "h": d * 0.58 * bulk_jitter},  # belly bulge
		{"center": Vector3(0, chest_y,    0), "w": w * 0.55 * bulk_jitter, "h": d * 0.55 * bulk_jitter},  # broad chest
		{"center": Vector3(0, shoulder_y, 0), "w": w * 0.58 * bulk_jitter, "h": d * 0.48 * bulk_jitter},  # widest shoulders
	]
	_swept_body(root, torso_sections, 10, fur, Color(0,0,0,0), 0.95, true)

	# Fur tufts on the shoulders — shaggy clumps
	for side in [-1, 1]:
		for clump_i in range(3):
			var cx: float = side * (w * 0.50 + rng.randf_range(-w * 0.08, w * 0.10))
			var cy: float = shoulder_y + rng.randf_range(-h * 0.06, h * 0.04)
			var cz: float = rng.randf_range(-d * 0.30, d * 0.30)
			var clump_r: float = w * rng.randf_range(0.08, 0.13)
			_build_box(
				root,
				Vector3(cx - clump_r, cy - clump_r, cz - clump_r),
				Vector3(cx + clump_r, cy + clump_r, cz + clump_r),
				fur, 0.98
			)

	# ============================================================================
	# NECK + HEAD — neck is THICK (yeti has barely any neck), head is round
	# with a heavy brow ridge and a wide jaw.
	# ============================================================================
	var neck_base: Vector3 = Vector3(0, shoulder_y, 0)
	var head_center: Vector3 = Vector3(0, shoulder_y + h * 0.18, d * 0.02)
	_build_tapered_segment(root, neck_base, w * 0.22, head_center + Vector3(0, -h * 0.05, 0),
		w * 0.20, fur, 0.95)

	# Cranium — wider than tall, slightly forward-leaning
	var cran_w: float = w * 0.36
	var cran_h: float = h * 0.20
	var cran_d: float = d * 0.85
	_build_box(
		root,
		Vector3(-cran_w, head_center.y - cran_h * 0.20, head_center.z - cran_d * 0.45),
		Vector3(cran_w, head_center.y + cran_h * 0.80, head_center.z + cran_d * 0.55),
		fur, 0.95
	)

	# Heavy brow ridge — protrudes above the eye line
	_build_box(
		root,
		Vector3(-cran_w * 1.05, head_center.y + cran_h * 0.40, head_center.z + cran_d * 0.30),
		Vector3(cran_w * 1.05, head_center.y + cran_h * 0.65, head_center.z + cran_d * 0.55),
		fur_dark, 0.98
	)

	# Top-head fur crest (mohawk-like) — small tuft sprouting from cranium top
	for crest_i in range(4):
		var crest_t: float = float(crest_i) / 3.0
		var cx: float = lerpf(-cran_w * 0.30, cran_w * 0.30, crest_t)
		var cz: float = head_center.z - cran_d * 0.10
		var crest_r: float = w * 0.07
		_build_box(
			root,
			Vector3(cx - crest_r, head_center.y + cran_h * 0.78, cz - crest_r),
			Vector3(cx + crest_r, head_center.y + cran_h * 1.10, cz + crest_r),
			fur, 0.98
		)

	# ----- FACE: exposed skin patch (not covered in fur) ------
	var face_center := Vector3(0, head_center.y + cran_h * 0.05, head_center.z + cran_d * 0.55)
	_build_box(
		root,
		Vector3(-cran_w * 0.65, face_center.y - cran_h * 0.30, face_center.z),
		Vector3(cran_w * 0.65, face_center.y + cran_h * 0.40, face_center.z + 0.020),
		skin, 0.85
	)

	# ----- EYES: glowing icy-blue (or chosen variant). Sit on face skin
	# patch, with dark socket frames. -----
	for side in [-1, 1]:
		var ex: float = side * cran_w * 0.32
		var ey: float = face_center.y + cran_h * 0.10
		# Socket recess
		_build_box(
			root,
			Vector3(ex - cran_w * 0.20, ey - cran_h * 0.10, face_center.z + 0.018),
			Vector3(ex + cran_w * 0.20, ey + cran_h * 0.20, face_center.z + 0.025),
			Color(0.08, 0.10, 0.15), 0.50
		)
		# Glowing iris
		var st_iris := SurfaceTool.new()
		st_iris.begin(Mesh.PRIMITIVE_TRIANGLES)
		var iris_n: int = 10
		var iris_r: float = cran_w * 0.15
		var iris_center := Vector3(ex, ey + cran_h * 0.04, face_center.z + 0.028)
		var iris_verts: Array = []
		for vi in range(iris_n):
			var ang: float = TAU * float(vi) / float(iris_n)
			iris_verts.append(Vector3(
				ex + cos(ang) * iris_r,
				ey + cran_h * 0.04 + sin(ang) * iris_r,
				face_center.z + 0.026
			))
		for vi in range(iris_n):
			var vk: int = (vi + 1) % iris_n
			_add_tri(st_iris, iris_verts[vi], iris_verts[vk], iris_center)
		st_iris.generate_normals()
		var mi_iris := MeshInstance3D.new()
		mi_iris.mesh = st_iris.commit()
		var mat_iris := StandardMaterial3D.new()
		mat_iris.albedo_color = eye_color
		mat_iris.emission_enabled = true
		mat_iris.emission = eye_color
		mat_iris.emission_energy_multiplier = 1.6
		mat_iris.roughness = 0.20
		mat_iris.metallic = 0.20
		mat_iris.cull_mode = BaseMaterial3D.CULL_DISABLED
		mi_iris.material_override = mat_iris
		root.add_child(mi_iris)
		# Small dark pupil
		_build_box(
			root,
			Vector3(ex - cran_w * 0.04, ey + cran_h * 0.00, face_center.z + 0.030),
			Vector3(ex + cran_w * 0.04, ey + cran_h * 0.08, face_center.z + 0.034),
			Color(0.05, 0.06, 0.08), 0.30
		)

	# ----- NOSE: small dark bump in the middle of the face -----
	_build_box(
		root,
		Vector3(-cran_w * 0.10, face_center.y - cran_h * 0.05, face_center.z + 0.022),
		Vector3(cran_w * 0.10, face_center.y + cran_h * 0.05, face_center.z + 0.040),
		Color(0.15, 0.12, 0.10), 0.50
	)

	# ----- LOWER JAW + FANGS: massive jaw hanging slightly open with 2 prominent
	# upward-curving tusks and a row of smaller fangs.
	var jaw_y: float = face_center.y - cran_h * 0.50
	_build_box(
		root,
		Vector3(-cran_w * 0.65, jaw_y - cran_h * 0.20, face_center.z - 0.025),
		Vector3(cran_w * 0.65, jaw_y + cran_h * 0.10, face_center.z + 0.020),
		skin.darkened(0.10), 0.85
	)
	# Two upward TUSKS — signature yeti detail
	for side in [-1, 1]:
		var tusk_root := Vector3(side * cran_w * 0.40, jaw_y + cran_h * 0.05, face_center.z + 0.015)
		var tusk_tip := Vector3(side * cran_w * 0.50, jaw_y + cran_h * 0.45 * fang_size_jitter,
			face_center.z + 0.022)
		_build_tapered_segment(root, tusk_root, w * 0.025 * fang_size_jitter, tusk_tip,
			w * 0.006 * fang_size_jitter, fang_color, 0.40)
	# Row of 4 smaller fangs across the jaw
	for ti in range(4):
		var tt: float = float(ti) / 3.0
		var tx: float = lerpf(-cran_w * 0.35, cran_w * 0.35, tt)
		_build_box(
			root,
			Vector3(tx - cran_w * 0.04, jaw_y - cran_h * 0.05, face_center.z + 0.005),
			Vector3(tx + cran_w * 0.04, jaw_y + cran_h * 0.10, face_center.z + 0.020),
			fang_color, 0.40
		)

	# ============================================================================
	# ARMS — LONG, hanging past the knees (gorilla ape arms). Massive shoulders.
	# Each arm: shoulder → elbow → wrist → big clawed hand.
	# ============================================================================
	for side in [-1, 1]:
		var arm_jitter: float = rng.randf_range(0.90, 1.10)
		var sh := Vector3(side * w * 0.58, shoulder_y - h * 0.02, 0)
		var elbow := Vector3(side * w * 0.70 * arm_jitter, hip_y + h * 0.30, d * 0.10)
		var wrist := Vector3(side * w * 0.62 * arm_jitter, hip_y - h * 0.15, d * 0.20)
		# Upper arm — chunky
		_build_tapered_segment(root, sh, w * 0.18 * bulk_jitter, elbow, w * 0.15 * bulk_jitter,
			fur, 0.95)
		# Forearm
		_build_tapered_segment(root, elbow, w * 0.14 * bulk_jitter, wrist,
			w * 0.13 * bulk_jitter, fur, 0.95)
		# Elbow fur tuft
		_build_box(
			root,
			Vector3(elbow.x - w * 0.10, elbow.y - w * 0.08, elbow.z - w * 0.10),
			Vector3(elbow.x + w * 0.12, elbow.y + w * 0.10, elbow.z + w * 0.10),
			fur, 0.98
		)
		# HAND — palm + 3 thick clawed fingers
		var palm_pos := Vector3(wrist.x, wrist.y - h * 0.06, wrist.z + d * 0.04)
		_build_box(
			root,
			Vector3(palm_pos.x - w * 0.15, palm_pos.y - h * 0.10, palm_pos.z - d * 0.10),
			Vector3(palm_pos.x + w * 0.15, palm_pos.y + h * 0.04, palm_pos.z + d * 0.10),
			skin.darkened(0.20), 0.88
		)
		# 3 claws extending from the palm
		for ci in range(3):
			var ct: float = float(ci) - 1.0
			var claw_root := Vector3(palm_pos.x + ct * w * 0.10, palm_pos.y - h * 0.10, palm_pos.z + d * 0.10)
			var claw_tip := Vector3(palm_pos.x + ct * w * 0.11, palm_pos.y - h * 0.16, palm_pos.z + d * 0.22)
			_build_tapered_segment(root, claw_root, w * 0.04, claw_tip, w * 0.005, claw_color, 0.40)

	# ============================================================================
	# LEGS — thick muscular, slightly bent at the knee. Big clawed feet.
	# ============================================================================
	for side in [-1, 1]:
		var leg_jitter: float = rng.randf_range(0.92, 1.10)
		var hip_x: float = side * w * 0.25
		var hip_pos := Vector3(hip_x, hip_y, 0)
		var knee := Vector3(hip_x * 1.05, clearance * 0.55, d * 0.06)
		var ankle := Vector3(hip_x, clearance * 0.12, -d * 0.02)
		var foot_center := Vector3(hip_x, 0.0, d * 0.10)
		_build_tapered_segment(root, hip_pos, w * 0.20 * bulk_jitter * leg_jitter, knee,
			w * 0.17 * bulk_jitter * leg_jitter, fur, 0.95)
		_build_tapered_segment(root, knee, w * 0.16 * bulk_jitter * leg_jitter, ankle,
			w * 0.14 * bulk_jitter * leg_jitter, fur, 0.95)
		# Knee fur tuft
		_build_box(
			root,
			Vector3(knee.x - w * 0.12, knee.y - w * 0.08, knee.z - w * 0.10),
			Vector3(knee.x + w * 0.13, knee.y + w * 0.10, knee.z + w * 0.12),
			fur, 0.98
		)
		# Foot — wide flat ape-style
		_build_box(
			root,
			Vector3(foot_center.x - w * 0.16, 0.0, foot_center.z - d * 0.18),
			Vector3(foot_center.x + w * 0.16, h * 0.06, foot_center.z + d * 0.22),
			skin.darkened(0.20), 0.88
		)
		# Toe claws — 3 per foot
		for ti in range(3):
			var tt: float = float(ti) - 1.0
			var toe_root := Vector3(foot_center.x + tt * w * 0.10, 0.005, foot_center.z + d * 0.22)
			var toe_tip := Vector3(foot_center.x + tt * w * 0.11, 0.015, foot_center.z + d * 0.30)
			_build_tapered_segment(root, toe_root, w * 0.04, toe_tip, w * 0.006, claw_color, 0.40)

	# ============================================================================
	# ICE CRYSTAL ACCENTS — small pale-blue crystalline shards growing out of
	# the fur (back, shoulders) for the "ice-touched" look. Per-individual count.
	# ============================================================================
	var ice_count: int = rng.randi_range(0, 6)
	var ice_color := Color(0.85, 0.95, 1.00)
	for _ic in range(ice_count):
		var ix: float = rng.randf_range(-w * 0.50, w * 0.50)
		var iy: float = rng.randf_range(chest_y - h * 0.10, shoulder_y + h * 0.05)
		var iz: float = rng.randf_range(-d * 0.40, -d * 0.05)
		var ice_h: float = h * rng.randf_range(0.05, 0.10)
		var ice_root := Vector3(ix, iy, iz)
		var ice_tip := Vector3(ix + rng.randf_range(-0.03, 0.03), iy + ice_h, iz + rng.randf_range(-0.02, 0.02))
		_build_tapered_segment(root, ice_root, w * 0.030, ice_tip, w * 0.004,
			ice_color, 0.20, 0.35)

# ============================================================================
# ADULT OBLEX (adult_oblex)
# A monstrous psychic ooze in its native form — an irregular dark slime body
# with multiple thin tendrils sticking up, each tendril ending in a STOLEN
# HUMANOID FACE (the Oblex copies people it has consumed). Anatomy:
#   - Amorphous main body — flat-bottomed irregular blob
#   - 3-6 thin tapered tendrils rising from the body
#   - Each tendril ends in a small face (head shape with 2 eyes + mouth)
#   - Dark inky surface with oily metallic sheen
#   - Body has 3-4 puddle-like lobes at the base
#   - Optional: ooze droplets dripping from tendril junctions
#
# Per-individual: tendril count, face features per tendril, body color
# (purple / inky black / blood red / bile green / acid yellow), oil sheen.
# ============================================================================

static func _build_adult_oblex(plan: Dictionary, root: Node3D) -> void:
	var base: Dictionary = plan.get("base", {})
	var palette: Dictionary = plan.get("palette", {})
	var limbs: Dictionary = plan.get("limbs", {})
	var meta: Dictionary = plan.get("meta", {})
	var species: String = String(meta.get("species", "Adult Oblex"))

	var w: float = _axis(base, "width", 1.15)
	var h: float = _axis(base, "height", 1.20)
	var _d: float = _axis(base, "depth", 1.10)
	var _ll: float = float(limbs.get("leg_length", 0.0))

	var render_seed: int = int(meta.get("render_seed", 0))
	var rng := RandomNumberGenerator.new()
	rng.seed = render_seed if render_seed != 0 else hash(species)

	# Per-individual jitter
	var tendril_count: int = rng.randi_range(3, 6)
	var body_size_jitter: float = rng.randf_range(0.88, 1.20)
	w *= body_size_jitter
	h *= body_size_jitter

	# Color palette — oozes come in unsettling shades
	var ooze_options := [
		Color(0.18, 0.08, 0.22),     # iconic dark purple
		Color(0.08, 0.06, 0.10),     # inky black
		Color(0.32, 0.06, 0.10),     # blood red
		Color(0.18, 0.30, 0.08),     # bile green
		Color(0.42, 0.45, 0.05),     # acid yellow
		Color(0.10, 0.18, 0.32),     # midnight blue
		Color(0.35, 0.15, 0.35),     # bruise magenta
		Color(0.22, 0.20, 0.05),     # tar
	]
	var face_skin_options := [
		Color(0.92, 0.78, 0.65),     # pale flesh
		Color(0.65, 0.45, 0.35),     # tan
		Color(0.40, 0.28, 0.20),     # dark skin
		Color(0.85, 0.62, 0.50),     # warm
		Color(0.55, 0.65, 0.55),     # sickly green-tinted (oblex-corrupted)
	]
	var ooze: Color = ooze_options[rng.randi() % ooze_options.size()]
	var ooze_dark: Color = ooze.darkened(0.40)
	var ooze_highlight: Color = ooze.lightened(0.30)
	var face_skin: Color = face_skin_options[rng.randi() % face_skin_options.size()]
	var eye_color: Color = palette.get("eye", Color(0.95, 0.95, 0.85))

	# ============================================================================
	# BODY — irregular blob built from 3-4 overlapping puddle lobes at the base
	# Each lobe is a flattened oval. Combined silhouette is irregular.
	# ============================================================================
	var body_y: float = h * 0.35
	var lobe_count: int = 4
	for li in range(lobe_count):
		var lobe_ang: float = TAU * float(li) / float(lobe_count) + rng.randf_range(-0.4, 0.4)
		var lobe_r_xy: float = w * rng.randf_range(0.45, 0.65)
		var lobe_pos := Vector3(
			cos(lobe_ang) * w * 0.18,
			rng.randf_range(h * 0.05, h * 0.30),
			sin(lobe_ang) * w * 0.18
		)
		# Each lobe as a 2-section flat dome
		var lobe_sections: Array = [
			{"center": Vector3(lobe_pos.x, 0.01, lobe_pos.z),
			 "w": lobe_r_xy * 1.10, "h": lobe_r_xy * 1.10},
			{"center": lobe_pos + Vector3(0, lobe_pos.y * 0.5, 0),
			 "w": lobe_r_xy * 1.05, "h": lobe_r_xy * 1.05},
			{"center": lobe_pos + Vector3(0, lobe_pos.y, 0),
			 "w": lobe_r_xy * 0.85, "h": lobe_r_xy * 0.85},
		]
		_swept_body(root, lobe_sections, 10, ooze, Color(0,0,0,0), 0.20, true)

	# Central main mass — taller central blob
	var main_sections: Array = [
		{"center": Vector3(0, 0.02, 0), "w": w * 0.55, "h": w * 0.55},
		{"center": Vector3(0, body_y * 0.6, 0), "w": w * 0.50, "h": w * 0.50},
		{"center": Vector3(0, body_y, 0), "w": w * 0.42, "h": w * 0.42},
		{"center": Vector3(0, body_y + h * 0.15, 0), "w": w * 0.28, "h": w * 0.28},
	]
	_swept_body(root, main_sections, 10, ooze, Color(0,0,0,0), 0.20, true)

	# ============================================================================
	# TENDRILS — 3-6 thin tapered stalks rising from the body, each topped
	# with a small humanoid face. Each tendril sways at a different angle.
	# ============================================================================
	for ti in range(tendril_count):
		var t_ang: float = TAU * float(ti) / float(tendril_count) + rng.randf_range(-0.3, 0.3)
		var t_base_r: float = w * rng.randf_range(0.18, 0.40)
		var t_base := Vector3(cos(t_ang) * t_base_r, body_y * 0.6, sin(t_ang) * t_base_r)
		# Each tendril has a unique height + lean
		var t_height: float = h * rng.randf_range(0.55, 0.95)
		var t_lean_x: float = rng.randf_range(-w * 0.15, w * 0.15)
		var t_lean_z: float = rng.randf_range(-w * 0.15, w * 0.15)
		var t_mid := Vector3(t_base.x + t_lean_x * 0.5, t_base.y + t_height * 0.45,
			t_base.z + t_lean_z * 0.5)
		var t_neck := Vector3(t_base.x + t_lean_x, t_base.y + t_height * 0.85,
			t_base.z + t_lean_z)
		_build_tapered_segment(root, t_base, w * 0.08, t_mid, w * 0.045, ooze, 0.20, 0.40)
		_build_tapered_segment(root, t_mid, w * 0.045, t_neck, w * 0.030, ooze, 0.20, 0.40)

		# ----- STOLEN FACE at top of tendril -----
		var face_y: float = t_neck.y + h * 0.06
		var face_pos := Vector3(t_neck.x, face_y, t_neck.z)
		var face_size: float = w * 0.12 * rng.randf_range(0.85, 1.15)
		# Head as a small oval (3-section sweep) — uses vertical orientation
		var head_sections: Array = [
			{"center": face_pos + Vector3(0, -face_size * 0.6, 0),
			 "w": face_size * 0.50, "h": face_size * 0.45},
			{"center": face_pos,
			 "w": face_size, "h": face_size * 0.85},
			{"center": face_pos + Vector3(0, face_size * 0.7, 0),
			 "w": face_size * 0.55, "h": face_size * 0.45},
		]
		_swept_body(root, head_sections, 8, face_skin, Color(0,0,0,0), 0.85, true)

		# Two tiny eyes on the face — look INWARD (oozing eye-effect) by being
		# closer together than normal, suggesting the face is "wrong"
		var face_face_z: float = face_size * 0.90
		for side in [-1, 1]:
			# Eye whites
			_build_box(
				root,
				Vector3(face_pos.x + side * face_size * 0.18 - face_size * 0.10,
						face_pos.y + face_size * 0.05,
						face_pos.z + face_face_z),
				Vector3(face_pos.x + side * face_size * 0.18 + face_size * 0.10,
						face_pos.y + face_size * 0.18,
						face_pos.z + face_face_z + 0.005),
				Color(0.95, 0.95, 0.85), 0.30
			)
			# Pupil (dark dot)
			_build_box(
				root,
				Vector3(face_pos.x + side * face_size * 0.18 - face_size * 0.04,
						face_pos.y + face_size * 0.08,
						face_pos.z + face_face_z + 0.005),
				Vector3(face_pos.x + side * face_size * 0.18 + face_size * 0.04,
						face_pos.y + face_size * 0.16,
						face_pos.z + face_face_z + 0.010),
				Color(0.10, 0.08, 0.10), 0.40
			)
		# Mouth — a dark line (varies per face: open/closed/screaming)
		var mouth_kind: int = rng.randi_range(0, 2)
		if mouth_kind == 0:
			# Closed line
			_build_box(
				root,
				Vector3(face_pos.x - face_size * 0.20, face_pos.y - face_size * 0.20,
						face_pos.z + face_face_z),
				Vector3(face_pos.x + face_size * 0.20, face_pos.y - face_size * 0.14,
						face_pos.z + face_face_z + 0.005),
				Color(0.30, 0.15, 0.18), 0.50
			)
		elif mouth_kind == 1:
			# Open small "o" - screaming
			_build_box(
				root,
				Vector3(face_pos.x - face_size * 0.10, face_pos.y - face_size * 0.25,
						face_pos.z + face_face_z),
				Vector3(face_pos.x + face_size * 0.10, face_pos.y - face_size * 0.10,
						face_pos.z + face_face_z + 0.008),
				Color(0.10, 0.05, 0.08), 0.30
			)
		else:
			# Drooping wide
			_build_box(
				root,
				Vector3(face_pos.x - face_size * 0.25, face_pos.y - face_size * 0.22,
						face_pos.z + face_face_z),
				Vector3(face_pos.x + face_size * 0.25, face_pos.y - face_size * 0.10,
						face_pos.z + face_face_z + 0.006),
				Color(0.20, 0.10, 0.12), 0.40
			)
		# Hair tuft on top of face — variety: bald / short / messy
		var hair_kind: int = rng.randi_range(0, 3)
		if hair_kind > 0:
			var hair_color := Color(
				rng.randf_range(0.10, 0.50),
				rng.randf_range(0.08, 0.40),
				rng.randf_range(0.06, 0.30)
			)
			var hair_r: float = face_size * lerpf(0.40, 0.85, float(hair_kind) / 3.0)
			_build_box(
				root,
				Vector3(face_pos.x - hair_r, face_pos.y + face_size * 0.55,
						face_pos.z - face_size * 0.40),
				Vector3(face_pos.x + hair_r, face_pos.y + face_size * 0.95,
						face_pos.z + face_size * 0.70),
				hair_color, 0.95
			)

		# Ooze residue around the base of each face — small dark patches where
		# the face is "growing out of" the ooze
		_build_box(
			root,
			Vector3(face_pos.x - face_size * 0.6, face_pos.y - face_size * 0.7,
					face_pos.z - face_size * 0.5),
			Vector3(face_pos.x + face_size * 0.6, face_pos.y - face_size * 0.45,
					face_pos.z + face_size * 0.5),
			ooze_dark, 0.30, 0.35
		)

	# ============================================================================
	# OOZE DRIPS — small droplets dripping from tendril junctions and the body.
	# Suggests the slime is actively oozing.
	# ============================================================================
	var drip_count: int = rng.randi_range(3, 8)
	for _di in range(drip_count):
		var drip_ang: float = rng.randf_range(0.0, TAU)
		var drip_r: float = w * rng.randf_range(0.30, 0.55)
		var drip_top := Vector3(
			cos(drip_ang) * drip_r,
			rng.randf_range(h * 0.08, h * 0.40),
			sin(drip_ang) * drip_r
		)
		var drip_bot := Vector3(drip_top.x, drip_top.y - h * rng.randf_range(0.08, 0.20),
			drip_top.z)
		_build_tapered_segment(root, drip_top, w * 0.04, drip_bot, w * 0.01,
			ooze_highlight, 0.20, 0.45)

	# Suppress unused warning
	var _unused_eye := eye_color

# ============================================================================
# AIR ELEMENTAL (air_elemental)
# A primordial spirit of wind — a swirling vertical vortex with a humanoid
# silhouette. Anatomy:
#   - Tall vertical vortex column made of 4 spiraling tubes around a central core
#   - Translucent wispy core body (cloud color)
#   - Two FLOWING ARM streamers extending sideways (wind currents)
#   - Glowing eyes set within the upper funnel
#   - LIGHTNING SPARK CROWN at the very top
#   - Funnel base narrowing slightly off the ground (just floating)
#   - Occasional dust/leaf particles caught in the spiral
#
# Per-individual: spiral arm count (3-5), core color (white/storm-grey/
# sandstorm/sky-blue/lightning-purple), arm wisp count, spark count.
# ============================================================================

static func _build_air_elemental(plan: Dictionary, root: Node3D) -> void:
	var base: Dictionary = plan.get("base", {})
	var palette: Dictionary = plan.get("palette", {})
	var meta: Dictionary = plan.get("meta", {})
	var species: String = String(meta.get("species", "Air Elemental"))

	var w: float = _axis(base, "width", 0.85)
	var h: float = _axis(base, "height", 1.80)
	var _d: float = _axis(base, "depth", 0.85)

	var render_seed: int = int(meta.get("render_seed", 0))
	var rng := RandomNumberGenerator.new()
	rng.seed = render_seed if render_seed != 0 else hash(species)

	# Per-individual variation
	var size_jitter: float = rng.randf_range(0.88, 1.20)
	var spiral_count: int = rng.randi_range(3, 5)
	var spark_count: int = rng.randi_range(5, 9)
	var arm_count: int = rng.randi_range(2, 4)
	w *= size_jitter
	h *= size_jitter

	# Color palette — different wind moods
	var wind_options := [
		Color(0.85, 0.92, 1.00),     # pale storm-white (default)
		Color(0.55, 0.62, 0.72),     # storm-grey
		Color(0.88, 0.72, 0.45),     # sandstorm dust
		Color(0.45, 0.70, 0.95),     # sky-blue
		Color(0.78, 0.65, 0.95),     # lightning-purple
		Color(0.65, 0.95, 0.90),     # ozone cyan
		Color(0.92, 0.90, 0.78),     # autumn dust
	]
	var spark_options := [
		Color(1.00, 1.00, 0.55),     # gold
		Color(0.85, 0.95, 1.00),     # white lightning
		Color(0.55, 0.70, 1.00),     # blue spark
		Color(0.95, 0.65, 1.00),     # violet
		Color(1.00, 0.85, 0.30),     # amber
	]
	var wind: Color = wind_options[rng.randi() % wind_options.size()]
	var cloud: Color = wind.darkened(0.15)
	var spark: Color = spark_options[rng.randi() % spark_options.size()]
	var eye_color: Color = palette.get("eye", spark)

	var float_y: float = h * 0.10                 # hovers slightly off ground

	# ============================================================================
	# VORTEX SPIRAL ARMS — multiple spiraling tapered tubes around a central
	# axis. Each spiral makes ~1.5 turns from base to top.
	# ============================================================================
	# TORNADO orientation: NARROW at the bottom (touching ground), WIDE at the
	# top (storm-cloud cap). Previous version was reversed → looked upside down.
	for s in range(spiral_count):
		var spiral_offset: float = TAU * float(s) / float(spiral_count)
		var radius_jitter: float = rng.randf_range(0.85, 1.15)
		var prev: Vector3 = Vector3(
			cos(spiral_offset) * w * 0.12 * radius_jitter,
			float_y,
			sin(spiral_offset) * w * 0.12 * radius_jitter
		)
		var prev_r: float = w * 0.05
		var spiral_steps: int = 10
		for i in range(spiral_steps):
			var t: float = float(i + 1) / float(spiral_steps)
			var ang: float = spiral_offset + t * TAU * 1.6
			# Funnel WIDENS upward
			var r: float = lerpf(w * 0.12, w * 0.55, t) * radius_jitter
			var y: float = float_y + t * h * 1.40
			var p := Vector3(cos(ang) * r, y, sin(ang) * r)
			var thick: float = w * lerpf(0.05, 0.13, t)
			_build_tapered_segment(root, prev, prev_r, p, thick, wind, 0.25, 0.10)
			prev = p
			prev_r = thick

	# ============================================================================
	# TRANSLUCENT CORE — the wispy "body" inside the vortex. Vertical swept
	# mesh. With auto-orientation detection, sections stacked along Y → rings
	# in X-Z plane (proper 3D).
	# ============================================================================
	# Core widens upward too — narrow trail at the bottom, billowing wide
	# storm-cloud body at the top.
	var core_sections: Array = []
	var core_steps: int = 8
	for i in range(core_steps):
		var t: float = float(i) / float(core_steps - 1)
		var y: float = float_y + t * h * 1.50
		# Profile: narrow base → wide cloud top with a slight pinch at the
		# upper-third (the "shoulders" of the storm cap).
		var r: float = lerpf(w * 0.06, w * 0.35, t)
		if t > 0.55 and t < 0.80:
			r *= 0.85                # slight pinch (shoulders / neck of funnel)
		core_sections.append({
			"center": Vector3(0, y, 0),
			"w": r, "h": r,
		})
	_swept_body(root, core_sections, 8, cloud, Color(0,0,0,0), 0.30, true)

	# Add translucency to the core (rebuild material override on its mesh
	# instance — but we don't have a handle; instead, build a SECOND translucent
	# pass at a fractionally different radius)
	# (Skipped: the high-roughness opaque core reads fine against the dark
	# preview backdrop; adding alpha can cause sorting issues with the spiral.)

	# ============================================================================
	# EYES — glowing dots inside the WIDE upper funnel cap where the "face"
	# would be (where the funnel widens out — top of the cloud).
	# ============================================================================
	var eye_y: float = float_y + h * 1.20             # upper third of the funnel
	for side in [-1, 1]:
		_build_box(
			root,
			Vector3(side * w * 0.14 - w * 0.05, eye_y, w * 0.20),
			Vector3(side * w * 0.14 + w * 0.05, eye_y + h * 0.10, w * 0.32),
			eye_color, 0.10, 0.40
		)

	# ============================================================================
	# ARMS — flowing wisp streamers reaching out from the WIDE upper cloud
	# (high on the funnel, not from the narrow middle).
	# ============================================================================
	for ai in range(arm_count):
		var side: float = 1.0 if ai % 2 == 0 else -1.0
		var arm_lift: float = rng.randf_range(0.85, 1.15)
		var prev := Vector3(side * w * 0.30, float_y + h * arm_lift, 0)
		var prev_r: float = w * 0.10
		var arm_segs: int = 4
		for i in range(arm_segs):
			var t: float = float(i + 1) / float(arm_segs)
			var p := Vector3(
				side * (w * 0.30 + sin(t * PI) * w * 0.85 * rng.randf_range(0.85, 1.10)),
				float_y + h * arm_lift + cos(t * PI * 0.5) * h * 0.10 - t * h * 0.10,
				cos(t * PI) * w * 0.30 * rng.randf_range(0.85, 1.10)
			)
			var r: float = prev_r * 0.75
			_build_tapered_segment(root, prev, prev_r, p, r, wind, 0.25, 0.10)
			prev = p
			prev_r = r

	# ============================================================================
	# LIGHTNING SPARK CROWN — emissive sparks at the top of the vortex
	# ============================================================================
	for si in range(spark_count):
		var ang: float = TAU * float(si) / float(spark_count) + rng.randf_range(-0.2, 0.2)
		var r: float = w * rng.randf_range(0.05, 0.14)
		var spark_base := Vector3(cos(ang) * r, float_y + h * 1.45, sin(ang) * r)
		var spark_tip := Vector3(
			cos(ang) * r * 2.4,
			float_y + h * (1.55 + rng.randf_range(0.05, 0.20)),
			sin(ang) * r * 2.4
		)
		_build_tapered_segment(root, spark_base, w * 0.025, spark_tip, w * 0.003,
			spark, 0.10, 0.55)
		# Branch crackles
		if rng.randf() > 0.4:
			var branch_tip := Vector3(
				spark_tip.x + rng.randf_range(-w * 0.08, w * 0.08),
				spark_tip.y + rng.randf_range(-h * 0.05, h * 0.08),
				spark_tip.z + rng.randf_range(-w * 0.08, w * 0.08)
			)
			_build_tapered_segment(root, spark_tip, w * 0.008, branch_tip, w * 0.002,
				spark, 0.10, 0.55)

	# ============================================================================
	# DUST PARTICLES — small caught debris in the vortex (per-individual count)
	# ============================================================================
	var dust_count: int = rng.randi_range(4, 12)
	var dust_color: Color = wind.darkened(0.20)
	for _di in range(dust_count):
		var d_ang: float = rng.randf_range(0.0, TAU)
		var d_t: float = rng.randf_range(0.10, 0.95)
		var d_r: float = lerpf(w * 0.40, w * 0.10, d_t) * rng.randf_range(0.85, 1.20)
		var d_pos := Vector3(
			cos(d_ang) * d_r,
			float_y + d_t * h * 1.40,
			sin(d_ang) * d_r
		)
		var d_size: float = w * rng.randf_range(0.012, 0.025)
		_build_box(
			root,
			d_pos - Vector3(d_size, d_size, d_size),
			d_pos + Vector3(d_size, d_size, d_size),
			dust_color, 0.80
		)

# ============================================================================
# AIR ELEMENTAL MYRMIDON (air_elemental_myrmidon)
# An armored elemental warrior — Mordenkainen's Tome of Foes. A humanoid
# wind elemental bound INSIDE polished plate armor with a longsword and
# wind streaming visibly from the joints / helm.
#   - Knight silhouette (heavy chest plate, pauldrons, helmet, greaves)
#   - Wind WISPS leaking from helmet visor, shoulder gaps, gauntlet edges
#   - Visible vortex CORE inside the chest cavity (glow + tube)
#   - Longsword in one hand (slim blade with crackling lightning trim)
#   - Round / kite shield on the other arm
#   - Helmet with horizontal visor slit + glowing wind-eyes
#   - Lightning crackle accents along the armor seams
#
# Per-individual: armor metal (silver / bronze / gold / dark steel /
# tarnished iron), wind color, sword glow, shield kind (round / kite / tower).
# ============================================================================

static func _build_air_myrmidon(plan: Dictionary, root: Node3D) -> void:
	var base: Dictionary = plan.get("base", {})
	var palette: Dictionary = plan.get("palette", {})
	var limbs: Dictionary = plan.get("limbs", {})
	var meta: Dictionary = plan.get("meta", {})
	var species: String = String(meta.get("species", "Air Elemental Myrmidon"))

	var w: float = _axis(base, "width", 0.65)
	var h: float = _axis(base, "height", 1.55)
	var d: float = _axis(base, "depth", 0.45)
	var leg_length: float = float(limbs.get("leg_length", 0.72))
	var clearance: float = leg_length

	var render_seed: int = int(meta.get("render_seed", 0))
	var rng := RandomNumberGenerator.new()
	rng.seed = render_seed if render_seed != 0 else hash(species)

	# Per-individual variation
	var size_jitter: float = rng.randf_range(0.90, 1.15)
	w *= size_jitter
	h *= size_jitter

	var armor_options := [
		Color(0.72, 0.78, 0.85),     # polished silver steel
		Color(0.65, 0.50, 0.32),     # bronze
		Color(0.85, 0.72, 0.30),     # gold
		Color(0.30, 0.32, 0.38),     # dark steel
		Color(0.55, 0.50, 0.45),     # tarnished iron
		Color(0.85, 0.85, 0.92),     # white pearl
	]
	var wind_options := [
		Color(0.85, 0.92, 1.00),
		Color(0.65, 0.85, 1.00),
		Color(0.78, 0.75, 0.95),
		Color(0.95, 0.95, 0.85),     # pale gold wind
		Color(0.65, 0.95, 0.95),
	]
	var glow_options := [
		Color(0.40, 0.85, 1.00),
		Color(0.95, 0.85, 0.30),
		Color(0.75, 0.55, 1.00),
		Color(0.55, 1.00, 0.85),
	]
	var armor: Color = armor_options[rng.randi() % armor_options.size()]
	var armor_dark: Color = armor.darkened(0.30)
	var armor_trim: Color = armor.lightened(0.15)
	var wind: Color = wind_options[rng.randi() % wind_options.size()]
	var glow: Color = glow_options[rng.randi() % glow_options.size()]
	var _eye_palette: Color = palette.get("eye", glow)   # unused but kept

	# Shield kind
	var shield_kinds := ["round", "kite", "tower"]
	var shield_kind: String = shield_kinds[rng.randi() % shield_kinds.size()]

	# ============================================================================
	# WIND CORE — visible vortex glowing inside the armor (chest cavity)
	# ============================================================================
	var hip_y: float = clearance + h * 0.05
	var chest_y: float = clearance + h * 0.45
	var shoulder_y: float = clearance + h * 0.65
	var core_sections: Array = []
	for i in range(6):
		var t: float = float(i) / 5.0
		var y: float = hip_y + t * (shoulder_y - hip_y + h * 0.05)
		var r: float = lerpf(w * 0.08, w * 0.18, t)
		core_sections.append({
			"center": Vector3(0, y, 0), "w": r, "h": r,
		})
	_swept_body(root, core_sections, 8, wind, Color(0,0,0,0), 0.20, true)

	# ============================================================================
	# ARMOR PLATES — chest piece + abdomen + pauldrons + belt + greaves
	# Each plate is a box positioned around the wind core.
	# ============================================================================
	# CHEST PLATE — broad, slightly V-shaped (narrower at the waist)
	_build_box(
		root,
		Vector3(-w * 0.42, chest_y - h * 0.10, -d * 0.40),
		Vector3(w * 0.42, chest_y + h * 0.20, d * 0.40),
		armor, 0.30, 0.65
	)
	# Abdomen plate — narrower
	_build_box(
		root,
		Vector3(-w * 0.32, hip_y + h * 0.10, -d * 0.35),
		Vector3(w * 0.32, chest_y - h * 0.08, d * 0.35),
		armor_dark, 0.30, 0.55
	)
	# Hip belt — gold/bright trim band
	_build_box(
		root,
		Vector3(-w * 0.36, hip_y, -d * 0.42),
		Vector3(w * 0.36, hip_y + h * 0.10, d * 0.42),
		armor_trim, 0.20, 0.70
	)
	# PAULDRONS (rounded shoulder caps)
	for side in [-1, 1]:
		_build_box(
			root,
			Vector3(side * w * 0.38, shoulder_y - h * 0.05, -d * 0.30),
			Vector3(side * w * 0.58, shoulder_y + h * 0.15, d * 0.30),
			armor, 0.30, 0.65
		)
		# Spike crest on top of pauldron
		_build_box(
			root,
			Vector3(side * w * 0.46, shoulder_y + h * 0.12, -d * 0.05),
			Vector3(side * w * 0.52, shoulder_y + h * 0.30, d * 0.05),
			armor_trim, 0.25, 0.65
		)

	# ============================================================================
	# HELMET — closed visor knight helm with a horizontal slit + glowing eyes
	# ============================================================================
	var head_anchor := Vector3(0, shoulder_y + h * 0.18, 0)
	# Neck-gap (visible wind streaming out between helmet and chest)
	_build_tapered_segment(root, Vector3(0, shoulder_y + h * 0.02, 0), w * 0.12,
		head_anchor + Vector3(0, -h * 0.05, 0), w * 0.18, wind, 0.20)
	# Helmet body
	var hw: float = w * 0.27
	var hh: float = h * 0.20
	var hd: float = d * 0.60
	_build_box(
		root,
		Vector3(-hw, head_anchor.y - hh * 0.10, -hd * 0.45),
		Vector3(hw, head_anchor.y + hh * 0.95, hd * 0.55),
		armor, 0.30, 0.65
	)
	# Crest mohawk along the top
	_build_box(
		root,
		Vector3(-hw * 0.10, head_anchor.y + hh * 0.85, -hd * 0.30),
		Vector3(hw * 0.10, head_anchor.y + hh * 1.20, hd * 0.40),
		armor_trim, 0.25
	)
	# Visor slit — dark band across the face
	_build_box(
		root,
		Vector3(-hw * 0.92, head_anchor.y + hh * 0.30, hd * 0.50),
		Vector3(hw * 0.92, hh * 0.42 + head_anchor.y, hd * 0.58),
		Color(0.04, 0.04, 0.05), 0.20
	)
	# Glowing eye slits inside the visor
	for side in [-1, 1]:
		_build_box(
			root,
			Vector3(side * hw * 0.40 - hw * 0.15, head_anchor.y + hh * 0.32, hd * 0.54),
			Vector3(side * hw * 0.40 + hw * 0.15, head_anchor.y + hh * 0.40, hd * 0.60),
			glow, 0.10, 0.40
		)
	# Wind STREAMING from the top of the helmet (long banners of cloud)
	for wisp_i in range(3):
		var wt: float = float(wisp_i) / 2.0 - 0.5
		var wisp_root := Vector3(wt * hw * 0.6, head_anchor.y + hh * 1.15, 0)
		var wisp_mid := Vector3(wt * hw * 0.4, head_anchor.y + hh * 1.45, -hd * 0.30)
		var wisp_tip := Vector3(wt * hw * 0.2, head_anchor.y + hh * 1.30, -hd * 0.80)
		_build_tapered_segment(root, wisp_root, w * 0.025, wisp_mid, w * 0.018,
			wind, 0.20, 0.10)
		_build_tapered_segment(root, wisp_mid, w * 0.018, wisp_tip, w * 0.005,
			wind, 0.20, 0.10)

	# ============================================================================
	# ARMS — right arm holds longsword, left arm holds shield. Wind wisps
	# leak at every joint.
	# ============================================================================
	# RIGHT ARM (sword side, side = +1) — use _r suffix to avoid name clash with left arm.
	var r_side: float = 1.0
	var r_sh := Vector3(r_side * w * 0.50, shoulder_y, 0)
	var r_elbow := Vector3(r_side * w * 0.62, clearance + h * 0.40, d * 0.10)
	var r_wrist := Vector3(r_side * w * 0.55, clearance + h * 0.18, d * 0.18)
	_build_tapered_segment(root, r_sh, w * 0.10, r_elbow, w * 0.08, armor, 0.30, 0.55)
	_build_tapered_segment(root, r_elbow, w * 0.08, r_wrist, w * 0.07, armor, 0.30, 0.55)
	_build_tapered_segment(root, r_elbow + Vector3(0, h * 0.02, 0), w * 0.04,
		r_elbow + Vector3(r_side * w * 0.20, h * 0.15, -d * 0.10), w * 0.008,
		wind, 0.20, 0.20)
	_build_box(
		root,
		Vector3(r_wrist.x - w * 0.07, r_wrist.y - h * 0.08, r_wrist.z - d * 0.07),
		Vector3(r_wrist.x + w * 0.07, r_wrist.y + h * 0.02, r_wrist.z + d * 0.09),
		armor_dark, 0.30, 0.65
	)
	# SWORD held in the hand
	var blade_color := Color(0.92, 0.92, 0.95)
	var hilt_color := armor_trim
	var sword_grip_top := Vector3(r_wrist.x + w * 0.04, r_wrist.y - h * 0.10, r_wrist.z + d * 0.08)
	var sword_guard := Vector3(r_wrist.x + w * 0.04, r_wrist.y + h * 0.04, r_wrist.z + d * 0.08)
	var blade_tip := Vector3(r_wrist.x + w * 0.04, r_wrist.y + h * 0.95, r_wrist.z + d * 0.05)
	_build_tapered_segment(root, sword_grip_top, w * 0.022, sword_guard, w * 0.024,
		hilt_color, 0.30)
	_build_box(
		root,
		Vector3(sword_guard.x - w * 0.13, sword_guard.y, sword_guard.z - 0.02),
		Vector3(sword_guard.x + w * 0.13, sword_guard.y + h * 0.04, sword_guard.z + 0.02),
		hilt_color, 0.25, 0.65
	)
	_build_box(
		root,
		Vector3(sword_grip_top.x - w * 0.035, sword_grip_top.y - h * 0.04, sword_grip_top.z - 0.025),
		Vector3(sword_grip_top.x + w * 0.035, sword_grip_top.y, sword_grip_top.z + 0.025),
		hilt_color, 0.25, 0.55
	)
	_build_tapered_segment(root, sword_guard + Vector3(0, h * 0.04, 0), w * 0.030,
		blade_tip, w * 0.005, blade_color, 0.20, 0.65)
	_build_tapered_segment(root, sword_guard + Vector3(0, h * 0.04, 0.005), w * 0.012,
		blade_tip + Vector3(0, 0, 0.002), w * 0.001, glow, 0.10, 0.55)

	# LEFT ARM (shield side, side = -1) — use _l suffix.
	var l_side: float = -1.0
	var l_sh := Vector3(l_side * w * 0.50, shoulder_y, 0)
	var l_elbow := Vector3(l_side * w * 0.55, clearance + h * 0.35, d * 0.05)
	var l_wrist := Vector3(l_side * w * 0.50, clearance + h * 0.10, d * 0.10)
	_build_tapered_segment(root, l_sh, w * 0.10, l_elbow, w * 0.08, armor, 0.30, 0.55)
	_build_tapered_segment(root, l_elbow, w * 0.08, l_wrist, w * 0.07, armor, 0.30, 0.55)
	_build_tapered_segment(root, l_elbow + Vector3(0, h * 0.02, 0), w * 0.04,
		l_elbow + Vector3(l_side * w * 0.20, h * 0.15, -d * 0.10), w * 0.008,
		wind, 0.20, 0.20)
	_build_box(
		root,
		Vector3(l_wrist.x - w * 0.07, l_wrist.y - h * 0.08, l_wrist.z - d * 0.07),
		Vector3(l_wrist.x + w * 0.07, l_wrist.y + h * 0.02, l_wrist.z + d * 0.09),
		armor_dark, 0.30, 0.65
	)
	# SHIELD — shape depends on shield_kind
	var shield_center := Vector3(l_wrist.x - w * 0.10, l_wrist.y + h * 0.12, l_wrist.z + d * 0.15)
	if shield_kind == "round":
		var shield_sections: Array = [
			{"center": shield_center, "w": w * 0.32, "h": w * 0.32},
			{"center": shield_center + Vector3(0, 0, d * 0.05),
			 "w": w * 0.32, "h": w * 0.32},
		]
		_swept_body(root, shield_sections, 12, armor, Color(0,0,0,0), 0.30, true)
		_build_box(
			root,
			shield_center + Vector3(-w * 0.08, -w * 0.08, d * 0.06),
			shield_center + Vector3(w * 0.08, w * 0.08, d * 0.12),
			armor_trim, 0.25, 0.65
		)
	elif shield_kind == "kite":
		var k_top_l := shield_center + Vector3(-w * 0.28, h * 0.30, d * 0.03)
		var k_top_r := shield_center + Vector3(w * 0.28, h * 0.30, d * 0.03)
		var k_mid_l := shield_center + Vector3(-w * 0.25, -h * 0.05, d * 0.03)
		var k_mid_r := shield_center + Vector3(w * 0.25, -h * 0.05, d * 0.03)
		var k_bot := shield_center + Vector3(0, -h * 0.35, d * 0.03)
		var st_k := SurfaceTool.new()
		st_k.begin(Mesh.PRIMITIVE_TRIANGLES)
		_add_tri(st_k, k_top_l, k_top_r, k_mid_r)
		_add_tri(st_k, k_top_l, k_mid_r, k_mid_l)
		_add_tri(st_k, k_mid_l, k_mid_r, k_bot)
		_add_tri(st_k, k_top_r, k_top_l, k_mid_r)
		_add_tri(st_k, k_mid_r, k_top_l, k_mid_l)
		_add_tri(st_k, k_mid_r, k_mid_l, k_bot)
		st_k.generate_normals()
		var mi_k := MeshInstance3D.new()
		mi_k.mesh = st_k.commit()
		var mat_k := StandardMaterial3D.new()
		mat_k.albedo_color = armor
		mat_k.roughness = 0.30
		mat_k.metallic = 0.65
		mat_k.cull_mode = BaseMaterial3D.CULL_DISABLED
		mi_k.material_override = mat_k
		root.add_child(mi_k)
	else:    # tower
		_build_box(
			root,
			shield_center + Vector3(-w * 0.25, -h * 0.40, d * 0.03),
			shield_center + Vector3(w * 0.25, h * 0.35, d * 0.07),
			armor, 0.30, 0.65
		)
		_build_box(
			root,
			shield_center + Vector3(-w * 0.27, h * 0.30, d * 0.06),
			shield_center + Vector3(w * 0.27, h * 0.35, d * 0.10),
			armor_trim, 0.25, 0.70
		)
		_build_box(
			root,
			shield_center + Vector3(-w * 0.27, -h * 0.40, d * 0.06),
			shield_center + Vector3(w * 0.27, -h * 0.35, d * 0.10),
			armor_trim, 0.25, 0.70
		)

	# ============================================================================
	# LEGS — armored greaves + boots with knee wind wisps
	# ============================================================================
	for side in [-1, 1]:
		var hip_x: float = side * w * 0.20
		var hip_pos := Vector3(hip_x, hip_y + h * 0.02, 0)
		var knee := Vector3(hip_x, clearance * 0.55, d * 0.02)
		var ankle := Vector3(hip_x, clearance * 0.10, 0)
		var foot := Vector3(hip_x, 0.0, d * 0.10)
		_build_tapered_segment(root, hip_pos, w * 0.14, knee, w * 0.11, armor, 0.30, 0.55)
		_build_tapered_segment(root, knee, w * 0.11, ankle, w * 0.09, armor, 0.30, 0.55)
		# Greave plate
		_build_box(
			root,
			Vector3(knee.x - w * 0.13, ankle.y, knee.z - d * 0.10),
			Vector3(knee.x + w * 0.13, knee.y, knee.z + d * 0.10),
			armor, 0.30, 0.65
		)
		# Knee wind wisp leaking from the joint
		_build_tapered_segment(root, knee + Vector3(0, 0, d * 0.05), w * 0.04,
			knee + Vector3(side * w * 0.15, h * 0.10, d * 0.25), w * 0.005,
			wind, 0.20, 0.10)
		# Boot
		_build_box(
			root,
			Vector3(foot.x - w * 0.11, 0.0, foot.z - d * 0.20),
			Vector3(foot.x + w * 0.11, h * 0.07, foot.z + d * 0.20),
			armor_dark, 0.30, 0.65
		)

# ============================================================================
# ALIORAMUS (alioramus)
# Small theropod dinosaur — Cretaceous cousin of T-Rex. Sleeker and longer
# than a Rex, with the SIGNATURE row of small horns / bumps on the snout.
#   - Bipedal stance, slightly hunched forward (counterbalance tail)
#   - Long narrow snout with row of small teeth + DORSAL HORN RIDGE
#   - Smaller forelimbs (not as tiny as Rex, but stunted)
#   - Three-toed clawed digitigrade hind legs
#   - Long counterbalance tail
#   - Scaly skin in tropical color variants
# ============================================================================

static func _build_alioramus(plan: Dictionary, root: Node3D) -> void:
	var base: Dictionary = plan.get("base", {})
	var palette: Dictionary = plan.get("palette", {})
	var limbs: Dictionary = plan.get("limbs", {})
	var meta: Dictionary = plan.get("meta", {})
	var species: String = String(meta.get("species", "Alioramus"))

	var w: float = _axis(base, "width", 0.55)
	var h: float = _axis(base, "height", 1.05)
	var d: float = _axis(base, "depth", 1.85)
	var leg_length: float = float(limbs.get("leg_length", 0.70))
	var clearance: float = leg_length

	var render_seed: int = int(meta.get("render_seed", 0))
	var rng := RandomNumberGenerator.new()
	rng.seed = render_seed if render_seed != 0 else hash(species)

	var size_jitter: float = rng.randf_range(0.88, 1.20)
	w *= size_jitter
	h *= size_jitter
	d *= size_jitter * rng.randf_range(0.92, 1.10)
	leg_length *= rng.randf_range(0.92, 1.10)
	clearance = leg_length

	# Scale color palette
	var scale_options := [
		Color(0.38, 0.50, 0.32),     # forest green
		Color(0.55, 0.42, 0.28),     # dusty brown
		Color(0.62, 0.55, 0.40),     # tan
		Color(0.55, 0.30, 0.20),     # red-orange
		Color(0.40, 0.38, 0.35),     # gray
		Color(0.30, 0.35, 0.42),     # blue-gray
		Color(0.65, 0.55, 0.20),     # mustard
		Color(0.42, 0.20, 0.30),     # plum
	]
	var primary: Color = scale_options[rng.randi() % scale_options.size()]
	var belly: Color = primary.lightened(0.30)
	var horn_color: Color = primary.darkened(0.30)
	var tooth_color := Color(0.92, 0.88, 0.72)
	var claw_color := Color(0.18, 0.14, 0.10)
	var eye_color: Color = palette.get("eye", Color(0.85, 0.65, 0.10))
	var horn_count: int = rng.randi_range(4, 7)

	# Optional stripes / spots per individual
	var has_stripes: bool = rng.randf() > 0.5
	var stripe_color: Color = primary.darkened(0.40)

	# ============================================================================
	# SPINE — bipedal dinosaur with horizontal back. Spine path follows hip
	# height through chest then upturns slightly at the neck base.
	# ============================================================================
	var hip_y: float = clearance + h * 0.10
	var spine_path: Array = []
	# Path: tail-base (rear, low), hip (low), mid (level), chest (slightly up), neck-base (up)
	spine_path.append({"pos": Vector3(0, hip_y, -d * 0.45), "w": w * 0.25, "h": h * 0.28})
	spine_path.append({"pos": Vector3(0, hip_y + h * 0.05, -d * 0.20), "w": w * 0.38, "h": h * 0.42})
	spine_path.append({"pos": Vector3(0, hip_y + h * 0.10, 0.0), "w": w * 0.42, "h": h * 0.45})
	spine_path.append({"pos": Vector3(0, hip_y + h * 0.15, d * 0.18), "w": w * 0.38, "h": h * 0.40})
	spine_path.append({"pos": Vector3(0, hip_y + h * 0.30, d * 0.35), "w": w * 0.28, "h": h * 0.30})
	var spine_sections: Array = []
	for sp in spine_path:
		spine_sections.append({"center": sp["pos"], "w": sp["w"], "h": sp["h"]})
	_swept_body(root, spine_sections, 10, primary, belly, 0.70, true)

	# ============================================================================
	# NECK — short curved tube up to the head
	# ============================================================================
	var neck_base: Vector3 = spine_path[4]["pos"]
	var head_back := Vector3(0, neck_base.y + h * 0.25, neck_base.z + d * 0.12)
	_build_tapered_segment(root, neck_base, w * 0.22, head_back, w * 0.20, primary, 0.70)

	# ============================================================================
	# HEAD — long narrow snout with the SIGNATURE horn ridge
	# ============================================================================
	var head_mid := Vector3(0, head_back.y - h * 0.02, head_back.z + d * 0.15)
	var head_front := Vector3(0, head_back.y - h * 0.08, head_back.z + d * 0.32)
	var head_sections: Array = [
		{"center": head_back, "w": w * 0.22, "h": h * 0.26},   # matches neck top
		{"center": head_mid,  "w": w * 0.24, "h": h * 0.24},   # widest at jaw hinge
		{"center": head_front, "w": w * 0.14, "h": h * 0.14},  # narrow tip
	]
	_swept_body(root, head_sections, 10, primary, belly, 0.70, true)

	# Jaw separation (bottom jaw drops slightly to suggest open mouth)
	_build_box(
		root,
		Vector3(-w * 0.18, head_back.y - h * 0.16, head_back.z + d * 0.04),
		Vector3(w * 0.18, head_back.y - h * 0.04, head_back.z + d * 0.32),
		primary.darkened(0.10), 0.70
	)

	# SIGNATURE HORN RIDGE along the top of the snout
	for hi in range(horn_count):
		var t: float = float(hi) / float(horn_count - 1)
		var hz: float = lerpf(head_back.z + d * 0.02, head_back.z + d * 0.30, t)
		var hy: float = head_back.y + h * (0.10 - 0.04 * t)
		# Some horns offset slightly left/right for asymmetric row
		var hx: float = rng.randf_range(-w * 0.02, w * 0.02)
		var horn_h: float = h * rng.randf_range(0.04, 0.10)
		var horn_root := Vector3(hx, hy, hz)
		var horn_tip := Vector3(hx, hy + horn_h, hz)
		_build_tapered_segment(root, horn_root, w * 0.025, horn_tip, w * 0.005,
			horn_color, 0.50)

	# TEETH — row along the upper jaw
	for ti in range(6):
		var t: float = float(ti) / 5.0
		var tz: float = lerpf(head_back.z + d * 0.06, head_back.z + d * 0.30, t)
		var tx: float = lerpf(w * 0.16, w * 0.10, t)
		var tooth_y_top: float = head_back.y - h * 0.04
		var tooth_y_bot: float = tooth_y_top - h * 0.06
		for side_t in [-1, 1]:
			_build_box(
				root,
				Vector3(side_t * tx - w * 0.012, tooth_y_bot, tz - w * 0.012),
				Vector3(side_t * tx + w * 0.012, tooth_y_top, tz + w * 0.012),
				tooth_color, 0.40
			)

	# EYES — small high on the head
	for side in [-1, 1]:
		_build_box(
			root,
			Vector3(side * w * 0.20, head_back.y + h * 0.06, head_back.z + d * 0.05),
			Vector3(side * w * 0.26, head_back.y + h * 0.13, head_back.z + d * 0.10),
			eye_color, 0.25, 0.10
		)
		# Pupil
		_build_box(
			root,
			Vector3(side * w * 0.22, head_back.y + h * 0.08, head_back.z + d * 0.09),
			Vector3(side * w * 0.24, head_back.y + h * 0.11, head_back.z + d * 0.12),
			Color(0.05, 0.04, 0.03), 0.30
		)

	# ============================================================================
	# TAIL — long counterbalance, tapers from hip to a point behind
	# ============================================================================
	var tail_sections: Array = []
	var tail_segs: int = 6
	var tail_start: Vector3 = spine_path[0]["pos"]
	for i in range(tail_segs):
		var t: float = float(i) / float(tail_segs - 1)
		var tz: float = tail_start.z - t * d * 0.95
		var ty: float = tail_start.y - t * h * 0.18
		var tr: float = lerpf(w * 0.22, w * 0.03, t)
		var thr: float = lerpf(h * 0.24, h * 0.04, t)
		tail_sections.append({"center": Vector3(0, ty, tz), "w": tr, "h": thr})
	_swept_body(root, tail_sections, 10, primary, belly, 0.70, false)

	# ============================================================================
	# FORELIMBS — small but not vestigial; arms dangle near the chest
	# ============================================================================
	for side in [-1, 1]:
		var arm_jitter: float = rng.randf_range(0.90, 1.10)
		var sh := Vector3(side * w * 0.30, spine_path[3]["pos"].y + h * 0.02, spine_path[3]["pos"].z)
		var elbow := Vector3(side * w * 0.38 * arm_jitter, sh.y - h * 0.15, sh.z + d * 0.05)
		var hand := Vector3(side * w * 0.42 * arm_jitter, sh.y - h * 0.30, sh.z + d * 0.10)
		_build_tapered_segment(root, sh, w * 0.06, elbow, w * 0.05, primary, 0.70)
		_build_tapered_segment(root, elbow, w * 0.05, hand, w * 0.04, primary, 0.70)
		# 2 claw fingers
		for ci in [-1, 1]:
			var claw_tip := Vector3(hand.x + ci * w * 0.025, hand.y - h * 0.06, hand.z + d * 0.04)
			_build_tapered_segment(root, hand, w * 0.02, claw_tip, w * 0.003,
				claw_color, 0.40)

	# ============================================================================
	# HIND LEGS — digitigrade (reverse knee), 3 clawed toes
	# ============================================================================
	for side in [-1, 1]:
		var leg_jitter: float = rng.randf_range(0.92, 1.12)
		var hip_x: float = side * w * 0.22
		var hip_pos := Vector3(hip_x, hip_y - h * 0.02, -d * 0.10)
		# Digitigrade: knee forward, ankle back, foot forward
		var knee := Vector3(hip_x, clearance * 0.60 * leg_jitter, d * 0.05)
		var ankle := Vector3(hip_x, clearance * 0.20, -d * 0.08)
		var foot := Vector3(hip_x, 0.0, d * 0.12)
		_build_tapered_segment(root, hip_pos, w * 0.16, knee, w * 0.13, primary, 0.70)
		_build_tapered_segment(root, knee, w * 0.12, ankle, w * 0.09, primary, 0.70)
		_build_tapered_segment(root, ankle, w * 0.09, foot, w * 0.08, primary, 0.70)
		# 3 clawed toes
		for ti in range(3):
			var toe_offset: float = (float(ti) - 1.0) * w * 0.06
			var toe_tip := Vector3(foot.x + toe_offset, 0.0, foot.z + d * 0.12)
			_build_tapered_segment(root, foot, w * 0.05, toe_tip, w * 0.02, primary.darkened(0.10), 0.70)
			# Claw
			var claw_tip := Vector3(toe_tip.x, 0.01, toe_tip.z + d * 0.05)
			_build_tapered_segment(root, toe_tip, w * 0.02, claw_tip, w * 0.004,
				claw_color, 0.40)

	# ============================================================================
	# STRIPES (optional) — vertical bands across the body
	# ============================================================================
	if has_stripes:
		var stripe_count: int = rng.randi_range(3, 6)
		for si in range(stripe_count):
			var t: float = float(si) / float(stripe_count - 1)
			var sz: float = lerpf(-d * 0.30, d * 0.25, t)
			# Ring around the body — simplified as a thin box wrapping around the body cross-section
			_build_box(
				root,
				Vector3(-w * 0.45, hip_y + h * 0.08, sz - w * 0.04),
				Vector3(w * 0.45, hip_y + h * 0.55, sz + w * 0.04),
				stripe_color, 0.75
			)

# ============================================================================
# ALLIP (allip)
# Incorporeal undead — restless babbling madman ghost. Iconic features:
#   - Floating tattered cloak form (no body, only hood + rags)
#   - NO LOWER JAW (signature — drove itself mad, chewed it off)
#   - Hollow glowing eye sockets in a skull-like face
#   - Multiple wispy ragged tails trailing below (instead of legs)
#   - Translucent ethereal body
#   - Tendril-arms reaching out with clawed fingers
#   - Subtle aura halo
# ============================================================================

static func _build_allip(plan: Dictionary, root: Node3D) -> void:
	var base: Dictionary = plan.get("base", {})
	var palette: Dictionary = plan.get("palette", {})
	var meta: Dictionary = plan.get("meta", {})
	var species: String = String(meta.get("species", "Allip"))

	var w: float = _axis(base, "width", 0.65)
	var h: float = _axis(base, "height", 1.55)
	var _d: float = _axis(base, "depth", 0.55)

	var render_seed: int = int(meta.get("render_seed", 0))
	var rng := RandomNumberGenerator.new()
	rng.seed = render_seed if render_seed != 0 else hash(species)

	# Per-individual variation
	var size_jitter: float = rng.randf_range(0.88, 1.18)
	var tatter_count: int = rng.randi_range(4, 7)
	var tail_wisp_count: int = rng.randi_range(3, 5)
	w *= size_jitter
	h *= size_jitter

	# Color palette — ghosts come in unsettling ethereal shades
	var cloak_options := [
		Color(0.08, 0.05, 0.12),     # near-black void
		Color(0.15, 0.10, 0.20),     # deep purple shadow
		Color(0.18, 0.18, 0.22),     # ash gray
		Color(0.22, 0.10, 0.10),     # bloody black
		Color(0.10, 0.15, 0.18),     # cold storm-blue
		Color(0.12, 0.18, 0.10),     # graveyard moss-black
	]
	var eye_options := [
		Color(0.95, 0.95, 0.80),     # bone white
		Color(0.55, 0.95, 1.00),     # ghost blue
		Color(0.95, 0.85, 0.30),     # corrupt gold
		Color(0.55, 0.95, 0.65),     # poison green
		Color(0.95, 0.55, 0.95),     # mad violet
		Color(1.00, 0.40, 0.40),     # rage red
	]
	var cloak: Color = cloak_options[rng.randi() % cloak_options.size()]
	var cloak_dark: Color = cloak.darkened(0.30)
	var eye_color: Color = eye_options[rng.randi() % eye_options.size()]
	var skin: Color = palette.get("primary", Color(0.65, 0.62, 0.55))
	var void_color := Color(0.02, 0.02, 0.04)

	# Allip floats — body center sits high off the ground.
	var hover: float = h * 0.30
	var body_y: float = hover + h * 0.50          # body center high up
	var head_y: float = body_y + h * 0.45         # face is at the very top

	# ============================================================================
	# HOOD + CLOAK — tapered cone form widening from head down to tails.
	# Vertical orientation, sections stacked along Y.
	# ============================================================================
	var cloak_sections: Array = []
	# Top: hood opening (narrowest)
	cloak_sections.append({"center": Vector3(0, head_y + h * 0.15, 0),
		"w": w * 0.22, "h": w * 0.22})
	# Hood widening
	cloak_sections.append({"center": Vector3(0, head_y + h * 0.05, 0),
		"w": w * 0.32, "h": w * 0.32})
	# Hood opening (where face is)
	cloak_sections.append({"center": Vector3(0, head_y - h * 0.05, 0),
		"w": w * 0.40, "h": w * 0.36})
	# Shoulders
	cloak_sections.append({"center": Vector3(0, body_y + h * 0.20, 0),
		"w": w * 0.52, "h": w * 0.40})
	# Waist
	cloak_sections.append({"center": Vector3(0, body_y - h * 0.10, 0),
		"w": w * 0.45, "h": w * 0.36})
	# Lower body (where it starts to fray)
	cloak_sections.append({"center": Vector3(0, body_y - h * 0.40, 0),
		"w": w * 0.32, "h": w * 0.28})
	# Frayed end — uneven cross-section (jitter the radius)
	cloak_sections.append({"center": Vector3(0, hover, 0),
		"w": w * 0.18, "h": w * 0.18})
	_swept_body(root, cloak_sections, 10, cloak, Color(0,0,0,0), 0.95, true)

	# ============================================================================
	# FACE INSIDE THE HOOD — sunken skull-like face with NO LOWER JAW.
	# Built as a smaller box recessed inside the hood opening.
	# ============================================================================
	var face_z: float = w * 0.32
	# Upper face — has cranium + eye sockets + nose hole
	_build_box(
		root,
		Vector3(-w * 0.20, head_y - h * 0.05, face_z),
		Vector3(w * 0.20, head_y + h * 0.05, face_z + 0.020),
		skin.darkened(0.20), 0.85
	)
	# DEEP DARK VOID inside the hood (behind the face)
	_build_box(
		root,
		Vector3(-w * 0.22, head_y - h * 0.05, face_z - 0.04),
		Vector3(w * 0.22, head_y + h * 0.10, face_z - 0.005),
		void_color, 0.20
	)
	# GLOWING EYE SOCKETS (hollow — eye-glow inside the empty socket)
	for side in [-1, 1]:
		# Socket recess (dark hole)
		_build_box(
			root,
			Vector3(side * w * 0.10 - w * 0.05, head_y - h * 0.02, face_z + 0.005),
			Vector3(side * w * 0.10 + w * 0.05, head_y + h * 0.04, face_z + 0.022),
			void_color, 0.30
		)
		# Glowing dot inside the socket — implies "eyes" but they're empty sockets
		_build_box(
			root,
			Vector3(side * w * 0.10 - w * 0.025, head_y - h * 0.005, face_z + 0.020),
			Vector3(side * w * 0.10 + w * 0.025, head_y + h * 0.025, face_z + 0.026),
			eye_color, 0.10, 0.45
		)
	# Nasal cavity (small black diamond / triangle)
	_build_box(
		root,
		Vector3(-w * 0.04, head_y - h * 0.04, face_z + 0.018),
		Vector3(w * 0.04, head_y - h * 0.01, face_z + 0.024),
		void_color, 0.30
	)
	# UPPER TEETH ROW — signature: only upper teeth exist (no lower jaw)
	for ti in range(5):
		var t: float = float(ti) / 4.0
		var tx: float = lerpf(-w * 0.14, w * 0.14, t)
		_build_box(
			root,
			Vector3(tx - w * 0.018, head_y - h * 0.08, face_z + 0.015),
			Vector3(tx + w * 0.018, head_y - h * 0.04, face_z + 0.026),
			Color(0.85, 0.78, 0.65), 0.50
		)
	# Below the upper teeth — empty space (no lower jaw, just darkness)
	# The hood interior void already covers this region.

	# ============================================================================
	# TATTERED CLOAK STRIPS — uneven rags hanging from the lower cloak edge.
	# Each strip is a tapered narrow vertical box.
	# ============================================================================
	for ti in range(tatter_count):
		var ang: float = TAU * float(ti) / float(tatter_count) + rng.randf_range(-0.3, 0.3)
		var r: float = w * 0.25
		var top_y: float = body_y - h * 0.30
		var rag_len: float = h * rng.randf_range(0.20, 0.55)
		var top := Vector3(cos(ang) * r, top_y, sin(ang) * r)
		var bottom := Vector3(cos(ang) * r * 1.10, top_y - rag_len,
			sin(ang) * r * 1.10)
		var rag_color: Color = cloak if ti % 2 == 0 else cloak_dark
		_build_tapered_segment(root, top, w * 0.05, bottom, w * 0.015, rag_color, 0.95)

	# ============================================================================
	# WISPY TAIL TENDRILS — multiple ragged ghost tails trailing below where
	# legs would be. Different lengths/droops for each.
	# ============================================================================
	for wi in range(tail_wisp_count):
		var ang: float = TAU * float(wi) / float(tail_wisp_count) + rng.randf_range(-0.4, 0.4)
		var r: float = w * 0.12
		var t_root := Vector3(cos(ang) * r, hover + h * 0.05, sin(ang) * r)
		var droop_len: float = h * rng.randf_range(0.20, 0.50)
		var t_mid := Vector3(cos(ang) * r * 1.5, hover - droop_len * 0.4, sin(ang) * r * 1.5)
		var t_tip := Vector3(cos(ang) * r * 1.8, hover - droop_len, sin(ang) * r * 1.8)
		_build_tapered_segment(root, t_root, w * 0.05, t_mid, w * 0.025, cloak_dark, 0.95)
		_build_tapered_segment(root, t_mid, w * 0.025, t_tip, w * 0.005, cloak_dark, 0.95)

	# ============================================================================
	# TENDRIL ARMS — long reaching arms with claw-fingers, emerging from
	# the upper cloak shoulders
	# ============================================================================
	for side in [-1, 1]:
		var arm_jitter: float = rng.randf_range(0.88, 1.15)
		var sh := Vector3(side * w * 0.40, body_y + h * 0.15, 0)
		var elbow := Vector3(side * w * 0.60 * arm_jitter, body_y - h * 0.05,
			w * 0.10)
		var wrist := Vector3(side * w * 0.55 * arm_jitter, body_y - h * 0.25,
			w * 0.15)
		_build_tapered_segment(root, sh, w * 0.06, elbow, w * 0.05, cloak_dark, 0.95)
		_build_tapered_segment(root, elbow, w * 0.05, wrist, w * 0.04, cloak_dark, 0.95)
		# 4 long claw fingers (allip's hands are eerily long)
		for fi in range(4):
			var ft: float = float(fi) / 3.0 - 0.5
			var fx: float = side * (w * 0.55 + ft * w * 0.04) * arm_jitter
			var finger_tip := Vector3(fx, wrist.y - h * 0.18, wrist.z + w * 0.05)
			_build_tapered_segment(root, wrist, w * 0.025, finger_tip, w * 0.004,
				eye_color.darkened(0.40), 0.40)

	# ============================================================================
	# AURA HALO — faint glowing ring/halo around the figure
	# ============================================================================
	var halo_y: float = head_y + h * 0.20
	var halo_r: float = w * 0.50
	for hi in range(8):
		var ang: float = TAU * float(hi) / 8.0
		var halo_root := Vector3(cos(ang) * halo_r, halo_y, sin(ang) * halo_r)
		var halo_next := Vector3(cos(ang + TAU / 8.0) * halo_r, halo_y,
			sin(ang + TAU / 8.0) * halo_r)
		_build_tapered_segment(root, halo_root, w * 0.015, halo_next, w * 0.015,
			eye_color, 0.10, 0.50)

# ============================================================================
# ALLOSAURUS (allosaurus)
# Large theropod dinosaur — distinct from Alioramus and T-Rex:
#   - LONGER and LEANER than T-Rex (more agile predator)
#   - LONG FORELIMBS with 3 large hooked claws (not vestigial like Rex)
#   - DISTINCTIVE BROW CRESTS — paired bony ridges above each eye
#     (the iconic Allosaurus signature)
#   - Long narrow head with toothy jaw (more elongated than Alioramus)
#   - 3-toed digitigrade hind legs with massive claws
#   - Long counterbalance tail
#   - Scaly skin in tropical predator colors
# ============================================================================

static func _build_allosaurus(plan: Dictionary, root: Node3D) -> void:
	var base: Dictionary = plan.get("base", {})
	var palette: Dictionary = plan.get("palette", {})
	var limbs: Dictionary = plan.get("limbs", {})
	var meta: Dictionary = plan.get("meta", {})
	var species: String = String(meta.get("species", "Allosaurus"))

	var w: float = _axis(base, "width", 0.70)
	var h: float = _axis(base, "height", 1.30)
	var d: float = _axis(base, "depth", 2.30)
	var leg_length: float = float(limbs.get("leg_length", 0.95))
	var clearance: float = leg_length

	var render_seed: int = int(meta.get("render_seed", 0))
	var rng := RandomNumberGenerator.new()
	rng.seed = render_seed if render_seed != 0 else hash(species)

	var size_jitter: float = rng.randf_range(0.88, 1.20)
	w *= size_jitter
	h *= size_jitter
	d *= size_jitter * rng.randf_range(0.95, 1.10)
	leg_length *= rng.randf_range(0.92, 1.10)
	clearance = leg_length

	# Scale color palette — Jurassic predator tones
	var scale_options := [
		Color(0.50, 0.42, 0.28),     # tawny brown
		Color(0.35, 0.45, 0.30),     # forest olive
		Color(0.62, 0.48, 0.30),     # sandstone
		Color(0.45, 0.30, 0.22),     # rust red
		Color(0.32, 0.35, 0.30),     # mottled grey-green
		Color(0.55, 0.25, 0.18),     # blood ochre
		Color(0.40, 0.42, 0.50),     # storm grey
		Color(0.65, 0.55, 0.35),     # savanna gold
	]
	var primary: Color = scale_options[rng.randi() % scale_options.size()]
	var belly: Color = primary.lightened(0.30)
	var crest_color: Color = primary.darkened(0.30)
	var tooth_color := Color(0.92, 0.88, 0.72)
	var claw_color := Color(0.15, 0.12, 0.08)
	var eye_color: Color = palette.get("eye", Color(0.85, 0.65, 0.15))

	# Per-individual: stripe pattern, crest size, more or fewer teeth
	var has_stripes: bool = rng.randf() > 0.40
	var has_back_spots: bool = rng.randf() > 0.55
	var crest_size_jitter: float = rng.randf_range(0.80, 1.40)
	var tooth_count: int = rng.randi_range(7, 11)

	# ============================================================================
	# SPINE — horizontal posture with subtle hip-rise. 6 sections for a smooth
	# theropod curve. Lengthier than Alioramus.
	# ============================================================================
	var hip_y: float = clearance + h * 0.10
	var spine_points: Array = [
		{"pos": Vector3(0, hip_y, -d * 0.50), "w": w * 0.28, "h": h * 0.32},   # tail-base
		{"pos": Vector3(0, hip_y + h * 0.06, -d * 0.25), "w": w * 0.42, "h": h * 0.48},
		{"pos": Vector3(0, hip_y + h * 0.10, -d * 0.05), "w": w * 0.48, "h": h * 0.52},  # widest mid
		{"pos": Vector3(0, hip_y + h * 0.14, d * 0.15), "w": w * 0.45, "h": h * 0.48},
		{"pos": Vector3(0, hip_y + h * 0.22, d * 0.32), "w": w * 0.36, "h": h * 0.38},
		{"pos": Vector3(0, hip_y + h * 0.34, d * 0.45), "w": w * 0.28, "h": h * 0.30},   # neck base
	]
	var spine_sections: Array = []
	for sp in spine_points:
		spine_sections.append({"center": sp["pos"], "w": sp["w"], "h": sp["h"]})
	_swept_body(root, spine_sections, 10, primary, belly, 0.70, true)

	# ============================================================================
	# NECK — extends from spine top to head base, slightly upward arc
	# ============================================================================
	var neck_base: Vector3 = spine_points[5]["pos"]
	var head_back := Vector3(0, neck_base.y + h * 0.22, neck_base.z + d * 0.18)
	_build_tapered_segment(root, neck_base, w * 0.24, head_back, w * 0.20, primary, 0.70)

	# ============================================================================
	# HEAD — LONG narrow toothy. Three sections, longer than Alioramus.
	# ============================================================================
	# Per verify-agent: monotone taper (back wider than mid → narrow snout)
	# and push the snout farther forward so the head reads as long & narrow
	# rather than a generic theropod bulge.
	var head_mid := Vector3(0, head_back.y - h * 0.05, head_back.z + d * 0.22)
	var head_front := Vector3(0, head_back.y - h * 0.12, head_back.z + d * 0.46)
	var head_sections: Array = [
		{"center": head_back, "w": w * 0.24, "h": h * 0.28},
		{"center": head_mid,  "w": w * 0.18, "h": h * 0.22},
		{"center": head_front, "w": w * 0.10, "h": h * 0.11},
	]
	_swept_body(root, head_sections, 10, primary, belly, 0.70, true)

	# Lower jaw — opens slightly to suggest the big toothy mouth
	_build_box(
		root,
		Vector3(-w * 0.18, head_back.y - h * 0.16, head_back.z + d * 0.04),
		Vector3(w * 0.18, head_back.y - h * 0.04, head_back.z + d * 0.36),
		primary.darkened(0.15), 0.70
	)

	# ============================================================================
	# SIGNATURE BROW CRESTS — paired bony ridges ABOVE each eye. THE
	# Allosaurus identifier in any reference image.
	# ============================================================================
	# Fix per verify-agent: raise crest height (h*0.18 → h*0.28) and pull the
	# inner vertex inboard so the ridge reads as a horn/blade, not a blob.
	for side in [-1, 1]:
		var crest_back := Vector3(side * w * 0.18, head_back.y + h * 0.08, head_back.z + d * 0.02)
		var crest_top := Vector3(side * w * 0.22, head_back.y + h * (0.28 * crest_size_jitter),
			head_back.z + d * 0.08)
		var crest_front := Vector3(side * w * 0.14, head_back.y + h * 0.06, head_back.z + d * 0.16)
		var st_crest := SurfaceTool.new()
		st_crest.begin(Mesh.PRIMITIVE_TRIANGLES)
		# Inside ridge vertex — narrower (was side*w*0.08 → side*w*0.12 keeps
		# the blade thin in plan view, and lower y for sharper silhouette).
		var crest_inner := Vector3(side * w * 0.12, crest_top.y - h * 0.06,
			head_back.z + d * 0.08)
		_add_tri(st_crest, crest_back, crest_top, crest_front)
		_add_tri(st_crest, crest_back, crest_inner, crest_top)
		_add_tri(st_crest, crest_front, crest_top, crest_inner)
		_add_tri(st_crest, crest_back, crest_front, crest_inner)
		st_crest.generate_normals()
		var mi_crest := MeshInstance3D.new()
		mi_crest.mesh = st_crest.commit()
		var mat_crest := StandardMaterial3D.new()
		mat_crest.albedo_color = crest_color
		mat_crest.roughness = 0.60
		mat_crest.cull_mode = BaseMaterial3D.CULL_DISABLED
		mi_crest.material_override = mat_crest
		root.add_child(mi_crest)

	# TEETH — long row of dagger teeth visible on both jaws
	for ti in range(tooth_count):
		var tt: float = float(ti) / float(tooth_count - 1)
		var tz: float = lerpf(head_back.z + d * 0.06, head_back.z + d * 0.34, tt)
		var tx: float = lerpf(w * 0.18, w * 0.10, tt)
		var tooth_y_top: float = head_back.y - h * 0.03
		var tooth_y_bot: float = tooth_y_top - h * lerpf(0.06, 0.10, sin(tt * PI))
		for side_t in [-1, 1]:
			_build_box(
				root,
				Vector3(side_t * tx - w * 0.013, tooth_y_bot, tz - w * 0.013),
				Vector3(side_t * tx + w * 0.013, tooth_y_top, tz + w * 0.013),
				tooth_color, 0.40
			)

	# EYES — small forward-facing on cranium top
	for side in [-1, 1]:
		_build_box(
			root,
			Vector3(side * w * 0.20, head_back.y + h * 0.02, head_back.z + d * 0.10),
			Vector3(side * w * 0.26, head_back.y + h * 0.10, head_back.z + d * 0.16),
			eye_color, 0.25, 0.10
		)
		_build_box(
			root,
			Vector3(side * w * 0.22, head_back.y + h * 0.04, head_back.z + d * 0.15),
			Vector3(side * w * 0.24, head_back.y + h * 0.08, head_back.z + d * 0.18),
			Color(0.05, 0.04, 0.03), 0.30
		)

	# ============================================================================
	# TAIL — long counterbalance tail with smooth taper, drooping slightly
	# ============================================================================
	var tail_sections: Array = []
	var tail_segs: int = 7
	var tail_start: Vector3 = spine_points[0]["pos"]
	for i in range(tail_segs):
		var t: float = float(i) / float(tail_segs - 1)
		var tz: float = tail_start.z - t * d * 1.10
		var ty: float = tail_start.y - t * h * 0.15
		var tr: float = lerpf(w * 0.26, w * 0.025, t)
		var thr: float = lerpf(h * 0.30, h * 0.04, t)
		tail_sections.append({"center": Vector3(0, ty, tz), "w": tr, "h": thr})
	_swept_body(root, tail_sections, 10, primary, belly, 0.70, false)

	# ============================================================================
	# FORELIMBS — LONGER than Alioramus, 3 large hooked claws per hand.
	# This is the Allosaurus identifier: powerful arms unlike T-Rex's stubs.
	# ============================================================================
	for side in [-1, 1]:
		var arm_jitter: float = rng.randf_range(0.92, 1.12)
		var sh := Vector3(side * w * 0.32, spine_points[3]["pos"].y + h * 0.04,
			spine_points[3]["pos"].z + d * 0.02)
		var elbow := Vector3(side * w * 0.45 * arm_jitter, sh.y - h * 0.22, sh.z + d * 0.10)
		var wrist := Vector3(side * w * 0.50 * arm_jitter, sh.y - h * 0.42, sh.z + d * 0.20)
		# Upper arm — more developed than Alioramus
		_build_tapered_segment(root, sh, w * 0.09 * arm_jitter, elbow, w * 0.075 * arm_jitter,
			primary, 0.70)
		# Forearm
		_build_tapered_segment(root, elbow, w * 0.075 * arm_jitter, wrist, w * 0.06 * arm_jitter,
			primary, 0.70)
		# 3 LARGE HOOKED CLAWS per hand — signature.
		# Per verify-agent: innermost finger is the LARGEST (Allosaurus trait),
		# and the hook should curve clearly BACKWARD past the wrist.
		for ci in range(3):
			var ct: float = float(ci) - 1.0
			# Innermost (ci=0) finger is biggest; outer fingers smaller.
			var claw_scale: float = 1.0 if ci == 0 else 0.75
			var claw_root := Vector3(wrist.x + ct * w * 0.030, wrist.y - h * 0.02,
				wrist.z + d * 0.02)
			# Mid-curve sweeps FORWARD then back, creating a hook.
			var claw_mid := Vector3(wrist.x + ct * w * 0.032, wrist.y - h * 0.10,
				wrist.z + d * 0.12)
			# Tip curves BACK toward (and slightly past) the wrist for the hook
			# — Allosaurus's killing claws were notably recurved.
			var claw_tip := Vector3(wrist.x + ct * w * 0.028, wrist.y - h * 0.18,
				wrist.z - d * 0.02)
			_build_tapered_segment(root, claw_root, w * 0.038 * claw_scale, claw_mid,
				w * 0.024 * claw_scale, claw_color, 0.40)
			_build_tapered_segment(root, claw_mid, w * 0.024 * claw_scale, claw_tip,
				w * 0.005 * claw_scale, claw_color, 0.40)

	# ============================================================================
	# HIND LEGS — digitigrade, 3 clawed toes, MASSIVE for the predator's lunge
	# ============================================================================
	for side in [-1, 1]:
		var leg_jitter: float = rng.randf_range(0.94, 1.10)
		var hip_x: float = side * w * 0.24
		var hip_pos := Vector3(hip_x, hip_y - h * 0.02, -d * 0.12)
		var knee := Vector3(hip_x, clearance * 0.60 * leg_jitter, d * 0.05)
		var ankle := Vector3(hip_x, clearance * 0.20, -d * 0.10)
		var foot := Vector3(hip_x, 0.0, d * 0.14)
		_build_tapered_segment(root, hip_pos, w * 0.20, knee, w * 0.16, primary, 0.70)
		_build_tapered_segment(root, knee, w * 0.15, ankle, w * 0.11, primary, 0.70)
		_build_tapered_segment(root, ankle, w * 0.11, foot, w * 0.09, primary, 0.70)
		# 3 toes with MASSIVE hooked claws (Allosaurus killing claws)
		for ti in range(3):
			var toe_offset: float = (float(ti) - 1.0) * w * 0.08
			var toe_tip := Vector3(foot.x + toe_offset, 0.0, foot.z + d * 0.14)
			_build_tapered_segment(root, foot, w * 0.06, toe_tip, w * 0.025,
				primary.darkened(0.10), 0.70)
			# Hooked claw on each toe — bigger than Alioramus claws
			var claw_tip := Vector3(toe_tip.x, 0.02, toe_tip.z + d * 0.08)
			_build_tapered_segment(root, toe_tip, w * 0.025, claw_tip, w * 0.006,
				claw_color, 0.40)

	# ============================================================================
	# STRIPES + BACK SPOTS — per-individual patterning
	# ============================================================================
	if has_stripes:
		# Per verify-agent: stripes now sit ON the dorsal surface only — raised
		# bottom Y from h*0.20 → h*0.55 so they don't slice through the belly.
		var stripe_color: Color = primary.darkened(0.35)
		var stripe_count: int = rng.randi_range(4, 8)
		for si in range(stripe_count):
			var t: float = float(si) / float(stripe_count - 1)
			var sz: float = lerpf(-d * 0.35, d * 0.20, t)
			_build_box(
				root,
				Vector3(-w * 0.50, hip_y + h * 0.55, sz - w * 0.03),
				Vector3(w * 0.50, hip_y + h * 0.68, sz + w * 0.03),
				stripe_color, 0.75
			)

	if has_back_spots:
		var spot_color: Color = primary.darkened(0.40)
		var spot_count: int = rng.randi_range(6, 14)
		for _si in range(spot_count):
			var sz: float = rng.randf_range(-d * 0.40, d * 0.30)
			var sx: float = rng.randf_range(-w * 0.40, w * 0.40)
			var sy: float = hip_y + h * rng.randf_range(0.35, 0.65)
			var spot_r: float = w * rng.randf_range(0.05, 0.09)
			_build_box(
				root,
				Vector3(sx - spot_r, sy - 0.005, sz - spot_r),
				Vector3(sx + spot_r, sy + 0.005, sz + spot_r),
				spot_color, 0.75
			)

# ============================================================================
# AMBUSH DRAKE (ambush_drake)
# A WINGLESS quadrupedal dragon predator — Mordenkainen's Tome of Foes.
# Designed for forest ambush hunting; chameleon-like skin shifts color.
#   - Lean low-slung quadruped (BELLY CLOSE TO THE GROUND)
#   - Long narrow toothy head with the dragon snout (wider than a lizard)
#   - Whip-like LONG TAIL with horizontal spike fringe (NOT vertical fin)
#   - NO WINGS — distinguishes from any winged dragon
#   - Spine ridge of small bony spikes from neck to tail base
#   - Two large clawed forelegs + two clawed hind legs (splayed reptile)
#   - Forked / split tongue tip (sometimes flicking out)
#   - Camouflage palette options for jungle / swamp / desert / temperate
# ============================================================================

static func _build_ambush_drake(plan: Dictionary, root: Node3D) -> void:
	var base: Dictionary = plan.get("base", {})
	var palette: Dictionary = plan.get("palette", {})
	var limbs: Dictionary = plan.get("limbs", {})
	var meta: Dictionary = plan.get("meta", {})
	var species: String = String(meta.get("species", "Ambush Drake"))

	var w: float = _axis(base, "width", 0.55)
	var h: float = _axis(base, "height", 0.40)
	var d: float = _axis(base, "depth", 1.85)
	var leg_length: float = float(limbs.get("leg_length", 0.32))
	var clearance: float = leg_length

	var render_seed: int = int(meta.get("render_seed", 0))
	var rng := RandomNumberGenerator.new()
	rng.seed = render_seed if render_seed != 0 else hash(species)

	var size_jitter: float = rng.randf_range(0.88, 1.20)
	w *= size_jitter
	h *= size_jitter
	d *= size_jitter * rng.randf_range(0.92, 1.15)
	leg_length *= rng.randf_range(0.85, 1.15)
	clearance = leg_length

	# Camouflage color palette — drakes shift to match their habitat
	var scale_options := [
		Color(0.22, 0.38, 0.20),     # forest green
		Color(0.30, 0.32, 0.18),     # swamp olive
		Color(0.45, 0.40, 0.22),     # jungle tan
		Color(0.50, 0.42, 0.28),     # autumn brown
		Color(0.62, 0.55, 0.35),     # desert sand
		Color(0.28, 0.28, 0.30),     # storm grey
		Color(0.20, 0.25, 0.32),     # dusk blue-grey
		Color(0.42, 0.30, 0.22),     # rust earth
	]
	var primary: Color = scale_options[rng.randi() % scale_options.size()]
	var belly: Color = primary.lightened(0.30)
	var spine_color: Color = primary.darkened(0.30)
	var spot_color: Color = primary.darkened(0.40)
	var tooth_color := Color(0.92, 0.86, 0.65)
	var claw_color := Color(0.12, 0.10, 0.06)
	var eye_color: Color = palette.get("eye", Color(0.95, 0.65, 0.10))
	var tongue_color := Color(0.55, 0.10, 0.18)

	# Per-individual variations
	var spike_count: int = rng.randi_range(8, 14)
	var has_camo_spots: bool = rng.randf() > 0.30
	var tongue_out: bool = rng.randf() > 0.50

	# ============================================================================
	# BODY — long lean horizontal quadruped, belly LOW to ground.
	# Per verify-agent: lowered body_y to clearance*0.75 + h*0.20 (was
	# clearance + h*0.35) so it reads as a slinking ambush predator, not a
	# tall-legged lizard.
	# ============================================================================
	var body_y: float = clearance * 0.75 + h * 0.20
	var body_sections: Array = [
		{"center": Vector3(0, body_y, -d * 0.42), "w": w * 0.30, "h": h * 0.38},   # hip
		{"center": Vector3(0, body_y, -d * 0.18), "w": w * 0.42, "h": h * 0.48},
		{"center": Vector3(0, body_y, 0.05),       "w": w * 0.46, "h": h * 0.52},  # widest mid
		{"center": Vector3(0, body_y, d * 0.22),  "w": w * 0.40, "h": h * 0.46},   # shoulder
		{"center": Vector3(0, body_y - h * 0.05, d * 0.36), "w": w * 0.28, "h": h * 0.30},  # neck base
	]
	_swept_body(root, body_sections, 10, primary, belly, 0.60, true)

	# ============================================================================
	# NECK + HEAD — short flexible neck, drake/dragon-shaped head
	# ============================================================================
	var neck_base := body_sections[4]["center"] as Vector3
	var head_back := Vector3(0, neck_base.y + h * 0.05, neck_base.z + d * 0.12)
	_build_tapered_segment(root, neck_base, w * 0.22, head_back, w * 0.20, primary, 0.60)

	# HEAD — extended LONG drake head with proper 4-section taper (verify-agent
	# noted previous head was only 8% of body length; drakes have elongated
	# muzzles). New head spans d*0.34 with a snout taper section before the tip.
	var head_mid := Vector3(0, head_back.y - h * 0.05, head_back.z + d * 0.14)
	var head_snout := Vector3(0, head_back.y - h * 0.08, head_back.z + d * 0.26)
	var head_front := Vector3(0, head_back.y - h * 0.10, head_back.z + d * 0.34)
	var head_sections: Array = [
		{"center": head_back, "w": w * 0.22, "h": h * 0.26},
		{"center": head_mid,  "w": w * 0.24, "h": h * 0.22},   # cheekbone bulge
		{"center": head_snout, "w": w * 0.16, "h": h * 0.14},  # snout taper
		{"center": head_front, "w": w * 0.09, "h": h * 0.09},  # nose tip
	]
	_swept_body(root, head_sections, 10, primary, belly, 0.60, true)

	# Lower jaw — extended to match longer head
	_build_box(
		root,
		Vector3(-w * 0.20, head_back.y - h * 0.18, head_back.z + d * 0.04),
		Vector3(w * 0.20, head_back.y - h * 0.06, head_back.z + d * 0.36),
		primary.darkened(0.10), 0.60
	)

	# TEETH along the jaw
	for ti in range(8):
		var tt: float = float(ti) / 7.0
		var tz: float = lerpf(head_back.z + d * 0.06, head_back.z + d * 0.26, tt)
		var tx: float = lerpf(w * 0.18, w * 0.08, tt)
		var tooth_y_top: float = head_back.y - h * 0.05
		var tooth_y_bot: float = tooth_y_top - h * lerpf(0.05, 0.09, sin(tt * PI))
		for side_t in [-1, 1]:
			_build_box(
				root,
				Vector3(side_t * tx - w * 0.012, tooth_y_bot, tz - w * 0.012),
				Vector3(side_t * tx + w * 0.012, tooth_y_top, tz + w * 0.012),
				tooth_color, 0.40
			)

	# EYES — moved forward onto the head sections (was near neck base).
	# Now sit between head_back and head_mid for proper skull placement.
	for side in [-1, 1]:
		_build_box(
			root,
			Vector3(side * w * 0.18, head_back.y + h * 0.05, head_back.z + d * 0.12),
			Vector3(side * w * 0.24, head_back.y + h * 0.14, head_back.z + d * 0.17),
			eye_color, 0.25, 0.10
		)
		# Vertical slit pupil
		_build_box(
			root,
			Vector3(side * w * 0.20, head_back.y + h * 0.06, head_back.z + d * 0.17),
			Vector3(side * w * 0.22, head_back.y + h * 0.13, head_back.z + d * 0.18),
			Color(0.05, 0.04, 0.03), 0.30
		)

	# Optional FORKED TONGUE flicking out
	if tongue_out:
		var tongue_root := Vector3(0, head_back.y - h * 0.10, head_back.z + d * 0.27)
		var tongue_mid := Vector3(0, head_back.y - h * 0.13, head_back.z + d * 0.36)
		var fork_l := Vector3(-w * 0.04, head_back.y - h * 0.14, head_back.z + d * 0.42)
		var fork_r := Vector3(w * 0.04, head_back.y - h * 0.14, head_back.z + d * 0.42)
		_build_tapered_segment(root, tongue_root, w * 0.014, tongue_mid, w * 0.010,
			tongue_color, 0.30)
		_build_tapered_segment(root, tongue_mid, w * 0.008, fork_l, w * 0.003, tongue_color, 0.30)
		_build_tapered_segment(root, tongue_mid, w * 0.008, fork_r, w * 0.003, tongue_color, 0.30)

	# ============================================================================
	# SPINE RIDGE — row of small bony spikes from neck through tail base.
	# Iconic drake feature, distinct from a generic lizard.
	# ============================================================================
	for si in range(spike_count):
		var t: float = float(si) / float(spike_count - 1)
		var sz: float = lerpf(-d * 0.40, d * 0.30, t)
		var sy: float = body_y + h * 0.40
		var spike_h: float = h * (0.12 + 0.08 * sin(t * PI))
		# Small leaning pyramid spike
		var spike_root := Vector3(0, sy, sz)
		var spike_tip := Vector3(0, sy + spike_h, sz - w * 0.04)
		_build_tapered_segment(root, spike_root, w * 0.025, spike_tip, w * 0.004,
			spine_color, 0.60)

	# ============================================================================
	# TAIL — LONG WHIP-LIKE with horizontal spike fringe on either side
	# ============================================================================
	var tail_sections: Array = []
	var tail_segs: int = 8
	for i in range(tail_segs):
		var t: float = float(i) / float(tail_segs - 1)
		var tz: float = -d * 0.42 - t * d * 1.20
		var ty: float = body_y - t * h * 0.08
		var tr: float = lerpf(w * 0.22, w * 0.02, t)
		var thr: float = lerpf(h * 0.26, h * 0.03, t)
		tail_sections.append({"center": Vector3(0, ty, tz), "w": tr, "h": thr})
	_swept_body(root, tail_sections, 10, primary, belly, 0.60, false)

	# Tail spikes — TRULY LATERAL now (verify-agent caught that the previous
	# loop placed both spikes at x=0, just making a second dorsal ridge).
	# Roots at the tail's outer side, tips fanning further outward.
	for si in range(5):
		var t: float = float(si + 1) / 6.0
		var sz: float = -d * 0.42 - t * d * 1.10
		var sy: float = body_y - t * h * 0.08
		var tr: float = lerpf(w * 0.22, w * 0.02, t)
		for side in [-1, 1]:
			var spike_root := Vector3(side * tr * 0.9, sy, sz)
			var spike_tip := Vector3(side * (tr * 1.6 + w * 0.06), sy, sz - w * 0.04)
			_build_tapered_segment(root, spike_root, w * 0.020, spike_tip,
				w * 0.004, spine_color, 0.60)

	# ============================================================================
	# FORELEGS + HIND LEGS — splayed reptile stance, big clawed feet
	# ============================================================================
	var leg_z_offsets := [d * 0.22, -d * 0.22]   # front, back
	for leg_z in leg_z_offsets:
		for side in [-1, 1]:
			var hip_x: float = side * w * 0.28
			var hip_pos := Vector3(hip_x, body_y - h * 0.05, leg_z)
			# Lower knee + push it OUTWARD so legs splay sideways (lizard
			# ambush stance) rather than just straight down. Per verify-agent.
			var knee_x: float = side * w * 0.52
			var knee_y: float = clearance * 0.40
			var knee := Vector3(knee_x, knee_y, leg_z + (0.04 if leg_z > 0 else -0.04))
			var foot_x: float = side * w * 0.55
			var foot_z: float = leg_z + (0.08 if leg_z > 0 else -0.08)
			var foot := Vector3(foot_x, 0.0, foot_z)
			_build_tapered_segment(root, hip_pos, w * 0.10, knee, w * 0.08, primary, 0.60)
			_build_tapered_segment(root, knee, w * 0.08, foot, w * 0.07, primary.darkened(0.05), 0.60)
			# 3 clawed toes per foot
			for ti in range(3):
				var toe_offset: float = (float(ti) - 1.0) * w * 0.05
				var toe_tip := Vector3(foot.x + toe_offset * 0.6, 0.0, foot.z + w * 0.10)
				_build_tapered_segment(root, foot, w * 0.03, toe_tip, w * 0.010,
					primary.darkened(0.10), 0.60)
				var claw_tip := Vector3(toe_tip.x, 0.01, toe_tip.z + w * 0.06)
				_build_tapered_segment(root, toe_tip, w * 0.010, claw_tip, w * 0.003,
					claw_color, 0.40)

	# ============================================================================
	# CAMOUFLAGE SPOTS — mottled darker patches over the body for the
	# ambush-predator look (about 70% of individuals).
	# ============================================================================
	if has_camo_spots:
		var spot_count: int = rng.randi_range(8, 18)
		for _si in range(spot_count):
			var sz: float = rng.randf_range(-d * 0.45, d * 0.35)
			var s_side: float = 1.0 if rng.randf() > 0.5 else -1.0
			var sx: float = s_side * w * rng.randf_range(0.20, 0.46)
			var sy: float = body_y + rng.randf_range(-h * 0.15, h * 0.35)
			var spot_r: float = w * rng.randf_range(0.05, 0.10)
			_build_box(
				root,
				Vector3(sx - spot_r * 0.5, sy - spot_r, sz - spot_r),
				Vector3(sx + spot_r * 0.5, sy + spot_r, sz + spot_r),
				spot_color, 0.75
			)

# ============================================================================
# ANDROSPHINX (androsphinx)
# Egyptian-style guardian sphinx — Monster Manual.
#   - Lion's BODY (quadruped, muscular) + male HUMAN HEAD with BEARD
#   - HUGE eagle/falcon WINGS folded against the back
#   - Long lion tail with tassel tip
#   - Big paws with claws
#   - REGAL bearing — head held high, chest broad
#   - Often depicted with Egyptian pharaoh nemes headdress
# ============================================================================

static func _build_androsphinx(plan: Dictionary, root: Node3D) -> void:
	var base: Dictionary = plan.get("base", {})
	var palette: Dictionary = plan.get("palette", {})
	var limbs: Dictionary = plan.get("limbs", {})
	var meta: Dictionary = plan.get("meta", {})
	var species: String = String(meta.get("species", "Androsphinx"))

	# Defaults raised per verify-agent: previous d=2.40 read as Large not Huge.
	# Huge sphinx is ~15ft so we bump base d/h/leg_length to land in that range.
	var w: float = _axis(base, "width", 1.40)
	var h: float = _axis(base, "height", 1.80)
	var d: float = _axis(base, "depth", 3.20)
	var leg_length: float = float(limbs.get("leg_length", 1.10))
	var clearance: float = leg_length

	var render_seed: int = int(meta.get("render_seed", 0))
	var rng := RandomNumberGenerator.new()
	rng.seed = render_seed if render_seed != 0 else hash(species)

	# Per-individual variation
	var size_jitter: float = rng.randf_range(0.90, 1.18)
	w *= size_jitter
	h *= size_jitter
	d *= size_jitter

	# Lion fur palette — Egyptian-influenced tones
	var fur_options := [
		Color(0.78, 0.62, 0.35),     # classic tawny gold
		Color(0.88, 0.72, 0.40),     # bright gold
		Color(0.65, 0.48, 0.28),     # darker tawny
		Color(0.82, 0.68, 0.50),     # pale sand
		Color(0.72, 0.55, 0.32),     # warm bronze
		Color(0.90, 0.85, 0.72),     # white/cream
		Color(0.55, 0.38, 0.22),     # deep brown
	]
	var wing_options := [
		Color(0.55, 0.42, 0.28),     # eagle brown
		Color(0.85, 0.80, 0.70),     # white falcon
		Color(0.35, 0.32, 0.25),     # black raven
		Color(0.62, 0.50, 0.32),     # tan hawk
		Color(0.78, 0.68, 0.45),     # golden eagle
	]
	var nemes_options := [
		Color(0.85, 0.70, 0.20),     # gold + lapis stripe
		Color(0.92, 0.92, 0.85),     # white + gold
		Color(0.30, 0.40, 0.75),     # blue + gold
		Color(0.85, 0.30, 0.30),     # red + gold
	]
	var primary: Color = fur_options[rng.randi() % fur_options.size()]
	var fur_dark: Color = primary.darkened(0.25)
	var skin: Color = palette.get("skin", Color(0.78, 0.60, 0.42))
	var mane_color: Color = fur_options[rng.randi() % fur_options.size()].darkened(0.20)
	var wing_color: Color = wing_options[rng.randi() % wing_options.size()]
	var wing_dark: Color = wing_color.darkened(0.30)
	var nemes_color: Color = nemes_options[rng.randi() % nemes_options.size()]
	var nemes_stripe: Color = nemes_color.darkened(0.30)
	var beard_color: Color = mane_color.darkened(0.10)
	var eye_color: Color = palette.get("eye", Color(0.85, 0.65, 0.10))
	var claw_color := Color(0.18, 0.14, 0.10)
	var has_nemes: bool = rng.randf() > 0.30   # 70% wear the pharaoh headdress

	# ============================================================================
	# LION BODY — horizontal quadruped, broader than the wolf, more muscular
	# ============================================================================
	var body_y: float = clearance + h * 0.40
	var body_sections: Array = [
		{"center": Vector3(0, body_y, -d * 0.45), "w": w * 0.40, "h": h * 0.45},   # hip
		{"center": Vector3(0, body_y, -d * 0.20), "w": w * 0.48, "h": h * 0.52},
		{"center": Vector3(0, body_y, 0.05),       "w": w * 0.50, "h": h * 0.54},   # mid widest
		{"center": Vector3(0, body_y + h * 0.04, d * 0.22), "w": w * 0.52, "h": h * 0.50},   # shoulder
		{"center": Vector3(0, body_y + h * 0.10, d * 0.40), "w": w * 0.36, "h": h * 0.38},   # neck base
	]
	_swept_body(root, body_sections, 10, primary, primary.lightened(0.15), 0.85, true)

	# ============================================================================
	# REGAL MANE / CHEST FUR — fluffy ring around the neck base
	# ============================================================================
	var neck_base: Vector3 = body_sections[4]["center"]
	var mane_y: float = neck_base.y + h * 0.05
	for mi in range(10):
		var ang: float = TAU * float(mi) / 10.0
		var mr: float = w * 0.35
		var clump_pos := Vector3(cos(ang) * mr, mane_y + rng.randf_range(-h * 0.05, h * 0.05),
			neck_base.z + sin(ang) * mr * 0.6)
		var clump_r: float = w * rng.randf_range(0.10, 0.16)
		_build_box(
			root,
			clump_pos - Vector3(clump_r, clump_r, clump_r),
			clump_pos + Vector3(clump_r, clump_r, clump_r),
			mane_color, 0.95
		)

	# ============================================================================
	# NECK + HUMAN HEAD held high (regal posture)
	# ============================================================================
	var head_anchor := Vector3(0, neck_base.y + h * 0.55, neck_base.z + d * 0.15)
	_build_tapered_segment(root, neck_base, w * 0.20, head_anchor + Vector3(0, -h * 0.08, 0),
		w * 0.18, skin, 0.85)

	# Cranium (rounded human-ish head)
	var cran_w: float = w * 0.22
	var cran_h: float = h * 0.22
	var cran_d: float = d * 0.20
	_build_box(
		root,
		Vector3(-cran_w, head_anchor.y - cran_h * 0.30, head_anchor.z - cran_d * 0.50),
		Vector3(cran_w, head_anchor.y + cran_h * 0.70, head_anchor.z + cran_d * 0.50),
		skin, 0.85
	)
	# BROW RIDGE — gives the face shape rather than a flat box
	_build_box(
		root,
		Vector3(-cran_w * 0.95, head_anchor.y + cran_h * 0.30, head_anchor.z + cran_d * 0.45),
		Vector3(cran_w * 0.95, head_anchor.y + cran_h * 0.50, head_anchor.z + cran_d * 0.58),
		skin.darkened(0.10), 0.85
	)
	# Upper jaw / cheek — slimmer than cranium
	_build_box(
		root,
		Vector3(-cran_w * 0.85, head_anchor.y - cran_h * 0.20, head_anchor.z - cran_d * 0.25),
		Vector3(cran_w * 0.85, head_anchor.y + cran_h * 0.10, head_anchor.z + cran_d * 0.50),
		skin.darkened(0.03), 0.85
	)
	# CHIN — narrower than jaw, slightly forward (anchor for the beard)
	_build_box(
		root,
		Vector3(-cran_w * 0.55, head_anchor.y - cran_h * 0.50, head_anchor.z + cran_d * 0.15),
		Vector3(cran_w * 0.55, head_anchor.y - cran_h * 0.18, head_anchor.z + cran_d * 0.55),
		skin.darkened(0.05), 0.85
	)

	# NEMES HEADDRESS (Egyptian pharaoh's striped head cloth) — optional
	if has_nemes:
		# Top band wrapping the cranium
		_build_box(
			root,
			Vector3(-cran_w * 1.05, head_anchor.y + cran_h * 0.55, head_anchor.z - cran_d * 0.55),
			Vector3(cran_w * 1.05, head_anchor.y + cran_h * 0.85, head_anchor.z + cran_d * 0.45),
			nemes_color, 0.50
		)
		# Side flaps hanging down beside the face
		for side in [-1, 1]:
			_build_box(
				root,
				Vector3(side * cran_w * 0.85, head_anchor.y - cran_h * 0.30,
					head_anchor.z - cran_d * 0.20),
				Vector3(side * cran_w * 1.20, head_anchor.y + cran_h * 0.65,
					head_anchor.z + cran_d * 0.25),
				nemes_color, 0.55
			)
			# Diagonal gold stripe on the flap
			_build_box(
				root,
				Vector3(side * cran_w * 1.20, head_anchor.y - cran_h * 0.10,
					head_anchor.z - cran_d * 0.05),
				Vector3(side * cran_w * 1.22, head_anchor.y + cran_h * 0.30,
					head_anchor.z + cran_d * 0.05),
				nemes_stripe, 0.40, 0.30
			)
		# Front uraeus / crest band
		_build_box(
			root,
			Vector3(-cran_w * 0.20, head_anchor.y + cran_h * 0.65, head_anchor.z + cran_d * 0.45),
			Vector3(cran_w * 0.20, head_anchor.y + cran_h * 0.95, head_anchor.z + cran_d * 0.55),
			nemes_stripe, 0.40, 0.40
		)

	# EYES — human-style, set forward on the face
	for side in [-1, 1]:
		_build_box(
			root,
			Vector3(side * cran_w * 0.45 - cran_w * 0.10, head_anchor.y + cran_h * 0.15,
				head_anchor.z + cran_d * 0.40),
			Vector3(side * cran_w * 0.45 + cran_w * 0.10, head_anchor.y + cran_h * 0.28,
				head_anchor.z + cran_d * 0.52),
			Color(0.95, 0.92, 0.85), 0.30
		)
		# Iris
		_build_box(
			root,
			Vector3(side * cran_w * 0.45 - cran_w * 0.05, head_anchor.y + cran_h * 0.17,
				head_anchor.z + cran_d * 0.49),
			Vector3(side * cran_w * 0.45 + cran_w * 0.05, head_anchor.y + cran_h * 0.26,
				head_anchor.z + cran_d * 0.56),
			eye_color, 0.25, 0.20
		)
		# Pupil
		_build_box(
			root,
			Vector3(side * cran_w * 0.45 - cran_w * 0.018, head_anchor.y + cran_h * 0.19,
				head_anchor.z + cran_d * 0.54),
			Vector3(side * cran_w * 0.45 + cran_w * 0.018, head_anchor.y + cran_h * 0.25,
				head_anchor.z + cran_d * 0.58),
			Color(0.05, 0.04, 0.03), 0.30
		)

	# Nose bump
	_build_box(
		root,
		Vector3(-cran_w * 0.08, head_anchor.y - cran_h * 0.05, head_anchor.z + cran_d * 0.45),
		Vector3(cran_w * 0.08, head_anchor.y + cran_h * 0.15, head_anchor.z + cran_d * 0.62),
		skin.darkened(0.05), 0.85
	)

	# Mouth (small dark line)
	_build_box(
		root,
		Vector3(-cran_w * 0.16, head_anchor.y - cran_h * 0.32, head_anchor.z + cran_d * 0.42),
		Vector3(cran_w * 0.16, head_anchor.y - cran_h * 0.26, head_anchor.z + cran_d * 0.52),
		Color(0.40, 0.20, 0.20), 0.50
	)

	# CEREMONIAL BEARD — Egyptian pharaoh-style long braided beard
	var beard_top := Vector3(0, head_anchor.y - cran_h * 0.45, head_anchor.z + cran_d * 0.45)
	var beard_bot := Vector3(0, head_anchor.y - cran_h * 1.20, head_anchor.z + cran_d * 0.40)
	_build_tapered_segment(root, beard_top, w * 0.08, beard_bot, w * 0.06,
		beard_color, 0.95)
	# Beard end tassel
	_build_box(
		root,
		Vector3(-w * 0.06, beard_bot.y - h * 0.04, beard_bot.z - w * 0.04),
		Vector3(w * 0.06, beard_bot.y + h * 0.02, beard_bot.z + w * 0.04),
		beard_color.darkened(0.20), 0.95
	)

	# ============================================================================
	# WINGS — HUGE eagle wings folded against the back, but visible from sides
	# ============================================================================
	for side in [-1, 1]:
		var wing_origin := Vector3(side * w * 0.40, body_y + h * 0.42, d * 0.10)
		# Build wing as a series of overlapping feather "fingers"
		# Primary edge: from shoulder back and slightly up
		var wing_tip := Vector3(side * w * 1.35, body_y + h * 0.85, -d * 0.30)
		var wing_mid := Vector3(side * w * 1.10, body_y + h * 0.92, -d * 0.05)
		var wing_back := Vector3(side * w * 0.65, body_y + h * 0.35, -d * 0.35)
		# Main wing membrane (large triangle)
		var st_wing := SurfaceTool.new()
		st_wing.begin(Mesh.PRIMITIVE_TRIANGLES)
		_add_tri(st_wing, wing_origin, wing_mid, wing_tip)
		_add_tri(st_wing, wing_origin, wing_tip, wing_back)
		# Backface
		_add_tri(st_wing, wing_origin, wing_tip, wing_mid)
		_add_tri(st_wing, wing_origin, wing_back, wing_tip)
		st_wing.generate_normals()
		var mi_wing := MeshInstance3D.new()
		mi_wing.mesh = st_wing.commit()
		var mat_wing := StandardMaterial3D.new()
		mat_wing.albedo_color = wing_color
		mat_wing.roughness = 0.85
		mat_wing.cull_mode = BaseMaterial3D.CULL_DISABLED
		mi_wing.material_override = mat_wing
		root.add_child(mi_wing)
		# PRIMARY feather struts along the wing tip edge (10 now, was 6;
		# wider base radius per verify-agent for proper density)
		for fi in range(10):
			var ft: float = float(fi) / 9.0
			var feather_root := wing_origin.lerp(wing_tip, ft * 0.6)
			var feather_tip := wing_mid.lerp(wing_tip, ft).lerp(
				Vector3(side * w * 1.40, body_y + h * 0.55, -d * 0.50), 0.3)
			_build_tapered_segment(root, feather_root, w * 0.035, feather_tip, w * 0.010,
				wing_dark, 0.85)
		# SECONDARY COVERTS — inner feather row covering the wing base.
		# Lighter color so they read as a distinct row.
		for fi in range(5):
			var ft: float = float(fi + 1) / 6.0
			var covert_root := wing_origin.lerp(wing_mid, ft)
			var covert_tip := wing_back.lerp(wing_mid, ft)
			_build_tapered_segment(root, covert_root, w * 0.030, covert_tip, w * 0.012,
				wing_color, 0.85)

	# ============================================================================
	# LION TAIL — long, ends in a tassel
	# ============================================================================
	var tail_root := Vector3(0, body_y, -d * 0.46)
	var tail_mid := Vector3(0, body_y - h * 0.18, -d * 0.75)
	var tail_pre_tassel := Vector3(0, body_y - h * 0.35, -d * 0.98)
	_build_tapered_segment(root, tail_root, w * 0.10, tail_mid, w * 0.06,
		primary, 0.85)
	_build_tapered_segment(root, tail_mid, w * 0.06, tail_pre_tassel, w * 0.025,
		primary, 0.85)
	# Tassel at the tip — fluffy bundle
	_build_box(
		root,
		Vector3(-w * 0.10, tail_pre_tassel.y - h * 0.10, tail_pre_tassel.z - w * 0.10),
		Vector3(w * 0.10, tail_pre_tassel.y + h * 0.05, tail_pre_tassel.z + w * 0.10),
		mane_color, 0.95
	)

	# ============================================================================
	# LION LEGS — 4 muscular legs, big paws with claws
	# ============================================================================
	var leg_z_offsets := [d * 0.25, -d * 0.25]
	for leg_z in leg_z_offsets:
		for side in [-1, 1]:
			var leg_jitter: float = rng.randf_range(0.92, 1.10)
			var hip_x: float = side * w * 0.28
			var hip_pos := Vector3(hip_x, body_y - h * 0.05, leg_z)
			var knee := Vector3(hip_x, clearance * 0.55 * leg_jitter, leg_z + (0.04 if leg_z > 0 else -0.04))
			var ankle := Vector3(hip_x, clearance * 0.18, leg_z + (0.02 if leg_z > 0 else -0.02))
			var paw := Vector3(hip_x, 0.0, leg_z + (0.10 if leg_z > 0 else -0.06))
			_build_tapered_segment(root, hip_pos, w * 0.16, knee, w * 0.13, primary, 0.85)
			_build_tapered_segment(root, knee, w * 0.12, ankle, w * 0.10, primary, 0.85)
			_build_tapered_segment(root, ankle, w * 0.10, paw, w * 0.09, fur_dark, 0.85)
			# Paw — wide flat box
			_build_box(
				root,
				Vector3(paw.x - w * 0.12, 0.0, paw.z - w * 0.12),
				Vector3(paw.x + w * 0.12, h * 0.06, paw.z + w * 0.14),
				fur_dark, 0.85
			)
			# 4 claws on each paw
			for ci in range(4):
				var co: float = (float(ci) - 1.5) * w * 0.06
				var claw_tip := Vector3(paw.x + co, 0.01, paw.z + w * (0.18 if leg_z > 0 else 0.10))
				_build_tapered_segment(root, paw + Vector3(co, h * 0.03, 0), w * 0.025,
					claw_tip, w * 0.004, claw_color, 0.40)

# ============================================================================
# ANGEL (angel)
# Generic celestial humanoid — Monster Manual. Floating, radiant humanoid:
#   - Upright humanoid body in flowing robes
#   - HUGE feathered wings extending from the back
#   - GLOWING HALO above the head
#   - Ethereal glowing skin (subtle emission)
#   - Flowing robes / sash with golden trim
#   - Bare feet (or holy sandals)
#   - Sometimes wielding a longsword / staff / spear
# ============================================================================

static func _build_angel(plan: Dictionary, root: Node3D) -> void:
	var base: Dictionary = plan.get("base", {})
	var palette: Dictionary = plan.get("palette", {})
	var limbs: Dictionary = plan.get("limbs", {})
	var meta: Dictionary = plan.get("meta", {})
	var species: String = String(meta.get("species", "Angel"))

	var w: float = _axis(base, "width", 0.65)
	var h: float = _axis(base, "height", 1.75)
	var d: float = _axis(base, "depth", 0.40)
	var leg_length: float = float(limbs.get("leg_length", 0.85))
	var clearance: float = leg_length

	var render_seed: int = int(meta.get("render_seed", 0))
	var rng := RandomNumberGenerator.new()
	rng.seed = render_seed if render_seed != 0 else hash(species)

	var size_jitter: float = rng.randf_range(0.92, 1.18)
	w *= size_jitter
	h *= size_jitter
	d *= size_jitter

	# Color palette — celestial radiant tones
	var robe_options := [
		Color(0.95, 0.92, 0.85),     # divine white
		Color(0.92, 0.78, 0.30),     # holy gold
		Color(0.85, 0.85, 0.92),     # silver
		Color(0.45, 0.65, 0.95),     # azure blue
		Color(0.85, 0.75, 0.55),     # cream and gold
		Color(0.78, 0.55, 0.95),     # ethereal lavender
		Color(0.55, 0.95, 0.85),     # mint celestial
	]
	var wing_options := [
		Color(0.95, 0.95, 0.92),     # pure white (most common)
		Color(0.95, 0.85, 0.30),     # gold-edged
		Color(0.85, 0.85, 0.92),     # silver
		Color(0.92, 0.88, 0.72),     # cream
		Color(0.55, 0.78, 0.95),     # sky blue
	]
	var halo_options := [
		Color(0.95, 0.85, 0.30),     # iconic gold
		Color(0.95, 0.95, 0.95),     # white light
		Color(0.55, 0.95, 0.95),     # cyan-blue celestial
		Color(0.95, 0.55, 0.95),     # violet
	]
	var eye_options := [
		Color(0.95, 0.95, 0.85),     # holy white
		Color(0.55, 0.85, 1.00),     # divine blue
		Color(0.95, 0.85, 0.30),     # gold
		Color(0.55, 0.95, 0.55),     # emerald
	]
	var weapon_kinds := ["sword", "staff", "spear", "none"]

	var robe: Color = robe_options[rng.randi() % robe_options.size()]
	var robe_dark: Color = robe.darkened(0.20)
	var trim: Color = Color(0.95, 0.78, 0.20)        # always gold trim
	var skin: Color = palette.get("skin", Color(0.95, 0.85, 0.75))
	var wing_color: Color = wing_options[rng.randi() % wing_options.size()]
	var wing_dark: Color = wing_color.darkened(0.15)
	var halo_color: Color = halo_options[rng.randi() % halo_options.size()]
	var eye_color: Color = eye_options[rng.randi() % eye_options.size()]
	var hair: Color = palette.get("hair", Color(0.85, 0.78, 0.55))
	var weapon_kind: String = weapon_kinds[rng.randi() % weapon_kinds.size()]

	# Angel hovers slightly off the ground (celestials don't really touch ground)
	var hover_lift: float = h * 0.08
	clearance += hover_lift

	# ============================================================================
	# ROBE BODY — long flowing robe wrapping the body. Vertical swept shape.
	# Sections stacked along Y → _swept_body auto-builds X-Z perpendicular rings.
	# ============================================================================
	var hip_y: float = clearance + h * 0.02
	var waist_y: float = clearance + h * 0.20
	var chest_y: float = clearance + h * 0.45
	var shoulder_y: float = clearance + h * 0.65
	var robe_hem_y: float = clearance - h * 0.10            # robe flares slightly below feet
	var robe_sections: Array = [
		# Robe hem (widest at the bottom — flowing flare)
		{"center": Vector3(0, robe_hem_y, 0), "w": w * 0.55, "h": w * 0.45},
		# Just above hem
		{"center": Vector3(0, hip_y - h * 0.04, 0), "w": w * 0.42, "h": w * 0.34},
		# Waist
		{"center": Vector3(0, waist_y, 0), "w": w * 0.32, "h": w * 0.28},   # cinched
		# Chest
		{"center": Vector3(0, chest_y, 0), "w": w * 0.40, "h": w * 0.32},
		# Shoulder
		{"center": Vector3(0, shoulder_y, 0), "w": w * 0.48, "h": w * 0.34},
	]
	_swept_body(root, robe_sections, 10, robe, Color(0,0,0,0), 0.92, true)

	# GOLD TRIM — hem ring at the bottom of the robe
	for ti in range(12):
		var ang: float = TAU * float(ti) / 12.0
		var ang2: float = TAU * float(ti + 1) / 12.0
		var hem_r: float = w * 0.55
		var st_t := SurfaceTool.new()
		st_t.begin(Mesh.PRIMITIVE_TRIANGLES)
		var p0a := Vector3(cos(ang) * hem_r * 1.01, robe_hem_y + h * 0.04, sin(ang) * hem_r * 0.85)
		var p1a := Vector3(cos(ang2) * hem_r * 1.01, robe_hem_y + h * 0.04, sin(ang2) * hem_r * 0.85)
		var p0b := Vector3(cos(ang) * hem_r * 1.02, robe_hem_y - h * 0.02, sin(ang) * hem_r * 0.86)
		var p1b := Vector3(cos(ang2) * hem_r * 1.02, robe_hem_y - h * 0.02, sin(ang2) * hem_r * 0.86)
		_add_quad(st_t, p0a, p1a, p1b, p0b)
		st_t.generate_normals()
		var mi_t := MeshInstance3D.new()
		mi_t.mesh = st_t.commit()
		var mat_t := StandardMaterial3D.new()
		mat_t.albedo_color = trim
		mat_t.roughness = 0.30
		mat_t.metallic = 0.75
		mat_t.cull_mode = BaseMaterial3D.CULL_DISABLED
		mi_t.material_override = mat_t
		root.add_child(mi_t)

	# SASH — wide band across the chest (was a stick, fixed per verify-agent)
	_build_box(
		root,
		Vector3(-w * 0.42, chest_y - h * 0.02, w * 0.18),
		Vector3(w * 0.42, chest_y + h * 0.08, w * 0.24),
		trim, 0.30, 0.65
	)

	# ============================================================================
	# NECK + HEAD — bare neck rising to a serene face
	# ============================================================================
	var neck_base: Vector3 = Vector3(0, shoulder_y + h * 0.02, 0)
	var head_anchor: Vector3 = Vector3(0, shoulder_y + h * 0.20, w * 0.02)
	_build_tapered_segment(root, neck_base, w * 0.10, head_anchor + Vector3(0, -h * 0.05, 0),
		w * 0.09, skin, 0.85)

	# Cranium — rounded oval (vertical swept body). Depth bumped to head_r*1.0
	# so the face has volume for eyes/mouth to sit on rather than be flush.
	var head_r: float = w * 0.20
	var head_sections: Array = [
		{"center": Vector3(0, head_anchor.y - head_r * 0.6, w * 0.02),
		 "w": head_r * 0.65, "h": head_r * 0.65},
		{"center": Vector3(0, head_anchor.y - head_r * 0.1, w * 0.02),
		 "w": head_r, "h": head_r * 1.00},
		{"center": Vector3(0, head_anchor.y + head_r * 0.4, w * 0.02),
		 "w": head_r * 0.92, "h": head_r * 0.95},
		{"center": Vector3(0, head_anchor.y + head_r * 0.75, w * 0.02),
		 "w": head_r * 0.50, "h": head_r * 0.50},
	]
	_swept_body(root, head_sections, 10, skin, Color(0,0,0,0), 0.80, true)

	# HAIR — flowing locks (back of head + side strands)
	var hair_sections: Array = [
		{"center": Vector3(0, head_anchor.y + head_r * 0.15, -w * 0.02),
		 "w": head_r * 1.05, "h": head_r * 0.95},
		{"center": Vector3(0, head_anchor.y + head_r * 0.50, -w * 0.04),
		 "w": head_r * 0.85, "h": head_r * 0.75},
	]
	_swept_body(root, hair_sections, 8, hair, Color(0,0,0,0), 0.95, true)
	# Hair locks falling beside the face
	for side in [-1, 1]:
		var lock_top := Vector3(side * head_r * 0.85, head_anchor.y + head_r * 0.20, w * 0.04)
		var lock_bot := Vector3(side * head_r * 0.90, head_anchor.y - head_r * 0.60, w * 0.10)
		_build_tapered_segment(root, lock_top, w * 0.045, lock_bot, w * 0.030, hair, 0.95)

	# EYES — large glowing (radiant celestial gaze). face_z anchored to head
	# center + head depth so they're proud of the face surface, not flush.
	var face_z: float = head_anchor.z + head_r * 1.05
	var eye_y: float = head_anchor.y + head_r * 0.10
	for side in [-1, 1]:
		var ex: float = side * head_r * 0.30
		# Eye whites
		_build_box(
			root,
			Vector3(ex - head_r * 0.14, eye_y, face_z),
			Vector3(ex + head_r * 0.14, eye_y + head_r * 0.16, face_z + 0.006),
			Color(0.98, 0.98, 0.92), 0.30
		)
		# Glowing iris
		_build_box(
			root,
			Vector3(ex - head_r * 0.06, eye_y + head_r * 0.03, face_z + 0.005),
			Vector3(ex + head_r * 0.06, eye_y + head_r * 0.14, face_z + 0.012),
			eye_color, 0.20, 0.30
		)
	# Serene small mouth
	_build_box(
		root,
		Vector3(-head_r * 0.10, head_anchor.y - head_r * 0.20, face_z),
		Vector3(head_r * 0.10, head_anchor.y - head_r * 0.14, face_z + 0.006),
		Color(0.85, 0.55, 0.55), 0.50
	)

	# ============================================================================
	# HALO — glowing ring above the head (8-segment circle in horizontal plane)
	# ============================================================================
	var halo_y: float = head_anchor.y + head_r * 1.20
	var halo_r: float = head_r * 1.40
	for hi in range(12):
		var ang: float = TAU * float(hi) / 12.0
		var ang2: float = TAU * float(hi + 1) / 12.0
		var halo_p1 := Vector3(cos(ang) * halo_r, halo_y, sin(ang) * halo_r)
		var halo_p2 := Vector3(cos(ang2) * halo_r, halo_y, sin(ang2) * halo_r)
		_build_tapered_segment(root, halo_p1, w * 0.020, halo_p2, w * 0.020,
			halo_color, 0.10, 0.50)

	# ============================================================================
	# WINGS — HUGE feathered angel wings extending from the back. Each wing
	# is built with multiple feather rows for proper density.
	# ============================================================================
	for side in [-1, 1]:
		# Per verify-agent: previous wings were ~1.5× body wide and drooped
		# behind the back like a cape. Real angel wings raise ABOVE the
		# shoulder and span 2-3× body height. Fix: tip pushed to w*2.8,
		# arch raised above shoulder, less rearward pull.
		var wing_origin := Vector3(side * w * 0.30, shoulder_y - h * 0.05, -w * 0.10)
		var wing_tip := Vector3(side * w * 2.80, shoulder_y + h * 0.75, -w * 0.20)
		var wing_mid := Vector3(side * w * 1.60, shoulder_y + h * 0.90, -w * 0.15)
		var wing_back := Vector3(side * w * 0.55, shoulder_y + h * 0.10, -w * 0.25)
		# Main wing membrane (large triangle pair)
		var st_wing := SurfaceTool.new()
		st_wing.begin(Mesh.PRIMITIVE_TRIANGLES)
		_add_tri(st_wing, wing_origin, wing_mid, wing_tip)
		_add_tri(st_wing, wing_origin, wing_tip, wing_back)
		# Backface
		_add_tri(st_wing, wing_origin, wing_tip, wing_mid)
		_add_tri(st_wing, wing_origin, wing_back, wing_tip)
		st_wing.generate_normals()
		var mi_wing := MeshInstance3D.new()
		mi_wing.mesh = st_wing.commit()
		var mat_wing := StandardMaterial3D.new()
		mat_wing.albedo_color = wing_color
		mat_wing.roughness = 0.85
		mat_wing.cull_mode = BaseMaterial3D.CULL_DISABLED
		mi_wing.material_override = mat_wing
		root.add_child(mi_wing)
		# Primary feather row — extended to match new larger wingspan
		for fi in range(10):
			var ft: float = float(fi) / 9.0
			var feather_root := wing_origin.lerp(wing_tip, ft * 0.5)
			var feather_tip := wing_mid.lerp(wing_tip, ft).lerp(
				Vector3(side * w * 2.50, shoulder_y + h * 0.30, -w * 0.40), 0.3)
			_build_tapered_segment(root, feather_root, w * 0.045, feather_tip, w * 0.012,
				wing_dark, 0.85)
		# Secondary covert row (lighter, inner feathers)
		for fi in range(6):
			var ft: float = float(fi + 1) / 7.0
			var covert_root := wing_origin.lerp(wing_mid, ft)
			var covert_tip := wing_back.lerp(wing_mid, ft)
			_build_tapered_segment(root, covert_root, w * 0.040, covert_tip, w * 0.014,
				wing_color.lightened(0.10), 0.85)

	# ============================================================================
	# ARMS — slim humanoid arms, exposed (rolled robe sleeves)
	# ============================================================================
	for side in [-1, 1]:
		var sh := Vector3(side * w * 0.42, shoulder_y - h * 0.02, 0)
		var elbow := Vector3(side * w * 0.52, chest_y - h * 0.20, w * 0.05)
		var wrist := Vector3(side * w * 0.40, waist_y + h * 0.02, w * 0.08)
		# Robe sleeve (top half of arm)
		_build_tapered_segment(root, sh, w * 0.10, elbow, w * 0.07, robe, 0.92)
		# Exposed forearm (skin)
		_build_tapered_segment(root, elbow, w * 0.06, wrist, w * 0.055, skin, 0.85)
		# Hand
		_build_box(
			root,
			Vector3(wrist.x - w * 0.05, wrist.y - h * 0.07, wrist.z - w * 0.05),
			Vector3(wrist.x + w * 0.05, wrist.y + h * 0.02, wrist.z + w * 0.05),
			skin, 0.85
		)
		# Wrist trim band
		_build_box(
			root,
			Vector3(wrist.x - w * 0.07, wrist.y + h * 0.00, wrist.z - w * 0.06),
			Vector3(wrist.x + w * 0.07, wrist.y + h * 0.05, wrist.z + w * 0.06),
			trim, 0.30, 0.65
		)

	# ============================================================================
	# WEAPON — variant: sword / staff / spear / none (hand-of-prayer)
	# Held in RIGHT hand only (left hand is empty / open in blessing)
	# ============================================================================
	var weapon_hand := Vector3(w * 0.40, waist_y + h * 0.02, w * 0.08)
	if weapon_kind == "sword":
		# Longsword — held point up
		var sword_grip_bot := Vector3(weapon_hand.x + w * 0.04, weapon_hand.y - h * 0.04,
			weapon_hand.z + w * 0.06)
		var sword_guard := Vector3(weapon_hand.x + w * 0.04, weapon_hand.y + h * 0.08,
			weapon_hand.z + w * 0.06)
		var blade_tip := Vector3(weapon_hand.x + w * 0.04, weapon_hand.y + h * 0.80,
			weapon_hand.z + w * 0.05)
		# Grip
		_build_tapered_segment(root, sword_grip_bot, w * 0.020, sword_guard, w * 0.022,
			trim, 0.30)
		# Crossguard
		_build_box(
			root,
			Vector3(sword_guard.x - w * 0.12, sword_guard.y, sword_guard.z - 0.02),
			Vector3(sword_guard.x + w * 0.12, sword_guard.y + h * 0.04, sword_guard.z + 0.02),
			trim, 0.25, 0.70
		)
		# Pommel
		_build_box(
			root,
			Vector3(sword_grip_bot.x - w * 0.035, sword_grip_bot.y - h * 0.04, sword_grip_bot.z - 0.025),
			Vector3(sword_grip_bot.x + w * 0.035, sword_grip_bot.y, sword_grip_bot.z + 0.025),
			trim, 0.25, 0.60
		)
		# Blade
		_build_tapered_segment(root, sword_guard + Vector3(0, h * 0.04, 0), w * 0.030,
			blade_tip, w * 0.005, Color(0.95, 0.95, 0.95), 0.20, 0.65)
		# Holy glow along the blade
		_build_tapered_segment(root, sword_guard + Vector3(0, h * 0.04, 0.004), w * 0.015,
			blade_tip + Vector3(0, 0, 0.002), w * 0.002, halo_color, 0.10, 0.55)
	elif weapon_kind == "staff":
		# Tall staff with a glowing orb at the top
		var staff_bot := Vector3(weapon_hand.x + w * 0.04, 0.0, weapon_hand.z + w * 0.06)
		var staff_top := Vector3(weapon_hand.x + w * 0.04, clearance + h * 0.95, weapon_hand.z + w * 0.06)
		_build_tapered_segment(root, staff_bot, w * 0.030, staff_top, w * 0.026,
			Color(0.50, 0.35, 0.20), 0.85)
		# Orb at top
		_build_box(
			root,
			Vector3(staff_top.x - w * 0.10, staff_top.y - h * 0.05, staff_top.z - w * 0.10),
			Vector3(staff_top.x + w * 0.10, staff_top.y + h * 0.10, staff_top.z + w * 0.10),
			halo_color, 0.15, 0.40
		)
	elif weapon_kind == "spear":
		# Spear — long shaft with a glowing leaf-blade head
		var spear_bot := Vector3(weapon_hand.x + w * 0.04, 0.0, weapon_hand.z + w * 0.06)
		var spear_top := Vector3(weapon_hand.x + w * 0.04, clearance + h * 1.05, weapon_hand.z + w * 0.06)
		_build_tapered_segment(root, spear_bot, w * 0.025, spear_top, w * 0.022,
			Color(0.55, 0.38, 0.22), 0.85)
		# Leaf-blade head — flat diamond shape at top
		var blade_apex := Vector3(spear_top.x, spear_top.y + h * 0.20, spear_top.z)
		var blade_l := Vector3(spear_top.x - w * 0.06, spear_top.y + h * 0.10, spear_top.z)
		var blade_r := Vector3(spear_top.x + w * 0.06, spear_top.y + h * 0.10, spear_top.z)
		var st_sp := SurfaceTool.new()
		st_sp.begin(Mesh.PRIMITIVE_TRIANGLES)
		_add_tri(st_sp, spear_top, blade_l, blade_apex)
		_add_tri(st_sp, spear_top, blade_apex, blade_r)
		_add_tri(st_sp, spear_top, blade_apex, blade_l)
		_add_tri(st_sp, spear_top, blade_r, blade_apex)
		st_sp.generate_normals()
		var mi_sp := MeshInstance3D.new()
		mi_sp.mesh = st_sp.commit()
		var mat_sp := StandardMaterial3D.new()
		mat_sp.albedo_color = Color(0.95, 0.95, 0.95)
		mat_sp.roughness = 0.20
		mat_sp.metallic = 0.70
		mat_sp.cull_mode = BaseMaterial3D.CULL_DISABLED
		mi_sp.material_override = mat_sp
		root.add_child(mi_sp)
	# weapon_kind == "none" → no weapon, just empty hand (blessing gesture)

	# ============================================================================
	# LEGS / FEET — robe usually covers most of the leg; just show the feet
	# poking out at the bottom.
	# ============================================================================
	for side in [-1, 1]:
		var foot_x: float = side * w * 0.10
		# Bare foot box (sandals would be similar)
		_build_box(
			root,
			Vector3(foot_x - w * 0.07, 0.0, w * 0.02),
			Vector3(foot_x + w * 0.07, h * 0.05, w * 0.16),
			skin, 0.85
		)

# ============================================================================
# ANIMAL LORD (animal_lord)
# Celestial humanoid embodying a beast species — Monster Manual: Bestiary 2.
# Humanoid body + ANIMAL HEAD of a randomly chosen species, ceremonial robes,
# staff or spear, sometimes antlers / horns / mane appropriate to the head.
# ============================================================================

static func _build_animal_lord(plan: Dictionary, root: Node3D) -> void:
	var base: Dictionary = plan.get("base", {})
	var palette: Dictionary = plan.get("palette", {})
	var limbs: Dictionary = plan.get("limbs", {})
	var meta: Dictionary = plan.get("meta", {})
	var species: String = String(meta.get("species", "Animal Lord"))

	var w: float = _axis(base, "width", 0.70)
	var h: float = _axis(base, "height", 1.95)
	var d: float = _axis(base, "depth", 0.45)
	var leg_length: float = float(limbs.get("leg_length", 0.95))
	var clearance: float = leg_length

	var render_seed: int = int(meta.get("render_seed", 0))
	var rng := RandomNumberGenerator.new()
	rng.seed = render_seed if render_seed != 0 else hash(species)

	var size_jitter: float = rng.randf_range(0.92, 1.18)
	w *= size_jitter
	h *= size_jitter

	# Per-individual: which animal head + robe color + weapon
	var animal_kinds := ["stag", "wolf", "bear", "eagle", "lion", "owl", "boar", "fox"]
	var animal: String = animal_kinds[rng.randi() % animal_kinds.size()]

	var robe_options := [
		Color(0.30, 0.55, 0.32),     # forest green
		Color(0.55, 0.42, 0.25),     # earthen brown
		Color(0.85, 0.78, 0.55),     # gold-cream
		Color(0.30, 0.40, 0.55),     # twilight blue
		Color(0.65, 0.30, 0.40),     # autumn red
		Color(0.40, 0.32, 0.20),     # bark brown
		Color(0.85, 0.85, 0.80),     # spirit white
	]
	var fur_options := [
		Color(0.40, 0.32, 0.20),     # dark brown
		Color(0.62, 0.48, 0.30),     # tawny
		Color(0.32, 0.30, 0.28),     # near-black
		Color(0.85, 0.78, 0.62),     # cream
		Color(0.55, 0.42, 0.28),     # russet
		Color(0.78, 0.72, 0.58),     # golden
		Color(0.92, 0.90, 0.85),     # white
	]
	var eye_options := [
		Color(0.95, 0.85, 0.20),
		Color(0.55, 0.95, 0.55),
		Color(0.95, 0.55, 0.20),
		Color(0.55, 0.85, 1.00),
		Color(0.95, 0.95, 0.85),
	]
	var weapon_kinds := ["staff", "spear", "none"]

	var robe: Color = robe_options[rng.randi() % robe_options.size()]
	var trim: Color = Color(0.85, 0.70, 0.25)
	var skin: Color = palette.get("skin", Color(0.85, 0.72, 0.58))
	var fur: Color = fur_options[rng.randi() % fur_options.size()]
	var fur_dark: Color = fur.darkened(0.25)
	var eye_color: Color = eye_options[rng.randi() % eye_options.size()]
	var weapon_kind: String = weapon_kinds[rng.randi() % weapon_kinds.size()]

	# ============================================================================
	# HUMANOID TORSO IN A ROBE — flowing robe vertical body
	# ============================================================================
	var hip_y: float = clearance
	var waist_y: float = clearance + h * 0.20
	var chest_y: float = clearance + h * 0.45
	var shoulder_y: float = clearance + h * 0.65
	var robe_hem_y: float = clearance - h * 0.05
	var robe_sections: Array = [
		{"center": Vector3(0, robe_hem_y, 0), "w": w * 0.48, "h": w * 0.40},
		{"center": Vector3(0, hip_y - h * 0.02, 0), "w": w * 0.38, "h": w * 0.32},
		{"center": Vector3(0, waist_y, 0), "w": w * 0.34, "h": w * 0.28},
		{"center": Vector3(0, chest_y, 0), "w": w * 0.42, "h": w * 0.32},
		{"center": Vector3(0, shoulder_y, 0), "w": w * 0.48, "h": w * 0.34},
	]
	_swept_body(root, robe_sections, 10, robe, Color(0,0,0,0), 0.90, true)
	# Gold belt at the waist — sized to hug the robe waist section (was too
	# wide + too deep, clipped through the robe per verify-agent).
	_build_box(
		root,
		Vector3(-w * 0.38, waist_y - h * 0.015, -w * 0.20),
		Vector3(w * 0.38, waist_y + h * 0.03, w * 0.20),
		trim, 0.30, 0.65
	)

	# ============================================================================
	# NECK + ANIMAL HEAD — head_anchor is the base of the animal head
	# ============================================================================
	var neck_base := Vector3(0, shoulder_y + h * 0.02, 0)
	var head_anchor := Vector3(0, shoulder_y + h * 0.25, w * 0.04)
	_build_tapered_segment(root, neck_base, w * 0.13, head_anchor + Vector3(0, -h * 0.10, 0),
		w * 0.12, fur, 0.92)

	# Branch on animal kind — each builds a distinct head silhouette AND
	# records its own eye anchor so eyes land properly on each variant's face.
	var head_r: float = w * 0.22
	var eye_front_z: float = head_anchor.z + head_r * 0.42   # safe default
	var eye_y_offset: float = h * 0.05
	if animal == "stag":
		# Long narrow head with antlers
		_build_box(
			root,
			Vector3(-head_r * 0.6, head_anchor.y - h * 0.10, head_anchor.z - head_r * 0.50),
			Vector3(head_r * 0.6, head_anchor.y + h * 0.10, head_anchor.z + head_r * 0.80),
			fur, 0.90
		)
		# Snout
		_build_box(
			root,
			Vector3(-head_r * 0.30, head_anchor.y - h * 0.16, head_anchor.z + head_r * 0.70),
			Vector3(head_r * 0.30, head_anchor.y + h * 0.04, head_anchor.z + head_r * 1.10),
			fur_dark, 0.90
		)
		# Antlers — two branching forks per side
		for side in [-1, 1]:
			var antler_base := Vector3(side * head_r * 0.40, head_anchor.y + h * 0.10,
				head_anchor.z + head_r * 0.10)
			var antler_mid := Vector3(side * head_r * 0.80, head_anchor.y + h * 0.45,
				head_anchor.z - head_r * 0.20)
			var antler_tip := Vector3(side * head_r * 1.10, head_anchor.y + h * 0.65,
				head_anchor.z - head_r * 0.40)
			_build_tapered_segment(root, antler_base, w * 0.030, antler_mid, w * 0.022,
				Color(0.78, 0.68, 0.50), 0.50)
			_build_tapered_segment(root, antler_mid, w * 0.022, antler_tip, w * 0.008,
				Color(0.78, 0.68, 0.50), 0.50)
			# Side fork
			var fork_tip := Vector3(side * head_r * 1.30, head_anchor.y + h * 0.40,
				head_anchor.z - head_r * 0.55)
			_build_tapered_segment(root, antler_mid, w * 0.015, fork_tip, w * 0.005,
				Color(0.78, 0.68, 0.50), 0.50)
	elif animal == "wolf":
		# Wolf snout — pointed
		_build_box(
			root,
			Vector3(-head_r * 0.7, head_anchor.y - h * 0.05, head_anchor.z - head_r * 0.40),
			Vector3(head_r * 0.7, head_anchor.y + h * 0.15, head_anchor.z + head_r * 0.50),
			fur, 0.90
		)
		_build_box(
			root,
			Vector3(-head_r * 0.30, head_anchor.y - h * 0.12, head_anchor.z + head_r * 0.45),
			Vector3(head_r * 0.30, head_anchor.y + h * 0.05, head_anchor.z + head_r * 0.95),
			fur_dark, 0.90
		)
		# Triangle ears
		for side in [-1, 1]:
			var ear_base := Vector3(side * head_r * 0.55, head_anchor.y + h * 0.18, head_anchor.z + 0.0)
			var ear_tip := Vector3(side * head_r * 0.70, head_anchor.y + h * 0.40, head_anchor.z - head_r * 0.05)
			_build_tapered_segment(root, ear_base, w * 0.040, ear_tip, w * 0.008, fur, 0.90)
	elif animal == "bear":
		# Bear — round broad head with small ears
		_build_box(
			root,
			Vector3(-head_r * 0.9, head_anchor.y - h * 0.05, head_anchor.z - head_r * 0.45),
			Vector3(head_r * 0.9, head_anchor.y + h * 0.20, head_anchor.z + head_r * 0.55),
			fur, 0.95
		)
		# Stub snout
		_build_box(
			root,
			Vector3(-head_r * 0.40, head_anchor.y - h * 0.10, head_anchor.z + head_r * 0.50),
			Vector3(head_r * 0.40, head_anchor.y + h * 0.05, head_anchor.z + head_r * 0.80),
			fur_dark, 0.90
		)
		# Small round ears
		for side in [-1, 1]:
			_build_box(
				root,
				Vector3(side * head_r * 0.65 - w * 0.06, head_anchor.y + h * 0.18, -w * 0.06),
				Vector3(side * head_r * 0.65 + w * 0.06, head_anchor.y + h * 0.30, w * 0.06),
				fur, 0.95
			)
	elif animal == "eagle":
		# Eagle — round head with sharp beak
		_build_box(
			root,
			Vector3(-head_r * 0.6, head_anchor.y - h * 0.05, head_anchor.z - head_r * 0.40),
			Vector3(head_r * 0.6, head_anchor.y + h * 0.20, head_anchor.z + head_r * 0.40),
			Color(0.92, 0.88, 0.75), 0.90  # white eagle head
		)
		# Hooked beak
		var beak_base := Vector3(0, head_anchor.y + h * 0.06, head_anchor.z + head_r * 0.40)
		var beak_mid := Vector3(0, head_anchor.y - h * 0.02, head_anchor.z + head_r * 0.65)
		var beak_tip := Vector3(0, head_anchor.y - h * 0.10, head_anchor.z + head_r * 0.75)
		_build_tapered_segment(root, beak_base, head_r * 0.18, beak_mid, head_r * 0.12,
			Color(0.95, 0.78, 0.20), 0.40)
		_build_tapered_segment(root, beak_mid, head_r * 0.12, beak_tip, head_r * 0.04,
			Color(0.95, 0.78, 0.20), 0.40)
	elif animal == "lion":
		# Lion — round head with full mane
		_build_box(
			root,
			Vector3(-head_r * 0.8, head_anchor.y - h * 0.05, head_anchor.z - head_r * 0.40),
			Vector3(head_r * 0.8, head_anchor.y + h * 0.18, head_anchor.z + head_r * 0.55),
			Color(0.85, 0.65, 0.35), 0.90
		)
		# Snout
		_build_box(
			root,
			Vector3(-head_r * 0.35, head_anchor.y - h * 0.12, head_anchor.z + head_r * 0.50),
			Vector3(head_r * 0.35, head_anchor.y + h * 0.05, head_anchor.z + head_r * 0.85),
			Color(0.65, 0.45, 0.25), 0.90
		)
		# Mane — fluffy ring of clumps
		for mi in range(10):
			var mang: float = TAU * float(mi) / 10.0
			var mr: float = head_r * 1.10
			var clump_pos := Vector3(cos(mang) * mr, head_anchor.y + h * 0.05,
				head_anchor.z + sin(mang) * mr * 0.50)
			var clump_r: float = w * rng.randf_range(0.06, 0.10)
			_build_box(
				root,
				clump_pos - Vector3(clump_r, clump_r, clump_r),
				clump_pos + Vector3(clump_r, clump_r, clump_r),
				Color(0.55, 0.38, 0.20), 0.95
			)
	elif animal == "owl":
		# Owl — flat round face with big circular eyes already, small beak
		_build_box(
			root,
			Vector3(-head_r * 0.9, head_anchor.y - h * 0.05, head_anchor.z - head_r * 0.30),
			Vector3(head_r * 0.9, head_anchor.y + h * 0.22, head_anchor.z + head_r * 0.40),
			Color(0.55, 0.42, 0.28), 0.95
		)
		# Facial disk markings
		for side in [-1, 1]:
			_build_box(
				root,
				Vector3(side * head_r * 0.40 - head_r * 0.30, head_anchor.y + h * 0.00,
					head_anchor.z + head_r * 0.38),
				Vector3(side * head_r * 0.40 + head_r * 0.30, head_anchor.y + h * 0.18,
					head_anchor.z + head_r * 0.45),
				Color(0.85, 0.78, 0.65), 0.95
			)
		# Tiny hooked beak
		_build_box(
			root,
			Vector3(-head_r * 0.08, head_anchor.y + h * 0.02, head_anchor.z + head_r * 0.40),
			Vector3(head_r * 0.08, head_anchor.y + h * 0.10, head_anchor.z + head_r * 0.55),
			Color(0.85, 0.78, 0.20), 0.40
		)
		# Tufts (ear-like) on top
		for side in [-1, 1]:
			_build_tapered_segment(root,
				Vector3(side * head_r * 0.50, head_anchor.y + h * 0.20, head_anchor.z),
				w * 0.020,
				Vector3(side * head_r * 0.62, head_anchor.y + h * 0.40, head_anchor.z - 0.02),
				w * 0.004, Color(0.40, 0.30, 0.20), 0.95)
	elif animal == "boar":
		# Boar — broad head with prominent tusks
		_build_box(
			root,
			Vector3(-head_r * 0.7, head_anchor.y - h * 0.05, head_anchor.z - head_r * 0.40),
			Vector3(head_r * 0.7, head_anchor.y + h * 0.15, head_anchor.z + head_r * 0.40),
			Color(0.45, 0.35, 0.25), 0.90
		)
		# Snout
		_build_box(
			root,
			Vector3(-head_r * 0.35, head_anchor.y - h * 0.12, head_anchor.z + head_r * 0.35),
			Vector3(head_r * 0.35, head_anchor.y + h * 0.02, head_anchor.z + head_r * 0.80),
			Color(0.30, 0.22, 0.15), 0.90
		)
		# Tusks
		for side in [-1, 1]:
			var tusk_root := Vector3(side * head_r * 0.25, head_anchor.y - h * 0.08,
				head_anchor.z + head_r * 0.78)
			var tusk_tip := Vector3(side * head_r * 0.42, head_anchor.y + h * 0.06,
				head_anchor.z + head_r * 0.85)
			_build_tapered_segment(root, tusk_root, w * 0.030, tusk_tip, w * 0.005,
				Color(0.92, 0.88, 0.72), 0.40)
	else:    # "fox"
		# Fox — small narrow head with big triangle ears
		_build_box(
			root,
			Vector3(-head_r * 0.55, head_anchor.y - h * 0.05, head_anchor.z - head_r * 0.30),
			Vector3(head_r * 0.55, head_anchor.y + h * 0.18, head_anchor.z + head_r * 0.45),
			Color(0.78, 0.45, 0.25), 0.92
		)
		# Pointed snout
		_build_box(
			root,
			Vector3(-head_r * 0.25, head_anchor.y - h * 0.12, head_anchor.z + head_r * 0.42),
			Vector3(head_r * 0.25, head_anchor.y + h * 0.02, head_anchor.z + head_r * 0.95),
			Color(0.85, 0.55, 0.30), 0.92
		)
		# Large triangle ears
		for side in [-1, 1]:
			var ear_base := Vector3(side * head_r * 0.45, head_anchor.y + h * 0.15, head_anchor.z)
			var ear_tip := Vector3(side * head_r * 0.60, head_anchor.y + h * 0.55, head_anchor.z - head_r * 0.05)
			_build_tapered_segment(root, ear_base, w * 0.045, ear_tip, w * 0.005,
				Color(0.78, 0.45, 0.25), 0.92)

	# EYES — glowing, placed per-animal. Each animal-head branch above has a
	# different face-front Z, so eye position is computed by animal kind here
	# (was using a fixed head_r * 0.55 which put stag eyes in front of empty
	# space and buried owl / fox eyes behind their snouts).
	match animal:
		"stag":
			eye_front_z = head_anchor.z + head_r * 0.55
			eye_y_offset = h * 0.06
		"wolf":
			eye_front_z = head_anchor.z + head_r * 0.50
			eye_y_offset = h * 0.09
		"bear":
			eye_front_z = head_anchor.z + head_r * 0.50
			eye_y_offset = h * 0.10
		"eagle":
			eye_front_z = head_anchor.z + head_r * 0.40
			eye_y_offset = h * 0.10
		"lion":
			eye_front_z = head_anchor.z + head_r * 0.50
			eye_y_offset = h * 0.08
		"owl":
			# Owl eyes are big and forward-facing — anchor to facial disk position
			eye_front_z = head_anchor.z + head_r * 0.46
			eye_y_offset = h * 0.08
		"boar":
			eye_front_z = head_anchor.z + head_r * 0.40
			eye_y_offset = h * 0.06
		_:    # fox
			eye_front_z = head_anchor.z + head_r * 0.42
			eye_y_offset = h * 0.10
	for side in [-1, 1]:
		var ex: float = side * head_r * 0.30
		var ey: float = head_anchor.y + eye_y_offset
		_build_box(
			root,
			Vector3(ex - head_r * 0.10, ey, eye_front_z),
			Vector3(ex + head_r * 0.10, ey + head_r * 0.16, eye_front_z + 0.008),
			eye_color, 0.20, 0.30
		)

	# ============================================================================
	# ARMS — robe sleeves + bare forearms
	# ============================================================================
	for side in [-1, 1]:
		var sh := Vector3(side * w * 0.42, shoulder_y - h * 0.02, 0)
		var elbow := Vector3(side * w * 0.50, chest_y - h * 0.20, w * 0.05)
		var wrist := Vector3(side * w * 0.40, waist_y - h * 0.05, w * 0.08)
		_build_tapered_segment(root, sh, w * 0.10, elbow, w * 0.07, robe, 0.90)
		_build_tapered_segment(root, elbow, w * 0.06, wrist, w * 0.055, fur, 0.92)
		# Hand
		_build_box(
			root,
			Vector3(wrist.x - w * 0.05, wrist.y - h * 0.07, wrist.z - w * 0.05),
			Vector3(wrist.x + w * 0.05, wrist.y + h * 0.02, wrist.z + w * 0.05),
			fur_dark, 0.85
		)

	# ============================================================================
	# WEAPON (in the right hand) — staff / spear / none. Weapon now centered
	# IN the hand (was offset to outer edge) and bottom clamped to just below
	# the robe hem (was at y=0, piercing the floor through the robe).
	# ============================================================================
	var weapon_hand := Vector3(w * 0.40, waist_y - h * 0.05, w * 0.08)
	var weapon_bot_y: float = robe_hem_y - h * 0.05      # exit cleanly below the hem
	if weapon_kind == "staff":
		var staff_bot := Vector3(weapon_hand.x, weapon_bot_y, weapon_hand.z + w * 0.06)
		var staff_top := Vector3(weapon_hand.x, clearance + h * 1.10, weapon_hand.z + w * 0.06)
		_build_tapered_segment(root, staff_bot, w * 0.028, staff_top, w * 0.024,
			Color(0.45, 0.30, 0.18), 0.85)
		# Crystal/leaf ornament at the top
		_build_box(
			root,
			Vector3(staff_top.x - w * 0.10, staff_top.y - h * 0.04, staff_top.z - w * 0.10),
			Vector3(staff_top.x + w * 0.10, staff_top.y + h * 0.12, staff_top.z + w * 0.10),
			eye_color, 0.20, 0.40
		)
	elif weapon_kind == "spear":
		var spear_bot := Vector3(weapon_hand.x, weapon_bot_y, weapon_hand.z + w * 0.06)
		var spear_top := Vector3(weapon_hand.x, clearance + h * 1.05, weapon_hand.z + w * 0.06)
		_build_tapered_segment(root, spear_bot, w * 0.022, spear_top, w * 0.020,
			Color(0.55, 0.38, 0.22), 0.85)
		# Leaf-blade head
		var blade_l := Vector3(spear_top.x - w * 0.06, spear_top.y + h * 0.06, spear_top.z)
		var blade_r := Vector3(spear_top.x + w * 0.06, spear_top.y + h * 0.06, spear_top.z)
		var blade_tip := Vector3(spear_top.x, spear_top.y + h * 0.20, spear_top.z)
		var st_sp := SurfaceTool.new()
		st_sp.begin(Mesh.PRIMITIVE_TRIANGLES)
		_add_tri(st_sp, spear_top, blade_l, blade_tip)
		_add_tri(st_sp, spear_top, blade_tip, blade_r)
		_add_tri(st_sp, spear_top, blade_tip, blade_l)
		_add_tri(st_sp, spear_top, blade_r, blade_tip)
		st_sp.generate_normals()
		var mi_sp := MeshInstance3D.new()
		mi_sp.mesh = st_sp.commit()
		var mat_sp := StandardMaterial3D.new()
		mat_sp.albedo_color = Color(0.92, 0.92, 0.92)
		mat_sp.roughness = 0.20
		mat_sp.metallic = 0.70
		mat_sp.cull_mode = BaseMaterial3D.CULL_DISABLED
		mi_sp.material_override = mat_sp
		root.add_child(mi_sp)

	# ============================================================================
	# FEET — small fur-pad feet poking out from the robe hem
	# ============================================================================
	for side in [-1, 1]:
		var foot_x: float = side * w * 0.10
		_build_box(
			root,
			Vector3(foot_x - w * 0.07, 0.0, w * 0.02),
			Vector3(foot_x + w * 0.07, h * 0.05, w * 0.18),
			fur_dark, 0.90
		)
	# Use skin somewhere to silence unused-warning
	var _unused_skin := skin

# ============================================================================
# ANGLER FISH (angler_fish)
# Deep-sea predator (D&D Monster Manual / real biology). Iconic features:
#   - BULBOUS rounded body (almost spherical)
#   - HUGE LOWER JAW with rows of long needle teeth
#   - BIOLUMINESCENT LURE — glowing bulb on a thin "esca" rod from forehead
#   - Tiny pectoral fins + small dorsal/anal fins
#   - Tail fin at rear
#   - Dark mottled deep-sea coloring (purple-black / black / blood red)
#   - Tiny dark eyes (sees by lure-glow, not by light)
# ============================================================================

static func _build_angler_fish(plan: Dictionary, root: Node3D) -> void:
	var base: Dictionary = plan.get("base", {})
	var palette: Dictionary = plan.get("palette", {})
	var limbs: Dictionary = plan.get("limbs", {})
	var meta: Dictionary = plan.get("meta", {})
	var species: String = String(meta.get("species", "Angler Fish"))

	# Bulbous proportions — width ≈ depth (almost round)
	var w: float = _axis(base, "width", 0.95)
	var h: float = _axis(base, "height", 0.85)
	var d: float = _axis(base, "depth", 1.20)
	var _ll: float = float(limbs.get("leg_length", 0.0))

	# Angler hovers (it's a fish — no ground contact)
	var hover: float = h * 0.35
	var body_y: float = hover

	var render_seed: int = int(meta.get("render_seed", 0))
	var rng := RandomNumberGenerator.new()
	rng.seed = render_seed if render_seed != 0 else hash(species)

	# Per-individual variation
	var size_jitter: float = rng.randf_range(0.88, 1.20)
	var tooth_count: int = rng.randi_range(10, 16)
	var lure_height_jitter: float = rng.randf_range(0.80, 1.30)
	w *= size_jitter
	h *= size_jitter
	d *= size_jitter

	# Color palette — deep-sea predator tones
	var body_options := [
		Color(0.06, 0.04, 0.10),     # near-black abyssal
		Color(0.15, 0.10, 0.22),     # deep purple
		Color(0.32, 0.06, 0.10),     # blood red
		Color(0.10, 0.18, 0.22),     # dark teal
		Color(0.20, 0.22, 0.18),     # swamp olive
		Color(0.22, 0.08, 0.20),     # bruise purple-black
		Color(0.18, 0.18, 0.22),     # storm grey-black
	]
	var lure_glow_options := [
		Color(0.55, 0.95, 1.00),     # bioluminescent cyan (iconic)
		Color(0.95, 0.85, 0.30),     # gold
		Color(0.55, 0.95, 0.55),     # toxic green
		Color(0.95, 0.55, 0.55),     # blood red
		Color(0.85, 0.55, 0.95),     # purple
		Color(0.95, 0.95, 0.85),     # white
	]
	var primary: Color = body_options[rng.randi() % body_options.size()]
	var belly: Color = primary.lightened(0.25)
	var dark: Color = primary.darkened(0.40)
	var tooth_color := Color(0.92, 0.88, 0.75)
	var lure_color: Color = lure_glow_options[rng.randi() % lure_glow_options.size()]
	var eye_color: Color = palette.get("eye", Color(0.30, 0.20, 0.10))   # tiny dark beady eyes

	# ============================================================================
	# BULBOUS BODY — round-ish body, slightly elongated front-to-back.
	# 6 sections forming a teardrop with the WIDE end at the front (head) and
	# narrowing toward the tail.
	# ============================================================================
	var body_sections: Array = [
		# Back-most tail attach (smallest)
		{"center": Vector3(0, body_y, -d * 0.50), "w": w * 0.12, "h": h * 0.14},
		{"center": Vector3(0, body_y, -d * 0.30), "w": w * 0.30, "h": h * 0.34},
		{"center": Vector3(0, body_y, -d * 0.10), "w": w * 0.46, "h": h * 0.50},
		{"center": Vector3(0, body_y, d * 0.10),  "w": w * 0.52, "h": h * 0.56},   # widest mid
		{"center": Vector3(0, body_y + h * 0.02, d * 0.25), "w": w * 0.52, "h": h * 0.55},  # shoulders / behind head
		{"center": Vector3(0, body_y + h * 0.05, d * 0.40), "w": w * 0.45, "h": h * 0.50},  # forehead area
	]
	_swept_body(root, body_sections, 12, primary, belly, 0.40, true)

	# ============================================================================
	# UPPER JAW + MASSIVE LOWER JAW — yawning gape per verify-agent.
	# Upper jaw top stays around body_y + h*0.10; lower jaw drops with
	# h*0.08 GAP so the mouth reads as open with teeth visible inside.
	# Lower jaw protrudes farther forward than upper for the underbite look.
	# ============================================================================
	var upper_jaw_z: float = d * 0.50
	_build_box(
		root,
		Vector3(-w * 0.32, body_y + h * 0.00, d * 0.36),
		Vector3(w * 0.32, body_y + h * 0.10, upper_jaw_z),
		primary.darkened(0.10), 0.50
	)
	# LOWER JAW — protrudes forward (under-bite) and drops down to create the
	# yawning gape between the jaws.
	var lower_jaw_back_z: float = d * 0.36
	var lower_jaw_front_z: float = d * 0.70
	_build_box(
		root,
		Vector3(-w * 0.34, body_y - h * 0.32, lower_jaw_back_z),
		Vector3(w * 0.34, body_y - h * 0.08, lower_jaw_front_z),
		dark, 0.50
	)
	# Mouth interior (dark cave between upper-jaw bottom and lower-jaw top —
	# the YAWNING gape with the dark throat visible inside)
	_build_box(
		root,
		Vector3(-w * 0.26, body_y - h * 0.10, d * 0.40),
		Vector3(w * 0.26, body_y + h * 0.00, d * 0.60),
		Color(0.05, 0.02, 0.05), 0.30
	)

	# ============================================================================
	# NEEDLE TEETH — long thin teeth on BOTH jaws, irregular sizes.
	# Upper teeth point DOWN, lower teeth point UP — interlocking.
	# ============================================================================
	# Upper tooth row
	for ti in range(tooth_count):
		var tt: float = float(ti) / float(tooth_count - 1)
		var tx: float = lerpf(-w * 0.28, w * 0.28, tt) + rng.randf_range(-w * 0.01, w * 0.01)
		var tz: float = lerpf(d * 0.46, upper_jaw_z - 0.02, rng.randf_range(0.30, 0.70))
		var tooth_h: float = h * rng.randf_range(0.10, 0.20)
		var tooth_root := Vector3(tx, body_y + h * 0.05, tz)
		var tooth_tip := Vector3(tx + rng.randf_range(-w * 0.02, w * 0.02),
			body_y - tooth_h, tz + rng.randf_range(-0.01, 0.01))
		_build_tapered_segment(root, tooth_root, w * 0.020, tooth_tip, w * 0.003,
			tooth_color, 0.40)
	# Lower tooth row
	for ti in range(tooth_count):
		var tt: float = float(ti) / float(tooth_count - 1)
		var tx: float = lerpf(-w * 0.28, w * 0.28, tt) + rng.randf_range(-w * 0.01, w * 0.01)
		var tz: float = lerpf(lower_jaw_back_z + 0.02, lower_jaw_front_z - 0.02,
			rng.randf_range(0.30, 0.70))
		var tooth_h: float = h * rng.randf_range(0.10, 0.20)
		var tooth_root := Vector3(tx, body_y - h * 0.05, tz)
		var tooth_tip := Vector3(tx + rng.randf_range(-w * 0.02, w * 0.02),
			body_y + tooth_h * 0.5, tz + rng.randf_range(-0.01, 0.01))
		_build_tapered_segment(root, tooth_root, w * 0.020, tooth_tip, w * 0.003,
			tooth_color, 0.40)

	# ============================================================================
	# BIOLUMINESCENT LURE — the signature angler fish feature. Thin "esca" rod
	# rises from the FOREHEAD (top of body, just behind upper jaw) with a
	# glowing bulb at the tip. Slight droop forward.
	# ============================================================================
	# Lure now dangles FORWARD past the snout (was straight up) so the bulb
	# hangs in front of the mouth like real anglers use it to lure prey in.
	var esca_base := Vector3(0, body_y + h * 0.35, d * 0.35)
	var esca_mid := Vector3(0, body_y + h * (0.75 * lure_height_jitter), d * 0.55)
	var esca_tip := Vector3(0, body_y + h * (0.60 * lure_height_jitter), d * 0.85)
	# Rod
	_build_tapered_segment(root, esca_base, w * 0.018, esca_mid, w * 0.012,
		dark, 0.85)
	_build_tapered_segment(root, esca_mid, w * 0.012, esca_tip, w * 0.008,
		dark, 0.85)
	# Glowing BULB at the tip — emissive sphere-ish
	var bulb_r: float = w * 0.10
	var st_bulb := SurfaceTool.new()
	st_bulb.begin(Mesh.PRIMITIVE_TRIANGLES)
	# Build as a 10-vert tri-fan dome
	var bulb_n: int = 10
	var bulb_verts: Array = []
	for bi in range(bulb_n):
		var ang: float = TAU * float(bi) / float(bulb_n)
		bulb_verts.append(Vector3(
			esca_tip.x + cos(ang) * bulb_r,
			esca_tip.y + h * 0.06,
			esca_tip.z + sin(ang) * bulb_r
		))
	# Top point
	var bulb_top := Vector3(esca_tip.x, esca_tip.y + h * 0.14, esca_tip.z)
	for bi in range(bulb_n):
		var bk: int = (bi + 1) % bulb_n
		_add_tri(st_bulb, bulb_verts[bi], bulb_verts[bk], bulb_top)
	# Bottom point (under the bulb)
	var bulb_bot := Vector3(esca_tip.x, esca_tip.y, esca_tip.z)
	for bi in range(bulb_n):
		var bk: int = (bi + 1) % bulb_n
		_add_tri(st_bulb, bulb_verts[bk], bulb_verts[bi], bulb_bot)
	st_bulb.generate_normals()
	var mi_bulb := MeshInstance3D.new()
	mi_bulb.mesh = st_bulb.commit()
	var mat_bulb := StandardMaterial3D.new()
	mat_bulb.albedo_color = lure_color
	mat_bulb.emission_enabled = true
	mat_bulb.emission = lure_color
	mat_bulb.emission_energy_multiplier = 1.8
	mat_bulb.roughness = 0.15
	mat_bulb.metallic = 0.30
	mat_bulb.cull_mode = BaseMaterial3D.CULL_DISABLED
	mi_bulb.material_override = mat_bulb
	root.add_child(mi_bulb)

	# ============================================================================
	# EYES — small dark beady (angler sees by its lure, not by light)
	# ============================================================================
	for side in [-1, 1]:
		_build_box(
			root,
			Vector3(side * w * 0.28, body_y + h * 0.15, d * 0.40),
			Vector3(side * w * 0.36, body_y + h * 0.25, d * 0.46),
			eye_color, 0.40
		)

	# ============================================================================
	# FINS — small pectoral fins on the sides, dorsal fin, anal fin
	# ============================================================================
	# Pectoral fins (sides, mid-body) — smaller per verify-agent
	for side in [-1, 1]:
		var fin_root := Vector3(side * w * 0.42, body_y - h * 0.05, d * 0.05)
		var fin_tip_top := Vector3(side * w * 0.55, body_y + h * 0.08, -d * 0.05)
		var fin_tip_bot := Vector3(side * w * 0.52, body_y - h * 0.15, -d * 0.05)
		var st_fin := SurfaceTool.new()
		st_fin.begin(Mesh.PRIMITIVE_TRIANGLES)
		_add_tri(st_fin, fin_root, fin_tip_top, fin_tip_bot)
		_add_tri(st_fin, fin_root, fin_tip_bot, fin_tip_top)   # backface
		st_fin.generate_normals()
		var mi_fin := MeshInstance3D.new()
		mi_fin.mesh = st_fin.commit()
		var mat_fin := StandardMaterial3D.new()
		mat_fin.albedo_color = dark
		mat_fin.roughness = 0.40
		mat_fin.cull_mode = BaseMaterial3D.CULL_DISABLED
		mi_fin.material_override = mat_fin
		root.add_child(mi_fin)

	# Dorsal fin — moved forward (immediately behind the illicium/esca, where
	# real anglers' second-dorsal-fin sits). Was too far back over the tail.
	var dorsal_root_l := Vector3(-0.005, body_y + h * 0.40, d * 0.05)
	var dorsal_root_r := Vector3(0.005, body_y + h * 0.40, d * 0.05)
	var dorsal_tip := Vector3(0, body_y + h * 0.70, -d * 0.05)
	var dorsal_back := Vector3(0, body_y + h * 0.35, -d * 0.15)
	var st_dorsal := SurfaceTool.new()
	st_dorsal.begin(Mesh.PRIMITIVE_TRIANGLES)
	_add_tri(st_dorsal, dorsal_root_l, dorsal_tip, dorsal_back)
	_add_tri(st_dorsal, dorsal_root_r, dorsal_back, dorsal_tip)
	st_dorsal.generate_normals()
	var mi_dorsal := MeshInstance3D.new()
	mi_dorsal.mesh = st_dorsal.commit()
	var mat_dorsal := StandardMaterial3D.new()
	mat_dorsal.albedo_color = dark
	mat_dorsal.roughness = 0.40
	mat_dorsal.cull_mode = BaseMaterial3D.CULL_DISABLED
	mi_dorsal.material_override = mat_dorsal
	root.add_child(mi_dorsal)

	# Anal fin (bottom of body, mid)
	var anal_root_l := Vector3(-0.005, body_y - h * 0.40, -d * 0.05)
	var anal_root_r := Vector3(0.005, body_y - h * 0.40, -d * 0.05)
	var anal_tip := Vector3(0, body_y - h * 0.65, -d * 0.12)
	var anal_back := Vector3(0, body_y - h * 0.35, -d * 0.20)
	var st_anal := SurfaceTool.new()
	st_anal.begin(Mesh.PRIMITIVE_TRIANGLES)
	_add_tri(st_anal, anal_root_l, anal_back, anal_tip)
	_add_tri(st_anal, anal_root_r, anal_tip, anal_back)
	st_anal.generate_normals()
	var mi_anal := MeshInstance3D.new()
	mi_anal.mesh = st_anal.commit()
	mi_anal.material_override = mat_dorsal     # share material
	root.add_child(mi_anal)

	# ============================================================================
	# TAIL FIN — vertical fan at the rear
	# ============================================================================
	var tail_pivot := Vector3(0, body_y, -d * 0.50)
	var tail_top := Vector3(0, body_y + h * 0.45, -d * 0.70)
	var tail_bot := Vector3(0, body_y - h * 0.45, -d * 0.70)
	var tail_back := Vector3(0, body_y, -d * 0.78)
	var st_tail := SurfaceTool.new()
	st_tail.begin(Mesh.PRIMITIVE_TRIANGLES)
	_add_tri(st_tail, tail_pivot + Vector3(-0.005, 0, 0), tail_top, tail_back)
	_add_tri(st_tail, tail_pivot + Vector3(0.005, 0, 0), tail_back, tail_top)
	_add_tri(st_tail, tail_pivot + Vector3(-0.005, 0, 0), tail_back, tail_bot)
	_add_tri(st_tail, tail_pivot + Vector3(0.005, 0, 0), tail_bot, tail_back)
	st_tail.generate_normals()
	var mi_tail := MeshInstance3D.new()
	mi_tail.mesh = st_tail.commit()
	mi_tail.material_override = mat_dorsal
	root.add_child(mi_tail)

	# ============================================================================
	# SKIN BUMPS — small irregular nodules on the body for that deep-sea
	# fish texture
	# ============================================================================
	var bump_count: int = rng.randi_range(4, 10)
	for _bi in range(bump_count):
		var b_ang: float = rng.randf_range(0.0, TAU)
		var b_t: float = rng.randf_range(-d * 0.30, d * 0.30)
		var b_r: float = w * rng.randf_range(0.30, 0.50)
		var b_pos := Vector3(cos(b_ang) * b_r, body_y + sin(b_ang) * h * 0.45, b_t)
		var b_size: float = w * rng.randf_range(0.020, 0.045)
		_build_box(
			root,
			b_pos - Vector3(b_size, b_size, b_size),
			b_pos + Vector3(b_size, b_size, b_size),
			dark, 0.80
		)

# ============================================================================
# ANIMATED ARMOR (animated_armor)
# Empty enchanted suit of plate armor walking on its own. Monster Manual.
#   - Full knight silhouette but HOLLOW inside (no body)
#   - Closed visor helmet (visor slit shows dark void or faint glow)
#   - Chest cuirass + pauldrons + gauntlets + greaves + boots
#   - Often holds a sword/shield/axe
#   - Faint magical aura, sometimes glowing seams or runes
#   - Can be polished / tarnished / rusty / battle-damaged
# ============================================================================

static func _build_animated_armor(plan: Dictionary, root: Node3D) -> void:
	var base: Dictionary = plan.get("base", {})
	var palette: Dictionary = plan.get("palette", {})
	var limbs: Dictionary = plan.get("limbs", {})
	var meta: Dictionary = plan.get("meta", {})
	var species: String = String(meta.get("species", "Animated Armor"))

	var w: float = _axis(base, "width", 0.60)
	var h: float = _axis(base, "height", 1.55)
	var d: float = _axis(base, "depth", 0.40)
	var leg_length: float = float(limbs.get("leg_length", 0.72))
	var clearance: float = leg_length

	var render_seed: int = int(meta.get("render_seed", 0))
	var rng := RandomNumberGenerator.new()
	rng.seed = render_seed if render_seed != 0 else hash(species)

	var size_jitter: float = rng.randf_range(0.92, 1.15)
	w *= size_jitter
	h *= size_jitter

	# Armor metal palette
	var armor_options := [
		Color(0.72, 0.78, 0.85),     # polished silver steel
		Color(0.65, 0.50, 0.32),     # bronze
		Color(0.85, 0.72, 0.30),     # gold
		Color(0.30, 0.32, 0.38),     # dark steel
		Color(0.55, 0.50, 0.45),     # tarnished iron
		Color(0.45, 0.30, 0.18),     # rusty
		Color(0.85, 0.85, 0.92),     # pearl white
		Color(0.22, 0.20, 0.22),     # blackened steel
	]
	var glow_options := [
		Color(0.40, 0.85, 1.00),     # ghostly cyan
		Color(0.95, 0.55, 1.00),     # arcane violet
		Color(0.55, 0.95, 0.55),     # necromantic green
		Color(0.95, 0.85, 0.30),     # holy gold
		Color(1.00, 0.40, 0.30),     # infernal red
	]
	var weapon_kinds := ["sword", "axe", "shield_sword", "halberd", "none"]
	var armor: Color = armor_options[rng.randi() % armor_options.size()]
	var armor_dark: Color = armor.darkened(0.30)
	var armor_trim: Color = armor.lightened(0.15)
	var glow: Color = glow_options[rng.randi() % glow_options.size()]
	var weapon_kind: String = weapon_kinds[rng.randi() % weapon_kinds.size()]
	var has_damage: bool = rng.randf() > 0.55       # ~45% have visible dents
	var _eye_palette: Color = palette.get("eye", glow)

	# ============================================================================
	# CHEST CUIRASS — broad V-shape (wider at shoulders, narrower at waist)
	# ============================================================================
	var hip_y: float = clearance + h * 0.05
	var waist_y: float = clearance + h * 0.30
	var chest_y: float = clearance + h * 0.50
	var shoulder_y: float = clearance + h * 0.65
	_build_box(
		root,
		Vector3(-w * 0.42, waist_y - h * 0.05, -d * 0.40),
		Vector3(w * 0.42, chest_y + h * 0.18, d * 0.42),
		armor, 0.30, 0.70
	)
	# Abdomen plate (narrower)
	_build_box(
		root,
		Vector3(-w * 0.32, hip_y + h * 0.08, -d * 0.35),
		Vector3(w * 0.32, waist_y, d * 0.35),
		armor_dark, 0.30, 0.60
	)
	# Hip belt — trim band
	_build_box(
		root,
		Vector3(-w * 0.36, hip_y, -d * 0.40),
		Vector3(w * 0.36, hip_y + h * 0.08, d * 0.40),
		armor_trim, 0.20, 0.75
	)
	# Skirt plates (faulds) — small armor strips hanging below the belt
	for fi in range(5):
		var ft: float = float(fi) / 4.0
		var fx: float = lerpf(-w * 0.32, w * 0.32, ft)
		_build_box(
			root,
			Vector3(fx - w * 0.07, hip_y - h * 0.10, d * 0.30),
			Vector3(fx + w * 0.07, hip_y + h * 0.02, d * 0.42),
			armor, 0.30, 0.65
		)
	# Diagonal V-stripe down the chest — emissive trim glow
	_build_box(
		root,
		Vector3(-w * 0.05, chest_y - h * 0.08, d * 0.40),
		Vector3(w * 0.05, chest_y + h * 0.15, d * 0.46),
		glow, 0.20, 0.30
	)

	# ============================================================================
	# PAULDRONS (shoulder caps)
	# ============================================================================
	for side in [-1, 1]:
		_build_box(
			root,
			Vector3(side * w * 0.38, shoulder_y - h * 0.05, -d * 0.30),
			Vector3(side * w * 0.60, shoulder_y + h * 0.18, d * 0.30),
			armor, 0.30, 0.70
		)
		# Crest spike on top of pauldron
		_build_box(
			root,
			Vector3(side * w * 0.46, shoulder_y + h * 0.15, -d * 0.05),
			Vector3(side * w * 0.52, shoulder_y + h * 0.35, d * 0.05),
			armor_trim, 0.25, 0.65
		)

	# ============================================================================
	# HELMET — closed visor knight helm with HOLLOW dark interior + glowing slit
	# ============================================================================
	var head_anchor := Vector3(0, shoulder_y + h * 0.20, 0)
	# Neck gorget (small ring of armor under the helmet)
	_build_box(
		root,
		Vector3(-w * 0.18, shoulder_y + h * 0.02, -d * 0.20),
		Vector3(w * 0.18, head_anchor.y - h * 0.08, d * 0.20),
		armor_dark, 0.30, 0.65
	)
	# Helmet shell
	var hw: float = w * 0.28
	var hh: float = h * 0.22
	var hd: float = d * 0.60
	_build_box(
		root,
		Vector3(-hw, head_anchor.y - hh * 0.10, -hd * 0.45),
		Vector3(hw, head_anchor.y + hh * 0.95, hd * 0.55),
		armor, 0.30, 0.70
	)
	# Crest mohawk along the top of the helm
	_build_box(
		root,
		Vector3(-hw * 0.08, head_anchor.y + hh * 0.85, -hd * 0.30),
		Vector3(hw * 0.08, head_anchor.y + hh * 1.20, hd * 0.40),
		armor_trim, 0.25
	)
	# VISOR — dark void band SITS IN FRONT of the recessed glow so the helm
	# reads as hollow with light leaking out from inside. Per verify-agent.
	_build_box(
		root,
		Vector3(-hw * 0.92, head_anchor.y + hh * 0.28, hd * 0.42),
		Vector3(hw * 0.92, head_anchor.y + hh * 0.44, hd * 0.50),
		Color(0.02, 0.02, 0.04), 0.20
	)
	# Single horizontal glowing visor band RECESSED into the helm (was two
	# tiny dots flush with the visor — now reads as light leaking from inside).
	_build_box(
		root,
		Vector3(-hw * 0.78, head_anchor.y + hh * 0.30, hd * 0.20),
		Vector3(hw * 0.78, head_anchor.y + hh * 0.42, hd * 0.42),
		glow, 0.10, 0.40
	)
	# Deeper hollow void interior (visible through the visor)
	_build_box(
		root,
		Vector3(-hw * 0.85, head_anchor.y + hh * 0.00, hd * 0.10),
		Vector3(hw * 0.85, head_anchor.y + hh * 0.50, hd * 0.30),
		Color(0.02, 0.02, 0.04), 0.30
	)

	# ============================================================================
	# ARMS — armored plates: pauldron-to-elbow + elbow-to-wrist + gauntlet
	# Right arm holds the weapon, left arm holds a shield (when "shield_sword")
	# ============================================================================
	for side in [-1, 1]:
		var sh := Vector3(side * w * 0.50, shoulder_y, 0)
		var elbow := Vector3(side * w * 0.55, clearance + h * 0.35, d * 0.05)
		var wrist := Vector3(side * w * 0.48, clearance + h * 0.12, d * 0.10)
		# Upper-arm rerebrace
		_build_tapered_segment(root, sh, w * 0.11, elbow, w * 0.09, armor, 0.30, 0.60)
		# Forearm vambrace
		_build_tapered_segment(root, elbow, w * 0.09, wrist, w * 0.08, armor, 0.30, 0.60)
		# Elbow couter — small disc plate
		_build_box(
			root,
			Vector3(elbow.x - w * 0.11, elbow.y - h * 0.04, elbow.z - d * 0.10),
			Vector3(elbow.x + w * 0.11, elbow.y + h * 0.04, elbow.z + d * 0.10),
			armor_dark, 0.25, 0.65
		)
		# Gauntlet
		_build_box(
			root,
			Vector3(wrist.x - w * 0.08, wrist.y - h * 0.10, wrist.z - d * 0.08),
			Vector3(wrist.x + w * 0.08, wrist.y + h * 0.02, wrist.z + d * 0.10),
			armor_dark, 0.30, 0.65
		)
		# Gauntlet fingers — 4 small box claws
		for fi in range(4):
			var fo: float = (float(fi) - 1.5) * w * 0.035
			_build_box(
				root,
				Vector3(wrist.x + fo - w * 0.015, wrist.y - h * 0.15, wrist.z + d * 0.08),
				Vector3(wrist.x + fo + w * 0.015, wrist.y - h * 0.06, wrist.z + d * 0.13),
				armor_dark, 0.30, 0.55
			)

	# ============================================================================
	# WEAPON in the right hand (side = +1, x ≈ +w * 0.48)
	# ============================================================================
	var weapon_hand := Vector3(w * 0.48, clearance + h * 0.12, d * 0.10)
	if weapon_kind == "sword" or weapon_kind == "shield_sword":
		# Longsword held point-up
		var grip_bot := Vector3(weapon_hand.x, weapon_hand.y - h * 0.04, weapon_hand.z + d * 0.08)
		var guard := Vector3(weapon_hand.x, weapon_hand.y + h * 0.06, weapon_hand.z + d * 0.08)
		var blade_tip := Vector3(weapon_hand.x, weapon_hand.y + h * 0.85, weapon_hand.z + d * 0.06)
		_build_tapered_segment(root, grip_bot, w * 0.022, guard, w * 0.024,
			Color(0.30, 0.20, 0.12), 0.85)
		_build_box(
			root,
			Vector3(guard.x - w * 0.13, guard.y, guard.z - 0.02),
			Vector3(guard.x + w * 0.13, guard.y + h * 0.04, guard.z + 0.02),
			armor_trim, 0.25, 0.70
		)
		_build_tapered_segment(root, guard + Vector3(0, h * 0.04, 0), w * 0.030,
			blade_tip, w * 0.005, Color(0.92, 0.92, 0.95), 0.20, 0.70)
		# Pommel
		_build_box(
			root,
			Vector3(grip_bot.x - w * 0.035, grip_bot.y - h * 0.04, grip_bot.z - 0.025),
			Vector3(grip_bot.x + w * 0.035, grip_bot.y, grip_bot.z + 0.025),
			armor_trim, 0.25, 0.60
		)
	elif weapon_kind == "axe":
		# Hand axe
		var haft_bot := Vector3(weapon_hand.x, weapon_hand.y - h * 0.20, weapon_hand.z + d * 0.08)
		var haft_top := Vector3(weapon_hand.x, weapon_hand.y + h * 0.45, weapon_hand.z + d * 0.08)
		_build_tapered_segment(root, haft_bot, w * 0.025, haft_top, w * 0.022,
			Color(0.35, 0.22, 0.14), 0.85)
		# Axe head blade — leaf-shaped
		var blade_root := Vector3(haft_top.x, haft_top.y - h * 0.05, haft_top.z)
		var blade_top := Vector3(haft_top.x + w * 0.20, haft_top.y + h * 0.05, haft_top.z)
		var blade_bot := Vector3(haft_top.x + w * 0.20, haft_top.y - h * 0.18, haft_top.z)
		var st_axe := SurfaceTool.new()
		st_axe.begin(Mesh.PRIMITIVE_TRIANGLES)
		_add_tri(st_axe, blade_root, blade_top, blade_bot)
		_add_tri(st_axe, blade_root, blade_bot, blade_top)
		st_axe.generate_normals()
		var mi_axe := MeshInstance3D.new()
		mi_axe.mesh = st_axe.commit()
		var mat_axe := StandardMaterial3D.new()
		mat_axe.albedo_color = Color(0.78, 0.78, 0.82)
		mat_axe.roughness = 0.25
		mat_axe.metallic = 0.70
		mat_axe.cull_mode = BaseMaterial3D.CULL_DISABLED
		mi_axe.material_override = mat_axe
		root.add_child(mi_axe)
	elif weapon_kind == "halberd":
		# Polearm with axe head + spike at top. Haft starts JUST BELOW the
		# hand (was at world Y=0, punching through the ground — per verify).
		var haft_bot := Vector3(weapon_hand.x, weapon_hand.y - h * 0.20, weapon_hand.z + d * 0.08)
		var haft_top := Vector3(weapon_hand.x, clearance + h * 1.15, weapon_hand.z + d * 0.08)
		_build_tapered_segment(root, haft_bot, w * 0.025, haft_top, w * 0.022,
			Color(0.35, 0.22, 0.14), 0.85)
		# Axe-blade on the side
		_build_box(
			root,
			Vector3(haft_top.x + w * 0.02, haft_top.y - h * 0.10, haft_top.z - 0.02),
			Vector3(haft_top.x + w * 0.18, haft_top.y + h * 0.02, haft_top.z + 0.02),
			Color(0.85, 0.85, 0.88), 0.20, 0.70
		)
		# Spike on top
		var spike_tip := Vector3(haft_top.x, haft_top.y + h * 0.18, haft_top.z)
		_build_tapered_segment(root, haft_top, w * 0.030, spike_tip, w * 0.005,
			Color(0.85, 0.85, 0.88), 0.20, 0.70)

	# SHIELD on the left arm (only for "shield_sword")
	if weapon_kind == "shield_sword":
		var shield_center := Vector3(-w * 0.62, clearance + h * 0.30, d * 0.12)
		# Round disc shield
		var shield_sections: Array = [
			{"center": shield_center, "w": w * 0.30, "h": w * 0.30},
			{"center": shield_center + Vector3(0, 0, d * 0.04), "w": w * 0.30, "h": w * 0.30},
		]
		_swept_body(root, shield_sections, 12, armor, Color(0,0,0,0), 0.30, true)
		# Center boss
		_build_box(
			root,
			shield_center + Vector3(-w * 0.08, -w * 0.08, d * 0.05),
			shield_center + Vector3(w * 0.08, w * 0.08, d * 0.10),
			armor_trim, 0.25, 0.65
		)

	# ============================================================================
	# LEGS — armored greaves + boots
	# ============================================================================
	for side in [-1, 1]:
		var hip_x: float = side * w * 0.20
		var hip_pos := Vector3(hip_x, hip_y + h * 0.02, 0)
		var knee := Vector3(hip_x, clearance * 0.55, d * 0.02)
		var ankle := Vector3(hip_x, clearance * 0.10, 0)
		var foot := Vector3(hip_x, 0.0, d * 0.10)
		# Cuisse (thigh)
		_build_tapered_segment(root, hip_pos, w * 0.14, knee, w * 0.11, armor, 0.30, 0.65)
		# Greave (shin)
		_build_tapered_segment(root, knee, w * 0.11, ankle, w * 0.09, armor, 0.30, 0.65)
		# Poleyn (knee plate)
		_build_box(
			root,
			Vector3(knee.x - w * 0.13, knee.y - h * 0.04, knee.z - d * 0.10),
			Vector3(knee.x + w * 0.13, knee.y + h * 0.04, knee.z + d * 0.10),
			armor_dark, 0.25, 0.65
		)
		# Sabaton (boot)
		_build_box(
			root,
			Vector3(foot.x - w * 0.11, 0.0, foot.z - d * 0.20),
			Vector3(foot.x + w * 0.11, h * 0.06, foot.z + d * 0.22),
			armor_dark, 0.30, 0.65
		)

	# ============================================================================
	# DAMAGE / DENTS — random dark scratches and dings if has_damage
	# ============================================================================
	if has_damage:
		var dent_count: int = rng.randi_range(3, 8)
		for _di in range(dent_count):
			var d_ang: float = rng.randf_range(0.0, TAU)
			var d_y_choice: float = rng.randf_range(hip_y, shoulder_y + h * 0.10)
			var d_r: float = w * rng.randf_range(0.35, 0.55)
			var d_pos := Vector3(cos(d_ang) * d_r, d_y_choice, sin(d_ang) * d_r * 0.6)
			var d_size: float = w * rng.randf_range(0.025, 0.060)
			_build_box(
				root,
				d_pos - Vector3(d_size * 1.5, d_size * 0.6, d_size),
				d_pos + Vector3(d_size * 1.5, d_size * 0.6, d_size),
				armor.darkened(0.55), 0.85
			)

# ============================================================================
# ANKHEG (ankheg)
# Giant subterranean insectoid predator — D&D Monster Manual.
#   - LONG segmented chitinous body (like a giant centipede / mantis-shrimp)
#   - 6 splayed insect legs (sometimes shown with extra small "swimmerets")
#   - Large CURVED mandibles (signature — used to drag prey underground)
#   - Compound eyes on the head
#   - 2 ANTENNAE on top of the head
#   - Yellow-green ACID DROOL from the mouth
#   - Body emerges from the ground in attack pose (lower body buried)
# ============================================================================

static func _build_ankheg(plan: Dictionary, root: Node3D) -> void:
	var base: Dictionary = plan.get("base", {})
	var palette: Dictionary = plan.get("palette", {})
	var limbs: Dictionary = plan.get("limbs", {})
	var meta: Dictionary = plan.get("meta", {})
	var species: String = String(meta.get("species", "Ankheg"))

	# Long horizontal insect body
	var w: float = _axis(base, "width", 0.85)
	var h: float = _axis(base, "height", 0.55)
	var d: float = _axis(base, "depth", 2.40)
	var leg_length: float = float(limbs.get("leg_length", 0.40))
	var clearance: float = leg_length

	var render_seed: int = int(meta.get("render_seed", 0))
	var rng := RandomNumberGenerator.new()
	rng.seed = render_seed if render_seed != 0 else hash(species)

	# Per-individual variation
	var size_jitter: float = rng.randf_range(0.88, 1.20)
	var segment_count: int = rng.randi_range(7, 10)
	var mandible_jitter: float = rng.randf_range(0.85, 1.30)
	var antenna_jitter: float = rng.randf_range(0.80, 1.40)
	w *= size_jitter
	h *= size_jitter
	d *= size_jitter * rng.randf_range(0.95, 1.15)

	# Chitin palette
	var chitin_options := [
		Color(0.28, 0.18, 0.10),     # dark brown
		Color(0.45, 0.30, 0.18),     # russet
		Color(0.20, 0.18, 0.16),     # near-black
		Color(0.50, 0.35, 0.22),     # tan brown
		Color(0.32, 0.18, 0.18),     # blood maroon
		Color(0.25, 0.28, 0.20),     # olive
		Color(0.18, 0.20, 0.32),     # blue-black
		Color(0.55, 0.42, 0.28),     # amber
	]
	var acid_options := [
		Color(0.55, 0.95, 0.20),     # toxic green (iconic)
		Color(0.95, 0.95, 0.20),     # yellow
		Color(0.95, 0.55, 0.20),     # orange acid
		Color(0.55, 0.95, 0.85),     # cyan
	]
	var chitin: Color = chitin_options[rng.randi() % chitin_options.size()]
	var chitin_dark: Color = chitin.darkened(0.30)
	var chitin_seam: Color = chitin.lightened(0.20)
	var acid_color: Color = acid_options[rng.randi() % acid_options.size()]
	var mandible_color: Color = chitin.darkened(0.10)
	var eye_color: Color = palette.get("eye", Color(0.95, 0.55, 0.10))

	# ============================================================================
	# SEGMENTED BODY — multiple discrete segments to suggest insect chitin
	# rather than one smooth tube. Each segment is built as its own short
	# swept_body so the seams between segments are visible.
	# ============================================================================
	var body_y: float = clearance + h * 0.40
	var total_z_span: float = d * 1.40           # head end at +d*0.55, tail at -d*0.85
	var seg_z_step: float = total_z_span / float(segment_count)
	for seg_i in range(segment_count):
		var t: float = float(seg_i) / float(segment_count - 1)
		# Segment center Z
		var seg_z_back: float = d * 0.55 - float(seg_i + 1) * seg_z_step
		var seg_z_front: float = d * 0.55 - float(seg_i) * seg_z_step
		# Tapering: head end widest, tail end narrowest
		var prof_w_back: float = lerpf(0.42, 0.10, t) * w
		var prof_w_front: float = lerpf(0.45, 0.12, t) * w
		var prof_h_back: float = lerpf(0.40, 0.10, t) * h
		var prof_h_front: float = lerpf(0.42, 0.12, t) * h
		# Dorsal arch — body curves up at the mid (Ankheg is iconically
		# shown bursting/arching from the ground). Amplitude raised per
		# verify-agent from h*0.08 → h*0.20 and curve uses full sin(t*PI).
		var seg_y_back: float = body_y + sin(t * PI) * h * 0.20
		var seg_y_front: float = body_y + sin((t - 1.0 / segment_count) * PI) * h * 0.20
		var seg_sections: Array = [
			{"center": Vector3(0, seg_y_back, seg_z_back),
			 "w": prof_w_back, "h": prof_h_back},
			{"center": Vector3(0, seg_y_front, seg_z_front),
			 "w": prof_w_front, "h": prof_h_front},
		]
		_swept_body(root, seg_sections, 10, chitin, Color(0, 0, 0, 0), 0.40, true)
		# Segment seam — a lighter ring at the front edge of each segment
		_build_box(
			root,
			Vector3(-prof_w_front * 1.05, seg_y_front - prof_h_front * 0.55, seg_z_front - 0.01),
			Vector3(prof_w_front * 1.05, seg_y_front + prof_h_front * 0.55, seg_z_front + 0.015),
			chitin_seam, 0.40
		)

	# ============================================================================
	# HEAD — wide armored head with compound eyes + mandibles + antennae
	# ============================================================================
	var head_z: float = d * 0.55
	var head_sections: Array = [
		{"center": Vector3(0, body_y + h * 0.05, head_z), "w": w * 0.42, "h": h * 0.42},
		{"center": Vector3(0, body_y + h * 0.02, head_z + d * 0.18), "w": w * 0.40, "h": h * 0.38},
		{"center": Vector3(0, body_y - h * 0.05, head_z + d * 0.30), "w": w * 0.28, "h": h * 0.24},
	]
	_swept_body(root, head_sections, 10, chitin, Color(0,0,0,0), 0.40, true)

	# COMPOUND EYES — two faceted hemispheres on the top-sides of the head
	for side in [-1, 1]:
		var eye_pos := Vector3(side * w * 0.32, body_y + h * 0.18, head_z + d * 0.06)
		# Build as a 2-section flat dome for low-poly compound eye
		var eye_r: float = w * 0.12
		var eye_sections: Array = [
			{"center": eye_pos, "w": eye_r, "h": eye_r * 0.85},
			{"center": eye_pos + Vector3(side * eye_r * 0.30, eye_r * 0.20, 0),
			 "w": eye_r * 0.70, "h": eye_r * 0.55},
		]
		_swept_body(root, eye_sections, 10, eye_color, Color(0, 0, 0, 0), 0.20, true)
		# Faceted markings — small darker bumps on the eye surface
		for f_i in range(5):
			var fang: float = TAU * float(f_i) / 5.0
			var f_pos := eye_pos + Vector3(side * eye_r * 0.5 + cos(fang) * eye_r * 0.30,
				sin(fang) * eye_r * 0.30, eye_r * 0.10)
			_build_box(
				root,
				f_pos - Vector3(eye_r * 0.08, eye_r * 0.08, eye_r * 0.04),
				f_pos + Vector3(eye_r * 0.08, eye_r * 0.08, eye_r * 0.04),
				eye_color.darkened(0.30), 0.30
			)

	# MANDIBLES — large curved chitinous mandibles extending forward
	for side in [-1, 1]:
		var mand_base := Vector3(side * w * 0.22, body_y - h * 0.05, head_z + d * 0.25)
		# Curve outward + forward + slightly inward at tip (pincer shape)
		var mand_mid := Vector3(side * w * 0.42 * mandible_jitter, body_y - h * 0.10,
			head_z + d * 0.40 * mandible_jitter)
		var mand_tip := Vector3(side * w * 0.18 * mandible_jitter, body_y - h * 0.12,
			head_z + d * 0.55 * mandible_jitter)
		_build_tapered_segment(root, mand_base, w * 0.08 * mandible_jitter, mand_mid,
			w * 0.055 * mandible_jitter, mandible_color, 0.40)
		_build_tapered_segment(root, mand_mid, w * 0.050 * mandible_jitter, mand_tip,
			w * 0.012 * mandible_jitter, mandible_color, 0.40)
		# Inner serrated edge — small teeth on the inside of the mandible
		for ti in range(3):
			var tt: float = float(ti + 1) / 4.0
			var tooth_root := mand_base.lerp(mand_mid, tt)
			var tooth_tip := tooth_root + Vector3(-side * w * 0.04, 0, 0)
			_build_tapered_segment(root, tooth_root, w * 0.02, tooth_tip, w * 0.004,
				mandible_color.lightened(0.10), 0.40)

	# ACID DROOL — glowing yellow-green dribble between/below the mandibles
	for di in range(3):
		var drool_x: float = (float(di) - 1.0) * w * 0.08
		var drool_top := Vector3(drool_x, body_y - h * 0.12, head_z + d * 0.32)
		var drool_bot := Vector3(drool_x + rng.randf_range(-0.02, 0.02),
			body_y - h * 0.40 - rng.randf_range(0.0, h * 0.10),
			head_z + d * 0.34)
		_build_tapered_segment(root, drool_top, w * 0.025, drool_bot, w * 0.005,
			acid_color, 0.10, 0.30)

	# ANTENNAE — two long curving antennae arcing FORWARD over the head
	# (verify-agent: previous version went straight up like flagpoles).
	for side in [-1, 1]:
		var ant_base := Vector3(side * w * 0.10, body_y + h * 0.35, head_z + d * 0.02)
		var ant_mid := Vector3(side * w * 0.22 * antenna_jitter, body_y + h * 0.60 * antenna_jitter,
			head_z + d * 0.25 * antenna_jitter)
		var ant_tip := Vector3(side * w * 0.35 * antenna_jitter, body_y + h * 0.60 * antenna_jitter,
			head_z + d * 0.45 * antenna_jitter)
		_build_tapered_segment(root, ant_base, w * 0.030, ant_mid, w * 0.018,
			chitin_dark, 0.50)
		_build_tapered_segment(root, ant_mid, w * 0.018, ant_tip, w * 0.005,
			chitin_dark, 0.50)

	# ============================================================================
	# 6 SPLAYED INSECT LEGS — 3 per side, splayed outward and downward
	# ============================================================================
	for li in range(3):
		# Distribute legs along the body length
		var lt: float = float(li) / 2.0
		var leg_z: float = lerpf(d * 0.30, -d * 0.30, lt)
		var leg_r_taper: float = lerpf(1.0, 0.85, lt)
		for side in [-1, 1]:
			var leg_jitter: float = rng.randf_range(0.92, 1.10)
			var hip_x: float = side * w * 0.38
			var hip_pos := Vector3(hip_x, body_y - h * 0.05, leg_z)
			# Insect leg: hip → out + up (knuckle) → out (femur) → DOWN (tibia) → ground
			var knuckle := Vector3(side * (w * 0.55 + w * 0.10) * leg_jitter,
				body_y + h * 0.15 * leg_jitter, leg_z + (0.05 if leg_z > 0 else -0.05))
			var femur_tip := Vector3(side * (w * 0.85 + w * 0.20) * leg_jitter,
				body_y - h * 0.02, leg_z + (0.05 if leg_z > 0 else -0.05))
			var foot := Vector3(side * (w * 0.95 + w * 0.20) * leg_jitter, 0.0,
				leg_z + (0.08 if leg_z > 0 else -0.08))
			# Coxa (hip joint)
			_build_tapered_segment(root, hip_pos, w * 0.08 * leg_r_taper, knuckle,
				w * 0.06 * leg_r_taper, chitin, 0.40)
			# Femur (up-and-out leg segment)
			_build_tapered_segment(root, knuckle, w * 0.06 * leg_r_taper, femur_tip,
				w * 0.05 * leg_r_taper, chitin, 0.40)
			# Tibia (down to ground)
			_build_tapered_segment(root, femur_tip, w * 0.05 * leg_r_taper, foot,
				w * 0.025 * leg_r_taper, chitin_dark, 0.40)
			# Tarsus (foot claw)
			var claw_tip := Vector3(foot.x + side * w * 0.04, 0.02, foot.z + (0.04 if leg_z > 0 else -0.04))
			_build_tapered_segment(root, foot, w * 0.020, claw_tip, w * 0.004,
				chitin_dark, 0.40)

	# (Tail stinger removed — verify-agent caught that Ankhegs have no
	# stinger in canon; their weapon is acid spit + mandibles.)

# ============================================================================
# ANKYLOSAURUS (ankylosaurus)
# Armored herbivorous dinosaur — D&D Monster Manual.
#   - Low broad body covered in bony OSTEODERM plates (scutes)
#   - Short stocky 4 legs
#   - Small triangular armored head with row of teeth at the front
#   - MASSIVE CLUB TAIL at the rear (signature)
#   - Two rows of lateral spike scutes down each side
#   - Tough armored skin in earth-tones
# ============================================================================

static func _build_ankylosaurus(plan: Dictionary, root: Node3D) -> void:
	var base: Dictionary = plan.get("base", {})
	var palette: Dictionary = plan.get("palette", {})
	var limbs: Dictionary = plan.get("limbs", {})
	var meta: Dictionary = plan.get("meta", {})
	var species: String = String(meta.get("species", "Ankylosaurus"))

	# Low broad horizontal body
	var w: float = _axis(base, "width", 1.30)
	var h: float = _axis(base, "height", 0.85)
	var d: float = _axis(base, "depth", 2.50)
	var leg_length: float = float(limbs.get("leg_length", 0.55))
	var clearance: float = leg_length

	var render_seed: int = int(meta.get("render_seed", 0))
	var rng := RandomNumberGenerator.new()
	rng.seed = render_seed if render_seed != 0 else hash(species)

	# Per-individual variation
	var size_jitter: float = rng.randf_range(0.88, 1.20)
	var club_size_jitter: float = rng.randf_range(0.80, 1.35)
	var plate_count: int = rng.randi_range(8, 13)        # dorsal plate count
	var side_spike_count: int = rng.randi_range(4, 7)    # lateral spike pairs
	w *= size_jitter
	h *= size_jitter
	d *= size_jitter

	# Earth-toned armor palette
	var scale_options := [
		Color(0.45, 0.40, 0.28),     # mossy olive
		Color(0.32, 0.35, 0.30),     # swamp gray-green
		Color(0.55, 0.45, 0.28),     # sandstone
		Color(0.38, 0.30, 0.20),     # bark brown
		Color(0.62, 0.55, 0.42),     # desert tan
		Color(0.30, 0.32, 0.32),     # storm grey
		Color(0.45, 0.30, 0.22),     # rust earth
		Color(0.40, 0.42, 0.35),     # mottled olive-grey
	]
	var primary: Color = scale_options[rng.randi() % scale_options.size()]
	var belly: Color = palette.get("secondary", Color(0.78, 0.72, 0.55))
	var plate_color: Color = primary.darkened(0.20)
	var plate_dark: Color = primary.darkened(0.40)
	var spike_color: Color = primary.darkened(0.30)
	var tooth_color := Color(0.92, 0.88, 0.72)
	var eye_color: Color = palette.get("eye", Color(0.65, 0.45, 0.18))

	# ============================================================================
	# BODY — wide, low, almost flat-bottomed. 5 sections, widest at the
	# shoulder/hip region.
	# ============================================================================
	var body_y: float = clearance + h * 0.40
	var body_sections: Array = [
		{"center": Vector3(0, body_y, -d * 0.45), "w": w * 0.34, "h": h * 0.38},   # rump
		{"center": Vector3(0, body_y, -d * 0.20), "w": w * 0.46, "h": h * 0.48},
		{"center": Vector3(0, body_y, 0.05),       "w": w * 0.50, "h": h * 0.55},   # widest mid
		{"center": Vector3(0, body_y, d * 0.25),  "w": w * 0.45, "h": h * 0.50},
		{"center": Vector3(0, body_y - h * 0.05, d * 0.42), "w": w * 0.32, "h": h * 0.34},   # neck base
	]
	_swept_body(root, body_sections, 10, primary, belly, 0.70, true)

	# ============================================================================
	# HEAD — small triangular armored head with teeth at the front
	# ============================================================================
	var head_back_z: float = d * 0.42
	var head_front_z: float = d * 0.68
	var head_back := Vector3(0, body_y - h * 0.05, head_back_z)
	var head_mid := Vector3(0, body_y - h * 0.10, head_back_z + d * 0.12)
	var head_front := Vector3(0, body_y - h * 0.14, head_front_z)
	var head_sections: Array = [
		{"center": head_back, "w": w * 0.28, "h": h * 0.30},   # matches neck-base
		{"center": head_mid,  "w": w * 0.30, "h": h * 0.28},
		{"center": head_front, "w": w * 0.18, "h": h * 0.18},
	]
	_swept_body(root, head_sections, 10, primary, belly, 0.70, true)

	# Real Ankylosaurus had a TOOTHLESS BEAK at the snout tip (rhamphotheca)
	# with small teeth ONLY along the cheek rows further back. Fixed per
	# verify-agent: dark beak box at the tip + tooth row inside the cheek.
	_build_box(
		root,
		Vector3(-w * 0.13, head_front.y - h * 0.05, head_front_z - 0.015),
		Vector3(w * 0.13, head_front.y + h * 0.02, head_front_z + 0.020),
		Color(0.18, 0.14, 0.08), 0.65    # dark beak / rhamphotheca
	)
	# Cheek tooth row (4 teeth per side, set back from the beak)
	for ti in range(4):
		var t: float = float(ti) / 3.0
		var tz: float = lerpf(head_back_z + d * 0.05, head_front_z - d * 0.10, t)
		var tooth_y: float = head_front.y - h * 0.03
		for side_t in [-1, 1]:
			var tx: float = side_t * w * 0.10
			_build_box(
				root,
				Vector3(tx - w * 0.012, tooth_y, tz - w * 0.012),
				Vector3(tx + w * 0.012, tooth_y + h * 0.03, tz + w * 0.012),
				tooth_color, 0.50
			)

	# EYES — small, on the upper sides of the head
	for side in [-1, 1]:
		_build_box(
			root,
			Vector3(side * w * 0.18, head_back.y + h * 0.08, head_back_z + d * 0.06),
			Vector3(side * w * 0.24, head_back.y + h * 0.15, head_back_z + d * 0.11),
			eye_color, 0.30, 0.10
		)
		# Pupil
		_build_box(
			root,
			Vector3(side * w * 0.20, head_back.y + h * 0.10, head_back_z + d * 0.10),
			Vector3(side * w * 0.22, head_back.y + h * 0.13, head_back_z + d * 0.115),
			Color(0.05, 0.04, 0.03), 0.30
		)

	# Head spikes — 2 small horns on top of the head, distinctive Ankylosaurus
	for side in [-1, 1]:
		var horn_root := Vector3(side * w * 0.22, head_back.y + h * 0.15, head_back_z + d * 0.04)
		var horn_tip := Vector3(side * w * 0.28, head_back.y + h * 0.25, head_back_z + d * 0.02)
		_build_tapered_segment(root, horn_root, w * 0.045, horn_tip, w * 0.012,
			spike_color, 0.50)
	# Cheek spikes — angled outward and back from each cheek
	for side in [-1, 1]:
		var cheek_root := Vector3(side * w * 0.26, head_back.y - h * 0.05, head_back_z + d * 0.08)
		var cheek_tip := Vector3(side * w * 0.40, head_back.y - h * 0.10, head_back_z - d * 0.02)
		_build_tapered_segment(root, cheek_root, w * 0.035, cheek_tip, w * 0.008,
			spike_color, 0.50)

	# ============================================================================
	# DORSAL OSTEODERM PLATES — rows of bony plates running along the back
	# in 2 rows (paired). Iconic ankylosaur armor.
	# ============================================================================
	for pi in range(plate_count):
		var pt: float = float(pi) / float(plate_count - 1)
		var pz: float = lerpf(-d * 0.42, d * 0.32, pt)
		# 2 plates per row position (left + right of spine)
		for side in [-1, 1]:
			var plate_x: float = side * w * lerpf(0.10, 0.20, sin(pt * PI))
			var plate_y: float = body_y + h * lerpf(0.30, 0.50, sin(pt * PI))
			# Plate size varies — bigger plates over the back, smaller at ends
			var plate_w_local: float = w * lerpf(0.06, 0.12, sin(pt * PI))
			var plate_h_local: float = h * 0.06
			var plate_d_local: float = w * lerpf(0.06, 0.10, sin(pt * PI))
			_build_box(
				root,
				Vector3(plate_x - plate_w_local, plate_y - plate_h_local, pz - plate_d_local),
				Vector3(plate_x + plate_w_local, plate_y + plate_h_local, pz + plate_d_local),
				plate_color, 0.60
			)
			# Small raised central knob on each plate
			_build_box(
				root,
				Vector3(plate_x - plate_w_local * 0.4, plate_y + plate_h_local, pz - plate_d_local * 0.4),
				Vector3(plate_x + plate_w_local * 0.4, plate_y + plate_h_local * 2.5, pz + plate_d_local * 0.4),
				plate_dark, 0.60
			)

	# ============================================================================
	# LATERAL SIDE SPIKES — row of curved spikes on the SIDES of the body
	# pointing outward (Ankylosaur signature lateral defense)
	# ============================================================================
	for si in range(side_spike_count):
		var st: float = float(si) / float(side_spike_count - 1)
		var sz: float = lerpf(-d * 0.35, d * 0.28, st)
		for side in [-1, 1]:
			var spike_root := Vector3(side * w * 0.48, body_y + h * 0.20, sz)
			var spike_tip := Vector3(side * (w * 0.70 + w * 0.10 * sin(st * PI)),
				body_y + h * 0.10, sz)
			_build_tapered_segment(root, spike_root, w * 0.040, spike_tip, w * 0.010,
				spike_color, 0.50)

	# ============================================================================
	# CLUBBED TAIL — the iconic Ankylosaurus signature. Tapered tail ending
	# in a MASSIVE bony club ball.
	# ============================================================================
	var tail_sections: Array = []
	var tail_segs: int = 5
	for i in range(tail_segs):
		var t: float = float(i) / float(tail_segs - 1)
		var tz: float = -d * 0.45 - t * d * 0.80
		var ty: float = body_y - t * h * 0.15
		var tr: float = lerpf(w * 0.22, w * 0.10, t)
		var thr: float = lerpf(h * 0.24, h * 0.12, t)
		tail_sections.append({"center": Vector3(0, ty, tz), "w": tr, "h": thr})
	_swept_body(root, tail_sections, 10, primary, belly, 0.70, false)

	# CLUB BALL at the end of the tail — SEMICIRCULAR (wider than tall) per
	# real Ankylosaurus club proportions (~3:3:1 W:L:H, flatter than spherical).
	# Sections vary in Z so the club extends laterally as a flat blob.
	var club_center := Vector3(0, body_y - h * 0.18, -d * 1.30)
	var club_r: float = w * 0.22 * club_size_jitter
	# Build along Z (horizontal) to make it lateral-wide rather than tall
	var club_sections: Array = [
		{"center": club_center + Vector3(0, 0, -club_r * 0.50),
		 "w": club_r * 0.55, "h": club_r * 0.30},
		{"center": club_center,
		 "w": club_r * 1.10, "h": club_r * 0.45},
		{"center": club_center + Vector3(0, 0, club_r * 0.50),
		 "w": club_r * 0.55, "h": club_r * 0.30},
	]
	_swept_body(root, club_sections, 12, plate_dark, Color(0,0,0,0), 0.65, true)
	# Small KNOBS on the club (not big radial spikes — real club is mostly
	# smooth fused osteoderms; 4 low knobs at most).
	for ki in range(4):
		var kang: float = TAU * float(ki) / 4.0
		var k_root := Vector3(
			club_center.x + cos(kang) * club_r * 0.80,
			club_center.y + club_r * 0.10,
			club_center.z + sin(kang) * club_r * 0.40
		)
		var k_tip := Vector3(
			club_center.x + cos(kang) * club_r * 1.00,
			club_center.y + club_r * 0.20,
			club_center.z + sin(kang) * club_r * 0.50
		)
		_build_tapered_segment(root, k_root, club_r * 0.18, k_tip, club_r * 0.10,
			spike_color, 0.60)

	# ============================================================================
	# LEGS — 4 short stocky legs. HIND LEGS LONGER than FORELEGS (per verify-
	# agent / Wikipedia anatomy). Front legs ~82% of back leg height so the
	# spine slopes down toward the head.
	# ============================================================================
	var leg_z_offsets := [d * 0.22, -d * 0.28]   # front, back
	for leg_z in leg_z_offsets:
		var is_front: bool = leg_z > 0
		var leg_scale: float = 0.82 if is_front else 1.0
		var local_clearance: float = clearance * leg_scale
		for side in [-1, 1]:
			var hip_x: float = side * w * 0.32
			var hip_y_local: float = body_y - h * 0.05
			if is_front:
				hip_y_local -= h * 0.08              # shoulder drops to compensate
			var hip_pos := Vector3(hip_x, hip_y_local, leg_z)
			var knee := Vector3(hip_x, local_clearance * 0.55,
				leg_z + (0.04 if is_front else -0.04))
			var foot := Vector3(hip_x, 0.0, leg_z + (0.08 if is_front else -0.08))
			_build_tapered_segment(root, hip_pos, w * 0.16, knee, w * 0.13, primary, 0.70)
			_build_tapered_segment(root, knee, w * 0.13, foot, w * 0.11, primary.darkened(0.05), 0.70)
			# Wide flat foot
			_build_box(
				root,
				Vector3(foot.x - w * 0.14, 0.0, foot.z - w * 0.12),
				Vector3(foot.x + w * 0.14, h * 0.06, foot.z + w * 0.14),
				plate_dark, 0.70
			)
			# 3 stubby claws
			for ti in range(3):
				var co: float = (float(ti) - 1.0) * w * 0.06
				var claw_tip := Vector3(foot.x + co, 0.01, foot.z + w * (0.20 if leg_z > 0 else 0.10))
				_build_tapered_segment(root, foot + Vector3(co, h * 0.03, 0), w * 0.030,
					claw_tip, w * 0.008, spike_color, 0.40)

# ============================================================================
# ANNIS HAG (annis_hag)
# Withered fey crone from Volo's / Monster Manual. Iconic features:
#   - Tall scrawny humanoid (8 ft tall), hunched posture
#   - Knobby joints (skinny limbs with bulging knees/elbows)
#   - Blue-black mottled hairy skin
#   - LONG bony fingers ending in hooked IRON CLAWS (10+ inches)
#   - Sunken yellow eyes in deep sockets
#   - Wild matted hair
#   - JAGGED IRON TEETH visible in a wide grin
#   - Ragged shawl / loincloth wrapping
# ============================================================================

static func _build_annis_hag(plan: Dictionary, root: Node3D) -> void:
	var base: Dictionary = plan.get("base", {})
	var palette: Dictionary = plan.get("palette", {})
	var limbs: Dictionary = plan.get("limbs", {})
	var meta: Dictionary = plan.get("meta", {})
	var species: String = String(meta.get("species", "Annis Hag"))

	# Tall scrawny humanoid — Volo's: "just over 8 feet", so 2.45 m baseline
	# (per verify-agent — previous 2.15 default could shrink below human).
	var w: float = _axis(base, "width", 0.55)
	var h: float = _axis(base, "height", 2.45)
	var d: float = _axis(base, "depth", 0.40)
	var leg_length: float = float(limbs.get("leg_length", 1.05))
	var clearance: float = leg_length

	var render_seed: int = int(meta.get("render_seed", 0))
	var rng := RandomNumberGenerator.new()
	rng.seed = render_seed if render_seed != 0 else hash(species)

	# Per-individual variation — tighter floor so she never reads as short.
	var size_jitter: float = rng.randf_range(1.00, 1.20)
	var stoop: float = rng.randf_range(h * 0.05, h * 0.20)         # hunch forward
	var claw_size_jitter: float = rng.randf_range(0.85, 1.40)
	var hair_wildness: float = rng.randf_range(0.85, 1.40)
	w *= size_jitter
	h *= size_jitter

	# Color palette — sickly blue-black hag skin
	var skin_options := [
		Color(0.18, 0.20, 0.30),     # iconic blue-black
		Color(0.22, 0.22, 0.25),     # charcoal
		Color(0.30, 0.28, 0.35),     # slate violet
		Color(0.18, 0.12, 0.22),     # bruise purple-black
		Color(0.28, 0.20, 0.18),     # rotted purple
		Color(0.20, 0.25, 0.30),     # deep teal-grey
		Color(0.35, 0.30, 0.32),     # dead grey-mauve
	]
	var hair_options := [
		Color(0.18, 0.15, 0.10),     # matted black
		Color(0.85, 0.78, 0.65),     # filthy grey-white
		Color(0.35, 0.18, 0.10),     # rust auburn
		Color(0.55, 0.30, 0.20),     # dirty red
		Color(0.22, 0.22, 0.22),     # iron grey
	]
	var eye_options := [
		Color(0.95, 0.85, 0.20),     # iconic sickly yellow
		Color(0.95, 0.55, 0.10),     # amber
		Color(0.55, 0.95, 0.30),     # poison green
		Color(0.95, 0.30, 0.30),     # blood red
	]
	var rag_options := [
		Color(0.20, 0.18, 0.15),     # filthy black rag
		Color(0.45, 0.30, 0.18),     # rotten brown
		Color(0.30, 0.28, 0.20),     # mud-stained
		Color(0.25, 0.30, 0.20),     # mossy
	]
	var skin: Color = skin_options[rng.randi() % skin_options.size()]
	var skin_dark: Color = skin.darkened(0.30)
	var skin_pallor: Color = skin.lightened(0.15)
	var hair: Color = hair_options[rng.randi() % hair_options.size()]
	var eye_color: Color = eye_options[rng.randi() % eye_options.size()]
	var rag: Color = rag_options[rng.randi() % rag_options.size()]
	var iron_color := Color(0.30, 0.32, 0.36)
	var iron_dark := Color(0.18, 0.20, 0.22)
	var tooth_color := Color(0.55, 0.55, 0.60)    # iron teeth — not white

	# ============================================================================
	# TORSO — gaunt, narrow waist, slight forward hunch.
	# Sections stack vertically along Y, slightly forward-leaning (Z increases
	# from hip → chest → shoulders to suggest stoop).
	# ============================================================================
	var hip_y: float = clearance + h * 0.05
	var waist_y: float = clearance + h * 0.20
	var chest_y: float = clearance + h * 0.40
	var shoulder_y: float = clearance + h * 0.55
	var torso_sections: Array = [
		{"center": Vector3(0, hip_y, 0), "w": w * 0.30, "h": w * 0.22},
		{"center": Vector3(0, waist_y, stoop * 0.10), "w": w * 0.24, "h": w * 0.18},   # narrow waist
		{"center": Vector3(0, chest_y, stoop * 0.30), "w": w * 0.34, "h": w * 0.22},
		{"center": Vector3(0, shoulder_y, stoop * 0.50), "w": w * 0.42, "h": w * 0.20},
	]
	_swept_body(root, torso_sections, 10, skin, Color(0,0,0,0), 0.95, true)

	# RIB CAGE BUMPS — emaciated bone ridges visible through skin
	for ri in range(3):
		var ry: float = lerpf(chest_y - h * 0.05, chest_y + h * 0.10, float(ri) / 2.0)
		_build_box(
			root,
			Vector3(-w * 0.30, ry, stoop * 0.30 + w * 0.18),
			Vector3(w * 0.30, ry + h * 0.015, stoop * 0.30 + w * 0.22),
			skin_dark, 0.95
		)

	# RAG SHAWL across shoulders + draped down chest
	_build_box(
		root,
		Vector3(-w * 0.50, shoulder_y - h * 0.05, stoop * 0.50 - w * 0.25),
		Vector3(w * 0.50, shoulder_y + h * 0.08, stoop * 0.50 + w * 0.25),
		rag, 0.95
	)
	# Loincloth / tattered skirt at the hip
	_build_box(
		root,
		Vector3(-w * 0.32, hip_y - h * 0.20, -w * 0.20),
		Vector3(w * 0.32, hip_y + h * 0.08, w * 0.22),
		rag, 0.95
	)
	# Ragged hanging strips
	for ri in range(5):
		var rang: float = TAU * float(ri) / 5.0 + 0.3
		var r_x: float = cos(rang) * w * 0.28
		var r_z: float = sin(rang) * w * 0.22
		var rag_top := Vector3(r_x, hip_y - h * 0.10, r_z)
		var rag_bot := Vector3(r_x * 1.10, hip_y - h * rng.randf_range(0.30, 0.50), r_z * 1.10)
		_build_tapered_segment(root, rag_top, w * 0.035, rag_bot, w * 0.015, rag, 0.95)

	# ============================================================================
	# NECK + HEAD — head tilts FORWARD due to the hunch
	# ============================================================================
	var neck_base := Vector3(0, shoulder_y + h * 0.02, stoop * 0.55)
	var head_anchor := Vector3(0, shoulder_y + h * 0.20, stoop + w * 0.08)
	_build_tapered_segment(root, neck_base, w * 0.10, head_anchor + Vector3(0, -h * 0.06, 0),
		w * 0.09, skin, 0.95)

	# Cranium — long-ish gaunt skull shape
	var cran_w: float = w * 0.24
	var cran_h: float = h * 0.18
	var cran_d: float = d * 0.65
	_build_box(
		root,
		Vector3(-cran_w, head_anchor.y - cran_h * 0.20, head_anchor.z - cran_d * 0.40),
		Vector3(cran_w, head_anchor.y + cran_h * 0.85, head_anchor.z + cran_d * 0.55),
		skin, 0.95
	)
	# Sunken cheeks (jaw narrower than cranium)
	_build_box(
		root,
		Vector3(-cran_w * 0.80, head_anchor.y - cran_h * 0.55, head_anchor.z - cran_d * 0.15),
		Vector3(cran_w * 0.80, head_anchor.y - cran_h * 0.18, head_anchor.z + cran_d * 0.50),
		skin_dark, 0.95
	)
	# Hooked nose — bony bridge + downward-hanging hooked tip (per verify).
	# Bridge
	_build_box(
		root,
		Vector3(-cran_w * 0.10, head_anchor.y - cran_h * 0.05, head_anchor.z + cran_d * 0.40),
		Vector3(cran_w * 0.10, head_anchor.y + cran_h * 0.15, head_anchor.z + cran_d * 0.70),
		skin_pallor, 0.95
	)
	# Downward-hanging hook tip — projects below the bridge and slightly forward
	_build_box(
		root,
		Vector3(-cran_w * 0.08, head_anchor.y - cran_h * 0.25, head_anchor.z + cran_d * 0.55),
		Vector3(cran_w * 0.08, head_anchor.y - cran_h * 0.04, head_anchor.z + cran_d * 0.85),
		skin_pallor, 0.95
	)
	# Brow ridge over eye sockets
	_build_box(
		root,
		Vector3(-cran_w * 0.95, head_anchor.y + cran_h * 0.35, head_anchor.z + cran_d * 0.35),
		Vector3(cran_w * 0.95, head_anchor.y + cran_h * 0.55, head_anchor.z + cran_d * 0.55),
		skin_dark, 0.95
	)

	# SUNKEN YELLOW EYES — deep-set in dark sockets
	for side in [-1, 1]:
		# Deep dark socket recess
		_build_box(
			root,
			Vector3(side * cran_w * 0.45 - cran_w * 0.18, head_anchor.y + cran_h * 0.10,
				head_anchor.z + cran_d * 0.40),
			Vector3(side * cran_w * 0.45 + cran_w * 0.18, head_anchor.y + cran_h * 0.32,
				head_anchor.z + cran_d * 0.52),
			Color(0.03, 0.03, 0.04), 0.30
		)
		# Glowing yellow eye inside the socket (recessed)
		_build_box(
			root,
			Vector3(side * cran_w * 0.45 - cran_w * 0.08, head_anchor.y + cran_h * 0.15,
				head_anchor.z + cran_d * 0.42),
			Vector3(side * cran_w * 0.45 + cran_w * 0.08, head_anchor.y + cran_h * 0.25,
				head_anchor.z + cran_d * 0.48),
			eye_color, 0.20, 0.30
		)

	# JAGGED IRON TEETH — wide grin of mismatched jagged iron teeth
	var grin_y_top: float = head_anchor.y - cran_h * 0.10
	var grin_y_bot: float = head_anchor.y - cran_h * 0.35
	# Mouth dark interior (the grin)
	_build_box(
		root,
		Vector3(-cran_w * 0.60, grin_y_bot, head_anchor.z + cran_d * 0.40),
		Vector3(cran_w * 0.60, grin_y_top, head_anchor.z + cran_d * 0.50),
		Color(0.06, 0.04, 0.06), 0.50
	)
	# Jagged iron teeth — random tooth heights for jaggedness
	var hag_tooth_count: int = rng.randi_range(7, 11)
	for ti in range(hag_tooth_count):
		var tt: float = float(ti) / float(hag_tooth_count - 1)
		var tx: float = lerpf(-cran_w * 0.55, cran_w * 0.55, tt)
		var tooth_h: float = h * rng.randf_range(0.025, 0.060)
		var alternate: int = ti % 2
		if alternate == 0:
			# Top tooth pointing down
			_build_box(
				root,
				Vector3(tx - cran_w * 0.05, grin_y_top - tooth_h, head_anchor.z + cran_d * 0.46),
				Vector3(tx + cran_w * 0.05, grin_y_top, head_anchor.z + cran_d * 0.54),
				tooth_color, 0.40, 0.55
			)
		else:
			# Bottom tooth pointing up
			_build_box(
				root,
				Vector3(tx - cran_w * 0.05, grin_y_bot, head_anchor.z + cran_d * 0.46),
				Vector3(tx + cran_w * 0.05, grin_y_bot + tooth_h, head_anchor.z + cran_d * 0.54),
				tooth_color, 0.40, 0.55
			)

	# ============================================================================
	# WILD MATTED HAIR — long stringy hair falling around the head + back
	# ============================================================================
	# Top + back hair mass
	var hair_top_sections: Array = [
		{"center": Vector3(0, head_anchor.y + cran_h * 0.10, head_anchor.z - cran_d * 0.10),
		 "w": cran_w * 1.10, "h": cran_d * 0.55},
		{"center": Vector3(0, head_anchor.y + cran_h * 0.80, head_anchor.z - cran_d * 0.15),
		 "w": cran_w * 0.95 * hair_wildness, "h": cran_d * 0.45},
		{"center": Vector3(0, head_anchor.y + cran_h * 1.10, head_anchor.z - cran_d * 0.20),
		 "w": cran_w * 0.50, "h": cran_d * 0.30},
	]
	_swept_body(root, hair_top_sections, 8, hair, Color(0,0,0,0), 0.98, true)
	# Long stringy locks falling down past the shoulders
	for lock_i in range(int(8 * hair_wildness)):
		var l_ang: float = TAU * float(lock_i) / float(int(8 * hair_wildness)) + rng.randf_range(-0.2, 0.2)
		var l_top := Vector3(cos(l_ang) * cran_w * 0.95, head_anchor.y + cran_h * 0.10,
			head_anchor.z + sin(l_ang) * cran_d * 0.30 - cran_d * 0.05)
		var lock_len: float = h * rng.randf_range(0.20, 0.45)
		var l_bot := Vector3(l_top.x + rng.randf_range(-w * 0.05, w * 0.05),
			l_top.y - lock_len, l_top.z + rng.randf_range(-w * 0.05, w * 0.05))
		_build_tapered_segment(root, l_top, w * 0.025, l_bot, w * 0.010, hair, 0.98)

	# ============================================================================
	# ARMS — long, skinny with knobby elbows and HUGE clawed hands
	# ============================================================================
	for side in [-1, 1]:
		var arm_jitter: float = rng.randf_range(0.92, 1.10)
		var sh := Vector3(side * w * 0.40, shoulder_y, stoop * 0.50)
		var elbow := Vector3(side * w * 0.55 * arm_jitter, chest_y - h * 0.18,
			stoop * 0.35 + w * 0.08)
		var wrist := Vector3(side * w * 0.45 * arm_jitter, hip_y - h * 0.05,
			stoop * 0.20 + w * 0.12)
		# Upper arm (thin)
		_build_tapered_segment(root, sh, w * 0.07, elbow, w * 0.06, skin, 0.95)
		# Knobby elbow joint
		_build_box(
			root,
			Vector3(elbow.x - w * 0.09, elbow.y - h * 0.03, elbow.z - w * 0.07),
			Vector3(elbow.x + w * 0.09, elbow.y + h * 0.03, elbow.z + w * 0.07),
			skin_dark, 0.95
		)
		# Forearm
		_build_tapered_segment(root, elbow, w * 0.055, wrist, w * 0.045, skin, 0.95)
		# Palm
		_build_box(
			root,
			Vector3(wrist.x - w * 0.07, wrist.y - h * 0.06, wrist.z - w * 0.05),
			Vector3(wrist.x + w * 0.07, wrist.y + h * 0.02, wrist.z + w * 0.05),
			skin_dark, 0.95
		)
		# LONG BONY FINGERS — 4 per hand, each ending in a hooked IRON CLAW
		for fi in range(4):
			var fo: float = (float(fi) - 1.5) * w * 0.035
			var finger_base := Vector3(wrist.x + fo, wrist.y - h * 0.04, wrist.z + w * 0.04)
			var finger_mid := Vector3(wrist.x + fo, wrist.y - h * 0.12 * claw_size_jitter,
				wrist.z + w * 0.10)
			# Iron claw at the tip (hooked back slightly)
			var claw_tip := Vector3(wrist.x + fo, wrist.y - h * 0.18 * claw_size_jitter,
				wrist.z + w * 0.04)
			# Bony finger
			_build_tapered_segment(root, finger_base, w * 0.020, finger_mid, w * 0.012,
				skin_pallor, 0.95)
			# Iron claw — use the brighter iron_color so the claws read
			# as IRON matching the iron teeth (was iron_dark = near-black).
			_build_tapered_segment(root, finger_mid, w * 0.014 * claw_size_jitter, claw_tip,
				w * 0.003, iron_color, 0.40, 0.50)

	# ============================================================================
	# LEGS — long thin with knobby knees, ending in clawed feet
	# ============================================================================
	for side in [-1, 1]:
		var leg_jitter: float = rng.randf_range(0.92, 1.10)
		var hip_x: float = side * w * 0.16
		var hip_pos := Vector3(hip_x, hip_y, 0)
		var knee := Vector3(hip_x * 1.20, clearance * 0.55 * leg_jitter, w * 0.05)
		var ankle := Vector3(hip_x, clearance * 0.12, 0)
		var foot := Vector3(hip_x, 0.0, w * 0.10)
		# Thigh (thin)
		_build_tapered_segment(root, hip_pos, w * 0.10, knee, w * 0.08, skin, 0.95)
		# Knobby knee
		_build_box(
			root,
			Vector3(knee.x - w * 0.10, knee.y - h * 0.03, knee.z - w * 0.08),
			Vector3(knee.x + w * 0.10, knee.y + h * 0.03, knee.z + w * 0.08),
			skin_dark, 0.95
		)
		# Shin
		_build_tapered_segment(root, knee, w * 0.07, ankle, w * 0.055, skin, 0.95)
		# Foot (bony with toe claws)
		_build_box(
			root,
			Vector3(foot.x - w * 0.08, 0.0, foot.z - w * 0.10),
			Vector3(foot.x + w * 0.08, h * 0.04, foot.z + w * 0.14),
			skin_dark, 0.95
		)
		# 3 toe claws — iron_color to match the iron teeth/claws
		for ti in range(3):
			var to: float = (float(ti) - 1.0) * w * 0.04
			var toe_tip := Vector3(foot.x + to, 0.01, foot.z + w * 0.20)
			_build_tapered_segment(root, foot + Vector3(to, h * 0.02, w * 0.05), w * 0.015,
				toe_tip, w * 0.004, iron_color, 0.40)

	# ============================================================================
	# BODY HAIR — short matted strand tufts on torso/arms. Per verify-agent:
	# Volo's lore is explicit about "blue-black HAIRY skin". Without these
	# the hag reads as a smooth gaunt zombie crone, not an annis.
	# ============================================================================
	var body_hair_count: int = 18
	for _bi in range(body_hair_count):
		var bang: float = rng.randf_range(0.0, TAU)
		var by_t: float = rng.randf_range(0.0, 1.0)
		# Pick a Y along the torso (hip → shoulder) and a radius from the body
		# axis. Strands point outward at the local surface.
		var by: float = lerpf(hip_y - h * 0.05, shoulder_y + h * 0.05, by_t)
		var br: float = w * 0.32       # approximate torso surface radius
		var bz_offset: float = stoop * lerpf(0.10, 0.55, by_t)
		var b_root := Vector3(cos(bang) * br, by, bz_offset + sin(bang) * br * 0.7)
		var strand_len: float = h * rng.randf_range(0.04, 0.08)
		var b_tip := Vector3(
			b_root.x + cos(bang) * strand_len * 0.6,
			b_root.y + rng.randf_range(-strand_len * 0.4, strand_len * 0.4),
			b_root.z + sin(bang) * strand_len * 0.6
		)
		_build_tapered_segment(root, b_root, w * 0.008, b_tip, w * 0.003,
			hair, 0.98)

# ============================================================================
# APE (ape)
# Large gorilla-like beast — D&D Monster Manual. Iconic features:
#   - Bulky muscular body, broad barrel chest
#   - LONG heavy arms (longer than legs, reach past the knees)
#   - Short thick legs
#   - Broad flat ape face with prominent BROW RIDGE and protruding muzzle
#   - Small ears low on the head
#   - Opposable thumb hands + flat feet
#   - Crouched / knuckle-walking posture (arms support the body)
# ============================================================================

static func _build_ape(plan: Dictionary, root: Node3D) -> void:
	var base: Dictionary = plan.get("base", {})
	var palette: Dictionary = plan.get("palette", {})
	var limbs: Dictionary = plan.get("limbs", {})
	var meta: Dictionary = plan.get("meta", {})
	var species: String = String(meta.get("species", "Ape"))

	var w: float = _axis(base, "width", 1.00)
	var h: float = _axis(base, "height", 1.55)
	var d: float = _axis(base, "depth", 0.70)
	var leg_length: float = float(limbs.get("leg_length", 0.65))
	var clearance: float = leg_length

	var render_seed: int = int(meta.get("render_seed", 0))
	var rng := RandomNumberGenerator.new()
	rng.seed = render_seed if render_seed != 0 else hash(species)

	# Per-individual variation
	var size_jitter: float = rng.randf_range(0.88, 1.20)
	var bulk_jitter: float = rng.randf_range(0.92, 1.18)
	var arm_length_jitter: float = rng.randf_range(0.95, 1.15)
	w *= size_jitter
	h *= size_jitter
	d *= size_jitter

	# Curated ape fur palette
	var fur_options := [
		Color(0.18, 0.15, 0.12),     # black gorilla
		Color(0.32, 0.22, 0.16),     # dark brown
		Color(0.55, 0.42, 0.28),     # chestnut brown
		Color(0.45, 0.35, 0.25),     # bronze brown
		Color(0.25, 0.22, 0.20),     # near-black
		Color(0.62, 0.52, 0.38),     # tawny (orangutan-ish)
		Color(0.40, 0.32, 0.22),     # tan
	]
	var face_options := [
		Color(0.18, 0.12, 0.08),     # dark gorilla face skin
		Color(0.30, 0.20, 0.15),     # leathery brown
		Color(0.42, 0.32, 0.22),     # warm tan face
		Color(0.20, 0.15, 0.12),     # near-black
	]
	var primary: Color = fur_options[rng.randi() % fur_options.size()]
	var fur_dark: Color = primary.darkened(0.25)
	var face: Color = face_options[rng.randi() % face_options.size()]
	var face_dark: Color = face.darkened(0.30)
	var eye_color: Color = palette.get("eye", Color(0.40, 0.25, 0.10))
	# Silverback patch — older male alpha apes
	var has_silverback: bool = rng.randf() > 0.55

	# ============================================================================
	# TORSO — broad barrel chest, narrower at hip, slight forward stoop
	# ============================================================================
	var hip_y: float = clearance
	var belly_y: float = clearance + h * 0.18
	var chest_y: float = clearance + h * 0.40
	var shoulder_y: float = clearance + h * 0.55
	var torso_sections: Array = [
		# Hips — narrower than chest
		{"center": Vector3(0, hip_y, 0),         "w": w * 0.36 * bulk_jitter, "h": d * 0.45 * bulk_jitter},
		# Belly — slight pot
		{"center": Vector3(0, belly_y, d * 0.04), "w": w * 0.42 * bulk_jitter, "h": d * 0.52 * bulk_jitter},
		# CHEST — broad barrel (signature ape)
		{"center": Vector3(0, chest_y, d * 0.04), "w": w * 0.50 * bulk_jitter, "h": d * 0.52 * bulk_jitter},
		# Shoulders — widest
		{"center": Vector3(0, shoulder_y, 0),     "w": w * 0.58 * bulk_jitter, "h": d * 0.45 * bulk_jitter},
	]
	_swept_body(root, torso_sections, 10, primary, primary.lightened(0.15), 0.95, true)

	# SILVERBACK patch — silver fur stripe ON the back surface (was floating
	# behind body per verify-agent). Anchored to actual torso back depth.
	if has_silverback:
		_build_box(
			root,
			Vector3(-w * 0.30, belly_y, -d * 0.30),
			Vector3(w * 0.30, shoulder_y + h * 0.05, -d * 0.05),
			Color(0.78, 0.78, 0.80), 0.95
		)

	# SHOULDER FUR CLUMPS — fluffy mass on shoulders, signature ape silhouette
	for side in [-1, 1]:
		for clump_i in range(2):
			var cx: float = side * (w * 0.50 + rng.randf_range(-w * 0.05, w * 0.10))
			var cy: float = shoulder_y + rng.randf_range(-h * 0.04, h * 0.10)
			var cz: float = rng.randf_range(-d * 0.25, d * 0.25)
			var clump_r: float = w * rng.randf_range(0.10, 0.14)
			_build_box(
				root,
				Vector3(cx - clump_r, cy - clump_r, cz - clump_r),
				Vector3(cx + clump_r, cy + clump_r, cz + clump_r),
				primary, 0.98
			)

	# ============================================================================
	# NECK + HEAD — short thick neck, broad ape head with protruding muzzle
	# ============================================================================
	var neck_base := Vector3(0, shoulder_y, 0)
	var head_anchor := Vector3(0, shoulder_y + h * 0.15, d * 0.05)
	_build_tapered_segment(root, neck_base, w * 0.22, head_anchor + Vector3(0, -h * 0.05, 0),
		w * 0.20, primary, 0.95)

	# Cranium — wider than tall, low forehead with prominent brow
	var cran_w: float = w * 0.32
	var cran_h: float = h * 0.18
	var cran_d: float = d * 0.70
	_build_box(
		root,
		Vector3(-cran_w, head_anchor.y - cran_h * 0.10, head_anchor.z - cran_d * 0.45),
		Vector3(cran_w, head_anchor.y + cran_h * 0.85, head_anchor.z + cran_d * 0.35),
		primary, 0.95
	)
	# HEAVY BROW RIDGE — protrudes above and forward of the eye line
	_build_box(
		root,
		Vector3(-cran_w * 1.05, head_anchor.y + cran_h * 0.40, head_anchor.z + cran_d * 0.25),
		Vector3(cran_w * 1.05, head_anchor.y + cran_h * 0.65, head_anchor.z + cran_d * 0.45),
		fur_dark, 0.98
	)
	# SAGITTAL CREST — bony midline ridge along the top of the cranium.
	# Only adult-male silverback gorillas have a prominent one — gate on
	# has_silverback per verify-agent.
	if has_silverback:
		_build_box(
			root,
			Vector3(-cran_w * 0.10, head_anchor.y + cran_h * 0.85, head_anchor.z - cran_d * 0.20),
			Vector3(cran_w * 0.10, head_anchor.y + cran_h * 1.15, head_anchor.z + cran_d * 0.20),
			fur_dark, 0.95
		)
	# FACE — exposed skin patch in the lower-front of the cranium
	_build_box(
		root,
		Vector3(-cran_w * 0.75, head_anchor.y - cran_h * 0.10, head_anchor.z + cran_d * 0.30),
		Vector3(cran_w * 0.75, head_anchor.y + cran_h * 0.40, head_anchor.z + cran_d * 0.50),
		face, 0.85
	)

	# PROTRUDING MUZZLE — extends forward from the face
	_build_box(
		root,
		Vector3(-cran_w * 0.55, head_anchor.y - cran_h * 0.30, head_anchor.z + cran_d * 0.45),
		Vector3(cran_w * 0.55, head_anchor.y + cran_h * 0.20, head_anchor.z + cran_d * 0.75),
		face, 0.85
	)
	# NOSTRIL flaps — two small dark holes on the muzzle front
	for side in [-1, 1]:
		_build_box(
			root,
			Vector3(side * cran_w * 0.18 - cran_w * 0.06, head_anchor.y + cran_h * 0.00, head_anchor.z + cran_d * 0.72),
			Vector3(side * cran_w * 0.18 + cran_w * 0.06, head_anchor.y + cran_h * 0.10, head_anchor.z + cran_d * 0.78),
			face_dark, 0.50
		)

	# EYES — small recessed under the brow
	for side in [-1, 1]:
		# Socket recess
		_build_box(
			root,
			Vector3(side * cran_w * 0.35 - cran_w * 0.18, head_anchor.y + cran_h * 0.18, head_anchor.z + cran_d * 0.40),
			Vector3(side * cran_w * 0.35 + cran_w * 0.18, head_anchor.y + cran_h * 0.38, head_anchor.z + cran_d * 0.50),
			Color(0.10, 0.08, 0.06), 0.50
		)
		# Iris dot
		_build_box(
			root,
			Vector3(side * cran_w * 0.35 - cran_w * 0.06, head_anchor.y + cran_h * 0.22, head_anchor.z + cran_d * 0.48),
			Vector3(side * cran_w * 0.35 + cran_w * 0.06, head_anchor.y + cran_h * 0.32, head_anchor.z + cran_d * 0.54),
			eye_color, 0.30, 0.10
		)

	# MOUTH — a dark horizontal slit across the muzzle bottom
	_build_box(
		root,
		Vector3(-cran_w * 0.40, head_anchor.y - cran_h * 0.22, head_anchor.z + cran_d * 0.70),
		Vector3(cran_w * 0.40, head_anchor.y - cran_h * 0.12, head_anchor.z + cran_d * 0.80),
		Color(0.10, 0.05, 0.05), 0.50
	)

	# Small EARS low on the head
	for side in [-1, 1]:
		_build_box(
			root,
			Vector3(side * cran_w * 1.00, head_anchor.y + cran_h * 0.05, head_anchor.z - cran_d * 0.10),
			Vector3(side * cran_w * 1.15, head_anchor.y + cran_h * 0.25, head_anchor.z + cran_d * 0.05),
			face_dark, 0.92
		)

	# ============================================================================
	# ARMS — VERY LONG (longer than legs), heavy, knuckle-walking pose
	# ============================================================================
	for side in [-1, 1]:
		var sh := Vector3(side * w * 0.58, shoulder_y - h * 0.02, 0)
		# Per verify-agent: lowered elbow (was hip_y + h*0.25 → now hip_y + h*0.05)
		# so the upper arm is longer and the forearm is dramatically long. Also
		# thickened upper arm bulk so the heavy gorilla brachiation muscles read.
		var elbow := Vector3(side * w * 0.70 * arm_length_jitter, hip_y + h * 0.05,
			d * 0.10)
		var knuckle := Vector3(side * w * 0.55 * arm_length_jitter, hip_y - h * 0.35,
			d * 0.18)
		# Upper arm — thicker
		_build_tapered_segment(root, sh, w * 0.20 * bulk_jitter, elbow, w * 0.16 * bulk_jitter,
			primary, 0.95)
		# Forearm
		_build_tapered_segment(root, elbow, w * 0.16 * bulk_jitter, knuckle,
			w * 0.14 * bulk_jitter, primary, 0.95)
		# Knuckle hand — knuckle-walking pose (hand pressed to ground)
		_build_box(
			root,
			Vector3(knuckle.x - w * 0.14, knuckle.y - h * 0.04, knuckle.z - d * 0.10),
			Vector3(knuckle.x + w * 0.14, knuckle.y + h * 0.06, knuckle.z + d * 0.14),
			face_dark, 0.85
		)
		# 4 stubby fingers + thumb (small dark knobs)
		for fi in range(4):
			var fo: float = (float(fi) - 1.5) * w * 0.06
			_build_box(
				root,
				Vector3(knuckle.x + fo - w * 0.020, knuckle.y - h * 0.05, knuckle.z + d * 0.10),
				Vector3(knuckle.x + fo + w * 0.020, knuckle.y + h * 0.02, knuckle.z + d * 0.18),
				face_dark, 0.85
			)
		# Thumb (opposable)
		_build_box(
			root,
			Vector3(knuckle.x - side * w * 0.16, knuckle.y - h * 0.03, knuckle.z + d * 0.04),
			Vector3(knuckle.x - side * w * 0.12, knuckle.y + h * 0.05, knuckle.z + d * 0.12),
			face_dark, 0.85
		)

	# ============================================================================
	# LEGS — SHORT and THICK, bent at the knee (crouched ape posture)
	# ============================================================================
	for side in [-1, 1]:
		var leg_jitter: float = rng.randf_range(0.92, 1.10)
		var hip_x: float = side * w * 0.22
		var hip_pos := Vector3(hip_x, hip_y - h * 0.02, 0)
		var knee := Vector3(hip_x * 1.20, clearance * 0.55 * leg_jitter, d * 0.10)
		var ankle := Vector3(hip_x, clearance * 0.15, d * 0.04)
		var foot := Vector3(hip_x, 0.0, d * 0.12)
		# Thigh
		_build_tapered_segment(root, hip_pos, w * 0.18 * bulk_jitter, knee,
			w * 0.16 * bulk_jitter, primary, 0.95)
		# Shin
		_build_tapered_segment(root, knee, w * 0.16 * bulk_jitter, ankle,
			w * 0.13 * bulk_jitter, primary, 0.95)
		# Foot — wide flat ape foot
		_build_box(
			root,
			Vector3(foot.x - w * 0.14, 0.0, foot.z - d * 0.18),
			Vector3(foot.x + w * 0.14, h * 0.06, foot.z + d * 0.22),
			face_dark, 0.88
		)
		# Toes (4 small + opposable big toe)
		for ti in range(4):
			var to: float = (float(ti) - 1.5) * w * 0.04
			_build_box(
				root,
				Vector3(foot.x + to - w * 0.016, 0.0, foot.z + d * 0.20),
				Vector3(foot.x + to + w * 0.016, h * 0.04, foot.z + d * 0.27),
				face_dark, 0.85
			)
		# Opposable big toe — to the side
		_build_box(
			root,
			Vector3(foot.x - side * w * 0.12, 0.0, foot.z + d * 0.04),
			Vector3(foot.x - side * w * 0.08, h * 0.06, foot.z + d * 0.14),
			face_dark, 0.85
		)

# ============================================================================
# ARCANALOTH (arcanaloth)
# Scholarly evil yugoloth — Monster Manual. A jackal-headed humanoid fiend
# wearing ornate robes, often holding a tome or staff.
#   - Tall slender humanoid in robes (mage-like silhouette)
#   - JACKAL HEAD (canine snout + large triangular ears)
#   - Fur on the head + hands + bare feet exposed
#   - Often holds a tome / staff / scroll
#   - Glowing eyes (red / yellow / green / violet)
#   - Ornate gold-trimmed scholar's robes (red / purple / black)
# ============================================================================

static func _build_arcanaloth(plan: Dictionary, root: Node3D) -> void:
	var base: Dictionary = plan.get("base", {})
	var palette: Dictionary = plan.get("palette", {})
	var limbs: Dictionary = plan.get("limbs", {})
	var meta: Dictionary = plan.get("meta", {})
	var species: String = String(meta.get("species", "Arcanaloth"))

	var w: float = _axis(base, "width", 0.65)
	var h: float = _axis(base, "height", 1.85)
	var d: float = _axis(base, "depth", 0.40)
	var leg_length: float = float(limbs.get("leg_length", 0.92))
	var clearance: float = leg_length

	var render_seed: int = int(meta.get("render_seed", 0))
	var rng := RandomNumberGenerator.new()
	rng.seed = render_seed if render_seed != 0 else hash(species)

	var size_jitter: float = rng.randf_range(0.92, 1.15)
	w *= size_jitter
	h *= size_jitter

	# Per-individual variation
	var robe_options := [
		Color(0.55, 0.10, 0.18),     # crimson (iconic)
		Color(0.20, 0.10, 0.30),     # dark purple
		Color(0.12, 0.10, 0.15),     # near-black
		Color(0.35, 0.05, 0.08),     # blood red
		Color(0.18, 0.25, 0.35),     # midnight blue
		Color(0.30, 0.18, 0.10),     # deep brown
	]
	var fur_options := [
		Color(0.72, 0.55, 0.30),     # golden jackal
		Color(0.55, 0.32, 0.18),     # red-brown
		Color(0.20, 0.18, 0.16),     # black
		Color(0.55, 0.50, 0.45),     # grey
		Color(0.85, 0.78, 0.62),     # cream
		Color(0.42, 0.35, 0.25),     # warm tawny
	]
	var eye_options := [
		Color(0.95, 0.20, 0.10),     # red
		Color(0.95, 0.85, 0.30),     # yellow
		Color(0.55, 0.95, 0.30),     # poison green
		Color(0.85, 0.30, 0.95),     # violet
		Color(0.95, 0.55, 0.10),     # amber
	]
	var weapon_kinds := ["tome", "staff", "scroll", "none"]
	var robe: Color = robe_options[rng.randi() % robe_options.size()]
	var robe_dark: Color = robe.darkened(0.30)
	var trim: Color = Color(0.85, 0.70, 0.20)              # always gold trim
	var fur: Color = fur_options[rng.randi() % fur_options.size()]
	var fur_dark: Color = fur.darkened(0.25)
	var eye_color: Color = eye_options[rng.randi() % eye_options.size()]
	var weapon_kind: String = weapon_kinds[rng.randi() % weapon_kinds.size()]
	var _skin_palette: Color = palette.get("skin", fur)

	# ============================================================================
	# ROBE BODY — long flowing scholar's robe, narrow waist, broad shoulders
	# ============================================================================
	var hip_y: float = clearance
	var waist_y: float = clearance + h * 0.18
	var chest_y: float = clearance + h * 0.42
	var shoulder_y: float = clearance + h * 0.62
	var robe_hem_y: float = clearance - h * 0.08            # hem just below feet
	var robe_sections: Array = [
		{"center": Vector3(0, robe_hem_y, 0), "w": w * 0.55, "h": w * 0.45},
		{"center": Vector3(0, hip_y - h * 0.04, 0), "w": w * 0.40, "h": w * 0.34},
		{"center": Vector3(0, waist_y, 0), "w": w * 0.34, "h": w * 0.28},      # narrow waist
		{"center": Vector3(0, chest_y, 0), "w": w * 0.45, "h": w * 0.32},
		{"center": Vector3(0, shoulder_y, 0), "w": w * 0.52, "h": w * 0.34},   # broad shoulders
	]
	_swept_body(root, robe_sections, 10, robe, Color(0,0,0,0), 0.92, true)

	# Hood draped over shoulders + a cowl reaching up to head height
	# (per verify-agent: previous was a back-bump, never reached the head).
	_build_box(
		root,
		Vector3(-w * 0.42, shoulder_y - h * 0.04, -w * 0.30),
		Vector3(w * 0.42, shoulder_y + h * 0.30, -w * 0.05),
		robe_dark, 0.95
	)
	# Cowl behind the head — wraps around the back of the cranium
	_build_box(
		root,
		Vector3(-w * 0.30, shoulder_y + h * 0.15, -w * 0.32),
		Vector3(w * 0.30, shoulder_y + h * 0.50, -w * 0.10),
		robe_dark, 0.95
	)
	# Gold trim hem ring
	for ti in range(12):
		var ang: float = TAU * float(ti) / 12.0
		var ang2: float = TAU * float(ti + 1) / 12.0
		var hem_r: float = w * 0.55
		var st_t := SurfaceTool.new()
		st_t.begin(Mesh.PRIMITIVE_TRIANGLES)
		var p0a := Vector3(cos(ang) * hem_r * 1.01, robe_hem_y + h * 0.04, sin(ang) * hem_r * 0.85)
		var p1a := Vector3(cos(ang2) * hem_r * 1.01, robe_hem_y + h * 0.04, sin(ang2) * hem_r * 0.85)
		var p0b := Vector3(cos(ang) * hem_r * 1.02, robe_hem_y - h * 0.02, sin(ang) * hem_r * 0.86)
		var p1b := Vector3(cos(ang2) * hem_r * 1.02, robe_hem_y - h * 0.02, sin(ang2) * hem_r * 0.86)
		_add_quad(st_t, p0a, p1a, p1b, p0b)
		st_t.generate_normals()
		var mi_t := MeshInstance3D.new()
		mi_t.mesh = st_t.commit()
		var mat_t := StandardMaterial3D.new()
		mat_t.albedo_color = trim
		mat_t.roughness = 0.30
		mat_t.metallic = 0.75
		mat_t.cull_mode = BaseMaterial3D.CULL_DISABLED
		mi_t.material_override = mat_t
		root.add_child(mi_t)
	# Gold chest sash
	_build_box(
		root,
		Vector3(-w * 0.40, chest_y - h * 0.02, w * 0.20),
		Vector3(w * 0.40, chest_y + h * 0.08, w * 0.26),
		trim, 0.30, 0.65
	)
	# Belt
	_build_box(
		root,
		Vector3(-w * 0.38, waist_y - h * 0.02, -w * 0.25),
		Vector3(w * 0.38, waist_y + h * 0.04, w * 0.25),
		trim, 0.30, 0.65
	)

	# ============================================================================
	# NECK + JACKAL HEAD
	# ============================================================================
	var neck_base := Vector3(0, shoulder_y + h * 0.04, 0)
	var head_anchor := Vector3(0, shoulder_y + h * 0.22, w * 0.04)
	_build_tapered_segment(root, neck_base, w * 0.12, head_anchor + Vector3(0, -h * 0.08, 0),
		w * 0.10, fur, 0.92)

	# Cranium — narrow elongated jackal skull
	var cran_w: float = w * 0.22
	var cran_h: float = h * 0.18
	var cran_d: float = d * 0.75
	_build_box(
		root,
		Vector3(-cran_w, head_anchor.y - cran_h * 0.05, head_anchor.z - cran_d * 0.40),
		Vector3(cran_w, head_anchor.y + cran_h * 0.85, head_anchor.z + cran_d * 0.45),
		fur, 0.92
	)
	# SNOUT — long protruding jackal snout
	_build_box(
		root,
		Vector3(-cran_w * 0.55, head_anchor.y - cran_h * 0.25, head_anchor.z + cran_d * 0.40),
		Vector3(cran_w * 0.55, head_anchor.y + cran_h * 0.20, head_anchor.z + cran_d * 0.85),
		fur, 0.92
	)
	# Lower jaw — slightly darker, slimmer
	_build_box(
		root,
		Vector3(-cran_w * 0.45, head_anchor.y - cran_h * 0.40, head_anchor.z + cran_d * 0.30),
		Vector3(cran_w * 0.45, head_anchor.y - cran_h * 0.18, head_anchor.z + cran_d * 0.80),
		fur_dark, 0.92
	)
	# Nose tip — small dark bump at snout end
	_build_box(
		root,
		Vector3(-cran_w * 0.15, head_anchor.y - cran_h * 0.05, head_anchor.z + cran_d * 0.80),
		Vector3(cran_w * 0.15, head_anchor.y + cran_h * 0.10, head_anchor.z + cran_d * 0.92),
		Color(0.10, 0.08, 0.06), 0.40
	)

	# TRIANGULAR JACKAL EARS — large, pointed, on top of head
	for side in [-1, 1]:
		var ear_base := Vector3(side * cran_w * 0.55, head_anchor.y + cran_h * 0.60, head_anchor.z - cran_d * 0.10)
		var ear_tip := Vector3(side * cran_w * 0.80, head_anchor.y + cran_h * 1.30, head_anchor.z - cran_d * 0.20)
		var ear_inner := Vector3(side * cran_w * 0.20, head_anchor.y + cran_h * 0.70, head_anchor.z - cran_d * 0.05)
		_emit_ear_tri(root, ear_base, ear_tip, ear_inner, fur)
		# Inner ear (lighter)
		var inner_tip := Vector3(side * cran_w * 0.55, head_anchor.y + cran_h * 1.05, head_anchor.z - cran_d * 0.10)
		_emit_ear_tri(root, ear_base, inner_tip, ear_inner, fur.lightened(0.30))

	# GLOWING EYES — anchored to the cranium SIDE above the snout root, not
	# floating in front of the snout. Per verify-agent.
	for side in [-1, 1]:
		# Socket recess
		_build_box(
			root,
			Vector3(side * cran_w * 0.35 - cran_w * 0.15, head_anchor.y + cran_h * 0.05, head_anchor.z + cran_d * 0.20),
			Vector3(side * cran_w * 0.35 + cran_w * 0.15, head_anchor.y + cran_h * 0.25, head_anchor.z + cran_d * 0.38),
			Color(0.08, 0.06, 0.06), 0.50
		)
		# Glowing iris
		_build_box(
			root,
			Vector3(side * cran_w * 0.35 - cran_w * 0.08, head_anchor.y + cran_h * 0.08, head_anchor.z + cran_d * 0.32),
			Vector3(side * cran_w * 0.35 + cran_w * 0.08, head_anchor.y + cran_h * 0.22, head_anchor.z + cran_d * 0.40),
			eye_color, 0.15, 0.40
		)
	# Fangs — two small white canines protruding from upper jaw
	for side in [-1, 1]:
		var fang_root := Vector3(side * cran_w * 0.30, head_anchor.y - cran_h * 0.15, head_anchor.z + cran_d * 0.70)
		var fang_tip := Vector3(side * cran_w * 0.30, head_anchor.y - cran_h * 0.30, head_anchor.z + cran_d * 0.72)
		_build_tapered_segment(root, fang_root, w * 0.020, fang_tip, w * 0.004,
			Color(0.92, 0.88, 0.72), 0.40)

	# ============================================================================
	# ARMS — slender with robe sleeves + furry hands with TALONS
	# ============================================================================
	for side in [-1, 1]:
		var sh := Vector3(side * w * 0.46, shoulder_y - h * 0.02, 0)
		var elbow := Vector3(side * w * 0.55, chest_y - h * 0.20, w * 0.05)
		var wrist := Vector3(side * w * 0.42, waist_y - h * 0.02, w * 0.10)
		# Robe sleeve (covers upper + most of forearm)
		_build_tapered_segment(root, sh, w * 0.12, elbow, w * 0.10, robe, 0.92)
		# Furry forearm peeking out below the sleeve
		_build_tapered_segment(root, elbow, w * 0.07, wrist, w * 0.06, fur, 0.92)
		# Sleeve cuff trim
		_build_box(
			root,
			Vector3(elbow.x - w * 0.13, elbow.y - h * 0.03, elbow.z - w * 0.10),
			Vector3(elbow.x + w * 0.13, elbow.y + h * 0.02, elbow.z + w * 0.10),
			trim, 0.30, 0.55
		)
		# Hand
		_build_box(
			root,
			Vector3(wrist.x - w * 0.06, wrist.y - h * 0.06, wrist.z - w * 0.05),
			Vector3(wrist.x + w * 0.06, wrist.y + h * 0.02, wrist.z + w * 0.05),
			fur, 0.92
		)
		# 4 talon claws — emerge FORWARD from the front of the hand (was
		# dangling down off the wrist per verify-agent).
		for fi in range(4):
			var fo: float = (float(fi) - 1.5) * w * 0.030
			var claw_base := Vector3(wrist.x + fo, wrist.y - h * 0.03, wrist.z + w * 0.05)
			var claw_tip := Vector3(wrist.x + fo, wrist.y - h * 0.05, wrist.z + w * 0.12)
			_build_tapered_segment(root, claw_base, w * 0.016, claw_tip, w * 0.002,
				fur_dark, 0.40)

	# ============================================================================
	# WEAPON — tome / staff / scroll / none (held in left hand for now)
	# ============================================================================
	var weapon_hand := Vector3(-w * 0.42, waist_y - h * 0.02, w * 0.10)
	if weapon_kind == "tome":
		# Closed book — flat box held against the chest
		_build_box(
			root,
			Vector3(weapon_hand.x - w * 0.18, weapon_hand.y - h * 0.02, weapon_hand.z + w * 0.05),
			Vector3(weapon_hand.x + w * 0.04, weapon_hand.y + h * 0.18, weapon_hand.z + w * 0.20),
			Color(0.45, 0.25, 0.15), 0.85
		)
		# Gold clasp / spine detail
		_build_box(
			root,
			Vector3(weapon_hand.x - w * 0.19, weapon_hand.y - h * 0.02, weapon_hand.z + w * 0.10),
			Vector3(weapon_hand.x - w * 0.16, weapon_hand.y + h * 0.18, weapon_hand.z + w * 0.16),
			trim, 0.30, 0.70
		)
	elif weapon_kind == "staff":
		var staff_bot := Vector3(weapon_hand.x, robe_hem_y - h * 0.05, weapon_hand.z + w * 0.06)
		var staff_top := Vector3(weapon_hand.x, clearance + h * 1.10, weapon_hand.z + w * 0.06)
		_build_tapered_segment(root, staff_bot, w * 0.026, staff_top, w * 0.022,
			Color(0.30, 0.20, 0.12), 0.85)
		# Glowing orb at the top
		_build_box(
			root,
			Vector3(staff_top.x - w * 0.10, staff_top.y - h * 0.04, staff_top.z - w * 0.10),
			Vector3(staff_top.x + w * 0.10, staff_top.y + h * 0.10, staff_top.z + w * 0.10),
			eye_color, 0.15, 0.45
		)
	elif weapon_kind == "scroll":
		# Rolled scroll — small cylinder held diagonally
		var scroll_bot := Vector3(weapon_hand.x - w * 0.04, weapon_hand.y - h * 0.05, weapon_hand.z + w * 0.08)
		var scroll_top := Vector3(weapon_hand.x + w * 0.06, weapon_hand.y + h * 0.18, weapon_hand.z + w * 0.18)
		_build_tapered_segment(root, scroll_bot, w * 0.030, scroll_top, w * 0.030,
			Color(0.92, 0.88, 0.65), 0.85)
		# Wax seal
		_build_box(
			root,
			Vector3(scroll_top.x - w * 0.025, scroll_top.y - h * 0.02, scroll_top.z - w * 0.025),
			Vector3(scroll_top.x + w * 0.025, scroll_top.y + h * 0.02, scroll_top.z + w * 0.025),
			Color(0.55, 0.05, 0.05), 0.60
		)

	# ============================================================================
	# FEET — small furry feet poking out below the robe
	# ============================================================================
	for side in [-1, 1]:
		var foot_x: float = side * w * 0.10
		_build_box(
			root,
			Vector3(foot_x - w * 0.08, 0.0, w * 0.02),
			Vector3(foot_x + w * 0.08, h * 0.05, w * 0.18),
			fur_dark, 0.90
		)

# ============================================================================
# ARCHMAGE (archmage)
# High-level humanoid wizard — D&D Monster Manual. The iconic D&D wizard:
#   - Robed humanoid in elaborate mage robes
#   - Pointy WIZARD HAT or hood (variant per individual)
#   - Long STAFF with crystal / orb top
#   - Big BEARD or long hair (varies)
#   - GLOWING runic glyphs floating around the hands / shoulders
#   - 1-3 small FLOATING BOOKS / SCROLLS orbiting overhead
#   - Old wizened face (sometimes) or stern younger mage
# ============================================================================

static func _build_archmage(plan: Dictionary, root: Node3D) -> void:
	var base: Dictionary = plan.get("base", {})
	var palette: Dictionary = plan.get("palette", {})
	var limbs: Dictionary = plan.get("limbs", {})
	var meta: Dictionary = plan.get("meta", {})
	var species: String = String(meta.get("species", "Archmage"))

	var w: float = _axis(base, "width", 0.60)
	var h: float = _axis(base, "height", 1.80)
	var d: float = _axis(base, "depth", 0.40)
	var leg_length: float = float(limbs.get("leg_length", 0.88))
	var clearance: float = leg_length

	var render_seed: int = int(meta.get("render_seed", 0))
	var rng := RandomNumberGenerator.new()
	rng.seed = render_seed if render_seed != 0 else hash(species)

	var size_jitter: float = rng.randf_range(0.92, 1.15)
	w *= size_jitter
	h *= size_jitter

	# Per-individual variation
	var robe_options := [
		Color(0.18, 0.22, 0.55),     # deep wizard blue
		Color(0.30, 0.10, 0.45),     # arcane purple
		Color(0.45, 0.08, 0.12),     # mage red
		Color(0.08, 0.10, 0.18),     # mystic black-blue
		Color(0.18, 0.30, 0.18),     # earth-mage green
		Color(0.55, 0.42, 0.10),     # sun-mage gold
		Color(0.78, 0.78, 0.85),     # white robes (high mage)
		Color(0.32, 0.15, 0.08),     # warm brown
	]
	var hat_kinds := ["pointy", "hood", "circlet", "none"]
	var hat_kind: String = hat_kinds[rng.randi() % hat_kinds.size()]
	var beard_kinds := ["long", "short", "none"]
	var beard_kind: String = beard_kinds[rng.randi() % beard_kinds.size()]
	var staff_kinds := ["staff", "wand", "none"]
	var staff_kind: String = staff_kinds[rng.randi() % staff_kinds.size()]
	var skin_options := [
		Color(0.92, 0.78, 0.65),     # pale
		Color(0.65, 0.45, 0.32),     # tan
		Color(0.42, 0.28, 0.20),     # brown
		Color(0.85, 0.72, 0.58),     # warm
	]
	var beard_options := [
		Color(0.85, 0.85, 0.85),     # wizard white
		Color(0.55, 0.50, 0.45),     # grey
		Color(0.18, 0.15, 0.10),     # black
		Color(0.45, 0.30, 0.18),     # brown
		Color(0.78, 0.55, 0.20),     # ginger
	]
	var rune_options := [
		Color(0.40, 0.85, 1.00),     # cyan
		Color(0.95, 0.85, 0.30),     # gold
		Color(0.95, 0.55, 1.00),     # violet
		Color(0.55, 0.95, 0.55),     # green
		Color(0.95, 0.20, 0.20),     # crimson
	]
	var robe: Color = robe_options[rng.randi() % robe_options.size()]
	var robe_dark: Color = robe.darkened(0.25)
	var trim: Color = Color(0.85, 0.70, 0.20)             # gold trim
	var skin: Color = skin_options[rng.randi() % skin_options.size()]
	var beard_color: Color = beard_options[rng.randi() % beard_options.size()]
	var rune_color: Color = rune_options[rng.randi() % rune_options.size()]
	var eye_color: Color = palette.get("eye", rune_color)

	# ============================================================================
	# ROBE BODY — long flowing wizard robe
	# ============================================================================
	var hip_y: float = clearance
	var waist_y: float = clearance + h * 0.20
	var chest_y: float = clearance + h * 0.42
	var shoulder_y: float = clearance + h * 0.62
	var robe_hem_y: float = clearance - h * 0.08
	var robe_sections: Array = [
		{"center": Vector3(0, robe_hem_y, 0), "w": w * 0.55, "h": w * 0.45},
		{"center": Vector3(0, hip_y - h * 0.04, 0), "w": w * 0.40, "h": w * 0.32},
		{"center": Vector3(0, waist_y, 0), "w": w * 0.32, "h": w * 0.26},
		{"center": Vector3(0, chest_y, 0), "w": w * 0.42, "h": w * 0.30},
		{"center": Vector3(0, shoulder_y, 0), "w": w * 0.48, "h": w * 0.32},
	]
	_swept_body(root, robe_sections, 10, robe, Color(0,0,0,0), 0.92, true)

	# Gold trim hem
	for ti in range(12):
		var ang: float = TAU * float(ti) / 12.0
		var ang2: float = TAU * float(ti + 1) / 12.0
		var hem_r: float = w * 0.55
		var st_t := SurfaceTool.new()
		st_t.begin(Mesh.PRIMITIVE_TRIANGLES)
		var p0a := Vector3(cos(ang) * hem_r * 1.01, robe_hem_y + h * 0.04, sin(ang) * hem_r * 0.85)
		var p1a := Vector3(cos(ang2) * hem_r * 1.01, robe_hem_y + h * 0.04, sin(ang2) * hem_r * 0.85)
		var p0b := Vector3(cos(ang) * hem_r * 1.02, robe_hem_y - h * 0.02, sin(ang) * hem_r * 0.86)
		var p1b := Vector3(cos(ang2) * hem_r * 1.02, robe_hem_y - h * 0.02, sin(ang2) * hem_r * 0.86)
		_add_quad(st_t, p0a, p1a, p1b, p0b)
		st_t.generate_normals()
		var mi_t := MeshInstance3D.new()
		mi_t.mesh = st_t.commit()
		var mat_t := StandardMaterial3D.new()
		mat_t.albedo_color = trim
		mat_t.roughness = 0.30
		mat_t.metallic = 0.75
		mat_t.cull_mode = BaseMaterial3D.CULL_DISABLED
		mi_t.material_override = mat_t
		root.add_child(mi_t)
	# Sash WRAPS around the chest (was a thin front-only slab per verify-agent)
	_build_box(
		root,
		Vector3(-w * 0.44, chest_y - h * 0.02, -w * 0.24),
		Vector3(w * 0.44, chest_y + h * 0.06, w * 0.24),
		trim, 0.30, 0.65
	)
	# Belt — already wraps full circumference
	_build_box(
		root,
		Vector3(-w * 0.35, waist_y - h * 0.02, -w * 0.22),
		Vector3(w * 0.35, waist_y + h * 0.04, w * 0.22),
		trim, 0.30, 0.65
	)
	# RUNIC GLYPHS on the chest — small glowing symbols
	for gi in range(4):
		var gx: float = lerpf(-w * 0.30, w * 0.30, float(gi) / 3.0)
		var gy: float = chest_y + h * 0.18
		_build_box(
			root,
			Vector3(gx - w * 0.04, gy - h * 0.025, w * 0.21),
			Vector3(gx + w * 0.04, gy + h * 0.025, w * 0.26),
			rune_color, 0.15, 0.35
		)

	# ============================================================================
	# NECK + HEAD
	# ============================================================================
	var neck_base := Vector3(0, shoulder_y + h * 0.04, 0)
	var head_anchor := Vector3(0, shoulder_y + h * 0.20, w * 0.04)
	_build_tapered_segment(root, neck_base, w * 0.10, head_anchor + Vector3(0, -h * 0.05, 0),
		w * 0.09, skin, 0.85)

	# Cranium
	var head_r: float = w * 0.20
	var head_sections: Array = [
		{"center": Vector3(0, head_anchor.y - head_r * 0.5, w * 0.02), "w": head_r * 0.70, "h": head_r * 0.60},
		{"center": Vector3(0, head_anchor.y, w * 0.02), "w": head_r, "h": head_r * 0.95},
		{"center": Vector3(0, head_anchor.y + head_r * 0.45, w * 0.02), "w": head_r * 0.92, "h": head_r * 0.88},
		{"center": Vector3(0, head_anchor.y + head_r * 0.80, w * 0.02), "w": head_r * 0.55, "h": head_r * 0.50},
	]
	_swept_body(root, head_sections, 10, skin, Color(0,0,0,0), 0.80, true)

	# EYES — anchored to the true head front face (was barely poking through
	# with 0.008 depth → Z-fighting). Now sits proud with proper bead depth.
	var face_z: float = w * 0.02 + head_r * 0.95
	for side in [-1, 1]:
		var ex: float = side * head_r * 0.30
		var ey: float = head_anchor.y + head_r * 0.08
		_build_box(
			root,
			Vector3(ex - head_r * 0.10, ey, face_z),
			Vector3(ex + head_r * 0.10, ey + head_r * 0.12, face_z + head_r * 0.10),
			eye_color, 0.20, 0.30
		)
	# Nose bump
	_build_box(
		root,
		Vector3(-head_r * 0.06, head_anchor.y - head_r * 0.05, face_z),
		Vector3(head_r * 0.06, head_anchor.y + head_r * 0.08, face_z + head_r * 0.18),
		skin.darkened(0.05), 0.85
	)

	# BEARD — variant
	if beard_kind == "long":
		# Long flowing beard from chin to chest
		var beard_top := Vector3(0, head_anchor.y - head_r * 0.30, face_z)
		var beard_mid := Vector3(0, chest_y + h * 0.15, face_z + w * 0.05)
		var beard_bot := Vector3(0, chest_y - h * 0.05, face_z + w * 0.10)
		_build_tapered_segment(root, beard_top, w * 0.10, beard_mid, w * 0.12,
			beard_color, 0.95)
		_build_tapered_segment(root, beard_mid, w * 0.12, beard_bot, w * 0.06,
			beard_color, 0.95)
		# Mustache
		for side in [-1, 1]:
			var must_root := Vector3(side * head_r * 0.10, head_anchor.y - head_r * 0.20, face_z)
			var must_tip := Vector3(side * head_r * 0.40, head_anchor.y - head_r * 0.30, face_z + w * 0.02)
			_build_tapered_segment(root, must_root, w * 0.025, must_tip, w * 0.008,
				beard_color, 0.95)
	elif beard_kind == "short":
		# Short scruffy beard hugging the jaw
		_build_box(
			root,
			Vector3(-head_r * 0.50, head_anchor.y - head_r * 0.40, face_z - 0.005),
			Vector3(head_r * 0.50, head_anchor.y - head_r * 0.15, face_z + 0.015),
			beard_color, 0.95
		)

	# ============================================================================
	# HAT — per-individual variant
	# ============================================================================
	var hat_y_base: float = head_anchor.y + head_r * 0.85
	if hat_kind == "pointy":
		# Tall pointed wizard hat — tapers to a tip
		var hat_sections: Array = [
			{"center": Vector3(0, hat_y_base, w * 0.02), "w": head_r * 1.20, "h": head_r * 1.10},  # brim
			{"center": Vector3(0, hat_y_base + h * 0.05, w * 0.02), "w": head_r * 0.85, "h": head_r * 0.80},
			{"center": Vector3(0, hat_y_base + h * 0.25, w * 0.02), "w": head_r * 0.55, "h": head_r * 0.50},
			{"center": Vector3(0, hat_y_base + h * 0.50, w * 0.04), "w": head_r * 0.20, "h": head_r * 0.20},  # tip-bend
			{"center": Vector3(0, hat_y_base + h * 0.65, w * 0.10), "w": head_r * 0.05, "h": head_r * 0.05},  # tip
		]
		_swept_body(root, hat_sections, 8, robe_dark, Color(0,0,0,0), 0.95, true)
		# Hat band trim
		_build_box(
			root,
			Vector3(-head_r * 1.15, hat_y_base + h * 0.02, w * 0.02 - head_r * 1.15),
			Vector3(head_r * 1.15, hat_y_base + h * 0.06, w * 0.02 + head_r * 1.15),
			trim, 0.30, 0.65
		)
		# Star or crescent at the tip
		var ornament_pos := Vector3(0, hat_y_base + h * 0.70, w * 0.10)
		_build_box(
			root,
			ornament_pos - Vector3(head_r * 0.10, head_r * 0.10, head_r * 0.05),
			ornament_pos + Vector3(head_r * 0.10, head_r * 0.10, head_r * 0.05),
			rune_color, 0.20, 0.40
		)
	elif hat_kind == "hood":
		# Hood — built as a vertical 3-section swept body that wraps the head
		# from the back, with sections OFFSET BACKWARD in Z so the front of
		# the head is exposed (face visible inside the cowl).
		var hood_sections: Array = [
			{"center": Vector3(0, head_anchor.y - head_r * 0.15, -head_r * 0.10),
			 "w": head_r * 1.20, "h": head_r * 1.10},
			{"center": Vector3(0, head_anchor.y + head_r * 0.40, -head_r * 0.15),
			 "w": head_r * 1.15, "h": head_r * 1.05},
			{"center": Vector3(0, hat_y_base + h * 0.05, -head_r * 0.20),
			 "w": head_r * 0.95, "h": head_r * 0.90},
		]
		_swept_body(root, hood_sections, 10, robe_dark, Color(0,0,0,0), 0.95, true)
	elif hat_kind == "circlet":
		# Gold circlet around the brow
		for ci in range(10):
			var ang: float = TAU * float(ci) / 10.0
			var ang2: float = TAU * float(ci + 1) / 10.0
			var crc_r: float = head_r * 1.05
			var crc_y: float = head_anchor.y + head_r * 0.40
			var crc_p1 := Vector3(cos(ang) * crc_r, crc_y, w * 0.02 + sin(ang) * crc_r)
			var crc_p2 := Vector3(cos(ang2) * crc_r, crc_y, w * 0.02 + sin(ang2) * crc_r)
			_build_tapered_segment(root, crc_p1, w * 0.020, crc_p2, w * 0.020,
				trim, 0.25, 0.70)
		# Gem at the front
		_build_box(
			root,
			Vector3(-head_r * 0.08, head_anchor.y + head_r * 0.40, w * 0.02 + head_r * 1.05),
			Vector3(head_r * 0.08, head_anchor.y + head_r * 0.55, w * 0.02 + head_r * 1.15),
			rune_color, 0.15, 0.50
		)

	# ============================================================================
	# ARMS — slim with wide robe sleeves
	# ============================================================================
	for side in [-1, 1]:
		var sh := Vector3(side * w * 0.42, shoulder_y - h * 0.02, 0)
		var elbow := Vector3(side * w * 0.50, chest_y - h * 0.20, w * 0.05)
		var wrist := Vector3(side * w * 0.40, waist_y, w * 0.10)
		_build_tapered_segment(root, sh, w * 0.12, elbow, w * 0.08, robe, 0.92)
		_build_tapered_segment(root, elbow, w * 0.07, wrist, w * 0.055, skin, 0.85)
		# Hand
		_build_box(
			root,
			Vector3(wrist.x - w * 0.05, wrist.y - h * 0.07, wrist.z - w * 0.05),
			Vector3(wrist.x + w * 0.05, wrist.y + h * 0.02, wrist.z + w * 0.05),
			skin, 0.85
		)
		# Sleeve cuff
		_build_box(
			root,
			Vector3(elbow.x - w * 0.13, elbow.y - h * 0.03, elbow.z - w * 0.10),
			Vector3(elbow.x + w * 0.13, elbow.y + h * 0.02, elbow.z + w * 0.10),
			trim, 0.30, 0.55
		)

	# ============================================================================
	# STAFF / WAND in the right hand
	# ============================================================================
	var weapon_hand := Vector3(w * 0.40, waist_y, w * 0.10)
	if staff_kind == "staff":
		var staff_bot := Vector3(weapon_hand.x, robe_hem_y - h * 0.05, weapon_hand.z + w * 0.06)
		var staff_top := Vector3(weapon_hand.x, clearance + h * 1.25, weapon_hand.z + w * 0.06)
		_build_tapered_segment(root, staff_bot, w * 0.028, staff_top, w * 0.024,
			Color(0.45, 0.30, 0.18), 0.85)
		# Glowing CRYSTAL/orb at the top
		_build_box(
			root,
			Vector3(staff_top.x - w * 0.10, staff_top.y - h * 0.05, staff_top.z - w * 0.10),
			Vector3(staff_top.x + w * 0.10, staff_top.y + h * 0.12, staff_top.z + w * 0.10),
			rune_color, 0.15, 0.50
		)
		# Claw mount around orb (3 prongs)
		for ki in range(3):
			var kang: float = TAU * float(ki) / 3.0
			var k_base := Vector3(staff_top.x + cos(kang) * w * 0.08, staff_top.y - h * 0.05,
				staff_top.z + sin(kang) * w * 0.08)
			var k_tip := Vector3(staff_top.x + cos(kang) * w * 0.13, staff_top.y + h * 0.10,
				staff_top.z + sin(kang) * w * 0.13)
			_build_tapered_segment(root, k_base, w * 0.020, k_tip, w * 0.005,
				Color(0.55, 0.40, 0.20), 0.85)
	elif staff_kind == "wand":
		var wand_root := Vector3(weapon_hand.x, weapon_hand.y - h * 0.04, weapon_hand.z + w * 0.06)
		var wand_tip := Vector3(weapon_hand.x + w * 0.10, weapon_hand.y + h * 0.20, weapon_hand.z + w * 0.20)
		_build_tapered_segment(root, wand_root, w * 0.018, wand_tip, w * 0.006,
			Color(0.40, 0.25, 0.15), 0.80)
		# Glowing tip
		_build_box(
			root,
			Vector3(wand_tip.x - w * 0.030, wand_tip.y - w * 0.020, wand_tip.z - w * 0.030),
			Vector3(wand_tip.x + w * 0.030, wand_tip.y + w * 0.040, wand_tip.z + w * 0.030),
			rune_color, 0.10, 0.50
		)

	# ============================================================================
	# FLOATING BOOKS — 1-3 small floating tomes orbiting overhead
	# ============================================================================
	var book_count: int = rng.randi_range(0, 3)
	for bi in range(book_count):
		var bang: float = TAU * float(bi) / max(float(book_count), 1.0) + rng.randf_range(0.0, 1.0)
		var br: float = w * 0.85
		var by: float = clearance + h * 1.25 + rng.randf_range(-h * 0.05, h * 0.05)
		var b_pos := Vector3(cos(bang) * br, by, sin(bang) * br * 0.6 + w * 0.04)
		_build_box(
			root,
			b_pos - Vector3(w * 0.08, w * 0.05, w * 0.12),
			b_pos + Vector3(w * 0.08, w * 0.05, w * 0.12),
			Color(0.55, 0.30, 0.18), 0.85
		)
		# Gold spine
		_build_box(
			root,
			b_pos - Vector3(w * 0.082, w * 0.05, w * 0.05),
			b_pos + Vector3(-w * 0.075, w * 0.05, w * 0.05),
			trim, 0.30, 0.70
		)

	# ============================================================================
	# FEET — small skin feet poking out
	# ============================================================================
	for side in [-1, 1]:
		var foot_x: float = side * w * 0.10
		_build_box(
			root,
			Vector3(foot_x - w * 0.07, 0.0, w * 0.02),
			Vector3(foot_x + w * 0.07, h * 0.05, w * 0.16),
			Color(0.30, 0.20, 0.12), 0.85    # leather shoes
		)

# ============================================================================
# ARCTIC BLINDFISH (arctic_blindfish)
# Small pale cave / under-ice fish — D&D Acquisitions Inc fauna.
#   - Small elongated streamlined fish body
#   - Translucent pale skin (pink-white / cream / ice-blue)
#   - NO EYES (vestigial — adapted to dark caves under ice)
#   - Small dorsal + anal + pectoral fins, simple tail fan
#   - Mouth at the front, sometimes slightly down-turned
#   - Lateral line of small bioluminescent dots (sensory organ)
# ============================================================================

static func _build_arctic_blindfish(plan: Dictionary, root: Node3D) -> void:
	var base: Dictionary = plan.get("base", {})
	var palette: Dictionary = plan.get("palette", {})
	var meta: Dictionary = plan.get("meta", {})
	var species: String = String(meta.get("species", "Arctic Blindfish"))

	# Small fish — width ≈ height (round-ish), elongated in depth
	var w: float = _axis(base, "width", 0.30)
	var h: float = _axis(base, "height", 0.28)
	var d: float = _axis(base, "depth", 0.85)

	# Hovers (it's a fish — no legs)
	var hover: float = h * 0.50
	var body_y: float = hover

	var render_seed: int = int(meta.get("render_seed", 0))
	var rng := RandomNumberGenerator.new()
	rng.seed = render_seed if render_seed != 0 else hash(species)

	# Per-individual variation
	var size_jitter: float = rng.randf_range(0.85, 1.25)
	var has_vestigial_eyes: bool = rng.randf() > 0.5    # 50/50 — some keep eye spots
	var lateral_dot_count: int = rng.randi_range(5, 9)
	w *= size_jitter
	h *= size_jitter
	d *= size_jitter * rng.randf_range(0.95, 1.15)

	# Pale cave-fish palette — all near-white / translucent
	var pale_options := [
		Color(0.95, 0.88, 0.85),     # pink-white (classic albino)
		Color(0.92, 0.94, 0.95),     # cream-white
		Color(0.85, 0.88, 0.92),     # ice blue-white
		Color(0.88, 0.85, 0.92),     # lavender-white
		Color(0.95, 0.95, 0.95),     # pure white
		Color(0.82, 0.85, 0.80),     # pale green-grey
	]
	var lum_options := [
		Color(0.55, 0.95, 1.00),     # bioluminescent cyan
		Color(0.95, 0.95, 0.60),     # pale yellow
		Color(0.55, 0.95, 0.55),     # toxic green
		Color(0.95, 0.55, 0.95),     # magenta
	]
	var primary: Color = pale_options[rng.randi() % pale_options.size()]
	var belly: Color = primary.lightened(0.10)
	var fin_color: Color = primary.darkened(0.05)
	var lum: Color = lum_options[rng.randi() % lum_options.size()]
	var mouth_color := Color(0.55, 0.35, 0.40)
	var eye_color: Color = palette.get("eye", Color(0.40, 0.25, 0.20))

	# ============================================================================
	# BODY — elongated streamlined fish. 6 sections, tapered at both ends.
	# ============================================================================
	var body_sections: Array = [
		{"center": Vector3(0, body_y, -d * 0.45), "w": w * 0.06, "h": h * 0.10},    # tail end
		{"center": Vector3(0, body_y, -d * 0.30), "w": w * 0.18, "h": h * 0.22},
		{"center": Vector3(0, body_y, -d * 0.10), "w": w * 0.32, "h": h * 0.36},
		{"center": Vector3(0, body_y, d * 0.10),  "w": w * 0.36, "h": h * 0.40},    # widest
		{"center": Vector3(0, body_y, d * 0.28),  "w": w * 0.28, "h": h * 0.32},
		{"center": Vector3(0, body_y - h * 0.02, d * 0.42), "w": w * 0.15, "h": h * 0.18},   # snout
	]
	_swept_body(root, body_sections, 10, primary, belly, 0.40, true)

	# Slight translucency — pale fish look (skip if it causes sorting issues)
	# Done via the existing material in _swept_body; pale color does most of the work.

	# ============================================================================
	# MOUTH — small dark slit at the front (slightly down-turned)
	# ============================================================================
	_build_box(
		root,
		Vector3(-w * 0.08, body_y - h * 0.10, d * 0.44),
		Vector3(w * 0.08, body_y - h * 0.04, d * 0.50),
		mouth_color, 0.50
	)
	# Tiny teeth row
	for ti in range(3):
		var tt: float = float(ti) / 2.0
		var tx: float = lerpf(-w * 0.05, w * 0.05, tt)
		_build_box(
			root,
			Vector3(tx - w * 0.006, body_y - h * 0.07, d * 0.48),
			Vector3(tx + w * 0.006, body_y - h * 0.02, d * 0.52),
			Color(0.92, 0.88, 0.78), 0.50
		)

	# ============================================================================
	# EYES — most blindfish have NO eyes (vestigial). 50% have tiny dark
	# rudimentary spots; the other 50% are eyeless caps.
	# ============================================================================
	if has_vestigial_eyes:
		for side in [-1, 1]:
			_build_box(
				root,
				Vector3(side * w * 0.18, body_y + h * 0.08, d * 0.30),
				Vector3(side * w * 0.22, body_y + h * 0.13, d * 0.36),
				eye_color, 0.50
			)
	else:
		# Smooth blind eye-cap — slightly darker patch where eyes WOULD be
		for side in [-1, 1]:
			_build_box(
				root,
				Vector3(side * w * 0.16, body_y + h * 0.05, d * 0.28),
				Vector3(side * w * 0.24, body_y + h * 0.15, d * 0.38),
				primary.darkened(0.08), 0.55
			)

	# ============================================================================
	# LATERAL LINE — row of small DARK PORE-DOTS along the side (sensory
	# mechanoreceptor pores, NOT bioluminescent — per verify-agent / biology).
	# ============================================================================
	var pore_color: Color = primary.darkened(0.20)
	for li in range(lateral_dot_count):
		var lt: float = float(li) / float(lateral_dot_count - 1)
		var lz: float = lerpf(-d * 0.32, d * 0.30, lt)
		var lh_local: float = lerpf(h * 0.18, h * 0.38, sin(lt * PI))
		for side in [-1, 1]:
			var lx_local: float = w * lh_local / h * 0.95     # approximate body surface
			var dot_pos := Vector3(side * lx_local, body_y, lz)
			_build_box(
				root,
				dot_pos - Vector3(w * 0.012, h * 0.012, w * 0.012),
				dot_pos + Vector3(w * 0.012, h * 0.012, w * 0.012),
				pore_color, 0.80
			)
	# Silence unused warning for the lum palette (kept in scope for future use)
	var _unused_lum := lum

	# ============================================================================
	# PECTORAL FINS — small modest fins (was too large/wing-like per verify)
	# ============================================================================
	for side in [-1, 1]:
		var pec_root := Vector3(side * w * 0.30, body_y - h * 0.05, d * 0.05)
		var pec_tip_top := Vector3(side * w * 0.42, body_y + h * 0.02, -d * 0.02)
		var pec_tip_bot := Vector3(side * w * 0.42, body_y - h * 0.10, -d * 0.02)
		var st_pec := SurfaceTool.new()
		st_pec.begin(Mesh.PRIMITIVE_TRIANGLES)
		_add_tri(st_pec, pec_root, pec_tip_top, pec_tip_bot)
		_add_tri(st_pec, pec_root, pec_tip_bot, pec_tip_top)   # backface
		st_pec.generate_normals()
		var mi_pec := MeshInstance3D.new()
		mi_pec.mesh = st_pec.commit()
		var mat_pec := StandardMaterial3D.new()
		mat_pec.albedo_color = fin_color
		mat_pec.roughness = 0.30
		mat_pec.cull_mode = BaseMaterial3D.CULL_DISABLED
		mi_pec.material_override = mat_pec
		root.add_child(mi_pec)

	# ============================================================================
	# DORSAL FIN — small triangular fin on top mid-back
	# ============================================================================
	# Dorsal fin moved FORWARD + shorter per verify-agent (cave fish have
	# modest forward dorsals, not tall mid-back fins).
	var dorsal_root_l := Vector3(-0.005, body_y + h * 0.30, d * 0.05)
	var dorsal_root_r := Vector3(0.005, body_y + h * 0.30, d * 0.05)
	var dorsal_tip := Vector3(0, body_y + h * 0.42, 0)
	var dorsal_back := Vector3(0, body_y + h * 0.28, -d * 0.08)
	var st_dorsal := SurfaceTool.new()
	st_dorsal.begin(Mesh.PRIMITIVE_TRIANGLES)
	_add_tri(st_dorsal, dorsal_root_l, dorsal_tip, dorsal_back)
	_add_tri(st_dorsal, dorsal_root_r, dorsal_back, dorsal_tip)
	st_dorsal.generate_normals()
	var mi_dorsal := MeshInstance3D.new()
	mi_dorsal.mesh = st_dorsal.commit()
	var mat_dorsal := StandardMaterial3D.new()
	mat_dorsal.albedo_color = fin_color
	mat_dorsal.roughness = 0.30
	mat_dorsal.cull_mode = BaseMaterial3D.CULL_DISABLED
	mi_dorsal.material_override = mat_dorsal
	root.add_child(mi_dorsal)

	# ============================================================================
	# ANAL FIN — bottom fin mirrored to dorsal
	# ============================================================================
	var anal_root_l := Vector3(-0.005, body_y - h * 0.28, -d * 0.05)
	var anal_root_r := Vector3(0.005, body_y - h * 0.28, -d * 0.05)
	var anal_tip := Vector3(0, body_y - h * 0.50, -d * 0.12)
	var anal_back := Vector3(0, body_y - h * 0.26, -d * 0.18)
	var st_anal := SurfaceTool.new()
	st_anal.begin(Mesh.PRIMITIVE_TRIANGLES)
	_add_tri(st_anal, anal_root_l, anal_back, anal_tip)
	_add_tri(st_anal, anal_root_r, anal_tip, anal_back)
	st_anal.generate_normals()
	var mi_anal := MeshInstance3D.new()
	mi_anal.mesh = st_anal.commit()
	mi_anal.material_override = mat_dorsal
	root.add_child(mi_anal)

	# ============================================================================
	# TAIL FIN — vertical fan at the rear
	# ============================================================================
	var tail_pivot := Vector3(0, body_y, -d * 0.45)
	var tail_top := Vector3(0, body_y + h * 0.40, -d * 0.60)
	var tail_bot := Vector3(0, body_y - h * 0.40, -d * 0.60)
	var tail_back := Vector3(0, body_y, -d * 0.65)
	var st_tail := SurfaceTool.new()
	st_tail.begin(Mesh.PRIMITIVE_TRIANGLES)
	_add_tri(st_tail, tail_pivot + Vector3(-0.005, 0, 0), tail_top, tail_back)
	_add_tri(st_tail, tail_pivot + Vector3(0.005, 0, 0), tail_back, tail_top)
	_add_tri(st_tail, tail_pivot + Vector3(-0.005, 0, 0), tail_back, tail_bot)
	_add_tri(st_tail, tail_pivot + Vector3(0.005, 0, 0), tail_bot, tail_back)
	st_tail.generate_normals()
	var mi_tail := MeshInstance3D.new()
	mi_tail.mesh = st_tail.commit()
	mi_tail.material_override = mat_dorsal
	root.add_child(mi_tail)

# ============================================================================
# ARCTIC CHAR (arctic_char)
# Cold-water salmonid food fish. Silvery-blue back, pink-red spawning belly,
# white fin edges, bright spots, forked tail.
# ============================================================================

static func _build_arctic_char(plan: Dictionary, root: Node3D) -> void:
	var base: Dictionary = plan.get("base", {})
	var palette: Dictionary = plan.get("palette", {})
	var meta: Dictionary = plan.get("meta", {})
	var species: String = String(meta.get("species", "Arctic Char"))

	var w: float = _axis(base, "width", 0.32)
	var h: float = _axis(base, "height", 0.40)
	var d: float = _axis(base, "depth", 1.10)
	var hover: float = h * 0.55
	var body_y: float = hover

	var render_seed: int = int(meta.get("render_seed", 0))
	var rng := RandomNumberGenerator.new()
	rng.seed = render_seed if render_seed != 0 else hash(species)

	var size_jitter: float = rng.randf_range(0.85, 1.25)
	var spot_count: int = rng.randi_range(8, 16)
	w *= size_jitter
	h *= size_jitter
	d *= size_jitter * rng.randf_range(0.95, 1.10)

	var color_phases := ["silver", "spawning", "juvenile", "dark_blue"]
	var color_phase: String = color_phases[rng.randi() % color_phases.size()]

	var primary: Color
	var belly: Color
	var spot_color: Color
	match color_phase:
		"silver":
			primary = Color(0.35, 0.50, 0.65)        # silvery-BLUE back (was too grey)
			belly = Color(0.88, 0.90, 0.92)
			spot_color = Color(0.95, 0.75, 0.70)     # pale pink spots (iconic char)
		"spawning":
			primary = Color(0.25, 0.30, 0.28)        # dark olive back
			belly = Color(0.95, 0.20, 0.18)          # vivid spawning RED
			spot_color = Color(0.95, 0.55, 0.30)     # warm orange spots
		"juvenile":
			primary = Color(0.32, 0.42, 0.28)
			belly = Color(0.65, 0.78, 0.55)
			spot_color = Color(0.95, 0.88, 0.40)
		_:
			primary = Color(0.22, 0.28, 0.40)
			belly = Color(0.65, 0.72, 0.78)
			spot_color = Color(0.55, 0.85, 0.95)
	var fin_color: Color = primary.darkened(0.10)
	var fin_white_edge := Color(0.95, 0.95, 0.92)
	var eye_color: Color = palette.get("eye", Color(0.05, 0.04, 0.03))
	var mouth_color := Color(0.55, 0.35, 0.30)

	# BODY — torpedo
	var body_sections: Array = [
		{"center": Vector3(0, body_y, -d * 0.48), "w": w * 0.04, "h": h * 0.08},
		{"center": Vector3(0, body_y, -d * 0.32), "w": w * 0.20, "h": h * 0.24},
		{"center": Vector3(0, body_y, -d * 0.12), "w": w * 0.34, "h": h * 0.40},
		{"center": Vector3(0, body_y, d * 0.08), "w": w * 0.40, "h": h * 0.48},
		{"center": Vector3(0, body_y, d * 0.25), "w": w * 0.35, "h": h * 0.42},
		{"center": Vector3(0, body_y - h * 0.02, d * 0.40), "w": w * 0.20, "h": h * 0.24},
	]
	_swept_body(root, body_sections, 10, primary, belly, 0.50, true)

	# MOUTH + EYES + GILL COVER
	_build_box(root,
		Vector3(-w * 0.10, body_y - h * 0.08, d * 0.42),
		Vector3(w * 0.10, body_y - h * 0.02, d * 0.50),
		mouth_color, 0.55)
	for side in [-1, 1]:
		_build_box(root,
			Vector3(side * w * 0.18, body_y + h * 0.08, d * 0.32),
			Vector3(side * w * 0.25, body_y + h * 0.18, d * 0.40),
			eye_color, 0.30)
		_build_box(root,
			Vector3(side * w * 0.20, body_y + h * 0.13, d * 0.38),
			Vector3(side * w * 0.22, body_y + h * 0.17, d * 0.40),
			Color(0.85, 0.85, 0.85), 0.30)
		_build_box(root,
			Vector3(side * w * 0.30, body_y - h * 0.18, d * 0.20),
			Vector3(side * w * 0.34, body_y + h * 0.22, d * 0.24),
			primary.darkened(0.20), 0.50)

	# SPOTS — bright spots on the back/sides (iconic char marking)
	for _si in range(spot_count):
		var sz: float = rng.randf_range(-d * 0.30, d * 0.20)
		var s_side: float = 1.0 if rng.randf() > 0.5 else -1.0
		var s_ang: float = rng.randf_range(-0.4, 0.7)
		var sz_t: float = (sz + d * 0.48) / d
		var local_w: float = w * lerpf(0.10, 0.40, sin(sz_t * PI))
		var local_h: float = h * lerpf(0.12, 0.48, sin(sz_t * PI))
		var sx: float = s_side * cos(s_ang) * local_w
		var sy: float = body_y + sin(s_ang) * local_h
		_build_box(root,
			Vector3(sx - w * 0.012, sy - h * 0.012, sz - w * 0.012),
			Vector3(sx + w * 0.012, sy + h * 0.012, sz + w * 0.012),
			spot_color, 0.40)

	# DORSAL FIN + ADIPOSE FIN (salmonid signature)
	var d_root_l := Vector3(-0.005, body_y + h * 0.40, d * 0.02)
	var d_root_r := Vector3(0.005, body_y + h * 0.40, d * 0.02)
	var d_tip := Vector3(0, body_y + h * 0.65, -d * 0.04)
	var d_back := Vector3(0, body_y + h * 0.40, -d * 0.18)
	var st_dor := SurfaceTool.new()
	st_dor.begin(Mesh.PRIMITIVE_TRIANGLES)
	_add_tri(st_dor, d_root_l, d_tip, d_back)
	_add_tri(st_dor, d_root_r, d_back, d_tip)
	st_dor.generate_normals()
	var mi_dor := MeshInstance3D.new()
	mi_dor.mesh = st_dor.commit()
	var mat_char_fin := StandardMaterial3D.new()
	mat_char_fin.albedo_color = fin_color
	mat_char_fin.roughness = 0.40
	mat_char_fin.cull_mode = BaseMaterial3D.CULL_DISABLED
	mi_dor.material_override = mat_char_fin
	root.add_child(mi_dor)
	# White leading edge on dorsal fin (per verify-agent — char signature)
	_build_tapered_segment(root, d_root_l, w * 0.012, d_tip, w * 0.004,
		fin_white_edge, 0.30)
	_build_box(root,
		Vector3(-w * 0.025, body_y + h * 0.35, -d * 0.30),
		Vector3(w * 0.025, body_y + h * 0.45, -d * 0.22),
		fin_color, 0.50)

	# PECTORAL FINS with WHITE leading edge
	for side in [-1, 1]:
		var pec_root := Vector3(side * w * 0.32, body_y - h * 0.10, d * 0.12)
		var pec_tip_top := Vector3(side * w * 0.50, body_y + h * 0.00, d * 0.05)
		var pec_tip_bot := Vector3(side * w * 0.50, body_y - h * 0.30, d * 0.02)
		var st_pec := SurfaceTool.new()
		st_pec.begin(Mesh.PRIMITIVE_TRIANGLES)
		_add_tri(st_pec, pec_root, pec_tip_top, pec_tip_bot)
		_add_tri(st_pec, pec_root, pec_tip_bot, pec_tip_top)
		st_pec.generate_normals()
		var mi_pec := MeshInstance3D.new()
		mi_pec.mesh = st_pec.commit()
		mi_pec.material_override = mat_char_fin
		root.add_child(mi_pec)
		_build_tapered_segment(root, pec_root, w * 0.012, pec_tip_top, w * 0.004,
			fin_white_edge, 0.30)

	# PELVIC FINS with white leading edge
	for side in [-1, 1]:
		var pel_root := Vector3(side * w * 0.18, body_y - h * 0.30, -d * 0.05)
		var pel_tip := Vector3(side * w * 0.30, body_y - h * 0.50, -d * 0.10)
		_build_tapered_segment(root, pel_root, w * 0.020, pel_tip, w * 0.008, fin_color, 0.40)
		_build_tapered_segment(root, pel_root, w * 0.010, pel_tip, w * 0.003, fin_white_edge, 0.30)

	# ANAL FIN
	var an_root_l := Vector3(-0.005, body_y - h * 0.35, -d * 0.18)
	var an_root_r := Vector3(0.005, body_y - h * 0.35, -d * 0.18)
	var an_tip := Vector3(0, body_y - h * 0.55, -d * 0.25)
	var an_back := Vector3(0, body_y - h * 0.34, -d * 0.30)
	var st_an := SurfaceTool.new()
	st_an.begin(Mesh.PRIMITIVE_TRIANGLES)
	_add_tri(st_an, an_root_l, an_back, an_tip)
	_add_tri(st_an, an_root_r, an_tip, an_back)
	st_an.generate_normals()
	var mi_an := MeshInstance3D.new()
	mi_an.mesh = st_an.commit()
	mi_an.material_override = mat_char_fin
	root.add_child(mi_an)
	# White leading edge on anal fin
	_build_tapered_segment(root, an_root_l, w * 0.012, an_tip, w * 0.004,
		fin_white_edge, 0.30)

	# FORKED TAIL FIN (char signature)
	var ctp := Vector3(0, body_y, -d * 0.48)
	var ct_top := Vector3(0, body_y + h * 0.45, -d * 0.68)
	var ct_top_fork := Vector3(0, body_y + h * 0.32, -d * 0.62)
	var ct_bot := Vector3(0, body_y - h * 0.45, -d * 0.68)
	var ct_bot_fork := Vector3(0, body_y - h * 0.32, -d * 0.62)
	var st_ct := SurfaceTool.new()
	st_ct.begin(Mesh.PRIMITIVE_TRIANGLES)
	_add_tri(st_ct, ctp + Vector3(-0.005, 0, 0), ct_top, ct_top_fork)
	_add_tri(st_ct, ctp + Vector3(0.005, 0, 0), ct_top_fork, ct_top)
	_add_tri(st_ct, ctp + Vector3(-0.005, 0, 0), ct_bot_fork, ct_bot)
	_add_tri(st_ct, ctp + Vector3(0.005, 0, 0), ct_bot, ct_bot_fork)
	st_ct.generate_normals()
	var mi_ct := MeshInstance3D.new()
	mi_ct.mesh = st_ct.commit()
	mi_ct.material_override = mat_char_fin
	root.add_child(mi_ct)

# ============================================================================
# ARCTIC FOX (arctic_fox)
# Small white winter fox. Compact rounded body (NOT lean like wolf), short
# legs, thick fluffy winter fur, small ears (heat conservation), bushy tail,
# short pointed snout. Seasonal coat variants.
# ============================================================================

static func _build_arctic_fox(plan: Dictionary, root: Node3D) -> void:
	var base: Dictionary = plan.get("base", {})
	var palette: Dictionary = plan.get("palette", {})
	var limbs: Dictionary = plan.get("limbs", {})
	var meta: Dictionary = plan.get("meta", {})
	var species: String = String(meta.get("species", "Arctic Fox"))

	# Compact quadruped — smaller than a wolf, fluffier proportions
	var w: float = _axis(base, "width", 0.42)
	var h: float = _axis(base, "height", 0.32)
	var d: float = _axis(base, "depth", 0.85)
	var leg_length: float = float(limbs.get("leg_length", 0.28))
	var clearance: float = leg_length

	var render_seed: int = int(meta.get("render_seed", 0))
	var rng := RandomNumberGenerator.new()
	rng.seed = render_seed if render_seed != 0 else hash(species)

	# Per-individual variation
	var size_jitter: float = rng.randf_range(0.88, 1.15)
	var fluff_jitter: float = rng.randf_range(0.90, 1.25)        # how puffy the fur is
	var ear_jitter: float = rng.randf_range(0.85, 1.20)
	var tail_bush_jitter: float = rng.randf_range(0.90, 1.30)
	w *= size_jitter
	h *= size_jitter
	d *= size_jitter

	# Coat color phases — Arctic Fox seasonal/morph variants
	var coat_phases := ["winter_white", "winter_white", "winter_white",
		"blue_morph", "blue_morph",
		"summer_brown"]   # winter-white is the most common
	var coat_phase: String = coat_phases[rng.randi() % coat_phases.size()]

	var primary: Color
	var belly: Color
	match coat_phase:
		"winter_white":
			primary = Color(0.95, 0.95, 0.96)        # near-pure white
			belly = Color(0.99, 0.99, 0.99)
		"blue_morph":
			primary = Color(0.55, 0.62, 0.68)        # slate blue-grey
			belly = Color(0.78, 0.82, 0.85)
		_:    # summer_brown
			primary = Color(0.45, 0.35, 0.25)        # warm brown
			belly = Color(0.85, 0.78, 0.62)
	var fur_dark: Color = primary.darkened(0.15)
	var nose_color := Color(0.10, 0.08, 0.06)
	var eye_color: Color = palette.get("eye", Color(0.32, 0.22, 0.10))

	# ============================================================================
	# BODY — compact, slightly fluffy (rings wider with fluff_jitter)
	# ============================================================================
	var body_y: float = clearance + h * 0.45
	var body_sections: Array = [
		{"center": Vector3(0, body_y, -d * 0.42), "w": w * 0.32 * fluff_jitter, "h": h * 0.34 * fluff_jitter},
		{"center": Vector3(0, body_y, -d * 0.20), "w": w * 0.44 * fluff_jitter, "h": h * 0.48 * fluff_jitter},
		{"center": Vector3(0, body_y, 0.0),       "w": w * 0.46 * fluff_jitter, "h": h * 0.50 * fluff_jitter},
		{"center": Vector3(0, body_y, d * 0.20),  "w": w * 0.42 * fluff_jitter, "h": h * 0.46 * fluff_jitter},
		{"center": Vector3(0, body_y + h * 0.02, d * 0.36), "w": w * 0.28, "h": h * 0.30},   # neck base
	]
	_swept_body(root, body_sections, 10, primary, belly, 0.95, true)

	# ============================================================================
	# HEAD — SHORT muzzle (Wikipedia: "short muzzle" is signature; was too
	# pointed and reading red-fox per verify-agent).
	# ============================================================================
	var neck_base := body_sections[4]["center"] as Vector3
	var head_back := Vector3(0, neck_base.y + h * 0.05, neck_base.z + d * 0.06)
	var head_mid := Vector3(0, neck_base.y, neck_base.z + d * 0.14)
	var snout_tip := Vector3(0, neck_base.y - h * 0.04, neck_base.z + d * 0.22)
	var head_sections: Array = [
		{"center": head_back, "w": w * 0.30, "h": h * 0.34},
		{"center": head_mid,  "w": w * 0.26, "h": h * 0.28},
		{"center": snout_tip, "w": w * 0.14, "h": h * 0.14},     # blunter tip
	]
	_swept_body(root, head_sections, 10, primary, belly, 0.95, true)

	# Dark NOSE bump at the snout tip
	_build_box(
		root,
		Vector3(-w * 0.06, snout_tip.y, snout_tip.z),
		Vector3(w * 0.06, snout_tip.y + h * 0.08, snout_tip.z + w * 0.06),
		nose_color, 0.40
	)

	# EYES — dark beady on the sides of the head
	for side in [-1, 1]:
		_build_box(
			root,
			Vector3(side * w * 0.18, head_back.y + h * 0.05, head_back.z + d * 0.04),
			Vector3(side * w * 0.24, head_back.y + h * 0.13, head_back.z + d * 0.10),
			eye_color, 0.30
		)

	# SMALL EARS — pointed triangles, smaller than wolf/red fox for heat
	# conservation (Bergmann-like ear-shrinking).
	for side in [-1, 1]:
		var this_ear: float = ear_jitter * rng.randf_range(0.90, 1.10)
		var ear_base := Vector3(side * w * 0.20, head_back.y + h * 0.22, head_back.z - d * 0.02)
		var ear_tip := Vector3(side * w * 0.28, head_back.y + h * (0.40 * this_ear), head_back.z - d * 0.04)
		var ear_inner := Vector3(side * w * 0.10, head_back.y + h * 0.28, head_back.z + d * 0.00)
		_emit_ear_tri(root, ear_base, ear_tip, ear_inner, primary)
		# Inner-ear lighter pink/pale
		var inner_tip := Vector3(side * w * 0.22, head_back.y + h * (0.32 * this_ear), head_back.z - d * 0.02)
		_emit_ear_tri(root, ear_base, inner_tip, ear_inner, Color(0.95, 0.78, 0.78))

	# ============================================================================
	# LEGS — short stubby, 4 of them
	# ============================================================================
	var leg_offsets := [
		{"x": -w * 0.22, "z": d * 0.22},
		{"x":  w * 0.22, "z": d * 0.22},
		{"x": -w * 0.22, "z": -d * 0.28},
		{"x":  w * 0.22, "z": -d * 0.28},
	]
	# Paw color matches the coat in winter (Arctic fox paws are fur-covered
	# for thermal insulation, not exposed dark skin like a wolf).
	var paw_color: Color = primary if coat_phase == "winter_white" else fur_dark
	for leg in leg_offsets:
		var hip_pos := Vector3(leg["x"], body_y - h * 0.20, leg["z"])
		var foot := Vector3(leg["x"], 0.0, leg["z"] + w * 0.04)
		_build_tapered_segment(root, hip_pos, w * 0.07, foot, w * 0.06,
			primary.darkened(0.05), 0.92)
		# Furred paw — uses the coat color for winter morphs
		_build_box(
			root,
			Vector3(leg["x"] - w * 0.06, 0.0, leg["z"] - w * 0.06),
			Vector3(leg["x"] + w * 0.06, h * 0.06, leg["z"] + w * 0.10),
			paw_color, 0.95
		)

	# ============================================================================
	# BUSHY TAIL — held back with fluffy bush. Length tuned per verify-agent:
	# real arctic fox tail is ~1/3 of body length (was 60% before, way too long).
	# ============================================================================
	var tail_root := Vector3(0, body_y + h * 0.05, -d * 0.45)
	var tail_mid := Vector3(0, body_y - h * 0.05, -d * 0.58)
	var tail_tip := Vector3(0, body_y - h * 0.15, -d * 0.70)
	# Tail is FAT — fluffier than a wolf or normal fox
	_build_tapered_segment(root, tail_root, w * 0.18 * tail_bush_jitter, tail_mid,
		w * 0.22 * tail_bush_jitter, primary, 0.98)
	_build_tapered_segment(root, tail_mid, w * 0.22 * tail_bush_jitter, tail_tip,
		w * 0.10 * tail_bush_jitter, primary, 0.98)
	# Tail tip — often slightly darker (or pure white for full winter coats)
	if coat_phase != "winter_white":
		_build_box(
			root,
			Vector3(-w * 0.08, tail_tip.y - h * 0.06, tail_tip.z - w * 0.08),
			Vector3(w * 0.08, tail_tip.y + h * 0.06, tail_tip.z + w * 0.04),
			primary.darkened(0.30), 0.98
		)

	# ============================================================================
	# FUR TUFTS — small fluff clumps on the body for the puffy winter look
	# ============================================================================
	var tuft_count: int = int(8 * fluff_jitter)
	for _ti in range(tuft_count):
		var t_ang: float = rng.randf_range(0.0, TAU)
		var t_z: float = rng.randf_range(-d * 0.30, d * 0.20)
		var t_r: float = w * 0.46 * fluff_jitter
		var t_pos := Vector3(cos(t_ang) * t_r, body_y + sin(t_ang) * h * 0.40 * fluff_jitter, t_z)
		var t_size: float = w * rng.randf_range(0.05, 0.10)
		_build_box(
			root,
			t_pos - Vector3(t_size, t_size, t_size),
			t_pos + Vector3(t_size, t_size, t_size),
			primary, 0.98
		)

# ============================================================================
# ARCTIC GOBY (arctic_goby)
# Small cold-water bottom-dwelling fish. Stout flattened body, oversized
# head with big mouth, BULGING EYES set high on the head, large fan pectoral
# fins, fused PELVIC SUCKER DISC on the belly (gobiid signature), two dorsal
# fins (spiny + soft).
# ============================================================================

static func _build_arctic_goby(plan: Dictionary, root: Node3D) -> void:
	var base: Dictionary = plan.get("base", {})
	var palette: Dictionary = plan.get("palette", {})
	var meta: Dictionary = plan.get("meta", {})
	var species: String = String(meta.get("species", "Arctic Goby"))

	# Stout fish — flat-bottomed, head-heavy
	var w: float = _axis(base, "width", 0.32)
	var h: float = _axis(base, "height", 0.30)
	var d: float = _axis(base, "depth", 0.80)
	var hover: float = h * 0.40
	var body_y: float = hover

	var render_seed: int = int(meta.get("render_seed", 0))
	var rng := RandomNumberGenerator.new()
	rng.seed = render_seed if render_seed != 0 else hash(species)

	var size_jitter: float = rng.randf_range(0.85, 1.20)
	var speckle_count: int = rng.randi_range(10, 20)
	w *= size_jitter
	h *= size_jitter
	d *= size_jitter

	# Speckled camouflage palette — gobies blend with substrate
	var camo_options := [
		Color(0.42, 0.32, 0.20),     # mud brown
		Color(0.35, 0.30, 0.22),     # sand
		Color(0.30, 0.35, 0.30),     # algae green-grey
		Color(0.50, 0.40, 0.28),     # sandy tan
		Color(0.25, 0.22, 0.18),     # dark mud
		Color(0.40, 0.38, 0.32),     # neutral grey-tan
		Color(0.45, 0.30, 0.22),     # rust brown
	]
	var speckle_options := [
		Color(0.20, 0.15, 0.08),     # dark spots
		Color(0.70, 0.55, 0.32),     # light spots
		Color(0.10, 0.20, 0.10),     # algae green
	]
	var primary: Color = camo_options[rng.randi() % camo_options.size()]
	var belly: Color = primary.lightened(0.30)
	var speckle: Color = speckle_options[rng.randi() % speckle_options.size()]
	var fin_color: Color = primary.darkened(0.10)
	var eye_color: Color = palette.get("eye", Color(0.05, 0.04, 0.02))
	var mouth_color := Color(0.45, 0.30, 0.25)

	# ============================================================================
	# BODY — head-heavy, slightly tapered. Front bulge = head.
	# ============================================================================
	var body_sections: Array = [
		{"center": Vector3(0, body_y, -d * 0.48), "w": w * 0.05, "h": h * 0.10},   # tail base
		{"center": Vector3(0, body_y, -d * 0.30), "w": w * 0.22, "h": h * 0.28},
		{"center": Vector3(0, body_y, -d * 0.10), "w": w * 0.30, "h": h * 0.38},
		{"center": Vector3(0, body_y, d * 0.10),  "w": w * 0.38, "h": h * 0.45},   # widest pre-head
		{"center": Vector3(0, body_y + h * 0.04, d * 0.28), "w": w * 0.42, "h": h * 0.50},   # head bulge
		{"center": Vector3(0, body_y, d * 0.40),  "w": w * 0.28, "h": h * 0.36},   # snout
	]
	_swept_body(root, body_sections, 10, primary, belly, 0.55, true)

	# ============================================================================
	# MOUTH — wide TERMINAL mouth at the snout tip (per verify-agent — gobies
	# don't have subterminal/down-turned mouths like loaches)
	# ============================================================================
	_build_box(
		root,
		Vector3(-w * 0.18, body_y - h * 0.02, d * 0.42),
		Vector3(w * 0.18, body_y + h * 0.04, d * 0.50),
		mouth_color, 0.55
	)

	# ============================================================================
	# BULGING EYES — on TOP of the head (high-set, classic goby look)
	# ============================================================================
	for side in [-1, 1]:
		var ex: float = side * w * 0.18
		var ey: float = body_y + h * 0.30
		# Eye dome (small flat-ish bulge)
		_build_box(
			root,
			Vector3(ex - w * 0.10, ey, d * 0.22),
			Vector3(ex + w * 0.10, ey + h * 0.18, d * 0.32),
			eye_color, 0.30
		)
		# Pupil highlight (small white dot)
		_build_box(
			root,
			Vector3(ex - w * 0.04, ey + h * 0.05, d * 0.28),
			Vector3(ex + w * 0.04, ey + h * 0.12, d * 0.32),
			Color(0.85, 0.85, 0.85), 0.30
		)

	# Gill cover line — inset onto the body surface, shorter (was floating
	# outside the silhouette as a fin stub per verify-agent).
	for side in [-1, 1]:
		_build_box(
			root,
			Vector3(side * w * 0.28, body_y - h * 0.05, d * 0.16),
			Vector3(side * w * 0.30, body_y + h * 0.15, d * 0.20),
			primary.darkened(0.20), 0.50
		)

	# ============================================================================
	# SPECKLE PATTERN — irregular dots scattered on the back (camouflage)
	# ============================================================================
	for _si in range(speckle_count):
		var sz: float = rng.randf_range(-d * 0.35, d * 0.25)
		var s_side: float = 1.0 if rng.randf() > 0.5 else -1.0
		var s_ang: float = rng.randf_range(-0.3, 0.8)
		var sz_t: float = (sz + d * 0.48) / d
		var local_w: float = w * lerpf(0.10, 0.40, sin(sz_t * PI))
		var local_h: float = h * lerpf(0.12, 0.48, sin(sz_t * PI))
		var sx: float = s_side * cos(s_ang) * local_w
		var sy: float = body_y + sin(s_ang) * local_h
		var spk_r: float = w * rng.randf_range(0.025, 0.050)
		_build_box(
			root,
			Vector3(sx - spk_r, sy - spk_r * 0.5, sz - spk_r),
			Vector3(sx + spk_r, sy + spk_r * 0.5, sz + spk_r),
			speckle, 0.70
		)

	# ============================================================================
	# TWO DORSAL FINS — first spiny (short), second soft (longer)
	# ============================================================================
	# First dorsal — spiny, just behind the head
	var d1_root_l := Vector3(-0.005, body_y + h * 0.42, d * 0.08)
	var d1_root_r := Vector3(0.005, body_y + h * 0.42, d * 0.08)
	var d1_tip := Vector3(0, body_y + h * 0.62, d * 0.04)
	var d1_back := Vector3(0, body_y + h * 0.40, -d * 0.04)
	var st_d1 := SurfaceTool.new()
	st_d1.begin(Mesh.PRIMITIVE_TRIANGLES)
	_add_tri(st_d1, d1_root_l, d1_tip, d1_back)
	_add_tri(st_d1, d1_root_r, d1_back, d1_tip)
	st_d1.generate_normals()
	var mi_d1 := MeshInstance3D.new()
	mi_d1.mesh = st_d1.commit()
	var mat_goby_fin := StandardMaterial3D.new()
	mat_goby_fin.albedo_color = fin_color
	mat_goby_fin.roughness = 0.50
	mat_goby_fin.cull_mode = BaseMaterial3D.CULL_DISABLED
	mi_d1.material_override = mat_goby_fin
	root.add_child(mi_d1)
	# Spine rays sticking up through first dorsal
	for ri in range(4):
		var rt: float = float(ri) / 3.0
		var rx: float = lerpf(-w * 0.04, w * 0.04, rt)
		var spine_top := Vector3(rx, body_y + h * 0.68, lerpf(d * 0.04, -d * 0.02, rt))
		_build_tapered_segment(root,
			Vector3(rx, body_y + h * 0.42, lerpf(d * 0.06, -d * 0.02, rt)),
			w * 0.008, spine_top, w * 0.002, fin_color.darkened(0.20), 0.50)

	# Second dorsal — softer, longer, sits behind the first
	var d2_root_l := Vector3(-0.005, body_y + h * 0.40, -d * 0.10)
	var d2_root_r := Vector3(0.005, body_y + h * 0.40, -d * 0.10)
	var d2_tip := Vector3(0, body_y + h * 0.55, -d * 0.20)
	var d2_back := Vector3(0, body_y + h * 0.35, -d * 0.30)
	var st_d2 := SurfaceTool.new()
	st_d2.begin(Mesh.PRIMITIVE_TRIANGLES)
	_add_tri(st_d2, d2_root_l, d2_tip, d2_back)
	_add_tri(st_d2, d2_root_r, d2_back, d2_tip)
	st_d2.generate_normals()
	var mi_d2 := MeshInstance3D.new()
	mi_d2.mesh = st_d2.commit()
	mi_d2.material_override = mat_goby_fin
	root.add_child(mi_d2)

	# ============================================================================
	# LARGE FAN PECTORAL FINS — horizontally-swept wing-like fans (was
	# vertical paddles per verify-agent; real goby pectorals spread back
	# along the flank, letting them prop on substrate).
	# ============================================================================
	for side in [-1, 1]:
		var pec_root := Vector3(side * w * 0.34, body_y - h * 0.05, d * 0.10)
		var pec_tip_top := Vector3(side * w * 0.55, body_y + h * 0.05, d * 0.12)
		var pec_tip_mid := Vector3(side * w * 0.70, body_y - h * 0.05, -d * 0.02)
		var pec_tip_bot := Vector3(side * w * 0.55, body_y - h * 0.10, -d * 0.16)
		var st_pec := SurfaceTool.new()
		st_pec.begin(Mesh.PRIMITIVE_TRIANGLES)
		_add_tri(st_pec, pec_root, pec_tip_top, pec_tip_mid)
		_add_tri(st_pec, pec_root, pec_tip_mid, pec_tip_bot)
		# Backface
		_add_tri(st_pec, pec_root, pec_tip_mid, pec_tip_top)
		_add_tri(st_pec, pec_root, pec_tip_bot, pec_tip_mid)
		st_pec.generate_normals()
		var mi_pec := MeshInstance3D.new()
		mi_pec.mesh = st_pec.commit()
		mi_pec.material_override = mat_goby_fin
		root.add_child(mi_pec)

	# ============================================================================
	# PELVIC SUCKER DISC — fused pelvic fins forming a sucker on the belly.
	# Iconic goby anatomy that lets them cling to rocks in current.
	# ============================================================================
	var sucker_sections: Array = [
		{"center": Vector3(0, body_y - h * 0.38, 0), "w": w * 0.18, "h": w * 0.16},
		{"center": Vector3(0, body_y - h * 0.45, 0), "w": w * 0.22, "h": w * 0.20},
	]
	_swept_body(root, sucker_sections, 10, fin_color, Color(0,0,0,0), 0.40, true)

	# ============================================================================
	# ANAL FIN — small fin under back belly
	# ============================================================================
	var an_root_l := Vector3(-0.005, body_y - h * 0.30, -d * 0.10)
	var an_root_r := Vector3(0.005, body_y - h * 0.30, -d * 0.10)
	var an_tip := Vector3(0, body_y - h * 0.50, -d * 0.18)
	var an_back := Vector3(0, body_y - h * 0.30, -d * 0.28)
	var st_an := SurfaceTool.new()
	st_an.begin(Mesh.PRIMITIVE_TRIANGLES)
	_add_tri(st_an, an_root_l, an_back, an_tip)
	_add_tri(st_an, an_root_r, an_tip, an_back)
	st_an.generate_normals()
	var mi_an := MeshInstance3D.new()
	mi_an.mesh = st_an.commit()
	mi_an.material_override = mat_goby_fin
	root.add_child(mi_an)

	# ============================================================================
	# TAIL FIN — simple rounded fan
	# ============================================================================
	var t_pivot := Vector3(0, body_y, -d * 0.46)
	var t_top := Vector3(0, body_y + h * 0.40, -d * 0.62)
	var t_bot := Vector3(0, body_y - h * 0.40, -d * 0.62)
	var t_back := Vector3(0, body_y, -d * 0.68)
	var st_t := SurfaceTool.new()
	st_t.begin(Mesh.PRIMITIVE_TRIANGLES)
	_add_tri(st_t, t_pivot + Vector3(-0.005, 0, 0), t_top, t_back)
	_add_tri(st_t, t_pivot + Vector3(0.005, 0, 0), t_back, t_top)
	_add_tri(st_t, t_pivot + Vector3(-0.005, 0, 0), t_back, t_bot)
	_add_tri(st_t, t_pivot + Vector3(0.005, 0, 0), t_bot, t_back)
	st_t.generate_normals()
	var mi_t := MeshInstance3D.new()
	mi_t.mesh = st_t.commit()
	mi_t.material_override = mat_goby_fin
	root.add_child(mi_t)

# ============================================================================
# ARCTIC SKATE (arctic_skate)
# Cartilaginous flatfish related to rays. Iconic features:
#   - FLAT KITE-SHAPED body with huge winged pectoral fins forming a rhombus
#   - Whip-like long tail with small dorsal fins
#   - Eyes set on TOP of the head (looking up)
#   - Mouth + gill slits on the UNDERSIDE
#   - Row of small thorns/denticles down the spine and tail
# ============================================================================

static func _build_arctic_skate(plan: Dictionary, root: Node3D) -> void:
	var base: Dictionary = plan.get("base", {})
	var palette: Dictionary = plan.get("palette", {})
	var meta: Dictionary = plan.get("meta", {})
	var species: String = String(meta.get("species", "Arctic Skate"))

	# Flat fish — WIDTH is huge (kite-shaped), HEIGHT is shallow, DEPTH is
	# the body length plus tail.
	var w: float = _axis(base, "width", 1.30)
	var h: float = _axis(base, "height", 0.20)
	var d: float = _axis(base, "depth", 1.50)
	var hover: float = h * 0.50
	var body_y: float = hover

	var render_seed: int = int(meta.get("render_seed", 0))
	var rng := RandomNumberGenerator.new()
	rng.seed = render_seed if render_seed != 0 else hash(species)

	# Per-individual variation
	var size_jitter: float = rng.randf_range(0.88, 1.20)
	var thorn_count: int = rng.randi_range(6, 10)
	var spot_count: int = rng.randi_range(0, 8)
	w *= size_jitter
	h *= size_jitter
	d *= size_jitter

	# Mottled sea-floor camouflage palette
	var color_options := [
		Color(0.45, 0.38, 0.28),     # mud brown
		Color(0.32, 0.30, 0.25),     # sandy grey
		Color(0.20, 0.18, 0.16),     # dark
		Color(0.55, 0.48, 0.32),     # tan
		Color(0.28, 0.32, 0.30),     # slate green-grey
		Color(0.38, 0.30, 0.22),     # rust earth
	]
	var primary: Color = color_options[rng.randi() % color_options.size()]
	var belly: Color = Color(0.92, 0.88, 0.80)        # creamy underside (skate signature)
	var thorn_color: Color = primary.darkened(0.30)
	var spot_color: Color = primary.darkened(0.40)
	var eye_color: Color = palette.get("eye", Color(0.85, 0.65, 0.10))

	# ============================================================================
	# KITE-SHAPED BODY — wide flat rhombus. Per verify-agent, wings flare
	# REARWARD from a forward snout (wingspan > body length, leading edges
	# longer than trailing edges → classic skate kite profile).
	# ============================================================================
	var snout_p := Vector3(0, body_y, d * 0.55)
	var wing_l := Vector3(-w * 0.85, body_y, -d * 0.10)       # rearward swept
	var wing_r := Vector3(w * 0.85, body_y, -d * 0.10)
	var rear_p := Vector3(0, body_y - h * 0.05, -d * 0.20)    # tail-base attach (closer than before)
	# Slight dorsal bulge in the middle — thickness ONLY in the central spine.
	# Wing tips inherit zero thickness so they read as thin trailing edges.
	var bulge_top := Vector3(0, body_y + h * 0.18, d * 0.05)
	var bulge_bot := Vector3(0, body_y - h * 0.15, d * 0.05)

	# Build top surface (dorsal — darker primary color)
	var st_top := SurfaceTool.new()
	st_top.begin(Mesh.PRIMITIVE_TRIANGLES)
	_add_tri(st_top, snout_p, bulge_top, wing_l)
	_add_tri(st_top, snout_p, wing_r, bulge_top)
	_add_tri(st_top, wing_l, bulge_top, rear_p)
	_add_tri(st_top, wing_r, rear_p, bulge_top)
	st_top.generate_normals()
	var mi_top := MeshInstance3D.new()
	mi_top.mesh = st_top.commit()
	var mat_top := StandardMaterial3D.new()
	mat_top.albedo_color = primary
	mat_top.roughness = 0.50
	mat_top.cull_mode = BaseMaterial3D.CULL_DISABLED
	mi_top.material_override = mat_top
	root.add_child(mi_top)

	# Build bottom surface (creamy belly)
	var st_bot := SurfaceTool.new()
	st_bot.begin(Mesh.PRIMITIVE_TRIANGLES)
	_add_tri(st_bot, snout_p, wing_l, bulge_bot)
	_add_tri(st_bot, snout_p, bulge_bot, wing_r)
	_add_tri(st_bot, wing_l, rear_p, bulge_bot)
	_add_tri(st_bot, wing_r, bulge_bot, rear_p)
	st_bot.generate_normals()
	var mi_bot := MeshInstance3D.new()
	mi_bot.mesh = st_bot.commit()
	var mat_bot := StandardMaterial3D.new()
	mat_bot.albedo_color = belly
	mat_bot.roughness = 0.55
	mat_bot.cull_mode = BaseMaterial3D.CULL_DISABLED
	mi_bot.material_override = mat_bot
	root.add_child(mi_bot)

	# ============================================================================
	# EYES — bulging on TOP of the snout (skates have dorsal eyes)
	# ============================================================================
	for side in [-1, 1]:
		var ex: float = side * w * 0.10
		var ey: float = body_y + h * 0.20
		var ez: float = d * 0.28
		# Eye bulge
		_build_box(
			root,
			Vector3(ex - w * 0.05, ey, ez - w * 0.04),
			Vector3(ex + w * 0.05, ey + h * 0.10, ez + w * 0.06),
			eye_color, 0.30, 0.10
		)
		# Pupil
		_build_box(
			root,
			Vector3(ex - w * 0.015, ey + h * 0.02, ez - w * 0.02),
			Vector3(ex + w * 0.015, ey + h * 0.07, ez + w * 0.04),
			Color(0.05, 0.04, 0.03), 0.30
		)

	# Spiracles (breathing holes on top, behind the eyes — signature ray/skate)
	for side in [-1, 1]:
		_build_box(
			root,
			Vector3(side * w * 0.13 - w * 0.020, body_y + h * 0.18, d * 0.18),
			Vector3(side * w * 0.13 + w * 0.020, body_y + h * 0.22, d * 0.22),
			Color(0.05, 0.04, 0.04), 0.50
		)

	# ============================================================================
	# THORN ROW — small spikes down the spine and tail (skate denticles)
	# ============================================================================
	var thorn_path: Array = [
		Vector3(0, body_y + h * 0.20, d * 0.10),
		Vector3(0, body_y + h * 0.18, -d * 0.05),
		Vector3(0, body_y + h * 0.12, -d * 0.20),
	]
	# Plus thorns along the tail
	for ti in range(thorn_count):
		var tt: float = float(ti) / float(thorn_count - 1)
		var thorn_pos := Vector3(0, body_y + h * (0.08 - 0.04 * tt), lerpf(-d * 0.30, -d * 1.10, tt))
		thorn_path.append(thorn_pos)
	for thorn_var in thorn_path:
		var thorn: Vector3 = thorn_var
		var thorn_tip: Vector3 = thorn + Vector3(0, h * 0.10, 0)
		_build_tapered_segment(root, thorn, w * 0.025, thorn_tip, w * 0.004,
			thorn_color, 0.50)

	# ============================================================================
	# TAIL — long whip-like, tapering from rear of body to a thin point
	# ============================================================================
	var tail_sections: Array = [
		{"center": Vector3(0, body_y - h * 0.05, -d * 0.30), "w": w * 0.12, "h": h * 0.20},
		{"center": Vector3(0, body_y - h * 0.10, -d * 0.55), "w": w * 0.08, "h": h * 0.14},
		{"center": Vector3(0, body_y - h * 0.15, -d * 0.80), "w": w * 0.05, "h": h * 0.10},
		{"center": Vector3(0, body_y - h * 0.20, -d * 1.05), "w": w * 0.02, "h": h * 0.05},
		{"center": Vector3(0, body_y - h * 0.22, -d * 1.20), "w": w * 0.005, "h": h * 0.02},
	]
	_swept_body(root, tail_sections, 8, primary, belly, 0.55, false)

	# Two small dorsal fins on the tail (skate feature). Each fin is a proper
	# 4-vertex sail (was degenerate slivers per verify-agent).
	var tail_fin_zs := [-d * 0.55, -d * 0.80]
	for fz in tail_fin_zs:
		var f_root_front_l := Vector3(-w * 0.015, body_y - h * 0.10, fz + d * 0.04)
		var f_root_front_r := Vector3(w * 0.015, body_y - h * 0.10, fz + d * 0.04)
		var f_root_back_l := Vector3(-w * 0.015, body_y - h * 0.10, fz - d * 0.04)
		var f_root_back_r := Vector3(w * 0.015, body_y - h * 0.10, fz - d * 0.04)
		var f_tip_top := Vector3(0, body_y + h * 0.10, fz - d * 0.02)
		var f_tip_back := Vector3(0, body_y - h * 0.05, fz - d * 0.10)
		var st_f := SurfaceTool.new()
		st_f.begin(Mesh.PRIMITIVE_TRIANGLES)
		# Left face
		_add_tri(st_f, f_root_front_l, f_tip_top, f_root_back_l)
		_add_tri(st_f, f_root_back_l, f_tip_top, f_tip_back)
		# Right face
		_add_tri(st_f, f_root_front_r, f_root_back_r, f_tip_top)
		_add_tri(st_f, f_root_back_r, f_tip_back, f_tip_top)
		st_f.generate_normals()
		var mi_f := MeshInstance3D.new()
		mi_f.mesh = st_f.commit()
		var mat_f := StandardMaterial3D.new()
		mat_f.albedo_color = primary.darkened(0.10)
		mat_f.roughness = 0.50
		mat_f.cull_mode = BaseMaterial3D.CULL_DISABLED
		mi_f.material_override = mat_f
		root.add_child(mi_f)

	# ============================================================================
	# OCELLI / BACK SPOTS — optional eye-spot patterns on the wings
	# ============================================================================
	for _si in range(spot_count):
		var sx: float = rng.randf_range(-w * 0.50, w * 0.50)
		var sz: float = rng.randf_range(-d * 0.20, d * 0.40)
		var spot_r: float = w * rng.randf_range(0.04, 0.08)
		var s_y: float = body_y + h * 0.05         # just above the wing top surface
		_build_box(
			root,
			Vector3(sx - spot_r, s_y, sz - spot_r),
			Vector3(sx + spot_r, s_y + h * 0.02, sz + spot_r),
			spot_color, 0.65
		)

# ============================================================================
# ARCTIC STINK SQUIRREL (arctic_stink_squirrel)
# Hornbound-original chimera — fluffy white arctic squirrel fused with a
# skunk's defensive scent gland. Compact body, dark dorsal stripe, huge
# upturned bushy tail, optional yellow stink mist puffing from the rear.
# ============================================================================

static func _build_arctic_stink_squirrel(plan: Dictionary, root: Node3D) -> void:
	var base: Dictionary = plan.get("base", {})
	var palette: Dictionary = plan.get("palette", {})
	var limbs: Dictionary = plan.get("limbs", {})
	var meta: Dictionary = plan.get("meta", {})
	var species: String = String(meta.get("species", "Arctic Stink Squirrel"))

	var w: float = _axis(base, "width", 0.36)
	var h: float = _axis(base, "height", 0.32)
	var d: float = _axis(base, "depth", 0.55)
	var leg_length: float = float(limbs.get("leg_length", 0.18))
	var clearance: float = leg_length

	var render_seed: int = int(meta.get("render_seed", 0))
	var rng := RandomNumberGenerator.new()
	rng.seed = render_seed if render_seed != 0 else hash(species)

	var size_jitter: float = rng.randf_range(0.85, 1.20)
	var tail_puff: float = rng.randf_range(1.00, 1.45)
	var stripe_count: int = rng.randi_range(1, 3)
	var has_stink_mist: bool = rng.randf() > 0.40
	w *= size_jitter
	h *= size_jitter
	d *= size_jitter

	# Fur palette (white-base since "arctic")
	var fur_options := [
		Color(0.95, 0.95, 0.96),     # pure white
		Color(0.92, 0.90, 0.85),     # cream
		Color(0.85, 0.88, 0.92),     # silver-white
		Color(0.98, 0.95, 0.92),     # off-white
	]
	var stripe_options := [
		Color(0.15, 0.12, 0.10),     # black skunk stripe
		Color(0.25, 0.20, 0.15),     # dark brown
		Color(0.20, 0.18, 0.22),     # near-black with violet tint
	]
	var stink_options := [
		Color(0.85, 0.95, 0.30),     # iconic stink yellow-green
		Color(0.95, 0.85, 0.30),     # mustard
		Color(0.55, 0.85, 0.30),     # toxic green
		Color(0.75, 0.55, 0.10),     # putrid brown-yellow
	]
	var primary: Color = fur_options[rng.randi() % fur_options.size()]
	var stripe_color: Color = stripe_options[rng.randi() % stripe_options.size()]
	var stink_color: Color = stink_options[rng.randi() % stink_options.size()]
	var nose_color := Color(0.10, 0.08, 0.06)
	var eye_color: Color = palette.get("eye", Color(0.10, 0.08, 0.06))

	# ============================================================================
	# COMPACT ROUNDED BODY — short squirrel proportions
	# ============================================================================
	var body_y: float = clearance + h * 0.45
	var body_sections: Array = [
		{"center": Vector3(0, body_y, -d * 0.40), "w": w * 0.36, "h": h * 0.42},
		{"center": Vector3(0, body_y, -d * 0.15), "w": w * 0.48, "h": h * 0.52},
		{"center": Vector3(0, body_y, 0.10),       "w": w * 0.48, "h": h * 0.52},
		{"center": Vector3(0, body_y + h * 0.02, d * 0.28), "w": w * 0.32, "h": h * 0.36},   # neck
	]
	_swept_body(root, body_sections, 10, primary, primary.lightened(0.05), 0.95, true)

	# ============================================================================
	# DARK SKUNK STRIPE(S) down the back — extended to reach BOTH the head end
	# and the tail base so there's no gap with the tail-stripe continuation.
	# ============================================================================
	for si in range(stripe_count):
		var stripe_x_off: float = (float(si) - float(stripe_count - 1) / 2.0) * w * 0.10
		_build_box(
			root,
			Vector3(stripe_x_off - w * 0.04, body_y + h * 0.45, -d * 0.42),
			Vector3(stripe_x_off + w * 0.04, body_y + h * 0.50, d * 0.30),
			stripe_color, 0.95
		)

	# ============================================================================
	# HEAD — squirrel-y short snout with big eyes
	# ============================================================================
	var head_back := Vector3(0, body_y + h * 0.10, d * 0.30)
	var head_mid := Vector3(0, body_y + h * 0.08, d * 0.40)
	var snout_tip := Vector3(0, body_y, d * 0.50)
	var head_sections: Array = [
		{"center": head_back, "w": w * 0.30, "h": h * 0.34},
		{"center": head_mid, "w": w * 0.28, "h": h * 0.28},
		{"center": snout_tip, "w": w * 0.14, "h": h * 0.14},
	]
	_swept_body(root, head_sections, 10, primary, Color(0,0,0,0), 0.95, true)

	# Nose
	_build_box(
		root,
		Vector3(-w * 0.06, snout_tip.y, snout_tip.z),
		Vector3(w * 0.06, snout_tip.y + h * 0.08, snout_tip.z + w * 0.06),
		nose_color, 0.40
	)
	# Big dark squirrel eyes
	for side in [-1, 1]:
		_build_box(
			root,
			Vector3(side * w * 0.18, head_back.y + h * 0.05, head_back.z + d * 0.05),
			Vector3(side * w * 0.26, head_back.y + h * 0.18, head_back.z + d * 0.13),
			eye_color, 0.30
		)
		# Highlight
		_build_box(
			root,
			Vector3(side * w * 0.20, head_back.y + h * 0.13, head_back.z + d * 0.11),
			Vector3(side * w * 0.22, head_back.y + h * 0.17, head_back.z + d * 0.13),
			Color(0.85, 0.85, 0.85), 0.30
		)
	# Small rounded ears — lowered onto the head crown (was floating behind).
	for side in [-1, 1]:
		_build_box(
			root,
			Vector3(side * w * 0.18 - w * 0.05, head_back.y + h * 0.12, head_back.z),
			Vector3(side * w * 0.18 + w * 0.05, head_back.y + h * 0.24, head_back.z + d * 0.06),
			primary, 0.95
		)

	# ============================================================================
	# 4 SHORT LEGS
	# ============================================================================
	var leg_pairs := [
		{"x": -w * 0.22, "z": d * 0.18},
		{"x":  w * 0.22, "z": d * 0.18},
		{"x": -w * 0.22, "z": -d * 0.22},
		{"x":  w * 0.22, "z": -d * 0.22},
	]
	for leg in leg_pairs:
		var hip_pos := Vector3(leg["x"], body_y - h * 0.20, leg["z"])
		var foot := Vector3(leg["x"], 0.0, leg["z"] + w * 0.04)
		_build_tapered_segment(root, hip_pos, w * 0.07, foot, w * 0.06, primary.darkened(0.05), 0.92)
		_build_box(
			root,
			Vector3(leg["x"] - w * 0.06, 0.0, leg["z"] - w * 0.06),
			Vector3(leg["x"] + w * 0.06, h * 0.06, leg["z"] + w * 0.10),
			primary, 0.95
		)

	# ============================================================================
	# HUGE BUSHY TAIL held UP behind the body (classic squirrel pose)
	# ============================================================================
	var tail_root := Vector3(0, body_y + h * 0.10, -d * 0.42)
	var tail_mid := Vector3(0, body_y + h * 0.55, -d * 0.50)
	var tail_tip := Vector3(0, body_y + h * 1.05, -d * 0.42)
	_build_tapered_segment(root, tail_root, w * 0.16 * tail_puff, tail_mid,
		w * 0.30 * tail_puff, primary, 0.98)
	_build_tapered_segment(root, tail_mid, w * 0.30 * tail_puff, tail_tip,
		w * 0.22 * tail_puff, primary, 0.98)
	# Dark stripe up the tail (continuation of dorsal stripes)
	for si in range(stripe_count):
		var s_off: float = (float(si) - float(stripe_count - 1) / 2.0) * w * 0.10
		var stripe_base := Vector3(s_off, body_y + h * 0.20, -d * 0.46)
		var stripe_top := Vector3(s_off, body_y + h * 0.95, -d * 0.40)
		_build_tapered_segment(root, stripe_base, w * 0.05, stripe_top, w * 0.05,
			stripe_color, 0.98)

	# ============================================================================
	# STINK GLAND PATCH at the rear — moved DOWN onto the underside-rear so
	# it doesn't clip through the tail base (real skunk glands sit under
	# the tail, not in it).
	# ============================================================================
	_build_box(
		root,
		Vector3(-w * 0.10, body_y - h * 0.25, -d * 0.38),
		Vector3(w * 0.10, body_y - h * 0.05, -d * 0.32),
		stink_color.darkened(0.20), 0.65
	)
	# Optional STINK MIST PUFFS — 4-6 small yellow-green spheres floating
	# behind the squirrel
	if has_stink_mist:
		var puff_count: int = rng.randi_range(4, 7)
		for pi in range(puff_count):
			var pang: float = TAU * float(pi) / float(puff_count) + rng.randf_range(-0.3, 0.3)
			var pr: float = w * rng.randf_range(0.25, 0.50)
			var pdz: float = -d * (0.50 + rng.randf_range(0.10, 0.40))
			var puff_pos := Vector3(cos(pang) * pr * 0.5, body_y + sin(pang) * h * 0.3 + h * 0.15, pdz)
			var puff_size: float = w * rng.randf_range(0.06, 0.12)
			_build_box(
				root,
				puff_pos - Vector3(puff_size, puff_size, puff_size),
				puff_pos + Vector3(puff_size, puff_size, puff_size),
				stink_color, 0.20, 0.30
			)

# ============================================================================
# AUROCHS (aurochs)
# Extinct massive wild ox — ancestor of modern cattle. Iconic features:
#   - Large stocky cattle silhouette, longer body than modern cows
#   - Prominent SHOULDER HUMP / withers
#   - MASSIVE forward-curving horns (signature)
#   - Short coarse coat, slight neck/chin BEARD on males
#   - 4 sturdy legs with cloven hooves
#   - Long tail with tuft at the tip
# ============================================================================

static func _build_aurochs(plan: Dictionary, root: Node3D) -> void:
	var base: Dictionary = plan.get("base", {})
	var palette: Dictionary = plan.get("palette", {})
	var limbs: Dictionary = plan.get("limbs", {})
	var meta: Dictionary = plan.get("meta", {})
	var species: String = String(meta.get("species", "Aurochs"))

	var w: float = _axis(base, "width", 1.10)
	var h: float = _axis(base, "height", 1.40)
	var d: float = _axis(base, "depth", 2.40)
	var leg_length: float = float(limbs.get("leg_length", 0.95))
	var clearance: float = leg_length

	var render_seed: int = int(meta.get("render_seed", 0))
	var rng := RandomNumberGenerator.new()
	rng.seed = render_seed if render_seed != 0 else hash(species)

	# Per-individual variation
	var size_jitter: float = rng.randf_range(0.90, 1.20)
	var horn_span_jitter: float = rng.randf_range(0.85, 1.30)
	var hump_jitter: float = rng.randf_range(0.85, 1.30)
	var has_beard: bool = rng.randf() > 0.40       # ~60% are bulls with beards
	w *= size_jitter
	h *= size_jitter
	d *= size_jitter

	# Coat palette — historical aurochs were largely black/dark brown bulls
	# with redder/cinnamon cows
	# Color paired with sex (has_beard = bull → dark; no beard = cow → reddish)
	# per verify-agent — historical aurochs showed strong sexual dimorphism.
	var bull_colors := [
		Color(0.10, 0.08, 0.06),     # bull black
		Color(0.18, 0.12, 0.08),     # dark brown
		Color(0.20, 0.18, 0.16),     # near-black
	]
	var cow_colors := [
		Color(0.45, 0.25, 0.18),     # cow cinnamon-red
		Color(0.32, 0.20, 0.12),     # warm brown
		Color(0.55, 0.42, 0.28),     # tan-brown
	]
	var primary: Color
	if has_beard:
		primary = bull_colors[rng.randi() % bull_colors.size()]
	else:
		primary = cow_colors[rng.randi() % cow_colors.size()]
	var belly: Color = primary.lightened(0.20)
	var horn_color := Color(0.85, 0.78, 0.65)       # pale ivory
	var horn_tip := Color(0.18, 0.14, 0.10)         # dark tip
	var hoof_color := Color(0.10, 0.08, 0.06)
	var eye_color: Color = palette.get("eye", Color(0.30, 0.20, 0.10))

	# Many aurochs had a pale dorsal stripe ("eel stripe")
	var has_eel_stripe: bool = rng.randf() > 0.40

	# ============================================================================
	# BODY — long stocky ox. 5 sections with hip/shoulder ring profile.
	# ============================================================================
	var body_y: float = clearance + h * 0.40
	var body_sections: Array = [
		{"center": Vector3(0, body_y, -d * 0.45), "w": w * 0.40, "h": h * 0.46},
		{"center": Vector3(0, body_y, -d * 0.20), "w": w * 0.46, "h": h * 0.50},
		{"center": Vector3(0, body_y, 0.05), "w": w * 0.48, "h": h * 0.52},
		{"center": Vector3(0, body_y + h * 0.05, d * 0.22), "w": w * 0.50, "h": h * 0.54},   # shoulder
		{"center": Vector3(0, body_y, d * 0.40), "w": w * 0.32, "h": h * 0.36},               # neck base
	]
	_swept_body(root, body_sections, 10, primary, belly, 0.90, true)

	# ============================================================================
	# SHOULDER HUMP — tapered muscular ridge concentrated OVER the withers
	# and falling away toward the hips (per verify-agent — was a flat slab).
	# ============================================================================
	var hump_front := Vector3(0, body_y + h * (0.62 * hump_jitter), d * 0.25)
	var hump_rear := Vector3(0, body_y + h * 0.50, -d * 0.10)
	_build_tapered_segment(root, hump_front, w * 0.30 * hump_jitter, hump_rear,
		w * 0.10, primary.darkened(0.10), 0.92)

	# ============================================================================
	# OPTIONAL EEL STRIPE — pale dorsal line from withers to tail
	# ============================================================================
	if has_eel_stripe:
		_build_box(
			root,
			Vector3(-w * 0.05, body_y + h * 0.48, -d * 0.42),
			Vector3(w * 0.05, body_y + h * 0.55, d * 0.20),
			primary.lightened(0.40), 0.92
		)

	# ============================================================================
	# NECK + HEAD — head held lower than withers (bull pose)
	# ============================================================================
	var neck_base := body_sections[4]["center"] as Vector3
	var head_anchor := Vector3(0, neck_base.y - h * 0.05, neck_base.z + d * 0.20)
	# Neck — thick muscular taper
	_build_tapered_segment(root, neck_base, w * 0.28, head_anchor + Vector3(0, h * 0.08, 0),
		w * 0.22, primary, 0.92)

	# Cranium — broad bovine head
	var cran_w: float = w * 0.28
	var cran_h: float = h * 0.22
	var cran_d: float = d * 0.30
	_build_box(
		root,
		Vector3(-cran_w, head_anchor.y - cran_h * 0.10, head_anchor.z - cran_d * 0.40),
		Vector3(cran_w, head_anchor.y + cran_h * 0.85, head_anchor.z + cran_d * 0.45),
		primary, 0.92
	)
	# Muzzle — broad and forward-protruding
	_build_box(
		root,
		Vector3(-cran_w * 0.75, head_anchor.y - cran_h * 0.35, head_anchor.z + cran_d * 0.40),
		Vector3(cran_w * 0.75, head_anchor.y + cran_h * 0.25, head_anchor.z + cran_d * 0.85),
		primary.darkened(0.08), 0.92
	)
	# Dark NOSE pad at the snout tip
	_build_box(
		root,
		Vector3(-cran_w * 0.45, head_anchor.y - cran_h * 0.25, head_anchor.z + cran_d * 0.80),
		Vector3(cran_w * 0.45, head_anchor.y + cran_h * 0.10, head_anchor.z + cran_d * 0.92),
		Color(0.08, 0.06, 0.05), 0.55
	)
	# Two nostril slits
	for side in [-1, 1]:
		_build_box(
			root,
			Vector3(side * cran_w * 0.20 - cran_w * 0.06, head_anchor.y - cran_h * 0.15, head_anchor.z + cran_d * 0.88),
			Vector3(side * cran_w * 0.20 + cran_w * 0.06, head_anchor.y - cran_h * 0.05, head_anchor.z + cran_d * 0.95),
			Color(0.04, 0.03, 0.02), 0.50
		)

	# EYES — large dark on the sides of the head
	for side in [-1, 1]:
		_build_box(
			root,
			Vector3(side * cran_w * 0.85, head_anchor.y + cran_h * 0.10, head_anchor.z + cran_d * 0.20),
			Vector3(side * cran_w * 1.00, head_anchor.y + cran_h * 0.30, head_anchor.z + cran_d * 0.35),
			eye_color, 0.30
		)
		# Highlight
		_build_box(
			root,
			Vector3(side * cran_w * 0.88, head_anchor.y + cran_h * 0.18, head_anchor.z + cran_d * 0.30),
			Vector3(side * cran_w * 0.95, head_anchor.y + cran_h * 0.25, head_anchor.z + cran_d * 0.35),
			Color(0.85, 0.85, 0.85), 0.30
		)

	# Ears — large floppy on the sides of the head
	for side in [-1, 1]:
		_build_box(
			root,
			Vector3(side * cran_w * 1.00, head_anchor.y + cran_h * 0.20, head_anchor.z - cran_d * 0.20),
			Vector3(side * cran_w * 1.30, head_anchor.y + cran_h * 0.60, head_anchor.z + cran_d * 0.05),
			primary.darkened(0.05), 0.92
		)

	# ============================================================================
	# MASSIVE FORWARD-CURVING HORNS — signature aurochs feature
	# ============================================================================
	for side in [-1, 1]:
		# Horn base anchored FORWARD on the cranium (was set slightly back —
		# verify-agent: Wikipedia describes 60° forward-facing emergence).
		var horn_base := Vector3(side * cran_w * 0.65, head_anchor.y + cran_h * 0.75, head_anchor.z + cran_d * 0.10)
		# Sweep out to the side STAYING HIGH (was dropping in Y)
		var horn_mid := Vector3(side * cran_w * (1.60 * horn_span_jitter),
			head_anchor.y + cran_h * 0.65, head_anchor.z + cran_d * 0.30)
		var horn_curve := Vector3(side * cran_w * (1.50 * horn_span_jitter),
			head_anchor.y + cran_h * 0.60, head_anchor.z + cran_d * 0.75)
		var horn_tip_pos := Vector3(side * cran_w * (1.10 * horn_span_jitter),
			head_anchor.y + cran_h * 0.85, head_anchor.z + cran_d * 0.95)
		# 3-segment horn for the curved shape
		_build_tapered_segment(root, horn_base, w * 0.08 * horn_span_jitter, horn_mid,
			w * 0.06 * horn_span_jitter, horn_color, 0.60)
		_build_tapered_segment(root, horn_mid, w * 0.06 * horn_span_jitter, horn_curve,
			w * 0.05 * horn_span_jitter, horn_color, 0.60)
		_build_tapered_segment(root, horn_curve, w * 0.05 * horn_span_jitter, horn_tip_pos,
			w * 0.012 * horn_span_jitter, horn_tip, 0.50)

	# ============================================================================
	# OPTIONAL CHIN BEARD (males)
	# ============================================================================
	if has_beard:
		_build_box(
			root,
			Vector3(-cran_w * 0.30, head_anchor.y - cran_h * 0.55, head_anchor.z + cran_d * 0.50),
			Vector3(cran_w * 0.30, head_anchor.y - cran_h * 0.20, head_anchor.z + cran_d * 0.70),
			primary.darkened(0.20), 0.98
		)
		# Slight ventral neck-mane down to the chest
		_build_box(
			root,
			Vector3(-cran_w * 0.20, neck_base.y - h * 0.15, neck_base.z + d * 0.05),
			Vector3(cran_w * 0.20, neck_base.y + h * 0.05, neck_base.z + d * 0.20),
			primary.darkened(0.20), 0.98
		)

	# ============================================================================
	# LEGS — 4 sturdy with cloven hooves
	# ============================================================================
	var leg_z_offsets := [d * 0.25, -d * 0.30]
	for leg_z in leg_z_offsets:
		for side in [-1, 1]:
			var hip_x: float = side * w * 0.28
			var hip_pos := Vector3(hip_x, body_y - h * 0.10, leg_z)
			var knee := Vector3(hip_x, clearance * 0.55, leg_z + (0.04 if leg_z > 0 else -0.04))
			var foot := Vector3(hip_x, 0.0, leg_z + (0.08 if leg_z > 0 else -0.08))
			# Thigh
			_build_tapered_segment(root, hip_pos, w * 0.16, knee, w * 0.13, primary, 0.92)
			# Shin
			_build_tapered_segment(root, knee, w * 0.13, foot, w * 0.10, primary.darkened(0.05), 0.92)
			# Cloven hoof — 2 box halves
			for hside in [-1, 1]:
				_build_box(
					root,
					Vector3(foot.x + hside * w * 0.03 - w * 0.04, 0.0, foot.z - w * 0.08),
					Vector3(foot.x + hside * w * 0.03 + w * 0.04, h * 0.06, foot.z + w * 0.10),
					hoof_color, 0.55
				)

	# ============================================================================
	# TAIL — long with tuft at the tip
	# ============================================================================
	var tail_root := Vector3(0, body_y + h * 0.10, -d * 0.45)
	var tail_mid := Vector3(0, body_y - h * 0.10, -d * 0.70)
	var tail_tip := Vector3(0, body_y - h * 0.50, -d * 0.85)
	_build_tapered_segment(root, tail_root, w * 0.06, tail_mid, w * 0.04, primary, 0.92)
	_build_tapered_segment(root, tail_mid, w * 0.04, tail_tip, w * 0.025, primary, 0.92)
	# Tail tuft — fluffy bunch at the tip
	_build_box(
		root,
		Vector3(tail_tip.x - w * 0.08, tail_tip.y - h * 0.10, tail_tip.z - w * 0.05),
		Vector3(tail_tip.x + w * 0.08, tail_tip.y + h * 0.04, tail_tip.z + w * 0.05),
		primary.darkened(0.15), 0.98
	)
	# (hump_front / hump_rear are consumed by _build_tapered_segment above)

# ============================================================================
# AXE BEAK (axe_beak)
# Large flightless predator bird — D&D Monster Manual (terror-bird analog).
#   - Bipedal terror-bird silhouette
#   - HUGE hooked AXE-LIKE BEAK (signature — disproportionately large)
#   - Powerful long legs with 3 clawed talons
#   - Small vestigial wings against the body
#   - Long counterbalance neck + tail feathers
#   - Plumage in earth tones (brown / grey / red / black)
# ============================================================================

static func _build_axe_beak(plan: Dictionary, root: Node3D) -> void:
	var base: Dictionary = plan.get("base", {})
	var palette: Dictionary = plan.get("palette", {})
	var limbs: Dictionary = plan.get("limbs", {})
	var meta: Dictionary = plan.get("meta", {})
	var species: String = String(meta.get("species", "Axe Beak"))

	var w: float = _axis(base, "width", 0.55)
	var h: float = _axis(base, "height", 1.55)
	var d: float = _axis(base, "depth", 0.65)
	var leg_length: float = float(limbs.get("leg_length", 0.95))
	var clearance: float = leg_length

	var render_seed: int = int(meta.get("render_seed", 0))
	var rng := RandomNumberGenerator.new()
	rng.seed = render_seed if render_seed != 0 else hash(species)

	# Per-individual variation
	var size_jitter: float = rng.randf_range(0.90, 1.18)
	var beak_size_jitter: float = rng.randf_range(0.90, 1.40)
	var neck_length_jitter: float = rng.randf_range(0.85, 1.20)
	w *= size_jitter
	h *= size_jitter
	d *= size_jitter
	leg_length *= rng.randf_range(0.90, 1.15)
	clearance = leg_length

	# Plumage palette — earth tones
	var feather_options := [
		Color(0.42, 0.30, 0.22),     # warm brown
		Color(0.55, 0.42, 0.28),     # tan
		Color(0.32, 0.28, 0.22),     # dark brown
		Color(0.18, 0.16, 0.14),     # near-black
		Color(0.62, 0.40, 0.20),     # rust orange
		Color(0.55, 0.50, 0.42),     # storm grey
		Color(0.45, 0.32, 0.18),     # russet
	]
	var beak_options := [
		Color(0.85, 0.65, 0.20),     # yellow-gold (iconic)
		Color(0.65, 0.50, 0.30),     # tan beak
		Color(0.30, 0.22, 0.18),     # near-black
		Color(0.85, 0.40, 0.10),     # bright orange
	]
	var primary: Color = feather_options[rng.randi() % feather_options.size()]
	var belly: Color = palette.get("secondary", primary.lightened(0.25))
	var feather_dark: Color = primary.darkened(0.20)
	var beak_color: Color = beak_options[rng.randi() % beak_options.size()]
	var leg_color: Color = beak_color.darkened(0.20)
	var claw_color := Color(0.12, 0.10, 0.06)
	var eye_color: Color = palette.get("eye", Color(0.95, 0.85, 0.10))

	# Has tail feathers? Most do, but make it variable
	var has_stripe: bool = rng.randf() > 0.55         # striped/banded plumage

	# ============================================================================
	# BODY — egg-shaped, slightly forward-leaning bipedal stance
	# ============================================================================
	var body_y: float = clearance + h * 0.30
	var body_sections: Array = [
		{"center": Vector3(0, body_y, -d * 0.35), "w": w * 0.30, "h": h * 0.28},   # tail end
		{"center": Vector3(0, body_y, -d * 0.10), "w": w * 0.50, "h": h * 0.40},
		{"center": Vector3(0, body_y, 0.10), "w": w * 0.52, "h": h * 0.42},        # widest mid
		{"center": Vector3(0, body_y, d * 0.30), "w": w * 0.42, "h": h * 0.36},    # chest
		{"center": Vector3(0, body_y + h * 0.05, d * 0.45), "w": w * 0.28, "h": h * 0.26},   # neck base
	]
	_swept_body(root, body_sections, 10, primary, belly, 0.90, true)

	# ============================================================================
	# NECK — tight "?"-shape, head carried FORWARD over the toes, not arched up
	# above the shoulders. Verify-agent fix: too swan-like before.
	# First segment near-vertical, then a forward tilt to place the head ahead
	# of the breast.
	# ============================================================================
	var neck_base := body_sections[4]["center"] as Vector3
	var neck_mid := Vector3(0, neck_base.y + h * (0.22 * neck_length_jitter),
		neck_base.z + d * 0.06)
	var head_anchor := Vector3(0, neck_base.y + h * (0.38 * neck_length_jitter),
		neck_base.z + d * (0.32 * neck_length_jitter))
	_build_tapered_segment(root, neck_base, w * 0.18, neck_mid, w * 0.15, primary, 0.90)
	_build_tapered_segment(root, neck_mid, w * 0.15, head_anchor + Vector3(0, -h * 0.06, 0),
		w * 0.16, primary, 0.90)

	# ============================================================================
	# HEAD — compact, bird-skull. Smaller than the beak for proper proportions.
	# ============================================================================
	var cran_w: float = w * 0.18
	var cran_h: float = h * 0.14
	var cran_d: float = d * 0.45
	_build_box(
		root,
		Vector3(-cran_w, head_anchor.y - cran_h * 0.10, head_anchor.z - cran_d * 0.40),
		Vector3(cran_w, head_anchor.y + cran_h * 0.85, head_anchor.z + cran_d * 0.45),
		primary, 0.92
	)

	# EYES — large on the sides of the head (predator binocular tendency)
	for side in [-1, 1]:
		_build_box(
			root,
			Vector3(side * cran_w * 0.85, head_anchor.y + cran_h * 0.20, head_anchor.z + cran_d * 0.20),
			Vector3(side * cran_w * 1.10, head_anchor.y + cran_h * 0.50, head_anchor.z + cran_d * 0.40),
			eye_color, 0.30, 0.15
		)
		# Pupil
		_build_box(
			root,
			Vector3(side * cran_w * 0.92, head_anchor.y + cran_h * 0.28, head_anchor.z + cran_d * 0.32),
			Vector3(side * cran_w * 1.03, head_anchor.y + cran_h * 0.42, head_anchor.z + cran_d * 0.40),
			Color(0.05, 0.04, 0.03), 0.30
		)

	# ============================================================================
	# AXE BEAK — the signature feature. The beak is an AXE-BLADE: long
	# straight-topped wedge for ~82% of its length, then a short sharp downturn
	# at the very tip (verify-agent fix: hook was curling too much before).
	# Beak extends to >100% of skull length.
	# ============================================================================
	var beak_base := Vector3(0, head_anchor.y + cran_h * 0.10, head_anchor.z + cran_d * 0.45)
	var beak_top_y: float = head_anchor.y + cran_h * (0.55 * beak_size_jitter)
	# bot_y is only ~25% lower than the blade-tip line — the hook drop is modest
	var beak_bot_y: float = head_anchor.y - cran_h * (0.55 * beak_size_jitter)
	var beak_back_w: float = cran_w * 0.95
	var beak_mid_w: float = cran_w * (1.05 * beak_size_jitter)
	var beak_full_length: float = cran_d * (1.50 * beak_size_jitter)
	var beak_blade_z: float = head_anchor.z + beak_full_length * 0.82   # blade ends here
	var beak_tip_z: float = head_anchor.z + beak_full_length            # hook tip
	# Upper jaw — straight-topped blade, then a SHORT hook curl at the very tip.
	# Eight key verts: back-bottom (BL/BR), back-top (TL/TR), blade-end top
	# (BladeTL/BladeTR), blade-end bottom (BladeBL/BladeBR), and a single Tip.
	var ubBL := Vector3(-beak_back_w, beak_base.y, beak_base.z)
	var ubBR := Vector3(beak_back_w, beak_base.y, beak_base.z)
	var ubTL := Vector3(-beak_back_w * 0.95, beak_top_y, beak_base.z + cran_d * 0.05)
	var ubTR := Vector3(beak_back_w * 0.95, beak_top_y, beak_base.z + cran_d * 0.05)
	# Blade-end top: still high — the top stays straight until the hook starts
	var ubBladeTL := Vector3(-beak_mid_w * 0.55, beak_top_y - cran_h * 0.04, beak_blade_z)
	var ubBladeTR := Vector3(beak_mid_w * 0.55, beak_top_y - cran_h * 0.04, beak_blade_z)
	# Blade-end bottom: stays near the base line — bottom edge is straighter too
	var ubBladeBL := Vector3(-beak_mid_w * 0.55, beak_bot_y * 0.45, beak_blade_z)
	var ubBladeBR := Vector3(beak_mid_w * 0.55, beak_bot_y * 0.45, beak_blade_z)
	# Hooked tip — drops down only ~25% of beak height from the blade line
	var ubTip := Vector3(0, beak_bot_y * 1.10, beak_tip_z)
	var st_beak := SurfaceTool.new()
	st_beak.begin(Mesh.PRIMITIVE_TRIANGLES)
	# Top — back to blade-end (long straight section)
	_add_quad(st_beak, ubTL, ubTR, ubBladeTR, ubBladeTL)
	# Bottom — back to blade-end (long straight section)
	_add_quad(st_beak, ubBladeBL, ubBladeBR, ubBR, ubBL)
	# Left side — back to blade
	_add_quad(st_beak, ubBL, ubTL, ubBladeTL, ubBladeBL)
	# Right side — back to blade
	_add_quad(st_beak, ubBladeBR, ubBladeTR, ubTR, ubBR)
	# Hook — short downturn from blade end to tip (tri fan)
	_add_tri(st_beak, ubBladeTL, ubBladeTR, ubTip)
	_add_tri(st_beak, ubBladeBL, ubTip, ubBladeBR)
	_add_tri(st_beak, ubBladeTL, ubTip, ubBladeBL)
	_add_tri(st_beak, ubBladeTR, ubBladeBR, ubTip)
	st_beak.generate_normals()
	var mi_beak := MeshInstance3D.new()
	mi_beak.mesh = st_beak.commit()
	var mat_beak := StandardMaterial3D.new()
	mat_beak.albedo_color = beak_color
	mat_beak.roughness = 0.40
	mat_beak.metallic = 0.10
	mat_beak.cull_mode = BaseMaterial3D.CULL_DISABLED
	mi_beak.material_override = mat_beak
	root.add_child(mi_beak)

	# Lower jaw — smaller, simpler wedge
	var lj_tip := Vector3(0, beak_bot_y, head_anchor.z + cran_d * (0.95 * beak_size_jitter))
	_build_box(
		root,
		Vector3(-beak_back_w * 0.75, beak_bot_y, beak_base.z),
		Vector3(beak_back_w * 0.75, beak_base.y - cran_h * 0.05, head_anchor.z + cran_d * 0.55),
		beak_color.darkened(0.10), 0.40
	)
	# Lower jaw tapered tip extending out
	_build_tapered_segment(root, Vector3(0, beak_bot_y + cran_h * 0.05, head_anchor.z + cran_d * 0.55),
		cran_w * 0.50, lj_tip, cran_w * 0.10, beak_color.darkened(0.10), 0.40)

	# ============================================================================
	# VESTIGIAL WINGS — small wing nubs folded against the body
	# ============================================================================
	for side in [-1, 1]:
		var wing_root := Vector3(side * w * 0.50, body_y + h * 0.10, d * 0.05)
		var wing_tip := Vector3(side * w * 0.62, body_y - h * 0.15, -d * 0.20)
		_build_tapered_segment(root, wing_root, w * 0.08, wing_tip, w * 0.04,
			feather_dark, 0.95)
		# Small wing feather details
		for fi in range(3):
			var ft: float = float(fi + 1) / 4.0
			var f_root := wing_root.lerp(wing_tip, ft * 0.3)
			var f_tip := Vector3(side * w * 0.60, body_y - h * (0.10 + ft * 0.15), -d * 0.20)
			_build_tapered_segment(root, f_root, w * 0.020, f_tip, w * 0.006,
				feather_dark, 0.95)

	# ============================================================================
	# TAIL FEATHERS — short stubby BUSTLE tucked against the rump.
	# Verify-agent fix: previous 5-feather horizontal fan read peacock/turkey,
	# not phorusrhacid. Real terror birds had vestigial tails.
	# Three short downward-angled tufts, no horizontal spread.
	# ============================================================================
	var tail_anchor := Vector3(0, body_y + h * 0.10, -d * 0.32)
	for fi in range(3):
		var t_off: float = (float(fi) - 1.0) * w * 0.10   # -w*0.10, 0, +w*0.10
		var feather_tip := Vector3(
			tail_anchor.x + t_off,
			tail_anchor.y - h * 0.18,
			tail_anchor.z - d * 0.18
		)
		var fc: Color = primary if (fi == 1) else feather_dark
		_build_tapered_segment(root, tail_anchor, w * 0.06, feather_tip, w * 0.020,
			fc, 0.95)

	# ============================================================================
	# POWERFUL LEGS — 2 long digitigrade bird legs with talons
	# ============================================================================
	for side in [-1, 1]:
		var leg_jitter: float = rng.randf_range(0.95, 1.10)
		var hip_x: float = side * w * 0.18
		var hip_pos := Vector3(hip_x, body_y - h * 0.10, 0)
		# Thigh (feathered — uses primary color)
		var knee := Vector3(hip_x, clearance * 0.60 * leg_jitter, d * 0.05)
		var ankle := Vector3(hip_x, clearance * 0.20, -d * 0.04)
		var foot := Vector3(hip_x, 0.0, d * 0.10)
		_build_tapered_segment(root, hip_pos, w * 0.14, knee, w * 0.10, primary, 0.92)
		# Shin (bare scaly leg)
		_build_tapered_segment(root, knee, w * 0.07, ankle, w * 0.06, leg_color, 0.60)
		# Metatarsal (ankle → foot)
		_build_tapered_segment(root, ankle, w * 0.06, foot, w * 0.055, leg_color, 0.60)
		# 3 forward talons + 1 back talon
		for ti in range(3):
			var to: float = (float(ti) - 1.0) * w * 0.07
			var toe_tip := Vector3(foot.x + to, 0.0, foot.z + w * 0.20)
			_build_tapered_segment(root, foot, w * 0.035, toe_tip, w * 0.010,
				leg_color.darkened(0.10), 0.60)
			# Claw at the tip
			var claw_tip := Vector3(toe_tip.x, 0.02, toe_tip.z + w * 0.08)
			_build_tapered_segment(root, toe_tip, w * 0.010, claw_tip, w * 0.004,
				claw_color, 0.40)
		# Back talon (dewclaw)
		var back_toe := Vector3(foot.x, 0.0, foot.z - w * 0.10)
		_build_tapered_segment(root, foot, w * 0.025, back_toe, w * 0.005,
			claw_color, 0.40)

	# ============================================================================
	# OPTIONAL STRIPE PATTERN — bands across the body
	# ============================================================================
	if has_stripe:
		var stripe_count: int = rng.randi_range(3, 6)
		var stripe_color: Color = primary.darkened(0.40)
		for si in range(stripe_count):
			var t: float = float(si) / float(stripe_count - 1)
			var sz: float = lerpf(-d * 0.30, d * 0.20, t)
			_build_box(
				root,
				Vector3(-w * 0.50, body_y + h * 0.20, sz - w * 0.04),
				Vector3(w * 0.50, body_y + h * 0.45, sz + w * 0.04),
				stripe_color, 0.92
			)


# ============================================================================
# AZER (azer)
# Brass-skinned fire-dwarf forge workers from the Plane of Fire.
#   - Stocky dwarf proportions (wide, short, broad shoulders)
#   - Polished BRASS / BRONZE metallic skin (metallic = 0.85+)
#   - FLAMING HAIR + FLAMING BEARD (literal fire, bright emissive)
#   - Leather + bronze studded kilt
#   - Forge hammer in one hand (signature tool)
#   - Glowing forge-coal eyes
# ============================================================================

static func _build_azer(plan: Dictionary, root: Node3D) -> void:
	var base: Dictionary = plan.get("base", {})
	var palette: Dictionary = plan.get("palette", {})
	var limbs: Dictionary = plan.get("limbs", {})
	var meta: Dictionary = plan.get("meta", {})
	var species: String = String(meta.get("species", "Azer"))

	# Dwarven proportions — short and wide.
	var w: float = _axis(base, "width", 0.55)
	var h: float = _axis(base, "height", 1.30)
	var d: float = _axis(base, "depth", 0.40)
	var leg_length: float = float(limbs.get("leg_length", 0.55))
	var clearance: float = leg_length

	var render_seed: int = int(meta.get("render_seed", 0))
	var rng := RandomNumberGenerator.new()
	rng.seed = render_seed if render_seed != 0 else hash(species)

	# Per-individual variation
	var size_jitter: float = rng.randf_range(0.92, 1.10)
	var beard_size_jitter: float = rng.randf_range(0.85, 1.30)
	var flame_height_jitter: float = rng.randf_range(0.85, 1.35)
	w *= size_jitter
	h *= size_jitter
	d *= size_jitter
	leg_length *= rng.randf_range(0.90, 1.10)
	clearance = leg_length

	# Brass / bronze skin palette — pick from polished, oxidized, dark.
	var brass_options := [
		Color(0.90, 0.70, 0.30),   # polished brass
		Color(0.78, 0.55, 0.22),   # bronze
		Color(0.95, 0.75, 0.35),   # bright gold-brass
		Color(0.68, 0.48, 0.20),   # darker bronze
		Color(0.85, 0.60, 0.25),   # copper-brass
	]
	var primary: Color = brass_options[rng.randi() % brass_options.size()]
	# Flame palette — bright, emissive
	var flame_core := Color(1.0, 0.92, 0.55)        # near-white core
	var flame_mid := Color(1.0, 0.65, 0.18)         # orange
	var flame_outer := Color(0.95, 0.30, 0.08)      # deep red-orange
	# Variations on flame hue
	if rng.randf() < 0.20:
		# Blue-flame variant (hottest azers)
		flame_core = Color(0.85, 0.95, 1.0)
		flame_mid = Color(0.45, 0.65, 1.0)
		flame_outer = Color(0.20, 0.35, 0.95)
	var leather_color := Color(0.30, 0.18, 0.10)
	var iron_color := Color(0.25, 0.22, 0.20)
	# Verify-agent fix: canonical azer eyes are dull metallic, NOT glowing.
	# The fire lives in the hair/beard; eyes contrast as cold metal sockets.
	# Pick from brass, copper, dark red flecks per the Fiend Folio / 5E MM.
	var azer_eye_options := [
		Color(0.45, 0.30, 0.12),   # dull bronze
		Color(0.55, 0.32, 0.18),   # copper
		Color(0.42, 0.10, 0.08),   # deep red iris
		Color(0.50, 0.40, 0.20),   # tarnished brass
	]
	var eye_color_metal: Color = azer_eye_options[rng.randi() % azer_eye_options.size()]

	# Sometimes a flame-foot (one leg ends in fire rather than a foot — canon)
	var has_flame_foot: bool = rng.randf() < 0.35
	# Some Azers have helmets/forge masks
	var has_helmet: bool = rng.randf() < 0.30

	# ============================================================================
	# TORSO — stocky dwarven build, broad chest, slight belly
	# ============================================================================
	var torso_y: float = clearance + h * 0.18
	var torso_top_y: float = clearance + h * 0.55
	var chest_y: float = clearance + h * 0.42
	var belt_y: float = clearance + h * 0.18
	# Lower body (kilt visible separately on top)
	_build_box(
		root,
		Vector3(-w * 0.40, clearance + h * 0.03, -d * 0.32),
		Vector3(w * 0.40, belt_y, d * 0.32),
		primary, 0.30, 0.90
	)
	# Mid torso (waist → chest)
	_build_box(
		root,
		Vector3(-w * 0.45, belt_y, -d * 0.35),
		Vector3(w * 0.45, chest_y, d * 0.36),
		primary, 0.30, 0.90
	)
	# Upper chest (broader shoulders)
	_build_box(
		root,
		Vector3(-w * 0.52, chest_y, -d * 0.34),
		Vector3(w * 0.52, torso_top_y, d * 0.34),
		primary, 0.30, 0.90
	)

	# Leather + bronze studded kilt — 5-6 plates with a WIDER central front
	# panel per the canonical Tony DiTerlizzi / Wayne Reynolds illustrations.
	# (Verify-agent fix: 8 plates around a dwarf waist read as armor skirting
	# instead of a smith's apron-kilt.)
	var kilt_y_top: float = belt_y - h * 0.01
	var kilt_y_bot: float = clearance + h * 0.02
	var kilt_plate_count: int = rng.randi_range(5, 6)
	for kside in range(kilt_plate_count):
		var ang: float = float(kside) / float(kilt_plate_count) * TAU
		var kx: float = cos(ang) * w * 0.43
		var kz: float = sin(ang) * d * 0.36
		# Front-center plate (closest to +Z, ang ≈ PI/2) is wider; sides narrower.
		var forward_factor: float = max(0.0, sin(ang))   # 1 at front, 0 sides, neg back
		var plate_half_w: float = lerpf(w * 0.06, w * 0.11, forward_factor)
		_build_box(
			root,
			Vector3(kx - plate_half_w, kilt_y_bot, kz - d * 0.05),
			Vector3(kx + plate_half_w, kilt_y_top, kz + d * 0.05),
			leather_color, 0.85
		)
	# Bronze belt
	_build_box(
		root,
		Vector3(-w * 0.47, belt_y - h * 0.04, -d * 0.37),
		Vector3(w * 0.47, belt_y + h * 0.02, d * 0.38),
		primary.darkened(0.10), 0.30, 0.85
	)
	# Belt buckle (centered, larger)
	_build_box(
		root,
		Vector3(-w * 0.10, belt_y - h * 0.05, d * 0.36),
		Vector3(w * 0.10, belt_y + h * 0.03, d * 0.42),
		Color(0.95, 0.80, 0.40), 0.20, 0.95
	)

	# ============================================================================
	# HEAD — round dwarf skull, prominent brow ridge
	# ============================================================================
	var head_size: float = w * 0.45
	var head_y_bot: float = torso_top_y + h * 0.02
	var head_y_top: float = head_y_bot + h * 0.30
	var head_center_y: float = (head_y_bot + head_y_top) * 0.5
	_build_box(
		root,
		Vector3(-head_size, head_y_bot, -head_size * 0.85),
		Vector3(head_size, head_y_top, head_size * 0.95),
		primary, 0.30, 0.90
	)
	# Brow ridge — heavy, casts shadow over the eyes
	_build_box(
		root,
		Vector3(-head_size * 1.02, head_center_y + h * 0.04, head_size * 0.70),
		Vector3(head_size * 1.02, head_center_y + h * 0.10, head_size * 1.02),
		primary.darkened(0.10), 0.35, 0.88
	)

	# EYES — DULL METALLIC sockets (NOT glowing). The fire lives in the
	# hair/beard; canonical azer eyes are cold contrasting metal.
	for side in [-1, 1]:
		_build_box(
			root,
			Vector3(side * head_size * 0.55 - w * 0.04,
				head_center_y - h * 0.005, head_size * 0.92),
			Vector3(side * head_size * 0.55 + w * 0.04,
				head_center_y + h * 0.035, head_size * 1.01),
			eye_color_metal, 0.45, 0.70
		)
		# Tiny dark pupil (cold, not luminous)
		_build_box(
			root,
			Vector3(side * head_size * 0.55 - w * 0.014,
				head_center_y + h * 0.005, head_size * 0.98),
			Vector3(side * head_size * 0.55 + w * 0.014,
				head_center_y + h * 0.025, head_size * 1.02),
			Color(0.08, 0.06, 0.05), 0.50
		)

	# Stocky nose
	_build_box(
		root,
		Vector3(-w * 0.06, head_center_y - h * 0.02, head_size * 0.94),
		Vector3(w * 0.06, head_center_y + h * 0.03, head_size * 1.08),
		primary, 0.30, 0.90
	)

	# Optional bronze forge helmet
	if has_helmet:
		_build_box(
			root,
			Vector3(-head_size * 1.10, head_y_top - h * 0.02, -head_size * 0.90),
			Vector3(head_size * 1.10, head_y_top + h * 0.06, head_size * 1.00),
			Color(0.78, 0.55, 0.22), 0.20, 0.95
		)

	# ============================================================================
	# FLAMING HAIR — column of flame rising from the top of the head.
	# Build as 3 stacked tapered segments (outer red, mid orange, core yellow)
	# with random side licks.
	# ============================================================================
	var flame_base_y: float = head_y_top - h * 0.005
	var flame_tip_y: float = flame_base_y + h * (0.55 * flame_height_jitter)
	# Outer envelope
	_build_tapered_segment(root,
		Vector3(0, flame_base_y, 0.0), head_size * 1.05,
		Vector3(0, flame_tip_y, 0.0), head_size * 0.05,
		flame_outer, 0.05, 0.0)
	# Mid layer (offset slightly forward)
	_build_tapered_segment(root,
		Vector3(0, flame_base_y + h * 0.01, head_size * 0.08), head_size * 0.85,
		Vector3(0, flame_tip_y - h * 0.05, head_size * 0.05), head_size * 0.04,
		flame_mid, 0.05, 0.0)
	# Core
	_build_tapered_segment(root,
		Vector3(0, flame_base_y + h * 0.02, 0.0), head_size * 0.55,
		Vector3(0, flame_tip_y - h * 0.10, 0.0), head_size * 0.03,
		flame_core, 0.05, 0.0)
	# Side flame licks — 2-4 extra tongues
	var lick_count: int = rng.randi_range(2, 4)
	for li in range(lick_count):
		var lick_ang: float = rng.randf_range(0.0, TAU)
		var lick_off_x: float = cos(lick_ang) * head_size * 0.7
		var lick_off_z: float = sin(lick_ang) * head_size * 0.7
		var lick_h: float = h * rng.randf_range(0.18, 0.35)
		_build_tapered_segment(root,
			Vector3(lick_off_x * 0.5, flame_base_y, lick_off_z * 0.5), head_size * 0.30,
			Vector3(lick_off_x, flame_base_y + lick_h, lick_off_z), head_size * 0.04,
			flame_outer.lerp(flame_mid, 0.5), 0.05, 0.0)

	# ============================================================================
	# FLAMING BEARD — fire pouring down from the chin, forking
	# ============================================================================
	var beard_base_y: float = head_center_y - h * 0.03
	var beard_tip_y: float = head_y_bot - h * (0.25 * beard_size_jitter)
	# Outer beard envelope (red-orange)
	_build_tapered_segment(root,
		Vector3(0, beard_base_y, head_size * 0.78), head_size * 0.95,
		Vector3(0, beard_tip_y + h * 0.05, head_size * 0.55), head_size * 0.55,
		flame_outer, 0.05, 0.0)
	# Forked beard tips — 2-3 forks at the bottom
	var fork_count: int = rng.randi_range(2, 3)
	for fk in range(fork_count):
		var fork_t: float = (float(fk) - (fork_count - 1) * 0.5) / float(fork_count)
		var fork_x: float = fork_t * head_size * 0.85
		var fork_h: float = h * rng.randf_range(0.10, 0.22)
		_build_tapered_segment(root,
			Vector3(fork_x * 0.4, beard_tip_y + h * 0.05, head_size * 0.55), head_size * 0.30,
			Vector3(fork_x, beard_tip_y - fork_h, head_size * 0.45), head_size * 0.04,
			flame_mid, 0.05, 0.0)
	# Beard core (yellow-white) — visible center
	_build_tapered_segment(root,
		Vector3(0, beard_base_y + h * 0.01, head_size * 0.82), head_size * 0.55,
		Vector3(0, beard_tip_y + h * 0.05, head_size * 0.50), head_size * 0.20,
		flame_core, 0.05, 0.0)

	# Moustache flames (small horizontal tongues either side of the nose)
	for side in [-1, 1]:
		_build_tapered_segment(root,
			Vector3(side * w * 0.05, head_center_y - h * 0.005, head_size * 0.96),
			head_size * 0.12,
			Vector3(side * w * 0.32, head_center_y + h * 0.01, head_size * 0.90),
			head_size * 0.03,
			flame_mid, 0.05, 0.0)

	# ============================================================================
	# ARMS — short stocky brass-skinned arms with bracers
	# ============================================================================
	var shoulder_y: float = torso_top_y - h * 0.04
	for side in [-1, 1]:
		var shoulder := Vector3(side * w * 0.52, shoulder_y, 0.0)
		var elbow := Vector3(side * (w * 0.58), shoulder_y - h * 0.18, d * 0.05)
		var wrist := Vector3(side * (w * 0.50), shoulder_y - h * 0.35, d * 0.20)
		# Upper arm
		_build_tapered_segment(root, shoulder, w * 0.16, elbow, w * 0.13, primary, 0.30, 0.90)
		# Forearm
		_build_tapered_segment(root, elbow, w * 0.13, wrist, w * 0.11, primary, 0.30, 0.90)
		# Bronze bracer (darker brass band around the forearm)
		_build_tapered_segment(root,
			elbow.lerp(wrist, 0.40), w * 0.135,
			elbow.lerp(wrist, 0.85), w * 0.115,
			primary.darkened(0.20), 0.20, 0.95)
		# Hand
		_build_box(
			root,
			Vector3(wrist.x - w * 0.08, wrist.y - h * 0.04, wrist.z - d * 0.06),
			Vector3(wrist.x + w * 0.08, wrist.y + h * 0.01, wrist.z + d * 0.06),
			primary, 0.30, 0.90
		)

	# ============================================================================
	# FORGE HAMMER — held in the right hand (always — signature tool)
	# Heavy iron head + bronze-banded wooden haft
	# ============================================================================
	var hand_r := Vector3(w * 0.50, shoulder_y - h * 0.35, d * 0.20)
	var haft_top := Vector3(w * 0.55, shoulder_y + h * 0.10, d * 0.22)
	var haft_bot := Vector3(w * 0.45, shoulder_y - h * 0.55, d * 0.18)
	# Wooden haft
	_build_tapered_segment(root, haft_bot, w * 0.04, haft_top, w * 0.045,
		leather_color.lightened(0.20), 0.80)
	# Bronze head (heavy block at the top of the haft)
	_build_box(
		root,
		Vector3(haft_top.x - w * 0.18, haft_top.y - h * 0.04, haft_top.z - d * 0.18),
		Vector3(haft_top.x + w * 0.18, haft_top.y + h * 0.10, haft_top.z + d * 0.18),
		iron_color, 0.30, 0.90
	)
	# Bronze trim on the hammer head ends
	for s in [-1, 1]:
		_build_box(
			root,
			Vector3(haft_top.x + s * w * 0.18 - w * 0.02, haft_top.y - h * 0.05,
				haft_top.z - d * 0.20),
			Vector3(haft_top.x + s * w * 0.18 + w * 0.02, haft_top.y + h * 0.11,
				haft_top.z + d * 0.20),
			primary.darkened(0.20), 0.25, 0.95
		)

	# ============================================================================
	# LEGS — stocky and short. Optional flame-foot variant on one leg.
	# ============================================================================
	for side in [-1, 1]:
		var hip := Vector3(side * w * 0.20, clearance + h * 0.05, 0.0)
		var knee := Vector3(side * w * 0.22, clearance * 0.45, d * 0.02)
		var foot_top := Vector3(side * w * 0.20, 0.05, 0.0)
		_build_tapered_segment(root, hip, w * 0.17, knee, w * 0.13, primary, 0.30, 0.90)
		_build_tapered_segment(root, knee, w * 0.13, foot_top, w * 0.11, primary, 0.30, 0.90)

		# Foot vs flame-foot. Verify-agent fix: canon azers go BAREFOOT on
		# brass legs — they walk on hot forge floors. No boots; just a thin
		# bronze anklet for ornamentation.
		var make_flame_foot: bool = has_flame_foot and side == 1
		if make_flame_foot:
			# Flame foot: foot replaced with a cone of fire
			_build_tapered_segment(root,
				Vector3(side * w * 0.20, 0.0, 0.0), w * 0.18,
				Vector3(side * w * 0.20 + w * 0.05, h * 0.25, d * 0.02), w * 0.03,
				flame_outer, 0.05, 0.0)
			_build_tapered_segment(root,
				Vector3(side * w * 0.20, 0.005, 0.0), w * 0.10,
				Vector3(side * w * 0.20 + w * 0.03, h * 0.18, d * 0.01), w * 0.02,
				flame_core, 0.05, 0.0)
		else:
			# Bare brass foot — flat top of foot + short toes, no boot.
			_build_box(
				root,
				Vector3(side * w * 0.20 - w * 0.11, 0.0, -d * 0.08),
				Vector3(side * w * 0.20 + w * 0.11, h * 0.05, d * 0.20),
				primary, 0.30, 0.90
			)
			# Five short toe stubs along the front edge
			for ti in range(5):
				var toe_t: float = (float(ti) - 2.0) / 2.5   # -0.8 to +0.8
				var tx: float = side * w * 0.20 + toe_t * w * 0.09
				_build_box(
					root,
					Vector3(tx - w * 0.018, 0.0, d * 0.20),
					Vector3(tx + w * 0.018, h * 0.025, d * 0.26),
					primary, 0.30, 0.90
				)
			# Thin bronze anklet — ornamentation only
			_build_box(
				root,
				Vector3(side * w * 0.20 - w * 0.13, h * 0.05, -d * 0.10),
				Vector3(side * w * 0.20 + w * 0.13, h * 0.08, d * 0.10),
				primary.darkened(0.20), 0.25, 0.95
			)


# ============================================================================
# BABAU (babau)
# Demon assassins from the Abyss — gaunt, hunched, oozing acidic slime.
#   - Tall, lean, hunched humanoid silhouette
#   - SKULL-LIKE HEAD with prominent fangs and small horns
#   - Sunken glowing red eye sockets
#   - Long forearms with razor claws (knuckle-walker tendency)
#   - Oily black/red wet-looking skin (metallic + low roughness for the sheen)
#   - Bony shoulder/spine spikes
#   - Long whip-like tail
# ============================================================================

static func _build_babau(plan: Dictionary, root: Node3D) -> void:
	var base: Dictionary = plan.get("base", {})
	var palette: Dictionary = plan.get("palette", {})
	var limbs: Dictionary = plan.get("limbs", {})
	var meta: Dictionary = plan.get("meta", {})
	var species: String = String(meta.get("species", "Babau"))

	# Lean tall demon
	var w: float = _axis(base, "width", 0.55)
	var h: float = _axis(base, "height", 1.95)
	var d: float = _axis(base, "depth", 0.45)
	var leg_length: float = float(limbs.get("leg_length", 0.95))
	var clearance: float = leg_length

	var render_seed: int = int(meta.get("render_seed", 0))
	var rng := RandomNumberGenerator.new()
	rng.seed = render_seed if render_seed != 0 else hash(species)

	# Per-individual jitter
	var size_jitter: float = rng.randf_range(0.90, 1.15)
	var horn_size_jitter: float = rng.randf_range(0.75, 1.45)
	var spike_count_jitter: int = rng.randi_range(3, 6)
	var claw_size_jitter: float = rng.randf_range(0.85, 1.30)
	w *= size_jitter
	h *= size_jitter
	d *= size_jitter
	leg_length *= rng.randf_range(0.90, 1.10)
	clearance = leg_length

	# Skin palette — canon babau are mottled black + russet-brown, oily/wet.
	# Verify-agent fix: previous 5-color spread made plum/grey individuals read
	# as different demons. Locked to the two canonical hues, with the russet
	# used as the "mottle dark" overlay rather than a primary variant.
	var primary := Color(0.06, 0.04, 0.04)        # near-black demon hide
	var skin_dark := Color(0.18, 0.08, 0.05)      # russet-brown mottling
	var bone_color := Color(0.85, 0.80, 0.70)         # for fangs/spikes/horns
	var bone_dark: Color = bone_color.darkened(0.25)
	var claw_color := Color(0.12, 0.10, 0.10)
	var eye_glow := Color(1.0, 0.18, 0.05)            # burning red eye sockets
	# Slime drip color (acidic green tinge) — appears at edges
	var slime_color := Color(0.55, 0.62, 0.20)

	# ============================================================================
	# TORSO — hunched, gaunt rib-cage with bony chest plate look
	# ============================================================================
	var hip_y: float = clearance
	var chest_y: float = clearance + h * 0.32
	var shoulder_y: float = clearance + h * 0.45
	# Lean abdomen
	_build_box(
		root,
		Vector3(-w * 0.32, hip_y, -d * 0.22),
		Vector3(w * 0.32, chest_y, d * 0.22),
		primary, 0.30, 0.0
	)
	# Rib cage (broader)
	_build_box(
		root,
		Vector3(-w * 0.40, chest_y, -d * 0.25),
		Vector3(w * 0.40, shoulder_y, d * 0.28),
		primary, 0.30, 0.0
	)
	# Visible rib lines — 3 darker bands across the chest
	for ri in range(3):
		var ry: float = lerpf(chest_y + h * 0.02, shoulder_y - h * 0.02, float(ri) / 2.0)
		_build_box(
			root,
			Vector3(-w * 0.41, ry - h * 0.008, d * 0.27),
			Vector3(w * 0.41, ry + h * 0.008, d * 0.30),
			skin_dark, 0.30
		)

	# ============================================================================
	# SHOULDER SPIKES — bony spikes erupting from the trapezius
	# ============================================================================
	for side in [-1, 1]:
		var spk_count: int = spike_count_jitter
		for si in range(spk_count):
			var sx: float = side * (w * 0.30 + float(si) * w * 0.04)
			var sy: float = shoulder_y - h * 0.01
			# Tilted outward + upward, with progressive shrink
			var spike_h: float = h * lerpf(0.18, 0.08, float(si) / max(1.0, float(spk_count - 1)))
			var spike_tip := Vector3(sx + side * w * 0.10, sy + spike_h, -d * 0.05)
			_build_tapered_segment(root,
				Vector3(sx, sy, 0.0), w * 0.05,
				spike_tip, w * 0.008,
				bone_color, 0.55)

	# Spine spikes — a row of 4-6 along the upper back
	var back_spike_count: int = rng.randi_range(4, 6)
	for bsi in range(back_spike_count):
		var bsy: float = lerpf(chest_y, shoulder_y - h * 0.01, float(bsi) / float(back_spike_count - 1))
		var bs_tip := Vector3(0, bsy + h * 0.06, -d * 0.40)
		_build_tapered_segment(root,
			Vector3(0, bsy, -d * 0.25), w * 0.05,
			bs_tip, w * 0.010,
			bone_dark, 0.55)

	# ============================================================================
	# HEAD — skull-like, hunched forward on a thick neck
	# ============================================================================
	var neck_top := Vector3(0, shoulder_y + h * 0.04, d * 0.10)
	_build_tapered_segment(root,
		Vector3(0, shoulder_y - h * 0.02, 0.0), w * 0.16,
		neck_top, w * 0.13,
		primary, 0.30, 0.0)

	var head_w: float = w * 0.32
	var head_h: float = h * 0.18
	var head_d: float = d * 0.60
	var head_y_bot: float = neck_top.y - h * 0.01
	var head_y_top: float = head_y_bot + head_h
	var head_center_y: float = (head_y_bot + head_y_top) * 0.5
	# Skull base (wider behind, narrower in front)
	_build_box(
		root,
		Vector3(-head_w, head_y_bot, neck_top.z - head_d * 0.35),
		Vector3(head_w, head_y_top, neck_top.z + head_d * 0.55),
		primary, 0.30, 0.0
	)
	# Brow ridge — heavy, casts shadow over eyes
	_build_box(
		root,
		Vector3(-head_w * 1.05, head_center_y + h * 0.03, neck_top.z + head_d * 0.20),
		Vector3(head_w * 1.05, head_center_y + h * 0.08, neck_top.z + head_d * 0.55),
		skin_dark, 0.30
	)

	# Skull-cheek hollow — darker patches on the sides of the face
	for side in [-1, 1]:
		_build_box(
			root,
			Vector3(side * head_w * 0.55, head_center_y - h * 0.04,
				neck_top.z + head_d * 0.25),
			Vector3(side * head_w * 1.02, head_center_y + h * 0.02,
				neck_top.z + head_d * 0.50),
			skin_dark, 0.30
		)

	# SUNKEN GLOWING RED EYE SOCKETS — deep in the brow shadow
	for side in [-1, 1]:
		# Socket recess (dark)
		_build_box(
			root,
			Vector3(side * head_w * 0.50 - w * 0.04,
				head_center_y - h * 0.005, neck_top.z + head_d * 0.45),
			Vector3(side * head_w * 0.50 + w * 0.04,
				head_center_y + h * 0.035, neck_top.z + head_d * 0.50),
			Color(0.03, 0.02, 0.02), 0.80
		)
		# Glowing red point inside the socket
		_build_box(
			root,
			Vector3(side * head_w * 0.50 - w * 0.020,
				head_center_y + h * 0.005, neck_top.z + head_d * 0.50),
			Vector3(side * head_w * 0.50 + w * 0.020,
				head_center_y + h * 0.025, neck_top.z + head_d * 0.56),
			eye_glow, 0.05, 0.0
		)

	# HORNS — single pair emerging from the TEMPLES (sides of skull above
	# ears), sweeping backward and slightly down along the skull profile.
	# Verify-agent fix: crown-mounted twin-segment horns read as glabrezu.
	# One long smooth segment per side.
	for side in [-1, 1]:
		var horn_base := Vector3(side * head_w * 1.00,
			head_y_top - h * 0.08,
			neck_top.z + head_d * 0.20)
		var horn_tip := Vector3(side * head_w * 1.05,
			head_y_top - h * (0.02 / max(0.5, horn_size_jitter)),
			neck_top.z - head_d * (0.30 * horn_size_jitter))
		_build_tapered_segment(root, horn_base, w * 0.05, horn_tip, w * 0.010,
			bone_color, 0.55)

	# JAW — wide gaping maw with FANGS
	var jaw_y_top: float = head_y_bot - h * 0.005
	var jaw_y_bot: float = jaw_y_top - h * 0.07
	_build_box(
		root,
		Vector3(-head_w * 0.90, jaw_y_bot, neck_top.z + head_d * 0.05),
		Vector3(head_w * 0.90, jaw_y_top, neck_top.z + head_d * 0.55),
		skin_dark, 0.30
	)
	# Inner mouth (dark slot)
	_build_box(
		root,
		Vector3(-head_w * 0.75, jaw_y_bot + h * 0.005,
			neck_top.z + head_d * 0.10),
		Vector3(head_w * 0.75, jaw_y_top - h * 0.005,
			neck_top.z + head_d * 0.50),
		Color(0.05, 0.02, 0.02), 0.85
	)
	# Upper fangs — 2 corner canines (verify-agent fix: 4 fangs read as vrock).
	for side in [-1, 1]:
		var fx_c: float = side * head_w * 0.65
		_build_tapered_segment(root,
			Vector3(fx_c, jaw_y_top, neck_top.z + head_d * 0.40), w * 0.028,
			Vector3(fx_c, jaw_y_top - h * 0.07, neck_top.z + head_d * 0.45), w * 0.008,
			bone_color, 0.45)
	# Lower fangs — 2 prominent
	for side in [-1, 1]:
		var lfx: float = side * head_w * 0.55
		_build_tapered_segment(root,
			Vector3(lfx, jaw_y_bot, neck_top.z + head_d * 0.42), w * 0.025,
			Vector3(lfx, jaw_y_bot + h * 0.055, neck_top.z + head_d * 0.48), w * 0.008,
			bone_color, 0.45)

	# ============================================================================
	# ARMS — long lean, forearms extend lower than the hips (knuckle-walker hint)
	# ============================================================================
	for side in [-1, 1]:
		var shoulder := Vector3(side * w * 0.45, shoulder_y - h * 0.03, 0.0)
		# Upper arm angled outward
		var elbow := Vector3(side * w * 0.62, chest_y - h * 0.08, d * 0.04)
		# Forearm extending down PAST the hip
		var wrist := Vector3(side * w * 0.55, hip_y - h * 0.10, d * 0.12)
		_build_tapered_segment(root, shoulder, w * 0.13, elbow, w * 0.10, primary, 0.30, 0.0)
		_build_tapered_segment(root, elbow, w * 0.10, wrist, w * 0.09, primary, 0.30, 0.0)
		# Elbow spike — small bone protrusion
		_build_tapered_segment(root,
			elbow, w * 0.035,
			Vector3(side * w * 0.72, chest_y - h * 0.16, d * 0.0), w * 0.008,
			bone_dark, 0.55)
		# Hand
		_build_box(
			root,
			Vector3(wrist.x - w * 0.08, wrist.y - h * 0.06, wrist.z - d * 0.05),
			Vector3(wrist.x + w * 0.08, wrist.y + h * 0.01, wrist.z + d * 0.08),
			skin_dark, 0.30, 0.0
		)
		# 4 LONG razor claws + thumb claw
		for ci in range(4):
			var ct: float = (float(ci) - 1.5) / 2.0   # -0.75..+0.75
			var cx: float = wrist.x + ct * w * 0.06
			var claw_tip := Vector3(cx, wrist.y - h * (0.10 * claw_size_jitter),
				wrist.z + d * (0.22 * claw_size_jitter))
			_build_tapered_segment(root,
				Vector3(cx, wrist.y - h * 0.04, wrist.z + d * 0.07), w * 0.018,
				claw_tip, w * 0.004,
				claw_color, 0.30)
		# Thumb claw
		var thumb_tip := Vector3(wrist.x - side * w * 0.05,
			wrist.y - h * 0.06,
			wrist.z + d * 0.12)
		_build_tapered_segment(root,
			Vector3(wrist.x - side * w * 0.06, wrist.y, wrist.z + d * 0.02),
			w * 0.020,
			thumb_tip, w * 0.005,
			claw_color, 0.30)

	# ============================================================================
	# LEGS — digitigrade demon legs, lean, with hooves replaced by clawed feet
	# ============================================================================
	for side in [-1, 1]:
		var hip := Vector3(side * w * 0.20, hip_y + h * 0.02, 0.0)
		var knee := Vector3(side * w * 0.25, clearance * 0.55, d * 0.05)
		var ankle := Vector3(side * w * 0.20, clearance * 0.18, -d * 0.05)
		var foot := Vector3(side * w * 0.20, 0.05, d * 0.05)
		_build_tapered_segment(root, hip, w * 0.16, knee, w * 0.11, primary, 0.30, 0.0)
		_build_tapered_segment(root, knee, w * 0.10, ankle, w * 0.085, primary, 0.30, 0.0)
		_build_tapered_segment(root, ankle, w * 0.085, foot, w * 0.075, skin_dark, 0.30)
		# Foot pad
		_build_box(
			root,
			Vector3(side * w * 0.20 - w * 0.10, 0.0, -d * 0.05),
			Vector3(side * w * 0.20 + w * 0.10, h * 0.04, d * 0.18),
			skin_dark, 0.30
		)
		# 3 forward toe claws
		for ti in range(3):
			var to: float = (float(ti) - 1.0) * w * 0.06
			var toe_tip := Vector3(side * w * 0.20 + to, 0.0, d * (0.30 * claw_size_jitter))
			_build_tapered_segment(root,
				Vector3(side * w * 0.20 + to, h * 0.02, d * 0.16), w * 0.025,
				toe_tip, w * 0.006,
				claw_color, 0.30)

	# ============================================================================
	# TAIL — long, thin, whip-like, dragging behind
	# ============================================================================
	var tail_base := Vector3(0, hip_y + h * 0.04, -d * 0.18)
	var tail_mid := Vector3(0, hip_y - h * 0.05, -d * 0.55)
	var tail_tip := Vector3(rng.randf_range(-w * 0.10, w * 0.10),
		h * 0.02, -d * 0.90)
	_build_tapered_segment(root, tail_base, w * 0.10, tail_mid, w * 0.055, primary, 0.30, 0.0)
	# Smooth rat-like taper to a fine point — no spade (verify-agent: canon
	# babau tails are unornamented; spade reads as devil/abishai).
	_build_tapered_segment(root, tail_mid, w * 0.055, tail_tip, w * 0.006, skin_dark, 0.30)

	# ============================================================================
	# ACID SLIME DRIPS — small green ooze droplets on shoulders/elbows/jaw
	# Signature babau feature (their hide constantly secretes acid).
	# ============================================================================
	var drip_count: int = rng.randi_range(3, 6)
	for di in range(drip_count):
		var dx: float = rng.randf_range(-w * 0.40, w * 0.40)
		var dz: float = rng.randf_range(-d * 0.20, d * 0.25)
		var dy_top: float = lerpf(chest_y, shoulder_y, rng.randf())
		var drip_len: float = h * rng.randf_range(0.04, 0.10)
		_build_tapered_segment(root,
			Vector3(dx, dy_top, dz), w * 0.020,
			Vector3(dx, dy_top - drip_len, dz), w * 0.008,
			slime_color, 0.10, 0.0)


# ============================================================================
# BALOR (balor)
# Demon lord — towering winged warrior wreathed in fire (the D&D Balrog).
#   - HUGE silhouette (Large/Huge size class)
#   - Bull-like / minotaur HORNED HEAD
#   - Massive leathery BAT WINGS spread behind
#   - FLAMING WHIP in one hand (signature weapon #1)
#   - FLAMING LONGSWORD in the other (signature weapon #2)
#   - Body constantly wreathed in flames (flickering aura)
#   - Red/black demonic skin
#   - Long tail
#   - Goat-like cloven-hoofed legs
# ============================================================================

static func _build_balor(plan: Dictionary, root: Node3D) -> void:
	var base: Dictionary = plan.get("base", {})
	var palette: Dictionary = plan.get("palette", {})
	var limbs: Dictionary = plan.get("limbs", {})
	var meta: Dictionary = plan.get("meta", {})
	var species: String = String(meta.get("species", "Balor"))

	# HUGE demon lord — ~12 ft / 4m tall, built like a heavyweight wrestler
	# with wings. Verify-agent fix: previously too slender (3.40 × 1.10).
	var w: float = _axis(base, "width", 1.45)
	var h: float = _axis(base, "height", 4.00)
	var d: float = _axis(base, "depth", 1.00)
	var leg_length: float = float(limbs.get("leg_length", 1.80))
	var clearance: float = leg_length

	var render_seed: int = int(meta.get("render_seed", 0))
	var rng := RandomNumberGenerator.new()
	rng.seed = render_seed if render_seed != 0 else hash(species)

	# Per-individual variation
	var size_jitter: float = rng.randf_range(0.92, 1.10)
	var horn_size_jitter: float = rng.randf_range(0.85, 1.30)
	var wing_size_jitter: float = rng.randf_range(0.90, 1.20)
	w *= size_jitter
	h *= size_jitter
	d *= size_jitter
	leg_length *= rng.randf_range(0.92, 1.10)
	clearance = leg_length

	# Skin palette — canon balor is RED-BLACK, charred. Lock to canonical hues.
	var skin_options := [
		Color(0.32, 0.05, 0.04),     # dark blood-red
		Color(0.42, 0.08, 0.04),     # ember red
		Color(0.22, 0.04, 0.03),     # charred near-black-red
		Color(0.38, 0.10, 0.06),     # demon crimson
	]
	var primary: Color = skin_options[rng.randi() % skin_options.size()]
	var skin_dark: Color = primary.darkened(0.45)
	var bone_color := Color(0.78, 0.72, 0.60)
	var horn_color := Color(0.18, 0.10, 0.08)         # dark blood-stained horns
	var hoof_color := Color(0.10, 0.08, 0.06)
	# Flame palette — bright emissive
	var flame_core := Color(1.0, 0.92, 0.50)
	var flame_mid := Color(1.0, 0.55, 0.10)
	var flame_outer := Color(0.90, 0.20, 0.05)
	# Eye glow
	var eye_glow := Color(1.0, 0.85, 0.20)

	# ============================================================================
	# TORSO — massive, broad-shouldered, BULKY (not narrow-waisted).
	# Verify-agent fix: softer waist taper, heavyweight-wrestler build.
	# ============================================================================
	var hip_y: float = clearance
	var waist_y: float = clearance + h * 0.15
	var chest_y: float = clearance + h * 0.32
	var shoulder_y: float = clearance + h * 0.48
	# Lower torso (waist) — wider than before
	_build_box(
		root,
		Vector3(-w * 0.42, hip_y, -d * 0.32),
		Vector3(w * 0.42, waist_y, d * 0.32),
		primary, 0.40
	)
	# Mid abs — only slightly narrower than chest
	_build_box(
		root,
		Vector3(-w * 0.46, waist_y, -d * 0.34),
		Vector3(w * 0.46, chest_y, d * 0.36),
		primary, 0.40
	)
	# Massive chest (pectorals broad)
	_build_box(
		root,
		Vector3(-w * 0.58, chest_y, -d * 0.38),
		Vector3(w * 0.58, shoulder_y, d * 0.42),
		primary, 0.40
	)
	# Pectoral split — small darker groove down center of chest
	_build_box(
		root,
		Vector3(-w * 0.015, chest_y, d * 0.38),
		Vector3(w * 0.015, shoulder_y, d * 0.41),
		skin_dark, 0.50
	)

	# Abdominal ridges — 3 horizontal lines
	for ai in range(3):
		var ay: float = lerpf(waist_y + h * 0.02, chest_y - h * 0.01, float(ai) / 2.0)
		_build_box(
			root,
			Vector3(-w * 0.38, ay - h * 0.006, d * 0.34),
			Vector3(w * 0.38, ay + h * 0.006, d * 0.36),
			skin_dark, 0.45
		)

	# ============================================================================
	# HEAD — bull/minotaur skull, prominent muzzle
	# ============================================================================
	# Thick neck (short)
	var neck_top := Vector3(0, shoulder_y + h * 0.03, d * 0.08)
	_build_tapered_segment(root,
		Vector3(0, shoulder_y - h * 0.01, 0.0), w * 0.20,
		neck_top, w * 0.18,
		primary, 0.40)

	var head_w: float = w * 0.40
	var head_h: float = h * 0.16
	var head_d: float = d * 0.85
	var head_y_bot: float = neck_top.y
	var head_y_top: float = head_y_bot + head_h
	var head_center_y: float = (head_y_bot + head_y_top) * 0.5
	# Skull
	_build_box(
		root,
		Vector3(-head_w, head_y_bot, neck_top.z - head_d * 0.30),
		Vector3(head_w, head_y_top, neck_top.z + head_d * 0.30),
		primary, 0.40
	)
	# Muzzle / snout — protruding bull-like, narrower than skull
	var muzzle_back_z: float = neck_top.z + head_d * 0.30
	var muzzle_tip_z: float = neck_top.z + head_d * 0.70
	_build_box(
		root,
		Vector3(-head_w * 0.65, head_y_bot + h * 0.005, muzzle_back_z - d * 0.02),
		Vector3(head_w * 0.65, head_y_top - h * 0.025, muzzle_tip_z),
		primary, 0.40
	)
	# Heavy brow ridge
	_build_box(
		root,
		Vector3(-head_w * 1.04, head_center_y + h * 0.025, neck_top.z + head_d * 0.10),
		Vector3(head_w * 1.04, head_center_y + h * 0.06, neck_top.z + head_d * 0.30),
		skin_dark, 0.45
	)

	# GLOWING YELLOW EYES — fierce demon-bull eyes
	for side in [-1, 1]:
		_build_box(
			root,
			Vector3(side * head_w * 0.55 - w * 0.05,
				head_center_y - h * 0.005, neck_top.z + head_d * 0.25),
			Vector3(side * head_w * 0.55 + w * 0.05,
				head_center_y + h * 0.030, neck_top.z + head_d * 0.32),
			eye_glow, 0.10, 0.0
		)
		# Inner pupil dot
		_build_box(
			root,
			Vector3(side * head_w * 0.55 - w * 0.020,
				head_center_y + h * 0.005, neck_top.z + head_d * 0.30),
			Vector3(side * head_w * 0.55 + w * 0.020,
				head_center_y + h * 0.025, neck_top.z + head_d * 0.33),
			Color(0.05, 0.02, 0.0), 0.30
		)

	# JAW — fanged maw
	var jaw_y_top: float = head_y_bot - h * 0.005
	var jaw_y_bot: float = jaw_y_top - h * 0.06
	_build_box(
		root,
		Vector3(-head_w * 0.60, jaw_y_bot, muzzle_back_z + d * 0.02),
		Vector3(head_w * 0.60, jaw_y_top, muzzle_tip_z - d * 0.02),
		skin_dark, 0.45
	)
	# Inner mouth
	_build_box(
		root,
		Vector3(-head_w * 0.50, jaw_y_bot + h * 0.005, muzzle_back_z + d * 0.05),
		Vector3(head_w * 0.50, jaw_y_top - h * 0.005, muzzle_tip_z - d * 0.05),
		Color(0.05, 0.02, 0.02), 0.85
	)
	# Upper canines — 2 prominent
	for side in [-1, 1]:
		var fcx: float = side * head_w * 0.50
		_build_tapered_segment(root,
			Vector3(fcx, jaw_y_top, muzzle_back_z + d * 0.15), w * 0.025,
			Vector3(fcx, jaw_y_top - h * 0.05, muzzle_back_z + d * 0.20), w * 0.005,
			bone_color, 0.45)

	# Nose ridge
	_build_box(
		root,
		Vector3(-w * 0.05, head_center_y + h * 0.005, muzzle_tip_z - d * 0.08),
		Vector3(w * 0.05, head_center_y + h * 0.04, muzzle_tip_z),
		skin_dark, 0.45
	)

	# HUGE BULL HORNS — sweep UP and BACKWARD (water-buffalo / classic devil).
	# Verify-agent fix: previously forward-curling, which read as minotaur.
	for side in [-1, 1]:
		var horn_base := Vector3(side * head_w * 0.85,
			head_y_top - h * 0.01,
			neck_top.z + head_d * 0.05)
		var horn_mid := Vector3(side * head_w * 1.35,
			head_y_top + h * (0.18 * horn_size_jitter),
			neck_top.z - head_d * 0.10)
		var horn_tip := Vector3(side * head_w * 1.10,
			head_y_top + h * (0.30 * horn_size_jitter),
			neck_top.z - head_d * 0.45)
		_build_tapered_segment(root, horn_base, w * 0.10, horn_mid, w * 0.06,
			horn_color, 0.55)
		_build_tapered_segment(root, horn_mid, w * 0.06, horn_tip, w * 0.015,
			horn_color.darkened(0.20), 0.55)

	# ============================================================================
	# BAT WINGS — huge leathery wings spread BEHIND the body
	# Built as wedge: shoulder + 3 finger-bone struts to a trailing edge.
	# ============================================================================
	for side in [-1, 1]:
		var wing_root := Vector3(side * w * 0.55, shoulder_y + h * 0.05, -d * 0.20)
		var wing_span: float = w * 2.40 * wing_size_jitter
		var wing_height: float = h * 0.85 * wing_size_jitter
		var wing_shoulder := Vector3(side * (w * 0.65 + wing_span * 0.10),
			shoulder_y + h * 0.20, -d * 0.30)
		var wing_elbow := Vector3(side * (w * 0.65 + wing_span * 0.50),
			shoulder_y + h * 0.30, -d * 0.45)
		var wing_tip := Vector3(side * (w * 0.65 + wing_span * 1.00),
			shoulder_y + h * 0.10, -d * 0.60)
		# Main wing arm (humerus → forearm bone)
		_build_tapered_segment(root, wing_root, w * 0.10, wing_shoulder, w * 0.08,
			skin_dark, 0.55)
		_build_tapered_segment(root, wing_shoulder, w * 0.08, wing_elbow, w * 0.06,
			skin_dark, 0.55)
		_build_tapered_segment(root, wing_elbow, w * 0.06, wing_tip, w * 0.020,
			skin_dark, 0.55)
		# Finger struts radiating to trailing edge — 4 fingers
		var finger_count := 4
		for fi in range(finger_count):
			var ft: float = float(fi) / float(finger_count - 1)
			# Finger root along the wing arm; tip on the trailing edge below
			var f_root := wing_elbow.lerp(wing_tip, lerpf(0.0, 0.95, ft))
			var f_tip := Vector3(
				side * (w * 0.60 + wing_span * lerpf(0.30, 0.95, ft)),
				shoulder_y - wing_height * lerpf(0.35, 0.20, ft),
				-d * lerpf(0.30, 0.55, ft)
			)
			_build_tapered_segment(root, f_root, w * 0.025, f_tip, w * 0.010,
				skin_dark, 0.55)
		# Wing membrane — built as a thin wedge between the finger struts
		# (3 panels) using SurfaceTool for proper triangulation.
		var membrane_verts: Array = [
			wing_root,
			wing_shoulder,
			wing_elbow,
			wing_tip,
			# Trailing edge points (matching the 4 finger tips above)
			Vector3(side * (w * 0.60 + wing_span * 0.30),
				shoulder_y - wing_height * 0.35, -d * 0.30),
			Vector3(side * (w * 0.60 + wing_span * 0.52),
				shoulder_y - wing_height * 0.30, -d * 0.38),
			Vector3(side * (w * 0.60 + wing_span * 0.73),
				shoulder_y - wing_height * 0.25, -d * 0.47),
			Vector3(side * (w * 0.60 + wing_span * 0.95),
				shoulder_y - wing_height * 0.20, -d * 0.55),
		]
		var st_wing := SurfaceTool.new()
		st_wing.begin(Mesh.PRIMITIVE_TRIANGLES)
		# Inner panel (root → elbow → trailing[0] → trailing-edge midpoint)
		_add_quad(st_wing, membrane_verts[0], membrane_verts[2],
			membrane_verts[5], membrane_verts[4])
		_add_quad(st_wing, membrane_verts[2], membrane_verts[3],
			membrane_verts[7], membrane_verts[6])
		# Middle panel between
		_add_tri(st_wing, membrane_verts[2], membrane_verts[6], membrane_verts[5])
		_add_tri(st_wing, membrane_verts[5], membrane_verts[4], membrane_verts[0])
		st_wing.generate_normals()
		var mi_wing := MeshInstance3D.new()
		mi_wing.mesh = st_wing.commit()
		var mat_wing := StandardMaterial3D.new()
		mat_wing.albedo_color = skin_dark.darkened(0.10)
		mat_wing.roughness = 0.60
		mat_wing.cull_mode = BaseMaterial3D.CULL_DISABLED
		mi_wing.material_override = mat_wing
		root.add_child(mi_wing)

	# ============================================================================
	# ARMS — massive, holding flaming sword (right) and flaming whip (left)
	# ============================================================================
	# Right arm — flaming longsword, raised
	var r_shoulder := Vector3(w * 0.55, shoulder_y - h * 0.03, 0.0)
	var r_elbow := Vector3(w * 0.75, shoulder_y - h * 0.05, d * 0.10)
	var r_wrist := Vector3(w * 0.85, shoulder_y + h * 0.05, d * 0.30)
	_build_tapered_segment(root, r_shoulder, w * 0.18, r_elbow, w * 0.14,
		primary, 0.40)
	_build_tapered_segment(root, r_elbow, w * 0.14, r_wrist, w * 0.12,
		primary, 0.40)
	# Right hand
	_build_box(
		root,
		Vector3(r_wrist.x - w * 0.10, r_wrist.y - h * 0.05, r_wrist.z - d * 0.06),
		Vector3(r_wrist.x + w * 0.10, r_wrist.y + h * 0.02, r_wrist.z + d * 0.08),
		primary.darkened(0.10), 0.40
	)

	# FLAMING LONGSWORD — held vertically from right hand
	var sword_hilt := Vector3(r_wrist.x, r_wrist.y + h * 0.02, r_wrist.z + d * 0.05)
	var sword_guard_y: float = sword_hilt.y + h * 0.04
	var sword_tip_y: float = sword_hilt.y + h * 0.85
	# Pommel
	_build_box(
		root,
		Vector3(sword_hilt.x - w * 0.04, sword_hilt.y - h * 0.05,
			sword_hilt.z - d * 0.04),
		Vector3(sword_hilt.x + w * 0.04, sword_hilt.y - h * 0.01,
			sword_hilt.z + d * 0.04),
		Color(0.30, 0.25, 0.20), 0.40
	)
	# Grip
	_build_box(
		root,
		Vector3(sword_hilt.x - w * 0.025, sword_hilt.y - h * 0.005,
			sword_hilt.z - d * 0.025),
		Vector3(sword_hilt.x + w * 0.025, sword_guard_y - h * 0.005,
			sword_hilt.z + d * 0.025),
		Color(0.15, 0.10, 0.08), 0.85
	)
	# Crossguard
	_build_box(
		root,
		Vector3(sword_hilt.x - w * 0.18, sword_guard_y,
			sword_hilt.z - d * 0.04),
		Vector3(sword_hilt.x + w * 0.18, sword_guard_y + h * 0.025,
			sword_hilt.z + d * 0.05),
		Color(0.55, 0.45, 0.30), 0.40, 0.50
	)
	# Steel blade (will be wreathed in fire)
	_build_tapered_segment(root,
		Vector3(sword_hilt.x, sword_guard_y + h * 0.02, sword_hilt.z), w * 0.045,
		Vector3(sword_hilt.x, sword_tip_y, sword_hilt.z), w * 0.010,
		Color(0.75, 0.72, 0.70), 0.20, 0.85)
	# Sword flames — wreath the blade in fire (3 stacked layers)
	_build_tapered_segment(root,
		Vector3(sword_hilt.x, sword_guard_y, sword_hilt.z), w * 0.13,
		Vector3(sword_hilt.x, sword_tip_y + h * 0.05, sword_hilt.z), w * 0.02,
		flame_outer, 0.05, 0.0)
	_build_tapered_segment(root,
		Vector3(sword_hilt.x, sword_guard_y + h * 0.02, sword_hilt.z), w * 0.08,
		Vector3(sword_hilt.x, sword_tip_y - h * 0.04, sword_hilt.z), w * 0.015,
		flame_mid, 0.05, 0.0)
	_build_tapered_segment(root,
		Vector3(sword_hilt.x, sword_guard_y + h * 0.04, sword_hilt.z), w * 0.045,
		Vector3(sword_hilt.x, sword_tip_y - h * 0.08, sword_hilt.z), w * 0.010,
		flame_core, 0.05, 0.0)

	# Left arm — wielding flaming whip, hanging forward + down
	var l_shoulder := Vector3(-w * 0.55, shoulder_y - h * 0.03, 0.0)
	var l_elbow := Vector3(-w * 0.65, shoulder_y - h * 0.20, d * 0.15)
	var l_wrist := Vector3(-w * 0.55, shoulder_y - h * 0.40, d * 0.30)
	_build_tapered_segment(root, l_shoulder, w * 0.18, l_elbow, w * 0.14,
		primary, 0.40)
	_build_tapered_segment(root, l_elbow, w * 0.14, l_wrist, w * 0.12,
		primary, 0.40)
	# Left hand
	_build_box(
		root,
		Vector3(l_wrist.x - w * 0.10, l_wrist.y - h * 0.05, l_wrist.z - d * 0.06),
		Vector3(l_wrist.x + w * 0.10, l_wrist.y + h * 0.02, l_wrist.z + d * 0.08),
		primary.darkened(0.10), 0.40
	)

	# FLAMING WHIP — sweeps out and down from the left hand, multi-segment curve
	var whip_handle_top := Vector3(l_wrist.x, l_wrist.y + h * 0.02, l_wrist.z + d * 0.05)
	# Handle
	_build_box(
		root,
		Vector3(whip_handle_top.x - w * 0.025, whip_handle_top.y - h * 0.06,
			whip_handle_top.z - d * 0.025),
		Vector3(whip_handle_top.x + w * 0.025, whip_handle_top.y + h * 0.02,
			whip_handle_top.z + d * 0.025),
		Color(0.15, 0.10, 0.08), 0.85
	)
	# Whip lash — 7 segments curving outward forward, getting thinner
	var whip_segments: int = 8
	var whip_points: Array = []
	for wi in range(whip_segments + 1):
		var t: float = float(wi) / float(whip_segments)
		# Curving forward + out + drooping
		var px: float = whip_handle_top.x - w * 0.5 * t
		var py: float = whip_handle_top.y + h * (0.05 - 0.45 * t * t)
		var pz: float = whip_handle_top.z + d * (0.30 + 1.20 * t)
		whip_points.append(Vector3(px, py, pz))
	# Build whip as tapered segments with flame layers
	for wi in range(whip_segments):
		var t0: float = float(wi) / float(whip_segments)
		var t1: float = float(wi + 1) / float(whip_segments)
		var r0: float = lerpf(w * 0.040, w * 0.005, t0)
		var r1: float = lerpf(w * 0.040, w * 0.005, t1)
		# Outer flame layer
		_build_tapered_segment(root, whip_points[wi], r0 * 2.5,
			whip_points[wi + 1], r1 * 2.5,
			flame_outer, 0.05, 0.0)
		# Inner core
		_build_tapered_segment(root, whip_points[wi], r0 * 1.2,
			whip_points[wi + 1], r1 * 1.2,
			flame_mid, 0.05, 0.0)
		# Core whip cord
		_build_tapered_segment(root, whip_points[wi], r0,
			whip_points[wi + 1], r1,
			flame_core, 0.05, 0.0)

	# ============================================================================
	# LEGS — goat-like digitigrade, ending in CLOVEN HOOVES
	# ============================================================================
	for side in [-1, 1]:
		var hip := Vector3(side * w * 0.22, hip_y + h * 0.03, 0.0)
		var knee := Vector3(side * w * 0.27, clearance * 0.60, d * 0.08)
		var ankle := Vector3(side * w * 0.22, clearance * 0.20, -d * 0.06)
		var hoof_top := Vector3(side * w * 0.20, h * 0.06, d * 0.02)
		# Thigh (thick)
		_build_tapered_segment(root, hip, w * 0.22, knee, w * 0.16, primary, 0.40)
		# Shin (lean, goat-like)
		_build_tapered_segment(root, knee, w * 0.15, ankle, w * 0.12, primary, 0.40)
		# Lower leg → hoof transition (dark fur shading)
		_build_tapered_segment(root, ankle, w * 0.12, hoof_top, w * 0.13,
			skin_dark, 0.50)
		# CLOVEN HOOF — two prongs, dark
		for prong in [-1, 1]:
			_build_box(
				root,
				Vector3(side * w * 0.20 + prong * w * 0.06 - w * 0.045,
					0.0, -d * 0.05),
				Vector3(side * w * 0.20 + prong * w * 0.06 + w * 0.045,
					h * 0.06, d * 0.18),
				hoof_color, 0.35, 0.20
			)

	# ============================================================================
	# TAIL — long, thick at base tapering to barbed tip
	# ============================================================================
	# Thick muscular tail — radius held wide until the final segment.
	# Verify-agent fix: thin tapering rat-tail read as imp/devil.
	var tail_base := Vector3(0, hip_y + h * 0.06, -d * 0.28)
	var tail_mid := Vector3(rng.randf_range(-w * 0.12, w * 0.12),
		hip_y - h * 0.04, -d * 0.70)
	var tail_tip := Vector3(rng.randf_range(-w * 0.18, w * 0.18),
		h * 0.10, -d * 1.05)
	_build_tapered_segment(root, tail_base, w * 0.18, tail_mid, w * 0.15, primary, 0.40)
	_build_tapered_segment(root, tail_mid, w * 0.15, tail_tip, w * 0.080, skin_dark, 0.45)

	# ============================================================================
	# BODY FLAME AURA — vertical flame tongues licking up the body, around hips,
	# shoulders, and head. Signature balor "wreathed in fire" feature.
	# ============================================================================
	var aura_count: int = rng.randi_range(8, 14)
	for ai in range(aura_count):
		var ang: float = rng.randf_range(0.0, TAU)
		var ay_base: float = lerpf(hip_y, shoulder_y + h * 0.05, rng.randf())
		var ar: float = max(w * 0.35, w * 0.45 * lerpf(0.6, 1.0, (ay_base - hip_y) / max(0.001, shoulder_y - hip_y)))
		var ax: float = cos(ang) * ar
		var az: float = sin(ang) * ar * 0.7
		var alick: float = h * rng.randf_range(0.12, 0.30)
		var fcol: Color = [flame_outer, flame_mid, flame_outer][ai % 3]
		_build_tapered_segment(root,
			Vector3(ax, ay_base, az), w * 0.06,
			Vector3(ax + ax * 0.05, ay_base + alick, az + az * 0.05), w * 0.008,
			fcol, 0.05, 0.0)
	# Shoulder flames — extra emphasis at the trapezius
	for side in [-1, 1]:
		var sx: float = side * w * 0.45
		_build_tapered_segment(root,
			Vector3(sx, shoulder_y, -d * 0.10), w * 0.12,
			Vector3(sx + side * w * 0.05, shoulder_y + h * 0.30, -d * 0.20), w * 0.015,
			flame_outer, 0.05, 0.0)
		_build_tapered_segment(root,
			Vector3(sx, shoulder_y + h * 0.02, -d * 0.05), w * 0.07,
			Vector3(sx + side * w * 0.03, shoulder_y + h * 0.22, -d * 0.15), w * 0.010,
			flame_mid, 0.05, 0.0)
	# Head-crown flames between the horns
	_build_tapered_segment(root,
		Vector3(0, head_y_top, neck_top.z), head_w * 0.40,
		Vector3(0, head_y_top + h * 0.20, neck_top.z - head_d * 0.10), head_w * 0.10,
		flame_outer, 0.05, 0.0)
	_build_tapered_segment(root,
		Vector3(0, head_y_top + h * 0.02, neck_top.z), head_w * 0.22,
		Vector3(0, head_y_top + h * 0.16, neck_top.z - head_d * 0.05), head_w * 0.06,
		flame_mid, 0.05, 0.0)


# ============================================================================
# BANSHEE (banshee)
# Wailing undead female elf-spirit — bound to the place of her death.
#   - Floating, no feet visible (dress dissolves into mist)
#   - Gaunt elven SKULL-FACE with sunken eyes, screaming open mouth
#   - Long flowing TENDRIL HAIR (acts like floating tentacles)
#   - Tattered translucent gown with ragged hem
#   - Ghostly pale-green/grey-white tint (emissive)
#   - Bony skeletal arms ending in clawed fingers
# ============================================================================

static func _build_banshee(plan: Dictionary, root: Node3D) -> void:
	var base: Dictionary = plan.get("base", {})
	var palette: Dictionary = plan.get("palette", {})
	var limbs: Dictionary = plan.get("limbs", {})
	var meta: Dictionary = plan.get("meta", {})
	var species: String = String(meta.get("species", "Banshee"))

	# Tall slender female-elf proportions; FLOATING — no ground clearance.
	var w: float = _axis(base, "width", 0.50)
	var h: float = _axis(base, "height", 1.75)
	var d: float = _axis(base, "depth", 0.32)
	# Floats off the ground — bottom of dress sits at ~0.15
	var float_offset: float = 0.20

	var render_seed: int = int(meta.get("render_seed", 0))
	var rng := RandomNumberGenerator.new()
	rng.seed = render_seed if render_seed != 0 else hash(species)

	# Per-individual variation
	var size_jitter: float = rng.randf_range(0.92, 1.10)
	var hair_count_jitter: int = rng.randi_range(5, 9)
	var dress_tear_jitter: int = rng.randi_range(4, 7)
	w *= size_jitter
	h *= size_jitter
	d *= size_jitter

	# Ghostly palette — pale green-mint dominates (~50% per verify-agent
	# canonical weighting). Remaining hues are minority spectral variants.
	var hue_roll: float = rng.randf()
	var primary: Color
	if hue_roll < 0.50:
		primary = Color(0.75, 0.92, 0.85)        # pale green-mint (canon)
	elif hue_roll < 0.70:
		primary = Color(0.65, 0.80, 0.78)        # spectral aqua
	elif hue_roll < 0.85:
		primary = Color(0.78, 0.85, 0.80)        # death's pallor (grey-green)
	elif hue_roll < 0.95:
		primary = Color(0.80, 0.90, 0.95)        # ice white
	else:
		primary = Color(0.62, 0.72, 0.85)        # corpse blue (rare)
	var dress_color: Color = primary.darkened(0.20)
	var skin_pale := primary.lightened(0.15)
	var hair_color: Color = primary.darkened(0.10)
	var eye_glow := Color(0.10, 0.10, 0.18)         # hollow dark sockets
	var mouth_dark := Color(0.05, 0.05, 0.10)
	var bone_color := Color(0.92, 0.94, 0.88)

	# ============================================================================
	# DRESS BODY — tapered from waist down, dissolving into mist at the bottom.
	# Built as a swept_body so it has the flowing skirt shape.
	# ============================================================================
	var waist_y: float = float_offset + h * 0.55
	var chest_y: float = float_offset + h * 0.75
	var shoulder_y: float = float_offset + h * 0.90
	# Dress: shroud-like drape, NOT a corseted hourglass. Verify-agent fix:
	# waist is only ~0.92× of bust — banshees billow loose, not tailored.
	var sections: Array = [
		{"center": Vector3(0, float_offset, 0), "w": w * 0.30, "h": w * 0.32},      # misty bottom
		{"center": Vector3(0, float_offset + h * 0.15, 0), "w": w * 0.62, "h": w * 0.56},
		{"center": Vector3(0, float_offset + h * 0.35, 0), "w": w * 0.55, "h": w * 0.50},
		{"center": Vector3(0, waist_y, 0), "w": w * 0.45, "h": w * 0.42},          # near-bust width
		{"center": Vector3(0, chest_y, 0), "w": w * 0.49, "h": w * 0.42},          # bust (only 1.09× waist)
		{"center": Vector3(0, shoulder_y, 0), "w": w * 0.50, "h": w * 0.34},
	]
	_swept_body(root, sections, 10, dress_color, dress_color.darkened(0.10), 0.40, false)

	# RAGGED HEM TEARS — 4-7 jagged vertical tears around the bottom
	for ti in range(dress_tear_jitter):
		var ang: float = float(ti) / float(dress_tear_jitter) * TAU + rng.randf_range(-0.1, 0.1)
		var tx: float = cos(ang) * w * 0.50
		var tz: float = sin(ang) * w * 0.42
		var tear_top: float = float_offset + h * rng.randf_range(0.10, 0.22)
		var tear_bot: float = float_offset + rng.randf_range(0.0, h * 0.06)
		# Two thin "tear strips" hanging down
		for prong in [-0.4, 0.4]:
			var tip_x: float = tx + cos(ang + prong) * w * 0.05
			var tip_z: float = tz + sin(ang + prong) * w * 0.05
			_build_tapered_segment(root,
				Vector3(tx, tear_top, tz), w * 0.02,
				Vector3(tip_x, tear_bot, tip_z), w * 0.003,
				dress_color.darkened(0.20), 0.50)

	# MIST TENDRILS at the bottom (dress dissolves into vapor)
	var mist_count: int = rng.randi_range(5, 8)
	for mi in range(mist_count):
		var ang: float = rng.randf_range(0.0, TAU)
		var mr: float = w * rng.randf_range(0.15, 0.45)
		var mx: float = cos(ang) * mr
		var mz: float = sin(ang) * mr
		var mist_top: float = float_offset + h * rng.randf_range(0.05, 0.15)
		_build_tapered_segment(root,
			Vector3(mx * 0.5, mist_top, mz * 0.5), w * 0.08,
			Vector3(mx, 0.0, mz), w * 0.015,
			primary.lightened(0.10), 0.10, 0.0)

	# ============================================================================
	# HEAD — gaunt elven skull-face on a thin neck
	# ============================================================================
	var neck_top := Vector3(0, shoulder_y + h * 0.04, d * 0.05)
	_build_tapered_segment(root,
		Vector3(0, shoulder_y - h * 0.01, 0.0), w * 0.10,
		neck_top, w * 0.08,
		skin_pale, 0.50)

	var head_w: float = w * 0.26
	var head_h: float = h * 0.16
	var head_d: float = d * 0.62
	var head_y_bot: float = neck_top.y
	var head_y_top: float = head_y_bot + head_h
	var head_center_y: float = (head_y_bot + head_y_top) * 0.5
	# Skull (narrow, gaunt)
	_build_box(
		root,
		Vector3(-head_w, head_y_bot, neck_top.z - head_d * 0.30),
		Vector3(head_w, head_y_top, neck_top.z + head_d * 0.30),
		skin_pale, 0.50
	)
	# Sunken cheek hollows — darker patches on the sides
	for side in [-1, 1]:
		_build_box(
			root,
			Vector3(side * head_w * 0.55, head_center_y - h * 0.04,
				neck_top.z + head_d * 0.15),
			Vector3(side * head_w * 1.02, head_center_y + h * 0.01,
				neck_top.z + head_d * 0.30),
			primary.darkened(0.30), 0.55
		)
	# POINTED ELVEN EARS — protruding sideways and slightly back
	for side in [-1, 1]:
		_build_tapered_segment(root,
			Vector3(side * head_w * 0.95, head_center_y + h * 0.02,
				neck_top.z + head_d * 0.05), w * 0.06,
			Vector3(side * head_w * 1.45, head_center_y + h * 0.06,
				neck_top.z - head_d * 0.05), w * 0.008,
			skin_pale, 0.55)

	# SUNKEN HOLLOW EYE SOCKETS — large dark voids
	for side in [-1, 1]:
		_build_box(
			root,
			Vector3(side * head_w * 0.55 - w * 0.06,
				head_center_y - h * 0.01, neck_top.z + head_d * 0.20),
			Vector3(side * head_w * 0.55 + w * 0.06,
				head_center_y + h * 0.04, neck_top.z + head_d * 0.32),
			Color(0.04, 0.04, 0.08), 0.85
		)
		# Faint pinprick of cold light deep in the socket
		_build_box(
			root,
			Vector3(side * head_w * 0.55 - w * 0.015,
				head_center_y + h * 0.005, neck_top.z + head_d * 0.30),
			Vector3(side * head_w * 0.55 + w * 0.015,
				head_center_y + h * 0.020, neck_top.z + head_d * 0.32),
			eye_glow.lerp(Color(0.6, 0.9, 1.0), 0.7), 0.05, 0.0
		)

	# SCREAMING OPEN MOUTH — wide ovular dark void
	var mouth_y_top: float = head_y_bot + h * 0.05
	var mouth_y_bot: float = head_y_bot - h * 0.02
	_build_box(
		root,
		Vector3(-head_w * 0.45, mouth_y_bot, neck_top.z + head_d * 0.22),
		Vector3(head_w * 0.45, mouth_y_top, neck_top.z + head_d * 0.32),
		mouth_dark, 0.95
	)
	# Lower jaw drop (gaunt)
	_build_box(
		root,
		Vector3(-head_w * 0.85, mouth_y_bot - h * 0.025, neck_top.z + head_d * 0.05),
		Vector3(head_w * 0.85, mouth_y_bot, neck_top.z + head_d * 0.30),
		skin_pale, 0.50
	)

	# ============================================================================
	# FLOWING TENDRIL HAIR — long wispy strands radiating from the skull,
	# flowing backward and outward as if caught in a constant wind.
	# ============================================================================
	for hi in range(hair_count_jitter):
		var ang: float = (float(hi) / float(hair_count_jitter)) * TAU
		# Root on the top/back of the skull
		var hx_root: float = cos(ang) * head_w * 0.85
		var hz_root: float = sin(ang) * head_d * 0.30 - head_d * 0.10
		var root_pos := Vector3(hx_root, head_y_top - h * 0.015, neck_top.z + hz_root)
		# Hair flows outward + down + back; length varies
		var hair_len: float = h * rng.randf_range(0.40, 0.80)
		var mid_pos := Vector3(hx_root * 1.5,
			head_y_top - h * (0.1 + rng.randf_range(0.0, 0.10)),
			neck_top.z + hz_root - head_d * 0.20)
		var tip_pos := Vector3(hx_root * 1.8,
			head_y_top - hair_len,
			neck_top.z + hz_root - head_d * 0.40 - rng.randf_range(0.0, 0.2))
		_build_tapered_segment(root, root_pos, w * 0.030, mid_pos, w * 0.018,
			hair_color, 0.50)
		_build_tapered_segment(root, mid_pos, w * 0.018, tip_pos, w * 0.004,
			hair_color.darkened(0.10), 0.55)

	# Front fringe — 2-3 strands draped over the forehead
	var fringe_count: int = rng.randi_range(2, 3)
	for fi in range(fringe_count):
		var ft: float = (float(fi) - (fringe_count - 1) * 0.5) / float(fringe_count)
		var froot := Vector3(ft * head_w * 0.6,
			head_y_top - h * 0.01,
			neck_top.z + head_d * 0.20)
		var ftip := Vector3(ft * head_w * 0.4,
			head_center_y + h * 0.02,
			neck_top.z + head_d * 0.34)
		_build_tapered_segment(root, froot, w * 0.025, ftip, w * 0.006,
			hair_color, 0.50)

	# ============================================================================
	# SKELETAL ARMS — KEENING POSE: spread wide and slightly UP/BACK, like a
	# soprano hitting a high note. Verify-agent fix: forward reach read as
	# ghoul/wight; canon banshee art shows arms spread outward in the wail.
	# ============================================================================
	for side in [-1, 1]:
		var shoulder := Vector3(side * w * 0.42, shoulder_y - h * 0.02, 0.0)
		# Elbow up and out, behind torso plane
		var elbow := Vector3(side * w * 0.85, shoulder_y + h * 0.04, -d * 0.10)
		# Wrist further out, hand raised
		var wrist := Vector3(side * w * 1.10, shoulder_y + h * 0.18, -d * 0.20)
		# Thin bony upper arm
		_build_tapered_segment(root, shoulder, w * 0.07, elbow, w * 0.055,
			skin_pale, 0.55)
		# Thin bony forearm
		_build_tapered_segment(root, elbow, w * 0.055, wrist, w * 0.045,
			skin_pale, 0.55)
		# Hand palm — facing outward
		_build_box(
			root,
			Vector3(wrist.x - w * 0.05, wrist.y - h * 0.02, wrist.z - d * 0.06),
			Vector3(wrist.x + w * 0.05, wrist.y + h * 0.05, wrist.z + d * 0.04),
			skin_pale, 0.55
		)
		# 4 LONG clawed fingers — splayed outward and up from the hand
		for fi in range(4):
			var ft: float = (float(fi) - 1.5) / 2.0
			# Fingers fan out along Y (vertical spread on the raised hand)
			var f_root := Vector3(wrist.x + side * w * 0.03,
				wrist.y + h * 0.03 + ft * h * 0.015,
				wrist.z - d * 0.02 + ft * d * 0.02)
			var f_tip := Vector3(wrist.x + side * w * 0.12,
				wrist.y + h * 0.12 + ft * h * 0.025,
				wrist.z - d * 0.05 + ft * d * 0.04)
			_build_tapered_segment(root, f_root, w * 0.012, f_tip, w * 0.003,
				bone_color, 0.45)
		# Thumb — extended on the underside of the raised hand
		var thumb_tip := Vector3(wrist.x + side * w * 0.04,
			wrist.y - h * 0.04, wrist.z + d * 0.08)
		_build_tapered_segment(root,
			Vector3(wrist.x + side * w * 0.02, wrist.y, wrist.z + d * 0.02),
			w * 0.013,
			thumb_tip, w * 0.003,
			bone_color, 0.45)

	# ============================================================================
	# WISPY GHOST AURA — faint streaks around the figure
	# ============================================================================
	var aura_count: int = rng.randi_range(4, 7)
	for ai in range(aura_count):
		var ang: float = rng.randf_range(0.0, TAU)
		var ay_base: float = lerpf(float_offset + h * 0.2, shoulder_y, rng.randf())
		var ar: float = w * rng.randf_range(0.50, 0.75)
		var ax: float = cos(ang) * ar
		var az: float = sin(ang) * ar * 0.7
		var alick: float = h * rng.randf_range(0.10, 0.22)
		_build_tapered_segment(root,
			Vector3(ax, ay_base, az), w * 0.04,
			Vector3(ax * 1.1, ay_base + alick, az * 1.1), w * 0.008,
			primary.lightened(0.20), 0.05, 0.0)


# ============================================================================
# BARBED DEVIL (barbed_devil) — Hamatula
# Lawful evil devil COVERED in razor-sharp barbs and spikes head to tail.
#   - Slim, cruel-looking humanoid devil
#   - Every body surface bristles with bone-sharp barbs (signature)
#   - Single pair of curving horns
#   - Spiked tail with arrowhead/barbed tip
#   - Burning fire/flame held in each hand (it hurls fire)
#   - Glowing yellow eyes
#   - Red/dark-red skin
#   - Clawed digitigrade legs (often described as having hooves or claws)
# ============================================================================

static func _build_barbed_devil(plan: Dictionary, root: Node3D) -> void:
	var base: Dictionary = plan.get("base", {})
	var palette: Dictionary = plan.get("palette", {})
	var limbs: Dictionary = plan.get("limbs", {})
	var meta: Dictionary = plan.get("meta", {})
	var species: String = String(meta.get("species", "Barbed Devil"))

	# Medium-sized stocky muscular devil (gorilla-wedge torso).
	# Verify-agent fix: bumped from slim 0.65 to bulky 0.90 for canon read.
	var w: float = _axis(base, "width", 0.90)
	var h: float = _axis(base, "height", 2.05)
	var d: float = _axis(base, "depth", 0.60)
	var leg_length: float = float(limbs.get("leg_length", 1.00))
	var clearance: float = leg_length

	var render_seed: int = int(meta.get("render_seed", 0))
	var rng := RandomNumberGenerator.new()
	rng.seed = render_seed if render_seed != 0 else hash(species)

	# Per-individual variation
	var size_jitter: float = rng.randf_range(0.92, 1.10)
	var barb_density_jitter: float = rng.randf_range(0.85, 1.30)
	w *= size_jitter
	h *= size_jitter
	d *= size_jitter
	leg_length *= rng.randf_range(0.95, 1.10)
	clearance = leg_length

	# Skin palette — canon hamatula red/dark-red
	var skin_options := [
		Color(0.55, 0.12, 0.08),     # blood crimson
		Color(0.42, 0.10, 0.06),     # dark red
		Color(0.62, 0.18, 0.10),     # bright devil red
		Color(0.38, 0.08, 0.05),     # near-black red
	]
	var primary: Color = skin_options[rng.randi() % skin_options.size()]
	var skin_dark: Color = primary.darkened(0.35)
	# Barbs/spikes — bone-colored, slightly darker than ivory
	var barb_color := Color(0.85, 0.78, 0.65)
	var barb_dark: Color = barb_color.darkened(0.30)
	var horn_color := Color(0.18, 0.10, 0.08)
	var claw_color := Color(0.12, 0.08, 0.06)
	var eye_glow := Color(1.0, 0.85, 0.20)
	# Flame palette
	var flame_outer := Color(0.95, 0.30, 0.08)
	var flame_mid := Color(1.0, 0.65, 0.20)
	var flame_core := Color(1.0, 0.92, 0.55)

	# Helper RNG for jittered barb placement
	# (Captures `rng`, `barb_color`, `barb_dark` from outer scope.)
	# We can't define inner funcs in GDScript that capture, so we'll inline.

	# ============================================================================
	# TORSO — slim cruel humanoid, broad chest, narrow waist
	# ============================================================================
	var hip_y: float = clearance
	var waist_y: float = clearance + h * 0.12
	var chest_y: float = clearance + h * 0.30
	var shoulder_y: float = clearance + h * 0.45
	_build_box(
		root,
		Vector3(-w * 0.32, hip_y, -d * 0.26),
		Vector3(w * 0.32, waist_y, d * 0.28),
		primary, 0.45
	)
	_build_box(
		root,
		Vector3(-w * 0.36, waist_y, -d * 0.28),
		Vector3(w * 0.36, chest_y, d * 0.32),
		primary, 0.45
	)
	_build_box(
		root,
		Vector3(-w * 0.48, chest_y, -d * 0.32),
		Vector3(w * 0.48, shoulder_y, d * 0.36),
		primary, 0.45
	)

	# ============================================================================
	# BARBS — the signature feature. Dozens of bone-sharp spikes covering
	# the entire torso surface. Procedurally jittered with two ring layers:
	# back row (longer, more menacing) + side/front (shorter).
	# ============================================================================
	var torso_top: float = shoulder_y
	var torso_bot: float = hip_y
	# Vertical rings of barbs along the torso
	var ring_count: int = int(round(8.0 * barb_density_jitter))
	for ri in range(ring_count):
		var ring_t: float = float(ri) / float(max(1, ring_count - 1))
		var ry: float = lerpf(torso_bot + h * 0.02, torso_top - h * 0.02, ring_t)
		# Body radius at this ring (lerp from waist to shoulder)
		var rx: float
		var rz: float
		if ring_t < 0.30:
			rx = w * 0.34
			rz = d * 0.30
		elif ring_t < 0.60:
			rx = w * 0.38
			rz = d * 0.32
		else:
			rx = w * 0.50
			rz = d * 0.36
		# 6-8 barbs per ring, with random outward angles + length jitter
		var per_ring: int = rng.randi_range(6, 8)
		for bi in range(per_ring):
			var ang: float = (float(bi) / float(per_ring)) * TAU + rng.randf_range(-0.20, 0.20)
			var bx: float = cos(ang) * rx
			var bz: float = sin(ang) * rz
			# Barbs are longer along the back (-Z side)
			var back_factor: float = 0.5 - sin(ang) * 0.5    # 1 at back, 0 at front
			var barb_len: float = w * lerpf(0.10, 0.30, back_factor) * rng.randf_range(0.85, 1.20)
			# Barb tip points outward + slightly up
			var tip_x: float = bx + cos(ang) * barb_len
			var tip_z: float = bz + sin(ang) * barb_len
			var tip_y: float = ry + barb_len * 0.40
			var col: Color = barb_color if (bi + ri) % 3 != 0 else barb_dark
			_build_tapered_segment(root,
				Vector3(bx, ry, bz), w * 0.025,
				Vector3(tip_x, tip_y, tip_z), w * 0.004,
				col, 0.50)

	# ============================================================================
	# HEAD — slim devilish skull on a thin neck
	# ============================================================================
	var neck_top := Vector3(0, shoulder_y + h * 0.04, d * 0.05)
	_build_tapered_segment(root,
		Vector3(0, shoulder_y - h * 0.01, 0.0), w * 0.13,
		neck_top, w * 0.11,
		primary, 0.45)

	var head_w: float = w * 0.32
	var head_h: float = h * 0.16
	var head_d: float = d * 0.66
	var head_y_bot: float = neck_top.y
	var head_y_top: float = head_y_bot + head_h
	var head_center_y: float = (head_y_bot + head_y_top) * 0.5
	# Skull
	_build_box(
		root,
		Vector3(-head_w, head_y_bot, neck_top.z - head_d * 0.30),
		Vector3(head_w, head_y_top, neck_top.z + head_d * 0.32),
		primary, 0.45
	)
	# Snout/muzzle (slight protrusion)
	_build_box(
		root,
		Vector3(-head_w * 0.65, head_y_bot + h * 0.005,
			neck_top.z + head_d * 0.32 - d * 0.02),
		Vector3(head_w * 0.65, head_y_top - h * 0.025,
			neck_top.z + head_d * 0.55),
		primary, 0.45
	)
	# Heavy brow
	_build_box(
		root,
		Vector3(-head_w * 1.02, head_center_y + h * 0.025,
			neck_top.z + head_d * 0.15),
		Vector3(head_w * 1.02, head_center_y + h * 0.06,
			neck_top.z + head_d * 0.32),
		skin_dark, 0.50
	)
	# Yellow glowing eyes
	for side in [-1, 1]:
		_build_box(
			root,
			Vector3(side * head_w * 0.55 - w * 0.040,
				head_center_y - h * 0.005, neck_top.z + head_d * 0.27),
			Vector3(side * head_w * 0.55 + w * 0.040,
				head_center_y + h * 0.030, neck_top.z + head_d * 0.34),
			eye_glow, 0.10, 0.0
		)
		_build_box(
			root,
			Vector3(side * head_w * 0.55 - w * 0.018,
				head_center_y + h * 0.005, neck_top.z + head_d * 0.33),
			Vector3(side * head_w * 0.55 + w * 0.018,
				head_center_y + h * 0.025, neck_top.z + head_d * 0.34),
			Color(0.05, 0.02, 0.0), 0.30
		)
	# Jaw with fangs
	var jaw_y_top: float = head_y_bot - h * 0.005
	var jaw_y_bot: float = jaw_y_top - h * 0.05
	_build_box(
		root,
		Vector3(-head_w * 0.55, jaw_y_bot,
			neck_top.z + head_d * 0.32),
		Vector3(head_w * 0.55, jaw_y_top,
			neck_top.z + head_d * 0.54),
		skin_dark, 0.45
	)
	_build_box(
		root,
		Vector3(-head_w * 0.45, jaw_y_bot + h * 0.004,
			neck_top.z + head_d * 0.36),
		Vector3(head_w * 0.45, jaw_y_top - h * 0.004,
			neck_top.z + head_d * 0.50),
		Color(0.05, 0.02, 0.02), 0.85
	)
	for side in [-1, 1]:
		var fx_c: float = side * head_w * 0.45
		_build_tapered_segment(root,
			Vector3(fx_c, jaw_y_top, neck_top.z + head_d * 0.44), w * 0.020,
			Vector3(fx_c, jaw_y_top - h * 0.04, neck_top.z + head_d * 0.50), w * 0.005,
			barb_color, 0.45)

	# HORNS — short stubby conical nubs (~30° outward from forehead).
	# Verify-agent fix: previous long sweeping ram horns read as bearded
	# devil; canon Hamatula horns are short forward-jutting nubs.
	for side in [-1, 1]:
		var horn_base := Vector3(side * head_w * 0.55,
			head_y_top - h * 0.005, neck_top.z + head_d * 0.18)
		# Angled ~30° outward, slightly forward-up
		var horn_tip := Vector3(side * head_w * 1.05,
			head_y_top + h * 0.07, neck_top.z + head_d * 0.28)
		_build_tapered_segment(root, horn_base, w * 0.055, horn_tip, w * 0.012,
			horn_color, 0.50)

	# HEAD BARBS — small spikes radiating from the skull
	var head_barb_count: int = int(round(8.0 * barb_density_jitter))
	for hbi in range(head_barb_count):
		var hang: float = (float(hbi) / float(head_barb_count)) * TAU + rng.randf_range(-0.15, 0.15)
		var hx: float = cos(hang) * head_w * 0.95
		var hz: float = sin(hang) * head_d * 0.35 + neck_top.z + head_d * 0.10
		# Don't put barbs through the face (front-center)
		if sin(hang) > 0.75 and abs(cos(hang)) < 0.30:
			continue
		var hb_len: float = w * rng.randf_range(0.10, 0.18)
		_build_tapered_segment(root,
			Vector3(hx, head_y_top - h * 0.02, hz), w * 0.020,
			Vector3(hx * 1.15, head_y_top - h * 0.02 + hb_len * 0.6,
				hz + sin(hang) * hb_len * 0.4), w * 0.003,
			barb_color, 0.50)

	# ============================================================================
	# ARMS — THICK MUSCULAR brute arms. Verify-agent fix: previously slim;
	# canon Hamatula has gorilla-like bulk in upper arms + deltoid mass.
	# Densely barbed forearms + prominent elbow spike.
	# ============================================================================
	for side in [-1, 1]:
		var shoulder := Vector3(side * w * 0.48, shoulder_y - h * 0.02, 0.0)
		var elbow := Vector3(side * w * 0.62, shoulder_y - h * 0.18, d * 0.08)
		var wrist := Vector3(side * w * 0.55, shoulder_y - h * 0.35, d * 0.28)
		# Beefy upper arm
		_build_tapered_segment(root, shoulder, w * 0.20, elbow, w * 0.15,
			primary, 0.45)
		# Beefy forearm
		_build_tapered_segment(root, elbow, w * 0.15, wrist, w * 0.11,
			primary, 0.45)
		# Deltoid bulge — extra cap at the shoulder
		_build_tapered_segment(root,
			shoulder + Vector3(side * w * 0.02, h * 0.02, 0),
			w * 0.16,
			shoulder + Vector3(side * w * 0.08, -h * 0.04, 0),
			w * 0.12,
			primary.darkened(0.10), 0.45)
		# PROMINENT ELBOW SPIKE — large outward + back-pointing barb
		_build_tapered_segment(root,
			elbow + Vector3(side * w * 0.04, h * 0.01, -d * 0.04),
			w * 0.05,
			elbow + Vector3(side * w * 0.20, h * 0.02, -d * 0.18),
			w * 0.008,
			barb_color, 0.50)
		# Dense forearm barbs — 7 per side in two rows (top + outer)
		var forearm_spikes: int = rng.randi_range(6, 8)
		for fsi in range(forearm_spikes):
			var ft: float = (float(fsi) + 0.5) / float(forearm_spikes)
			var fp := elbow.lerp(wrist, ft)
			# Alternate top-row and outer-row barbs
			var is_outer: bool = fsi % 2 == 0
			var off_x: float = side * w * (0.12 if is_outer else 0.04)
			var off_y: float = w * (0.02 if is_outer else 0.10)
			var off_z: float = -d * (0.04 if is_outer else 0.0)
			_build_tapered_segment(root, fp, w * 0.022,
				fp + Vector3(off_x, off_y, off_z), w * 0.004,
				barb_color if fsi % 3 != 0 else barb_dark, 0.50)
		# Hand
		_build_box(
			root,
			Vector3(wrist.x - w * 0.08, wrist.y - h * 0.05, wrist.z - d * 0.06),
			Vector3(wrist.x + w * 0.08, wrist.y + h * 0.01, wrist.z + d * 0.08),
			skin_dark, 0.45
		)
		# Clawed fingers
		for ci in range(4):
			var ct: float = (float(ci) - 1.5) / 2.0
			var cx: float = wrist.x + ct * w * 0.04
			_build_tapered_segment(root,
				Vector3(cx, wrist.y - h * 0.04, wrist.z + d * 0.08), w * 0.012,
				Vector3(cx + ct * w * 0.02, wrist.y - h * 0.10, wrist.z + d * 0.22),
				w * 0.004,
				claw_color, 0.40)
		# BALL OF FLAME above the open palm (3 layered emissive spheres-as-boxes)
		var flame_center := Vector3(wrist.x, wrist.y + h * 0.06, wrist.z + d * 0.15)
		_build_box(
			root,
			flame_center + Vector3(-w * 0.10, -h * 0.04, -d * 0.10),
			flame_center + Vector3(w * 0.10, h * 0.06, d * 0.10),
			flame_outer, 0.05, 0.0
		)
		_build_box(
			root,
			flame_center + Vector3(-w * 0.07, -h * 0.025, -d * 0.07),
			flame_center + Vector3(w * 0.07, h * 0.045, d * 0.07),
			flame_mid, 0.05, 0.0
		)
		_build_box(
			root,
			flame_center + Vector3(-w * 0.04, -h * 0.015, -d * 0.04),
			flame_center + Vector3(w * 0.04, h * 0.03, d * 0.04),
			flame_core, 0.05, 0.0
		)
		# Upward-licking flame tongue
		_build_tapered_segment(root,
			flame_center + Vector3(0, h * 0.04, 0), w * 0.08,
			flame_center + Vector3(0, h * 0.20, 0), w * 0.010,
			flame_outer, 0.05, 0.0)
		_build_tapered_segment(root,
			flame_center + Vector3(0, h * 0.05, 0), w * 0.05,
			flame_center + Vector3(0, h * 0.16, 0), w * 0.006,
			flame_core, 0.05, 0.0)

	# ============================================================================
	# LEGS — clawed digitigrade legs with barbs
	# ============================================================================
	for side in [-1, 1]:
		var hip := Vector3(side * w * 0.22, hip_y + h * 0.03, 0.0)
		var knee := Vector3(side * w * 0.25, clearance * 0.58, d * 0.08)
		var ankle := Vector3(side * w * 0.20, clearance * 0.18, -d * 0.04)
		var foot := Vector3(side * w * 0.20, 0.05, d * 0.04)
		_build_tapered_segment(root, hip, w * 0.17, knee, w * 0.13, primary, 0.45)
		_build_tapered_segment(root, knee, w * 0.12, ankle, w * 0.10, primary, 0.45)
		_build_tapered_segment(root, ankle, w * 0.10, foot, w * 0.085, skin_dark, 0.50)
		# Knee spike
		_build_tapered_segment(root,
			knee, w * 0.045,
			knee + Vector3(side * w * 0.10, h * 0.04, d * 0.10), w * 0.005,
			barb_color, 0.50)
		# Shin barbs (3 per leg, alternating sides)
		for li in range(3):
			var lt: float = float(li) / 3.0 + 0.10
			var lp := knee.lerp(ankle, lt)
			var lside: float = (1.0 if li % 2 == 0 else -1.0) * side
			_build_tapered_segment(root, lp, w * 0.020,
				lp + Vector3(lside * w * 0.08, w * 0.03, -d * 0.04),
				w * 0.004, barb_color, 0.50)
		# Foot — clawed
		_build_box(
			root,
			Vector3(side * w * 0.20 - w * 0.10, 0.0, -d * 0.05),
			Vector3(side * w * 0.20 + w * 0.10, h * 0.05, d * 0.18),
			skin_dark, 0.50
		)
		# 3 clawed toes
		for ti in range(3):
			var to: float = (float(ti) - 1.0) * w * 0.06
			_build_tapered_segment(root,
				Vector3(side * w * 0.20 + to, h * 0.03, d * 0.16), w * 0.024,
				Vector3(side * w * 0.20 + to, 0.0, d * 0.28), w * 0.005,
				claw_color, 0.40)

	# ============================================================================
	# TAIL — long, ending in a BARBED ARROWHEAD TIP
	# Spiked along its length.
	# ============================================================================
	var tail_base := Vector3(0, hip_y + h * 0.05, -d * 0.22)
	var tail_mid := Vector3(rng.randf_range(-w * 0.15, w * 0.15),
		hip_y - h * 0.08, -d * 0.55)
	var tail_pre_tip := Vector3(rng.randf_range(-w * 0.20, w * 0.20),
		h * 0.05, -d * 0.85)
	_build_tapered_segment(root, tail_base, w * 0.12, tail_mid, w * 0.07,
		primary, 0.45)
	_build_tapered_segment(root, tail_mid, w * 0.07, tail_pre_tip, w * 0.045,
		skin_dark, 0.45)
	# Tail-length barbs along the underside
	var tail_barbs: int = rng.randi_range(4, 6)
	for tbi in range(tail_barbs):
		var tbt: float = (float(tbi) + 0.5) / float(tail_barbs)
		var tb_pos: Vector3 = tail_base.lerp(tail_pre_tip, tbt)
		var bside: float = 1.0 if tbi % 2 == 0 else -1.0
		_build_tapered_segment(root,
			tb_pos, w * 0.020,
			tb_pos + Vector3(bside * w * 0.04, -h * 0.05, -d * 0.05),
			w * 0.004,
			barb_color, 0.50)
	# ARROWHEAD TIP — wide spade flanked by two side barbs
	var tip_center := tail_pre_tip + Vector3(0, -h * 0.02, -d * 0.10)
	_build_box(
		root,
		Vector3(tip_center.x - w * 0.08, tip_center.y - h * 0.04,
			tip_center.z - d * 0.08),
		Vector3(tip_center.x + w * 0.08, tip_center.y + h * 0.04,
			tip_center.z),
		barb_color, 0.45
	)
	# Two side flanges of the arrowhead (barbed)
	for side in [-1, 1]:
		_build_tapered_segment(root,
			tip_center + Vector3(side * w * 0.06, 0, -d * 0.02),
			w * 0.040,
			tip_center + Vector3(side * w * 0.18, -h * 0.02, -d * 0.10),
			w * 0.006,
			barb_color, 0.45)
	# Central point of the arrowhead
	_build_tapered_segment(root,
		tip_center, w * 0.040,
		tip_center + Vector3(0, 0, -d * 0.15), w * 0.005,
		barb_dark, 0.45)


# ============================================================================
# BARGHEST (barghest) — Greater goblin-demon shapeshifter (wolf form)
#   - Large quadruped wolf-demon (bigger than a normal wolf)
#   - Stocky/heavy build with shoulder hump
#   - DARK BLUE-BLACK or RED fur, often bristly
#   - Glowing orange/red FEROCIOUS EYES (signature)
#   - Oversized fangs jutting from a heavy lower jaw
#   - RIDGE OF BONY PLATES along the spine (signature)
#   - Long bushy tail
#   - Powerful clawed paws (4 toes each)
# ============================================================================

static func _build_barghest(plan: Dictionary, root: Node3D) -> void:
	var base: Dictionary = plan.get("base", {})
	var palette: Dictionary = plan.get("palette", {})
	var limbs: Dictionary = plan.get("limbs", {})
	var meta: Dictionary = plan.get("meta", {})
	var species: String = String(meta.get("species", "Barghest"))

	# Large stocky wolf-demon
	var w: float = _axis(base, "width", 0.75)
	var h: float = _axis(base, "height", 1.05)
	var d: float = _axis(base, "depth", 1.55)
	var leg_length: float = float(limbs.get("leg_length", 0.55))
	var clearance: float = leg_length

	var render_seed: int = int(meta.get("render_seed", 0))
	var rng := RandomNumberGenerator.new()
	rng.seed = render_seed if render_seed != 0 else hash(species)

	# Per-individual variation
	var size_jitter: float = rng.randf_range(0.92, 1.15)
	var fur_bristle_jitter: float = rng.randf_range(0.85, 1.30)
	var plate_count_jitter: int = rng.randi_range(5, 8)
	w *= size_jitter
	h *= size_jitter
	d *= size_jitter
	leg_length *= rng.randf_range(0.90, 1.10)
	clearance = leg_length

	# Fur palette — canon greater barghest is BLUE-BLACK; lesser is sometimes
	# rusty red. Pick from canonical hues only.
	var roll: float = rng.randf()
	var primary: Color
	if roll < 0.55:
		primary = Color(0.10, 0.12, 0.18)    # blue-black (canon greater)
	elif roll < 0.75:
		primary = Color(0.14, 0.16, 0.22)    # midnight blue
	elif roll < 0.92:
		primary = Color(0.32, 0.10, 0.08)    # rusty red (lesser variant)
	else:
		primary = Color(0.18, 0.18, 0.20)    # ash-grey
	var fur_dark: Color = primary.darkened(0.30)
	var fur_light: Color = primary.lightened(0.10)
	var belly_color: Color = primary.darkened(0.20)
	var plate_color := Color(0.10, 0.08, 0.06)         # near-black bony plates
	var plate_highlight: Color = plate_color.lightened(0.15)
	var claw_color := Color(0.10, 0.08, 0.06)
	var fang_color := Color(0.92, 0.88, 0.78)
	var eye_glow := Color(1.0, 0.45, 0.05)             # ferocious orange

	# ============================================================================
	# BODY — heavy quadruped trunk with shoulder hump (like a hyena/dire wolf)
	# ============================================================================
	var body_y: float = clearance + h * 0.30
	var hump_y: float = body_y + h * 0.18
	var body_sections: Array = [
		{"center": Vector3(0, body_y - h * 0.02, -d * 0.40), "w": w * 0.30, "h": h * 0.28}, # tail base
		{"center": Vector3(0, body_y - h * 0.02, -d * 0.20), "w": w * 0.42, "h": h * 0.38}, # hip
		{"center": Vector3(0, body_y, 0.0), "w": w * 0.46, "h": h * 0.40},                  # mid back
		{"center": Vector3(0, hump_y, d * 0.18), "w": w * 0.52, "h": h * 0.48},             # shoulder hump
		{"center": Vector3(0, body_y + h * 0.05, d * 0.32), "w": w * 0.42, "h": h * 0.40},  # chest
		{"center": Vector3(0, body_y + h * 0.08, d * 0.42), "w": w * 0.30, "h": h * 0.30},  # neck base
	]
	_swept_body(root, body_sections, 10, primary, belly_color, 0.92, true)

	# ============================================================================
	# NECK + HEAD — thick maned neck, square heavy wolf-skull
	# ============================================================================
	var neck_base := (body_sections[5]["center"] as Vector3)
	var neck_mid := Vector3(0, neck_base.y + h * 0.12, neck_base.z + d * 0.12)
	var head_anchor := Vector3(0, neck_base.y + h * 0.18, neck_base.z + d * 0.30)
	_build_tapered_segment(root, neck_base, w * 0.22, neck_mid, w * 0.20, primary, 0.92)
	_build_tapered_segment(root, neck_mid, w * 0.20, head_anchor + Vector3(0, -h * 0.06, 0),
		w * 0.22, primary, 0.92)

	# Skull — wider behind, narrower at snout. Square heavy wolfish profile.
	var skull_w: float = w * 0.28
	var skull_h: float = h * 0.30
	var skull_d: float = d * 0.30
	var skull_y_bot: float = head_anchor.y - skull_h * 0.30
	var skull_y_top: float = skull_y_bot + skull_h
	var skull_center_y: float = (skull_y_bot + skull_y_top) * 0.5
	_build_box(
		root,
		Vector3(-skull_w, skull_y_bot,
			head_anchor.z - skull_d * 0.35),
		Vector3(skull_w, skull_y_top,
			head_anchor.z + skull_d * 0.30),
		primary, 0.92
	)
	# Snout — narrower, protruding forward
	var snout_back_z: float = head_anchor.z + skull_d * 0.30
	var snout_tip_z: float = head_anchor.z + skull_d * 0.95
	_build_box(
		root,
		Vector3(-skull_w * 0.55, skull_y_bot + h * 0.02,
			snout_back_z - d * 0.02),
		Vector3(skull_w * 0.55, skull_y_top - h * 0.05,
			snout_tip_z),
		primary, 0.92
	)
	# Black nose tip
	_build_box(
		root,
		Vector3(-skull_w * 0.20, skull_y_top - h * 0.10,
			snout_tip_z - d * 0.04),
		Vector3(skull_w * 0.20, skull_y_top - h * 0.05,
			snout_tip_z + d * 0.02),
		Color(0.04, 0.03, 0.03), 0.55
	)
	# Heavy brow ridge — casts shadow over eyes
	_build_box(
		root,
		Vector3(-skull_w * 1.05, skull_center_y + h * 0.05,
			head_anchor.z + skull_d * 0.05),
		Vector3(skull_w * 1.05, skull_center_y + h * 0.10,
			head_anchor.z + skull_d * 0.30),
		fur_dark, 0.92
	)

	# FEROCIOUS GLOWING EYES — orange, predator forward-facing
	for side in [-1, 1]:
		_build_box(
			root,
			Vector3(side * skull_w * 0.55 - w * 0.04,
				skull_center_y + h * 0.005, head_anchor.z + skull_d * 0.20),
			Vector3(side * skull_w * 0.55 + w * 0.04,
				skull_center_y + h * 0.045, head_anchor.z + skull_d * 0.30),
			eye_glow, 0.10, 0.0
		)
		# Inner pupil slit
		_build_box(
			root,
			Vector3(side * skull_w * 0.55 - w * 0.010,
				skull_center_y + h * 0.012, head_anchor.z + skull_d * 0.28),
			Vector3(side * skull_w * 0.55 + w * 0.010,
				skull_center_y + h * 0.038, head_anchor.z + skull_d * 0.30),
			Color(0.05, 0.02, 0.0), 0.30
		)

	# UPRIGHT POINTED EARS — tall canine ears on top of skull
	for side in [-1, 1]:
		var ear_base := Vector3(side * skull_w * 0.65,
			skull_y_top - h * 0.005, head_anchor.z - skull_d * 0.10)
		var ear_tip := Vector3(side * skull_w * 0.90,
			skull_y_top + h * 0.22, head_anchor.z - skull_d * 0.05)
		_build_tapered_segment(root, ear_base, w * 0.08, ear_tip, w * 0.010,
			primary, 0.92)
		# Inner ear (darker)
		_build_tapered_segment(root,
			ear_base + Vector3(0, h * 0.02, d * 0.005), w * 0.05,
			ear_tip + Vector3(0, -h * 0.02, 0), w * 0.006,
			fur_dark, 0.95)

	# JAW with OVERSIZED FANGS — heavy lower jaw drop, fangs protrude past lips
	var jaw_y_top: float = skull_y_bot + h * 0.05
	var jaw_y_bot: float = skull_y_bot - h * 0.05
	_build_box(
		root,
		Vector3(-skull_w * 0.50, jaw_y_bot,
			snout_back_z + d * 0.02),
		Vector3(skull_w * 0.50, jaw_y_top,
			snout_tip_z - d * 0.02),
		fur_dark, 0.92
	)
	# Inner mouth dark
	_build_box(
		root,
		Vector3(-skull_w * 0.40, jaw_y_bot + h * 0.005,
			snout_back_z + d * 0.06),
		Vector3(skull_w * 0.40, jaw_y_top - h * 0.005,
			snout_tip_z - d * 0.06),
		Color(0.08, 0.03, 0.03), 0.85
	)
	# Upper canines — large but the jaw CLOSES. Verify-agent fix: previously
	# sabertooth-long past the mandible; now tip kisses the lower lip line.
	for side in [-1, 1]:
		var ufx: float = side * skull_w * 0.42
		_build_tapered_segment(root,
			Vector3(ufx, jaw_y_top, snout_back_z + d * 0.15), w * 0.030,
			Vector3(ufx, jaw_y_bot + h * 0.005, snout_back_z + d * 0.17), w * 0.005,
			fang_color, 0.45)
	# Lower canines — INTERLOCK in front of the uppers (slightly inside the
	# mouth-line) for that menacing bared-teeth read.
	for side in [-1, 1]:
		var lfx: float = side * skull_w * 0.35
		_build_tapered_segment(root,
			Vector3(lfx, jaw_y_bot, snout_back_z + d * 0.13), w * 0.026,
			Vector3(lfx, jaw_y_top - h * 0.005, snout_back_z + d * 0.16), w * 0.005,
			fang_color, 0.45)

	# ============================================================================
	# DORSAL HACKLE CREST — bristly STIFF FUR ridge along the spine.
	# Verify-agent fix: replaced bony plates (which pushed silhouette toward
	# hell hound) with the canon bristly hackle continuing from the mane.
	# Tapered cones angled ~20° rearward, ~40% of former plate height,
	# colored in the mane palette (no bone highlight).
	# ============================================================================
	var plate_z_start: float = d * 0.20
	var plate_z_end: float = -d * 0.35
	# Hackle is denser than plates were — use ~2× count
	var hackle_count: int = plate_count_jitter * 2
	for pi in range(hackle_count):
		var pt: float = float(pi) / float(hackle_count - 1)
		var pz: float = lerpf(plate_z_start, plate_z_end, pt)
		var height_factor: float = 1.0 - pow(abs(pt - 0.45) * 2.0, 1.5)
		var tuft_h: float = h * lerpf(0.02, 0.07, max(0.0, height_factor)) * fur_bristle_jitter
		var spine_y: float = body_y + h * 0.20
		# Slight rng to sway each tuft + alternate dark/light fur
		var sway: float = rng.randf_range(-w * 0.02, w * 0.02)
		var tuft_root := Vector3(sway, spine_y, pz)
		# Tip slants ~20° rearward + up
		var tuft_tip := Vector3(sway, spine_y + tuft_h,
			pz - tuft_h * 0.36)
		var tuft_col: Color = fur_dark if pi % 2 == 0 else fur_light
		_build_tapered_segment(root, tuft_root, w * 0.025,
			tuft_tip, w * 0.005,
			tuft_col, 0.95)

	# ============================================================================
	# BRISTLY FUR TUFTS — around the neck (mane) and shoulders
	# ============================================================================
	var mane_count: int = int(round(12.0 * fur_bristle_jitter))
	for mi in range(mane_count):
		var ang: float = (float(mi) / float(mane_count)) * TAU + rng.randf_range(-0.15, 0.15)
		var mr_x: float = cos(ang) * w * 0.36
		var mr_z: float = sin(ang) * d * 0.20
		var mane_root := Vector3(mr_x, neck_base.y + h * rng.randf_range(0.0, 0.10),
			neck_base.z + mr_z)
		var tuft_len: float = w * rng.randf_range(0.08, 0.20)
		var mane_tip := Vector3(mr_x * 1.15,
			mane_root.y + tuft_len * 0.40,
			mane_root.z + mr_z * 0.2 - d * 0.05)
		_build_tapered_segment(root, mane_root, w * 0.025, mane_tip, w * 0.005,
			fur_dark if mi % 2 == 0 else fur_light, 0.95)

	# ============================================================================
	# LEGS — 4 powerful clawed paws (canine quadruped)
	# ============================================================================
	for side in [-1, 1]:
		# Front legs (slightly straighter; under shoulder hump)
		var fhip := Vector3(side * w * 0.30, body_y + h * 0.05, d * 0.20)
		var fknee := Vector3(side * w * 0.30, clearance * 0.55, d * 0.22)
		var fpaw := Vector3(side * w * 0.28, 0.05, d * 0.25)
		_build_tapered_segment(root, fhip, w * 0.16, fknee, w * 0.12, primary, 0.92)
		_build_tapered_segment(root, fknee, w * 0.12, fpaw, w * 0.10, fur_dark, 0.92)
		# Paw
		_build_box(
			root,
			Vector3(side * w * 0.28 - w * 0.12, 0.0, d * 0.18),
			Vector3(side * w * 0.28 + w * 0.12, h * 0.08, d * 0.36),
			fur_dark, 0.92
		)
		# Front paw claws — splayed unequal demonic claws.
		# Verify-agent fix: previously too wolfish-tidy; now 5 claws with
		# center claws ~25% longer + a rear-set dewclaw.
		for ci in range(4):
			var co: float = (float(ci) - 1.5) * w * 0.06
			# Centermost two are oversized
			var is_center: bool = ci == 1 or ci == 2
			var claw_len_z: float = d * (0.075 if is_center else 0.060)
			var claw_thick: float = w * (0.026 if is_center else 0.020)
			_build_tapered_segment(root,
				Vector3(side * w * 0.28 + co, h * 0.03, d * 0.36), claw_thick,
				Vector3(side * w * 0.28 + co, 0.0, d * 0.36 + claw_len_z), w * 0.004,
				claw_color, 0.40)
		# Rear-set dewclaw on front paw (demonic 5th claw, slight outward angle)
		_build_tapered_segment(root,
			Vector3(side * w * 0.32, h * 0.06, d * 0.20), w * 0.020,
			Vector3(side * w * 0.36, h * 0.005, d * 0.14), w * 0.004,
			claw_color, 0.40)
		# Back legs (digitigrade angle)
		var rhip := Vector3(side * w * 0.30, body_y, -d * 0.20)
		var rknee := Vector3(side * w * 0.32, clearance * 0.65, -d * 0.16)
		var rhock := Vector3(side * w * 0.28, clearance * 0.30, -d * 0.24)
		var rpaw := Vector3(side * w * 0.28, 0.05, -d * 0.15)
		_build_tapered_segment(root, rhip, w * 0.18, rknee, w * 0.13, primary, 0.92)
		_build_tapered_segment(root, rknee, w * 0.12, rhock, w * 0.10, primary, 0.92)
		_build_tapered_segment(root, rhock, w * 0.10, rpaw, w * 0.10, fur_dark, 0.92)
		# Back paw
		_build_box(
			root,
			Vector3(side * w * 0.28 - w * 0.11, 0.0, -d * 0.22),
			Vector3(side * w * 0.28 + w * 0.11, h * 0.08, -d * 0.08),
			fur_dark, 0.92
		)
		# Back paw claws
		for ci in range(4):
			var co: float = (float(ci) - 1.5) * w * 0.055
			_build_tapered_segment(root,
				Vector3(side * w * 0.28 + co, h * 0.03, -d * 0.08), w * 0.020,
				Vector3(side * w * 0.28 + co, 0.0, -d * 0.02), w * 0.004,
				claw_color, 0.40)

	# ============================================================================
	# TAIL — long bushy wolf-demon tail with a flame-like bristle
	# ============================================================================
	var tail_base := Vector3(0, body_y, -d * 0.40)
	var tail_mid := Vector3(rng.randf_range(-w * 0.05, w * 0.05),
		body_y - h * 0.05, -d * 0.70)
	var tail_tip := Vector3(rng.randf_range(-w * 0.15, w * 0.15),
		body_y - h * 0.10, -d * 0.95)
	_build_tapered_segment(root, tail_base, w * 0.18, tail_mid, w * 0.14, primary, 0.92)
	_build_tapered_segment(root, tail_mid, w * 0.14, tail_tip, w * 0.08, fur_dark, 0.95)
	# Tail bristle tufts — 5 fur clumps along the length
	for ti in range(5):
		var tt: float = (float(ti) + 0.5) / 5.0
		var t_pos: Vector3 = tail_base.lerp(tail_tip, tt)
		for bside in [-1, 1]:
			var bristle_tip := t_pos + Vector3(bside * w * 0.10,
				w * rng.randf_range(-0.04, 0.06), -d * 0.02)
			_build_tapered_segment(root, t_pos, w * 0.04, bristle_tip, w * 0.008,
				fur_dark, 0.95)


# ============================================================================
# BASILISK (basilisk) — D&D petrifying-gaze reptile
#   - EIGHT short legs (NOT four — signature D&D anatomy)
#   - Squat lizard body, low to the ground
#   - Heavy scaled hide with prominent back ridges
#   - Petrifying gaze — large orange/yellow gemstone-like EYES
#   - Blunt reptilian head with rows of small teeth
#   - Stocky tapering tail with bony spines
#   - Brown/olive/grey scales
# ============================================================================

static func _build_basilisk(plan: Dictionary, root: Node3D) -> void:
	var base: Dictionary = plan.get("base", {})
	var palette: Dictionary = plan.get("palette", {})
	var limbs: Dictionary = plan.get("limbs", {})
	var meta: Dictionary = plan.get("meta", {})
	var species: String = String(meta.get("species", "Basilisk"))

	# Squat 8-legged reptile: longer than tall. Verify-agent fix: bumped
	# width to ~1.10 for the canon "broad-bodied toad-like" trunk that
	# justifies the splayed 8-leg layout (was 0.85, too centipede-narrow).
	var w: float = _axis(base, "width", 1.10)
	var h: float = _axis(base, "height", 0.55)
	var d: float = _axis(base, "depth", 1.80)
	var leg_length: float = float(limbs.get("leg_length", 0.22))
	var clearance: float = leg_length

	var render_seed: int = int(meta.get("render_seed", 0))
	var rng := RandomNumberGenerator.new()
	rng.seed = render_seed if render_seed != 0 else hash(species)

	# Per-individual variation
	var size_jitter: float = rng.randf_range(0.92, 1.15)
	var spine_count_jitter: int = rng.randi_range(6, 9)
	w *= size_jitter
	h *= size_jitter
	d *= size_jitter
	leg_length *= rng.randf_range(0.90, 1.15)
	clearance = leg_length

	# Scale palette — earthy reptilian
	var scale_options := [
		Color(0.35, 0.32, 0.22),     # olive-brown
		Color(0.28, 0.24, 0.18),     # dark earth
		Color(0.42, 0.35, 0.20),     # sandy ochre
		Color(0.30, 0.30, 0.25),     # grey-green
		Color(0.22, 0.20, 0.16),     # near-black brown
	]
	var primary: Color = scale_options[rng.randi() % scale_options.size()]
	var scale_dark: Color = primary.darkened(0.30)
	var belly_color: Color = primary.lightened(0.10).lerp(Color(0.55, 0.50, 0.30), 0.4)
	var spine_color := Color(0.22, 0.18, 0.14)
	var claw_color := Color(0.10, 0.08, 0.06)
	# Petrifying gaze — orange/yellow gemstone eye
	var eye_glow := Color(0.95, 0.70, 0.15)
	var eye_dark := Color(0.55, 0.35, 0.05)

	# ============================================================================
	# BODY — low squat lizard trunk, slightly wider at hips than shoulders
	# ============================================================================
	var body_y: float = clearance + h * 0.22
	var body_sections: Array = [
		{"center": Vector3(0, body_y - h * 0.02, -d * 0.42), "w": w * 0.28, "h": h * 0.24},  # tail base
		{"center": Vector3(0, body_y - h * 0.02, -d * 0.25), "w": w * 0.46, "h": h * 0.40},  # hip
		{"center": Vector3(0, body_y, -d * 0.08), "w": w * 0.50, "h": h * 0.42},             # mid-back
		{"center": Vector3(0, body_y, d * 0.10), "w": w * 0.46, "h": h * 0.40},              # shoulders
		{"center": Vector3(0, body_y, d * 0.28), "w": w * 0.38, "h": h * 0.36},              # chest
		{"center": Vector3(0, body_y + h * 0.05, d * 0.42), "w": w * 0.30, "h": h * 0.30},   # neck base
	]
	_swept_body(root, body_sections, 10, primary, belly_color, 0.95, true)

	# ============================================================================
	# HEAD — blunt reptilian, low and forward
	# ============================================================================
	var neck_base := (body_sections[5]["center"] as Vector3)
	var head_anchor := Vector3(0, neck_base.y, neck_base.z + d * 0.18)
	# Short thick neck
	_build_tapered_segment(root, neck_base, w * 0.20,
		Vector3(0, head_anchor.y, head_anchor.z - d * 0.05), w * 0.22,
		primary, 0.95)

	var skull_w: float = w * 0.32
	var skull_h: float = h * 0.30
	var skull_d: float = d * 0.30
	var skull_y_bot: float = head_anchor.y - skull_h * 0.45
	var skull_y_top: float = skull_y_bot + skull_h
	var skull_center_y: float = (skull_y_bot + skull_y_top) * 0.5
	# Skull (rectangular, blunt)
	_build_box(
		root,
		Vector3(-skull_w, skull_y_bot, head_anchor.z - skull_d * 0.35),
		Vector3(skull_w, skull_y_top, head_anchor.z + skull_d * 0.50),
		primary, 0.95
	)
	# Snout (slightly narrower, blunt)
	_build_box(
		root,
		Vector3(-skull_w * 0.75, skull_y_bot + h * 0.01,
			head_anchor.z + skull_d * 0.50 - d * 0.02),
		Vector3(skull_w * 0.75, skull_y_top - h * 0.04,
			head_anchor.z + skull_d * 0.88),
		primary, 0.95
	)
	# Nostril dimples
	for side in [-1, 1]:
		_build_box(
			root,
			Vector3(side * skull_w * 0.30 - w * 0.020,
				skull_y_top - h * 0.10, head_anchor.z + skull_d * 0.82),
			Vector3(side * skull_w * 0.30 + w * 0.020,
				skull_y_top - h * 0.06, head_anchor.z + skull_d * 0.90),
			scale_dark, 0.95
		)
	# Heavy brow over the eyes
	_build_box(
		root,
		Vector3(-skull_w * 1.02, skull_center_y + h * 0.05,
			head_anchor.z + skull_d * 0.05),
		Vector3(skull_w * 1.02, skull_center_y + h * 0.10,
			head_anchor.z + skull_d * 0.50),
		scale_dark, 0.95
	)

	# PETRIFYING GAZE EYES — large gemstone-like orange/yellow, prominent
	for side in [-1, 1]:
		# Outer eye socket (set high on the head — predator eyes forward)
		_build_box(
			root,
			Vector3(side * skull_w * 0.50 - w * 0.07,
				skull_center_y - h * 0.005, head_anchor.z + skull_d * 0.30),
			Vector3(side * skull_w * 0.50 + w * 0.07,
				skull_center_y + h * 0.055, head_anchor.z + skull_d * 0.50),
			eye_glow, 0.10, 0.0
		)
		# Inner iris (darker amber)
		_build_box(
			root,
			Vector3(side * skull_w * 0.50 - w * 0.035,
				skull_center_y + h * 0.005, head_anchor.z + skull_d * 0.40),
			Vector3(side * skull_w * 0.50 + w * 0.035,
				skull_center_y + h * 0.040, head_anchor.z + skull_d * 0.50),
			eye_dark, 0.20, 0.0
		)
		# Vertical reptilian slit pupil
		_build_box(
			root,
			Vector3(side * skull_w * 0.50 - w * 0.005,
				skull_center_y + h * 0.005, head_anchor.z + skull_d * 0.48),
			Vector3(side * skull_w * 0.50 + w * 0.005,
				skull_center_y + h * 0.045, head_anchor.z + skull_d * 0.50),
			Color(0.02, 0.02, 0.02), 0.30
		)

	# JAW + tooth row — wide blunt mouth with small teeth
	var jaw_y_top: float = skull_y_bot + h * 0.03
	var jaw_y_bot: float = skull_y_bot - h * 0.04
	_build_box(
		root,
		Vector3(-skull_w * 0.70, jaw_y_bot,
			head_anchor.z + skull_d * 0.05),
		Vector3(skull_w * 0.70, jaw_y_top,
			head_anchor.z + skull_d * 0.85),
		scale_dark, 0.95
	)
	# Inner mouth dark
	_build_box(
		root,
		Vector3(-skull_w * 0.55, jaw_y_bot + h * 0.005,
			head_anchor.z + skull_d * 0.12),
		Vector3(skull_w * 0.55, jaw_y_top - h * 0.005,
			head_anchor.z + skull_d * 0.80),
		Color(0.10, 0.05, 0.05), 0.85
	)
	# Small teeth row — 7 along the upper jaw line
	for ti in range(7):
		var tt: float = float(ti) / 6.0
		var tx: float = lerpf(-skull_w * 0.55, skull_w * 0.55, tt)
		var tooth_h: float = h * (0.03 if (ti == 0 or ti == 6) else 0.02)
		_build_tapered_segment(root,
			Vector3(tx, jaw_y_top, head_anchor.z + skull_d * 0.65), w * 0.010,
			Vector3(tx, jaw_y_top - tooth_h, head_anchor.z + skull_d * 0.65),
			w * 0.003,
			Color(0.85, 0.80, 0.65), 0.45)

	# ============================================================================
	# DORSAL SPINE RIDGES — pointed bony spikes along the back (canon)
	# Distinct from barghest hackles — these are HARD chitin-like spikes.
	# ============================================================================
	var ridge_z_start: float = d * 0.30
	var ridge_z_end: float = -d * 0.40
	for si in range(spine_count_jitter):
		var st: float = float(si) / float(spine_count_jitter - 1)
		var sz: float = lerpf(ridge_z_start, ridge_z_end, st)
		# Height profile: largest mid-back, smaller at ends
		var height_factor: float = 1.0 - pow(abs(st - 0.4) * 2.0, 1.4)
		var spike_h: float = h * lerpf(0.10, 0.30, max(0.0, height_factor))
		var spine_top_y: float = body_y + h * 0.22
		_build_tapered_segment(root,
			Vector3(0, spine_top_y, sz), w * 0.05,
			Vector3(0, spine_top_y + spike_h, sz - h * 0.04), w * 0.008,
			spine_color, 0.55)

	# ============================================================================
	# EIGHT LEGS — the signature D&D anatomy. 4 pairs along the body.
	# Distributed forward → back at z = +0.30, +0.10, -0.10, -0.30 approximately.
	# Each is a short, stocky reptilian leg with a 3-claw foot.
	# ============================================================================
	var leg_z_positions: Array = [d * 0.32, d * 0.12, -d * 0.10, -d * 0.30]
	for pair_idx in range(4):
		var lz: float = leg_z_positions[pair_idx] as float
		# Front pairs slightly larger than mid pairs (typical 8-leg layout)
		var leg_scale: float = 1.0 if (pair_idx == 0 or pair_idx == 3) else 0.88
		for side in [-1, 1]:
			var hip := Vector3(side * w * 0.42, body_y - h * 0.05, lz)
			var knee := Vector3(side * w * 0.52, clearance * 0.55 * leg_scale,
				lz + d * 0.04)
			var ankle := Vector3(side * w * 0.50, clearance * 0.18,
				lz - d * 0.02)
			var foot := Vector3(side * w * 0.50, 0.03, lz)
			_build_tapered_segment(root, hip, w * 0.08 * leg_scale,
				knee, w * 0.06 * leg_scale, primary, 0.95)
			_build_tapered_segment(root, knee, w * 0.06 * leg_scale,
				ankle, w * 0.05 * leg_scale, primary, 0.95)
			_build_tapered_segment(root, ankle, w * 0.05 * leg_scale,
				foot, w * 0.05 * leg_scale, scale_dark, 0.95)
			# Foot pad
			_build_box(
				root,
				Vector3(side * w * 0.50 - w * 0.06, 0.0, lz - d * 0.05),
				Vector3(side * w * 0.50 + w * 0.06, h * 0.04, lz + d * 0.05),
				scale_dark, 0.95
			)
			# 3 short toe claws — outer toes SPLAY OUTWARD ~25-30° lateral
			# for the sprawling reptile foot read (verify-agent fix: previous
			# forward-facing layout looked theropod).
			for ci in range(3):
				var co: float = (float(ci) - 1.0) * w * 0.04
				# Lateral offset increases for outer toes (side-pointing splay)
				var lateral_factor: float = float(ci) - 1.0     # -1, 0, +1
				var lateral_x: float = side * lateral_factor * w * 0.04
				_build_tapered_segment(root,
					Vector3(side * w * 0.50 + co, h * 0.02, lz + d * 0.05),
					w * 0.012,
					Vector3(side * w * 0.50 + co + lateral_x, 0.0,
						lz + d * (0.10 - abs(lateral_factor) * 0.03)),
					w * 0.003,
					claw_color, 0.40)

	# ============================================================================
	# SCALE PLATES — visible armor pattern along the back (3 rows of scale rosettes)
	# ============================================================================
	var scale_rows: int = 6
	for sri in range(scale_rows):
		var srt: float = float(sri) / float(scale_rows - 1)
		var srz: float = lerpf(ridge_z_start, ridge_z_end, srt)
		for side in [-1, 1]:
			_build_box(
				root,
				Vector3(side * w * 0.30 - w * 0.06, body_y + h * 0.10,
					srz - d * 0.03),
				Vector3(side * w * 0.30 + w * 0.06, body_y + h * 0.18,
					srz + d * 0.03),
				scale_dark, 0.90
			)
			# Inner highlight
			_build_box(
				root,
				Vector3(side * w * 0.30 - w * 0.040, body_y + h * 0.15,
					srz - d * 0.02),
				Vector3(side * w * 0.30 + w * 0.040, body_y + h * 0.18,
					srz + d * 0.02),
				primary, 0.90
			)

	# ============================================================================
	# TAIL — LONG tapering reptilian tail (~85% of body length) with continuing
	# dorsal spines. Verify-agent fix: was stocky stub; now properly long with
	# narrow tip.
	# ============================================================================
	var tail_base := Vector3(0, body_y - h * 0.02, -d * 0.42)
	var tail_mid := Vector3(rng.randf_range(-w * 0.10, w * 0.10),
		body_y - h * 0.10, -d * 0.95)
	var tail_far := Vector3(rng.randf_range(-w * 0.18, w * 0.18),
		body_y - h * 0.18, -d * 1.35)
	var tail_tip := Vector3(rng.randf_range(-w * 0.25, w * 0.25),
		body_y - h * 0.25, -d * 1.65)
	_build_tapered_segment(root, tail_base, w * 0.24, tail_mid, w * 0.16,
		primary, 0.95)
	_build_tapered_segment(root, tail_mid, w * 0.16, tail_far, w * 0.06,
		scale_dark, 0.95)
	_build_tapered_segment(root, tail_far, w * 0.06, tail_tip, w * 0.012,
		scale_dark, 0.95)
	# Tail spines continuing along the longer taper
	var tail_spine_count: int = 7
	for tsi in range(tail_spine_count):
		var tst: float = (float(tsi) + 0.5) / float(tail_spine_count)
		# Lerp along base→far for the visible spine length (skip the very tip)
		var ts_pos: Vector3 = tail_base.lerp(tail_far, tst)
		var ts_h: float = h * lerpf(0.20, 0.04, tst)
		_build_tapered_segment(root,
			ts_pos, w * 0.028,
			ts_pos + Vector3(0, ts_h, -h * 0.02), w * 0.004,
			spine_color, 0.55)


# ============================================================================
# BAT (bat) — Common or Giant winged mammal
#   - Compact furry body, hangs/perches with wings folded
#   - TWO LARGE LEATHERY WINGS extended outward (signature silhouette)
#   - 3-4 finger struts per wing supporting the membrane
#   - LARGE POINTED EARS (signature for echolocation)
#   - Small fanged mouth
#   - Hooked thumb claw on the wing peak
#   - Brown/black/grey fur
# ============================================================================

static func _build_bat(plan: Dictionary, root: Node3D) -> void:
	var base: Dictionary = plan.get("base", {})
	var palette: Dictionary = plan.get("palette", {})
	var limbs: Dictionary = plan.get("limbs", {})
	var meta: Dictionary = plan.get("meta", {})
	var species: String = String(meta.get("species", "Bat"))

	# Compact body — wings are MUCH wider than body. Body scales with size class.
	var w: float = _axis(base, "width", 0.18)
	var h: float = _axis(base, "height", 0.30)
	var d: float = _axis(base, "depth", 0.30)
	var leg_length: float = float(limbs.get("leg_length", 0.10))
	# Bats are usually rendered hovering — small clearance.
	var float_offset: float = leg_length * 1.2

	var render_seed: int = int(meta.get("render_seed", 0))
	var rng := RandomNumberGenerator.new()
	rng.seed = render_seed if render_seed != 0 else hash(species)

	# Per-individual variation
	var size_jitter: float = rng.randf_range(0.85, 1.20)
	var wing_span_jitter: float = rng.randf_range(0.90, 1.20)
	var ear_size_jitter: float = rng.randf_range(0.80, 1.40)
	w *= size_jitter
	h *= size_jitter
	d *= size_jitter

	# Fur palette — canon brown/black/grey
	var fur_options := [
		Color(0.22, 0.18, 0.14),     # dark brown
		Color(0.12, 0.10, 0.10),     # near-black
		Color(0.32, 0.26, 0.20),     # warm brown
		Color(0.22, 0.20, 0.22),     # slate grey
		Color(0.42, 0.32, 0.22),     # tawny brown (rare)
	]
	var primary: Color
	var fur_roll: float = rng.randf()
	if fur_roll < 0.35:
		primary = fur_options[0]      # dark brown most common
	elif fur_roll < 0.55:
		primary = fur_options[1]
	elif fur_roll < 0.75:
		primary = fur_options[2]
	elif fur_roll < 0.92:
		primary = fur_options[3]
	else:
		primary = fur_options[4]
	var fur_dark: Color = primary.darkened(0.30)
	var belly_color: Color = primary.lightened(0.12)
	# Wing membrane — pinkish-brown translucent skin
	var membrane_color := primary.darkened(0.15).lerp(
		Color(0.35, 0.20, 0.18), 0.45)
	var claw_color := Color(0.08, 0.06, 0.05)
	var fang_color := Color(0.92, 0.88, 0.75)
	var eye_color := Color(0.05, 0.05, 0.05)

	# Center of body
	var body_y: float = float_offset + h * 0.25
	var body_center := Vector3(0, body_y, 0)

	# ============================================================================
	# BODY — small compact furry trunk (egg-shaped)
	# ============================================================================
	var body_sections: Array = [
		{"center": Vector3(0, body_y - h * 0.10, -d * 0.20), "w": w * 0.40, "h": h * 0.30},  # tail/rear
		{"center": Vector3(0, body_y, -d * 0.05), "w": w * 0.62, "h": h * 0.42},             # mid (widest)
		{"center": Vector3(0, body_y + h * 0.08, d * 0.10), "w": w * 0.55, "h": h * 0.40},   # chest
		{"center": Vector3(0, body_y + h * 0.18, d * 0.18), "w": w * 0.40, "h": h * 0.32},   # neck
	]
	_swept_body(root, body_sections, 8, primary, belly_color, 0.95, true)

	# ============================================================================
	# HEAD — small with prominent muzzle + ears
	# ============================================================================
	var head_anchor := Vector3(0, body_y + h * 0.28, d * 0.25)
	var head_w: float = w * 0.40
	var head_h: float = h * 0.25
	var head_d: float = d * 0.42
	var head_y_bot: float = head_anchor.y - head_h * 0.50
	var head_y_top: float = head_y_bot + head_h
	var head_center_y: float = (head_y_bot + head_y_top) * 0.5
	_build_box(
		root,
		Vector3(-head_w, head_y_bot, head_anchor.z - head_d * 0.20),
		Vector3(head_w, head_y_top, head_anchor.z + head_d * 0.45),
		primary, 0.95
	)
	# Snout protrusion — short pug-like microbat muzzle (verify-agent fix:
	# previously fox/megabat-long; shortened by ~35% with bigger nose pad).
	_build_box(
		root,
		Vector3(-head_w * 0.55, head_y_bot + h * 0.005,
			head_anchor.z + head_d * 0.42),
		Vector3(head_w * 0.55, head_y_top - h * 0.03,
			head_anchor.z + head_d * 0.58),
		primary, 0.95
	)
	# Nose-pad (dark, prominent — microbat noseleaf)
	_build_box(
		root,
		Vector3(-head_w * 0.32, head_y_bot + h * 0.04,
			head_anchor.z + head_d * 0.53),
		Vector3(head_w * 0.32, head_y_top - h * 0.02,
			head_anchor.z + head_d * 0.60),
		Color(0.05, 0.04, 0.04), 0.65
	)
	# Eyes — small beady black
	for side in [-1, 1]:
		_build_box(
			root,
			Vector3(side * head_w * 0.55 - w * 0.040,
				head_center_y + h * 0.005, head_anchor.z + head_d * 0.30),
			Vector3(side * head_w * 0.55 + w * 0.040,
				head_center_y + h * 0.045, head_anchor.z + head_d * 0.42),
			eye_color, 0.20
		)
	# Mouth (small fanged underside)
	var jaw_y_top: float = head_y_bot - h * 0.005
	var jaw_y_bot: float = jaw_y_top - h * 0.06
	_build_box(
		root,
		Vector3(-head_w * 0.45, jaw_y_bot,
			head_anchor.z + head_d * 0.42),
		Vector3(head_w * 0.45, jaw_y_top,
			head_anchor.z + head_d * 0.68),
		fur_dark, 0.95
	)
	# 2 tiny upper fangs (anchored to the shorter snout)
	for side in [-1, 1]:
		var fx_c: float = side * head_w * 0.30
		_build_tapered_segment(root,
			Vector3(fx_c, jaw_y_top, head_anchor.z + head_d * 0.45), w * 0.020,
			Vector3(fx_c, jaw_y_top - h * 0.05, head_anchor.z + head_d * 0.48),
			w * 0.005,
			fang_color, 0.45)

	# LARGE POINTED EARS — signature feature, scale with ear_size_jitter
	for side in [-1, 1]:
		var ear_base := Vector3(side * head_w * 0.70,
			head_y_top - h * 0.005,
			head_anchor.z + head_d * 0.05)
		var ear_tip := Vector3(side * head_w * 1.20,
			head_y_top + h * (0.40 * ear_size_jitter),
			head_anchor.z + head_d * 0.0)
		_build_tapered_segment(root, ear_base, w * 0.10, ear_tip, w * 0.010,
			primary, 0.95)
		# Inner ear (pinker)
		_build_tapered_segment(root,
			ear_base + Vector3(0, h * 0.01, d * 0.01), w * 0.06,
			ear_tip + Vector3(0, -h * 0.02, 0), w * 0.006,
			membrane_color.lightened(0.10), 0.85)
		# Tragus (small inner cartilage flap)
		_build_tapered_segment(root,
			ear_base + Vector3(side * w * 0.02, h * 0.01, d * 0.02), w * 0.030,
			ear_base + Vector3(side * w * 0.04, h * 0.08, d * 0.01), w * 0.008,
			fur_dark, 0.95)

	# ============================================================================
	# WINGS — LARGE leathery wings spread outward, each with 4 finger struts
	# and a membrane. Wing span = ~3.5× body width.
	# ============================================================================
	for side in [-1, 1]:
		var wing_span: float = w * 4.0 * wing_span_jitter
		var wing_root := Vector3(side * w * 0.55, body_y + h * 0.10, 0.0)
		# Wing arm: shoulder → elbow → wrist (peak of the wing)
		var wing_elbow := Vector3(side * (w * 0.55 + wing_span * 0.40),
			body_y + h * 0.30, -d * 0.05)
		var wing_peak := Vector3(side * (w * 0.55 + wing_span * 0.85),
			body_y + h * 0.25, -d * 0.10)
		_build_tapered_segment(root, wing_root, w * 0.060, wing_elbow, w * 0.040,
			primary, 0.95)
		_build_tapered_segment(root, wing_elbow, w * 0.040, wing_peak, w * 0.025,
			primary, 0.95)
		# THUMB CLAW at the wing peak (signature hooked claw)
		_build_tapered_segment(root, wing_peak, w * 0.020,
			wing_peak + Vector3(side * w * 0.06, h * 0.05, d * 0.04),
			w * 0.005,
			claw_color, 0.40)
		# 4 FINGER STRUTS radiating from the peak to the trailing edge
		var trailing_points: Array = []
		var struts := 4
		for fi in range(struts):
			var ft: float = float(fi) / float(struts - 1)
			# Trailing-edge point: from chest behind body to wing-peak rear
			var trail := Vector3(
				lerpf(side * w * 0.40, side * (w * 0.55 + wing_span * 0.85), ft),
				body_y + h * 0.05 - h * lerpf(0.10, 0.05, ft),
				lerpf(-d * 0.30, -d * 0.15, ft)
			)
			trailing_points.append(trail)
			# Finger strut from peak to trailing point
			_build_tapered_segment(root, wing_peak, w * 0.020,
				trail, w * 0.005,
				primary, 0.95)
		# MEMBRANE — built as wedge between wing arm + trailing edge,
		# split into 3 panels for the 4 finger struts.
		var st_mem := SurfaceTool.new()
		st_mem.begin(Mesh.PRIMITIVE_TRIANGLES)
		# Inner panel: shoulder→elbow→trail[0]→trail-inner
		_add_quad(st_mem, wing_root, wing_elbow,
			trailing_points[1] as Vector3, trailing_points[0] as Vector3)
		# Mid panel: elbow→peak→trail[2]→trail[1]
		_add_quad(st_mem, wing_elbow, wing_peak,
			trailing_points[2] as Vector3, trailing_points[1] as Vector3)
		# Outer panel: peak→trail[3]→trail[2]
		_add_tri(st_mem, wing_peak,
			trailing_points[3] as Vector3, trailing_points[2] as Vector3)
		st_mem.generate_normals()
		var mi_mem := MeshInstance3D.new()
		mi_mem.mesh = st_mem.commit()
		var mat_mem := StandardMaterial3D.new()
		mat_mem.albedo_color = membrane_color
		mat_mem.roughness = 0.70
		mat_mem.cull_mode = BaseMaterial3D.CULL_DISABLED
		mi_mem.material_override = mat_mem
		root.add_child(mi_mem)

		# UROPATAGIUM — membrane bridging the innermost finger strut down to
		# the hind-leg ankle on this side. Verify-agent: the highest-impact
		# silhouette cue I was missing.
		var foot_ankle := Vector3(side * w * 0.18,
			body_y - h * 0.30, -d * 0.12)
		var inner_strut: Vector3 = trailing_points[0] as Vector3
		# Two anchor points: from the body's rear (matches the trunk side) +
		# inner strut, connecting down to the ankle.
		var body_rear := Vector3(side * w * 0.30, body_y - h * 0.05, -d * 0.20)
		var st_uro := SurfaceTool.new()
		st_uro.begin(Mesh.PRIMITIVE_TRIANGLES)
		_add_quad(st_uro, body_rear, inner_strut, foot_ankle, foot_ankle)
		_add_tri(st_uro, body_rear, foot_ankle, inner_strut)
		st_uro.generate_normals()
		var mi_uro := MeshInstance3D.new()
		mi_uro.mesh = st_uro.commit()
		var mat_uro := StandardMaterial3D.new()
		mat_uro.albedo_color = membrane_color
		mat_uro.roughness = 0.70
		mat_uro.cull_mode = BaseMaterial3D.CULL_DISABLED
		mi_uro.material_override = mat_uro
		root.add_child(mi_uro)

	# ============================================================================
	# FEET — tiny clawed hind legs (used for hanging upside-down)
	# ============================================================================
	for side in [-1, 1]:
		var hip := Vector3(side * w * 0.18, body_y - h * 0.18, -d * 0.10)
		var ankle := Vector3(side * w * 0.18, body_y - h * 0.30, -d * 0.12)
		_build_tapered_segment(root, hip, w * 0.05, ankle, w * 0.04,
			fur_dark, 0.95)
		# Tiny foot with 3 hooked claws
		for ci in range(3):
			var co: float = (float(ci) - 1.0) * w * 0.03
			var claw_tip := ankle + Vector3(co, -h * 0.05, -d * 0.02)
			_build_tapered_segment(root,
				ankle + Vector3(co * 0.5, 0, 0), w * 0.012,
				claw_tip, w * 0.003,
				claw_color, 0.40)


# ============================================================================
# BEHIR (behir) — Twelve-legged lightning-spitting serpent-dragon
#   - LONG SERPENTINE BLUE-SCALED body (no wings — NOT a dragon)
#   - 12 SHORT REPTILIAN LEGS (6 pairs along the body) — signature anatomy
#   - Crocodilian/draconic head with row of horns running back from skull
#   - Lightning breath (built-in crackling tongues from the maw)
#   - Long tail tapering to fine point
#   - Distinctive deep-blue scales with purple/indigo undertones
# ============================================================================

static func _build_behir(plan: Dictionary, root: Node3D) -> void:
	var base: Dictionary = plan.get("base", {})
	var palette: Dictionary = plan.get("palette", {})
	var limbs: Dictionary = plan.get("limbs", {})
	var meta: Dictionary = plan.get("meta", {})
	var species: String = String(meta.get("species", "Behir"))

	# Behir is a LONG laterally-narrow serpentine creature.
	# Verify-agent fix: cross-section was too circular-square; now tall &
	# narrow like a snake (h>w).
	var w: float = _axis(base, "width", 0.60)
	var h: float = _axis(base, "height", 0.85)
	var d: float = _axis(base, "depth", 3.40)
	var leg_length: float = float(limbs.get("leg_length", 0.30))
	var clearance: float = leg_length

	var render_seed: int = int(meta.get("render_seed", 0))
	var rng := RandomNumberGenerator.new()
	rng.seed = render_seed if render_seed != 0 else hash(species)

	# Per-individual jitter
	var size_jitter: float = rng.randf_range(0.92, 1.15)
	var horn_count_jitter: int = rng.randi_range(2, 3)       # canon: 2-3 skull horns
	var lightning_count_jitter: int = rng.randi_range(0, 3)  # 0-3 lightning licks
	w *= size_jitter
	h *= size_jitter
	d *= size_jitter
	leg_length *= rng.randf_range(0.90, 1.10)
	clearance = leg_length

	# Scale palette — canon DEEP BLUE with indigo/purple shifts
	var scale_options := [
		Color(0.10, 0.25, 0.55),     # deep azure (canon)
		Color(0.08, 0.18, 0.42),     # midnight blue
		Color(0.18, 0.20, 0.55),     # indigo
		Color(0.12, 0.30, 0.50),     # steel blue
	]
	var primary: Color = scale_options[rng.randi() % scale_options.size()]
	var scale_dark: Color = primary.darkened(0.40)
	var belly_color: Color = Color(0.15, 0.15, 0.32)
	var horn_color := Color(0.12, 0.10, 0.18)
	var claw_color := Color(0.08, 0.07, 0.10)
	var eye_glow := Color(0.95, 0.95, 0.55)   # pale yellow
	# Lightning palette
	var lightning_outer := Color(0.55, 0.75, 1.0)
	var lightning_core := Color(0.95, 0.95, 1.0)

	# ============================================================================
	# BODY — long serpentine trunk built via _swept_body with many sections
	# for the curving snake-like shape (subtle S-curve via x offsets).
	# ============================================================================
	var body_y: float = clearance + h * 0.20
	# Subtle wave through the body for that serpentine read
	var body_sections: Array = [
		{"center": Vector3(0, body_y - h * 0.05, -d * 0.48), "w": w * 0.16, "h": h * 0.18},  # tail base
		{"center": Vector3(-w * 0.05, body_y, -d * 0.35), "w": w * 0.30, "h": h * 0.30},     # post-hip
		{"center": Vector3(-w * 0.08, body_y + h * 0.02, -d * 0.20), "w": w * 0.40, "h": h * 0.40},
		{"center": Vector3(-w * 0.05, body_y + h * 0.03, -d * 0.05), "w": w * 0.46, "h": h * 0.44},
		{"center": Vector3(0, body_y + h * 0.05, d * 0.10), "w": w * 0.46, "h": h * 0.44},  # widest mid
		{"center": Vector3(w * 0.05, body_y + h * 0.05, d * 0.25), "w": w * 0.42, "h": h * 0.42},
		{"center": Vector3(w * 0.08, body_y + h * 0.08, d * 0.40), "w": w * 0.34, "h": h * 0.36},  # chest
		{"center": Vector3(0, body_y + h * 0.12, d * 0.50), "w": w * 0.24, "h": h * 0.28},        # neck base
	]
	_swept_body(root, body_sections, 10, primary, belly_color, 0.95, true)

	# ============================================================================
	# HEAD — crocodilian/draconic
	# ============================================================================
	var neck_base := (body_sections[7]["center"] as Vector3)
	# Lift head + push forward
	var neck_mid := Vector3(0, neck_base.y + h * 0.10, neck_base.z + d * 0.10)
	var head_anchor := Vector3(0, neck_base.y + h * 0.15, neck_base.z + d * 0.22)
	_build_tapered_segment(root, neck_base, w * 0.20, neck_mid, w * 0.18, primary, 0.95)
	_build_tapered_segment(root, neck_mid, w * 0.18, head_anchor, w * 0.20, primary, 0.95)

	var skull_w: float = w * 0.28
	var skull_h: float = h * 0.28
	var skull_d: float = d * 0.18
	var skull_y_bot: float = head_anchor.y - skull_h * 0.40
	var skull_y_top: float = skull_y_bot + skull_h
	var skull_center_y: float = (skull_y_bot + skull_y_top) * 0.5
	# Skull
	_build_box(
		root,
		Vector3(-skull_w, skull_y_bot, head_anchor.z - skull_d * 0.50),
		Vector3(skull_w, skull_y_top, head_anchor.z + skull_d * 0.30),
		primary, 0.95
	)
	# Snout — long crocodilian
	_build_box(
		root,
		Vector3(-skull_w * 0.75, skull_y_bot + h * 0.01,
			head_anchor.z + skull_d * 0.30 - d * 0.005),
		Vector3(skull_w * 0.75, skull_y_top - h * 0.04,
			head_anchor.z + skull_d * 1.30),
		primary, 0.95
	)
	# Nostril dimples (paired, top of snout)
	for side in [-1, 1]:
		_build_box(
			root,
			Vector3(side * skull_w * 0.30 - w * 0.020,
				skull_y_top - h * 0.07, head_anchor.z + skull_d * 1.20),
			Vector3(side * skull_w * 0.30 + w * 0.020,
				skull_y_top - h * 0.045, head_anchor.z + skull_d * 1.28),
			scale_dark, 0.95
		)
	# Heavy brow
	_build_box(
		root,
		Vector3(-skull_w * 1.04, skull_center_y + h * 0.03,
			head_anchor.z - skull_d * 0.30),
		Vector3(skull_w * 1.04, skull_center_y + h * 0.07,
			head_anchor.z + skull_d * 0.30),
		scale_dark, 0.95
	)
	# Pale yellow eyes
	for side in [-1, 1]:
		_build_box(
			root,
			Vector3(side * skull_w * 0.55 - w * 0.05,
				skull_center_y - h * 0.005, head_anchor.z + skull_d * 0.05),
			Vector3(side * skull_w * 0.55 + w * 0.05,
				skull_center_y + h * 0.035, head_anchor.z + skull_d * 0.25),
			eye_glow, 0.10, 0.0
		)
		# Slit pupil (reptilian)
		_build_box(
			root,
			Vector3(side * skull_w * 0.55 - w * 0.008,
				skull_center_y, head_anchor.z + skull_d * 0.20),
			Vector3(side * skull_w * 0.55 + w * 0.008,
				skull_center_y + h * 0.030, head_anchor.z + skull_d * 0.25),
			Color(0.05, 0.04, 0.0), 0.30
		)

	# JAW with crocodilian tooth rows
	var jaw_y_top: float = skull_y_bot + h * 0.03
	var jaw_y_bot: float = skull_y_bot - h * 0.05
	_build_box(
		root,
		Vector3(-skull_w * 0.70, jaw_y_bot,
			head_anchor.z + skull_d * 0.10),
		Vector3(skull_w * 0.70, jaw_y_top,
			head_anchor.z + skull_d * 1.25),
		scale_dark, 0.95
	)
	# Inner mouth dark (lightning glows inside)
	_build_box(
		root,
		Vector3(-skull_w * 0.55, jaw_y_bot + h * 0.005,
			head_anchor.z + skull_d * 0.20),
		Vector3(skull_w * 0.55, jaw_y_top - h * 0.005,
			head_anchor.z + skull_d * 1.18),
		Color(0.05, 0.03, 0.10), 0.85
	)
	# Tooth row — 6 along each side of the upper jaw
	for ti in range(6):
		var tt: float = float(ti) / 5.0
		var tx_pos: float = lerpf(skull_w * 0.10, skull_w * 0.65, tt)
		var tooth_h: float = h * (0.045 if (ti == 0 or ti == 5) else 0.03)
		for side in [-1, 1]:
			_build_tapered_segment(root,
				Vector3(side * tx_pos, jaw_y_top, head_anchor.z + skull_d * lerpf(0.35, 1.10, tt)),
				w * 0.010,
				Vector3(side * tx_pos, jaw_y_top - tooth_h,
					head_anchor.z + skull_d * lerpf(0.35, 1.10, tt)),
				w * 0.003,
				Color(0.92, 0.88, 0.75), 0.45)

	# ============================================================================
	# SKULL HORNS — canon Behir has a single pair of LARGE curved horns +
	# optionally a third smaller central crown horn. Verify-agent fix:
	# previous 7-10 horn dorsal mohawk was non-canon and pushed the silhouette
	# toward chromatic-dragon territory.
	# ============================================================================
	# Primary pair — large backward-sweeping horns from the temples
	for side in [-1, 1]:
		var horn_base := Vector3(side * skull_w * 0.85,
			skull_y_top - h * 0.005,
			head_anchor.z - skull_d * 0.05)
		var horn_mid := Vector3(side * skull_w * 1.10,
			skull_y_top + h * 0.18,
			head_anchor.z - skull_d * 0.30)
		var horn_tip := Vector3(side * skull_w * 1.05,
			skull_y_top + h * 0.22,
			head_anchor.z - skull_d * 0.70)
		_build_tapered_segment(root, horn_base, w * 0.060, horn_mid, w * 0.030,
			horn_color, 0.55)
		_build_tapered_segment(root, horn_mid, w * 0.030, horn_tip, w * 0.006,
			horn_color.darkened(0.15), 0.55)
	# Optional 3rd central crown horn (when jitter == 3)
	if horn_count_jitter >= 3:
		_build_tapered_segment(root,
			Vector3(0, skull_y_top, head_anchor.z - skull_d * 0.10), w * 0.045,
			Vector3(0, skull_y_top + h * 0.20, head_anchor.z - skull_d * 0.30),
			w * 0.008,
			horn_color, 0.55)

	# ============================================================================
	# LIGHTNING BREATH — 0-3 crackling tongues escaping the maw
	# ============================================================================
	for li in range(lightning_count_jitter):
		var fork_dir_x: float = rng.randf_range(-0.10, 0.10)
		var fork_dir_y: float = rng.randf_range(-0.05, 0.10)
		var l_base := Vector3(rng.randf_range(-skull_w * 0.25, skull_w * 0.25),
			skull_center_y - h * 0.005, head_anchor.z + skull_d * 1.20)
		var l_mid := Vector3(l_base.x + fork_dir_x * d * 0.15,
			l_base.y + fork_dir_y * h * 0.20,
			l_base.z + d * 0.15)
		var l_tip := Vector3(l_mid.x + rng.randf_range(-w * 0.20, w * 0.20),
			l_mid.y + rng.randf_range(-h * 0.10, h * 0.20),
			l_mid.z + d * rng.randf_range(0.10, 0.30))
		# Outer bolt
		_build_tapered_segment(root, l_base, w * 0.035, l_mid, w * 0.022,
			lightning_outer, 0.05, 0.0)
		_build_tapered_segment(root, l_mid, w * 0.022, l_tip, w * 0.008,
			lightning_outer, 0.05, 0.0)
		# Inner core
		_build_tapered_segment(root, l_base, w * 0.015, l_mid, w * 0.010,
			lightning_core, 0.05, 0.0)
		_build_tapered_segment(root, l_mid, w * 0.010, l_tip, w * 0.003,
			lightning_core, 0.05, 0.0)

	# ============================================================================
	# TWELVE LEGS — 6 pairs spaced along the body (signature anatomy)
	# z-positions distributed along the trunk from chest to tail base.
	# ============================================================================
	var leg_z_positions: Array = [d * 0.35, d * 0.20, d * 0.05,
								  -d * 0.10, -d * 0.25, -d * 0.38]
	for pair_idx in range(6):
		var lz: float = leg_z_positions[pair_idx] as float
		# Body radius at this z — sample from sections (approximate)
		var body_t: float = 1.0 - clamp((lz + d * 0.48) / d, 0.0, 1.0)
		# Outer pairs (first + last) slightly larger, mid pairs smaller
		var pos_factor: float = 1.0 - abs(pair_idx - 2.5) * 0.04
		var leg_scale: float = lerpf(0.90, 1.05, pos_factor)
		for side in [-1, 1]:
			var lhip := Vector3(side * w * 0.36, body_y - h * 0.10, lz)
			# Splayed lizard knee
			var lknee := Vector3(side * w * 0.50,
				clearance * 0.45 * leg_scale, lz + d * 0.03)
			var lankle := Vector3(side * w * 0.48,
				clearance * 0.15, lz - d * 0.02)
			var lfoot := Vector3(side * w * 0.48, 0.03, lz)
			# Thigh + shin
			_build_tapered_segment(root, lhip, w * 0.075 * leg_scale,
				lknee, w * 0.055 * leg_scale, primary, 0.95)
			_build_tapered_segment(root, lknee, w * 0.055 * leg_scale,
				lankle, w * 0.045 * leg_scale, primary, 0.95)
			_build_tapered_segment(root, lankle, w * 0.045 * leg_scale,
				lfoot, w * 0.045 * leg_scale, scale_dark, 0.95)
			# Foot pad
			_build_box(
				root,
				Vector3(side * w * 0.48 - w * 0.055, 0.0, lz - d * 0.04),
				Vector3(side * w * 0.48 + w * 0.055, h * 0.04, lz + d * 0.05),
				scale_dark, 0.95
			)
			# 3 clawed toes (splayed outward)
			for ci in range(3):
				var co: float = (float(ci) - 1.0) * w * 0.035
				var lateral_factor: float = float(ci) - 1.0
				var lateral_x: float = side * lateral_factor * w * 0.025
				_build_tapered_segment(root,
					Vector3(side * w * 0.48 + co, h * 0.02, lz + d * 0.05),
					w * 0.011,
					Vector3(side * w * 0.48 + co + lateral_x, 0.0,
						lz + d * (0.10 - abs(lateral_factor) * 0.02)),
					w * 0.003,
					claw_color, 0.40)

	# ============================================================================
	# TAIL — LONG tapering serpent tail (~canon ratio: tail ≈ trunk length).
	# Verify-agent fix: previous tail was only 31% of trunk; canon is closer
	# to 90-100%, giving the full 40-ft canon behir length.
	# Tail crest removed entirely (also non-canon).
	# ============================================================================
	var tail_base := Vector3(0, body_y - h * 0.05, -d * 0.48)
	var tail_q1 := Vector3(rng.randf_range(-w * 0.10, w * 0.10),
		body_y - h * 0.08, -d * 1.10)
	var tail_q2 := Vector3(rng.randf_range(-w * 0.25, w * 0.25),
		body_y - h * 0.14, -d * 1.80)
	var tail_q3 := Vector3(rng.randf_range(-w * 0.45, w * 0.45),
		body_y - h * 0.22, -d * 2.50)
	var tail_tip := Vector3(rng.randf_range(-w * 0.60, w * 0.60),
		body_y - h * 0.30, -d * 3.10)
	_build_tapered_segment(root, tail_base, w * 0.16, tail_q1, w * 0.12,
		primary, 0.95)
	_build_tapered_segment(root, tail_q1, w * 0.12, tail_q2, w * 0.07,
		primary, 0.95)
	_build_tapered_segment(root, tail_q2, w * 0.07, tail_q3, w * 0.035,
		scale_dark, 0.95)
	_build_tapered_segment(root, tail_q3, w * 0.035, tail_tip, w * 0.008,
		scale_dark, 0.95)


# ============================================================================
# BERSERKER (berserker) — Human barbarian warrior (D&D MM)
#   - Stocky muscular human male (or rarely female via jitter)
#   - Bare chest with leather straps + fur shoulder mantle
#   - WILD UNKEMPT HAIR (long, often braided) + heavy beard (males)
#   - WAR PAINT stripes on the face/torso (signature)
#   - Two-handed GREATAXE held ready (signature weapon)
#   - Leather kilt + fur-trimmed boots
#   - Bracers on forearms
# ============================================================================

static func _build_berserker(plan: Dictionary, root: Node3D) -> void:
	var base: Dictionary = plan.get("base", {})
	var palette: Dictionary = plan.get("palette", {})
	var limbs: Dictionary = plan.get("limbs", {})
	var meta: Dictionary = plan.get("meta", {})
	var species: String = String(meta.get("species", "Berserker"))

	# Stocky muscular humanoid
	var w: float = _axis(base, "width", 0.65)
	var h: float = _axis(base, "height", 1.85)
	var d: float = _axis(base, "depth", 0.45)
	var leg_length: float = float(limbs.get("leg_length", 0.95))
	var clearance: float = leg_length

	var render_seed: int = int(meta.get("render_seed", 0))
	var rng := RandomNumberGenerator.new()
	rng.seed = render_seed if render_seed != 0 else hash(species)

	# Per-individual variation
	var size_jitter: float = rng.randf_range(0.92, 1.12)
	var is_male: bool = rng.randf() < 0.80
	var has_beard: bool = is_male and rng.randf() < 0.85
	var hair_length_jitter: float = rng.randf_range(0.7, 1.4)
	var paint_count_jitter: int = rng.randi_range(2, 5)
	w *= size_jitter
	h *= size_jitter
	d *= size_jitter
	leg_length *= rng.randf_range(0.95, 1.10)
	clearance = leg_length

	# Skin tone palette — varied human ethnicities
	var skin_options := [
		Color(0.92, 0.74, 0.58),     # light tan
		Color(0.78, 0.58, 0.44),     # ruddy
		Color(0.62, 0.46, 0.34),     # olive
		Color(0.48, 0.34, 0.24),     # bronze
		Color(0.32, 0.22, 0.18),     # dark brown
	]
	var skin: Color = skin_options[rng.randi() % skin_options.size()]
	var skin_dark: Color = skin.darkened(0.20)
	# Hair palette — barbarian / nordic / wild colors
	var hair_options := [
		Color(0.85, 0.70, 0.35),     # dirty blonde
		Color(0.45, 0.20, 0.10),     # chestnut
		Color(0.65, 0.30, 0.10),     # red
		Color(0.18, 0.10, 0.06),     # black
		Color(0.85, 0.78, 0.68),     # white/grey (old warrior)
	]
	var hair: Color = hair_options[rng.randi() % hair_options.size()]
	# Fur cloak palette
	var fur_options := [
		Color(0.55, 0.42, 0.30),     # wolf brown
		Color(0.85, 0.82, 0.78),     # white wolf
		Color(0.30, 0.22, 0.18),     # black bear
		Color(0.42, 0.35, 0.25),     # bear brown
	]
	var fur: Color = fur_options[rng.randi() % fur_options.size()]
	var fur_dark: Color = fur.darkened(0.20)
	# War paint — blue or red or black
	var paint_options := [
		Color(0.10, 0.20, 0.55),     # woad blue
		Color(0.62, 0.12, 0.08),     # blood red
		Color(0.06, 0.06, 0.06),     # soot black
		Color(0.55, 0.42, 0.05),     # mud yellow
	]
	var paint: Color = paint_options[rng.randi() % paint_options.size()]
	# Leather, metal
	var leather := Color(0.32, 0.18, 0.10)
	var leather_dark := Color(0.20, 0.12, 0.07)
	var iron := Color(0.40, 0.42, 0.42)
	var iron_dark := Color(0.20, 0.20, 0.22)
	var wood := Color(0.42, 0.28, 0.16)
	var eye_color := Color(0.10, 0.20, 0.30)

	# ============================================================================
	# TORSO — bare-chested, broad shoulders, defined chest
	# ============================================================================
	var hip_y: float = clearance
	var waist_y: float = clearance + h * 0.12
	var chest_y: float = clearance + h * 0.30
	var shoulder_y: float = clearance + h * 0.44
	# Waist
	_build_box(
		root,
		Vector3(-w * 0.30, hip_y, -d * 0.25),
		Vector3(w * 0.30, waist_y, d * 0.25),
		skin, 0.60
	)
	# Abs (mid torso)
	_build_box(
		root,
		Vector3(-w * 0.35, waist_y, -d * 0.27),
		Vector3(w * 0.35, chest_y, d * 0.30),
		skin, 0.60
	)
	# Chest (broad pecs)
	_build_box(
		root,
		Vector3(-w * 0.48, chest_y, -d * 0.30),
		Vector3(w * 0.48, shoulder_y, d * 0.34),
		skin, 0.60
	)
	# Sternum line (slight shadow down chest)
	_build_box(
		root,
		Vector3(-w * 0.012, chest_y + h * 0.005, d * 0.34),
		Vector3(w * 0.012, shoulder_y - h * 0.005, d * 0.36),
		skin_dark, 0.65
	)
	# Ab lines — 3 horizontal grooves
	for ai in range(3):
		var ay: float = lerpf(waist_y + h * 0.01, chest_y - h * 0.02, float(ai) / 2.0)
		_build_box(
			root,
			Vector3(-w * 0.28, ay - h * 0.004, d * 0.28),
			Vector3(w * 0.28, ay + h * 0.004, d * 0.31),
			skin_dark, 0.65
		)

	# ============================================================================
	# LEATHER KILT — Norse-style wider flaps (not Roman pteruges).
	# Verify-agent fix: 7-plate ring read as Roman legionary; now 4 wider
	# flaps positioned front/back/sides for the proper barbarian wrap.
	# ============================================================================
	var kilt_y_top: float = waist_y
	var kilt_y_bot: float = clearance + h * 0.01
	# 4 wider flaps at cardinal positions
	var kilt_positions: Array = [
		Vector3(0, 0, d * 0.30),       # front
		Vector3(0, 0, -d * 0.30),      # back
		Vector3(-w * 0.34, 0, 0),      # left
		Vector3(w * 0.34, 0, 0),       # right
	]
	for kpos in kilt_positions:
		var kp: Vector3 = kpos as Vector3
		# Widen each flap ~40% on the appropriate axis
		var is_side: bool = abs(kp.x) > 0.01
		var half_w: float = (w * 0.06 if is_side else w * 0.18)
		var half_d: float = (d * 0.10 if is_side else d * 0.06)
		_build_box(
			root,
			Vector3(kp.x - half_w, kilt_y_bot, kp.z - half_d),
			Vector3(kp.x + half_w, kilt_y_top, kp.z + half_d),
			leather, 0.85
		)
	# Belt (wide leather)
	_build_box(
		root,
		Vector3(-w * 0.40, waist_y - h * 0.025, -d * 0.30),
		Vector3(w * 0.40, waist_y + h * 0.015, d * 0.32),
		leather_dark, 0.80
	)
	# Belt buckle (iron)
	_build_box(
		root,
		Vector3(-w * 0.06, waist_y - h * 0.03, d * 0.30),
		Vector3(w * 0.06, waist_y + h * 0.02, d * 0.36),
		iron, 0.40, 0.70
	)

	# ============================================================================
	# FUR SHOULDER MANTLE — short fur cape over the shoulders
	# ============================================================================
	# Main mantle band
	_build_box(
		root,
		Vector3(-w * 0.55, shoulder_y - h * 0.02, -d * 0.34),
		Vector3(w * 0.55, shoulder_y + h * 0.10, d * 0.36),
		fur, 0.95
	)
	# Mantle hangs slightly past shoulders down the back
	_build_box(
		root,
		Vector3(-w * 0.42, chest_y, -d * 0.36),
		Vector3(w * 0.42, shoulder_y, -d * 0.30),
		fur, 0.95
	)
	# Fur tufts radiating from the mantle edge
	for ti in range(10):
		var ang: float = (float(ti) / 10.0) * TAU - PI * 0.5  # bottom half-ring
		if sin(ang) > 0.20: continue   # only on back/sides
		var tx: float = cos(ang) * w * 0.50
		var tz: float = sin(ang) * d * 0.36
		_build_tapered_segment(root,
			Vector3(tx, shoulder_y, tz), w * 0.04,
			Vector3(tx * 1.10, shoulder_y - h * 0.06,
				tz * 1.20), w * 0.008,
			fur_dark, 0.95)

	# Crossed leather straps over chest
	_build_box(
		root,
		Vector3(-w * 0.40, chest_y - h * 0.02, d * 0.32),
		Vector3(w * 0.40, chest_y + h * 0.02, d * 0.36),
		leather, 0.80
	)

	# ============================================================================
	# HEAD — human with hair, beard, war paint
	# ============================================================================
	# Neck
	var neck_top := Vector3(0, shoulder_y + h * 0.04, d * 0.04)
	_build_tapered_segment(root,
		Vector3(0, shoulder_y - h * 0.01, 0.0), w * 0.13,
		neck_top, w * 0.11,
		skin, 0.60)

	var head_w: float = w * 0.28
	var head_h: float = h * 0.18
	var head_d: float = d * 0.55
	var head_y_bot: float = neck_top.y
	var head_y_top: float = head_y_bot + head_h
	var head_center_y: float = (head_y_bot + head_y_top) * 0.5
	_build_box(
		root,
		Vector3(-head_w, head_y_bot, neck_top.z - head_d * 0.40),
		Vector3(head_w, head_y_top, neck_top.z + head_d * 0.45),
		skin, 0.60
	)

	# Eyes
	for side in [-1, 1]:
		_build_box(
			root,
			Vector3(side * head_w * 0.50 - w * 0.045,
				head_center_y, neck_top.z + head_d * 0.40),
			Vector3(side * head_w * 0.50 + w * 0.045,
				head_center_y + h * 0.022, neck_top.z + head_d * 0.46),
			Color(0.95, 0.92, 0.85), 0.40
		)
		# Iris
		_build_box(
			root,
			Vector3(side * head_w * 0.50 - w * 0.018,
				head_center_y + h * 0.003, neck_top.z + head_d * 0.43),
			Vector3(side * head_w * 0.50 + w * 0.018,
				head_center_y + h * 0.020, neck_top.z + head_d * 0.46),
			eye_color, 0.30
		)
	# Nose
	_build_box(
		root,
		Vector3(-w * 0.04, head_center_y - h * 0.02,
			neck_top.z + head_d * 0.40),
		Vector3(w * 0.04, head_center_y + h * 0.005,
			neck_top.z + head_d * 0.50),
		skin, 0.60
	)
	# Mouth slit (snarling — wider for berserker fury)
	_build_box(
		root,
		Vector3(-head_w * 0.30, head_y_bot + h * 0.025,
			neck_top.z + head_d * 0.43),
		Vector3(head_w * 0.30, head_y_bot + h * 0.045,
			neck_top.z + head_d * 0.46),
		Color(0.25, 0.10, 0.08), 0.85
	)
	# Bared upper teeth — 4
	for ti in range(4):
		var tx: float = lerpf(-head_w * 0.25, head_w * 0.25, float(ti) / 3.0)
		_build_box(
			root,
			Vector3(tx - w * 0.012, head_y_bot + h * 0.030,
				neck_top.z + head_d * 0.45),
			Vector3(tx + w * 0.012, head_y_bot + h * 0.045,
				neck_top.z + head_d * 0.46),
			Color(0.92, 0.88, 0.78), 0.45
		)

	# WAR PAINT — 2-5 stripes across the face (and one on the torso)
	for pi in range(paint_count_jitter):
		var py: float = lerpf(head_center_y - h * 0.04, head_center_y + h * 0.06,
			float(pi) / max(1.0, float(paint_count_jitter - 1)))
		var p_offset_x: float = rng.randf_range(-w * 0.05, w * 0.05)
		var p_half_w: float = rng.randf_range(w * 0.10, w * 0.22)
		_build_box(
			root,
			Vector3(p_offset_x - p_half_w, py - h * 0.005,
				neck_top.z + head_d * 0.45),
			Vector3(p_offset_x + p_half_w, py + h * 0.005,
				neck_top.z + head_d * 0.47),
			paint, 0.65
		)
	# Bold chest paint stripe
	_build_box(
		root,
		Vector3(-w * 0.32, chest_y + h * 0.05, d * 0.34),
		Vector3(w * 0.32, chest_y + h * 0.10, d * 0.36),
		paint, 0.65
	)

	# ============================================================================
	# PELT HOOD — animal-head crown above the skull (the ULFHEÐNAR/BEAR-WARRIOR
	# look). Verify-agent: this was the SINGLE biggest miss; adding it now
	# sharpens identity dramatically. Same fur color as the shoulder mantle.
	# ============================================================================
	# Snout brim hanging over the brow (animal's open jaw)
	_build_box(
		root,
		Vector3(-head_w * 0.65, head_y_top - h * 0.005,
			neck_top.z + head_d * 0.25),
		Vector3(head_w * 0.65, head_y_top + h * 0.060,
			neck_top.z + head_d * 0.55),
		fur, 0.95
	)
	# Hood crown (caps the top + back of the skull)
	_build_box(
		root,
		Vector3(-head_w * 1.05, head_y_top - h * 0.005,
			neck_top.z - head_d * 0.45),
		Vector3(head_w * 1.05, head_y_top + h * 0.130,
			neck_top.z + head_d * 0.25),
		fur, 0.95
	)
	# Two small triangular ear nubs on top of the hood
	for hside in [-1, 1]:
		var ear_base := Vector3(hside * head_w * 0.55,
			head_y_top + h * 0.12, neck_top.z - head_d * 0.05)
		var ear_tip := Vector3(hside * head_w * 0.55,
			head_y_top + h * 0.22, neck_top.z - head_d * 0.05)
		_build_tapered_segment(root, ear_base, w * 0.04, ear_tip, w * 0.008,
			fur_dark, 0.95)
	# Two small dark "eyes" on the snout brim (decorative, the pelt's eyes)
	for sside in [-1, 1]:
		_build_box(
			root,
			Vector3(sside * head_w * 0.30 - w * 0.020,
				head_y_top + h * 0.015,
				neck_top.z + head_d * 0.40),
			Vector3(sside * head_w * 0.30 + w * 0.020,
				head_y_top + h * 0.040,
				neck_top.z + head_d * 0.46),
			Color(0.08, 0.06, 0.04), 0.55
		)

	# WILD HAIR — long unkempt strands flowing back from the head
	var hair_count: int = int(8.0 * hair_length_jitter)
	for hi in range(hair_count):
		var ang: float = (float(hi) / float(hair_count)) * TAU
		# Only place hair on the back/top hemisphere
		if cos(ang) > 0.8 and abs(sin(ang)) < 0.3:    # skip the front face center
			continue
		var hx_root: float = cos(ang) * head_w * 0.80
		var hz_root: float = sin(ang) * head_d * 0.30 - head_d * 0.05
		var root_pos := Vector3(hx_root, head_y_top - h * 0.015,
			neck_top.z + hz_root)
		var hair_len: float = h * rng.randf_range(0.18, 0.40) * hair_length_jitter
		var hair_tip := Vector3(hx_root * 1.30,
			head_y_top - hair_len * 0.7,
			neck_top.z + hz_root - head_d * 0.25)
		_build_tapered_segment(root, root_pos, w * 0.025, hair_tip, w * 0.005,
			hair if hi % 3 != 0 else hair.darkened(0.10), 0.85)

	# BEARD (if has_beard)
	if has_beard:
		# Beard body — fills the lower face/chin
		_build_box(
			root,
			Vector3(-head_w * 0.85, head_y_bot - h * 0.04,
				neck_top.z + head_d * 0.20),
			Vector3(head_w * 0.85, head_y_bot + h * 0.030,
				neck_top.z + head_d * 0.45),
			hair, 0.85
		)
		# Beard hangs below chin
		var beard_strands: int = rng.randi_range(4, 7)
		for bi in range(beard_strands):
			var bt: float = (float(bi) - (beard_strands - 1) * 0.5) / float(beard_strands)
			var bx_off: float = bt * head_w * 0.7
			var b_len: float = h * rng.randf_range(0.06, 0.18)
			_build_tapered_segment(root,
				Vector3(bx_off, head_y_bot - h * 0.03,
					neck_top.z + head_d * 0.35),
				w * 0.030,
				Vector3(bx_off * 1.05, head_y_bot - h * 0.03 - b_len,
					neck_top.z + head_d * 0.28),
				w * 0.005,
				hair, 0.85)

	# ============================================================================
	# ARMS — thick muscular, with bracers, holding a greataxe
	# ============================================================================
	# Right arm — gripping greataxe handle high
	var r_shoulder := Vector3(w * 0.48, shoulder_y - h * 0.02, 0.0)
	var r_elbow := Vector3(w * 0.62, shoulder_y - h * 0.22, d * 0.06)
	var r_wrist := Vector3(w * 0.55, shoulder_y - h * 0.05, d * 0.42)
	_build_tapered_segment(root, r_shoulder, w * 0.18, r_elbow, w * 0.13, skin, 0.60)
	_build_tapered_segment(root, r_elbow, w * 0.13, r_wrist, w * 0.10, skin, 0.60)
	# Right bracer
	_build_tapered_segment(root,
		r_elbow.lerp(r_wrist, 0.35), w * 0.135,
		r_elbow.lerp(r_wrist, 0.90), w * 0.105,
		leather_dark, 0.85)
	# Right hand grip
	_build_box(
		root,
		Vector3(r_wrist.x - w * 0.08, r_wrist.y - h * 0.05, r_wrist.z - d * 0.05),
		Vector3(r_wrist.x + w * 0.08, r_wrist.y + h * 0.01, r_wrist.z + d * 0.05),
		skin, 0.60
	)

	# Left arm — gripping greataxe handle lower
	var l_shoulder := Vector3(-w * 0.48, shoulder_y - h * 0.02, 0.0)
	var l_elbow := Vector3(-w * 0.55, shoulder_y - h * 0.30, d * 0.10)
	var l_wrist := Vector3(-w * 0.30, shoulder_y - h * 0.35, d * 0.50)
	_build_tapered_segment(root, l_shoulder, w * 0.18, l_elbow, w * 0.13, skin, 0.60)
	_build_tapered_segment(root, l_elbow, w * 0.13, l_wrist, w * 0.10, skin, 0.60)
	# Left bracer
	_build_tapered_segment(root,
		l_elbow.lerp(l_wrist, 0.35), w * 0.135,
		l_elbow.lerp(l_wrist, 0.90), w * 0.105,
		leather_dark, 0.85)
	# Left hand
	_build_box(
		root,
		Vector3(l_wrist.x - w * 0.08, l_wrist.y - h * 0.05, l_wrist.z - d * 0.05),
		Vector3(l_wrist.x + w * 0.08, l_wrist.y + h * 0.01, l_wrist.z + d * 0.05),
		skin, 0.60
	)

	# ============================================================================
	# GREATAXE — held mid-RAGE in a ready-to-swing pose at chest/waist height,
	# haft mostly horizontal angled head-up-right. Verify-agent fix: parade-
	# carry diagonal replaced with combat-ready stance.
	# Right hand grips high near the head; left hand low on the haft.
	# ============================================================================
	var axe_top := Vector3(w * 0.70, shoulder_y + h * 0.12, d * 0.45)
	var axe_bot := Vector3(-w * 0.50, shoulder_y - h * 0.30, d * 0.55)
	# Wooden haft
	_build_tapered_segment(root, axe_bot, w * 0.035, axe_top, w * 0.040, wood, 0.85)
	# Haft grip wrapping (darker leather binding mid-haft)
	var grip_a: Vector3 = axe_bot.lerp(axe_top, 0.45)
	var grip_b: Vector3 = axe_bot.lerp(axe_top, 0.75)
	_build_tapered_segment(root, grip_a, w * 0.045, grip_b, w * 0.045,
		leather_dark, 0.85)
	# AXE HEAD — large iron crescent blade at the top
	# Built as a wedge: spine box + crescent blade
	var head_back := Vector3(axe_top.x - w * 0.05, axe_top.y - h * 0.05, axe_top.z - d * 0.05)
	var head_front_top := axe_top + Vector3(w * 0.05, h * 0.10, d * 0.18)
	var head_front_bot := axe_top + Vector3(w * 0.05, -h * 0.12, d * 0.16)
	# Bulk of the head — wide blade box
	_build_box(
		root,
		Vector3(axe_top.x - w * 0.04, axe_top.y - h * 0.12, axe_top.z - d * 0.05),
		Vector3(axe_top.x + w * 0.04, axe_top.y + h * 0.12, axe_top.z + d * 0.18),
		iron, 0.30, 0.85
	)
	# Crescent blade edge — tapered front
	_build_tapered_segment(root, head_back, w * 0.05, head_front_top, w * 0.020,
		iron, 0.30, 0.85)
	_build_tapered_segment(root, head_back, w * 0.05, head_front_bot, w * 0.020,
		iron, 0.30, 0.85)
	# Cutting edge highlight (lighter strip along the curve)
	_build_tapered_segment(root, head_front_top, w * 0.010, head_front_bot, w * 0.010,
		iron.lightened(0.30), 0.20, 0.95)
	# Spike on top of the axe head
	_build_tapered_segment(root,
		axe_top + Vector3(0, h * 0.06, 0), w * 0.025,
		axe_top + Vector3(0, h * 0.18, 0), w * 0.005,
		iron_dark, 0.30, 0.85)
	# Pommel cap at the bottom of the haft
	_build_box(
		root,
		Vector3(axe_bot.x - w * 0.04, axe_bot.y - h * 0.03, axe_bot.z - d * 0.04),
		Vector3(axe_bot.x + w * 0.04, axe_bot.y + h * 0.01, axe_bot.z + d * 0.04),
		iron_dark, 0.40, 0.70
	)

	# ============================================================================
	# LEGS — thick muscular, with leather boots
	# ============================================================================
	for side in [-1, 1]:
		var hip := Vector3(side * w * 0.18, hip_y + h * 0.02, 0.0)
		var knee := Vector3(side * w * 0.20, clearance * 0.50, d * 0.04)
		var ankle := Vector3(side * w * 0.18, clearance * 0.15, -d * 0.02)
		_build_tapered_segment(root, hip, w * 0.18, knee, w * 0.14, skin, 0.60)
		_build_tapered_segment(root, knee, w * 0.14, ankle, w * 0.11, skin, 0.60)
		# FUR-TRIMMED BOOT
		_build_box(
			root,
			Vector3(side * w * 0.18 - w * 0.13, 0.0, -d * 0.10),
			Vector3(side * w * 0.18 + w * 0.13, h * 0.18, d * 0.20),
			leather, 0.80
		)
		# Fur boot trim at the top
		_build_box(
			root,
			Vector3(side * w * 0.18 - w * 0.15, h * 0.16, -d * 0.12),
			Vector3(side * w * 0.18 + w * 0.15, h * 0.22, d * 0.22),
			fur, 0.95
		)
		# Boot strap (wraps around shin a bit higher)
		_build_box(
			root,
			Vector3(side * w * 0.18 - w * 0.13, h * 0.26, -d * 0.10),
			Vector3(side * w * 0.18 + w * 0.13, h * 0.30, d * 0.20),
			leather_dark, 0.80
		)


# ============================================================================
# BLACK BEAR (black_bear) — Medium-sized American black bear
# Distinguished from Brown/Grizzly bear by:
#   - SMALLER body, ~80% of brown bear size
#   - NO SHOULDER HUMP (signature distinction — brown bears have prominent one)
#   - SHORTER ROUNDER MUZZLE
#   - FORWARD-FACING ROUNDED EARS (proportionally larger than brown bear)
#   - Often tan/cinnamon facial markings around the muzzle
#   - Black fur dominant, with cinnamon/brown phase variants
# ============================================================================

static func _build_black_bear(plan: Dictionary, root: Node3D) -> void:
	var base: Dictionary = plan.get("base", {})
	var palette: Dictionary = plan.get("palette", {})
	var limbs: Dictionary = plan.get("limbs", {})
	var meta: Dictionary = plan.get("meta", {})
	var species: String = String(meta.get("species", "Black Bear"))

	# Black bear: smaller than brown bear, shorter legs, no hump.
	# Verify-agent fix: flattened the stance with longer body (h/d ratio
	# was 0.61; canon average ~0.55 → more "doglike running" silhouette).
	var w: float = _axis(base, "width", 0.72)
	var h: float = _axis(base, "height", 0.88)
	var d: float = _axis(base, "depth", 1.65)
	var leg_length: float = float(limbs.get("leg_length", 0.45))
	var clearance: float = leg_length

	var render_seed: int = int(meta.get("render_seed", 0))
	var rng := RandomNumberGenerator.new()
	rng.seed = render_seed if render_seed != 0 else hash(species)

	# Per-individual variation
	var size_jitter: float = rng.randf_range(0.88, 1.15)
	w *= size_jitter
	h *= size_jitter
	d *= size_jitter
	leg_length *= rng.randf_range(0.92, 1.10)
	clearance = leg_length

	# Fur palette — canon American black bear coat phases:
	# Most are black, but ~30% are color-phased (cinnamon, brown, blonde).
	var coat_roll: float = rng.randf()
	var primary: Color
	var has_muzzle_tan: bool = true
	if coat_roll < 0.65:
		primary = Color(0.06, 0.05, 0.05)         # standard black
	elif coat_roll < 0.82:
		primary = Color(0.42, 0.25, 0.15)         # cinnamon
		has_muzzle_tan = rng.randf() < 0.4
	elif coat_roll < 0.95:
		primary = Color(0.30, 0.20, 0.14)         # chocolate brown
		has_muzzle_tan = rng.randf() < 0.5
	else:
		primary = Color(0.72, 0.58, 0.38)         # blonde/honey (rare Kermode-like)
		has_muzzle_tan = false
	var fur_dark: Color = primary.darkened(0.30)
	var belly_color: Color = primary.darkened(0.10)
	# Muzzle tan markings — distinctive color around the snout
	var muzzle_tan := Color(0.68, 0.50, 0.32)
	var claw_color := Color(0.08, 0.06, 0.04)
	var fang_color := Color(0.92, 0.88, 0.78)
	var eye_color := Color(0.18, 0.12, 0.08)

	# White V-chest blaze probability per coat phase (~25% on dark phases,
	# lower on cinnamon, none on blonde). Canonical Ursus americanus marker.
	var blaze_chance: float
	if coat_roll < 0.65:
		blaze_chance = 0.25     # standard black
	elif coat_roll < 0.82:
		blaze_chance = 0.10     # cinnamon
	elif coat_roll < 0.95:
		blaze_chance = 0.20     # chocolate
	else:
		blaze_chance = 0.0      # blonde — none
	var has_chest_blaze: bool = rng.randf() < blaze_chance
	var blaze_color := Color(0.92, 0.88, 0.78)

	# ============================================================================
	# BODY — STRAIGHT topline (NO shoulder hump — key distinction from brown bear)
	# ============================================================================
	var body_y: float = clearance + h * 0.30
	var body_sections: Array = [
		{"center": Vector3(0, body_y - h * 0.02, -d * 0.40), "w": w * 0.30, "h": h * 0.30},  # tail base
		{"center": Vector3(0, body_y - h * 0.01, -d * 0.22), "w": w * 0.46, "h": h * 0.42},  # hip
		{"center": Vector3(0, body_y, -d * 0.05), "w": w * 0.48, "h": h * 0.44},             # mid back
		{"center": Vector3(0, body_y, d * 0.12), "w": w * 0.48, "h": h * 0.44},              # shoulders (FLAT — no hump)
		{"center": Vector3(0, body_y + h * 0.04, d * 0.28), "w": w * 0.42, "h": h * 0.40},   # chest
		{"center": Vector3(0, body_y + h * 0.08, d * 0.42), "w": w * 0.30, "h": h * 0.32},   # neck base
	]
	_swept_body(root, body_sections, 10, primary, belly_color, 0.95, true)

	# WHITE V-CHEST BLAZE — small V/crescent on the upper sternum for ~25%
	# of black/chocolate individuals (canonical Ursus americanus marking).
	if has_chest_blaze:
		# Built as a V from two narrow tapered strips meeting at the bottom
		var blaze_top_y: float = body_y + h * 0.18
		var blaze_bot_y: float = body_y + h * 0.02
		var blaze_z: float = d * 0.42
		for bside in [-1, 1]:
			_build_tapered_segment(root,
				Vector3(bside * w * 0.18, blaze_top_y, blaze_z),
				w * 0.040,
				Vector3(0, blaze_bot_y, blaze_z + d * 0.005),
				w * 0.020,
				blaze_color, 0.85)

	# ============================================================================
	# HEAD — ROUNDED SHORT MUZZLE on a thick neck
	# ============================================================================
	var neck_base := (body_sections[5]["center"] as Vector3)
	var head_anchor := Vector3(0, neck_base.y + h * 0.08, neck_base.z + d * 0.15)
	_build_tapered_segment(root, neck_base, w * 0.22, head_anchor, w * 0.24, primary, 0.95)

	var skull_w: float = w * 0.30
	var skull_h: float = h * 0.28
	var skull_d: float = d * 0.28
	var skull_y_bot: float = head_anchor.y - skull_h * 0.40
	var skull_y_top: float = skull_y_bot + skull_h
	var skull_center_y: float = (skull_y_bot + skull_y_top) * 0.5
	# Skull — round (broader than tall)
	_build_box(
		root,
		Vector3(-skull_w, skull_y_bot, head_anchor.z - skull_d * 0.30),
		Vector3(skull_w, skull_y_top, head_anchor.z + skull_d * 0.30),
		primary, 0.95
	)
	# SHORT ROUND MUZZLE — only ~50% of skull depth, NOT elongated like brown bear
	var muzzle_back_z: float = head_anchor.z + skull_d * 0.30
	var muzzle_tip_z: float = head_anchor.z + skull_d * 0.85
	_build_box(
		root,
		Vector3(-skull_w * 0.55, skull_y_bot + h * 0.02,
			muzzle_back_z - d * 0.02),
		Vector3(skull_w * 0.55, skull_y_top - h * 0.05,
			muzzle_tip_z),
		primary if not has_muzzle_tan else muzzle_tan, 0.95
	)
	# Black nose tip
	_build_box(
		root,
		Vector3(-skull_w * 0.18, skull_y_top - h * 0.12,
			muzzle_tip_z - d * 0.04),
		Vector3(skull_w * 0.18, skull_y_top - h * 0.06,
			muzzle_tip_z + d * 0.02),
		Color(0.04, 0.03, 0.03), 0.55
	)

	# Eyes — small forward-facing
	for side in [-1, 1]:
		_build_box(
			root,
			Vector3(side * skull_w * 0.50 - w * 0.030,
				skull_center_y + h * 0.005, head_anchor.z + skull_d * 0.20),
			Vector3(side * skull_w * 0.50 + w * 0.030,
				skull_center_y + h * 0.030, head_anchor.z + skull_d * 0.30),
			eye_color, 0.30
		)

	# FORWARD-FACING ROUNDED EARS — proportionally larger than brown bear's,
	# but SET WELL BACK on the cranium (verify-agent fix: previously sat too
	# forward at z = -0.05*skull_d; canon Ursus americanus has rearward ears).
	for side in [-1, 1]:
		# Ear base on top of skull, set BACK on the cranium (-20% of skull_d)
		var ear_center := Vector3(side * skull_w * 0.55,
			skull_y_top + h * 0.05,
			head_anchor.z - skull_d * 0.20)
		# Outer rounded ear (semi-circular)
		_build_box(
			root,
			ear_center + Vector3(-w * 0.07, -h * 0.005, -d * 0.04),
			ear_center + Vector3(w * 0.07, h * 0.10, d * 0.04),
			primary, 0.95
		)
		# Outer rim curve (extra cap on top)
		_build_box(
			root,
			ear_center + Vector3(-w * 0.05, h * 0.08, -d * 0.03),
			ear_center + Vector3(w * 0.05, h * 0.12, d * 0.03),
			primary, 0.95
		)
		# Inner ear (lighter)
		_build_box(
			root,
			ear_center + Vector3(-w * 0.04, h * 0.01, d * 0.025),
			ear_center + Vector3(w * 0.04, h * 0.08, d * 0.045),
			primary.lightened(0.15), 0.95
		)

	# JAW — small fanged
	var jaw_y_top: float = skull_y_bot + h * 0.04
	var jaw_y_bot: float = skull_y_bot - h * 0.03
	_build_box(
		root,
		Vector3(-skull_w * 0.50, jaw_y_bot,
			muzzle_back_z + d * 0.02),
		Vector3(skull_w * 0.50, jaw_y_top,
			muzzle_tip_z - d * 0.02),
		fur_dark if not has_muzzle_tan else muzzle_tan.darkened(0.10), 0.95
	)
	# Inner mouth dark
	_build_box(
		root,
		Vector3(-skull_w * 0.40, jaw_y_bot + h * 0.005,
			muzzle_back_z + d * 0.06),
		Vector3(skull_w * 0.40, jaw_y_top - h * 0.005,
			muzzle_tip_z - d * 0.06),
		Color(0.10, 0.05, 0.05), 0.85
	)
	# Upper canines — modest, not oversized like a predator showcase
	for side in [-1, 1]:
		var fx_c: float = side * skull_w * 0.38
		_build_tapered_segment(root,
			Vector3(fx_c, jaw_y_top, muzzle_back_z + d * 0.15), w * 0.022,
			Vector3(fx_c, jaw_y_top - h * 0.04, muzzle_back_z + d * 0.18),
			w * 0.004,
			fang_color, 0.45)

	# ============================================================================
	# LEGS — 4 sturdy quadruped legs, shorter than brown bear's
	# ============================================================================
	for side in [-1, 1]:
		# Front legs
		var fhip := Vector3(side * w * 0.30, body_y + h * 0.02, d * 0.18)
		var fknee := Vector3(side * w * 0.30, clearance * 0.55, d * 0.20)
		var fpaw := Vector3(side * w * 0.28, 0.05, d * 0.22)
		_build_tapered_segment(root, fhip, w * 0.18, fknee, w * 0.15, primary, 0.95)
		_build_tapered_segment(root, fknee, w * 0.15, fpaw, w * 0.12, fur_dark, 0.95)
		# Front paw
		_build_box(
			root,
			Vector3(side * w * 0.28 - w * 0.13, 0.0, d * 0.14),
			Vector3(side * w * 0.28 + w * 0.13, h * 0.08, d * 0.34),
			fur_dark, 0.95
		)
		# 5 SHORT CURVED CLAWS — black bear has distinctive long curved claws
		for ci in range(5):
			var co: float = (float(ci) - 2.0) * w * 0.05
			_build_tapered_segment(root,
				Vector3(side * w * 0.28 + co, h * 0.03, d * 0.34), w * 0.020,
				Vector3(side * w * 0.28 + co, 0.0, d * 0.42), w * 0.004,
				claw_color, 0.40)
		# Back legs
		var rhip := Vector3(side * w * 0.30, body_y - h * 0.01, -d * 0.18)
		var rknee := Vector3(side * w * 0.32, clearance * 0.55, -d * 0.14)
		var rpaw := Vector3(side * w * 0.28, 0.05, -d * 0.18)
		_build_tapered_segment(root, rhip, w * 0.20, rknee, w * 0.16, primary, 0.95)
		_build_tapered_segment(root, rknee, w * 0.16, rpaw, w * 0.12, fur_dark, 0.95)
		# Back paw — longer (bears are plantigrade)
		_build_box(
			root,
			Vector3(side * w * 0.28 - w * 0.12, 0.0, -d * 0.26),
			Vector3(side * w * 0.28 + w * 0.12, h * 0.08, -d * 0.04),
			fur_dark, 0.95
		)
		# Back paw claws
		for ci in range(5):
			var co: float = (float(ci) - 2.0) * w * 0.045
			_build_tapered_segment(root,
				Vector3(side * w * 0.28 + co, h * 0.03, -d * 0.04), w * 0.018,
				Vector3(side * w * 0.28 + co, 0.0, d * 0.02), w * 0.004,
				claw_color, 0.40)

	# ============================================================================
	# TAIL — short stub (bears have very short tails)
	# ============================================================================
	var tail_base := Vector3(0, body_y + h * 0.03, -d * 0.42)
	var tail_tip := Vector3(0, body_y - h * 0.02, -d * 0.52)
	_build_tapered_segment(root, tail_base, w * 0.08, tail_tip, w * 0.025,
		primary, 0.95)


# ============================================================================
# BLACK DRAGON WYRMLING (black_dragon_wyrmling)
# Chromatic acid-breathing dragon — sinuous, slim, marsh predator.
#   - Long sinuous BLACK body with subtle green-grey marsh tint
#   - Pair of LONG BACKWARD-CURVING HORNS (signature distinguishing feature)
#   - Sunken cheeks giving a GAUNT skull look (signature)
#   - Prominent forward fangs
#   - Bat-wings folded against body (for wyrmling) or spread (adult)
#   - 4 clawed legs + long whip-like tail with continuing crest
#   - Spiked frill running along spine, neck, and tail
#   - Yellow/green slit eyes
# ============================================================================

static func _build_black_dragon_wyrmling(plan: Dictionary, root: Node3D) -> void:
	var base: Dictionary = plan.get("base", {})
	var palette: Dictionary = plan.get("palette", {})
	var limbs: Dictionary = plan.get("limbs", {})
	var meta: Dictionary = plan.get("meta", {})
	var species: String = String(meta.get("species", "Black Dragon Wyrmling"))

	# Wyrmling-scale dragon — sinuous, slim build. Scale up for older variants.
	var species_lower: String = species.to_lower()
	var is_adult: bool = ("adult" in species_lower) or ("ancient" in species_lower)
	var is_young: bool = "young" in species_lower
	var base_scale: float = 1.0
	if is_adult:
		base_scale = 2.6
	elif is_young:
		base_scale = 1.7

	var w: float = _axis(base, "width", 0.55 * base_scale)
	var h: float = _axis(base, "height", 0.65 * base_scale)
	var d: float = _axis(base, "depth", 1.85 * base_scale)
	var leg_length: float = float(limbs.get("leg_length", 0.40 * base_scale))
	var clearance: float = leg_length

	var render_seed: int = int(meta.get("render_seed", 0))
	var rng := RandomNumberGenerator.new()
	rng.seed = render_seed if render_seed != 0 else hash(species)

	# Per-individual variation
	var size_jitter: float = rng.randf_range(0.92, 1.15)
	var wing_open_jitter: float = rng.randf_range(0.30, 1.00)  # 0=folded, 1=spread
	var horn_curl_jitter: float = rng.randf_range(0.85, 1.25)
	var spine_count_jitter: int = rng.randi_range(9, 14)
	w *= size_jitter
	h *= size_jitter
	d *= size_jitter
	leg_length *= rng.randf_range(0.92, 1.10)
	clearance = leg_length

	# Black-dragon scale palette — canon is OILY BLACK with subtle green-grey
	# marsh tint, never pure black-black. Some art shows hints of bog purple.
	var scale_options := [
		Color(0.06, 0.06, 0.07),     # cold black (canon base)
		Color(0.08, 0.10, 0.07),     # marsh-green black
		Color(0.07, 0.05, 0.08),     # purple-black
		Color(0.10, 0.10, 0.08),     # warm charcoal
	]
	var primary: Color = scale_options[rng.randi() % scale_options.size()]
	var scale_dark: Color = primary.darkened(0.40)
	var belly_color: Color = Color(0.18, 0.20, 0.16)         # dull marsh grey
	var horn_color := Color(0.20, 0.18, 0.12)                # bone-grey horn
	var horn_dark: Color = horn_color.darkened(0.20)
	var claw_color := Color(0.10, 0.08, 0.06)
	var fang_color := Color(0.85, 0.80, 0.68)
	# Black dragon eyes are GREEN or YELLOW per canon (5e MM)
	var eye_glow := Color(0.65, 0.95, 0.20) if rng.randf() < 0.5 else Color(0.95, 0.90, 0.20)
	# Acid drip color (yellow-green)
	var acid_color := Color(0.55, 0.85, 0.20)

	# ============================================================================
	# BODY — long sinuous SLIM trunk (black dragons are leaner than other chromatics)
	# ============================================================================
	var body_y: float = clearance + h * 0.30
	var body_sections: Array = [
		{"center": Vector3(0, body_y - h * 0.03, -d * 0.44), "w": w * 0.22, "h": h * 0.24},
		{"center": Vector3(0, body_y, -d * 0.28), "w": w * 0.38, "h": h * 0.38},
		{"center": Vector3(0, body_y, -d * 0.10), "w": w * 0.46, "h": h * 0.44},
		{"center": Vector3(0, body_y + h * 0.02, d * 0.08), "w": w * 0.50, "h": h * 0.48},   # mid (widest)
		{"center": Vector3(0, body_y + h * 0.03, d * 0.22), "w": w * 0.44, "h": h * 0.44},
		{"center": Vector3(0, body_y + h * 0.05, d * 0.36), "w": w * 0.34, "h": h * 0.38},
		{"center": Vector3(0, body_y + h * 0.10, d * 0.48), "w": w * 0.24, "h": h * 0.28},   # neck base
	]
	_swept_body(root, body_sections, 10, primary, belly_color, 0.85, true)

	# ============================================================================
	# HEAD — gaunt sunken-cheek draconic skull
	# ============================================================================
	var neck_base := (body_sections[6]["center"] as Vector3)
	var neck_mid := Vector3(0, neck_base.y + h * 0.08, neck_base.z + d * 0.08)
	var head_anchor := Vector3(0, neck_base.y + h * 0.16, neck_base.z + d * 0.18)
	_build_tapered_segment(root, neck_base, w * 0.20, neck_mid, w * 0.17, primary, 0.85)
	_build_tapered_segment(root, neck_mid, w * 0.17, head_anchor, w * 0.20, primary, 0.85)

	var skull_w: float = w * 0.30
	var skull_h: float = h * 0.30
	var skull_d: float = d * 0.25
	var skull_y_bot: float = head_anchor.y - skull_h * 0.40
	var skull_y_top: float = skull_y_bot + skull_h
	var skull_center_y: float = (skull_y_bot + skull_y_top) * 0.5
	# Skull
	_build_box(
		root,
		Vector3(-skull_w, skull_y_bot, head_anchor.z - skull_d * 0.30),
		Vector3(skull_w, skull_y_top, head_anchor.z + skull_d * 0.30),
		primary, 0.85
	)
	# Long crocodilian SNOUT
	_build_box(
		root,
		Vector3(-skull_w * 0.65, skull_y_bot + h * 0.02,
			head_anchor.z + skull_d * 0.30 - d * 0.01),
		Vector3(skull_w * 0.65, skull_y_top - h * 0.06,
			head_anchor.z + skull_d * 1.30),
		primary, 0.85
	)
	# SUNKEN CHEEK HOLLOWS — darker patches make the skull look gaunt (signature)
	for side in [-1, 1]:
		_build_box(
			root,
			Vector3(side * skull_w * 0.55, skull_y_bot + h * 0.005,
				head_anchor.z + skull_d * 0.10),
			Vector3(side * skull_w * 1.02, skull_center_y + h * 0.005,
				head_anchor.z + skull_d * 0.50),
			scale_dark, 0.90
		)
	# Heavy brow ridge
	_build_box(
		root,
		Vector3(-skull_w * 1.05, skull_center_y + h * 0.04,
			head_anchor.z - skull_d * 0.10),
		Vector3(skull_w * 1.05, skull_center_y + h * 0.09,
			head_anchor.z + skull_d * 0.30),
		scale_dark, 0.85
	)
	# Nostril dimples on top of snout
	for side in [-1, 1]:
		_build_box(
			root,
			Vector3(side * skull_w * 0.25 - w * 0.022,
				skull_y_top - h * 0.10, head_anchor.z + skull_d * 1.18),
			Vector3(side * skull_w * 0.25 + w * 0.022,
				skull_y_top - h * 0.06, head_anchor.z + skull_d * 1.28),
			scale_dark, 0.85
		)
	# EYES — green or yellow slit pupils (deep set under heavy brow)
	for side in [-1, 1]:
		_build_box(
			root,
			Vector3(side * skull_w * 0.55 - w * 0.05,
				skull_center_y - h * 0.005, head_anchor.z + skull_d * 0.12),
			Vector3(side * skull_w * 0.55 + w * 0.05,
				skull_center_y + h * 0.035, head_anchor.z + skull_d * 0.28),
			eye_glow, 0.10, 0.0
		)
		# Slit pupil
		_build_box(
			root,
			Vector3(side * skull_w * 0.55 - w * 0.008,
				skull_center_y + h * 0.0, head_anchor.z + skull_d * 0.22),
			Vector3(side * skull_w * 0.55 + w * 0.008,
				skull_center_y + h * 0.035, head_anchor.z + skull_d * 0.28),
			Color(0.04, 0.04, 0.02), 0.30
		)

	# JAW + prominent FANGS (forward-facing, canon-distinctive)
	var jaw_y_top: float = skull_y_bot + h * 0.04
	var jaw_y_bot: float = skull_y_bot - h * 0.06
	_build_box(
		root,
		Vector3(-skull_w * 0.65, jaw_y_bot,
			head_anchor.z + skull_d * 0.10),
		Vector3(skull_w * 0.65, jaw_y_top,
			head_anchor.z + skull_d * 1.25),
		scale_dark, 0.85
	)
	# Inner mouth dark with green acid glow tint
	_build_box(
		root,
		Vector3(-skull_w * 0.50, jaw_y_bot + h * 0.005,
			head_anchor.z + skull_d * 0.18),
		Vector3(skull_w * 0.50, jaw_y_top - h * 0.005,
			head_anchor.z + skull_d * 1.20),
		Color(0.10, 0.18, 0.05), 0.85
	)
	# PROMINENT FORWARD FANGS — 4 upper (paired large + 2 medium)
	for ti in range(4):
		var tt: float = float(ti) / 3.0
		var fx: float = lerpf(-skull_w * 0.55, skull_w * 0.55, tt)
		var fz: float = head_anchor.z + skull_d * lerpf(0.30, 1.10, tt if ti < 2 else (1.0 - tt))
		var is_large: bool = ti == 0 or ti == 3
		var fang_h: float = h * (0.085 if is_large else 0.055)
		_build_tapered_segment(root,
			Vector3(fx, jaw_y_top, fz), w * 0.028,
			Vector3(fx, jaw_y_top - fang_h, fz), w * 0.005,
			fang_color, 0.45)
	# Lower fangs (2 visible interlocking)
	for side in [-1, 1]:
		var lfx: float = side * skull_w * 0.45
		_build_tapered_segment(root,
			Vector3(lfx, jaw_y_bot, head_anchor.z + skull_d * 0.45), w * 0.024,
			Vector3(lfx, jaw_y_top - h * 0.005, head_anchor.z + skull_d * 0.55), w * 0.005,
			fang_color, 0.45)

	# ============================================================================
	# HORNS — paired FORWARD-CURLING horns (THE black dragon signature).
	# Per canon: "horns protrude from the sides of their heads and wrap
	# around, projecting forward." This is the #1 differentiator from green
	# dragons. Verify-agent HIGH severity fix.
	# Base lateral-out → mid arcs forward + slightly up → tip points forward
	# past the snout line.
	# ============================================================================
	for side in [-1, 1]:
		var horn_base := Vector3(side * skull_w * 0.95,
			skull_y_top - h * 0.005,
			head_anchor.z + skull_d * 0.10)
		var horn_mid := Vector3(side * skull_w * 1.20,
			skull_y_top + h * (0.10 * horn_curl_jitter),
			head_anchor.z + skull_d * 0.55)
		var horn_tip := Vector3(side * skull_w * 1.00,
			skull_y_top - h * (0.05 * horn_curl_jitter),
			head_anchor.z + skull_d * 1.20)
		_build_tapered_segment(root, horn_base, w * 0.060, horn_mid, w * 0.035,
			horn_color, 0.55)
		_build_tapered_segment(root, horn_mid, w * 0.035, horn_tip, w * 0.008,
			horn_dark, 0.55)

	# JAW SCUTES — small down-back spikes along the mandible
	# (replaces the redundant forward cheek-horns; crocodilian feel)
	for side in [-1, 1]:
		for sp in range(2):
			var spt: float = float(sp) / 1.5
			var sp_base := Vector3(side * skull_w * 0.72,
				jaw_y_bot + h * 0.005,
				head_anchor.z + skull_d * lerpf(0.35, 0.85, spt))
			var sp_tip := Vector3(side * skull_w * 0.78,
				jaw_y_bot - h * 0.040,
				head_anchor.z + skull_d * lerpf(0.25, 0.75, spt))
			_build_tapered_segment(root, sp_base, w * 0.018, sp_tip, w * 0.004,
				horn_dark, 0.55)

	# ============================================================================
	# NECK FRILL — broad fin/sail at the nape (canon: "a large frill" behind
	# the skull base, distinct from the spinal crest). 2-tri membrane fan.
	# ============================================================================
	var frill_anchor_z: float = neck_mid.z - d * 0.04
	var frill_anchor_y: float = neck_mid.y
	var frill_height: float = h * 0.32
	for fside in [-1, 1]:
		var f_root := Vector3(0, frill_anchor_y, frill_anchor_z)
		var f_inner := Vector3(fside * w * 0.12,
			frill_anchor_y + frill_height * 0.30,
			frill_anchor_z - d * 0.02)
		var f_mid := Vector3(fside * w * 0.32,
			frill_anchor_y + frill_height * 0.85,
			frill_anchor_z - d * 0.05)
		var f_outer := Vector3(fside * w * 0.42,
			frill_anchor_y + frill_height * 0.35,
			frill_anchor_z - d * 0.08)
		var st_frill := SurfaceTool.new()
		st_frill.begin(Mesh.PRIMITIVE_TRIANGLES)
		_add_tri(st_frill, f_root, f_inner, f_mid)
		_add_tri(st_frill, f_root, f_mid, f_outer)
		st_frill.generate_normals()
		var mi_frill := MeshInstance3D.new()
		mi_frill.mesh = st_frill.commit()
		var mat_frill := StandardMaterial3D.new()
		mat_frill.albedo_color = scale_dark.darkened(0.10)
		mat_frill.roughness = 0.75
		mat_frill.cull_mode = BaseMaterial3D.CULL_DISABLED
		mi_frill.material_override = mat_frill
		root.add_child(mi_frill)
		# Bone strut along the leading edge of the frill
		_build_tapered_segment(root, f_root, w * 0.022, f_mid, w * 0.008,
			horn_dark, 0.55)

	# ============================================================================
	# DORSAL SPINE CREST — frill running from skull along the spine to tail tip
	# ============================================================================
	var crest_z_start: float = head_anchor.z + skull_d * 0.10
	var crest_z_end: float = -d * 0.42
	for si in range(spine_count_jitter):
		var st: float = float(si) / float(spine_count_jitter - 1)
		var sz: float = lerpf(crest_z_start, crest_z_end, st)
		# Y follows the spine top (approximation lerps from head_y_top to body_y+0.30)
		var sy_top: float
		if sz > body_y * 0.0 and st < 0.30:
			sy_top = lerpf(skull_y_top - h * 0.04, body_y + h * 0.28, st / 0.30)
		else:
			sy_top = body_y + h * 0.28
		# Spine height — tallest mid-back
		var height_factor: float = 1.0 - pow(abs(st - 0.50) * 2.0, 1.3)
		var spike_h: float = h * lerpf(0.05, 0.18, max(0.0, height_factor))
		_build_tapered_segment(root,
			Vector3(0, sy_top, sz), w * 0.030,
			Vector3(0, sy_top + spike_h, sz - h * 0.02), w * 0.005,
			horn_dark, 0.55)

	# ============================================================================
	# WINGS — bat-wings, partially folded for wyrmling (controlled by jitter)
	# Adult variant gets a fuller spread.
	# ============================================================================
	var wing_spread: float = lerpf(0.5, 2.2, wing_open_jitter) * (1.6 if is_adult else 1.0)
	for side in [-1, 1]:
		var wing_root := Vector3(side * w * 0.50, body_y + h * 0.16, d * 0.05)
		var wing_elbow := Vector3(side * (w * 0.50 + wing_spread * 0.30),
			body_y + h * 0.25 + wing_spread * h * 0.10,
			-d * 0.05)
		var wing_peak := Vector3(side * (w * 0.50 + wing_spread * 0.85),
			body_y + h * 0.05 + wing_spread * h * 0.05,
			-d * (0.15 + wing_open_jitter * 0.10))
		_build_tapered_segment(root, wing_root, w * 0.08, wing_elbow, w * 0.055,
			scale_dark, 0.85)
		_build_tapered_segment(root, wing_elbow, w * 0.055, wing_peak, w * 0.025,
			scale_dark, 0.85)
		# THUMB CLAW at peak
		_build_tapered_segment(root, wing_peak, w * 0.020,
			wing_peak + Vector3(side * w * 0.06, h * 0.04, d * 0.02), w * 0.004,
			claw_color, 0.40)
		# 4 finger struts + membrane
		var struts: int = 4
		var trail_points: Array = []
		for fi in range(struts):
			var ft: float = float(fi) / float(struts - 1)
			var trail := Vector3(
				lerpf(side * w * 0.40, side * (w * 0.50 + wing_spread * 0.85), ft),
				body_y - h * lerpf(0.05, 0.0, ft) - wing_spread * h * 0.05,
				lerpf(-d * 0.30, -d * 0.15, ft) - wing_open_jitter * d * 0.10
			)
			trail_points.append(trail)
			_build_tapered_segment(root, wing_peak, w * 0.020, trail, w * 0.005,
				scale_dark, 0.85)
		# Membrane (3 panels)
		var st_mem := SurfaceTool.new()
		st_mem.begin(Mesh.PRIMITIVE_TRIANGLES)
		_add_quad(st_mem, wing_root, wing_elbow,
			trail_points[1] as Vector3, trail_points[0] as Vector3)
		_add_quad(st_mem, wing_elbow, wing_peak,
			trail_points[2] as Vector3, trail_points[1] as Vector3)
		_add_tri(st_mem, wing_peak,
			trail_points[3] as Vector3, trail_points[2] as Vector3)
		st_mem.generate_normals()
		var mi_mem := MeshInstance3D.new()
		mi_mem.mesh = st_mem.commit()
		var mat_mem := StandardMaterial3D.new()
		mat_mem.albedo_color = scale_dark.darkened(0.10)
		mat_mem.roughness = 0.70
		mat_mem.cull_mode = BaseMaterial3D.CULL_DISABLED
		mi_mem.material_override = mat_mem
		root.add_child(mi_mem)

	# ============================================================================
	# LEGS — 4 powerful clawed dragon legs
	# ============================================================================
	for side in [-1, 1]:
		# Front legs
		var fhip := Vector3(side * w * 0.30, body_y + h * 0.02, d * 0.18)
		var fknee := Vector3(side * w * 0.32, clearance * 0.55, d * 0.20)
		var fpaw := Vector3(side * w * 0.30, 0.05, d * 0.22)
		_build_tapered_segment(root, fhip, w * 0.15, fknee, w * 0.11, primary, 0.85)
		_build_tapered_segment(root, fknee, w * 0.11, fpaw, w * 0.10, scale_dark, 0.85)
		_build_box(
			root,
			Vector3(side * w * 0.30 - w * 0.12, 0.0, d * 0.15),
			Vector3(side * w * 0.30 + w * 0.12, h * 0.07, d * 0.30),
			scale_dark, 0.85
		)
		# 4 long forward claws + 1 rear dewclaw
		for ci in range(4):
			var co: float = (float(ci) - 1.5) * w * 0.05
			_build_tapered_segment(root,
				Vector3(side * w * 0.30 + co, h * 0.03, d * 0.30), w * 0.020,
				Vector3(side * w * 0.30 + co, 0.0, d * 0.40), w * 0.004,
				claw_color, 0.40)
		# Back legs (digitigrade angle)
		var rhip := Vector3(side * w * 0.30, body_y - h * 0.02, -d * 0.18)
		var rknee := Vector3(side * w * 0.34, clearance * 0.60, -d * 0.10)
		var rhock := Vector3(side * w * 0.30, clearance * 0.25, -d * 0.20)
		var rpaw := Vector3(side * w * 0.30, 0.05, -d * 0.12)
		_build_tapered_segment(root, rhip, w * 0.17, rknee, w * 0.12, primary, 0.85)
		_build_tapered_segment(root, rknee, w * 0.11, rhock, w * 0.10, primary, 0.85)
		_build_tapered_segment(root, rhock, w * 0.10, rpaw, w * 0.10, scale_dark, 0.85)
		_build_box(
			root,
			Vector3(side * w * 0.30 - w * 0.11, 0.0, -d * 0.20),
			Vector3(side * w * 0.30 + w * 0.11, h * 0.07, -d * 0.04),
			scale_dark, 0.85
		)
		for ci in range(4):
			var co: float = (float(ci) - 1.5) * w * 0.045
			_build_tapered_segment(root,
				Vector3(side * w * 0.30 + co, h * 0.03, -d * 0.04), w * 0.018,
				Vector3(side * w * 0.30 + co, 0.0, d * 0.04), w * 0.004,
				claw_color, 0.40)

	# ============================================================================
	# TAIL — long whip-like tail with continuing crest fading at the end
	# ============================================================================
	var tail_base := Vector3(0, body_y - h * 0.02, -d * 0.44)
	var tail_q1 := Vector3(rng.randf_range(-w * 0.10, w * 0.10),
		body_y - h * 0.08, -d * 0.80)
	var tail_q2 := Vector3(rng.randf_range(-w * 0.25, w * 0.25),
		body_y - h * 0.18, -d * 1.20)
	var tail_tip := Vector3(rng.randf_range(-w * 0.40, w * 0.40),
		body_y - h * 0.25, -d * 1.65)
	_build_tapered_segment(root, tail_base, w * 0.18, tail_q1, w * 0.11,
		primary, 0.85)
	_build_tapered_segment(root, tail_q1, w * 0.11, tail_q2, w * 0.055,
		scale_dark, 0.85)
	_build_tapered_segment(root, tail_q2, w * 0.055, tail_tip, w * 0.010,
		scale_dark, 0.85)

	# ============================================================================
	# ACID DRIPS — 1-3 acid drops dribbling from the jaw (signature)
	# ============================================================================
	var drip_count: int = rng.randi_range(1, 3)
	for di in range(drip_count):
		var dx: float = rng.randf_range(-skull_w * 0.30, skull_w * 0.30)
		var dy_top: float = jaw_y_bot
		var dy_bot: float = dy_top - h * rng.randf_range(0.04, 0.10)
		var dz: float = head_anchor.z + skull_d * rng.randf_range(0.60, 1.10)
		_build_tapered_segment(root,
			Vector3(dx, dy_top, dz), w * 0.022,
			Vector3(dx, dy_bot, dz), w * 0.008,
			acid_color, 0.10, 0.0)


# ============================================================================
# BLACK PUDDING (black_pudding) — Amorphous acidic ooze
#   - NO fixed shape — irregular pulsating blob (lower-wider than tall)
#   - Inky BLACK color, wet/slick surface (low roughness)
#   - Multiple PSEUDOPOD NUBS pushing out asymmetrically (signature)
#   - Small surface BUBBLES bulging across the top
#   - Acidic drips/strings of slime hanging from underside
#   - NO eyes, NO mouth, NO discernible front (deliberate)
# ============================================================================

static func _build_black_pudding(plan: Dictionary, root: Node3D) -> void:
	var base: Dictionary = plan.get("base", {})
	var palette: Dictionary = plan.get("palette", {})
	var meta: Dictionary = plan.get("meta", {})
	var species: String = String(meta.get("species", "Black Pudding"))

	# Black pudding is Large per 5e MM — a wide low blob.
	var w: float = _axis(base, "width", 1.40)
	var h: float = _axis(base, "height", 0.85)
	var d: float = _axis(base, "depth", 1.40)

	var render_seed: int = int(meta.get("render_seed", 0))
	var rng := RandomNumberGenerator.new()
	rng.seed = render_seed if render_seed != 0 else hash(species)

	# Per-individual variation. Verify-agent fix: fewer pseudopods (was 3-6,
	# read as "kraken" at the top of the range); 4-9 drips kept but they'll
	# now spawn from upper rim + pseudopod tips, not underside.
	var size_jitter: float = rng.randf_range(0.85, 1.20)
	var pseudopod_count: int = rng.randi_range(2, 4)
	var bubble_count: int = rng.randi_range(5, 10)
	var drip_count: int = rng.randi_range(4, 9)
	w *= size_jitter
	h *= size_jitter
	d *= size_jitter

	# Black pudding palette — inky black with subtle hue shifts
	var ooze_options := [
		Color(0.04, 0.04, 0.04),     # inky black (canon)
		Color(0.06, 0.05, 0.06),     # slight purple-black
		Color(0.05, 0.06, 0.05),     # slight green-black
		Color(0.07, 0.05, 0.04),     # warm tar
	]
	var primary: Color = ooze_options[rng.randi() % ooze_options.size()]
	var slime_color: Color = primary.lightened(0.08)         # wet highlight
	var ooze_dark: Color = primary.darkened(0.30)
	# Acid drip color — slightly green-yellow for the bubbling acidic property
	var acid_color := Color(0.30, 0.45, 0.10).lerp(primary, 0.7)

	# ============================================================================
	# MAIN BLOB — irregular blob built as a swept body with jittered sections
	# so it never looks like a clean dome. Wider at bottom than top.
	# ============================================================================
	var blob_base_y: float = 0.0
	var blob_top_y: float = h * 0.95
	# 5 stacked rings with varying radii and slight asymmetric offsets
	# (using rng) so no two pudding individuals look identical.
	var sections: Array = []
	var ring_count: int = 5
	for ri in range(ring_count):
		var rt: float = float(ri) / float(ring_count - 1)     # 0..1 bottom→top
		# Width profile: widest at ~25-35% height (bulge low), narrowing at top
		var width_curve: float
		if rt < 0.30:
			width_curve = lerpf(0.60, 1.00, rt / 0.30)        # bottom flat-ish
		else:
			width_curve = lerpf(1.00, 0.40, (rt - 0.30) / 0.70)
		var sect_w: float = w * 0.50 * width_curve
		var sect_h: float = d * 0.50 * width_curve
		# Slight per-ring offset for irregular silhouette
		var off_x: float = rng.randf_range(-w * 0.05, w * 0.05) * rt
		var off_z: float = rng.randf_range(-d * 0.05, d * 0.05) * rt
		sections.append({
			"center": Vector3(off_x, lerpf(blob_base_y, blob_top_y, rt), off_z),
			"w": sect_w,
			"h": sect_h
		})
	_swept_body(root, sections, 10, primary, ooze_dark, 0.15, true)

	# ============================================================================
	# PSEUDOPOD LOBES — short, BLUNT extrusions that bulge wider at the tip
	# (used to slap/engulf prey). Verify-agent fix: tendril-tapered shape was
	# reading as grell/roper; now narrow-base → wider-bulge-tip lobe with
	# capped length ~0.30 body height.
	# Track tip positions for drip anchoring later.
	# ============================================================================
	var pseudopod_tips: Array = []
	for pi in range(pseudopod_count):
		var p_ang: float = rng.randf_range(0.0, TAU)
		var p_height_t: float = rng.randf_range(0.10, 0.70)
		var anchor_r: float = w * 0.45 * lerpf(0.7, 1.0, p_height_t)
		var anchor := Vector3(
			cos(p_ang) * anchor_r,
			lerpf(blob_base_y, blob_top_y, p_height_t),
			sin(p_ang) * anchor_r
		)
		# Short stubby lobe — length capped at 0.25-0.35 * body height
		var pseudo_len: float = h * rng.randf_range(0.25, 0.35)
		var up_lift: float = h * rng.randf_range(-0.05, 0.15)
		var p_tip := Vector3(
			cos(p_ang) * (anchor_r + pseudo_len * 0.7),
			anchor.y + up_lift,
			sin(p_ang) * (anchor_r + pseudo_len * 0.7)
		)
		# INVERTED taper — narrow at base, BULGE WIDER at tip (lobe)
		_build_tapered_segment(root,
			anchor, w * 0.10, p_tip, w * 0.18,
			primary, 0.15, 0.0)
		# Larger bulbous rounded blob at the tip
		_build_box(
			root,
			p_tip + Vector3(-w * 0.12, -h * 0.09, -d * 0.12),
			p_tip + Vector3(w * 0.12, h * 0.09, d * 0.12),
			primary, 0.15
		)
		# Slime sheen highlight on the upper face of the lobe-tip
		_build_box(
			root,
			p_tip + Vector3(-w * 0.06, h * 0.05, -d * 0.06),
			p_tip + Vector3(w * 0.06, h * 0.10, d * 0.06),
			slime_color, 0.10
		)
		pseudopod_tips.append(p_tip)

	# ============================================================================
	# SURFACE BUBBLES — small irregular bulges across the top hemisphere.
	# Suggests the slowly pulsating ooze surface.
	# ============================================================================
	for bi in range(bubble_count):
		var b_ang: float = rng.randf_range(0.0, TAU)
		var b_t: float = rng.randf_range(0.40, 0.90)
		var b_r: float = w * 0.40 * lerpf(1.0, 0.5, (b_t - 0.40) / 0.50)
		var bx: float = cos(b_ang) * b_r * rng.randf_range(0.5, 1.0)
		var bz: float = sin(b_ang) * b_r * rng.randf_range(0.5, 1.0)
		var by: float = lerpf(blob_base_y, blob_top_y, b_t)
		var bubble_radius: float = w * rng.randf_range(0.05, 0.10)
		_build_box(
			root,
			Vector3(bx - bubble_radius, by - bubble_radius * 0.6,
				bz - bubble_radius),
			Vector3(bx + bubble_radius, by + bubble_radius,
				bz + bubble_radius),
			primary if bi % 3 != 0 else slime_color, 0.15
		)
		# Tiny wet highlight dot on top of half the bubbles
		if bi % 2 == 0:
			_build_box(
				root,
				Vector3(bx - bubble_radius * 0.30, by + bubble_radius * 0.5,
					bz - bubble_radius * 0.30),
				Vector3(bx + bubble_radius * 0.30, by + bubble_radius,
					bz + bubble_radius * 0.30),
				slime_color, 0.10
			)

	# ============================================================================
	# ACID DRIPS — strings hanging from the UPPER RIM and pseudopod tips
	# (verify-agent fix: pudding sits ON the floor, underside drips are
	# geometrically impossible). Mostly black; only 1-2 green-tinted.
	# ============================================================================
	# Pre-pick which drips get the green acid tint (cap at 2 max)
	var green_drip_count: int = min(2, drip_count / 4)
	for di in range(drip_count):
		var dx: float
		var dz: float
		var dy_top: float
		# Half from upper rim, half from pseudopod-tip undersides
		if di % 2 == 0 or pseudopod_tips.is_empty():
			# Upper rim drip: pick from ring 4-5 (upper third of body)
			var d_ang: float = rng.randf_range(0.0, TAU)
			var d_t: float = rng.randf_range(0.55, 0.85)        # upper third
			var d_r: float = w * 0.40 * lerpf(1.0, 0.5, (d_t - 0.55) / 0.30)
			dx = cos(d_ang) * d_r
			dz = sin(d_ang) * d_r
			dy_top = lerpf(blob_base_y, blob_top_y, d_t)
		else:
			# Pseudopod-tip drip: hang from one of the lobe tips
			var tip: Vector3 = pseudopod_tips[di % pseudopod_tips.size()] as Vector3
			dx = tip.x + rng.randf_range(-w * 0.05, w * 0.05)
			dz = tip.z + rng.randf_range(-d * 0.05, d * 0.05)
			dy_top = tip.y - h * 0.05
		# Drip length 0.10-0.25 — never reaches the ground
		var drip_len: float = h * rng.randf_range(0.10, 0.25)
		var dy_bot: float = dy_top - drip_len
		var drip_thick: float = w * rng.randf_range(0.012, 0.040)
		var col: Color = acid_color if di < green_drip_count else primary
		_build_tapered_segment(root,
			Vector3(dx, dy_top, dz), drip_thick,
			Vector3(dx + rng.randf_range(-0.02, 0.02), dy_bot,
				dz + rng.randf_range(-0.02, 0.02)),
			drip_thick * 0.3,
			col, 0.10, 0.0)
		# Optional teardrop bead at the bottom (gravity)
		if rng.randf() < 0.4:
			var bead_r: float = drip_thick * 1.8
			_build_box(
				root,
				Vector3(dx - bead_r, dy_bot - bead_r,
					dz - bead_r),
				Vector3(dx + bead_r, dy_bot + bead_r * 0.4,
					dz + bead_r),
				col, 0.10
			)

	# ============================================================================
	# GROUND PUDDLE — ASYMMETRIC drip pool clustered on one side (where the
	# pudding just oozed from). Verify-agent fix: even 14-bump ring read as
	# decorative; now 6-10 bumps with heavy one-side clustering.
	# ============================================================================
	var puddle_r: float = w * 0.65
	# Pick a dominant heading angle for the cluster
	var cluster_ang: float = rng.randf_range(0.0, TAU)
	var puddle_bumps: int = rng.randi_range(6, 10)
	for ppi in range(puddle_bumps):
		# 70% chance within ±60° of cluster heading, 30% scattered elsewhere
		var pang: float
		if rng.randf() < 0.70:
			pang = cluster_ang + rng.randf_range(-PI / 3.0, PI / 3.0)
		else:
			pang = rng.randf_range(0.0, TAU)
		var bump_r: float = puddle_r * rng.randf_range(0.70, 1.20)
		var px: float = cos(pang) * bump_r
		var pz: float = sin(pang) * bump_r
		var bump_size: float = w * rng.randf_range(0.06, 0.13)
		_build_box(
			root,
			Vector3(px - bump_size, -h * 0.005, pz - bump_size),
			Vector3(px + bump_size, h * 0.020, pz + bump_size),
			primary, 0.20
		)


# ============================================================================
# BLINK DOG (blink_dog) — Fey magical canine, teleporting hunter
#   - Medium quadruped, lighter and slimmer than a wolf
#   - Pharaoh-hound / fennec aesthetic — UPRIGHT FOX-LIKE EARS (signature)
#   - TAWNY GOLD / honey-brown fur (canon)
#   - Intelligent forward-facing eyes
#   - Slim deer-like legs
#   - Bushy tail with WHITE TIP (canon)
#   - Faint blue/gold magical sheen from teleportation aura
# ============================================================================

static func _build_blink_dog(plan: Dictionary, root: Node3D) -> void:
	var base: Dictionary = plan.get("base", {})
	var palette: Dictionary = plan.get("palette", {})
	var limbs: Dictionary = plan.get("limbs", {})
	var meta: Dictionary = plan.get("meta", {})
	var species: String = String(meta.get("species", "Blink Dog"))

	# Lighter / slimmer than wolf
	var w: float = _axis(base, "width", 0.42)
	var h: float = _axis(base, "height", 0.78)
	var d: float = _axis(base, "depth", 1.30)
	var leg_length: float = float(limbs.get("leg_length", 0.40))
	var clearance: float = leg_length

	var render_seed: int = int(meta.get("render_seed", 0))
	var rng := RandomNumberGenerator.new()
	rng.seed = render_seed if render_seed != 0 else hash(species)

	# Per-individual variation. Verify-agent fix: clamped ear size to canon
	# pharaoh-hound proportions (max 1.20× was 1.30× pushing fennec).
	var size_jitter: float = rng.randf_range(0.90, 1.12)
	var ear_size_jitter: float = rng.randf_range(0.85, 1.20)
	var tail_curl_jitter: float = rng.randf_range(0.0, 0.50)
	var has_blink_shimmer: bool = rng.randf() < 0.60
	w *= size_jitter
	h *= size_jitter
	d *= size_jitter
	leg_length *= rng.randf_range(0.95, 1.10)
	clearance = leg_length

	# Tawny gold fur — pharaoh-hound palette
	var fur_options := [
		Color(0.78, 0.55, 0.25),     # tawny gold (canon)
		Color(0.82, 0.62, 0.30),     # honey
		Color(0.70, 0.48, 0.22),     # russet brown
		Color(0.85, 0.68, 0.38),     # warm sand
		Color(0.65, 0.42, 0.20),     # darker rust
	]
	var primary: Color = fur_options[rng.randi() % fur_options.size()]
	var fur_dark: Color = primary.darkened(0.25)
	var fur_light: Color = primary.lightened(0.15)
	var belly_color: Color = primary.lightened(0.25)
	var nose_color := Color(0.10, 0.07, 0.05)
	var fang_color := Color(0.92, 0.88, 0.78)
	var claw_color := Color(0.20, 0.15, 0.10)
	# Intelligent amber eyes
	var eye_color := Color(0.85, 0.55, 0.10)
	# Magical teleport aura — blue/gold shimmer
	var aura_color := Color(0.40, 0.70, 1.00).lerp(Color(1.0, 0.85, 0.30), 0.4)

	# ============================================================================
	# BODY — LEAN deer-like trunk, less hump than wolf
	# ============================================================================
	var body_y: float = clearance + h * 0.25
	var body_sections: Array = [
		{"center": Vector3(0, body_y - h * 0.02, -d * 0.42), "w": w * 0.26, "h": h * 0.25},  # tail base
		{"center": Vector3(0, body_y, -d * 0.22), "w": w * 0.38, "h": h * 0.38},             # hip
		{"center": Vector3(0, body_y, -d * 0.05), "w": w * 0.42, "h": h * 0.40},             # mid back
		{"center": Vector3(0, body_y + h * 0.02, d * 0.15), "w": w * 0.40, "h": h * 0.40},   # shoulders
		{"center": Vector3(0, body_y + h * 0.06, d * 0.32), "w": w * 0.32, "h": h * 0.32},   # chest
		{"center": Vector3(0, body_y + h * 0.10, d * 0.45), "w": w * 0.22, "h": h * 0.26},   # neck base
	]
	_swept_body(root, body_sections, 10, primary, belly_color, 0.92, true)

	# ============================================================================
	# NECK + HEAD — slim pharaoh-hound skull, forward-set eyes
	# ============================================================================
	var neck_base := (body_sections[5]["center"] as Vector3)
	var neck_top := Vector3(0, neck_base.y + h * 0.10, neck_base.z + d * 0.12)
	var head_anchor := Vector3(0, neck_base.y + h * 0.16, neck_base.z + d * 0.25)
	_build_tapered_segment(root, neck_base, w * 0.18, neck_top, w * 0.15, primary, 0.92)
	_build_tapered_segment(root, neck_top, w * 0.15,
		head_anchor + Vector3(0, -h * 0.05, 0), w * 0.16, primary, 0.92)

	# Skull — wedge-shaped, narrower than wolf
	var skull_w: float = w * 0.26
	var skull_h: float = h * 0.22
	var skull_d: float = d * 0.30
	var skull_y_bot: float = head_anchor.y - skull_h * 0.30
	var skull_y_top: float = skull_y_bot + skull_h
	var skull_center_y: float = (skull_y_bot + skull_y_top) * 0.5
	_build_box(
		root,
		Vector3(-skull_w, skull_y_bot, head_anchor.z - skull_d * 0.30),
		Vector3(skull_w, skull_y_top, head_anchor.z + skull_d * 0.25),
		primary, 0.92
	)
	# Snout — narrower + slightly elongated (canine but lean)
	_build_box(
		root,
		Vector3(-skull_w * 0.50, skull_y_bot + h * 0.01,
			head_anchor.z + skull_d * 0.25 - d * 0.005),
		Vector3(skull_w * 0.50, skull_y_top - h * 0.04,
			head_anchor.z + skull_d * 0.90),
		primary, 0.92
	)
	# Black nose
	_build_box(
		root,
		Vector3(-skull_w * 0.20, skull_y_top - h * 0.085,
			head_anchor.z + skull_d * 0.85),
		Vector3(skull_w * 0.20, skull_y_top - h * 0.04,
			head_anchor.z + skull_d * 0.95),
		nose_color, 0.55
	)

	# INTELLIGENT AMBER EYES — set forward, alert
	for side in [-1, 1]:
		_build_box(
			root,
			Vector3(side * skull_w * 0.55 - w * 0.035,
				skull_center_y + h * 0.005, head_anchor.z + skull_d * 0.15),
			Vector3(side * skull_w * 0.55 + w * 0.035,
				skull_center_y + h * 0.030, head_anchor.z + skull_d * 0.25),
			eye_color, 0.20
		)
		# Pupil
		_build_box(
			root,
			Vector3(side * skull_w * 0.55 - w * 0.013,
				skull_center_y + h * 0.010, head_anchor.z + skull_d * 0.22),
			Vector3(side * skull_w * 0.55 + w * 0.013,
				skull_center_y + h * 0.025, head_anchor.z + skull_d * 0.25),
			Color(0.08, 0.05, 0.03), 0.30
		)

	# LARGE UPRIGHT FOX-LIKE EARS — signature blink dog / pharaoh hound look
	for side in [-1, 1]:
		var ear_base := Vector3(side * skull_w * 0.50,
			skull_y_top - h * 0.005,
			head_anchor.z - skull_d * 0.05)
		# Tall pointed ear — much taller than a wolf's
		var ear_tip := Vector3(side * skull_w * 0.55,
			skull_y_top + h * (0.30 * ear_size_jitter),
			head_anchor.z - skull_d * 0.0)
		_build_tapered_segment(root, ear_base, w * 0.075, ear_tip, w * 0.010,
			primary, 0.92)
		# Inner ear (subtle darker cup for the pink/shadow)
		_build_tapered_segment(root,
			ear_base + Vector3(0, h * 0.015, d * 0.008), w * 0.05,
			ear_tip + Vector3(0, -h * 0.025, 0), w * 0.006,
			fur_dark, 0.95)
		# Thin darker RIM at the tip (1-voxel — verify-agent fix: discrete
		# fox-black tip was non-canonical; canon ears are mostly solid tawny)
		_build_box(
			root,
			ear_tip + Vector3(-w * 0.012, -h * 0.010, -d * 0.008),
			ear_tip + Vector3(w * 0.012, h * 0.005, d * 0.008),
			fur_dark, 0.95
		)

	# JAW with modest fangs
	var jaw_y_top: float = skull_y_bot + h * 0.03
	var jaw_y_bot: float = skull_y_bot - h * 0.04
	_build_box(
		root,
		Vector3(-skull_w * 0.45, jaw_y_bot,
			head_anchor.z + skull_d * 0.10),
		Vector3(skull_w * 0.45, jaw_y_top,
			head_anchor.z + skull_d * 0.85),
		fur_dark, 0.92
	)
	# Inner mouth
	_build_box(
		root,
		Vector3(-skull_w * 0.36, jaw_y_bot + h * 0.005,
			head_anchor.z + skull_d * 0.15),
		Vector3(skull_w * 0.36, jaw_y_top - h * 0.005,
			head_anchor.z + skull_d * 0.78),
		Color(0.18, 0.10, 0.08), 0.85
	)
	# Modest upper canines (not over-displayed; this is an intelligent fey)
	for side in [-1, 1]:
		var fx_c: float = side * skull_w * 0.32
		_build_tapered_segment(root,
			Vector3(fx_c, jaw_y_top, head_anchor.z + skull_d * 0.50), w * 0.016,
			Vector3(fx_c, jaw_y_top - h * 0.030, head_anchor.z + skull_d * 0.55),
			w * 0.004,
			fang_color, 0.45)

	# ============================================================================
	# LEGS — 4 slim deer-like legs in uniform tawny (verify-agent fix: white
	# socks were non-canonical; canon blink dogs are uniformly tawny).
	# ============================================================================
	for side in [-1, 1]:
		# Front legs
		var fhip := Vector3(side * w * 0.26, body_y, d * 0.18)
		var fknee := Vector3(side * w * 0.26, clearance * 0.55, d * 0.20)
		var fpaw := Vector3(side * w * 0.24, 0.04, d * 0.22)
		_build_tapered_segment(root, fhip, w * 0.10, fknee, w * 0.08, primary, 0.92)
		_build_tapered_segment(root, fknee, w * 0.08, fpaw, w * 0.07, primary, 0.92)
		# Paw (matches body tawny, not white)
		_build_box(
			root,
			Vector3(side * w * 0.24 - w * 0.085, 0.0, d * 0.17),
			Vector3(side * w * 0.24 + w * 0.085, h * 0.05, d * 0.32),
			primary, 0.95
		)
		# 4 small claws
		for ci in range(4):
			var co: float = (float(ci) - 1.5) * w * 0.035
			_build_tapered_segment(root,
				Vector3(side * w * 0.24 + co, h * 0.03, d * 0.32), w * 0.012,
				Vector3(side * w * 0.24 + co, 0.0, d * 0.36), w * 0.003,
				claw_color, 0.40)
		# Back legs (digitigrade)
		var rhip := Vector3(side * w * 0.26, body_y - h * 0.02, -d * 0.18)
		var rknee := Vector3(side * w * 0.28, clearance * 0.60, -d * 0.14)
		var rhock := Vector3(side * w * 0.24, clearance * 0.22, -d * 0.20)
		var rpaw := Vector3(side * w * 0.24, 0.04, -d * 0.10)
		_build_tapered_segment(root, rhip, w * 0.11, rknee, w * 0.08, primary, 0.92)
		_build_tapered_segment(root, rknee, w * 0.08, rhock, w * 0.07, primary, 0.92)
		_build_tapered_segment(root, rhock, w * 0.07, rpaw, w * 0.075, primary, 0.92)
		_build_box(
			root,
			Vector3(side * w * 0.24 - w * 0.085, 0.0, -d * 0.18),
			Vector3(side * w * 0.24 + w * 0.085, h * 0.05, -d * 0.02),
			primary, 0.95
		)
		for ci in range(4):
			var co: float = (float(ci) - 1.5) * w * 0.032
			_build_tapered_segment(root,
				Vector3(side * w * 0.24 + co, h * 0.03, -d * 0.02), w * 0.010,
				Vector3(side * w * 0.24 + co, 0.0, d * 0.02), w * 0.003,
				claw_color, 0.40)

	# ============================================================================
	# TAIL — bushy, slight upward curl, WHITE TIP (canon signature)
	# ============================================================================
	var tail_base := Vector3(0, body_y + h * 0.05, -d * 0.42)
	# Curl jitter sweeps the mid+tip upward + sideways
	var tail_mid := Vector3(rng.randf_range(-w * 0.08, w * 0.08),
		body_y + h * (0.10 + tail_curl_jitter * 0.15),
		-d * 0.65)
	var tail_tip := Vector3(rng.randf_range(-w * 0.15, w * 0.15),
		body_y + h * (0.15 + tail_curl_jitter * 0.35),
		-d * (0.80 - tail_curl_jitter * 0.10))
	_build_tapered_segment(root, tail_base, w * 0.14, tail_mid, w * 0.12,
		primary, 0.95)
	_build_tapered_segment(root, tail_mid, w * 0.12, tail_tip, w * 0.080,
		primary, 0.95)
	# DARKER RUSSET TIP — verify-agent fix: white tip was a fox/coyote
	# marker; canon blink dog tail is tawny end-to-end, often with darker tip.
	_build_box(
		root,
		Vector3(tail_tip.x - w * 0.07, tail_tip.y - h * 0.05, tail_tip.z - d * 0.05),
		Vector3(tail_tip.x + w * 0.07, tail_tip.y + h * 0.06, tail_tip.z + d * 0.02),
		fur_dark.darkened(0.10), 0.95
	)
	# Bushy fur tufts along the tail — reduced from 4 to 2 (canon is bushy-
	# uniform, not plumed).
	for ti in range(2):
		var tt: float = (float(ti) + 0.5) / 2.0
		var t_pos: Vector3 = tail_base.lerp(tail_tip, tt)
		for tside in [-1, 1]:
			_build_tapered_segment(root,
				t_pos, w * 0.04,
				t_pos + Vector3(tside * w * 0.08, h * 0.01, -d * 0.02), w * 0.008,
				fur_dark, 0.95)

	# ============================================================================
	# BLINK SHIMMER — optional faint blue/gold magical aura sparks around body
	# (canon: blink dogs phase between planes; some art shows visible shimmer)
	# ============================================================================
	if has_blink_shimmer:
		var spark_count: int = rng.randi_range(4, 8)
		for sp in range(spark_count):
			var s_ang: float = rng.randf_range(0.0, TAU)
			var s_y: float = lerpf(body_y - h * 0.10, body_y + h * 0.18, rng.randf())
			var s_r: float = w * rng.randf_range(0.40, 0.55)
			var sx: float = cos(s_ang) * s_r
			var sz: float = sin(s_ang) * s_r * 0.7
			var spark_size: float = w * rng.randf_range(0.018, 0.040)
			_build_box(
				root,
				Vector3(sx - spark_size, s_y - spark_size,
					sz - spark_size),
				Vector3(sx + spark_size, s_y + spark_size,
					sz + spark_size),
				aura_color, 0.05, 0.0
			)


# ============================================================================
# BLOOD HAWK (blood_hawk) — Pack-hunting predatory bird (D&D MM)
#   - Compact raptor body
#   - RED/RUST feathers (signature for "blood" name) with darker tips
#   - Sharp HOOKED BEAK (raptor curved)
#   - Sharp golden TALONS on each foot
#   - Fierce yellow/orange forward-facing eyes (predator binocular)
#   - Wings spread or partially folded
#   - Banded tail feathers
# ============================================================================

static func _build_blood_hawk(plan: Dictionary, root: Node3D) -> void:
	var base: Dictionary = plan.get("base", {})
	var palette: Dictionary = plan.get("palette", {})
	var limbs: Dictionary = plan.get("limbs", {})
	var meta: Dictionary = plan.get("meta", {})
	var species: String = String(meta.get("species", "Blood Hawk"))

	# Small accipiter — sleeker teardrop body (verify-agent fix: previously
	# near-cubic; canon blood hawks have streamlined hawk proportions).
	var w: float = _axis(base, "width", 0.28)
	var h: float = _axis(base, "height", 0.34)
	var d: float = _axis(base, "depth", 0.48)
	var leg_length: float = float(limbs.get("leg_length", 0.18))
	# Blood hawks are typically rendered hovering/flying
	var float_offset: float = leg_length * 0.8

	var render_seed: int = int(meta.get("render_seed", 0))
	var rng := RandomNumberGenerator.new()
	rng.seed = render_seed if render_seed != 0 else hash(species)

	# Per-individual variation
	var size_jitter: float = rng.randf_range(0.88, 1.18)
	var wing_open_jitter: float = rng.randf_range(0.55, 1.00)   # 0.55=folded-ish, 1=spread
	var crest_size_jitter: float = rng.randf_range(0.7, 1.4)
	w *= size_jitter
	h *= size_jitter
	d *= size_jitter

	# Red feather palette — canon "blood hawk" name demands red
	var feather_options := [
		Color(0.70, 0.15, 0.10),     # deep blood red
		Color(0.80, 0.22, 0.10),     # vermillion
		Color(0.55, 0.10, 0.06),     # dark blood
		Color(0.85, 0.35, 0.12),     # rust orange
		Color(0.65, 0.18, 0.18),     # crimson
	]
	var primary: Color = feather_options[rng.randi() % feather_options.size()]
	var feather_dark: Color = primary.darkened(0.40)            # dark tips
	var belly_color: Color = primary.lightened(0.20)            # lighter underside
	var beak_color := Color(0.85, 0.78, 0.30)                   # yellow horn
	var beak_dark := Color(0.30, 0.22, 0.12)                    # darker tip
	var talon_color := Color(0.95, 0.85, 0.40)                  # golden talons
	var talon_tip := Color(0.10, 0.08, 0.05)                    # black tips
	var eye_color := Color(1.0, 0.78, 0.10)                     # fierce yellow

	# Center of body
	var body_y: float = float_offset + h * 0.30
	var body_center := Vector3(0, body_y, 0)

	# ============================================================================
	# BODY — small raptor trunk, slimmer than bat, more streamlined
	# ============================================================================
	var body_sections: Array = [
		{"center": Vector3(0, body_y - h * 0.05, -d * 0.25), "w": w * 0.35, "h": h * 0.28},  # tail base
		{"center": Vector3(0, body_y, -d * 0.10), "w": w * 0.55, "h": h * 0.45},             # mid
		{"center": Vector3(0, body_y + h * 0.05, d * 0.05), "w": w * 0.60, "h": h * 0.48},   # breast (widest)
		{"center": Vector3(0, body_y + h * 0.12, d * 0.18), "w": w * 0.42, "h": h * 0.38},   # upper chest
		{"center": Vector3(0, body_y + h * 0.20, d * 0.25), "w": w * 0.30, "h": h * 0.32},   # neck
	]
	_swept_body(root, body_sections, 10, primary, belly_color, 0.95, true)

	# ============================================================================
	# HEAD — compact raptor skull with hooked beak
	# ============================================================================
	var neck_base := (body_sections[4]["center"] as Vector3)
	var head_anchor := Vector3(0, neck_base.y + h * 0.05, neck_base.z + d * 0.08)
	# Short thick neck (raptors have compressed necks in flight)
	_build_tapered_segment(root, neck_base, w * 0.18, head_anchor, w * 0.20,
		primary, 0.95)

	var head_w: float = w * 0.42
	var head_h: float = h * 0.20
	var head_d: float = d * 0.36
	var head_y_bot: float = head_anchor.y - head_h * 0.30
	var head_y_top: float = head_y_bot + head_h
	var head_center_y: float = (head_y_bot + head_y_top) * 0.5
	# Skull
	_build_box(
		root,
		Vector3(-head_w, head_y_bot, head_anchor.z - head_d * 0.30),
		Vector3(head_w, head_y_top, head_anchor.z + head_d * 0.40),
		primary, 0.95
	)
	# Heavy brow ridge for FIERCE look (raptor signature)
	_build_box(
		root,
		Vector3(-head_w * 1.05, head_center_y + h * 0.04,
			head_anchor.z + head_d * 0.10),
		Vector3(head_w * 1.05, head_center_y + h * 0.085,
			head_anchor.z + head_d * 0.40),
		feather_dark, 0.95
	)
	# FIERCE YELLOW EYES — forward-facing binocular (predator)
	for side in [-1, 1]:
		_build_box(
			root,
			Vector3(side * head_w * 0.60 - w * 0.040,
				head_center_y, head_anchor.z + head_d * 0.30),
			Vector3(side * head_w * 0.60 + w * 0.040,
				head_center_y + h * 0.040, head_anchor.z + head_d * 0.42),
			eye_color, 0.20, 0.0
		)
		# Black pupil
		_build_box(
			root,
			Vector3(side * head_w * 0.60 - w * 0.015,
				head_center_y + h * 0.005, head_anchor.z + head_d * 0.38),
			Vector3(side * head_w * 0.60 + w * 0.015,
				head_center_y + h * 0.035, head_anchor.z + head_d * 0.42),
			Color(0.05, 0.04, 0.02), 0.30
		)

	# ============================================================================
	# HOOKED BEAK — signature raptor curved beak (THE blood hawk identifier)
	# Upper beak curves DOWN past the lower jaw to a hooked point.
	# ============================================================================
	var beak_base_y: float = head_y_bot + h * 0.02
	var beak_base_z: float = head_anchor.z + head_d * 0.40
	var beak_back_w: float = head_w * 0.45
	# Upper beak: 6 vertices forming a wedge that hooks downward
	var ubBL := Vector3(-beak_back_w, beak_base_y, beak_base_z)
	var ubBR := Vector3(beak_back_w, beak_base_y, beak_base_z)
	var ubTL := Vector3(-beak_back_w * 0.85, beak_base_y + h * 0.06,
		beak_base_z + d * 0.02)
	var ubTR := Vector3(beak_back_w * 0.85, beak_base_y + h * 0.06,
		beak_base_z + d * 0.02)
	# Mid-beak — narrower, lower
	var ubMidL := Vector3(-beak_back_w * 0.45, beak_base_y - h * 0.02,
		beak_base_z + d * 0.18)
	var ubMidR := Vector3(beak_back_w * 0.45, beak_base_y - h * 0.02,
		beak_base_z + d * 0.18)
	# Hook tip — curves DOWN past the lower beak
	var ubTip := Vector3(0, beak_base_y - h * 0.10, beak_base_z + d * 0.24)
	var st_beak := SurfaceTool.new()
	st_beak.begin(Mesh.PRIMITIVE_TRIANGLES)
	# Top
	_add_quad(st_beak, ubTL, ubTR, ubMidR, ubMidL)
	_add_tri(st_beak, ubMidL, ubMidR, ubTip)
	# Left
	_add_tri(st_beak, ubBL, ubTL, ubMidL)
	_add_tri(st_beak, ubBL, ubMidL, ubTip)
	# Right
	_add_tri(st_beak, ubTR, ubBR, ubMidR)
	_add_tri(st_beak, ubBR, ubTip, ubMidR)
	# Bottom (underside of upper beak)
	_add_quad(st_beak, ubBL, ubMidL, ubMidR, ubBR)
	st_beak.generate_normals()
	var mi_beak := MeshInstance3D.new()
	mi_beak.mesh = st_beak.commit()
	var mat_beak := StandardMaterial3D.new()
	mat_beak.albedo_color = beak_color
	mat_beak.roughness = 0.40
	mat_beak.cull_mode = BaseMaterial3D.CULL_DISABLED
	mi_beak.material_override = mat_beak
	root.add_child(mi_beak)
	# Darker beak tip box
	_build_box(
		root,
		Vector3(ubTip.x - w * 0.015, ubTip.y - h * 0.005,
			ubTip.z - d * 0.015),
		Vector3(ubTip.x + w * 0.015, ubTip.y + h * 0.015,
			ubTip.z + d * 0.005),
		beak_dark, 0.40
	)
	# Lower beak — smaller wedge tucked under
	_build_box(
		root,
		Vector3(-beak_back_w * 0.65, beak_base_y - h * 0.06,
			beak_base_z),
		Vector3(beak_back_w * 0.65, beak_base_y - h * 0.01,
			beak_base_z + d * 0.15),
		beak_color.darkened(0.10), 0.40
	)
	_build_tapered_segment(root,
		Vector3(0, beak_base_y - h * 0.025, beak_base_z + d * 0.12), w * 0.10,
		Vector3(0, beak_base_y - h * 0.05, beak_base_z + d * 0.20), w * 0.020,
		beak_color.darkened(0.15), 0.40)
	# Yellow cere (fleshy area at beak base, raptor cue)
	_build_box(
		root,
		Vector3(-beak_back_w * 0.85, beak_base_y + h * 0.005,
			beak_base_z - d * 0.02),
		Vector3(beak_back_w * 0.85, beak_base_y + h * 0.045,
			beak_base_z + d * 0.005),
		beak_color, 0.50
	)

	# ============================================================================
	# HEAD CREST removed — verify-agent: true hawks don't crest; backward
	# crest was reading harpy/owl. Use crest_size_jitter only for an OPTIONAL
	# faint forward-leaning brow tuft (rare individuals, no rakish backward fan).
	# ============================================================================
	if crest_size_jitter > 1.20:
		# Subtle forward brow tuft at the crown
		_build_box(
			root,
			Vector3(-head_w * 0.18, head_y_top - h * 0.005,
				head_anchor.z + head_d * 0.08),
			Vector3(head_w * 0.18, head_y_top + h * 0.030,
				head_anchor.z + head_d * 0.20),
			feather_dark, 0.95
		)

	# ============================================================================
	# WINGS — SHORT BROAD ACCIPITRINE wings (verify-agent fix: was buteo-long
	# at 3.5× body width; accipiters need short broad woodland-agile wings).
	# Wingspan now ~2.6× body width, chord widened for the broader profile.
	# ============================================================================
	for side in [-1, 1]:
		var wing_span: float = w * 2.6 * wing_open_jitter
		var wing_root := Vector3(side * w * 0.50, body_y + h * 0.15, 0.0)
		var wing_elbow := Vector3(side * (w * 0.55 + wing_span * 0.40),
			body_y + h * 0.30, -d * 0.10)            # wider chord (+0.05 z)
		var wing_wrist := Vector3(side * (w * 0.55 + wing_span * 0.80),
			body_y + h * 0.23, -d * 0.18)            # wider chord (+0.08 z)
		# Wing arm (humerus + ulna)
		_build_tapered_segment(root, wing_root, w * 0.10, wing_elbow, w * 0.075,
			primary, 0.95)
		_build_tapered_segment(root, wing_elbow, w * 0.075, wing_wrist, w * 0.050,
			primary, 0.95)
		# PRIMARY FEATHERS — 5 long pinions from the wrist, fanning back/out
		var primary_count: int = 5
		for pi in range(primary_count):
			var pt: float = float(pi) / float(primary_count - 1)
			# Outer primaries trail more outward+back
			var p_tip := Vector3(
				side * (w * 0.55 + wing_span * (0.95 + pt * 0.30)),
				body_y + h * lerpf(0.15, 0.05, pt),
				-d * lerpf(0.10, 0.45, pt)
			)
			# Use feather_dark for tip-half darker (canon raptor wing tip)
			var feather_thickness: float = w * lerpf(0.022, 0.018, pt)
			_build_tapered_segment(root, wing_wrist, feather_thickness,
				p_tip, w * 0.005,
				primary, 0.95)
			# Darker tip overlay
			_build_tapered_segment(root,
				wing_wrist.lerp(p_tip, 0.70), feather_thickness * 0.7,
				p_tip, w * 0.005,
				feather_dark, 0.95)
		# SECONDARY FEATHERS — 4 shorter feathers along the trailing edge
		# (between shoulder/elbow and the body)
		var secondary_count: int = 4
		for si in range(secondary_count):
			var st_t: float = float(si) / float(secondary_count - 1)
			var s_root := wing_root.lerp(wing_wrist, lerpf(0.20, 0.75, st_t))
			var s_tip := s_root + Vector3(
				side * w * 0.10,
				-h * 0.08,
				-d * 0.20
			)
			_build_tapered_segment(root, s_root, w * 0.022, s_tip, w * 0.005,
				primary, 0.95)
		# COVERT FEATHERS — small overlapping feathers along the wing arm top
		var covert_count: int = 5
		for ki in range(covert_count):
			var kt: float = (float(ki) + 0.5) / float(covert_count)
			var k_pos: Vector3 = wing_root.lerp(wing_wrist, kt)
			_build_box(
				root,
				k_pos + Vector3(-w * 0.04, h * 0.005, -d * 0.04),
				k_pos + Vector3(w * 0.04, h * 0.045, d * 0.04),
				feather_dark if ki % 2 == 0 else primary, 0.95
			)

	# ============================================================================
	# TAIL FEATHERS — LONG RECTANGULAR accipitrine fan (verify-agent fix:
	# previously buteo-stubby and round; canon accipiters use a long tail
	# for woodland rudder steering).
	# Tail length ≈ body depth, narrow rectangular fan rather than wide round.
	# ============================================================================
	var tail_anchor := Vector3(0, body_y - h * 0.02, -d * 0.30)
	var tail_length: float = d * 1.10
	for ti in range(5):
		var tt: float = float(ti) / 4.0 - 0.5    # -0.5..+0.5
		# Narrower lateral spread — rectangular not rounded
		var t_tip := Vector3(
			tail_anchor.x + tt * w * 0.30,
			tail_anchor.y - h * 0.05,
			tail_anchor.z - tail_length * (1.0 - abs(tt) * 0.04)
		)
		var fc: Color = primary if (ti != 1 and ti != 3) else feather_dark
		_build_tapered_segment(root, tail_anchor, w * 0.05, t_tip, w * 0.012,
			fc, 0.95)
	# Two tail bands — dark stripes for accipiter barring pattern
	for band_i in range(2):
		var band_z_t: float = lerpf(0.35, 0.75, float(band_i))
		var band_z: float = tail_anchor.z - tail_length * band_z_t
		_build_tapered_segment(root,
			Vector3(-w * 0.16, tail_anchor.y - h * 0.04 - h * 0.005, band_z),
			w * 0.018,
			Vector3(w * 0.16, tail_anchor.y - h * 0.04 - h * 0.005, band_z),
			w * 0.018,
			feather_dark, 0.95)

	# ============================================================================
	# LEGS + TALONS — yellow scaled legs with sharp golden talons
	# ============================================================================
	for side in [-1, 1]:
		var leg_top := Vector3(side * w * 0.18, body_y - h * 0.20, -d * 0.05)
		var leg_bot := Vector3(side * w * 0.18, body_y - h * 0.40, -d * 0.05)
		# Feathered upper leg (matches body)
		_build_tapered_segment(root, leg_top, w * 0.06, leg_bot, w * 0.04,
			primary, 0.95)
		# Bare scaled lower leg (yellow horn)
		var foot_top := Vector3(side * w * 0.18, body_y - h * 0.55, 0.0)
		_build_tapered_segment(root, leg_bot, w * 0.040, foot_top, w * 0.030,
			beak_color, 0.60)
		# Foot pad
		_build_box(
			root,
			Vector3(side * w * 0.18 - w * 0.04, foot_top.y - h * 0.020,
				foot_top.z - d * 0.04),
			Vector3(side * w * 0.18 + w * 0.04, foot_top.y + h * 0.010,
				foot_top.z + d * 0.04),
			beak_color, 0.60
		)
		# 3 FORWARD TALONS + 1 BACK TALON
		for ti in range(3):
			var to: float = (float(ti) - 1.0) * w * 0.035
			var lateral: float = side * (float(ti) - 1.0) * w * 0.015
			var toe_tip := Vector3(side * w * 0.18 + to + lateral,
				foot_top.y - h * 0.02,
				foot_top.z + d * 0.08)
			# Talon (curved hook)
			_build_tapered_segment(root,
				Vector3(side * w * 0.18 + to, foot_top.y - h * 0.005, foot_top.z + d * 0.02),
				w * 0.014,
				toe_tip, w * 0.004,
				talon_color, 0.40)
			# Black hook tip
			var hook_tip := Vector3(toe_tip.x + lateral * 0.5,
				toe_tip.y - h * 0.05,
				toe_tip.z + d * 0.02)
			_build_tapered_segment(root, toe_tip, w * 0.006, hook_tip, w * 0.002,
				talon_tip, 0.40)
		# Back talon (raptor hallux)
		var back_toe := Vector3(side * w * 0.18, foot_top.y - h * 0.02,
			foot_top.z - d * 0.06)
		_build_tapered_segment(root,
			Vector3(side * w * 0.18, foot_top.y, foot_top.z - d * 0.01),
			w * 0.013,
			back_toe, w * 0.003,
			talon_color, 0.40)
		_build_tapered_segment(root, back_toe, w * 0.004,
			back_toe + Vector3(0, -h * 0.05, -d * 0.02),
			w * 0.002,
			talon_tip, 0.40)


# ============================================================================
# BLUE DRAGON WYRMLING (blue_dragon_wyrmling)
# Chromatic lightning-breathing desert dragon.
#   - Stocky/powerful build (more solid than slim black dragon)
#   - BLUE SCALES (azure/sky/deep blue range) with paler sandy belly
#   - ONE LARGE FRONTAL HORN on snout/forehead (THE signature feature)
#   - Frilled / large ear flaps (canon — distinct from other chromatics)
#   - Lightning crackle/static aura
#   - Yellow slit eyes
#   - Long horn-spiked spine ridge
# ============================================================================

static func _build_blue_dragon_wyrmling(plan: Dictionary, root: Node3D) -> void:
	var base: Dictionary = plan.get("base", {})
	var palette: Dictionary = plan.get("palette", {})
	var limbs: Dictionary = plan.get("limbs", {})
	var meta: Dictionary = plan.get("meta", {})
	var species: String = String(meta.get("species", "Blue Dragon Wyrmling"))

	# Stockier than black dragon. Scale up for adult/young.
	var species_lower: String = species.to_lower()
	var is_adult: bool = ("adult" in species_lower) or ("ancient" in species_lower)
	var is_young: bool = "young" in species_lower
	var base_scale: float = 1.0
	if is_adult:
		base_scale = 2.6
	elif is_young:
		base_scale = 1.7

	var w: float = _axis(base, "width", 0.70 * base_scale)
	var h: float = _axis(base, "height", 0.80 * base_scale)
	var d: float = _axis(base, "depth", 1.85 * base_scale)
	var leg_length: float = float(limbs.get("leg_length", 0.45 * base_scale))
	var clearance: float = leg_length

	var render_seed: int = int(meta.get("render_seed", 0))
	var rng := RandomNumberGenerator.new()
	rng.seed = render_seed if render_seed != 0 else hash(species)

	# Per-individual variation. Verify-agent fix: bias wing_open higher
	# (blue dragons are desert thermal soarers with the largest wing:body
	# ratio of any chromatic), reduce spine count toward sparser canon.
	var size_jitter: float = rng.randf_range(0.92, 1.15)
	var frontal_horn_jitter: float = rng.randf_range(0.85, 1.30)
	var wing_open_jitter: float = rng.randf_range(0.55, 1.00)
	var spine_count_jitter: int = rng.randi_range(6, 9)
	var crackle_count: int = rng.randi_range(0, 4)
	w *= size_jitter
	h *= size_jitter
	d *= size_jitter
	leg_length *= rng.randf_range(0.92, 1.10)
	clearance = leg_length

	# Blue scale palette — canon azure/sky/deep blue range
	var scale_options := [
		Color(0.20, 0.45, 0.80),     # azure (canon base)
		Color(0.12, 0.30, 0.65),     # deep ocean
		Color(0.32, 0.55, 0.85),     # bright sky
		Color(0.18, 0.40, 0.70),     # cobalt
	]
	var primary: Color = scale_options[rng.randi() % scale_options.size()]
	var scale_dark: Color = primary.darkened(0.40)
	var belly_color := Color(0.78, 0.72, 0.55)              # sandy/tan (desert sun-bleached)
	var horn_color := Color(0.20, 0.18, 0.12)               # bone horn
	var horn_dark: Color = horn_color.darkened(0.20)
	var claw_color := Color(0.10, 0.08, 0.06)
	var fang_color := Color(0.92, 0.88, 0.75)
	var eye_glow := Color(0.95, 0.85, 0.20)                 # canon yellow
	# Lightning palette
	var lightning_outer := Color(0.55, 0.80, 1.00)
	var lightning_core := Color(0.95, 0.95, 1.00)

	# ============================================================================
	# BODY — STOCKIER trunk than black dragon (broader chest, less sinuous)
	# ============================================================================
	var body_y: float = clearance + h * 0.30
	var body_sections: Array = [
		{"center": Vector3(0, body_y - h * 0.03, -d * 0.42), "w": w * 0.28, "h": h * 0.28},
		{"center": Vector3(0, body_y, -d * 0.22), "w": w * 0.46, "h": h * 0.44},
		{"center": Vector3(0, body_y, -d * 0.05), "w": w * 0.52, "h": h * 0.50},
		{"center": Vector3(0, body_y + h * 0.02, d * 0.12), "w": w * 0.55, "h": h * 0.52},   # mid widest
		{"center": Vector3(0, body_y + h * 0.03, d * 0.26), "w": w * 0.50, "h": h * 0.48},   # broad chest
		{"center": Vector3(0, body_y + h * 0.06, d * 0.40), "w": w * 0.36, "h": h * 0.38},
		{"center": Vector3(0, body_y + h * 0.10, d * 0.50), "w": w * 0.26, "h": h * 0.30},   # neck base
	]
	_swept_body(root, body_sections, 10, primary, belly_color, 0.85, true)

	# ============================================================================
	# HEAD — angular draconic skull with prominent SINGLE FRONTAL HORN
	# ============================================================================
	var neck_base := (body_sections[6]["center"] as Vector3)
	var neck_mid := Vector3(0, neck_base.y + h * 0.08, neck_base.z + d * 0.08)
	var head_anchor := Vector3(0, neck_base.y + h * 0.16, neck_base.z + d * 0.18)
	_build_tapered_segment(root, neck_base, w * 0.22, neck_mid, w * 0.20, primary, 0.85)
	_build_tapered_segment(root, neck_mid, w * 0.20, head_anchor, w * 0.22, primary, 0.85)

	var skull_w: float = w * 0.30
	var skull_h: float = h * 0.30
	var skull_d: float = d * 0.25
	var skull_y_bot: float = head_anchor.y - skull_h * 0.40
	var skull_y_top: float = skull_y_bot + skull_h
	var skull_center_y: float = (skull_y_bot + skull_y_top) * 0.5
	# Skull
	_build_box(
		root,
		Vector3(-skull_w, skull_y_bot, head_anchor.z - skull_d * 0.30),
		Vector3(skull_w, skull_y_top, head_anchor.z + skull_d * 0.30),
		primary, 0.85
	)
	# Snout — long but more robust than black dragon's gaunt one
	_build_box(
		root,
		Vector3(-skull_w * 0.70, skull_y_bot + h * 0.02,
			head_anchor.z + skull_d * 0.30 - d * 0.005),
		Vector3(skull_w * 0.70, skull_y_top - h * 0.04,
			head_anchor.z + skull_d * 1.20),
		primary, 0.85
	)
	# Heavy brow
	_build_box(
		root,
		Vector3(-skull_w * 1.05, skull_center_y + h * 0.04,
			head_anchor.z - skull_d * 0.05),
		Vector3(skull_w * 1.05, skull_center_y + h * 0.09,
			head_anchor.z + skull_d * 0.30),
		scale_dark, 0.85
	)
	# Nostril dimples on top of snout
	for side in [-1, 1]:
		_build_box(
			root,
			Vector3(side * skull_w * 0.25 - w * 0.020,
				skull_y_top - h * 0.10, head_anchor.z + skull_d * 1.10),
			Vector3(side * skull_w * 0.25 + w * 0.020,
				skull_y_top - h * 0.06, head_anchor.z + skull_d * 1.18),
			scale_dark, 0.85
		)

	# YELLOW SLIT EYES
	for side in [-1, 1]:
		_build_box(
			root,
			Vector3(side * skull_w * 0.55 - w * 0.05,
				skull_center_y - h * 0.005, head_anchor.z + skull_d * 0.12),
			Vector3(side * skull_w * 0.55 + w * 0.05,
				skull_center_y + h * 0.035, head_anchor.z + skull_d * 0.28),
			eye_glow, 0.10, 0.0
		)
		_build_box(
			root,
			Vector3(side * skull_w * 0.55 - w * 0.008,
				skull_center_y + h * 0.0, head_anchor.z + skull_d * 0.22),
			Vector3(side * skull_w * 0.55 + w * 0.008,
				skull_center_y + h * 0.035, head_anchor.z + skull_d * 0.28),
			Color(0.05, 0.04, 0.0), 0.30
		)

	# JAW
	var jaw_y_top: float = skull_y_bot + h * 0.04
	var jaw_y_bot: float = skull_y_bot - h * 0.05
	_build_box(
		root,
		Vector3(-skull_w * 0.65, jaw_y_bot,
			head_anchor.z + skull_d * 0.10),
		Vector3(skull_w * 0.65, jaw_y_top,
			head_anchor.z + skull_d * 1.15),
		scale_dark, 0.85
	)
	_build_box(
		root,
		Vector3(-skull_w * 0.50, jaw_y_bot + h * 0.005,
			head_anchor.z + skull_d * 0.18),
		Vector3(skull_w * 0.50, jaw_y_top - h * 0.005,
			head_anchor.z + skull_d * 1.10),
		Color(0.10, 0.18, 0.30), 0.85
	)
	# Upper canines — 2 prominent
	for side in [-1, 1]:
		var fx_c: float = side * skull_w * 0.45
		_build_tapered_segment(root,
			Vector3(fx_c, jaw_y_top, head_anchor.z + skull_d * 0.50), w * 0.026,
			Vector3(fx_c, jaw_y_top - h * 0.06, head_anchor.z + skull_d * 0.55), w * 0.005,
			fang_color, 0.45)

	# ============================================================================
	# SIGNATURE SINGLE FRONTAL HORN — large bony horn on the snout's bridge
	# (THE blue dragon identifier — distinguishes from green/red/black/white)
	# Pointed forward + slightly up.
	# ============================================================================
	var horn_base := Vector3(0, skull_y_top - h * 0.025,
		head_anchor.z + skull_d * 0.80)
	var horn_tip := Vector3(0,
		skull_y_top + h * (0.25 * frontal_horn_jitter),
		head_anchor.z + skull_d * (1.30 + 0.20 * frontal_horn_jitter))
	_build_tapered_segment(root,
		horn_base, w * 0.075,
		horn_tip, w * 0.012,
		horn_color, 0.55)
	# Darker shadow band partway up the horn
	_build_tapered_segment(root,
		horn_base.lerp(horn_tip, 0.40), w * 0.055,
		horn_base.lerp(horn_tip, 0.60), w * 0.040,
		horn_dark, 0.55)

	# ============================================================================
	# FRILLED EAR FLAPS — broad fin-like ears flanking back of skull (canon
	# blue dragon signature — distinct large frill behind the eyes).
	# ============================================================================
	for side in [-1, 1]:
		var ear_root := Vector3(side * skull_w * 0.95,
			skull_y_top - h * 0.020,
			head_anchor.z - skull_d * 0.05)
		var ear_outer_top := Vector3(side * skull_w * 1.55,
			skull_y_top + h * 0.20,
			head_anchor.z - skull_d * 0.45)
		var ear_outer_bot := Vector3(side * skull_w * 1.55,
			skull_y_top - h * 0.10,
			head_anchor.z - skull_d * 0.45)
		var st_ear := SurfaceTool.new()
		st_ear.begin(Mesh.PRIMITIVE_TRIANGLES)
		_add_tri(st_ear, ear_root, ear_outer_top, ear_outer_bot)
		st_ear.generate_normals()
		var mi_ear := MeshInstance3D.new()
		mi_ear.mesh = st_ear.commit()
		var mat_ear := StandardMaterial3D.new()
		mat_ear.albedo_color = scale_dark.darkened(0.10)
		mat_ear.roughness = 0.75
		mat_ear.cull_mode = BaseMaterial3D.CULL_DISABLED
		mi_ear.material_override = mat_ear
		root.add_child(mi_ear)
		# Bone strut along the leading edge
		_build_tapered_segment(root, ear_root, w * 0.020,
			ear_outer_top, w * 0.006,
			horn_dark, 0.55)

	# ============================================================================
	# DORSAL SPINE CREST — sparser, lower spikes (verify-agent fix: was too
	# dense + tall, competing with the frontal horn for visual focus).
	# Spike height reduced ~20% so the single frontal horn stays the hero.
	# ============================================================================
	var crest_z_start: float = head_anchor.z + skull_d * 0.05
	var crest_z_end: float = -d * 0.42
	for si in range(spine_count_jitter):
		var st: float = float(si) / float(spine_count_jitter - 1)
		var sz: float = lerpf(crest_z_start, crest_z_end, st)
		var sy_top: float
		if sz > body_y * 0.0 and st < 0.30:
			sy_top = lerpf(skull_y_top - h * 0.04, body_y + h * 0.28, st / 0.30)
		else:
			sy_top = body_y + h * 0.28
		var height_factor: float = 1.0 - pow(abs(st - 0.50) * 2.0, 1.3)
		# Reduced spike height range: 0.06→0.05, 0.18→0.14 (~20% lower)
		var spike_h: float = h * lerpf(0.05, 0.14, max(0.0, height_factor))
		_build_tapered_segment(root,
			Vector3(0, sy_top, sz), w * 0.025,
			Vector3(0, sy_top + spike_h, sz - h * 0.02), w * 0.004,
			horn_dark, 0.55)

	# ============================================================================
	# WINGS — bat-wings with LARGER spread (verify-agent fix: canon blues have
	# the largest wing-to-body ratio of any chromatic; scaled ~1.20× wider).
	# ============================================================================
	var wing_spread: float = lerpf(0.6, 2.6, wing_open_jitter) * (1.6 if is_adult else 1.0)
	for side in [-1, 1]:
		var wing_root := Vector3(side * w * 0.52, body_y + h * 0.18, d * 0.05)
		var wing_elbow := Vector3(side * (w * 0.52 + wing_spread * 0.32),
			body_y + h * 0.30 + wing_spread * h * 0.12,
			-d * 0.05)
		var wing_peak := Vector3(side * (w * 0.52 + wing_spread * 0.98),
			body_y + h * 0.10 + wing_spread * h * 0.06,
			-d * (0.15 + wing_open_jitter * 0.10))
		_build_tapered_segment(root, wing_root, w * 0.08, wing_elbow, w * 0.055,
			scale_dark, 0.85)
		_build_tapered_segment(root, wing_elbow, w * 0.055, wing_peak, w * 0.025,
			scale_dark, 0.85)
		_build_tapered_segment(root, wing_peak, w * 0.020,
			wing_peak + Vector3(side * w * 0.06, h * 0.04, d * 0.02), w * 0.004,
			claw_color, 0.40)
		var struts: int = 4
		var trail_points: Array = []
		for fi in range(struts):
			var ft: float = float(fi) / float(struts - 1)
			# Widen trailing edge ~15% via wing_spread*0.98 (matches peak)
			var trail := Vector3(
				lerpf(side * w * 0.40, side * (w * 0.52 + wing_spread * 0.98), ft),
				body_y - h * lerpf(0.05, 0.0, ft) - wing_spread * h * 0.06,
				lerpf(-d * 0.32, -d * 0.15, ft) - wing_open_jitter * d * 0.12
			)
			trail_points.append(trail)
			_build_tapered_segment(root, wing_peak, w * 0.020, trail, w * 0.005,
				scale_dark, 0.85)
		var st_mem := SurfaceTool.new()
		st_mem.begin(Mesh.PRIMITIVE_TRIANGLES)
		_add_quad(st_mem, wing_root, wing_elbow,
			trail_points[1] as Vector3, trail_points[0] as Vector3)
		_add_quad(st_mem, wing_elbow, wing_peak,
			trail_points[2] as Vector3, trail_points[1] as Vector3)
		_add_tri(st_mem, wing_peak,
			trail_points[3] as Vector3, trail_points[2] as Vector3)
		st_mem.generate_normals()
		var mi_mem := MeshInstance3D.new()
		mi_mem.mesh = st_mem.commit()
		var mat_mem := StandardMaterial3D.new()
		mat_mem.albedo_color = scale_dark.darkened(0.10)
		mat_mem.roughness = 0.70
		mat_mem.cull_mode = BaseMaterial3D.CULL_DISABLED
		mi_mem.material_override = mat_mem
		root.add_child(mi_mem)

	# ============================================================================
	# LEGS — 4 powerful clawed dragon legs (stocky)
	# ============================================================================
	for side in [-1, 1]:
		var fhip := Vector3(side * w * 0.32, body_y + h * 0.02, d * 0.18)
		var fknee := Vector3(side * w * 0.34, clearance * 0.55, d * 0.20)
		var fpaw := Vector3(side * w * 0.30, 0.05, d * 0.22)
		_build_tapered_segment(root, fhip, w * 0.17, fknee, w * 0.13, primary, 0.85)
		_build_tapered_segment(root, fknee, w * 0.13, fpaw, w * 0.11, scale_dark, 0.85)
		_build_box(
			root,
			Vector3(side * w * 0.30 - w * 0.12, 0.0, d * 0.15),
			Vector3(side * w * 0.30 + w * 0.12, h * 0.07, d * 0.30),
			scale_dark, 0.85
		)
		for ci in range(4):
			var co: float = (float(ci) - 1.5) * w * 0.05
			_build_tapered_segment(root,
				Vector3(side * w * 0.30 + co, h * 0.03, d * 0.30), w * 0.020,
				Vector3(side * w * 0.30 + co, 0.0, d * 0.40), w * 0.004,
				claw_color, 0.40)
		var rhip := Vector3(side * w * 0.32, body_y - h * 0.02, -d * 0.18)
		var rknee := Vector3(side * w * 0.36, clearance * 0.60, -d * 0.10)
		var rhock := Vector3(side * w * 0.32, clearance * 0.25, -d * 0.20)
		var rpaw := Vector3(side * w * 0.30, 0.05, -d * 0.12)
		_build_tapered_segment(root, rhip, w * 0.19, rknee, w * 0.13, primary, 0.85)
		_build_tapered_segment(root, rknee, w * 0.12, rhock, w * 0.10, primary, 0.85)
		_build_tapered_segment(root, rhock, w * 0.10, rpaw, w * 0.11, scale_dark, 0.85)
		_build_box(
			root,
			Vector3(side * w * 0.30 - w * 0.11, 0.0, -d * 0.20),
			Vector3(side * w * 0.30 + w * 0.11, h * 0.07, -d * 0.04),
			scale_dark, 0.85
		)
		for ci in range(4):
			var co: float = (float(ci) - 1.5) * w * 0.045
			_build_tapered_segment(root,
				Vector3(side * w * 0.30 + co, h * 0.03, -d * 0.04), w * 0.018,
				Vector3(side * w * 0.30 + co, 0.0, d * 0.04), w * 0.004,
				claw_color, 0.40)

	# ============================================================================
	# TAIL — THICK BUMPY tapering tail with knuckle nodules along its length.
	# Verify-agent fix: was smooth-tapering; canon blue dragon tail is
	# described as "thick and bumpy" — base radius bumped ~12%, and 8
	# scale-knuckle bumps added along the length.
	# ============================================================================
	var tail_base := Vector3(0, body_y - h * 0.02, -d * 0.44)
	var tail_q1 := Vector3(rng.randf_range(-w * 0.10, w * 0.10),
		body_y - h * 0.08, -d * 0.80)
	var tail_q2 := Vector3(rng.randf_range(-w * 0.20, w * 0.20),
		body_y - h * 0.16, -d * 1.20)
	var tail_tip := Vector3(rng.randf_range(-w * 0.30, w * 0.30),
		body_y - h * 0.24, -d * 1.60)
	# Thicker base (0.18 → 0.20)
	_build_tapered_segment(root, tail_base, w * 0.20, tail_q1, w * 0.13,
		primary, 0.85)
	_build_tapered_segment(root, tail_q1, w * 0.13, tail_q2, w * 0.065,
		scale_dark, 0.85)
	_build_tapered_segment(root, tail_q2, w * 0.065, tail_tip, w * 0.012,
		scale_dark, 0.85)
	# Bumpy knuckle nodules along the upper surface
	for ki in range(8):
		var kt: float = (float(ki) + 0.5) / 8.0
		# Lerp across the tail spline (approximate)
		var k_pos: Vector3
		if kt < 0.33:
			k_pos = tail_base.lerp(tail_q1, kt / 0.33)
		elif kt < 0.66:
			k_pos = tail_q1.lerp(tail_q2, (kt - 0.33) / 0.33)
		else:
			k_pos = tail_q2.lerp(tail_tip, (kt - 0.66) / 0.34)
		# Knuckle size tapers with tail thickness
		var knuckle_r: float = w * lerpf(0.060, 0.018, kt)
		# Place on the dorsal surface (above the tail spline)
		_build_box(
			root,
			k_pos + Vector3(-knuckle_r * 0.85, knuckle_r * 0.30, -knuckle_r * 0.85),
			k_pos + Vector3(knuckle_r * 0.85, knuckle_r * 1.10, knuckle_r * 0.85),
			scale_dark if ki % 2 == 0 else primary, 0.85
		)

	# ============================================================================
	# LIGHTNING CRACKLE — 0-4 small static arcs visible around the body
	# (signature lightning-aura — blue dragons sparkle with stored charge)
	# ============================================================================
	for ci in range(crackle_count):
		var c_ang: float = rng.randf_range(0.0, TAU)
		var c_height_t: float = rng.randf_range(0.10, 0.95)
		var c_anchor_r: float = w * 0.50 * lerpf(0.4, 1.0, c_height_t)
		var c_anchor := Vector3(
			cos(c_ang) * c_anchor_r,
			lerpf(body_y - h * 0.10, body_y + h * 0.35, c_height_t),
			sin(c_ang) * c_anchor_r * 0.7
		)
		# Zig-zag bolt
		var c_mid := c_anchor + Vector3(
			rng.randf_range(-w * 0.08, w * 0.08),
			h * rng.randf_range(0.05, 0.10),
			rng.randf_range(-d * 0.08, d * 0.08)
		)
		var c_tip := c_mid + Vector3(
			rng.randf_range(-w * 0.12, w * 0.12),
			h * rng.randf_range(0.05, 0.15),
			rng.randf_range(-d * 0.12, d * 0.12)
		)
		_build_tapered_segment(root, c_anchor, w * 0.014, c_mid, w * 0.010,
			lightning_outer, 0.05, 0.0)
		_build_tapered_segment(root, c_mid, w * 0.010, c_tip, w * 0.004,
			lightning_outer, 0.05, 0.0)
		_build_tapered_segment(root, c_anchor, w * 0.007, c_mid, w * 0.005,
			lightning_core, 0.05, 0.0)
		_build_tapered_segment(root, c_mid, w * 0.005, c_tip, w * 0.002,
			lightning_core, 0.05, 0.0)


# ============================================================================
# BOAR (boar) — Wild boar / Giant Boar
#   - Stocky compact pig with short legs
#   - HEAVY SHOULDER HUMP from massive neck muscles (signature)
#   - BRISTLY DORSAL MANE along the spine (signature)
#   - PROMINENT CURVED TUSKS jutting up from lower jaw (signature)
#   - Flat disc nose with two round nostrils (pig)
#   - Small triangular ears
#   - Cloven hooves
#   - Dark gray-brown / black-brown coat
#   - Short angry tail
# ============================================================================

static func _build_boar(plan: Dictionary, root: Node3D) -> void:
	var base: Dictionary = plan.get("base", {})
	var palette: Dictionary = plan.get("palette", {})
	var limbs: Dictionary = plan.get("limbs", {})
	var meta: Dictionary = plan.get("meta", {})
	var species: String = String(meta.get("species", "Boar"))

	# Boar — short stocky, longer than tall.
	# Giant Boar scales up via species keyword.
	var species_lower: String = species.to_lower()
	var is_giant: bool = "giant" in species_lower
	var base_scale: float = 1.7 if is_giant else 1.0

	# Verify-agent fix: body shortened (d 1.35→1.15) for the canon
	# length:height ratio ~1.3-1.4 instead of dachshund-long 1.8.
	var w: float = _axis(base, "width", 0.62 * base_scale)
	var h: float = _axis(base, "height", 0.78 * base_scale)
	var d: float = _axis(base, "depth", 1.15 * base_scale)
	var leg_length: float = float(limbs.get("leg_length", 0.30 * base_scale))
	var clearance: float = leg_length

	var render_seed: int = int(meta.get("render_seed", 0))
	var rng := RandomNumberGenerator.new()
	rng.seed = render_seed if render_seed != 0 else hash(species)

	# Per-individual variation
	var size_jitter: float = rng.randf_range(0.92, 1.18)
	var tusk_size_jitter: float = rng.randf_range(0.80, 1.50)   # some are tuskier
	var mane_density_jitter: float = rng.randf_range(0.85, 1.30)
	w *= size_jitter
	h *= size_jitter
	d *= size_jitter
	leg_length *= rng.randf_range(0.92, 1.10)
	clearance = leg_length

	# Coat palette — canon wild boar dark earth tones
	var coat_options := [
		Color(0.22, 0.18, 0.14),     # dark grey-brown (canon)
		Color(0.16, 0.12, 0.10),     # near-black brown
		Color(0.32, 0.22, 0.15),     # warm brown
		Color(0.18, 0.16, 0.14),     # soot grey
		Color(0.40, 0.28, 0.18),     # rusty (older individuals)
	]
	var primary: Color = coat_options[rng.randi() % coat_options.size()]
	var coat_dark: Color = primary.darkened(0.30)
	var belly_color: Color = primary.lightened(0.15)
	var mane_color: Color = primary.darkened(0.40)
	var snout_color: Color = primary.darkened(0.20)
	var hoof_color := Color(0.08, 0.06, 0.05)
	var tusk_color := Color(0.92, 0.88, 0.75)
	var eye_color := Color(0.20, 0.12, 0.06)

	# ============================================================================
	# BODY — stocky pig with PROMINENT SHOULDER HUMP front; underdeveloped
	# RUMP tapering narrower behind (canon wild boar profile).
	# Verify-agent fix: rear sections narrowed (was 0.32-0.46, now 0.26-0.40).
	# ============================================================================
	var body_y: float = clearance + h * 0.30
	var body_sections: Array = [
		{"center": Vector3(0, body_y - h * 0.08, -d * 0.42), "w": w * 0.26, "h": h * 0.28},  # rump (narrow)
		{"center": Vector3(0, body_y - h * 0.05, -d * 0.25), "w": w * 0.40, "h": h * 0.38},  # hip (narrower)
		{"center": Vector3(0, body_y, -d * 0.05), "w": w * 0.50, "h": h * 0.46},             # back
		{"center": Vector3(0, body_y + h * 0.10, d * 0.12), "w": w * 0.52, "h": h * 0.52},   # SHOULDER HUMP (highest point)
		{"center": Vector3(0, body_y + h * 0.05, d * 0.28), "w": w * 0.40, "h": h * 0.44},   # chest
		{"center": Vector3(0, body_y + h * 0.08, d * 0.40), "w": w * 0.28, "h": h * 0.32},   # neck base
	]
	_swept_body(root, body_sections, 10, primary, belly_color, 0.95, true)

	# ============================================================================
	# HEAD — thick triangular skull with flat disc nose
	# ============================================================================
	var neck_base := (body_sections[5]["center"] as Vector3)
	var head_anchor := Vector3(0, neck_base.y, neck_base.z + d * 0.18)
	# Short thick neck (almost no neck visible — boar head sits on shoulders)
	_build_tapered_segment(root, neck_base, w * 0.24, head_anchor, w * 0.26,
		primary, 0.95)

	# Verify-agent fix: head scaled up — canon boar head is ~1/3 body length.
	# Width and depth both bumped (skull_w 0.30→0.34, skull_d 0.40→0.50).
	var skull_w: float = w * 0.34
	var skull_h: float = h * 0.32
	var skull_d: float = d * 0.50
	var skull_y_bot: float = head_anchor.y - skull_h * 0.45
	var skull_y_top: float = skull_y_bot + skull_h
	var skull_center_y: float = (skull_y_bot + skull_y_top) * 0.5
	# Wedge skull — narrower at snout, broader at back
	_build_box(
		root,
		Vector3(-skull_w, skull_y_bot, head_anchor.z - skull_d * 0.30),
		Vector3(skull_w, skull_y_top, head_anchor.z + skull_d * 0.40),
		primary, 0.95
	)
	# Long blunt snout — narrower than skull
	_build_box(
		root,
		Vector3(-skull_w * 0.55, skull_y_bot + h * 0.02,
			head_anchor.z + skull_d * 0.40 - d * 0.005),
		Vector3(skull_w * 0.55, skull_y_top - h * 0.06,
			head_anchor.z + skull_d * 0.95),
		primary, 0.95
	)
	# FLAT DISC NOSE — circular pad at the snout tip (signature pig nose)
	_build_box(
		root,
		Vector3(-skull_w * 0.45, skull_y_bot + h * 0.03,
			head_anchor.z + skull_d * 0.92),
		Vector3(skull_w * 0.45, skull_y_top - h * 0.04,
			head_anchor.z + skull_d * 1.02),
		snout_color, 0.85
	)
	# Two ROUND NOSTRILS on the disc
	for side in [-1, 1]:
		_build_box(
			root,
			Vector3(side * skull_w * 0.20 - w * 0.030,
				skull_center_y - h * 0.005,
				head_anchor.z + skull_d * 0.97),
			Vector3(side * skull_w * 0.20 + w * 0.030,
				skull_center_y + h * 0.040,
				head_anchor.z + skull_d * 1.03),
			Color(0.05, 0.04, 0.03), 0.85
		)
	# Small EYES — set well back on the skull (pig eyes are far from snout)
	for side in [-1, 1]:
		_build_box(
			root,
			Vector3(side * skull_w * 0.65 - w * 0.025,
				skull_center_y + h * 0.005, head_anchor.z + skull_d * 0.10),
			Vector3(side * skull_w * 0.65 + w * 0.025,
				skull_center_y + h * 0.030, head_anchor.z + skull_d * 0.20),
			eye_color, 0.50
		)

	# LONG BROAD OVAL EARS — verify-agent fix: small triangles read as
	# domestic pig/peccary; canon wild boar ears are "long and broad",
	# taller than wide. Rear-set with forward lean, slight tufting.
	for side in [-1, 1]:
		var ear_base_y: float = skull_y_top - h * 0.005
		var ear_x: float = side * skull_w * 0.60
		var ear_z: float = head_anchor.z - skull_d * 0.10
		# Oval ear body — built as a tall narrow box (taller than wide)
		_build_box(
			root,
			Vector3(ear_x - w * 0.040, ear_base_y, ear_z - d * 0.025),
			Vector3(ear_x + w * 0.040, ear_base_y + h * 0.18, ear_z + d * 0.035),
			coat_dark, 0.95
		)
		# Forward-leaning rounded top cap
		_build_box(
			root,
			Vector3(ear_x - w * 0.035, ear_base_y + h * 0.16, ear_z + d * 0.010),
			Vector3(ear_x + w * 0.035, ear_base_y + h * 0.22, ear_z + d * 0.045),
			coat_dark, 0.95
		)
		# Inner ear (darker/pinker oval inside)
		_build_box(
			root,
			Vector3(ear_x - w * 0.025, ear_base_y + h * 0.025,
				ear_z + d * 0.020),
			Vector3(ear_x + w * 0.025, ear_base_y + h * 0.155,
				ear_z + d * 0.040),
			snout_color, 0.95
		)
		# Small tuft at the top edge (bristly fringe)
		_build_tapered_segment(root,
			Vector3(ear_x, ear_base_y + h * 0.20, ear_z),
			w * 0.012,
			Vector3(ear_x + side * w * 0.015, ear_base_y + h * 0.27, ear_z - d * 0.020),
			w * 0.003,
			mane_color, 0.95)

	# JAW
	var jaw_y_top: float = skull_y_bot + h * 0.04
	var jaw_y_bot: float = skull_y_bot - h * 0.05
	_build_box(
		root,
		Vector3(-skull_w * 0.50, jaw_y_bot,
			head_anchor.z + skull_d * 0.10),
		Vector3(skull_w * 0.50, jaw_y_top,
			head_anchor.z + skull_d * 0.95),
		coat_dark, 0.95
	)

	# ============================================================================
	# PROMINENT TUSKS — signature curved tusks from lower jaw (sweeping up + out)
	# ============================================================================
	for side in [-1, 1]:
		var tusk_base := Vector3(side * skull_w * 0.40,
			jaw_y_top - h * 0.005,
			head_anchor.z + skull_d * 0.55)
		var tusk_mid := Vector3(side * skull_w * 0.55,
			jaw_y_top + h * (0.06 * tusk_size_jitter),
			head_anchor.z + skull_d * 0.75)
		var tusk_tip := Vector3(side * skull_w * 0.70,
			jaw_y_top + h * (0.15 * tusk_size_jitter),
			head_anchor.z + skull_d * 0.65)
		_build_tapered_segment(root, tusk_base, w * 0.030, tusk_mid, w * 0.018,
			tusk_color, 0.45)
		_build_tapered_segment(root, tusk_mid, w * 0.018, tusk_tip, w * 0.005,
			tusk_color.darkened(0.10), 0.45)

	# ============================================================================
	# BRISTLY DORSAL MANE — stiff bristle row along the spine from neck to back
	# (signature wild boar feature — especially prominent on shoulder hump)
	# ============================================================================
	var mane_count: int = int(round(10.0 * mane_density_jitter))
	var mane_z_start: float = d * 0.35
	var mane_z_end: float = -d * 0.30
	for mi in range(mane_count):
		var mt: float = float(mi) / float(mane_count - 1)
		var mz: float = lerpf(mane_z_start, mane_z_end, mt)
		# Spine height — peak at the shoulder hump (front third)
		var spine_y: float
		if mt < 0.30:
			# Front: rising to hump
			spine_y = lerpf(body_y + h * 0.18, body_y + h * 0.32, mt / 0.30)
		elif mt < 0.50:
			# Hump down to back
			spine_y = lerpf(body_y + h * 0.32, body_y + h * 0.22, (mt - 0.30) / 0.20)
		else:
			# Back to tail
			spine_y = lerpf(body_y + h * 0.22, body_y + h * 0.05, (mt - 0.50) / 0.50)
		# Bristle height — tallest on the shoulder hump
		var hump_factor: float = 1.0 - pow(abs(mt - 0.30) * 3.0, 1.4)
		var bristle_h: float = h * lerpf(0.06, 0.18, max(0.0, hump_factor))
		# Slight rng for irregular bristle row
		var sway: float = rng.randf_range(-w * 0.03, w * 0.03)
		_build_tapered_segment(root,
			Vector3(sway, spine_y, mz), w * 0.020,
			Vector3(sway + rng.randf_range(-w * 0.01, w * 0.01),
				spine_y + bristle_h,
				mz - bristle_h * 0.25),
			w * 0.004,
			mane_color, 0.95)

	# ============================================================================
	# LEGS — 4 short stocky legs ending in CLOVEN HOOVES
	# ============================================================================
	for side in [-1, 1]:
		# Front legs
		var fhip := Vector3(side * w * 0.28, body_y + h * 0.04, d * 0.18)
		var fknee := Vector3(side * w * 0.28, clearance * 0.55, d * 0.20)
		var fhoof_top := Vector3(side * w * 0.26, h * 0.08, d * 0.22)
		_build_tapered_segment(root, fhip, w * 0.13, fknee, w * 0.10, primary, 0.95)
		_build_tapered_segment(root, fknee, w * 0.10, fhoof_top, w * 0.08,
			coat_dark, 0.95)
		# CLOVEN HOOF — two black prongs
		for prong in [-1, 1]:
			_build_box(
				root,
				Vector3(side * w * 0.26 + prong * w * 0.04 - w * 0.025,
					0.0, d * 0.16),
				Vector3(side * w * 0.26 + prong * w * 0.04 + w * 0.025,
					h * 0.08, d * 0.28),
				hoof_color, 0.35
			)
		# Back legs
		var rhip := Vector3(side * w * 0.28, body_y - h * 0.02, -d * 0.18)
		var rknee := Vector3(side * w * 0.30, clearance * 0.55, -d * 0.15)
		var rhoof_top := Vector3(side * w * 0.26, h * 0.08, -d * 0.10)
		_build_tapered_segment(root, rhip, w * 0.15, rknee, w * 0.11, primary, 0.95)
		_build_tapered_segment(root, rknee, w * 0.11, rhoof_top, w * 0.08,
			coat_dark, 0.95)
		for prong in [-1, 1]:
			_build_box(
				root,
				Vector3(side * w * 0.26 + prong * w * 0.04 - w * 0.025,
					0.0, -d * 0.16),
				Vector3(side * w * 0.26 + prong * w * 0.04 + w * 0.025,
					h * 0.08, -d * 0.04),
				hoof_color, 0.35
			)

	# ============================================================================
	# TAIL — short with a curly twist (or straight — random)
	# ============================================================================
	var tail_base := Vector3(0, body_y + h * 0.03, -d * 0.42)
	var is_curly: bool = rng.randf() < 0.40
	if is_curly:
		# Curly twist — 3 short segments arcing up-back
		var t1 := Vector3(0, body_y + h * 0.10, -d * 0.48)
		var t2 := Vector3(w * 0.05, body_y + h * 0.12, -d * 0.45)
		var t3 := Vector3(-w * 0.03, body_y + h * 0.08, -d * 0.48)
		_build_tapered_segment(root, tail_base, w * 0.05, t1, w * 0.030,
			primary, 0.95)
		_build_tapered_segment(root, t1, w * 0.030, t2, w * 0.020,
			primary, 0.95)
		_build_tapered_segment(root, t2, w * 0.020, t3, w * 0.010,
			mane_color, 0.95)
	else:
		# Straight short tail with bristle tip
		var tail_tip := Vector3(0, body_y - h * 0.05, -d * 0.58)
		_build_tapered_segment(root, tail_base, w * 0.05, tail_tip, w * 0.015,
			primary, 0.95)
		# Bristle tuft at tip
		for tside in [-1, 1]:
			_build_tapered_segment(root,
				tail_tip, w * 0.020,
				tail_tip + Vector3(tside * w * 0.04, -h * 0.04, -d * 0.04),
				w * 0.004,
				mane_color, 0.95)


# ============================================================================
# BONE DEVIL (bone_devil) — Osyluth, skeletal devil of Stygia
#   - TALL gaunt skeletal humanoid (~9 ft canon)
#   - BONE-WHITE skin pulled tight over visible bones
#   - VISIBLE RIB CAGE through emaciated chest (signature)
#   - SKULL-FACE head with hollow eye sockets
#   - SCORPION-LIKE SEGMENTED STING TAIL arching over the body (signature)
#   - Hooked claws on each hand
#   - Bony shoulder/elbow spikes
#   - Vestigial leathery wings (small, can't truly fly)
# ============================================================================

static func _build_bone_devil(plan: Dictionary, root: Node3D) -> void:
	var base: Dictionary = plan.get("base", {})
	var palette: Dictionary = plan.get("palette", {})
	var limbs: Dictionary = plan.get("limbs", {})
	var meta: Dictionary = plan.get("meta", {})
	var species: String = String(meta.get("species", "Bone Devil"))

	# Tall thin emaciated devil
	var w: float = _axis(base, "width", 0.65)
	var h: float = _axis(base, "height", 2.65)       # ~9 ft canon
	var d: float = _axis(base, "depth", 0.50)
	var leg_length: float = float(limbs.get("leg_length", 1.30))
	var clearance: float = leg_length

	var render_seed: int = int(meta.get("render_seed", 0))
	var rng := RandomNumberGenerator.new()
	rng.seed = render_seed if render_seed != 0 else hash(species)

	# Per-individual variation
	var size_jitter: float = rng.randf_range(0.92, 1.15)
	var sting_size_jitter: float = rng.randf_range(0.85, 1.30)
	var wing_open_jitter: float = rng.randf_range(0.20, 0.55)   # mostly small/folded
	w *= size_jitter
	h *= size_jitter
	d *= size_jitter
	leg_length *= rng.randf_range(0.95, 1.10)
	clearance = leg_length

	# Skin palette — bone-white to pale grey
	var skin_options := [
		Color(0.85, 0.82, 0.74),     # bone white (canon base)
		Color(0.78, 0.75, 0.68),     # pale ivory
		Color(0.72, 0.70, 0.65),     # ashen grey
		Color(0.88, 0.84, 0.74),     # warm bone
	]
	var primary: Color = skin_options[rng.randi() % skin_options.size()]
	var skin_dark: Color = primary.darkened(0.30)
	var bone_white: Color = primary.lightened(0.10)
	var hollow_dark := Color(0.06, 0.05, 0.05)
	var claw_color := Color(0.20, 0.18, 0.16)
	var sting_dark := Color(0.45, 0.42, 0.38)
	# Eye glow — pale yellow/green (canon)
	var eye_glow := Color(0.85, 0.95, 0.40)
	# Stinger acid drip color
	var venom_color := Color(0.70, 0.85, 0.30)

	# ============================================================================
	# TORSO — gaunt, EMACIATED, with visible rib cage
	# ============================================================================
	var hip_y: float = clearance
	var waist_y: float = clearance + h * 0.12
	var chest_y: float = clearance + h * 0.30
	var shoulder_y: float = clearance + h * 0.45
	# Narrow waist
	_build_box(
		root,
		Vector3(-w * 0.22, hip_y, -d * 0.18),
		Vector3(w * 0.22, waist_y, d * 0.18),
		primary, 0.65
	)
	# Visible PELVIS bones either side of the hip
	for side in [-1, 1]:
		_build_box(
			root,
			Vector3(side * w * 0.22 - w * 0.04, hip_y + h * 0.005,
				-d * 0.12),
			Vector3(side * w * 0.22 + w * 0.04, hip_y + h * 0.05,
				d * 0.18),
			bone_white, 0.60
		)
	# Mid (skeletal abdomen) — narrow, ribbed shadows
	_build_box(
		root,
		Vector3(-w * 0.28, waist_y, -d * 0.22),
		Vector3(w * 0.28, chest_y, d * 0.24),
		primary, 0.65
	)
	# Rib cage chest (wider but emaciated)
	_build_box(
		root,
		Vector3(-w * 0.40, chest_y, -d * 0.28),
		Vector3(w * 0.40, shoulder_y, d * 0.30),
		primary, 0.65
	)
	# VISIBLE RIBS — 5 darker horizontal grooves across the chest
	for ri in range(5):
		var ry: float = lerpf(chest_y + h * 0.01, shoulder_y - h * 0.01, float(ri) / 4.0)
		_build_box(
			root,
			Vector3(-w * 0.38, ry - h * 0.006, d * 0.26),
			Vector3(w * 0.38, ry + h * 0.006, d * 0.31),
			skin_dark, 0.70
		)
	# Sternum line (raised center)
	_build_box(
		root,
		Vector3(-w * 0.020, chest_y, d * 0.28),
		Vector3(w * 0.020, shoulder_y, d * 0.32),
		bone_white, 0.60
	)

	# ============================================================================
	# HEAD — SKULL-LIKE elongated face
	# ============================================================================
	# Long thin VULTURE-LIKE neck (verify-agent fix: removed humanoid
	# Adam's-apple; added cervical vertebrae bumps along the BACK of the
	# neck for the canon hunched skeletal silhouette).
	var neck_top := Vector3(0, shoulder_y + h * 0.06, d * 0.05)
	_build_tapered_segment(root,
		Vector3(0, shoulder_y - h * 0.01, 0.0), w * 0.10,
		neck_top, w * 0.08,
		primary, 0.65)
	# 3 cervical vertebrae bumps along the BACK of the neck
	for vi in range(3):
		var vt: float = (float(vi) + 0.5) / 3.0    # 0.17, 0.50, 0.83
		var vy: float = lerpf(shoulder_y + h * 0.01, neck_top.y - h * 0.005, vt)
		_build_box(
			root,
			Vector3(-w * 0.025, vy - h * 0.010, -d * 0.05),
			Vector3(w * 0.025, vy + h * 0.012, -d * 0.02),
			bone_white, 0.60
		)

	var skull_w: float = w * 0.26
	var skull_h: float = h * 0.16
	var skull_d: float = d * 0.70
	var skull_y_bot: float = neck_top.y
	var skull_y_top: float = skull_y_bot + skull_h
	var skull_center_y: float = (skull_y_bot + skull_y_top) * 0.5
	# Cranium — elongated, narrow
	_build_box(
		root,
		Vector3(-skull_w, skull_y_bot, neck_top.z - skull_d * 0.25),
		Vector3(skull_w, skull_y_top, neck_top.z + skull_d * 0.40),
		primary, 0.65
	)
	# Long elongated muzzle/jaw
	_build_box(
		root,
		Vector3(-skull_w * 0.55, skull_y_bot + h * 0.01,
			neck_top.z + skull_d * 0.40),
		Vector3(skull_w * 0.55, skull_y_top - h * 0.04,
			neck_top.z + skull_d * 0.85),
		primary, 0.65
	)
	# SUNKEN CHEEK HOLLOWS
	for side in [-1, 1]:
		_build_box(
			root,
			Vector3(side * skull_w * 0.50, skull_y_bot + h * 0.005,
				neck_top.z + skull_d * 0.15),
			Vector3(side * skull_w * 1.02, skull_center_y + h * 0.005,
				neck_top.z + skull_d * 0.50),
			skin_dark, 0.70
		)
	# Heavy brow ridge
	_build_box(
		root,
		Vector3(-skull_w * 1.04, skull_center_y + h * 0.025,
			neck_top.z + skull_d * 0.05),
		Vector3(skull_w * 1.04, skull_center_y + h * 0.065,
			neck_top.z + skull_d * 0.32),
		skin_dark, 0.70
	)

	# HOLLOW EYE SOCKETS with pale glow inside (skull-like)
	for side in [-1, 1]:
		# Socket recess (dark void)
		_build_box(
			root,
			Vector3(side * skull_w * 0.55 - w * 0.05,
				skull_center_y - h * 0.005, neck_top.z + skull_d * 0.18),
			Vector3(side * skull_w * 0.55 + w * 0.05,
				skull_center_y + h * 0.035, neck_top.z + skull_d * 0.28),
			hollow_dark, 0.85
		)
		# Pale glow inside
		_build_box(
			root,
			Vector3(side * skull_w * 0.55 - w * 0.018,
				skull_center_y + h * 0.005, neck_top.z + skull_d * 0.26),
			Vector3(side * skull_w * 0.55 + w * 0.018,
				skull_center_y + h * 0.025, neck_top.z + skull_d * 0.30),
			eye_glow, 0.05, 0.0
		)

	# JAW — wide skeletal fanged maw
	var jaw_y_top: float = skull_y_bot + h * 0.01
	var jaw_y_bot: float = jaw_y_top - h * 0.06
	_build_box(
		root,
		Vector3(-skull_w * 0.55, jaw_y_bot,
			neck_top.z + skull_d * 0.30),
		Vector3(skull_w * 0.55, jaw_y_top,
			neck_top.z + skull_d * 0.83),
		skin_dark, 0.70
	)
	# Inner mouth dark
	_build_box(
		root,
		Vector3(-skull_w * 0.45, jaw_y_bot + h * 0.005,
			neck_top.z + skull_d * 0.35),
		Vector3(skull_w * 0.45, jaw_y_top - h * 0.005,
			neck_top.z + skull_d * 0.78),
		hollow_dark, 0.85
	)
	# Bared teeth — 5 prominent upper
	for ti in range(5):
		var tt: float = float(ti) / 4.0
		var tx: float = lerpf(-skull_w * 0.45, skull_w * 0.45, tt)
		var is_canine: bool = ti == 0 or ti == 4
		var tooth_h: float = h * (0.045 if is_canine else 0.025)
		_build_tapered_segment(root,
			Vector3(tx, jaw_y_top, neck_top.z + skull_d * 0.50), w * 0.014,
			Vector3(tx, jaw_y_top - tooth_h, neck_top.z + skull_d * 0.55),
			w * 0.003,
			bone_white, 0.45)

	# ============================================================================
	# SCAPULAR BONE SPIKES + SPINAL RIDGE — replaces non-canon wings.
	# Verify-agent fix: osyluth has NO wings in any edition (1e-5e);
	# wings were conflating with gelugon. Now wingless skeletal with
	# bony shoulder blades + jagged upper-back spine spikes.
	# ============================================================================
	# Sweeping scapular bone spikes back from each shoulder blade
	for side in [-1, 1]:
		var scap_base := Vector3(side * w * 0.42, shoulder_y + h * 0.02, -d * 0.18)
		var scap_mid := Vector3(side * w * 0.50, shoulder_y + h * 0.12, -d * 0.32)
		var scap_tip := Vector3(side * w * 0.42, shoulder_y - h * 0.05, -d * 0.48)
		_build_tapered_segment(root, scap_base, w * 0.06, scap_mid, w * 0.035,
			bone_white, 0.60)
		_build_tapered_segment(root, scap_mid, w * 0.035, scap_tip, w * 0.008,
			bone_white, 0.60)
		# Secondary smaller bone shard alongside
		_build_tapered_segment(root,
			scap_base + Vector3(side * w * 0.05, h * 0.04, -d * 0.05),
			w * 0.030,
			scap_base + Vector3(side * w * 0.14, h * 0.14, -d * 0.15),
			w * 0.005,
			bone_white, 0.60)
	# Jagged spinal ridge — 5 bony nubs down the upper back
	for ri in range(5):
		var rt: float = float(ri) / 4.0
		var ry: float = lerpf(shoulder_y - h * 0.01, chest_y + h * 0.02, rt)
		var rz: float = -d * lerpf(0.30, 0.26, rt)
		var nub_h: float = h * lerpf(0.05, 0.025, rt)
		_build_tapered_segment(root,
			Vector3(0, ry, rz), w * 0.025,
			Vector3(0, ry + nub_h, rz - h * 0.01), w * 0.005,
			bone_white, 0.60)

	# ============================================================================
	# ARMS — long gaunt skeletal arms with hooked claws
	# ============================================================================
	for side in [-1, 1]:
		var shoulder := Vector3(side * w * 0.42, shoulder_y - h * 0.02, 0.0)
		# SHOULDER BONE SPIKE — outward + up
		_build_tapered_segment(root,
			shoulder + Vector3(side * w * 0.03, h * 0.04, -d * 0.03), w * 0.045,
			shoulder + Vector3(side * w * 0.20, h * 0.15, -d * 0.10), w * 0.005,
			bone_white, 0.60)
		# Long thin upper arm
		var elbow := Vector3(side * w * 0.55, shoulder_y - h * 0.22, d * 0.05)
		var wrist := Vector3(side * w * 0.50, shoulder_y - h * 0.42, d * 0.20)
		_build_tapered_segment(root, shoulder, w * 0.09, elbow, w * 0.07, primary, 0.65)
		_build_tapered_segment(root, elbow, w * 0.07, wrist, w * 0.06, primary, 0.65)
		# ELBOW BONE SPIKE — backward
		_build_tapered_segment(root,
			elbow, w * 0.040,
			elbow + Vector3(side * w * 0.05, -h * 0.05, -d * 0.10), w * 0.005,
			bone_white, 0.60)
		# Hand palm (small)
		_build_box(
			root,
			Vector3(wrist.x - w * 0.06, wrist.y - h * 0.04, wrist.z - d * 0.04),
			Vector3(wrist.x + w * 0.06, wrist.y + h * 0.01, wrist.z + d * 0.07),
			skin_dark, 0.65
		)
		# 3 LONG HOOKED CLAWS + thumb claw — canon osyluth has 4 digits total
		# (verify-agent fix: was 5; reduced to 3 fingers + thumb, ~15% longer)
		for ci in range(3):
			var ct: float = (float(ci) - 1.0) / 1.5     # -0.67, 0, +0.67
			var cx: float = wrist.x + ct * w * 0.04
			var claw_tip := Vector3(cx + ct * w * 0.05,
				wrist.y - h * 0.115,           # +15% length
				wrist.z + d * 0.255)            # +15% reach
			_build_tapered_segment(root,
				Vector3(cx, wrist.y - h * 0.03, wrist.z + d * 0.07), w * 0.015,
				claw_tip, w * 0.003,
				claw_color, 0.40)
		# Thumb claw
		var thumb_tip := Vector3(wrist.x - side * w * 0.05,
			wrist.y - h * 0.05, wrist.z + d * 0.12)
		_build_tapered_segment(root,
			Vector3(wrist.x - side * w * 0.04, wrist.y, wrist.z + d * 0.02),
			w * 0.013,
			thumb_tip, w * 0.003,
			claw_color, 0.40)

	# ============================================================================
	# LEGS — long gaunt skeletal legs ending in clawed feet
	# ============================================================================
	for side in [-1, 1]:
		var hip := Vector3(side * w * 0.18, hip_y + h * 0.02, 0.0)
		var knee := Vector3(side * w * 0.22, clearance * 0.55, d * 0.05)
		var ankle := Vector3(side * w * 0.18, clearance * 0.18, -d * 0.05)
		var foot := Vector3(side * w * 0.18, 0.05, d * 0.05)
		_build_tapered_segment(root, hip, w * 0.13, knee, w * 0.10, primary, 0.65)
		# KNEE BONE SPIKE — forward
		_build_tapered_segment(root,
			knee, w * 0.040,
			knee + Vector3(side * w * 0.03, h * 0.02, d * 0.12), w * 0.005,
			bone_white, 0.60)
		_build_tapered_segment(root, knee, w * 0.10, ankle, w * 0.08, primary, 0.65)
		_build_tapered_segment(root, ankle, w * 0.08, foot, w * 0.075,
			skin_dark, 0.65)
		# Foot pad
		_build_box(
			root,
			Vector3(side * w * 0.18 - w * 0.09, 0.0, -d * 0.05),
			Vector3(side * w * 0.18 + w * 0.09, h * 0.04, d * 0.18),
			skin_dark, 0.65
		)
		# 3 forward toe claws
		for ti in range(3):
			var to: float = (float(ti) - 1.0) * w * 0.055
			_build_tapered_segment(root,
				Vector3(side * w * 0.18 + to, h * 0.025, d * 0.16), w * 0.020,
				Vector3(side * w * 0.18 + to, 0.0, d * 0.30),
				w * 0.004,
				claw_color, 0.40)

	# ============================================================================
	# SCORPION STING TAIL — SIGNATURE FEATURE
	# Long segmented tail arching UP and OVER the body to point forward
	# Built from 6 segments + bulbous venom sac + curved sting at the tip.
	# ============================================================================
	# Tail base at lower back
	var t_root := Vector3(0, hip_y + h * 0.06, -d * 0.18)
	# 6 control points in an arching curve (up over the body)
	var tail_points: Array = []
	tail_points.append(t_root)
	tail_points.append(Vector3(0, hip_y + h * 0.30, -d * 0.30))
	tail_points.append(Vector3(0, hip_y + h * 0.55, -d * 0.40))
	tail_points.append(Vector3(0, hip_y + h * 0.80, -d * 0.25))
	tail_points.append(Vector3(0, hip_y + h * 0.95, 0.0))
	tail_points.append(Vector3(0, hip_y + h * 0.85, d * 0.15))   # arches over head
	tail_points.append(Vector3(0, hip_y + h * 0.70, d * 0.30))   # comes forward
	# Segmented tail — taper from thick base to thin near sting
	for ti in range(tail_points.size() - 1):
		var t0: float = float(ti) / float(tail_points.size() - 2)
		var t1: float = float(ti + 1) / float(tail_points.size() - 2)
		var r0: float = lerpf(w * 0.14, w * 0.06, t0) * sting_size_jitter
		var r1: float = lerpf(w * 0.14, w * 0.06, t1) * sting_size_jitter
		# Segment body
		_build_tapered_segment(root,
			tail_points[ti] as Vector3, r0,
			tail_points[ti + 1] as Vector3, r1,
			primary, 0.65)
		# Ring band at each joint (visible segmentation — signature scorpion look)
		var joint: Vector3 = tail_points[ti + 1] as Vector3
		_build_box(
			root,
			joint + Vector3(-r1 * 1.10, -r1 * 0.20, -r1 * 1.10),
			joint + Vector3(r1 * 1.10, r1 * 0.20, r1 * 1.10),
			skin_dark, 0.70
		)
	# BULBOUS VENOM SAC at the second-to-last point
	var venom_pos: Vector3 = tail_points[tail_points.size() - 1] as Vector3
	_build_box(
		root,
		venom_pos + Vector3(-w * 0.10, -h * 0.06, -d * 0.06),
		venom_pos + Vector3(w * 0.10, h * 0.06, d * 0.06),
		primary, 0.65
	)
	# CURVED STING — sharp curved point continuing forward from the venom sac
	var sting_base := venom_pos
	var sting_mid := sting_base + Vector3(0, -h * 0.05, d * 0.12)
	var sting_tip := sting_base + Vector3(0, -h * 0.18, d * 0.20)
	_build_tapered_segment(root, sting_base, w * 0.045, sting_mid, w * 0.020,
		sting_dark, 0.50)
	_build_tapered_segment(root, sting_mid, w * 0.020, sting_tip, w * 0.003,
		Color(0.08, 0.06, 0.04), 0.40)
	# Venom drip from sting tip
	_build_tapered_segment(root,
		sting_tip, w * 0.012,
		sting_tip + Vector3(0, -h * 0.04, 0), w * 0.004,
		venom_color, 0.10, 0.0)


# ============================================================================
# BRASS DRAGON WYRMLING (brass_dragon_wyrmling)
# Metallic dragon — friendly desert-dweller with talkative reputation.
#   - BRASS / COPPER METALLIC scales (signature)
#   - SIGNATURE CHIN FRILL — large fan-shaped fin under the jaw (THE id)
#   - FLAT-PLATE HEAD SHELF (dorsal crown plate behind eyes)
#   - Long backward-curving HORNS from temples (single pair, swept back)
#   - Fire AND sleep breath weapons (canon)
#   - Sandy desert belly
#   - Slim build (more lean than the chunky red/gold dragons)
# ============================================================================

static func _build_brass_dragon_wyrmling(plan: Dictionary, root: Node3D) -> void:
	var base: Dictionary = plan.get("base", {})
	var palette: Dictionary = plan.get("palette", {})
	var limbs: Dictionary = plan.get("limbs", {})
	var meta: Dictionary = plan.get("meta", {})
	var species: String = String(meta.get("species", "Brass Dragon Wyrmling"))

	# Brass dragons are slim/lean compared to chunky chromatics; size scales.
	var species_lower: String = species.to_lower()
	var is_adult: bool = ("adult" in species_lower) or ("ancient" in species_lower)
	var is_young: bool = "young" in species_lower
	var base_scale: float = 1.0
	if is_adult:
		base_scale = 2.6
	elif is_young:
		base_scale = 1.7

	var w: float = _axis(base, "width", 0.62 * base_scale)
	var h: float = _axis(base, "height", 0.72 * base_scale)
	var d: float = _axis(base, "depth", 1.85 * base_scale)
	var leg_length: float = float(limbs.get("leg_length", 0.42 * base_scale))
	var clearance: float = leg_length

	var render_seed: int = int(meta.get("render_seed", 0))
	var rng := RandomNumberGenerator.new()
	rng.seed = render_seed if render_seed != 0 else hash(species)

	# Per-individual variation
	var size_jitter: float = rng.randf_range(0.92, 1.15)
	var frill_size_jitter: float = rng.randf_range(0.85, 1.30)
	var wing_open_jitter: float = rng.randf_range(0.50, 1.00)
	var spine_count_jitter: int = rng.randi_range(7, 10)
	w *= size_jitter
	h *= size_jitter
	d *= size_jitter
	leg_length *= rng.randf_range(0.92, 1.10)
	clearance = leg_length

	# Brass scale palette — canon brass / warm copper / dull bronze with
	# slight age shift toward verdigris in the oldest individuals.
	var scale_options := [
		Color(0.85, 0.65, 0.25),     # polished brass (canon)
		Color(0.72, 0.50, 0.18),     # tarnished brass
		Color(0.78, 0.55, 0.22),     # warm bronze
		Color(0.62, 0.42, 0.18),     # darker copper
		Color(0.88, 0.72, 0.30),     # bright gold-brass
	]
	var primary: Color = scale_options[rng.randi() % scale_options.size()]
	var scale_dark: Color = primary.darkened(0.30)
	var belly_color := Color(0.85, 0.75, 0.55)              # warm sandy belly
	var horn_color := Color(0.45, 0.30, 0.15)               # darker brass horn
	var horn_dark: Color = horn_color.darkened(0.20)
	var claw_color := Color(0.20, 0.15, 0.10)
	var fang_color := Color(0.92, 0.88, 0.75)
	var eye_color := Color(0.85, 0.55, 0.10)                # amber/copper eyes (canon)

	# ============================================================================
	# BODY — slim sinuous trunk, slightly more refined than chromatics
	# ============================================================================
	var body_y: float = clearance + h * 0.30
	var body_sections: Array = [
		{"center": Vector3(0, body_y - h * 0.03, -d * 0.44), "w": w * 0.22, "h": h * 0.24},
		{"center": Vector3(0, body_y, -d * 0.28), "w": w * 0.38, "h": h * 0.38},
		{"center": Vector3(0, body_y, -d * 0.10), "w": w * 0.46, "h": h * 0.44},
		{"center": Vector3(0, body_y + h * 0.02, d * 0.08), "w": w * 0.48, "h": h * 0.46},   # mid widest
		{"center": Vector3(0, body_y + h * 0.03, d * 0.22), "w": w * 0.42, "h": h * 0.42},
		{"center": Vector3(0, body_y + h * 0.05, d * 0.36), "w": w * 0.32, "h": h * 0.36},
		{"center": Vector3(0, body_y + h * 0.10, d * 0.48), "w": w * 0.24, "h": h * 0.28},   # neck base
	]
	# Metallic finish: bump metallic when using _swept_body via brighter belly
	_swept_body(root, body_sections, 10, primary, belly_color, 0.40, true)

	# ============================================================================
	# HEAD — distinctive FLAT DORSAL PLATE behind the eyes (canon brass shelf)
	# ============================================================================
	var neck_base := (body_sections[6]["center"] as Vector3)
	var neck_mid := Vector3(0, neck_base.y + h * 0.10, neck_base.z + d * 0.10)
	var head_anchor := Vector3(0, neck_base.y + h * 0.18, neck_base.z + d * 0.22)
	_build_tapered_segment(root, neck_base, w * 0.20, neck_mid, w * 0.17, primary, 0.40)
	_build_tapered_segment(root, neck_mid, w * 0.17, head_anchor, w * 0.20, primary, 0.40)

	var skull_w: float = w * 0.30
	var skull_h: float = h * 0.28
	var skull_d: float = d * 0.26
	var skull_y_bot: float = head_anchor.y - skull_h * 0.40
	var skull_y_top: float = skull_y_bot + skull_h
	var skull_center_y: float = (skull_y_bot + skull_y_top) * 0.5
	# Skull
	_build_box(
		root,
		Vector3(-skull_w, skull_y_bot, head_anchor.z - skull_d * 0.30),
		Vector3(skull_w, skull_y_top, head_anchor.z + skull_d * 0.30),
		primary, 0.40
	)
	# FLAT DORSAL HEAD PLATE — distinctive shelf extending back from skull crown
	# (canon brass dragon "plowshare" feature; canon also has the plate's rear
	# edge curving UP into two points — built as separate tapered horns below).
	_build_box(
		root,
		Vector3(-skull_w * 1.15, skull_y_top - h * 0.008,
			head_anchor.z - skull_d * 0.70),
		Vector3(skull_w * 1.15, skull_y_top + h * 0.025,
			head_anchor.z + skull_d * 0.15),
		primary, 0.40
	)
	# PLOWSHARE POINTS — the two upward-curving points at the rear corners
	# of the head plate (verify-agent HIGH-impact fix: this IS the canon
	# brass "horns" rather than a separate temple horn pair).
	for pside in [-1, 1]:
		var plow_base := Vector3(pside * skull_w * 1.05,
			skull_y_top + h * 0.020,
			head_anchor.z - skull_d * 0.65)
		# Tip raised ~0.25× head height, angled outward ~20°
		var plow_tip := Vector3(pside * skull_w * 1.30,
			skull_y_top + h * 0.25,
			head_anchor.z - skull_d * 0.70)
		_build_tapered_segment(root, plow_base, w * 0.060, plow_tip, w * 0.010,
			horn_color, 0.55)
	# Snout — long crocodilian
	_build_box(
		root,
		Vector3(-skull_w * 0.70, skull_y_bot + h * 0.02,
			head_anchor.z + skull_d * 0.30 - d * 0.005),
		Vector3(skull_w * 0.70, skull_y_top - h * 0.05,
			head_anchor.z + skull_d * 1.25),
		primary, 0.40
	)
	# Heavy brow ridge
	_build_box(
		root,
		Vector3(-skull_w * 1.05, skull_center_y + h * 0.04,
			head_anchor.z - skull_d * 0.05),
		Vector3(skull_w * 1.05, skull_center_y + h * 0.09,
			head_anchor.z + skull_d * 0.30),
		scale_dark, 0.45
	)
	# Nostril dimples
	for side in [-1, 1]:
		_build_box(
			root,
			Vector3(side * skull_w * 0.25 - w * 0.020,
				skull_y_top - h * 0.10, head_anchor.z + skull_d * 1.15),
			Vector3(side * skull_w * 0.25 + w * 0.020,
				skull_y_top - h * 0.06, head_anchor.z + skull_d * 1.23),
			scale_dark, 0.45
		)
	# AMBER/COPPER EYES with slit pupils
	for side in [-1, 1]:
		_build_box(
			root,
			Vector3(side * skull_w * 0.55 - w * 0.05,
				skull_center_y - h * 0.005, head_anchor.z + skull_d * 0.12),
			Vector3(side * skull_w * 0.55 + w * 0.05,
				skull_center_y + h * 0.035, head_anchor.z + skull_d * 0.28),
			eye_color, 0.20, 0.0
		)
		_build_box(
			root,
			Vector3(side * skull_w * 0.55 - w * 0.008,
				skull_center_y + h * 0.0, head_anchor.z + skull_d * 0.22),
			Vector3(side * skull_w * 0.55 + w * 0.008,
				skull_center_y + h * 0.035, head_anchor.z + skull_d * 0.28),
			Color(0.10, 0.06, 0.02), 0.30
		)

	# JAW
	var jaw_y_top: float = skull_y_bot + h * 0.04
	var jaw_y_bot: float = skull_y_bot - h * 0.05
	_build_box(
		root,
		Vector3(-skull_w * 0.65, jaw_y_bot,
			head_anchor.z + skull_d * 0.10),
		Vector3(skull_w * 0.65, jaw_y_top,
			head_anchor.z + skull_d * 1.20),
		scale_dark, 0.45
	)
	_build_box(
		root,
		Vector3(-skull_w * 0.50, jaw_y_bot + h * 0.005,
			head_anchor.z + skull_d * 0.18),
		Vector3(skull_w * 0.50, jaw_y_top - h * 0.005,
			head_anchor.z + skull_d * 1.15),
		Color(0.20, 0.10, 0.06), 0.85
	)
	# Upper canines
	for side in [-1, 1]:
		var fx_c: float = side * skull_w * 0.45
		_build_tapered_segment(root,
			Vector3(fx_c, jaw_y_top, head_anchor.z + skull_d * 0.50), w * 0.026,
			Vector3(fx_c, jaw_y_top - h * 0.05, head_anchor.z + skull_d * 0.55), w * 0.005,
			fang_color, 0.45)

	# ============================================================================
	# SIGNATURE CHIN FRILL — large fan-shaped fin hanging under the jaw
	# (THE brass dragon identifier — sets it apart from all other dragons)
	# Built as a tri-membrane fan with bone struts forming the rib pattern.
	# ============================================================================
	var frill_root := Vector3(0, jaw_y_bot - h * 0.005,
		head_anchor.z + skull_d * 0.65)
	# Fan spans down + slightly back from the lower jaw
	for fside in [-1, 1]:
		var f_outer_top := Vector3(fside * skull_w * 0.65,
			jaw_y_bot - h * 0.015,
			head_anchor.z + skull_d * 0.50)
		var f_outer_mid := Vector3(fside * skull_w * (1.10 * frill_size_jitter),
			jaw_y_bot - h * (0.28 * frill_size_jitter),
			head_anchor.z + skull_d * 0.45)
		var f_outer_bot := Vector3(fside * skull_w * (0.70 * frill_size_jitter),
			jaw_y_bot - h * (0.40 * frill_size_jitter),
			head_anchor.z + skull_d * 0.55)
		# Membrane (4 panels)
		var st_f := SurfaceTool.new()
		st_f.begin(Mesh.PRIMITIVE_TRIANGLES)
		_add_tri(st_f, frill_root, f_outer_top, f_outer_mid)
		_add_tri(st_f, frill_root, f_outer_mid, f_outer_bot)
		st_f.generate_normals()
		var mi_f := MeshInstance3D.new()
		mi_f.mesh = st_f.commit()
		var mat_f := StandardMaterial3D.new()
		mat_f.albedo_color = primary.darkened(0.10)
		mat_f.roughness = 0.50
		mat_f.metallic = 0.40
		mat_f.cull_mode = BaseMaterial3D.CULL_DISABLED
		mi_f.material_override = mat_f
		root.add_child(mi_f)
		# Bone ribs along the fan
		_build_tapered_segment(root, frill_root, w * 0.018, f_outer_top, w * 0.006,
			horn_dark, 0.55)
		_build_tapered_segment(root, frill_root, w * 0.022, f_outer_mid, w * 0.005,
			horn_dark, 0.55)
		_build_tapered_segment(root, frill_root, w * 0.018, f_outer_bot, w * 0.006,
			horn_dark, 0.55)

	# ============================================================================
	# CHIN HORNS — canon brass dragons have "two sharp horns on the chin"
	# that sharpen with age. Verify-agent fix: temple horns removed (they were
	# duplicating the plowshare-plate silhouette role); chin horns added.
	# Scale with age via base_scale (wyrmling small → adult large).
	# ============================================================================
	var chin_horn_scale: float = lerpf(0.3, 1.0, clamp((base_scale - 1.0) / 1.6, 0.0, 1.0))
	for side in [-1, 1]:
		var chin_base := Vector3(side * skull_w * 0.25,
			jaw_y_bot - h * 0.005,
			head_anchor.z + skull_d * 0.95)
		# Forward-angled bone spike, sharpens (longer) with age
		var chin_tip := Vector3(side * skull_w * 0.30,
			jaw_y_bot - h * (0.10 * chin_horn_scale),
			head_anchor.z + skull_d * (1.05 + 0.20 * chin_horn_scale))
		_build_tapered_segment(root, chin_base, w * 0.030, chin_tip, w * 0.006,
			horn_color, 0.55)

	# ============================================================================
	# DORSAL SPINE CREST — modest spikes along the spine
	# ============================================================================
	var crest_z_start: float = head_anchor.z + skull_d * 0.05
	var crest_z_end: float = -d * 0.42
	for si in range(spine_count_jitter):
		var st: float = float(si) / float(spine_count_jitter - 1)
		var sz: float = lerpf(crest_z_start, crest_z_end, st)
		var sy_top: float
		if sz > body_y * 0.0 and st < 0.30:
			sy_top = lerpf(skull_y_top - h * 0.04, body_y + h * 0.28, st / 0.30)
		else:
			sy_top = body_y + h * 0.28
		var height_factor: float = 1.0 - pow(abs(st - 0.50) * 2.0, 1.3)
		var spike_h: float = h * lerpf(0.05, 0.13, max(0.0, height_factor))
		_build_tapered_segment(root,
			Vector3(0, sy_top, sz), w * 0.025,
			Vector3(0, sy_top + spike_h, sz - h * 0.02), w * 0.004,
			horn_dark, 0.55)

	# ============================================================================
	# WINGS — bat-wings, partial spread
	# ============================================================================
	var wing_spread: float = lerpf(0.6, 2.4, wing_open_jitter) * (1.6 if is_adult else 1.0)
	for side in [-1, 1]:
		var wing_root := Vector3(side * w * 0.50, body_y + h * 0.16, d * 0.05)
		var wing_elbow := Vector3(side * (w * 0.50 + wing_spread * 0.32),
			body_y + h * 0.28 + wing_spread * h * 0.10,
			-d * 0.05)
		var wing_peak := Vector3(side * (w * 0.50 + wing_spread * 0.90),
			body_y + h * 0.08 + wing_spread * h * 0.05,
			-d * (0.15 + wing_open_jitter * 0.10))
		_build_tapered_segment(root, wing_root, w * 0.08, wing_elbow, w * 0.055,
			scale_dark, 0.50)
		_build_tapered_segment(root, wing_elbow, w * 0.055, wing_peak, w * 0.025,
			scale_dark, 0.50)
		_build_tapered_segment(root, wing_peak, w * 0.020,
			wing_peak + Vector3(side * w * 0.06, h * 0.04, d * 0.02), w * 0.004,
			claw_color, 0.40)
		var struts: int = 4
		var trail_points: Array = []
		for fi in range(struts):
			var ft: float = float(fi) / float(struts - 1)
			var trail := Vector3(
				lerpf(side * w * 0.40, side * (w * 0.50 + wing_spread * 0.90), ft),
				body_y - h * lerpf(0.05, 0.0, ft) - wing_spread * h * 0.05,
				lerpf(-d * 0.30, -d * 0.15, ft) - wing_open_jitter * d * 0.10
			)
			trail_points.append(trail)
			_build_tapered_segment(root, wing_peak, w * 0.020, trail, w * 0.005,
				scale_dark, 0.50)
		# FLANK ANCHOR — canon brass/copper wings continue down to the body
		# flank/tail base. Verify-agent fix: standard bat-root-at-shoulder
		# only was too chromatic; add a body-side anchor at the hip and a
		# triangle panel joining the innermost wing strut to that anchor.
		var flank_anchor := Vector3(side * w * 0.32, body_y - h * 0.04, -d * 0.40)
		var st_flank := SurfaceTool.new()
		st_flank.begin(Mesh.PRIMITIVE_TRIANGLES)
		_add_tri(st_flank, wing_root, trail_points[0] as Vector3, flank_anchor)
		st_flank.generate_normals()
		var mi_flank := MeshInstance3D.new()
		mi_flank.mesh = st_flank.commit()
		var mat_flank := StandardMaterial3D.new()
		mat_flank.albedo_color = scale_dark.darkened(0.10)
		mat_flank.roughness = 0.65
		mat_flank.cull_mode = BaseMaterial3D.CULL_DISABLED
		mi_flank.material_override = mat_flank
		root.add_child(mi_flank)
		# Main wing membrane (3 panels)
		var st_mem := SurfaceTool.new()
		st_mem.begin(Mesh.PRIMITIVE_TRIANGLES)
		_add_quad(st_mem, wing_root, wing_elbow,
			trail_points[1] as Vector3, trail_points[0] as Vector3)
		_add_quad(st_mem, wing_elbow, wing_peak,
			trail_points[2] as Vector3, trail_points[1] as Vector3)
		_add_tri(st_mem, wing_peak,
			trail_points[3] as Vector3, trail_points[2] as Vector3)
		st_mem.generate_normals()
		var mi_mem := MeshInstance3D.new()
		mi_mem.mesh = st_mem.commit()
		var mat_mem := StandardMaterial3D.new()
		mat_mem.albedo_color = scale_dark.darkened(0.10)
		mat_mem.roughness = 0.65
		mat_mem.cull_mode = BaseMaterial3D.CULL_DISABLED
		mi_mem.material_override = mat_mem
		root.add_child(mi_mem)

	# ============================================================================
	# LEGS — 4 lithe clawed dragon legs (slimmer than chromatic stocky)
	# ============================================================================
	for side in [-1, 1]:
		var fhip := Vector3(side * w * 0.30, body_y + h * 0.02, d * 0.18)
		var fknee := Vector3(side * w * 0.32, clearance * 0.55, d * 0.20)
		var fpaw := Vector3(side * w * 0.28, 0.05, d * 0.22)
		_build_tapered_segment(root, fhip, w * 0.13, fknee, w * 0.10, primary, 0.40)
		_build_tapered_segment(root, fknee, w * 0.10, fpaw, w * 0.09, scale_dark, 0.45)
		_build_box(
			root,
			Vector3(side * w * 0.28 - w * 0.12, 0.0, d * 0.15),
			Vector3(side * w * 0.28 + w * 0.12, h * 0.07, d * 0.30),
			scale_dark, 0.45
		)
		for ci in range(4):
			var co: float = (float(ci) - 1.5) * w * 0.05
			_build_tapered_segment(root,
				Vector3(side * w * 0.28 + co, h * 0.03, d * 0.30), w * 0.020,
				Vector3(side * w * 0.28 + co, 0.0, d * 0.40), w * 0.004,
				claw_color, 0.40)
		var rhip := Vector3(side * w * 0.30, body_y - h * 0.02, -d * 0.18)
		var rknee := Vector3(side * w * 0.34, clearance * 0.60, -d * 0.10)
		var rhock := Vector3(side * w * 0.30, clearance * 0.25, -d * 0.20)
		var rpaw := Vector3(side * w * 0.28, 0.05, -d * 0.12)
		_build_tapered_segment(root, rhip, w * 0.15, rknee, w * 0.11, primary, 0.40)
		_build_tapered_segment(root, rknee, w * 0.11, rhock, w * 0.10, primary, 0.40)
		_build_tapered_segment(root, rhock, w * 0.10, rpaw, w * 0.10, scale_dark, 0.45)
		_build_box(
			root,
			Vector3(side * w * 0.28 - w * 0.11, 0.0, -d * 0.20),
			Vector3(side * w * 0.28 + w * 0.11, h * 0.07, -d * 0.04),
			scale_dark, 0.45
		)
		for ci in range(4):
			var co: float = (float(ci) - 1.5) * w * 0.045
			_build_tapered_segment(root,
				Vector3(side * w * 0.28 + co, h * 0.03, -d * 0.04), w * 0.018,
				Vector3(side * w * 0.28 + co, 0.0, d * 0.04), w * 0.004,
				claw_color, 0.40)

	# ============================================================================
	# TAIL — long whip-like with continuing crest
	# ============================================================================
	var tail_base := Vector3(0, body_y - h * 0.02, -d * 0.44)
	var tail_q1 := Vector3(rng.randf_range(-w * 0.10, w * 0.10),
		body_y - h * 0.08, -d * 0.85)
	var tail_q2 := Vector3(rng.randf_range(-w * 0.20, w * 0.20),
		body_y - h * 0.16, -d * 1.30)
	var tail_tip := Vector3(rng.randf_range(-w * 0.30, w * 0.30),
		body_y - h * 0.24, -d * 1.75)
	_build_tapered_segment(root, tail_base, w * 0.18, tail_q1, w * 0.11,
		primary, 0.40)
	_build_tapered_segment(root, tail_q1, w * 0.11, tail_q2, w * 0.055,
		scale_dark, 0.45)
	_build_tapered_segment(root, tail_q2, w * 0.055, tail_tip, w * 0.010,
		scale_dark, 0.45)


# ============================================================================
# BRONZE DRAGON WYRMLING (bronze_dragon_wyrmling)
# Metallic dragon — coastal sea-dweller with lightning breath.
#   - BRONZE / COPPER-RED scales (richer/redder than brass)
#   - Single forward-jutting BLADE-LIKE HEAD CREST (signature)
#   - Smaller paired CHEEK FRILLS / scallops on either side of the jaw
#   - WEBBED FEET (ocean dweller)
#   - Lightning breath (built-in 0-2 arcs in maw)
#   - Ridged horns sweeping back from temples
#   - Wings anchored to flank like brass (metallic family trait)
# ============================================================================

static func _build_bronze_dragon_wyrmling(plan: Dictionary, root: Node3D) -> void:
	var base: Dictionary = plan.get("base", {})
	var palette: Dictionary = plan.get("palette", {})
	var limbs: Dictionary = plan.get("limbs", {})
	var meta: Dictionary = plan.get("meta", {})
	var species: String = String(meta.get("species", "Bronze Dragon Wyrmling"))

	# Slightly chunkier than brass — bronzes are stockier coastal predators.
	var species_lower: String = species.to_lower()
	var is_adult: bool = ("adult" in species_lower) or ("ancient" in species_lower)
	var is_young: bool = "young" in species_lower
	var base_scale: float = 1.0
	if is_adult:
		base_scale = 2.6
	elif is_young:
		base_scale = 1.7

	var w: float = _axis(base, "width", 0.68 * base_scale)
	var h: float = _axis(base, "height", 0.78 * base_scale)
	var d: float = _axis(base, "depth", 1.90 * base_scale)
	var leg_length: float = float(limbs.get("leg_length", 0.45 * base_scale))
	var clearance: float = leg_length

	var render_seed: int = int(meta.get("render_seed", 0))
	var rng := RandomNumberGenerator.new()
	rng.seed = render_seed if render_seed != 0 else hash(species)

	# Per-individual variation
	var size_jitter: float = rng.randf_range(0.92, 1.15)
	var crest_size_jitter: float = rng.randf_range(0.90, 1.25)
	var wing_open_jitter: float = rng.randf_range(0.50, 1.00)
	var spine_count_jitter: int = rng.randi_range(7, 10)
	var lightning_count: int = rng.randi_range(0, 2)
	w *= size_jitter
	h *= size_jitter
	d *= size_jitter
	leg_length *= rng.randf_range(0.92, 1.10)
	clearance = leg_length

	# Bronze scale palette — redder/richer than brass
	var scale_options := [
		Color(0.70, 0.45, 0.20),     # bronze (canon)
		Color(0.80, 0.50, 0.22),     # warm copper
		Color(0.65, 0.38, 0.18),     # darker bronze
		Color(0.75, 0.48, 0.25),     # red-bronze
		Color(0.60, 0.40, 0.30),     # tarnished verdi-bronze
	]
	var primary: Color = scale_options[rng.randi() % scale_options.size()]
	var scale_dark: Color = primary.darkened(0.30)
	var belly_color := Color(0.55, 0.62, 0.45)              # sea-green tinted belly
	var horn_color := Color(0.35, 0.22, 0.12)
	var horn_dark: Color = horn_color.darkened(0.20)
	var claw_color := Color(0.15, 0.10, 0.06)
	var fang_color := Color(0.92, 0.88, 0.75)
	var eye_color := Color(0.20, 0.65, 0.70)                # sea-green/teal eyes (canon)
	# Lightning palette
	var lightning_outer := Color(0.55, 0.80, 1.00)
	var lightning_core := Color(0.95, 0.95, 1.00)

	# ============================================================================
	# BODY — robust stocky trunk (coastal predator)
	# ============================================================================
	var body_y: float = clearance + h * 0.30
	var body_sections: Array = [
		{"center": Vector3(0, body_y - h * 0.03, -d * 0.44), "w": w * 0.22, "h": h * 0.26},
		{"center": Vector3(0, body_y, -d * 0.28), "w": w * 0.40, "h": h * 0.40},
		{"center": Vector3(0, body_y, -d * 0.10), "w": w * 0.50, "h": h * 0.48},
		{"center": Vector3(0, body_y + h * 0.02, d * 0.08), "w": w * 0.54, "h": h * 0.52},   # mid widest
		{"center": Vector3(0, body_y + h * 0.04, d * 0.22), "w": w * 0.48, "h": h * 0.48},
		{"center": Vector3(0, body_y + h * 0.06, d * 0.36), "w": w * 0.36, "h": h * 0.40},
		{"center": Vector3(0, body_y + h * 0.10, d * 0.48), "w": w * 0.26, "h": h * 0.30},   # neck base
	]
	_swept_body(root, body_sections, 10, primary, belly_color, 0.40, true)

	# ============================================================================
	# HEAD
	# ============================================================================
	var neck_base := (body_sections[6]["center"] as Vector3)
	var neck_mid := Vector3(0, neck_base.y + h * 0.10, neck_base.z + d * 0.10)
	var head_anchor := Vector3(0, neck_base.y + h * 0.18, neck_base.z + d * 0.22)
	_build_tapered_segment(root, neck_base, w * 0.22, neck_mid, w * 0.19, primary, 0.40)
	_build_tapered_segment(root, neck_mid, w * 0.19, head_anchor, w * 0.22, primary, 0.40)

	var skull_w: float = w * 0.30
	var skull_h: float = h * 0.30
	var skull_d: float = d * 0.26
	var skull_y_bot: float = head_anchor.y - skull_h * 0.40
	var skull_y_top: float = skull_y_bot + skull_h
	var skull_center_y: float = (skull_y_bot + skull_y_top) * 0.5
	# Skull
	_build_box(
		root,
		Vector3(-skull_w, skull_y_bot, head_anchor.z - skull_d * 0.30),
		Vector3(skull_w, skull_y_top, head_anchor.z + skull_d * 0.30),
		primary, 0.40
	)
	# Snout
	_build_box(
		root,
		Vector3(-skull_w * 0.65, skull_y_bot + h * 0.02,
			head_anchor.z + skull_d * 0.30 - d * 0.005),
		Vector3(skull_w * 0.65, skull_y_top - h * 0.05,
			head_anchor.z + skull_d * 1.20),
		primary, 0.40
	)
	# Heavy brow
	_build_box(
		root,
		Vector3(-skull_w * 1.05, skull_center_y + h * 0.04,
			head_anchor.z - skull_d * 0.05),
		Vector3(skull_w * 1.05, skull_center_y + h * 0.09,
			head_anchor.z + skull_d * 0.30),
		scale_dark, 0.45
	)
	# Nostrils
	for side in [-1, 1]:
		_build_box(
			root,
			Vector3(side * skull_w * 0.25 - w * 0.020,
				skull_y_top - h * 0.10, head_anchor.z + skull_d * 1.10),
			Vector3(side * skull_w * 0.25 + w * 0.020,
				skull_y_top - h * 0.06, head_anchor.z + skull_d * 1.18),
			scale_dark, 0.45
		)
	# Sea-green/teal eyes (canon bronze)
	for side in [-1, 1]:
		_build_box(
			root,
			Vector3(side * skull_w * 0.55 - w * 0.05,
				skull_center_y - h * 0.005, head_anchor.z + skull_d * 0.12),
			Vector3(side * skull_w * 0.55 + w * 0.05,
				skull_center_y + h * 0.035, head_anchor.z + skull_d * 0.28),
			eye_color, 0.20, 0.0
		)
		_build_box(
			root,
			Vector3(side * skull_w * 0.55 - w * 0.008,
				skull_center_y + h * 0.0, head_anchor.z + skull_d * 0.22),
			Vector3(side * skull_w * 0.55 + w * 0.008,
				skull_center_y + h * 0.035, head_anchor.z + skull_d * 0.28),
			Color(0.05, 0.12, 0.10), 0.30
		)

	# ============================================================================
	# SIGNATURE NECK FRILL — large backward-sweeping fin from the base of the
	# skull, running DOWN along the upper neck. Verify-agent HIGH-severity fix:
	# the forward-jutting blade is BRASS, not bronze. Canon bronze has a
	# smooth ridged head topped by a neck frill swept rearward/downward.
	# ============================================================================
	# Frill anchor at base of skull, sweeping back along first 2-3 neck verts
	var frill_root := Vector3(0, skull_y_top - h * 0.010,
		head_anchor.z - skull_d * 0.25)
	# Lower trailing point sits down the neck behind the skull
	var frill_bot := Vector3(0, neck_mid.y - h * 0.08,
		neck_mid.z - d * 0.10)
	var frill_top := Vector3(0,
		skull_y_top + h * (0.20 * crest_size_jitter),
		head_anchor.z - skull_d * (0.45 + 0.15 * crest_size_jitter))
	var st_frill := SurfaceTool.new()
	st_frill.begin(Mesh.PRIMITIVE_TRIANGLES)
	_add_tri(st_frill, frill_root, frill_top, frill_bot)
	_add_tri(st_frill, frill_bot, frill_top, frill_root)
	st_frill.generate_normals()
	var mi_frill := MeshInstance3D.new()
	mi_frill.mesh = st_frill.commit()
	var mat_frill := StandardMaterial3D.new()
	mat_frill.albedo_color = primary
	mat_frill.roughness = 0.50
	mat_frill.metallic = 0.45
	mat_frill.cull_mode = BaseMaterial3D.CULL_DISABLED
	mi_frill.material_override = mat_frill
	root.add_child(mi_frill)
	# Bone struts on leading + trailing edges of the frill
	_build_tapered_segment(root, frill_root, w * 0.018, frill_top, w * 0.005,
		horn_dark, 0.55)
	_build_tapered_segment(root, frill_top, w * 0.005, frill_bot, w * 0.015,
		horn_dark, 0.55)

	# THREE BACKWARD-SWEEPING CHEEK HORN CLUSTER per side (canon bronze).
	# Verify-agent fix: small fan scallops replaced with 3 horn struts
	# pointing tailward at -30°, -50°, -70° from horizontal.
	for side in [-1, 1]:
		var cluster_base := Vector3(side * skull_w * 0.85,
			skull_center_y - h * 0.02,
			head_anchor.z + skull_d * 0.40)
		# 3 horns radiating back + outward at different pitch angles
		var pitches: Array = [-0.52, -0.87, -1.22]   # -30°, -50°, -70° in radians
		for hi in range(pitches.size()):
			var pitch: float = pitches[hi] as float
			var horn_len: float = w * (0.35 - float(hi) * 0.05)
			var horn_tip := cluster_base + Vector3(
				side * cos(pitch) * horn_len * 0.5,
				sin(pitch) * horn_len * 0.5,
				-cos(pitch) * horn_len * 1.2
			)
			_build_tapered_segment(root, cluster_base, w * 0.030, horn_tip, w * 0.006,
				horn_color, 0.55)

	# JAW
	var jaw_y_top: float = skull_y_bot + h * 0.04
	var jaw_y_bot: float = skull_y_bot - h * 0.05
	_build_box(
		root,
		Vector3(-skull_w * 0.65, jaw_y_bot,
			head_anchor.z + skull_d * 0.10),
		Vector3(skull_w * 0.65, jaw_y_top,
			head_anchor.z + skull_d * 1.18),
		scale_dark, 0.45
	)
	_build_box(
		root,
		Vector3(-skull_w * 0.50, jaw_y_bot + h * 0.005,
			head_anchor.z + skull_d * 0.18),
		Vector3(skull_w * 0.50, jaw_y_top - h * 0.005,
			head_anchor.z + skull_d * 1.13),
		Color(0.08, 0.18, 0.20), 0.85
	)
	for side in [-1, 1]:
		var fx_c: float = side * skull_w * 0.45
		_build_tapered_segment(root,
			Vector3(fx_c, jaw_y_top, head_anchor.z + skull_d * 0.50), w * 0.026,
			Vector3(fx_c, jaw_y_top - h * 0.05, head_anchor.z + skull_d * 0.55), w * 0.005,
			fang_color, 0.45)

	# Ridged horns sweeping back from temples
	for side in [-1, 1]:
		var horn_base := Vector3(side * skull_w * 0.92,
			skull_y_top - h * 0.005,
			head_anchor.z + skull_d * 0.05)
		var horn_tip := Vector3(side * skull_w * 1.00,
			skull_y_top + h * 0.10,
			head_anchor.z - skull_d * 0.50)
		_build_tapered_segment(root, horn_base, w * 0.045, horn_tip, w * 0.010,
			horn_color, 0.55)

	# ============================================================================
	# LIGHTNING TONGUES — 0-2 small arcs escaping the maw
	# ============================================================================
	for li in range(lightning_count):
		var l_base := Vector3(rng.randf_range(-skull_w * 0.25, skull_w * 0.25),
			skull_center_y - h * 0.005, head_anchor.z + skull_d * 1.10)
		var l_mid := Vector3(l_base.x + rng.randf_range(-w * 0.08, w * 0.08),
			l_base.y + rng.randf_range(-h * 0.05, h * 0.10),
			l_base.z + d * 0.10)
		var l_tip := Vector3(l_mid.x + rng.randf_range(-w * 0.15, w * 0.15),
			l_mid.y + rng.randf_range(-h * 0.05, h * 0.15),
			l_mid.z + d * 0.15)
		_build_tapered_segment(root, l_base, w * 0.025, l_mid, w * 0.015,
			lightning_outer, 0.05, 0.0)
		_build_tapered_segment(root, l_mid, w * 0.015, l_tip, w * 0.005,
			lightning_outer, 0.05, 0.0)
		_build_tapered_segment(root, l_base, w * 0.012, l_mid, w * 0.008,
			lightning_core, 0.05, 0.0)
		_build_tapered_segment(root, l_mid, w * 0.008, l_tip, w * 0.003,
			lightning_core, 0.05, 0.0)

	# ============================================================================
	# DORSAL SPINE CREST
	# ============================================================================
	var crest_z_start: float = head_anchor.z + skull_d * 0.05
	var crest_z_end: float = -d * 0.42
	for si in range(spine_count_jitter):
		var st_t: float = float(si) / float(spine_count_jitter - 1)
		var sz: float = lerpf(crest_z_start, crest_z_end, st_t)
		var sy_top: float
		if sz > body_y * 0.0 and st_t < 0.30:
			sy_top = lerpf(skull_y_top - h * 0.04, body_y + h * 0.28, st_t / 0.30)
		else:
			sy_top = body_y + h * 0.28
		var height_factor: float = 1.0 - pow(abs(st_t - 0.50) * 2.0, 1.3)
		var spike_h: float = h * lerpf(0.05, 0.14, max(0.0, height_factor))
		_build_tapered_segment(root,
			Vector3(0, sy_top, sz), w * 0.025,
			Vector3(0, sy_top + spike_h, sz - h * 0.02), w * 0.004,
			horn_dark, 0.55)

	# ============================================================================
	# WINGS — bat-wings with metallic-family flank anchor
	# ============================================================================
	var wing_spread: float = lerpf(0.6, 2.4, wing_open_jitter) * (1.6 if is_adult else 1.0)
	for side in [-1, 1]:
		var wing_root := Vector3(side * w * 0.52, body_y + h * 0.16, d * 0.05)
		var wing_elbow := Vector3(side * (w * 0.52 + wing_spread * 0.32),
			body_y + h * 0.28 + wing_spread * h * 0.10,
			-d * 0.05)
		var wing_peak := Vector3(side * (w * 0.52 + wing_spread * 0.90),
			body_y + h * 0.08 + wing_spread * h * 0.05,
			-d * (0.15 + wing_open_jitter * 0.10))
		_build_tapered_segment(root, wing_root, w * 0.08, wing_elbow, w * 0.055,
			scale_dark, 0.50)
		_build_tapered_segment(root, wing_elbow, w * 0.055, wing_peak, w * 0.025,
			scale_dark, 0.50)
		_build_tapered_segment(root, wing_peak, w * 0.020,
			wing_peak + Vector3(side * w * 0.06, h * 0.04, d * 0.02), w * 0.004,
			claw_color, 0.40)
		var struts: int = 4
		var trail_points: Array = []
		for fi in range(struts):
			var ft: float = float(fi) / float(struts - 1)
			var trail := Vector3(
				lerpf(side * w * 0.40, side * (w * 0.52 + wing_spread * 0.90), ft),
				body_y - h * lerpf(0.05, 0.0, ft) - wing_spread * h * 0.05,
				lerpf(-d * 0.30, -d * 0.15, ft) - wing_open_jitter * d * 0.10
			)
			trail_points.append(trail)
			_build_tapered_segment(root, wing_peak, w * 0.020, trail, w * 0.005,
				scale_dark, 0.50)
		# Flank anchor (metallic family — wings continue to body flank)
		var flank_anchor := Vector3(side * w * 0.32, body_y - h * 0.04, -d * 0.40)
		var st_flank := SurfaceTool.new()
		st_flank.begin(Mesh.PRIMITIVE_TRIANGLES)
		_add_tri(st_flank, wing_root, trail_points[0] as Vector3, flank_anchor)
		st_flank.generate_normals()
		var mi_flank := MeshInstance3D.new()
		mi_flank.mesh = st_flank.commit()
		var mat_flank := StandardMaterial3D.new()
		mat_flank.albedo_color = scale_dark.darkened(0.10)
		mat_flank.roughness = 0.65
		mat_flank.cull_mode = BaseMaterial3D.CULL_DISABLED
		mi_flank.material_override = mat_flank
		root.add_child(mi_flank)
		# Main wing membrane (3 panels)
		var st_mem := SurfaceTool.new()
		st_mem.begin(Mesh.PRIMITIVE_TRIANGLES)
		_add_quad(st_mem, wing_root, wing_elbow,
			trail_points[1] as Vector3, trail_points[0] as Vector3)
		_add_quad(st_mem, wing_elbow, wing_peak,
			trail_points[2] as Vector3, trail_points[1] as Vector3)
		_add_tri(st_mem, wing_peak,
			trail_points[3] as Vector3, trail_points[2] as Vector3)
		st_mem.generate_normals()
		var mi_mem := MeshInstance3D.new()
		mi_mem.mesh = st_mem.commit()
		var mat_mem := StandardMaterial3D.new()
		mat_mem.albedo_color = scale_dark.darkened(0.10)
		mat_mem.roughness = 0.65
		mat_mem.cull_mode = BaseMaterial3D.CULL_DISABLED
		mi_mem.material_override = mat_mem
		root.add_child(mi_mem)

	# ============================================================================
	# LEGS — 4 stocky clawed dragon legs with WEBBED FEET (canon water dweller)
	# ============================================================================
	for side in [-1, 1]:
		var fhip := Vector3(side * w * 0.32, body_y + h * 0.02, d * 0.18)
		var fknee := Vector3(side * w * 0.34, clearance * 0.55, d * 0.20)
		var fpaw := Vector3(side * w * 0.30, 0.05, d * 0.22)
		_build_tapered_segment(root, fhip, w * 0.15, fknee, w * 0.12, primary, 0.40)
		_build_tapered_segment(root, fknee, w * 0.12, fpaw, w * 0.10, scale_dark, 0.45)
		_build_box(
			root,
			Vector3(side * w * 0.30 - w * 0.12, 0.0, d * 0.15),
			Vector3(side * w * 0.30 + w * 0.12, h * 0.07, d * 0.30),
			scale_dark, 0.45
		)
		# 4 forward claws
		var claw_tips: Array = []
		for ci in range(4):
			var co: float = (float(ci) - 1.5) * w * 0.05
			var tip := Vector3(side * w * 0.30 + co, 0.0, d * 0.40)
			claw_tips.append(tip)
			_build_tapered_segment(root,
				Vector3(side * w * 0.30 + co, h * 0.03, d * 0.30), w * 0.020,
				tip, w * 0.004,
				claw_color, 0.40)
		# WEBBED MEMBRANE between front toes — signature aquatic dragon
		var st_web := SurfaceTool.new()
		st_web.begin(Mesh.PRIMITIVE_TRIANGLES)
		for wi in range(3):
			var a := claw_tips[wi] as Vector3
			var b := claw_tips[wi + 1] as Vector3
			var mid_base := Vector3((a.x + b.x) * 0.5, h * 0.005, d * 0.34)
			_add_tri(st_web, a, b, mid_base)
		st_web.generate_normals()
		var mi_web := MeshInstance3D.new()
		mi_web.mesh = st_web.commit()
		var mat_web := StandardMaterial3D.new()
		mat_web.albedo_color = scale_dark.lerp(belly_color, 0.4)
		mat_web.roughness = 0.65
		mat_web.cull_mode = BaseMaterial3D.CULL_DISABLED
		mi_web.material_override = mat_web
		root.add_child(mi_web)

		# Back legs (digitigrade) with webbed back feet
		var rhip := Vector3(side * w * 0.32, body_y - h * 0.02, -d * 0.18)
		var rknee := Vector3(side * w * 0.36, clearance * 0.60, -d * 0.10)
		var rhock := Vector3(side * w * 0.32, clearance * 0.25, -d * 0.20)
		var rpaw := Vector3(side * w * 0.30, 0.05, -d * 0.12)
		_build_tapered_segment(root, rhip, w * 0.17, rknee, w * 0.12, primary, 0.40)
		_build_tapered_segment(root, rknee, w * 0.11, rhock, w * 0.10, primary, 0.40)
		_build_tapered_segment(root, rhock, w * 0.10, rpaw, w * 0.10, scale_dark, 0.45)
		_build_box(
			root,
			Vector3(side * w * 0.30 - w * 0.11, 0.0, -d * 0.20),
			Vector3(side * w * 0.30 + w * 0.11, h * 0.07, -d * 0.04),
			scale_dark, 0.45
		)
		var rear_tips: Array = []
		for ci in range(4):
			var co: float = (float(ci) - 1.5) * w * 0.045
			var tip := Vector3(side * w * 0.30 + co, 0.0, d * 0.04)
			rear_tips.append(tip)
			_build_tapered_segment(root,
				Vector3(side * w * 0.30 + co, h * 0.03, -d * 0.04), w * 0.018,
				tip, w * 0.004,
				claw_color, 0.40)
		# Webbing between rear toes
		var st_rw := SurfaceTool.new()
		st_rw.begin(Mesh.PRIMITIVE_TRIANGLES)
		for wi in range(3):
			var a := rear_tips[wi] as Vector3
			var b := rear_tips[wi + 1] as Vector3
			var mid_base := Vector3((a.x + b.x) * 0.5, h * 0.005, -d * 0.0)
			_add_tri(st_rw, a, b, mid_base)
		st_rw.generate_normals()
		var mi_rw := MeshInstance3D.new()
		mi_rw.mesh = st_rw.commit()
		var mat_rw := StandardMaterial3D.new()
		mat_rw.albedo_color = scale_dark.lerp(belly_color, 0.4)
		mat_rw.roughness = 0.65
		mat_rw.cull_mode = BaseMaterial3D.CULL_DISABLED
		mi_rw.material_override = mat_rw
		root.add_child(mi_rw)

	# ============================================================================
	# TAIL — long whip-like
	# ============================================================================
	var tail_base := Vector3(0, body_y - h * 0.02, -d * 0.44)
	var tail_q1 := Vector3(rng.randf_range(-w * 0.10, w * 0.10),
		body_y - h * 0.08, -d * 0.85)
	var tail_q2 := Vector3(rng.randf_range(-w * 0.20, w * 0.20),
		body_y - h * 0.16, -d * 1.30)
	var tail_tip := Vector3(rng.randf_range(-w * 0.30, w * 0.30),
		body_y - h * 0.24, -d * 1.70)
	_build_tapered_segment(root, tail_base, w * 0.18, tail_q1, w * 0.11,
		primary, 0.40)
	_build_tapered_segment(root, tail_q1, w * 0.11, tail_q2, w * 0.055,
		scale_dark, 0.45)
	_build_tapered_segment(root, tail_q2, w * 0.055, tail_tip, w * 0.010,
		scale_dark, 0.45)


# ============================================================================
# BROWN BEAR (brown_bear) — Grizzly bear (Ursus arctos)
# Distinguished from Black Bear by:
#   - LARGER overall (~30% bigger than black bear)
#   - PROMINENT SHOULDER HUMP (massive forearm muscles — signature)
#   - LONGER DISHED MUZZLE (concave profile, not the rounded black bear)
#   - LONGER STRAIGHTER CLAWS (digging claws, not climbing claws)
#   - PROPORTIONALLY SMALLER rounder ears (less prominent than black bear)
#   - Grizzled coat (blonde/silver-tipped fur in lighter patches)
# ============================================================================

static func _build_brown_bear(plan: Dictionary, root: Node3D) -> void:
	var base: Dictionary = plan.get("base", {})
	var palette: Dictionary = plan.get("palette", {})
	var limbs: Dictionary = plan.get("limbs", {})
	var meta: Dictionary = plan.get("meta", {})
	var species: String = String(meta.get("species", "Brown Bear"))

	# Brown bear: larger than black, more massive — long and low-slung
	# with the hump as the high point (verify-agent fix: trimmed non-hump h
	# 1.20→1.05 and extended d 1.90→2.10 for canon 0.50 height:length ratio).
	var w: float = _axis(base, "width", 0.92)
	var h: float = _axis(base, "height", 1.05)
	var d: float = _axis(base, "depth", 2.10)
	var leg_length: float = float(limbs.get("leg_length", 0.55))
	var clearance: float = leg_length

	var render_seed: int = int(meta.get("render_seed", 0))
	var rng := RandomNumberGenerator.new()
	rng.seed = render_seed if render_seed != 0 else hash(species)

	# Per-individual variation
	var size_jitter: float = rng.randf_range(0.92, 1.15)
	var hump_jitter: float = rng.randf_range(0.90, 1.25)
	var claw_size_jitter: float = rng.randf_range(0.90, 1.30)
	w *= size_jitter
	h *= size_jitter
	d *= size_jitter
	leg_length *= rng.randf_range(0.92, 1.10)
	clearance = leg_length

	# Brown bear coat palette — varied browns
	var coat_options := [
		Color(0.32, 0.22, 0.14),     # standard brown (canon)
		Color(0.45, 0.32, 0.18),     # warm cinnamon brown
		Color(0.18, 0.14, 0.10),     # dark brown / near-black
		Color(0.55, 0.42, 0.25),     # blonde/honey grizzly
		Color(0.28, 0.20, 0.14),     # chocolate
	]
	var primary: Color = coat_options[rng.randi() % coat_options.size()]
	var fur_dark: Color = primary.darkened(0.30)
	var belly_color: Color = primary.darkened(0.10)
	var grizzle_tip: Color = primary.lightened(0.30)
	var has_grizzle: bool = rng.randf() < 0.55
	var claw_color := Color(0.18, 0.12, 0.08)
	var fang_color := Color(0.92, 0.88, 0.78)
	var eye_color := Color(0.18, 0.10, 0.05)

	# ============================================================================
	# BODY — massive quadruped with PROMINENT SHOULDER HUMP (canon signature)
	# ============================================================================
	# Verify-agent fix: hump multiplier bumped 0.15→0.24 so the peak rises
	# discretely ABOVE the skull line; sections 2 and 4 tapered down so the
	# hump reads as a peak rather than a general back-rise.
	var body_y: float = clearance + h * 0.30
	var hump_extra_y: float = h * (0.24 * hump_jitter)
	var body_sections: Array = [
		{"center": Vector3(0, body_y - h * 0.02, -d * 0.42), "w": w * 0.34, "h": h * 0.32},
		{"center": Vector3(0, body_y - h * 0.04, -d * 0.22), "w": w * 0.48, "h": h * 0.42},  # dipped (was -0.01)
		{"center": Vector3(0, body_y - h * 0.02, -d * 0.05), "w": w * 0.50, "h": h * 0.44},  # dipped (was 0)
		{"center": Vector3(0, body_y + hump_extra_y, d * 0.12), "w": w * 0.55, "h": h * 0.52},   # SHOULDER HUMP (PEAK)
		{"center": Vector3(0, body_y + h * 0.00, d * 0.28), "w": w * 0.42, "h": h * 0.42},   # dipped (was +0.05)
		{"center": Vector3(0, body_y + h * 0.08, d * 0.40), "w": w * 0.32, "h": h * 0.34},
	]
	_swept_body(root, body_sections, 10, primary, belly_color, 0.95, true)

	# GRIZZLED COAT — silver-tipped fur patches on shoulder hump + back
	if has_grizzle:
		var grizzle_count: int = rng.randi_range(8, 14)
		for gi in range(grizzle_count):
			var g_ang: float = rng.randf_range(-PI * 0.5, PI * 0.5)
			var g_t: float = rng.randf_range(0.0, 0.65)
			var gz: float = lerpf(d * 0.30, -d * 0.30, g_t)
			var gy: float = lerpf(body_y + h * 0.10, body_y + hump_extra_y,
				1.0 - abs(g_t - 0.35) * 2.0)
			var gx: float = sin(g_ang) * w * 0.40
			var patch_size: float = w * rng.randf_range(0.04, 0.09)
			_build_box(
				root,
				Vector3(gx - patch_size, gy + h * 0.03, gz - d * 0.04),
				Vector3(gx + patch_size, gy + h * 0.07, gz + d * 0.04),
				grizzle_tip, 0.95
			)

	# ============================================================================
	# HEAD — LONG DISHED MUZZLE (concave forehead-snout profile)
	# ============================================================================
	var neck_base := (body_sections[5]["center"] as Vector3)
	var head_anchor := Vector3(0, neck_base.y + h * 0.08, neck_base.z + d * 0.18)
	_build_tapered_segment(root, neck_base, w * 0.26, head_anchor, w * 0.28, primary, 0.95)

	var skull_w: float = w * 0.32
	var skull_h: float = h * 0.32
	var skull_d: float = d * 0.32
	var skull_y_bot: float = head_anchor.y - skull_h * 0.40
	var skull_y_top: float = skull_y_bot + skull_h
	var skull_center_y: float = (skull_y_bot + skull_y_top) * 0.5
	_build_box(
		root,
		Vector3(-skull_w, skull_y_bot, head_anchor.z - skull_d * 0.30),
		Vector3(skull_w, skull_y_top, head_anchor.z + skull_d * 0.30),
		primary, 0.95
	)
	# LONG DISHED MUZZLE — ~75% of skull_d (vs black bear 50%); drops further
	# so the forehead-snout profile is concave (canon dished).
	var muzzle_back_z: float = head_anchor.z + skull_d * 0.30
	var muzzle_tip_z: float = head_anchor.z + skull_d * 1.05
	_build_box(
		root,
		Vector3(-skull_w * 0.55, skull_y_bot + h * 0.02,
			muzzle_back_z - d * 0.02),
		Vector3(skull_w * 0.55, skull_y_top - h * 0.10,
			muzzle_tip_z),
		primary, 0.95
	)
	# Black nose tip
	_build_box(
		root,
		Vector3(-skull_w * 0.18, skull_y_top - h * 0.16,
			muzzle_tip_z - d * 0.04),
		Vector3(skull_w * 0.18, skull_y_top - h * 0.10,
			muzzle_tip_z + d * 0.02),
		Color(0.04, 0.03, 0.03), 0.55
	)
	# Forehead dish shadow — darker patch emphasizing the dished profile
	_build_box(
		root,
		Vector3(-skull_w * 0.40, skull_center_y + h * 0.03,
			head_anchor.z + skull_d * 0.18),
		Vector3(skull_w * 0.40, skull_center_y + h * 0.08,
			head_anchor.z + skull_d * 0.30),
		fur_dark, 0.95
	)

	# Eyes
	for side in [-1, 1]:
		_build_box(
			root,
			Vector3(side * skull_w * 0.50 - w * 0.030,
				skull_center_y + h * 0.005, head_anchor.z + skull_d * 0.20),
			Vector3(side * skull_w * 0.50 + w * 0.030,
				skull_center_y + h * 0.030, head_anchor.z + skull_d * 0.30),
			eye_color, 0.30
		)

	# SMALL ROUNDED EARS — proportionally smaller than black bear's
	for side in [-1, 1]:
		var ear_center := Vector3(side * skull_w * 0.55,
			skull_y_top + h * 0.03,
			head_anchor.z - skull_d * 0.05)
		# Small rounded ear box (NOT taller than wide like black bear's)
		_build_box(
			root,
			ear_center + Vector3(-w * 0.055, -h * 0.005, -d * 0.04),
			ear_center + Vector3(w * 0.055, h * 0.06, d * 0.04),
			primary, 0.95
		)
		# Inner ear
		_build_box(
			root,
			ear_center + Vector3(-w * 0.035, h * 0.005, d * 0.020),
			ear_center + Vector3(w * 0.035, h * 0.045, d * 0.045),
			primary.lightened(0.12), 0.95
		)

	# JAW
	var jaw_y_top: float = skull_y_bot + h * 0.04
	var jaw_y_bot: float = skull_y_bot - h * 0.03
	_build_box(
		root,
		Vector3(-skull_w * 0.50, jaw_y_bot,
			muzzle_back_z + d * 0.02),
		Vector3(skull_w * 0.50, jaw_y_top,
			muzzle_tip_z - d * 0.02),
		fur_dark, 0.95
	)
	_build_box(
		root,
		Vector3(-skull_w * 0.40, jaw_y_bot + h * 0.005,
			muzzle_back_z + d * 0.06),
		Vector3(skull_w * 0.40, jaw_y_top - h * 0.005,
			muzzle_tip_z - d * 0.06),
		Color(0.10, 0.05, 0.05), 0.85
	)
	# Upper canines — larger than black bear
	for side in [-1, 1]:
		var fx_c: float = side * skull_w * 0.38
		_build_tapered_segment(root,
			Vector3(fx_c, jaw_y_top, muzzle_back_z + d * 0.20), w * 0.025,
			Vector3(fx_c, jaw_y_top - h * 0.055, muzzle_back_z + d * 0.23),
			w * 0.005,
			fang_color, 0.45)

	# ============================================================================
	# LEGS — 4 powerful legs with LONG STRAIGHT DIGGING CLAWS
	# ============================================================================
	for side in [-1, 1]:
		# Front legs (under the shoulder hump — bigger and more powerful)
		var fhip := Vector3(side * w * 0.30, body_y + hump_extra_y * 0.5, d * 0.16)
		var fknee := Vector3(side * w * 0.32, clearance * 0.55, d * 0.18)
		var fpaw := Vector3(side * w * 0.30, 0.05, d * 0.20)
		_build_tapered_segment(root, fhip, w * 0.20, fknee, w * 0.16, primary, 0.95)
		_build_tapered_segment(root, fknee, w * 0.16, fpaw, w * 0.13, fur_dark, 0.95)
		_build_box(
			root,
			Vector3(side * w * 0.30 - w * 0.15, 0.0, d * 0.12),
			Vector3(side * w * 0.30 + w * 0.15, h * 0.09, d * 0.34),
			fur_dark, 0.95
		)
		# 5 LONG CURVED DIGGING CLAWS — canon "longer and stronger claws,
		# with a blunt curve" (verify-agent fix: was straight, read as
		# anteater/badger; now 2-segment with a downward arc + blunter tip).
		for ci in range(5):
			var co: float = (float(ci) - 2.0) * w * 0.055
			var claw_total: float = d * (0.13 * claw_size_jitter)
			# Mid-knuckle bend ~15-20° down from base direction
			var mid_pos := Vector3(side * w * 0.30 + co, h * 0.015,
				d * 0.34 + claw_total * 0.55)
			var tip_pos := Vector3(side * w * 0.30 + co, 0.0,
				d * 0.34 + claw_total * 0.92)
			# Base → mid (gentle drop)
			_build_tapered_segment(root,
				Vector3(side * w * 0.30 + co, h * 0.04, d * 0.34), w * 0.025,
				mid_pos, w * 0.014,
				claw_color, 0.40)
			# Mid → tip (continued arc, BLUNTER tip than black bear's sharp claws)
			_build_tapered_segment(root, mid_pos, w * 0.014,
				tip_pos, w * 0.008,    # blunter tip (was 0.005)
				claw_color, 0.40)
		# Back legs
		var rhip := Vector3(side * w * 0.30, body_y - h * 0.02, -d * 0.18)
		var rknee := Vector3(side * w * 0.32, clearance * 0.55, -d * 0.14)
		var rpaw := Vector3(side * w * 0.28, 0.05, -d * 0.16)
		_build_tapered_segment(root, rhip, w * 0.22, rknee, w * 0.16, primary, 0.95)
		_build_tapered_segment(root, rknee, w * 0.16, rpaw, w * 0.13, fur_dark, 0.95)
		_build_box(
			root,
			Vector3(side * w * 0.28 - w * 0.13, 0.0, -d * 0.30),
			Vector3(side * w * 0.28 + w * 0.13, h * 0.09, -d * 0.04),
			fur_dark, 0.95
		)
		# Back paw claws — shorter than front (canon)
		for ci in range(5):
			var co: float = (float(ci) - 2.0) * w * 0.05
			_build_tapered_segment(root,
				Vector3(side * w * 0.28 + co, h * 0.04, -d * 0.04), w * 0.020,
				Vector3(side * w * 0.28 + co, 0.0, d * 0.04),
				w * 0.005,
				claw_color, 0.40)

	# ============================================================================
	# TAIL — short stub
	# ============================================================================
	var bear_tail_base := Vector3(0, body_y + h * 0.03, -d * 0.42)
	var bear_tail_tip := Vector3(0, body_y - h * 0.02, -d * 0.55)
	_build_tapered_segment(root, bear_tail_base, w * 0.08, bear_tail_tip, w * 0.025,
		primary, 0.95)


# ============================================================================
# BUGBEAR (bugbear) — Hairy hulking goblinoid brute (D&D MM)
#   - 7-ft tall, broad-shouldered, hunched posture
#   - SHAGGY YELLOW-BROWN FUR covering body (signature — not bare skin)
#   - HYENA / WOLFISH FACE with snout + fangs
#   - Long muscular arms (LONGER than legs — knuckle-walker tendency)
#   - Pointed goblinoid ears
#   - Hide/leather scrap armor + bone trophies
#   - Brutal weapon (morningstar / spiked club)
# ============================================================================

static func _build_bugbear(plan: Dictionary, root: Node3D) -> void:
	var base: Dictionary = plan.get("base", {})
	var palette: Dictionary = plan.get("palette", {})
	var limbs: Dictionary = plan.get("limbs", {})
	var meta: Dictionary = plan.get("meta", {})
	var species: String = String(meta.get("species", "Bugbear"))

	# 7-ft tall hulking goblinoid — broad and heavily built
	var w: float = _axis(base, "width", 0.80)
	var h: float = _axis(base, "height", 2.20)
	var d: float = _axis(base, "depth", 0.55)
	var leg_length: float = float(limbs.get("leg_length", 1.05))
	var clearance: float = leg_length

	var render_seed: int = int(meta.get("render_seed", 0))
	var rng := RandomNumberGenerator.new()
	rng.seed = render_seed if render_seed != 0 else hash(species)

	# Per-individual variation
	var size_jitter: float = rng.randf_range(0.92, 1.15)
	var fur_density_jitter: float = rng.randf_range(0.85, 1.30)
	var trophy_count_jitter: int = rng.randi_range(1, 4)
	w *= size_jitter
	h *= size_jitter
	d *= size_jitter
	leg_length *= rng.randf_range(0.92, 1.10)
	clearance = leg_length

	# Fur palette — canon bugbear yellow-brown to rust
	var fur_options := [
		Color(0.55, 0.40, 0.20),     # tawny brown (canon base)
		Color(0.45, 0.32, 0.18),     # darker brown
		Color(0.62, 0.45, 0.22),     # rust
		Color(0.40, 0.30, 0.18),     # mud brown
		Color(0.50, 0.35, 0.25),     # cinnamon
	]
	var primary: Color = fur_options[rng.randi() % fur_options.size()]
	var fur_dark: Color = primary.darkened(0.30)
	var fur_light: Color = primary.lightened(0.15)
	var belly_color: Color = primary.darkened(0.10)
	var skin_color := Color(0.42, 0.32, 0.22)
	var leather := Color(0.30, 0.18, 0.10)
	var leather_dark := Color(0.20, 0.12, 0.07)
	var iron := Color(0.35, 0.35, 0.38)
	var iron_dark := Color(0.18, 0.18, 0.20)
	var bone_color := Color(0.85, 0.78, 0.65)
	var fang_color := Color(0.90, 0.85, 0.72)
	var claw_color := Color(0.12, 0.10, 0.08)
	var eye_color := Color(0.95, 0.75, 0.10)    # malicious yellow

	# ============================================================================
	# TORSO — heavy, broad-shouldered, HUNCHED forward
	# ============================================================================
	var hip_y: float = clearance
	var waist_y: float = clearance + h * 0.14
	var chest_y: float = clearance + h * 0.32
	var shoulder_y: float = clearance + h * 0.45
	# Lower torso
	_build_box(
		root,
		Vector3(-w * 0.30, hip_y, -d * 0.25),
		Vector3(w * 0.30, waist_y, d * 0.25),
		primary, 0.95
	)
	# Mid torso (broadening)
	_build_box(
		root,
		Vector3(-w * 0.36, waist_y, -d * 0.28),
		Vector3(w * 0.36, chest_y, d * 0.30),
		primary, 0.95
	)
	# Broad shaggy chest (HUNCHED — sits slightly forward in Z)
	_build_box(
		root,
		Vector3(-w * 0.50, chest_y, -d * 0.30 + d * 0.05),
		Vector3(w * 0.50, shoulder_y, d * 0.34 + d * 0.05),
		primary, 0.95
	)

	# Shaggy fur tufts down the back (canon — bugbear "shaggy" pelt)
	var back_tuft_count: int = int(round(8.0 * fur_density_jitter))
	for ti in range(back_tuft_count):
		var tt: float = float(ti) / float(back_tuft_count - 1)
		var ty: float = lerpf(chest_y, shoulder_y - h * 0.005, tt)
		# Slight sway across the back
		var tx: float = rng.randf_range(-w * 0.18, w * 0.18)
		var tuft_h: float = h * rng.randf_range(0.04, 0.08)
		_build_tapered_segment(root,
			Vector3(tx, ty, -d * 0.28), w * 0.025,
			Vector3(tx + rng.randf_range(-0.02, 0.02), ty - tuft_h, -d * 0.36),
			w * 0.006,
			fur_dark if ti % 2 == 0 else fur_light, 0.95)

	# Scrap leather chestpiece (worn over the shaggy chest)
	_build_box(
		root,
		Vector3(-w * 0.42, chest_y + h * 0.02, d * 0.28),
		Vector3(w * 0.42, shoulder_y - h * 0.02, d * 0.38),
		leather, 0.85
	)
	# Belt
	_build_box(
		root,
		Vector3(-w * 0.40, waist_y - h * 0.020, -d * 0.30),
		Vector3(w * 0.40, waist_y + h * 0.015, d * 0.32),
		leather_dark, 0.85
	)
	# Iron belt buckle
	_build_box(
		root,
		Vector3(-w * 0.06, waist_y - h * 0.025, d * 0.30),
		Vector3(w * 0.06, waist_y + h * 0.015, d * 0.36),
		iron, 0.40, 0.50
	)
	# Loincloth/skirt scraps (3 pieces front/sides)
	for kang in [-0.6, 0.0, 0.6]:
		var kx: float = sin(kang) * w * 0.30
		var kz: float = cos(kang) * d * 0.30
		_build_box(
			root,
			Vector3(kx - w * 0.10, hip_y, kz - d * 0.04),
			Vector3(kx + w * 0.10, waist_y - h * 0.005, kz + d * 0.04),
			leather, 0.85
		)

	# ============================================================================
	# HEAD — HYENA/WOLFISH skull with protruding snout + pointed ears
	# ============================================================================
	# Short thick neck (hunched — head sits slightly forward of shoulders)
	var neck_top := Vector3(0, shoulder_y + h * 0.06, d * 0.12)
	_build_tapered_segment(root,
		Vector3(0, shoulder_y - h * 0.01, d * 0.02), w * 0.17,
		neck_top, w * 0.15,
		primary, 0.95)

	var head_w: float = w * 0.32
	var head_h: float = h * 0.16
	var head_d: float = d * 0.65
	var head_y_bot: float = neck_top.y
	var head_y_top: float = head_y_bot + head_h
	var head_center_y: float = (head_y_bot + head_y_top) * 0.5
	# Skull
	_build_box(
		root,
		Vector3(-head_w, head_y_bot, neck_top.z - head_d * 0.30),
		Vector3(head_w, head_y_top, neck_top.z + head_d * 0.30),
		primary, 0.95
	)
	# FLAT GOBLIN-APE SNOUT — verify-agent fix: previous wolf muzzle was
	# pushing the read toward gnoll. Shortened ~45% on Z, widened ~20% on X
	# so the face reads goblinoid-ape with a flat-pushed snout.
	_build_box(
		root,
		Vector3(-head_w * 0.66, head_y_bot + h * 0.005,
			neck_top.z + head_d * 0.30 - d * 0.005),
		Vector3(head_w * 0.66, head_y_top - h * 0.04,
			neck_top.z + head_d * 0.55),     # was 0.75 — short flat muzzle
		primary, 0.95
	)
	# Broad squashed nose pad (not pointed)
	_build_box(
		root,
		Vector3(-head_w * 0.28, head_y_top - h * 0.085,
			neck_top.z + head_d * 0.50),
		Vector3(head_w * 0.28, head_y_top - h * 0.04,
			neck_top.z + head_d * 0.58),
		Color(0.05, 0.04, 0.03), 0.65
	)
	# Heavy brow ridge
	_build_box(
		root,
		Vector3(-head_w * 1.05, head_center_y + h * 0.020,
			neck_top.z + head_d * 0.08),
		Vector3(head_w * 1.05, head_center_y + h * 0.055,
			neck_top.z + head_d * 0.30),
		fur_dark, 0.95
	)
	# MALICIOUS YELLOW EYES
	for side in [-1, 1]:
		_build_box(
			root,
			Vector3(side * head_w * 0.55 - w * 0.035,
				head_center_y - h * 0.005, neck_top.z + head_d * 0.20),
			Vector3(side * head_w * 0.55 + w * 0.035,
				head_center_y + h * 0.025, neck_top.z + head_d * 0.30),
			eye_color, 0.15, 0.0
		)
		# Pupil
		_build_box(
			root,
			Vector3(side * head_w * 0.55 - w * 0.012,
				head_center_y, neck_top.z + head_d * 0.27),
			Vector3(side * head_w * 0.55 + w * 0.012,
				head_center_y + h * 0.020, neck_top.z + head_d * 0.30),
			Color(0.05, 0.03, 0.01), 0.30
		)

	# JAW — bestial with prominent FANGS
	var jaw_y_top: float = head_y_bot - h * 0.005
	var jaw_y_bot: float = jaw_y_top - h * 0.06
	_build_box(
		root,
		Vector3(-head_w * 0.50, jaw_y_bot,
			neck_top.z + head_d * 0.30),
		Vector3(head_w * 0.50, jaw_y_top,
			neck_top.z + head_d * 0.72),
		fur_dark, 0.95
	)
	# Inner mouth dark
	_build_box(
		root,
		Vector3(-head_w * 0.40, jaw_y_bot + h * 0.005,
			neck_top.z + head_d * 0.35),
		Vector3(head_w * 0.40, jaw_y_top - h * 0.005,
			neck_top.z + head_d * 0.68),
		Color(0.15, 0.08, 0.05), 0.85
	)
	# Two prominent upper canine fangs (anchored to the shorter snout)
	for side in [-1, 1]:
		var fx_c: float = side * head_w * 0.36
		_build_tapered_segment(root,
			Vector3(fx_c, jaw_y_top, neck_top.z + head_d * 0.40), w * 0.024,
			Vector3(fx_c, jaw_y_top - h * 0.055, neck_top.z + head_d * 0.45),
			w * 0.005,
			fang_color, 0.45)

	# LARGE BEAR-LIKE EARS — sticking OUT and UP from the skull
	# (verify-agent fix: back-swept goblin spikes were canid-coded; canon is
	# "large pointed ears like a bear's" out-and-slightly-up with rounded tips).
	for side in [-1, 1]:
		var ear_base := Vector3(side * head_w * 0.85,
			head_y_top - h * 0.005,
			neck_top.z + head_d * 0.00)
		# OUT-and-UP (~70-80° from skull axis): big x, modest y-up, near-zero z
		var ear_tip := Vector3(side * head_w * 1.40,
			head_y_top + h * 0.14,
			neck_top.z - head_d * 0.02)
		_build_tapered_segment(root, ear_base, w * 0.075, ear_tip, w * 0.020,
			primary, 0.95)
		# Rounded tip cap (not sharp) — distinct bear-ear look
		_build_box(
			root,
			ear_tip + Vector3(-w * 0.025, -h * 0.015, -d * 0.025),
			ear_tip + Vector3(w * 0.025, h * 0.015, d * 0.025),
			primary, 0.95
		)
		# Inner ear darker
		_build_tapered_segment(root,
			ear_base + Vector3(0, h * 0.005, d * 0.005), w * 0.05,
			ear_tip + Vector3(0, -h * 0.020, 0), w * 0.012,
			fur_dark, 0.95)

	# ============================================================================
	# ARMS — VERY LONG muscular arms reaching past the hips (canon brute)
	# ============================================================================
	# Right arm — gripping weapon high
	var r_shoulder := Vector3(w * 0.48, shoulder_y - h * 0.03, d * 0.05)
	var r_elbow := Vector3(w * 0.62, shoulder_y - h * 0.25, d * 0.12)
	# Wrist drops well past the hip — knuckle-walker arm length
	var r_wrist := Vector3(w * 0.55, hip_y - h * 0.08, d * 0.22)
	_build_tapered_segment(root, r_shoulder, w * 0.17, r_elbow, w * 0.13, primary, 0.95)
	_build_tapered_segment(root, r_elbow, w * 0.13, r_wrist, w * 0.11, primary, 0.95)
	# Right hand
	_build_box(
		root,
		Vector3(r_wrist.x - w * 0.08, r_wrist.y - h * 0.05, r_wrist.z - d * 0.05),
		Vector3(r_wrist.x + w * 0.08, r_wrist.y + h * 0.01, r_wrist.z + d * 0.07),
		skin_color, 0.65
	)
	# Right hand: 4 fingers + thumb (5 digits — humanoid, NOT beast paw).
	# Verify-agent fix: 4-claw read as hyena/gnoll; 5 fingers = bugbear.
	for ci in range(4):
		var ct: float = (float(ci) - 1.5) / 2.0
		var cx: float = r_wrist.x + ct * w * 0.04
		_build_tapered_segment(root,
			Vector3(cx, r_wrist.y - h * 0.03, r_wrist.z + d * 0.07), w * 0.014,
			Vector3(cx + ct * w * 0.02, r_wrist.y - h * 0.08, r_wrist.z + d * 0.15),
			w * 0.004,
			claw_color, 0.40)
	# Thumb (opposing, on inner side)
	_build_tapered_segment(root,
		Vector3(r_wrist.x - w * 0.06, r_wrist.y - h * 0.02, r_wrist.z + d * 0.04),
		w * 0.015,
		Vector3(r_wrist.x - w * 0.10, r_wrist.y - h * 0.05, r_wrist.z + d * 0.10),
		w * 0.004,
		claw_color, 0.40)

	# Left arm — also long, hanging more relaxed
	var l_shoulder := Vector3(-w * 0.48, shoulder_y - h * 0.03, d * 0.05)
	var l_elbow := Vector3(-w * 0.58, shoulder_y - h * 0.28, d * 0.08)
	var l_wrist := Vector3(-w * 0.50, hip_y - h * 0.12, d * 0.12)
	_build_tapered_segment(root, l_shoulder, w * 0.17, l_elbow, w * 0.13, primary, 0.95)
	_build_tapered_segment(root, l_elbow, w * 0.13, l_wrist, w * 0.11, primary, 0.95)
	# Left hand
	_build_box(
		root,
		Vector3(l_wrist.x - w * 0.08, l_wrist.y - h * 0.05, l_wrist.z - d * 0.05),
		Vector3(l_wrist.x + w * 0.08, l_wrist.y + h * 0.01, l_wrist.z + d * 0.07),
		skin_color, 0.65
	)
	# Left hand: 4 fingers + thumb
	for ci in range(4):
		var ct: float = (float(ci) - 1.5) / 2.0
		var cx: float = l_wrist.x + ct * w * 0.04
		_build_tapered_segment(root,
			Vector3(cx, l_wrist.y - h * 0.03, l_wrist.z + d * 0.07), w * 0.014,
			Vector3(cx + ct * w * 0.02, l_wrist.y - h * 0.08, l_wrist.z + d * 0.15),
			w * 0.004,
			claw_color, 0.40)
	# Thumb (opposing, on inner side)
	_build_tapered_segment(root,
		Vector3(l_wrist.x + w * 0.06, l_wrist.y - h * 0.02, l_wrist.z + d * 0.04),
		w * 0.015,
		Vector3(l_wrist.x + w * 0.10, l_wrist.y - h * 0.05, l_wrist.z + d * 0.10),
		w * 0.004,
		claw_color, 0.40)

	# ============================================================================
	# MORNINGSTAR — signature bugbear weapon
	# Wooden haft with iron spiked ball at the top, held in right hand
	# ============================================================================
	var haft_grip := r_wrist + Vector3(0, h * 0.02, d * 0.04)
	var haft_bot := haft_grip + Vector3(0, -h * 0.18, 0.0)
	var haft_top := haft_grip + Vector3(0, h * 0.55, 0.0)
	# Wooden haft
	_build_tapered_segment(root, haft_bot, w * 0.030, haft_top, w * 0.035,
		Color(0.42, 0.28, 0.16), 0.85)
	# Iron spiked ball (morningstar head)
	var ball_center := haft_top + Vector3(0, h * 0.06, 0)
	_build_box(
		root,
		ball_center + Vector3(-w * 0.10, -h * 0.06, -d * 0.10),
		ball_center + Vector3(w * 0.10, h * 0.06, d * 0.10),
		iron_dark, 0.40
	)
	# 8 spikes radiating from the ball
	for si in range(8):
		var spk_ang: float = (float(si) / 8.0) * TAU
		var spk_x: float = cos(spk_ang) * w * 0.10
		var spk_z: float = sin(spk_ang) * d * 0.10
		var spk_tip := ball_center + Vector3(spk_x * 1.7, 0.0, spk_z * 1.7)
		_build_tapered_segment(root,
			ball_center + Vector3(spk_x * 0.5, 0.0, spk_z * 0.5), w * 0.020,
			spk_tip, w * 0.003,
			iron, 0.40)
	# Top spike (the iconic upward spike)
	_build_tapered_segment(root,
		ball_center + Vector3(0, h * 0.05, 0), w * 0.020,
		ball_center + Vector3(0, h * 0.16, 0), w * 0.003,
		iron, 0.40)

	# ============================================================================
	# BONE TROPHIES — 1-4 trophies dangling from belt (canon scary bugbear)
	# ============================================================================
	for ti in range(trophy_count_jitter):
		var t_ang: float = (float(ti) / float(trophy_count_jitter)) * PI - PI * 0.5
		var t_root := Vector3(sin(t_ang) * w * 0.30,
			waist_y - h * 0.025,
			cos(t_ang) * d * 0.32)
		var trophy_pick: int = rng.randi() % 3
		if trophy_pick == 0:
			# Skull trophy
			_build_box(
				root,
				t_root + Vector3(-w * 0.04, -h * 0.10, -d * 0.04),
				t_root + Vector3(w * 0.04, -h * 0.04, d * 0.04),
				bone_color, 0.55
			)
			# Eye sockets
			for ess in [-1, 1]:
				_build_box(
					root,
					t_root + Vector3(ess * w * 0.018 - w * 0.012,
						-h * 0.075, d * 0.03),
					t_root + Vector3(ess * w * 0.018 + w * 0.012,
						-h * 0.055, d * 0.045),
					Color(0.05, 0.04, 0.04), 0.85
				)
		elif trophy_pick == 1:
			# Tooth/fang trophy
			_build_tapered_segment(root, t_root, w * 0.012,
				t_root + Vector3(0, -h * 0.08, 0), w * 0.003,
				fang_color, 0.45)
		else:
			# Bone shard trophy
			_build_box(
				root,
				t_root + Vector3(-w * 0.020, -h * 0.10, -d * 0.010),
				t_root + Vector3(w * 0.020, -h * 0.020, d * 0.010),
				bone_color, 0.55
			)
		# Leather cord
		_build_tapered_segment(root,
			Vector3(t_root.x, waist_y + h * 0.005, t_root.z),
			w * 0.005,
			t_root + Vector3(0, -h * 0.01, 0),
			w * 0.004,
			leather_dark, 0.85)

	# ============================================================================
	# LEGS — short stocky legs (bugbears have long arms RELATIVE to legs)
	# ============================================================================
	for side in [-1, 1]:
		var hip := Vector3(side * w * 0.18, hip_y + h * 0.02, 0.0)
		var knee := Vector3(side * w * 0.22, clearance * 0.45, d * 0.05)
		var ankle := Vector3(side * w * 0.18, clearance * 0.15, -d * 0.04)
		_build_tapered_segment(root, hip, w * 0.18, knee, w * 0.14, primary, 0.95)
		_build_tapered_segment(root, knee, w * 0.14, ankle, w * 0.11, primary, 0.95)
		# Foot pad
		_build_box(
			root,
			Vector3(side * w * 0.18 - w * 0.12, 0.0, -d * 0.08),
			Vector3(side * w * 0.18 + w * 0.12, h * 0.07, d * 0.20),
			skin_color, 0.65
		)
		# 5 short clawed toes — humanoid not beast (verify-agent fix:
		# 3-toed was gnoll/dinosaur coded; 5 toes = bugbear).
		for ti in range(5):
			var to: float = (float(ti) - 2.0) * w * 0.04
			_build_tapered_segment(root,
				Vector3(side * w * 0.18 + to, h * 0.03, d * 0.18), w * 0.015,
				Vector3(side * w * 0.18 + to, 0.0, d * 0.24), w * 0.004,
				claw_color, 0.40)


# ============================================================================
# BULETTE (bulette) — "Land Shark" (D&D MM)
#   - Massive quadruped armored predator
#   - SHARK-LIKE WEDGE HEAD with huge gaping fanged maw (signature)
#   - SEGMENTED DORSAL ARMOR PLATES along the back (signature — armadillo+shark)
#   - PROMINENT TALL DORSAL FIN that breaks ground surface when burrowing
#   - Powerful BURROWING FRONT LEGS with shovel claws
#   - Strong rear legs for leaping
#   - Grey-blue armor color with brown/tan belly
#   - Short tail
# ============================================================================

static func _build_bulette(plan: Dictionary, root: Node3D) -> void:
	var base: Dictionary = plan.get("base", {})
	var palette: Dictionary = plan.get("palette", {})
	var limbs: Dictionary = plan.get("limbs", {})
	var meta: Dictionary = plan.get("meta", {})
	var species: String = String(meta.get("species", "Bulette"))

	# Bulette is Large — stocky, longer than tall, broad.
	var w: float = _axis(base, "width", 1.10)
	var h: float = _axis(base, "height", 1.20)
	var d: float = _axis(base, "depth", 2.40)
	var leg_length: float = float(limbs.get("leg_length", 0.42))
	var clearance: float = leg_length

	var render_seed: int = int(meta.get("render_seed", 0))
	var rng := RandomNumberGenerator.new()
	rng.seed = render_seed if render_seed != 0 else hash(species)

	# Per-individual variation
	var size_jitter: float = rng.randf_range(0.92, 1.15)
	var fin_size_jitter: float = rng.randf_range(0.90, 1.30)
	var plate_count_jitter: int = rng.randi_range(5, 8)
	w *= size_jitter
	h *= size_jitter
	d *= size_jitter
	leg_length *= rng.randf_range(0.92, 1.10)
	clearance = leg_length

	# Armor palette — grey-blue / steel / earth-brown
	var armor_options := [
		Color(0.42, 0.45, 0.52),     # slate grey-blue (canon)
		Color(0.35, 0.38, 0.45),     # dark steel
		Color(0.50, 0.52, 0.55),     # pale grey
		Color(0.45, 0.42, 0.38),     # weathered brown-grey
	]
	var primary: Color = armor_options[rng.randi() % armor_options.size()]
	var plate_dark: Color = primary.darkened(0.40)
	var belly_color := Color(0.50, 0.42, 0.30)    # tan/brown belly
	var fang_color := Color(0.95, 0.90, 0.78)
	var claw_color := Color(0.10, 0.08, 0.06)
	var eye_color := Color(0.90, 0.30, 0.10)      # angry orange-red eyes

	# ============================================================================
	# BODY — broad armored trunk, low and powerful
	# ============================================================================
	var body_y: float = clearance + h * 0.28
	var body_sections: Array = [
		{"center": Vector3(0, body_y - h * 0.05, -d * 0.42), "w": w * 0.28, "h": h * 0.28},  # tail base
		{"center": Vector3(0, body_y - h * 0.02, -d * 0.22), "w": w * 0.46, "h": h * 0.42},  # hip
		{"center": Vector3(0, body_y + h * 0.02, -d * 0.05), "w": w * 0.52, "h": h * 0.50},  # mid
		{"center": Vector3(0, body_y + h * 0.04, d * 0.12), "w": w * 0.55, "h": h * 0.52},   # widest behind shoulders
		{"center": Vector3(0, body_y + h * 0.02, d * 0.28), "w": w * 0.48, "h": h * 0.46},   # shoulders
		{"center": Vector3(0, body_y + h * 0.05, d * 0.42), "w": w * 0.32, "h": h * 0.32},   # neck base
	]
	_swept_body(root, body_sections, 10, primary, belly_color, 0.85, true)

	# ============================================================================
	# HEAD — MASSIVE SHARK-WEDGE with gaping fanged maw
	# ============================================================================
	var neck_base := (body_sections[5]["center"] as Vector3)
	var head_anchor := Vector3(0, neck_base.y, neck_base.z + d * 0.20)
	# Short thick neck — almost no neck visible (head sits forward on shoulders)
	_build_tapered_segment(root, neck_base, w * 0.32,
		Vector3(0, head_anchor.y, head_anchor.z - d * 0.05), w * 0.34,
		primary, 0.85)

	# BULLET-BLUNT HIPPO/SNAPPING-TURTLE head — verify-agent fix: was too
	# shark-wedge tapering. Now short broad blunt; depth shortened ~30%,
	# sections 4-5 only pinch ~15% (no narrow snout point).
	var head_w_back: float = w * 0.48
	var head_w_front: float = w * 0.42
	var head_h: float = h * 0.40
	var head_y_bot: float = head_anchor.y - head_h * 0.45
	var head_y_top: float = head_y_bot + head_h
	var head_center_y: float = (head_y_bot + head_y_top) * 0.5
	var head_back_z: float = head_anchor.z - d * 0.08
	var head_front_z: float = head_anchor.z + d * 0.38       # shortened ~30%
	var head_sections: Array = [
		{"center": Vector3(0, head_center_y, head_back_z), "w": head_w_back, "h": head_h * 0.95},
		{"center": Vector3(0, head_center_y, head_back_z + d * 0.12), "w": head_w_back, "h": head_h * 1.00},
		{"center": Vector3(0, head_center_y, head_back_z + d * 0.26), "w": head_w_back * 0.96, "h": head_h * 0.98},
		{"center": Vector3(0, head_center_y, head_back_z + d * 0.38), "w": head_w_front * 0.95, "h": head_h * 0.90},
		{"center": Vector3(0, head_center_y, head_front_z), "w": head_w_front * 0.85, "h": head_h * 0.80},  # blunt snout
	]
	_swept_body(root, head_sections, 8, primary, belly_color, 0.85, true)

	# HEAVY BROW RIDGE above eyes
	_build_box(
		root,
		Vector3(-head_w_back * 1.02, head_center_y + h * 0.10,
			head_back_z + d * 0.05),
		Vector3(head_w_back * 1.02, head_center_y + h * 0.16,
			head_back_z + d * 0.25),
		plate_dark, 0.85
	)
	# Small ANGRY ORANGE EYES — deep-set under the brow
	for side in [-1, 1]:
		_build_box(
			root,
			Vector3(side * head_w_back * 0.65 - w * 0.04,
				head_center_y + h * 0.04, head_back_z + d * 0.12),
			Vector3(side * head_w_back * 0.65 + w * 0.04,
				head_center_y + h * 0.085, head_back_z + d * 0.22),
			eye_color, 0.20, 0.0
		)
		# Pupil
		_build_box(
			root,
			Vector3(side * head_w_back * 0.65 - w * 0.012,
				head_center_y + h * 0.050, head_back_z + d * 0.18),
			Vector3(side * head_w_back * 0.65 + w * 0.012,
				head_center_y + h * 0.075, head_back_z + d * 0.22),
			Color(0.10, 0.04, 0.02), 0.40
		)

	# GAPING SHARK MAW — wide mouth across the front-bottom of the head
	var jaw_y_top: float = head_center_y - h * 0.03
	var jaw_y_bot: float = head_center_y - h * 0.18
	# Inner mouth dark (gaping)
	_build_box(
		root,
		Vector3(-head_w_front * 0.85, jaw_y_bot,
			head_back_z + d * 0.30),
		Vector3(head_w_front * 0.85, jaw_y_top,
			head_front_z - d * 0.05),
		Color(0.15, 0.05, 0.05), 0.85
	)
	# Tooth rows — UPPER (8 teeth) + LOWER (7 teeth) shark fangs
	var tooth_count_upper: int = 8
	for ti in range(tooth_count_upper):
		var tt: float = float(ti) / float(tooth_count_upper - 1)
		# Lateral position along the curving jaw
		var tx: float = lerpf(-head_w_front * 0.75, head_w_front * 0.75, tt)
		# Tooth Z curves slightly back at the corners
		var tz_curve: float = head_back_z + d * lerpf(0.35, 0.85, 1.0 - abs(tt - 0.5) * 2.0)
		var tooth_h: float = h * (0.10 if (ti == 3 or ti == 4) else 0.075)
		_build_tapered_segment(root,
			Vector3(tx, jaw_y_top, tz_curve), w * 0.018,
			Vector3(tx, jaw_y_top - tooth_h, tz_curve - d * 0.005), w * 0.004,
			fang_color, 0.45)
	# Lower fangs (point upward)
	var tooth_count_lower: int = 7
	for ti in range(tooth_count_lower):
		var tt: float = float(ti) / float(tooth_count_lower - 1)
		var tx: float = lerpf(-head_w_front * 0.65, head_w_front * 0.65, tt)
		var tz_curve: float = head_back_z + d * lerpf(0.42, 0.80, 1.0 - abs(tt - 0.5) * 2.0)
		var tooth_h: float = h * 0.075
		_build_tapered_segment(root,
			Vector3(tx, jaw_y_bot, tz_curve), w * 0.016,
			Vector3(tx, jaw_y_bot + tooth_h, tz_curve - d * 0.005), w * 0.004,
			fang_color, 0.45)
	# Lower-jaw chin plate (under the mouth)
	_build_box(
		root,
		Vector3(-head_w_front * 0.80, jaw_y_bot - h * 0.04,
			head_back_z + d * 0.35),
		Vector3(head_w_front * 0.80, jaw_y_bot,
			head_front_z - d * 0.02),
		plate_dark, 0.85
	)

	# ============================================================================
	# DORSAL FIN — TALLER signature "shark fin" centered over shoulders.
	# Verify-agent fix: moved forward (z=0.3-0.5), scaled 1.4× taller, slight
	# rearward rake on the tip (canon: single prominent fin breaking soil
	# ahead of the body).
	# ============================================================================
	var fin_root_z: float = d * 0.45
	var fin_back_z: float = d * 0.18
	var fin_root_y: float = body_y + h * 0.30
	# Taller — 1.4× previous (0.95 → 1.33)
	var fin_tip_y: float = body_y + h * (1.33 * fin_size_jitter)
	var fin_front := Vector3(0, fin_root_y, fin_root_z)
	var fin_back := Vector3(0, fin_root_y, fin_back_z)
	# Rearward rake — tip pushed back-of-center
	var fin_tip := Vector3(0, fin_tip_y,
		lerpf(fin_back_z, fin_root_z, 0.35))
	var st_fin := SurfaceTool.new()
	st_fin.begin(Mesh.PRIMITIVE_TRIANGLES)
	# Both faces (cull_disabled makes the thin blade visible from both sides)
	_add_tri(st_fin, fin_front, fin_tip, fin_back)
	_add_tri(st_fin, fin_back, fin_tip, fin_front)
	st_fin.generate_normals()
	var mi_fin := MeshInstance3D.new()
	mi_fin.mesh = st_fin.commit()
	var mat_fin := StandardMaterial3D.new()
	mat_fin.albedo_color = plate_dark
	mat_fin.roughness = 0.65
	mat_fin.cull_mode = BaseMaterial3D.CULL_DISABLED
	mi_fin.material_override = mat_fin
	root.add_child(mi_fin)
	# Bone strut on leading edge
	_build_tapered_segment(root, fin_front, w * 0.022, fin_tip, w * 0.006,
		plate_dark.darkened(0.20), 0.55)
	_build_tapered_segment(root, fin_back, w * 0.022, fin_tip, w * 0.006,
		plate_dark.darkened(0.20), 0.55)

	# ============================================================================
	# SEGMENTED DORSAL ARMOR PLATES — overlapping bands across the back
	# (signature armadillo-shark armor — separate plates with visible seams)
	# ============================================================================
	var plate_z_start: float = d * 0.30
	var plate_z_end: float = -d * 0.38
	for pi in range(plate_count_jitter):
		var pt: float = float(pi) / float(plate_count_jitter - 1)
		var pz: float = lerpf(plate_z_start, plate_z_end, pt)
		# Skip the region directly under the fin
		if pz < fin_root_z and pz > fin_back_z - d * 0.03:
			continue
		# Width of plate — wider mid-body, narrower toward tail
		var plate_w_t: float = lerpf(1.0, 0.65, pt)
		var plate_w: float = w * 0.42 * plate_w_t
		var spine_y: float = body_y + h * 0.28
		# Plate as a thin curved box (small Y height, wraps over the back)
		_build_box(
			root,
			Vector3(-plate_w, spine_y - h * 0.03, pz - d * 0.030),
			Vector3(plate_w, spine_y + h * 0.04, pz + d * 0.025),
			primary, 0.80
		)
		# Plate inner highlight stripe (suggests segmentation seam)
		_build_box(
			root,
			Vector3(-plate_w * 0.92, spine_y + h * 0.025, pz - d * 0.012),
			Vector3(plate_w * 0.92, spine_y + h * 0.045, pz + d * 0.012),
			plate_dark, 0.75
		)
		# Side seam shadow (between plates)
		if pi > 0:
			var seam_z: float = lerpf(plate_z_start, plate_z_end, pt - 0.5 / float(plate_count_jitter - 1))
			_build_box(
				root,
				Vector3(-plate_w * 0.95, spine_y - h * 0.005, seam_z - d * 0.005),
				Vector3(plate_w * 0.95, spine_y + h * 0.015, seam_z + d * 0.005),
				plate_dark, 0.85
			)

	# ============================================================================
	# LEGS — 4 powerful squat legs, FRONTS with SHOVEL CLAWS for burrowing
	# ============================================================================
	for side in [-1, 1]:
		# Front legs — thicker for digging power
		var fhip := Vector3(side * w * 0.36, body_y - h * 0.05, d * 0.18)
		var fknee := Vector3(side * w * 0.40, clearance * 0.50, d * 0.20)
		var fpaw := Vector3(side * w * 0.36, 0.05, d * 0.24)
		_build_tapered_segment(root, fhip, w * 0.18, fknee, w * 0.15, primary, 0.85)
		_build_tapered_segment(root, fknee, w * 0.15, fpaw, w * 0.13, plate_dark, 0.85)
		# Broad foot pad
		_build_box(
			root,
			Vector3(side * w * 0.36 - w * 0.16, 0.0, d * 0.14),
			Vector3(side * w * 0.36 + w * 0.16, h * 0.08, d * 0.36),
			plate_dark, 0.85
		)
		# 4 BIG SHOVEL CLAWS for burrowing (broad and slightly curved down)
		for ci in range(4):
			var co: float = (float(ci) - 1.5) * w * 0.07
			var claw_total: float = d * 0.16
			var mid_pos := Vector3(side * w * 0.36 + co, h * 0.015,
				d * 0.36 + claw_total * 0.55)
			var tip_pos := Vector3(side * w * 0.36 + co, 0.0,
				d * 0.36 + claw_total * 0.95)
			# Wider/flatter claw — shovel shape
			_build_tapered_segment(root,
				Vector3(side * w * 0.36 + co, h * 0.04, d * 0.36), w * 0.032,
				mid_pos, w * 0.020,
				claw_color, 0.40)
			_build_tapered_segment(root, mid_pos, w * 0.020,
				tip_pos, w * 0.010,    # blunter shovel tip
				claw_color, 0.40)

		# Back legs — strong for leaping (canon: bulettes can leap great distances)
		var rhip := Vector3(side * w * 0.34, body_y - h * 0.04, -d * 0.18)
		var rknee := Vector3(side * w * 0.40, clearance * 0.62, -d * 0.12)
		var rhock := Vector3(side * w * 0.34, clearance * 0.25, -d * 0.20)
		var rpaw := Vector3(side * w * 0.32, 0.05, -d * 0.10)
		_build_tapered_segment(root, rhip, w * 0.22, rknee, w * 0.16, primary, 0.85)
		_build_tapered_segment(root, rknee, w * 0.16, rhock, w * 0.14, primary, 0.85)
		_build_tapered_segment(root, rhock, w * 0.14, rpaw, w * 0.12, plate_dark, 0.85)
		# Back foot pad
		_build_box(
			root,
			Vector3(side * w * 0.32 - w * 0.13, 0.0, -d * 0.22),
			Vector3(side * w * 0.32 + w * 0.13, h * 0.07, -d * 0.04),
			plate_dark, 0.85
		)
		# 3 forward claws on back paw (shorter than front shovels)
		for ci in range(3):
			var co: float = (float(ci) - 1.0) * w * 0.06
			_build_tapered_segment(root,
				Vector3(side * w * 0.32 + co, h * 0.04, -d * 0.04), w * 0.022,
				Vector3(side * w * 0.32 + co, 0.0, d * 0.04), w * 0.005,
				claw_color, 0.40)

	# ============================================================================
	# TAIL — short THICK CROCODILIAN STUB with armor banding.
	# Verify-agent fix: previous tail was too thin/pointed; canon bulette
	# tail is short but thick and blunt-tipped with armor plate rings.
	# Base width +40% (0.18 → 0.25), blunt tip (0.030 → 0.085).
	# ============================================================================
	var bul_tail_base := Vector3(0, body_y - h * 0.02, -d * 0.42)
	var bul_tail_mid := Vector3(0, body_y - h * 0.08, -d * 0.60)
	var bul_tail_tip := Vector3(rng.randf_range(-w * 0.04, w * 0.04),
		body_y - h * 0.14, -d * 0.78)
	_build_tapered_segment(root, bul_tail_base, w * 0.25, bul_tail_mid, w * 0.18,
		primary, 0.85)
	_build_tapered_segment(root, bul_tail_mid, w * 0.18, bul_tail_tip, w * 0.085,
		plate_dark, 0.85)
	# Armor plate rings — 2 visible bands matching dorsal segmentation
	for ri in range(2):
		var rt: float = (float(ri) + 0.5) / 2.0    # 0.25, 0.75
		var ring_pos: Vector3 = bul_tail_base.lerp(bul_tail_tip, rt)
		var ring_w: float = lerpf(w * 0.22, w * 0.10, rt)
		_build_box(
			root,
			ring_pos + Vector3(-ring_w, -h * 0.005, -d * 0.012),
			ring_pos + Vector3(ring_w, h * 0.020, d * 0.012),
			plate_dark, 0.80
		)


# ============================================================================
# CAMBION (cambion) — Half-fiend humanoid (D&D MM)
#   - Tall handsome/imposing humanoid with HUMANLIKE BUILD
#   - Curved BACKWARD-SWEEPING HORNS from forehead/temples (signature)
#   - BAT WINGS spread from shoulders (signature)
#   - Red/ashen/purple fiendish skin
#   - Pointed/spaded TAIL
#   - Often hooves OR humanlike feet (50/50)
#   - Wears nobleman/sorcerer garb + martial weapon (longsword)
#   - Glowing eyes
# ============================================================================

static func _build_cambion(plan: Dictionary, root: Node3D) -> void:
	var base: Dictionary = plan.get("base", {})
	var palette: Dictionary = plan.get("palette", {})
	var limbs: Dictionary = plan.get("limbs", {})
	var meta: Dictionary = plan.get("meta", {})
	var species: String = String(meta.get("species", "Cambion"))

	# Tall humanlike build
	var w: float = _axis(base, "width", 0.65)
	var h: float = _axis(base, "height", 2.10)
	var d: float = _axis(base, "depth", 0.50)
	var leg_length: float = float(limbs.get("leg_length", 1.05))
	var clearance: float = leg_length

	var render_seed: int = int(meta.get("render_seed", 0))
	var rng := RandomNumberGenerator.new()
	rng.seed = render_seed if render_seed != 0 else hash(species)

	# Per-individual variation. Verify-agent fix: hooves dropped 50%→10%
	# (canon cambions have humanoid feet; hooves are tiefling/satyr territory).
	var size_jitter: float = rng.randf_range(0.92, 1.12)
	var horn_size_jitter: float = rng.randf_range(0.85, 1.30)
	var wing_open_jitter: float = rng.randf_range(0.50, 1.00)
	var has_hooves: bool = rng.randf() < 0.10
	w *= size_jitter
	h *= size_jitter
	d *= size_jitter
	leg_length *= rng.randf_range(0.95, 1.10)
	clearance = leg_length

	# Fiendish skin palette
	var skin_options := [
		Color(0.62, 0.22, 0.20),     # blood red (canon)
		Color(0.52, 0.30, 0.32),     # ashen red
		Color(0.42, 0.18, 0.30),     # demon plum
		Color(0.48, 0.28, 0.22),     # rust red
		Color(0.35, 0.15, 0.18),     # dark crimson
	]
	var primary: Color = skin_options[rng.randi() % skin_options.size()]
	var skin_dark: Color = primary.darkened(0.30)
	var horn_color := Color(0.20, 0.15, 0.12)
	var horn_dark: Color = horn_color.darkened(0.20)
	var hair_options := [
		Color(0.08, 0.06, 0.06),     # black
		Color(0.35, 0.18, 0.12),     # dark red-brown
		Color(0.65, 0.55, 0.42),     # platinum (sorcerer-prince look)
	]
	var hair: Color = hair_options[rng.randi() % hair_options.size()]
	var cloak_options := [
		Color(0.25, 0.10, 0.30),     # dark purple
		Color(0.18, 0.08, 0.12),     # blood maroon
		Color(0.10, 0.10, 0.15),     # midnight blue-black
		Color(0.30, 0.18, 0.05),     # dark gold-brown
	]
	var cloak: Color = cloak_options[rng.randi() % cloak_options.size()]
	var leather := Color(0.20, 0.12, 0.07)
	var iron := Color(0.55, 0.55, 0.58)
	var iron_dark := Color(0.30, 0.30, 0.32)
	var gold := Color(0.85, 0.65, 0.20)
	var fang_color := Color(0.92, 0.88, 0.78)
	var eye_glow := Color(0.95, 0.45, 0.10)     # burning orange-red

	# ============================================================================
	# TORSO — slim athletic humanoid (more refined than bugbear brute)
	# ============================================================================
	var hip_y: float = clearance
	var waist_y: float = clearance + h * 0.12
	var chest_y: float = clearance + h * 0.30
	var shoulder_y: float = clearance + h * 0.44
	# Waist (narrow)
	_build_box(
		root,
		Vector3(-w * 0.25, hip_y, -d * 0.22),
		Vector3(w * 0.25, waist_y, d * 0.22),
		primary, 0.55
	)
	# Mid (abs)
	_build_box(
		root,
		Vector3(-w * 0.32, waist_y, -d * 0.26),
		Vector3(w * 0.32, chest_y, d * 0.28),
		primary, 0.55
	)
	# Chest (BROAD shoulders — verify-agent fix: previously 0.46 read too
	# slim; cambions are powerfully built warrior-princes, broader than
	# typical human. Now 0.55 for canon shoulder:height ratio ~0.36+).
	_build_box(
		root,
		Vector3(-w * 0.55, chest_y, -d * 0.32),
		Vector3(w * 0.55, shoulder_y, d * 0.34),
		primary, 0.55
	)

	# ============================================================================
	# CLOAK — fiendish noble cloak draped from shoulders (back panel)
	# ============================================================================
	# Shoulder clasp + collar
	_build_box(
		root,
		Vector3(-w * 0.45, shoulder_y - h * 0.02, -d * 0.32),
		Vector3(w * 0.45, shoulder_y + h * 0.05, -d * 0.26),
		cloak, 0.80
	)
	# Cloak panel hangs down the back
	_build_box(
		root,
		Vector3(-w * 0.40, hip_y, -d * 0.34),
		Vector3(w * 0.40, shoulder_y, -d * 0.28),
		cloak, 0.80
	)
	# Cloak hem extends below the hips
	_build_box(
		root,
		Vector3(-w * 0.35, hip_y - h * 0.20, -d * 0.36),
		Vector3(w * 0.35, hip_y, -d * 0.30),
		cloak, 0.80
	)
	# Gold trim along the cloak edge
	_build_box(
		root,
		Vector3(-w * 0.42, shoulder_y, -d * 0.34),
		Vector3(-w * 0.36, hip_y, -d * 0.30),
		gold, 0.30, 0.85
	)
	_build_box(
		root,
		Vector3(w * 0.36, shoulder_y, -d * 0.34),
		Vector3(w * 0.42, hip_y, -d * 0.30),
		gold, 0.30, 0.85
	)

	# Leather vest / sash crossing the chest
	_build_box(
		root,
		Vector3(-w * 0.40, chest_y + h * 0.05, d * 0.30),
		Vector3(w * 0.40, shoulder_y - h * 0.02, d * 0.36),
		leather, 0.85
	)
	# Belt
	_build_box(
		root,
		Vector3(-w * 0.34, waist_y - h * 0.02, -d * 0.30),
		Vector3(w * 0.34, waist_y + h * 0.01, d * 0.30),
		leather, 0.85
	)
	# Gold belt buckle
	_build_box(
		root,
		Vector3(-w * 0.06, waist_y - h * 0.025, d * 0.28),
		Vector3(w * 0.06, waist_y + h * 0.015, d * 0.36),
		gold, 0.30, 0.85
	)
	# Loincloth / sorcerer skirt scraps
	for kang in [-0.5, 0.0, 0.5]:
		var kx: float = sin(kang) * w * 0.28
		var kz: float = cos(kang) * d * 0.26
		_build_box(
			root,
			Vector3(kx - w * 0.09, hip_y - h * 0.05, kz - d * 0.05),
			Vector3(kx + w * 0.09, waist_y - h * 0.010, kz + d * 0.05),
			leather, 0.85
		)

	# ============================================================================
	# HEAD — handsome/striking humanoid face with fiendish features
	# ============================================================================
	# Neck
	var neck_top := Vector3(0, shoulder_y + h * 0.06, d * 0.02)
	_build_tapered_segment(root,
		Vector3(0, shoulder_y - h * 0.01, 0.0), w * 0.11,
		neck_top, w * 0.09,
		primary, 0.55)

	var head_w: float = w * 0.27
	var head_h: float = h * 0.17
	var head_d: float = d * 0.55
	var head_y_bot: float = neck_top.y
	var head_y_top: float = head_y_bot + head_h
	var head_center_y: float = (head_y_bot + head_y_top) * 0.5
	_build_box(
		root,
		Vector3(-head_w, head_y_bot, neck_top.z - head_d * 0.40),
		Vector3(head_w, head_y_top, neck_top.z + head_d * 0.45),
		primary, 0.55
	)

	# GLOWING ORANGE-RED EYES
	for side in [-1, 1]:
		_build_box(
			root,
			Vector3(side * head_w * 0.48 - w * 0.040,
				head_center_y, neck_top.z + head_d * 0.38),
			Vector3(side * head_w * 0.48 + w * 0.040,
				head_center_y + h * 0.025, neck_top.z + head_d * 0.46),
			eye_glow, 0.10, 0.0
		)
		# Pupil
		_build_box(
			root,
			Vector3(side * head_w * 0.48 - w * 0.014,
				head_center_y + h * 0.005, neck_top.z + head_d * 0.43),
			Vector3(side * head_w * 0.48 + w * 0.014,
				head_center_y + h * 0.020, neck_top.z + head_d * 0.46),
			Color(0.05, 0.02, 0.0), 0.30
		)

	# Nose
	_build_box(
		root,
		Vector3(-w * 0.035, head_center_y - h * 0.02,
			neck_top.z + head_d * 0.40),
		Vector3(w * 0.035, head_center_y + h * 0.005,
			neck_top.z + head_d * 0.50),
		primary, 0.55
	)
	# Mouth slit (small)
	_build_box(
		root,
		Vector3(-head_w * 0.30, head_y_bot + h * 0.025,
			neck_top.z + head_d * 0.43),
		Vector3(head_w * 0.30, head_y_bot + h * 0.040,
			neck_top.z + head_d * 0.46),
		Color(0.18, 0.06, 0.04), 0.85
	)
	# Tiny upper fangs (subtle hint of fiendish nature)
	for side in [-1, 1]:
		var fx: float = side * head_w * 0.25
		_build_tapered_segment(root,
			Vector3(fx, head_y_bot + h * 0.030, neck_top.z + head_d * 0.45), w * 0.012,
			Vector3(fx, head_y_bot + h * 0.010, neck_top.z + head_d * 0.46), w * 0.003,
			fang_color, 0.45)

	# WILD HAIR — long flowing from back of head (sorcerer-prince look)
	var hair_count: int = rng.randi_range(6, 9)
	for hi in range(hair_count):
		var ang: float = (float(hi) / float(hair_count)) * TAU
		if cos(ang) > 0.8 and abs(sin(ang)) < 0.3:
			continue
		var hx_root: float = cos(ang) * head_w * 0.85
		var hz_root: float = sin(ang) * head_d * 0.25 - head_d * 0.05
		var root_pos := Vector3(hx_root, head_y_top - h * 0.010,
			neck_top.z + hz_root)
		var hair_len: float = h * rng.randf_range(0.15, 0.30)
		var hair_tip := Vector3(hx_root * 1.20,
			head_y_top - hair_len * 0.6,
			neck_top.z + hz_root - head_d * 0.25)
		_build_tapered_segment(root, root_pos, w * 0.022, hair_tip, w * 0.005,
			hair, 0.85)

	# ============================================================================
	# SIGNATURE HORNS — pair of curved BACKWARD-SWEEPING horns from forehead
	# ============================================================================
	for side in [-1, 1]:
		var horn_base := Vector3(side * head_w * 0.55,
			head_y_top - h * 0.005,
			neck_top.z + head_d * 0.20)
		var horn_mid := Vector3(side * head_w * 0.80,
			head_y_top + h * (0.18 * horn_size_jitter),
			neck_top.z - head_d * 0.05)
		var horn_tip := Vector3(side * head_w * 0.70,
			head_y_top + h * (0.10 * horn_size_jitter),
			neck_top.z - head_d * 0.35)
		_build_tapered_segment(root, horn_base, w * 0.045, horn_mid, w * 0.025,
			horn_color, 0.55)
		_build_tapered_segment(root, horn_mid, w * 0.025, horn_tip, w * 0.006,
			horn_dark, 0.55)

	# ============================================================================
	# BAT WINGS — spread from shoulders (signature fiend wings)
	# ============================================================================
	for side in [-1, 1]:
		var wing_spread: float = w * 2.20 * wing_open_jitter
		var wing_root := Vector3(side * w * 0.42, shoulder_y + h * 0.03, -d * 0.20)
		var wing_elbow := Vector3(side * (w * 0.42 + wing_spread * 0.40),
			shoulder_y + h * 0.20, -d * 0.30)
		var wing_peak := Vector3(side * (w * 0.42 + wing_spread * 0.90),
			shoulder_y + h * 0.05, -d * 0.45)
		_build_tapered_segment(root, wing_root, w * 0.07, wing_elbow, w * 0.05,
			skin_dark, 0.55)
		_build_tapered_segment(root, wing_elbow, w * 0.05, wing_peak, w * 0.02,
			skin_dark, 0.55)
		# Hook claw at peak
		_build_tapered_segment(root, wing_peak, w * 0.018,
			wing_peak + Vector3(side * w * 0.05, h * 0.03, d * 0.02), w * 0.004,
			horn_dark, 0.40)
		# 4 finger struts + membrane
		var struts: int = 4
		var trails: Array = []
		for fi in range(struts):
			var ft: float = float(fi) / float(struts - 1)
			var trail := Vector3(
				lerpf(side * w * 0.36, side * (w * 0.42 + wing_spread * 0.90), ft),
				shoulder_y - h * lerpf(0.10, 0.05, ft),
				-d * lerpf(0.35, 0.30, ft)
			)
			trails.append(trail)
			_build_tapered_segment(root, wing_peak, w * 0.018, trail, w * 0.005,
				skin_dark, 0.55)
		# Membrane (3 panels)
		var st_mem := SurfaceTool.new()
		st_mem.begin(Mesh.PRIMITIVE_TRIANGLES)
		_add_quad(st_mem, wing_root, wing_elbow,
			trails[1] as Vector3, trails[0] as Vector3)
		_add_quad(st_mem, wing_elbow, wing_peak,
			trails[2] as Vector3, trails[1] as Vector3)
		_add_tri(st_mem, wing_peak,
			trails[3] as Vector3, trails[2] as Vector3)
		st_mem.generate_normals()
		var mi_mem := MeshInstance3D.new()
		mi_mem.mesh = st_mem.commit()
		var mat_mem := StandardMaterial3D.new()
		mat_mem.albedo_color = skin_dark.darkened(0.15)
		mat_mem.roughness = 0.65
		mat_mem.cull_mode = BaseMaterial3D.CULL_DISABLED
		mi_mem.material_override = mat_mem
		root.add_child(mi_mem)

	# ============================================================================
	# ARMS — athletic humanoid arms holding LONGSWORD (right) and gesture (left)
	# ============================================================================
	# Right arm — gripping longsword raised slightly
	var r_shoulder := Vector3(w * 0.46, shoulder_y - h * 0.02, 0.0)
	var r_elbow := Vector3(w * 0.58, shoulder_y - h * 0.20, d * 0.08)
	var r_wrist := Vector3(w * 0.50, shoulder_y - h * 0.05, d * 0.40)
	_build_tapered_segment(root, r_shoulder, w * 0.13, r_elbow, w * 0.10, primary, 0.55)
	_build_tapered_segment(root, r_elbow, w * 0.10, r_wrist, w * 0.085, primary, 0.55)
	# Right hand
	_build_box(
		root,
		Vector3(r_wrist.x - w * 0.07, r_wrist.y - h * 0.04, r_wrist.z - d * 0.05),
		Vector3(r_wrist.x + w * 0.07, r_wrist.y + h * 0.01, r_wrist.z + d * 0.06),
		primary, 0.55
	)

	# LONGSWORD — held vertically from the right hand, blade pointing up
	var sword_hilt := Vector3(r_wrist.x, r_wrist.y + h * 0.02, r_wrist.z + d * 0.04)
	var sword_guard_y: float = sword_hilt.y + h * 0.04
	var sword_tip_y: float = sword_hilt.y + h * 0.65
	# Pommel
	_build_box(
		root,
		Vector3(sword_hilt.x - w * 0.030, sword_hilt.y - h * 0.04,
			sword_hilt.z - d * 0.030),
		Vector3(sword_hilt.x + w * 0.030, sword_hilt.y - h * 0.01,
			sword_hilt.z + d * 0.030),
		gold, 0.30, 0.85
	)
	# Grip
	_build_box(
		root,
		Vector3(sword_hilt.x - w * 0.020, sword_hilt.y - h * 0.005,
			sword_hilt.z - d * 0.020),
		Vector3(sword_hilt.x + w * 0.020, sword_guard_y - h * 0.005,
			sword_hilt.z + d * 0.020),
		leather, 0.85
	)
	# Crossguard
	_build_box(
		root,
		Vector3(sword_hilt.x - w * 0.14, sword_guard_y,
			sword_hilt.z - d * 0.030),
		Vector3(sword_hilt.x + w * 0.14, sword_guard_y + h * 0.020,
			sword_hilt.z + d * 0.040),
		gold, 0.30, 0.85
	)
	# Blade (steel)
	_build_tapered_segment(root,
		Vector3(sword_hilt.x, sword_guard_y + h * 0.02, sword_hilt.z), w * 0.030,
		Vector3(sword_hilt.x, sword_tip_y, sword_hilt.z), w * 0.005,
		Color(0.75, 0.75, 0.78), 0.20, 0.90)

	# Left arm — relaxed at side
	var l_shoulder := Vector3(-w * 0.46, shoulder_y - h * 0.02, 0.0)
	var l_elbow := Vector3(-w * 0.50, shoulder_y - h * 0.22, d * 0.06)
	var l_wrist := Vector3(-w * 0.42, shoulder_y - h * 0.38, d * 0.18)
	_build_tapered_segment(root, l_shoulder, w * 0.13, l_elbow, w * 0.10, primary, 0.55)
	_build_tapered_segment(root, l_elbow, w * 0.10, l_wrist, w * 0.085, primary, 0.55)
	# Left hand
	_build_box(
		root,
		Vector3(l_wrist.x - w * 0.07, l_wrist.y - h * 0.04, l_wrist.z - d * 0.05),
		Vector3(l_wrist.x + w * 0.07, l_wrist.y + h * 0.01, l_wrist.z + d * 0.06),
		primary, 0.55
	)
	# Fingers (left)
	for ci in range(4):
		var ct: float = (float(ci) - 1.5) / 2.0
		var cx: float = l_wrist.x + ct * w * 0.035
		_build_tapered_segment(root,
			Vector3(cx, l_wrist.y - h * 0.03, l_wrist.z + d * 0.06), w * 0.012,
			Vector3(cx + ct * w * 0.015, l_wrist.y - h * 0.075, l_wrist.z + d * 0.12),
			w * 0.003,
			horn_dark, 0.40)

	# ============================================================================
	# LEGS — athletic humanoid; 50% have hooves, 50% have humanlike booted feet
	# ============================================================================
	for side in [-1, 1]:
		var hip := Vector3(side * w * 0.18, hip_y + h * 0.02, 0.0)
		var knee := Vector3(side * w * 0.20, clearance * 0.50, d * 0.04)
		var ankle := Vector3(side * w * 0.18, clearance * 0.15, -d * 0.02)
		_build_tapered_segment(root, hip, w * 0.16, knee, w * 0.12, primary, 0.55)
		_build_tapered_segment(root, knee, w * 0.12, ankle, w * 0.10, primary, 0.55)
		if has_hooves:
			# CLOVEN HOOF — two black prongs (devil-prince look)
			for prong in [-1, 1]:
				_build_box(
					root,
					Vector3(side * w * 0.18 + prong * w * 0.05 - w * 0.040,
						0.0, -d * 0.06),
					Vector3(side * w * 0.18 + prong * w * 0.05 + w * 0.040,
						h * 0.10, d * 0.18),
					Color(0.08, 0.06, 0.04), 0.40, 0.20
				)
		else:
			# Tall noble boot
			_build_box(
				root,
				Vector3(side * w * 0.18 - w * 0.12, 0.0, -d * 0.08),
				Vector3(side * w * 0.18 + w * 0.12, h * 0.18, d * 0.20),
				leather, 0.85
			)
			# Boot trim (gold)
			_build_box(
				root,
				Vector3(side * w * 0.18 - w * 0.13, h * 0.16, -d * 0.10),
				Vector3(side * w * 0.18 + w * 0.13, h * 0.20, d * 0.22),
				gold, 0.30, 0.85
			)

	# ============================================================================
	# TAIL — long thin pointed/spaded fiendish tail
	# ============================================================================
	var tail_base := Vector3(0, hip_y + h * 0.04, -d * 0.22)
	var tail_mid := Vector3(rng.randf_range(-w * 0.05, w * 0.05),
		hip_y - h * 0.10, -d * 0.50)
	var tail_tip := Vector3(rng.randf_range(-w * 0.15, w * 0.15),
		hip_y - h * 0.05, -d * 0.85)
	_build_tapered_segment(root, tail_base, w * 0.06, tail_mid, w * 0.035, primary, 0.55)
	_build_tapered_segment(root, tail_mid, w * 0.035, tail_tip, w * 0.015,
		skin_dark, 0.55)
	# SIMPLE SPADE TIP — single flat diamond/arrowhead (verify-agent fix:
	# previous side prongs read as pit fiend; canon cambion tail is a
	# simple ~0.12-wide flat spade).
	_build_box(
		root,
		Vector3(tail_tip.x - w * 0.06, tail_tip.y - h * 0.025, tail_tip.z - d * 0.05),
		Vector3(tail_tip.x + w * 0.06, tail_tip.y + h * 0.030, tail_tip.z + d * 0.015),
		horn_dark, 0.50
	)
	# Pointed back-spike of the spade (gives the diamond a tip)
	_build_tapered_segment(root,
		Vector3(tail_tip.x, tail_tip.y + h * 0.003, tail_tip.z - d * 0.04),
		w * 0.030,
		Vector3(tail_tip.x, tail_tip.y - h * 0.005, tail_tip.z - d * 0.10),
		w * 0.006,
		horn_dark, 0.50)


# ============================================================================
# CAMEL (camel) — Desert quadruped (dromedary or bactrian)
#   - Stocky long-legged quadruped
#   - 1 OR 2 HUMPS on the back (signature — dromedary 1, bactrian 2)
#   - Long S-CURVING NECK
#   - Long flat face with squarish muzzle + split upper lip
#   - Tan/sandy/cream fur with darker hump tips
#   - SPLAY-TOED PAD FEET (NOT hooves — wide soft sand pads)
#   - Tasseled tail
#   - Long eyelashes (canon detail)
# ============================================================================

static func _build_camel(plan: Dictionary, root: Node3D) -> void:
	var base: Dictionary = plan.get("base", {})
	var palette: Dictionary = plan.get("palette", {})
	var limbs: Dictionary = plan.get("limbs", {})
	var meta: Dictionary = plan.get("meta", {})
	var species: String = String(meta.get("species", "Camel"))

	# Tall narrow long-legged quadruped (verify-agent fix: was bulldog-thick
	# at 0.65 × 1.45 × 1.80; canon dromedaries are narrow-and-tall with
	# silhouette height exceeding body length).
	var w: float = _axis(base, "width", 0.50)
	var h: float = _axis(base, "height", 1.75)
	var d: float = _axis(base, "depth", 2.10)
	var leg_length: float = float(limbs.get("leg_length", 0.95))
	var clearance: float = leg_length

	var render_seed: int = int(meta.get("render_seed", 0))
	var rng := RandomNumberGenerator.new()
	rng.seed = render_seed if render_seed != 0 else hash(species)

	# Per-individual variation
	var size_jitter: float = rng.randf_range(0.92, 1.15)
	var hump_count: int = 2 if rng.randf() < 0.30 else 1     # 30% bactrian, 70% dromedary
	var hump_size_jitter: float = rng.randf_range(0.85, 1.30)
	w *= size_jitter
	h *= size_jitter
	d *= size_jitter
	leg_length *= rng.randf_range(0.95, 1.10)
	clearance = leg_length

	# Coat palette — canon tan/sand
	var coat_options := [
		Color(0.78, 0.62, 0.40),     # sandy tan (canon)
		Color(0.85, 0.70, 0.45),     # cream
		Color(0.62, 0.45, 0.28),     # dark sand
		Color(0.92, 0.78, 0.55),     # pale gold
		Color(0.55, 0.38, 0.22),     # warm brown (older)
	]
	var primary: Color = coat_options[rng.randi() % coat_options.size()]
	var fur_dark: Color = primary.darkened(0.25)
	var belly_color: Color = primary.lightened(0.10)
	var hoof_color := Color(0.20, 0.16, 0.12)
	var eye_color := Color(0.18, 0.10, 0.05)

	# ============================================================================
	# BODY — stocky trunk; the hump(s) are built separately on top
	# ============================================================================
	var body_y: float = clearance + h * 0.22
	var body_sections: Array = [
		{"center": Vector3(0, body_y - h * 0.02, -d * 0.42), "w": w * 0.32, "h": h * 0.30},  # rump
		{"center": Vector3(0, body_y, -d * 0.22), "w": w * 0.46, "h": h * 0.40},             # hip
		{"center": Vector3(0, body_y, -d * 0.05), "w": w * 0.50, "h": h * 0.44},             # mid back
		{"center": Vector3(0, body_y, d * 0.12), "w": w * 0.50, "h": h * 0.44},              # shoulder
		{"center": Vector3(0, body_y + h * 0.05, d * 0.28), "w": w * 0.40, "h": h * 0.40},   # chest
		{"center": Vector3(0, body_y + h * 0.10, d * 0.40), "w": w * 0.28, "h": h * 0.32},   # neck base
	]
	_swept_body(root, body_sections, 10, primary, belly_color, 0.95, true)

	# BRISKET PAD — dark leathery patch on the lower chest where the camel
	# kneels (signature camel callosity along with knee pads).
	_build_box(
		root,
		Vector3(-w * 0.18, body_y - h * 0.12, d * 0.22),
		Vector3(w * 0.18, body_y + h * 0.02, d * 0.38),
		Color(0.20, 0.14, 0.08), 0.85
	)

	# ============================================================================
	# HUMP(S) — 1 or 2 fatty humps on the back (signature)
	# Built as additional flatter swept segments riding on top of the spine.
	# ============================================================================
	var hump_base_y: float = body_y + h * 0.22
	var hump_top_y: float = body_y + h * (0.48 * hump_size_jitter)
	if hump_count == 1:
		# Single central hump (dromedary)
		var hump_sections: Array = [
			{"center": Vector3(0, hump_base_y, -d * 0.08), "w": w * 0.20, "h": h * 0.10},
			{"center": Vector3(0, hump_top_y, d * 0.00), "w": w * 0.28, "h": h * 0.22},     # peak
			{"center": Vector3(0, hump_base_y, d * 0.16), "w": w * 0.20, "h": h * 0.10},
		]
		_swept_body(root, hump_sections, 8, primary, fur_dark, 0.95, true)
		# Darker tuft on top of the hump
		_build_box(
			root,
			Vector3(-w * 0.10, hump_top_y + h * 0.005, -d * 0.04),
			Vector3(w * 0.10, hump_top_y + h * 0.030, d * 0.08),
			fur_dark, 0.95
		)
	else:
		# Two humps (bactrian) — front (smaller) + back (larger), with valley between
		var bactr_humps: Array = [
			{"z_center": -d * 0.08, "z_span": d * 0.18, "size_mult": 0.95},   # back hump
			{"z_center": d * 0.16, "z_span": d * 0.18, "size_mult": 1.00},    # front hump
		]
		for hump_info in bactr_humps:
			var hi: Dictionary = hump_info
			var hz_center: float = float(hi["z_center"])
			var hz_span: float = float(hi["z_span"])
			var hs_mult: float = float(hi["size_mult"])
			var hump_sections: Array = [
				{"center": Vector3(0, hump_base_y, hz_center - hz_span * 0.50),
					"w": w * 0.15, "h": h * 0.08},
				{"center": Vector3(0, hump_top_y * hs_mult - h * 0.10, hz_center),
					"w": w * 0.22, "h": h * 0.18},     # peak
				{"center": Vector3(0, hump_base_y, hz_center + hz_span * 0.50),
					"w": w * 0.15, "h": h * 0.08},
			]
			_swept_body(root, hump_sections, 8, primary, fur_dark, 0.95, true)
			# Tuft on top
			_build_box(
				root,
				Vector3(-w * 0.08, hump_top_y * hs_mult - h * 0.09,
					hz_center - d * 0.03),
				Vector3(w * 0.08, hump_top_y * hs_mult - h * 0.07,
					hz_center + d * 0.03),
				fur_dark, 0.95
			)

	# ============================================================================
	# NECK — long S-CURVING neck (canon camel signature). Verify-agent fix:
	# neck base shifted forward (+d*0.22) so the withers/shoulder is visible
	# BETWEEN the neck base and the hump front, not emerging from the hump.
	# ============================================================================
	var withers := Vector3(0,
		(body_sections[5]["center"] as Vector3).y + h * 0.04,
		(body_sections[5]["center"] as Vector3).z + d * 0.22)
	var neck_base := withers
	var neck_low := Vector3(0, neck_base.y + h * 0.18,
		neck_base.z + d * 0.08)
	var neck_high := Vector3(0, neck_base.y + h * 0.42,
		neck_base.z + d * 0.18)
	var neck_top := Vector3(0, neck_base.y + h * 0.40,
		neck_base.z + d * 0.34)
	# Withers bump (shoulder meat between hump and neck origin)
	_build_box(
		root,
		Vector3(-w * 0.18, neck_base.y - h * 0.08, neck_base.z - d * 0.05),
		Vector3(w * 0.18, neck_base.y + h * 0.02, neck_base.z + d * 0.08),
		primary, 0.95
	)
	_build_tapered_segment(root, neck_base, w * 0.18, neck_low, w * 0.15,
		primary, 0.95)
	_build_tapered_segment(root, neck_low, w * 0.15, neck_high, w * 0.13,
		primary, 0.95)
	_build_tapered_segment(root, neck_high, w * 0.13, neck_top, w * 0.13,
		primary, 0.95)

	# ============================================================================
	# HEAD — long flat face, squarish muzzle, split upper lip
	# ============================================================================
	var head_anchor := Vector3(0, neck_top.y - h * 0.04, neck_top.z + d * 0.10)
	var skull_w: float = w * 0.22
	var skull_h: float = h * 0.18
	var skull_d: float = d * 0.32
	var skull_y_bot: float = head_anchor.y - skull_h * 0.30
	var skull_y_top: float = skull_y_bot + skull_h
	var skull_center_y: float = (skull_y_bot + skull_y_top) * 0.5
	# Long flat skull
	_build_box(
		root,
		Vector3(-skull_w, skull_y_bot, head_anchor.z - skull_d * 0.25),
		Vector3(skull_w, skull_y_top, head_anchor.z + skull_d * 0.45),
		primary, 0.95
	)
	# Long squarish muzzle (camels have a distinctive long flat snout)
	_build_box(
		root,
		Vector3(-skull_w * 0.85, skull_y_bot + h * 0.005,
			head_anchor.z + skull_d * 0.45 - d * 0.005),
		Vector3(skull_w * 0.85, skull_y_top - h * 0.04,
			head_anchor.z + skull_d * 0.95),
		primary, 0.95
	)
	# SPLIT UPPER LIP — small notch box at the front of the muzzle
	# (signature camelid feature — visible split between two upper lip lobes)
	for lip_side in [-1, 1]:
		_build_box(
			root,
			Vector3(lip_side * skull_w * 0.20, skull_y_bot - h * 0.005,
				head_anchor.z + skull_d * 0.88),
			Vector3(lip_side * skull_w * 0.55, skull_y_bot + h * 0.020,
				head_anchor.z + skull_d * 0.96),
			fur_dark, 0.95
		)
	# Slit forward-facing NOSTRILS on top of snout
	for side in [-1, 1]:
		_build_box(
			root,
			Vector3(side * skull_w * 0.30 - w * 0.015,
				skull_y_top - h * 0.06, head_anchor.z + skull_d * 0.82),
			Vector3(side * skull_w * 0.30 + w * 0.015,
				skull_y_top - h * 0.04, head_anchor.z + skull_d * 0.90),
			fur_dark, 0.95
		)
	# Heavy brow ridge (sun protection)
	_build_box(
		root,
		Vector3(-skull_w * 1.05, skull_center_y + h * 0.02,
			head_anchor.z + skull_d * 0.05),
		Vector3(skull_w * 1.05, skull_center_y + h * 0.05,
			head_anchor.z + skull_d * 0.30),
		fur_dark, 0.95
	)
	# Eyes — small dark with surrounding darker ring (suggests long eyelashes)
	for side in [-1, 1]:
		# Eyelash ring
		_build_box(
			root,
			Vector3(side * skull_w * 0.55 - w * 0.050,
				skull_center_y - h * 0.015, head_anchor.z + skull_d * 0.18),
			Vector3(side * skull_w * 0.55 + w * 0.050,
				skull_center_y + h * 0.040, head_anchor.z + skull_d * 0.30),
			fur_dark, 0.95
		)
		# Eye
		_build_box(
			root,
			Vector3(side * skull_w * 0.55 - w * 0.025,
				skull_center_y - h * 0.005, head_anchor.z + skull_d * 0.22),
			Vector3(side * skull_w * 0.55 + w * 0.025,
				skull_center_y + h * 0.025, head_anchor.z + skull_d * 0.30),
			eye_color, 0.40
		)
	# Lower jaw (flat)
	_build_box(
		root,
		Vector3(-skull_w * 0.75, skull_y_bot - h * 0.025,
			head_anchor.z + skull_d * 0.30),
		Vector3(skull_w * 0.75, skull_y_bot + h * 0.005,
			head_anchor.z + skull_d * 0.85),
		primary, 0.95
	)
	# EARS — small rounded forward-pointing
	for side in [-1, 1]:
		_build_box(
			root,
			Vector3(side * skull_w * 0.65, skull_y_top - h * 0.005,
				head_anchor.z + skull_d * 0.05),
			Vector3(side * skull_w * 0.95, skull_y_top + h * 0.05,
				head_anchor.z + skull_d * 0.18),
			primary, 0.95
		)

	# ============================================================================
	# LEGS — 4 LONG STRAIGHT LEGS with SPLAY-TOED PAD FEET (NOT hooves)
	# Camels have wide soft sand pads — distinctive vs horse/cattle hooves.
	# ============================================================================
	for side in [-1, 1]:
		# Front legs (straight standing)
		var fhip := Vector3(side * w * 0.22, body_y - h * 0.05, d * 0.16)
		var fknee := Vector3(side * w * 0.22, clearance * 0.55, d * 0.18)
		var fpad := Vector3(side * w * 0.20, 0.04, d * 0.20)
		_build_tapered_segment(root, fhip, w * 0.10, fknee, w * 0.08, primary, 0.95)
		# KNEE CALLOSITY — dark leathery pad at the knee (signature camel)
		_build_box(
			root,
			fknee + Vector3(-w * 0.07, -h * 0.025, -d * 0.03),
			fknee + Vector3(w * 0.07, h * 0.025, d * 0.07),
			Color(0.20, 0.14, 0.08), 0.85
		)
		_build_tapered_segment(root, fknee, w * 0.08, fpad, w * 0.075, fur_dark, 0.95)
		# Foot pad — WIDE SPLAY-TOED PAD (signature camel sand pad)
		_build_box(
			root,
			Vector3(side * w * 0.20 - w * 0.14, 0.0, d * 0.10),
			Vector3(side * w * 0.20 + w * 0.14, h * 0.04, d * 0.32),
			fur_dark, 0.85
		)
		# Two toe pads visible at the front (split-toed)
		for ts in [-1, 1]:
			_build_box(
				root,
				Vector3(side * w * 0.20 + ts * w * 0.06 - w * 0.045,
					0.0, d * 0.30),
				Vector3(side * w * 0.20 + ts * w * 0.06 + w * 0.045,
					h * 0.025, d * 0.36),
				hoof_color, 0.55
			)

		# Back legs (slightly angled — camels have characteristic back-leg shape)
		var rhip := Vector3(side * w * 0.22, body_y - h * 0.02, -d * 0.18)
		var rknee := Vector3(side * w * 0.24, clearance * 0.58, -d * 0.10)
		var rpad := Vector3(side * w * 0.22, 0.04, -d * 0.16)
		_build_tapered_segment(root, rhip, w * 0.12, rknee, w * 0.09, primary, 0.95)
		# Rear knee callosity (smaller than front)
		_build_box(
			root,
			rknee + Vector3(-w * 0.06, -h * 0.020, -d * 0.03),
			rknee + Vector3(w * 0.06, h * 0.020, d * 0.05),
			Color(0.20, 0.14, 0.08), 0.85
		)
		_build_tapered_segment(root, rknee, w * 0.09, rpad, w * 0.075, fur_dark, 0.95)
		_build_box(
			root,
			Vector3(side * w * 0.22 - w * 0.14, 0.0, -d * 0.28),
			Vector3(side * w * 0.22 + w * 0.14, h * 0.04, -d * 0.06),
			fur_dark, 0.85
		)
		for ts in [-1, 1]:
			_build_box(
				root,
				Vector3(side * w * 0.22 + ts * w * 0.06 - w * 0.045,
					0.0, -d * 0.10),
				Vector3(side * w * 0.22 + ts * w * 0.06 + w * 0.045,
					h * 0.025, -d * 0.04),
				hoof_color, 0.55
			)

	# ============================================================================
	# TAIL — medium-length with TASSELED TIP
	# ============================================================================
	var tail_base := Vector3(0, body_y - h * 0.02, -d * 0.42)
	var tail_mid := Vector3(0, body_y - h * 0.20, -d * 0.55)
	var tail_tip := Vector3(rng.randf_range(-w * 0.05, w * 0.05),
		body_y - h * 0.38, -d * 0.70)
	_build_tapered_segment(root, tail_base, w * 0.06, tail_mid, w * 0.040,
		primary, 0.95)
	_build_tapered_segment(root, tail_mid, w * 0.040, tail_tip, w * 0.025,
		fur_dark, 0.95)
	# Tassel tuft — 5 bristly strands fanning at the tip
	for tu in range(5):
		var t_ang: float = (float(tu) - 2.0) * 0.30
		var tassel_tip := tail_tip + Vector3(
			sin(t_ang) * w * 0.08,
			-h * rng.randf_range(0.05, 0.10),
			cos(t_ang) * d * 0.04 - d * 0.05
		)
		_build_tapered_segment(root,
			tail_tip, w * 0.022,
			tassel_tip, w * 0.005,
			fur_dark, 0.95)


# ============================================================================
# CARRION CRAWLER (carrion_crawler) — Worm-centipede dungeon scavenger
#   - Long SEGMENTED WORM-LIKE BODY (8-10 segments visible)
#   - MANY SHORT LEGS along body sides (centipede — ~14-18 total)
#   - 8 PARALYTIC TENTACLES drooping/waving around the mouth (signature)
#   - SICKLY YELLOW-GREEN color (canon)
#   - Mandibled mouth + COMPOUND EYES on stalks or sides of head
#   - Low body that hugs floor (carrion eater)
# ============================================================================

static func _build_carrion_crawler(plan: Dictionary, root: Node3D) -> void:
	var base: Dictionary = plan.get("base", {})
	var palette: Dictionary = plan.get("palette", {})
	var limbs: Dictionary = plan.get("limbs", {})
	var meta: Dictionary = plan.get("meta", {})
	var species: String = String(meta.get("species", "Carrion Crawler"))

	# Long low worm-like body
	var w: float = _axis(base, "width", 0.65)
	var h: float = _axis(base, "height", 0.55)
	var d: float = _axis(base, "depth", 2.40)
	var leg_length: float = float(limbs.get("leg_length", 0.18))
	var clearance: float = leg_length

	var render_seed: int = int(meta.get("render_seed", 0))
	var rng := RandomNumberGenerator.new()
	rng.seed = render_seed if render_seed != 0 else hash(species)

	# Per-individual variation
	var size_jitter: float = rng.randf_range(0.90, 1.18)
	var tentacle_curl_jitter: float = rng.randf_range(0.7, 1.4)
	w *= size_jitter
	h *= size_jitter
	d *= size_jitter
	leg_length *= rng.randf_range(0.92, 1.10)
	clearance = leg_length

	# Sickly yellow-green palette — canon
	var skin_options := [
		Color(0.55, 0.62, 0.20),     # sickly yellow-green (canon)
		Color(0.45, 0.55, 0.22),     # olive
		Color(0.62, 0.65, 0.28),     # mustard
		Color(0.40, 0.50, 0.20),     # dark olive
		Color(0.55, 0.55, 0.18),     # yellow-ochre
	]
	var primary: Color = skin_options[rng.randi() % skin_options.size()]
	var skin_dark: Color = primary.darkened(0.30)
	var belly_color: Color = primary.lightened(0.10).lerp(Color(0.75, 0.70, 0.40), 0.3)
	var tentacle_color: Color = primary.lerp(Color(0.40, 0.20, 0.30), 0.3)  # purplish-tinged
	var mandible_color := Color(0.20, 0.16, 0.10)
	var eye_color := Color(0.85, 0.85, 0.10)     # yellow compound eyes
	var claw_color := Color(0.10, 0.08, 0.05)

	# ============================================================================
	# BODY — long segmented worm trunk with visible ring segments
	# Built via _swept_body with 7 sections + visible segment seams between.
	# ============================================================================
	var body_y: float = clearance + h * 0.18
	var body_sections: Array = [
		{"center": Vector3(0, body_y - h * 0.02, -d * 0.46), "w": w * 0.18, "h": h * 0.20},  # tail tip
		{"center": Vector3(0, body_y - h * 0.01, -d * 0.34), "w": w * 0.32, "h": h * 0.32},
		{"center": Vector3(0, body_y, -d * 0.18), "w": w * 0.44, "h": h * 0.42},
		{"center": Vector3(0, body_y, -d * 0.02), "w": w * 0.50, "h": h * 0.48},             # mid (widest)
		{"center": Vector3(0, body_y, d * 0.15), "w": w * 0.48, "h": h * 0.46},
		{"center": Vector3(0, body_y, d * 0.30), "w": w * 0.44, "h": h * 0.42},
		{"center": Vector3(0, body_y + h * 0.05, d * 0.42), "w": w * 0.36, "h": h * 0.36},   # head base
	]
	_swept_body(root, body_sections, 10, primary, belly_color, 0.85, true)

	# SEGMENT SEAM RINGS — 6 visible darker rings between sections (centipede look)
	var seam_z_positions: Array = [-d * 0.40, -d * 0.26, -d * 0.10,
								   d * 0.08, d * 0.22, d * 0.36]
	for sz in seam_z_positions:
		var seam_z: float = sz as float
		# Approximate body radius at this z (use widest as scale)
		var ring_w: float = w * 0.50
		_build_box(
			root,
			Vector3(-ring_w * 1.02, body_y - h * 0.24, seam_z - d * 0.012),
			Vector3(ring_w * 1.02, body_y + h * 0.24, seam_z + d * 0.012),
			skin_dark, 0.85
		)

	# ============================================================================
	# HEAD — bulbous segment at the front with mandibles + eyes + tentacles
	# ============================================================================
	var head_anchor := Vector3(0, body_y + h * 0.05, d * 0.55)
	# Head bulb
	_build_box(
		root,
		Vector3(-w * 0.28, body_y - h * 0.10, d * 0.42),
		Vector3(w * 0.28, body_y + h * 0.28, d * 0.65),
		primary, 0.85
	)
	# SMALL DULL EYES — verify-agent fix: previous large yellow compound eyes
	# read as "giant insect"; canon carrion crawlers have small dull eyes
	# (hunt by smell + tentacle-sense). Pale sclera + dark pupil dot.
	for side in [-1, 1]:
		# Small recessed eye socket (pale)
		_build_box(
			root,
			Vector3(side * w * 0.28, body_y + h * 0.09, d * 0.55),
			Vector3(side * w * 0.32, body_y + h * 0.14, d * 0.60),
			Color(0.75, 0.72, 0.55), 0.65
		)
		# Tiny dark pupil dot
		_build_box(
			root,
			Vector3(side * w * 0.295, body_y + h * 0.105, d * 0.58),
			Vector3(side * w * 0.315, body_y + h * 0.125, d * 0.605),
			Color(0.06, 0.05, 0.04), 0.70
		)

	# CEPHALOPOD-STYLE BEAK — small dark downward-pointing beak recessed
	# inside the tentacle ring (verify-agent fix: jutting mandibles read as
	# ankheg/umber hulk). Two short triangular chitin pieces meeting vertically.
	# Upper beak (small downward triangle)
	_build_tapered_segment(root,
		Vector3(0, body_y + h * 0.03, d * 0.65), w * 0.060,
		Vector3(0, body_y - h * 0.07, d * 0.66), w * 0.018,
		mandible_color, 0.55)
	# Lower beak (small upward triangle below the upper one)
	_build_tapered_segment(root,
		Vector3(0, body_y - h * 0.10, d * 0.65), w * 0.045,
		Vector3(0, body_y - h * 0.02, d * 0.66), w * 0.015,
		mandible_color.darkened(0.20), 0.55)

	# Mouth interior — dark void behind the beak (recessed inside head)
	_build_box(
		root,
		Vector3(-w * 0.10, body_y - h * 0.06, d * 0.61),
		Vector3(w * 0.10, body_y + h * 0.04, d * 0.65),
		Color(0.08, 0.04, 0.04), 0.90
	)

	# ============================================================================
	# 8 PARALYTIC TENTACLES — drooping/waving from around the mouth
	# (THE signature carrion crawler feature)
	# Arranged in a ring at the front of the head, drooping forward + down.
	# ============================================================================
	for ti in range(8):
		var t_ang: float = (float(ti) / 8.0) * TAU
		# Anchor on a ring around the mouth
		var anchor_x: float = cos(t_ang) * w * 0.22
		var anchor_y: float = body_y + h * 0.08 + sin(t_ang) * h * 0.18
		var anchor_z: float = d * 0.62
		var anchor := Vector3(anchor_x, anchor_y, anchor_z)
		# Tip droops down + forward, with curl jittered
		var tip_t: float = tentacle_curl_jitter * rng.randf_range(0.85, 1.20)
		var tip_x: float = anchor_x * 1.5 + rng.randf_range(-w * 0.05, w * 0.05)
		var tip_y: float = anchor_y - h * (0.40 + 0.20 * tip_t)
		var tip_z: float = anchor_z + d * (0.25 + 0.10 * tip_t)
		var tip_pos := Vector3(tip_x, tip_y, tip_z)
		# 3-segment tentacle with curving mid-point for organic droop
		var mid_pos := Vector3(
			anchor_x * 1.2 + rng.randf_range(-w * 0.03, w * 0.03),
			(anchor_y + tip_y) * 0.5 - h * 0.05,
			anchor_z + d * (0.10 + 0.05 * tip_t)
		)
		# Base → mid (fat)
		_build_tapered_segment(root, anchor, w * 0.035, mid_pos, w * 0.020,
			tentacle_color, 0.45)
		# Mid → tip (thin)
		_build_tapered_segment(root, mid_pos, w * 0.020, tip_pos, w * 0.006,
			tentacle_color.darkened(0.15), 0.45)
		# Tiny suction-cup nub at the tip
		_build_box(
			root,
			tip_pos + Vector3(-w * 0.012, -h * 0.010, -d * 0.012),
			tip_pos + Vector3(w * 0.012, h * 0.010, d * 0.012),
			tentacle_color.lightened(0.10), 0.45
		)

	# ============================================================================
	# LEGS — DENSE centipede legs along the body sides (10 pairs = 20 legs).
	# Verify-agent fix: was 7 pairs with front-larger emphasis (ant-coded);
	# now 10 pairs at UNIFORM scale for proper centipede-worm density.
	# ============================================================================
	var leg_z_positions: Array = [d * 0.38, d * 0.28, d * 0.18, d * 0.08, d * -0.02,
								  -d * 0.12, -d * 0.22, -d * 0.30, -d * 0.38, -d * 0.44]
	for pair_idx in range(leg_z_positions.size()):
		var lz: float = leg_z_positions[pair_idx] as float
		# Uniform scale across all leg pairs
		var leg_scale: float = 0.95
		for side in [-1, 1]:
			var hip := Vector3(side * w * 0.32, body_y - h * 0.08, lz)
			# Splay outward + slightly forward
			var knee := Vector3(side * w * 0.46, clearance * 0.45 * leg_scale,
				lz + d * 0.02)
			var foot := Vector3(side * w * 0.48, 0.02, lz - d * 0.01)
			# Upper segment
			_build_tapered_segment(root, hip, w * 0.040 * leg_scale,
				knee, w * 0.025 * leg_scale, skin_dark, 0.85)
			# Lower segment
			_build_tapered_segment(root, knee, w * 0.025 * leg_scale,
				foot, w * 0.022 * leg_scale, skin_dark, 0.85)
			# Tiny claw at the foot tip
			_build_tapered_segment(root,
				foot, w * 0.018 * leg_scale,
				foot + Vector3(side * w * 0.02, -h * 0.005, -d * 0.02),
				w * 0.004,
				claw_color, 0.40)


# ============================================================================
# CAT (cat) — Domestic housecat (D&D MM CR 0)
#   - Small slim quadruped
#   - TRIANGULAR FACE with pointed UPRIGHT EARS
#   - Almond eyes with slit pupils
#   - Long whiskers
#   - LONG curling/upright TAIL (signature cat posture)
#   - Soft round paws (claws retracted by default)
#   - Varied coat colors + patterns (tabby/calico/tuxedo/etc.)
# ============================================================================

static func _build_cat(plan: Dictionary, root: Node3D) -> void:
	var base: Dictionary = plan.get("base", {})
	var palette: Dictionary = plan.get("palette", {})
	var limbs: Dictionary = plan.get("limbs", {})
	var meta: Dictionary = plan.get("meta", {})
	var species: String = String(meta.get("species", "Cat"))

	# Small slim quadruped — cats are LOW and LONG (2:1 length:height canon).
	# Verify-agent fix: previous 1.57:1 ratio read as small dog/fox.
	var w: float = _axis(base, "width", 0.20)
	var h: float = _axis(base, "height", 0.28)
	var d: float = _axis(base, "depth", 0.64)
	var leg_length: float = float(limbs.get("leg_length", 0.18))
	var clearance: float = leg_length

	var render_seed: int = int(meta.get("render_seed", 0))
	var rng := RandomNumberGenerator.new()
	rng.seed = render_seed if render_seed != 0 else hash(species)

	# Per-individual variation. Verify-agent fix: lynx tufts dropped 25%→5%
	# (canon ear-tufts are bobcat/Maine Coon trait, not baseline housecat).
	var size_jitter: float = rng.randf_range(0.88, 1.18)
	var tail_curl_jitter: float = rng.randf_range(0.0, 1.0)
	var ear_tuft_jitter: bool = rng.randf() < 0.05
	# Back arch sign — some cats are arched (positive dip removal), some neutral
	var back_neutral: bool = rng.randf() < 0.55
	w *= size_jitter
	h *= size_jitter
	d *= size_jitter
	leg_length *= rng.randf_range(0.95, 1.10)
	clearance = leg_length

	# Coat phase — pick a base + pattern combo
	var coat_phase_roll: float = rng.randf()
	var primary: Color
	var pattern_color: Color
	var has_stripes: bool = false
	var has_patches: bool = false
	var has_white_socks: bool = false
	if coat_phase_roll < 0.20:
		# BLACK
		primary = Color(0.08, 0.07, 0.07)
		pattern_color = primary
	elif coat_phase_roll < 0.35:
		# WHITE
		primary = Color(0.92, 0.90, 0.85)
		pattern_color = primary
	elif coat_phase_roll < 0.55:
		# TABBY (orange or grey base + dark stripes)
		if rng.randf() < 0.5:
			primary = Color(0.78, 0.55, 0.25)        # orange tabby
			pattern_color = Color(0.45, 0.25, 0.10)
		else:
			primary = Color(0.55, 0.50, 0.42)        # grey tabby
			pattern_color = Color(0.20, 0.18, 0.15)
		has_stripes = true
	elif coat_phase_roll < 0.70:
		# TUXEDO (black with white socks/chest)
		primary = Color(0.10, 0.08, 0.08)
		pattern_color = Color(0.92, 0.90, 0.85)
		has_white_socks = true
	elif coat_phase_roll < 0.85:
		# CALICO (white base with orange + black patches)
		primary = Color(0.92, 0.90, 0.85)
		pattern_color = Color(0.78, 0.45, 0.20)
		has_patches = true
	else:
		# GINGER / Solid orange
		primary = Color(0.82, 0.55, 0.22)
		pattern_color = Color(0.65, 0.40, 0.15)

	var fur_dark: Color = primary.darkened(0.20)
	var belly_color: Color = primary.lightened(0.10)
	var nose_color := Color(0.85, 0.45, 0.50)         # pink nose (most cats)
	if primary.r < 0.30:
		nose_color = Color(0.10, 0.08, 0.08)          # black cats often have black noses
	var pad_color := Color(0.70, 0.55, 0.50)          # pink paw pads
	var claw_color := Color(0.85, 0.80, 0.70)
	# Eye color — green, yellow, or blue
	var eye_roll: float = rng.randf()
	var eye_color: Color
	if eye_roll < 0.40:
		eye_color = Color(0.40, 0.85, 0.30)           # green
	elif eye_roll < 0.75:
		eye_color = Color(0.95, 0.80, 0.20)           # yellow/amber
	else:
		eye_color = Color(0.40, 0.70, 1.00)           # blue

	# ============================================================================
	# BODY — slim lithe trunk, lower than tall
	# ============================================================================
	# Back arch — most cats stand with a gently convex topline; some stretch
	# with a mid-back dip. Verify-agent fix: randomized via back_neutral.
	var body_y: float = clearance + h * 0.20
	var mid_dy: float = h * (0.02 if back_neutral else -0.01)
	var body_sections: Array = [
		{"center": Vector3(0, body_y - h * 0.02, -d * 0.40), "w": w * 0.30, "h": h * 0.30},  # rump
		{"center": Vector3(0, body_y, -d * 0.20), "w": w * 0.45, "h": h * 0.40},             # hip
		{"center": Vector3(0, body_y + mid_dy, 0.0), "w": w * 0.42, "h": h * 0.38},          # mid
		{"center": Vector3(0, body_y, d * 0.18), "w": w * 0.45, "h": h * 0.42},              # shoulders
		{"center": Vector3(0, body_y + h * 0.05, d * 0.32), "w": w * 0.30, "h": h * 0.34},   # neck base
	]
	_swept_body(root, body_sections, 10, primary, belly_color, 0.95, true)

	# WHITE SOCKS / CHEST BLAZE (tuxedo)
	if has_white_socks:
		# Chest blaze
		_build_box(
			root,
			Vector3(-w * 0.20, body_y - h * 0.10, d * 0.25),
			Vector3(w * 0.20, body_y + h * 0.04, d * 0.40),
			pattern_color, 0.95
		)
	# CALICO PATCHES — 4 irregular patches on body
	if has_patches:
		var patch_count: int = rng.randi_range(3, 5)
		for pi in range(patch_count):
			var p_ang: float = rng.randf_range(-PI * 0.4, PI * 0.4)
			var p_t: float = rng.randf_range(0.1, 0.8)
			var px: float = sin(p_ang) * w * 0.30
			var pz: float = lerpf(d * 0.30, -d * 0.30, p_t)
			var py: float = body_y + h * 0.10
			var psize: float = w * rng.randf_range(0.06, 0.13)
			# Alternate pattern_color (orange) and black patches
			var pcol: Color = pattern_color if pi % 2 == 0 else Color(0.10, 0.08, 0.08)
			_build_box(
				root,
				Vector3(px - psize, py - h * 0.005, pz - d * 0.04),
				Vector3(px + psize, py + h * 0.025, pz + d * 0.04),
				pcol, 0.95
			)
	# TABBY STRIPES — 6 dark bands across the back
	if has_stripes:
		for si in range(6):
			var st_t: float = float(si) / 5.0
			var sz: float = lerpf(d * 0.20, -d * 0.30, st_t)
			_build_box(
				root,
				Vector3(-w * 0.30, body_y + h * 0.14, sz - d * 0.012),
				Vector3(w * 0.30, body_y + h * 0.22, sz + d * 0.012),
				pattern_color, 0.95
			)

	# ============================================================================
	# HEAD — small triangular cat head
	# ============================================================================
	var neck_base := (body_sections[4]["center"] as Vector3)
	var head_anchor := Vector3(0, neck_base.y + h * 0.05, neck_base.z + d * 0.10)
	# Short neck
	_build_tapered_segment(root, neck_base, w * 0.18, head_anchor, w * 0.20,
		primary, 0.95)

	var head_w: float = w * 0.30
	var head_h: float = h * 0.30
	var head_d: float = d * 0.28
	var head_y_bot: float = head_anchor.y - head_h * 0.40
	var head_y_top: float = head_y_bot + head_h
	var head_center_y: float = (head_y_bot + head_y_top) * 0.5
	# Triangular skull — wider at back, narrower at snout
	_build_box(
		root,
		Vector3(-head_w, head_y_bot, head_anchor.z - head_d * 0.30),
		Vector3(head_w, head_y_top, head_anchor.z + head_d * 0.25),
		primary, 0.95
	)
	# Short muzzle (small triangle forward)
	_build_box(
		root,
		Vector3(-head_w * 0.55, head_y_bot + h * 0.02,
			head_anchor.z + head_d * 0.25),
		Vector3(head_w * 0.55, head_y_top - h * 0.08,
			head_anchor.z + head_d * 0.55),
		primary, 0.95
	)
	# Pink/black NOSE
	_build_box(
		root,
		Vector3(-head_w * 0.18, head_y_bot + h * 0.04,
			head_anchor.z + head_d * 0.52),
		Vector3(head_w * 0.18, head_y_top - h * 0.10,
			head_anchor.z + head_d * 0.58),
		nose_color, 0.55
	)
	# ALMOND EYES with slit pupils
	for side in [-1, 1]:
		# Outer eye (color)
		_build_box(
			root,
			Vector3(side * head_w * 0.50 - w * 0.060,
				head_center_y + h * 0.005, head_anchor.z + head_d * 0.18),
			Vector3(side * head_w * 0.50 + w * 0.060,
				head_center_y + h * 0.060, head_anchor.z + head_d * 0.28),
			eye_color, 0.15, 0.0
		)
		# Vertical slit pupil
		_build_box(
			root,
			Vector3(side * head_w * 0.50 - w * 0.008,
				head_center_y + h * 0.005, head_anchor.z + head_d * 0.27),
			Vector3(side * head_w * 0.50 + w * 0.008,
				head_center_y + h * 0.060, head_anchor.z + head_d * 0.29),
			Color(0.05, 0.04, 0.04), 0.40
		)

	# Mouth slit (small)
	_build_box(
		root,
		Vector3(-head_w * 0.16, head_y_bot - h * 0.005,
			head_anchor.z + head_d * 0.45),
		Vector3(head_w * 0.16, head_y_bot + h * 0.015,
			head_anchor.z + head_d * 0.55),
		Color(0.20, 0.10, 0.10), 0.85
	)
	# Muzzle whiskers — 6 per side (canon "dozens of movable whiskers";
	# 6 reads as cat, not rodent). Verify-agent fix: was 3/side.
	for side in [-1, 1]:
		for wi in range(6):
			var w_off_y: float = h * (float(wi) - 2.5) * 0.012
			_build_tapered_segment(root,
				Vector3(side * head_w * 0.30, head_y_bot + h * 0.04 + w_off_y,
					head_anchor.z + head_d * 0.50),
				w * 0.005,
				Vector3(side * head_w * 0.95, head_y_bot + h * 0.05 + w_off_y * 0.7,
					head_anchor.z + head_d * 0.62),
				w * 0.001,
				Color(0.92, 0.90, 0.85), 0.95)
		# BROW whiskers (superciliary vibrissae) — 2 above each eye
		for bi in range(2):
			var b_off_x: float = w * (float(bi) - 0.5) * 0.020
			_build_tapered_segment(root,
				Vector3(side * head_w * 0.45 + b_off_x,
					head_center_y + h * 0.075, head_anchor.z + head_d * 0.18),
				w * 0.004,
				Vector3(side * head_w * 0.95 + b_off_x,
					head_center_y + h * 0.085, head_anchor.z + head_d * 0.25),
				w * 0.001,
				Color(0.92, 0.90, 0.85), 0.95)

	# POINTED UPRIGHT EARS — triangular, atop the head
	for side in [-1, 1]:
		var ear_base := Vector3(side * head_w * 0.60,
			head_y_top - h * 0.005,
			head_anchor.z - head_d * 0.05)
		var ear_tip := Vector3(side * head_w * 0.70,
			head_y_top + h * 0.22,
			head_anchor.z - head_d * 0.02)
		_build_tapered_segment(root, ear_base, w * 0.060, ear_tip, w * 0.005,
			primary, 0.95)
		# Inner ear (pinker — darker fur tone)
		_build_tapered_segment(root,
			ear_base + Vector3(0, h * 0.010, d * 0.008), w * 0.040,
			ear_tip + Vector3(0, -h * 0.020, 0), w * 0.004,
			nose_color.lerp(primary, 0.4), 0.95)
		# Optional lynx tufts at tip
		if ear_tuft_jitter:
			_build_tapered_segment(root,
				ear_tip, w * 0.008,
				ear_tip + Vector3(0, h * 0.05, -d * 0.01), w * 0.002,
				fur_dark, 0.95)

	# ============================================================================
	# LEGS — 4 slim cat legs ending in soft round paws
	# ============================================================================
	for side in [-1, 1]:
		# Front legs
		var fhip := Vector3(side * w * 0.22, body_y - h * 0.02, d * 0.16)
		var fknee := Vector3(side * w * 0.22, clearance * 0.55, d * 0.18)
		var fpaw := Vector3(side * w * 0.20, 0.03, d * 0.20)
		_build_tapered_segment(root, fhip, w * 0.08, fknee, w * 0.065, primary, 0.95)
		_build_tapered_segment(root, fknee, w * 0.065, fpaw, w * 0.060, primary, 0.95)
		# WHITE SOCK paw (tuxedo)
		var fpaw_col: Color = pattern_color if has_white_socks else primary
		_build_box(
			root,
			Vector3(side * w * 0.20 - w * 0.075, 0.0, d * 0.16),
			Vector3(side * w * 0.20 + w * 0.075, h * 0.04, d * 0.30),
			fpaw_col, 0.95
		)
		# Tiny pink paw pad (visible from below — pad ovals on the underside)
		_build_box(
			root,
			Vector3(side * w * 0.20 - w * 0.040, -h * 0.005, d * 0.20),
			Vector3(side * w * 0.20 + w * 0.040, h * 0.010, d * 0.26),
			pad_color, 0.85
		)
		# Back legs (digitigrade hock)
		var rhip := Vector3(side * w * 0.22, body_y, -d * 0.16)
		var rknee := Vector3(side * w * 0.24, clearance * 0.65, -d * 0.10)
		var rhock := Vector3(side * w * 0.22, clearance * 0.25, -d * 0.20)
		var rpaw := Vector3(side * w * 0.20, 0.03, -d * 0.12)
		_build_tapered_segment(root, rhip, w * 0.10, rknee, w * 0.07, primary, 0.95)
		_build_tapered_segment(root, rknee, w * 0.07, rhock, w * 0.060, primary, 0.95)
		_build_tapered_segment(root, rhock, w * 0.060, rpaw, w * 0.060, primary, 0.95)
		var rpaw_col: Color = pattern_color if has_white_socks else primary
		_build_box(
			root,
			Vector3(side * w * 0.20 - w * 0.075, 0.0, -d * 0.18),
			Vector3(side * w * 0.20 + w * 0.075, h * 0.04, -d * 0.04),
			rpaw_col, 0.95
		)
		# Pink rear paw pad
		_build_box(
			root,
			Vector3(side * w * 0.20 - w * 0.040, -h * 0.005, -d * 0.14),
			Vector3(side * w * 0.20 + w * 0.040, h * 0.010, -d * 0.08),
			pad_color, 0.85
		)

	# ============================================================================
	# LONG TAIL — straight back to hooked-up depending on tail_curl_jitter
	# ============================================================================
	var tail_base := Vector3(0, body_y + h * 0.03, -d * 0.40)
	# Lerp curl: 0 = straight back+slight droop, 1 = hooked up over the body
	var tail_mid_y: float = lerpf(body_y - h * 0.05, body_y + h * 0.30, tail_curl_jitter)
	var tail_tip_y: float = lerpf(body_y - h * 0.12, body_y + h * 0.50, tail_curl_jitter)
	var tail_mid_z: float = lerpf(-d * 0.65, -d * 0.30, tail_curl_jitter)
	var tail_tip_z: float = lerpf(-d * 0.85, -d * 0.05, tail_curl_jitter)
	var tail_mid := Vector3(0, tail_mid_y, tail_mid_z)
	var tail_tip := Vector3(rng.randf_range(-w * 0.04, w * 0.04),
		tail_tip_y, tail_tip_z)
	_build_tapered_segment(root, tail_base, w * 0.07, tail_mid, w * 0.055,
		primary, 0.95)
	_build_tapered_segment(root, tail_mid, w * 0.055, tail_tip, w * 0.040,
		primary, 0.95)
	# White tail tip (if tuxedo or random ~20% chance)
	if has_white_socks or rng.randf() < 0.20:
		_build_box(
			root,
			Vector3(tail_tip.x - w * 0.035, tail_tip.y - h * 0.025, tail_tip.z - d * 0.025),
			Vector3(tail_tip.x + w * 0.035, tail_tip.y + h * 0.025, tail_tip.z + d * 0.025),
			Color(0.92, 0.90, 0.85), 0.95
		)


# ============================================================================
# CENTAUR (centaur) — Half-human half-horse warrior-scout
#   - Humanoid upper body atop equine quadruped lower body
#   - Fused at the waist (human torso ↔ horse withers)
#   - HUMAN HEAD + ARMS with longbow (canon ranger weapon)
#   - 4 horse legs + flowing horse tail
#   - Horse coat colors (bay/chestnut/black/grey/dapple)
#   - Long humanoid hair often braided
#   - Tribal warpaint or simple leather garb
# ============================================================================

static func _build_centaur(plan: Dictionary, root: Node3D) -> void:
	var base: Dictionary = plan.get("base", {})
	var palette: Dictionary = plan.get("palette", {})
	var limbs: Dictionary = plan.get("limbs", {})
	var meta: Dictionary = plan.get("meta", {})
	var species: String = String(meta.get("species", "Centaur"))

	# Centaur — needs both horse-body extent (long depth) AND humanoid height.
	var w: float = _axis(base, "width", 0.75)
	var h: float = _axis(base, "height", 2.65)        # total fused height
	var d: float = _axis(base, "depth", 2.20)         # equine body length
	var leg_length: float = float(limbs.get("leg_length", 0.85))
	var clearance: float = leg_length

	var render_seed: int = int(meta.get("render_seed", 0))
	var rng := RandomNumberGenerator.new()
	rng.seed = render_seed if render_seed != 0 else hash(species)

	# Per-individual variation
	var size_jitter: float = rng.randf_range(0.92, 1.12)
	var has_warpaint: bool = rng.randf() < 0.55
	var is_archer: bool = rng.randf() < 0.65
	w *= size_jitter
	h *= size_jitter
	d *= size_jitter
	leg_length *= rng.randf_range(0.95, 1.10)
	clearance = leg_length

	# Horse coat palette
	var coat_options := [
		Color(0.42, 0.25, 0.15),     # bay
		Color(0.65, 0.40, 0.18),     # chestnut
		Color(0.08, 0.07, 0.06),     # black
		Color(0.58, 0.55, 0.50),     # grey
		Color(0.78, 0.70, 0.55),     # palomino
		Color(0.32, 0.22, 0.16),     # dark bay
	]
	var horse_color: Color = coat_options[rng.randi() % coat_options.size()]
	var horse_dark: Color = horse_color.darkened(0.25)
	var horse_belly: Color = horse_color.lightened(0.15)
	# Human skin
	var skin_options := [
		Color(0.92, 0.74, 0.58),     # light
		Color(0.78, 0.58, 0.44),     # ruddy
		Color(0.62, 0.46, 0.34),     # olive
		Color(0.48, 0.34, 0.24),     # bronze
		Color(0.32, 0.22, 0.18),     # dark
	]
	var skin: Color = skin_options[rng.randi() % skin_options.size()]
	var skin_dark: Color = skin.darkened(0.20)
	# Hair (humanoid)
	var hair_options := [
		Color(0.45, 0.20, 0.10),     # chestnut
		Color(0.18, 0.10, 0.06),     # black
		Color(0.85, 0.70, 0.35),     # blonde
		Color(0.65, 0.30, 0.10),     # red
		Color(0.55, 0.55, 0.50),     # grey (older)
	]
	var hair: Color = hair_options[rng.randi() % hair_options.size()]
	var leather := Color(0.30, 0.18, 0.10)
	var leather_dark := Color(0.20, 0.12, 0.07)
	var wood := Color(0.42, 0.28, 0.16)
	var iron := Color(0.40, 0.42, 0.42)
	var paint_options := [
		Color(0.10, 0.20, 0.55),     # woad blue
		Color(0.62, 0.12, 0.08),     # blood red
		Color(0.85, 0.65, 0.10),     # ochre
	]
	var paint: Color = paint_options[rng.randi() % paint_options.size()]
	var eye_color := Color(0.12, 0.10, 0.06)

	# ============================================================================
	# HORSE BODY — equine quadruped trunk (the lower half)
	# ============================================================================
	var horse_body_y: float = clearance + h * 0.20
	var horse_sections: Array = [
		{"center": Vector3(0, horse_body_y - h * 0.02, -d * 0.42), "w": w * 0.35, "h": h * 0.18},  # rump
		{"center": Vector3(0, horse_body_y, -d * 0.22), "w": w * 0.48, "h": h * 0.22},             # hip
		{"center": Vector3(0, horse_body_y, -d * 0.05), "w": w * 0.50, "h": h * 0.22},             # mid
		{"center": Vector3(0, horse_body_y, d * 0.12), "w": w * 0.50, "h": h * 0.22},              # shoulders
		{"center": Vector3(0, horse_body_y + h * 0.03, d * 0.28), "w": w * 0.46, "h": h * 0.22},   # withers (where torso meets horse)
	]
	_swept_body(root, horse_sections, 10, horse_color, horse_belly, 0.95, true)

	# ============================================================================
	# HORSE LEGS — 4 powerful equine legs ending in HOOVES
	# ============================================================================
	for side in [-1, 1]:
		# Front legs
		var fhip := Vector3(side * w * 0.28, horse_body_y - h * 0.04, d * 0.18)
		var fknee := Vector3(side * w * 0.28, clearance * 0.55, d * 0.18)
		var fhoof := Vector3(side * w * 0.26, 0.04, d * 0.20)
		_build_tapered_segment(root, fhip, w * 0.13, fknee, w * 0.10, horse_color, 0.95)
		_build_tapered_segment(root, fknee, w * 0.10, fhoof, w * 0.08, horse_dark, 0.95)
		# Hoof (single solid black hoof)
		_build_box(
			root,
			Vector3(side * w * 0.26 - w * 0.060, 0.0, d * 0.14),
			Vector3(side * w * 0.26 + w * 0.060, h * 0.05, d * 0.26),
			Color(0.08, 0.06, 0.04), 0.50
		)

		# Back legs (slightly bent canon horse stance)
		var rhip := Vector3(side * w * 0.30, horse_body_y - h * 0.02, -d * 0.18)
		var rknee := Vector3(side * w * 0.30, clearance * 0.60, -d * 0.14)
		var rhock := Vector3(side * w * 0.28, clearance * 0.30, -d * 0.22)
		var rhoof := Vector3(side * w * 0.26, 0.04, -d * 0.18)
		_build_tapered_segment(root, rhip, w * 0.15, rknee, w * 0.11, horse_color, 0.95)
		_build_tapered_segment(root, rknee, w * 0.11, rhock, w * 0.085, horse_color, 0.95)
		_build_tapered_segment(root, rhock, w * 0.085, rhoof, w * 0.08, horse_dark, 0.95)
		# Hoof
		_build_box(
			root,
			Vector3(side * w * 0.26 - w * 0.060, 0.0, -d * 0.24),
			Vector3(side * w * 0.26 + w * 0.060, h * 0.05, -d * 0.12),
			Color(0.08, 0.06, 0.04), 0.50
		)

	# ============================================================================
	# HORSE TAIL — long flowing horse tail at the rump
	# ============================================================================
	var htail_base := Vector3(0, horse_body_y + h * 0.02, -d * 0.42)
	var htail_mid := Vector3(rng.randf_range(-w * 0.06, w * 0.06),
		horse_body_y - h * 0.10, -d * 0.55)
	var htail_tip := Vector3(rng.randf_range(-w * 0.12, w * 0.12),
		horse_body_y - h * 0.25, -d * 0.65)
	# Bushy tail — multiple parallel strands for the flowing effect
	for ts in range(7):
		var off_x: float = (float(ts) - 3.0) * w * 0.020
		var t_base := htail_base + Vector3(off_x, 0, 0)
		var t_tip := htail_tip + Vector3(off_x * 1.3, rng.randf_range(-h * 0.03, h * 0.03), 0)
		_build_tapered_segment(root, t_base, w * 0.025, htail_mid + Vector3(off_x, 0, 0),
			w * 0.020, hair, 0.95)
		_build_tapered_segment(root, htail_mid + Vector3(off_x, 0, 0), w * 0.020,
			t_tip, w * 0.008, hair, 0.95)

	# ============================================================================
	# HUMANOID TORSO — emerges DIRECTLY from the horse withers (Class A fusion).
	# Verify-agent fix: previous hip-blend stack read as human-standing-on-horse;
	# now the human waist replaces the horse neck (no separate hip blend),
	# and the torso is extended ~0.15h taller so the human portion reaches
	# canon ~7ft head height.
	# ============================================================================
	var withers_y: float = horse_body_y + h * 0.18
	# Waist sits directly atop the withers (no hip blend segment)
	var human_waist_y: float = withers_y + h * 0.04
	var human_chest_y: float = withers_y + h * 0.22
	var human_shoulder_y: float = withers_y + h * 0.40   # raised from 0.32 (+0.08)
	# Waist (replaces the horse's neck position)
	_build_box(
		root,
		Vector3(-w * 0.26, withers_y - h * 0.01, d * 0.22),
		Vector3(w * 0.26, human_waist_y, d * 0.34),
		skin, 0.65
	)
	# Mid (abs)
	_build_box(
		root,
		Vector3(-w * 0.30, human_waist_y, d * 0.20),
		Vector3(w * 0.30, human_chest_y, d * 0.36),
		skin, 0.65
	)
	# Chest (broad)
	_build_box(
		root,
		Vector3(-w * 0.42, human_chest_y, d * 0.18),
		Vector3(w * 0.42, human_shoulder_y, d * 0.40),
		skin, 0.65
	)
	# Sternum line
	_build_box(
		root,
		Vector3(-w * 0.012, human_chest_y, d * 0.40),
		Vector3(w * 0.012, human_shoulder_y, d * 0.42),
		skin_dark, 0.70
	)
	# Ab grooves
	for ai in range(2):
		var ay: float = lerpf(human_waist_y + h * 0.01, human_chest_y - h * 0.01,
			float(ai) / 1.0)
		_build_box(
			root,
			Vector3(-w * 0.25, ay - h * 0.004, d * 0.34),
			Vector3(w * 0.25, ay + h * 0.004, d * 0.37),
			skin_dark, 0.70
		)
	# WAIST FUSION FILL — sloped skin transition from horse withers up to
	# the floating human waist (visible filler so the junction reads fused).
	_build_box(
		root,
		Vector3(-w * 0.32, horse_body_y + h * 0.14, d * 0.18),
		Vector3(w * 0.32, withers_y - h * 0.01, d * 0.34),
		skin, 0.65
	)

	# Simple leather sash across chest
	_build_box(
		root,
		Vector3(-w * 0.40, human_chest_y - h * 0.005, d * 0.36),
		Vector3(w * 0.40, human_chest_y + h * 0.035, d * 0.42),
		leather, 0.85
	)

	# WARPAINT — 3 horizontal stripes across the human torso (optional)
	if has_warpaint:
		for pi in range(3):
			var py: float = lerpf(human_waist_y + h * 0.03, human_shoulder_y - h * 0.03,
				float(pi) / 2.0)
			_build_box(
				root,
				Vector3(-w * 0.18, py - h * 0.005, d * 0.40),
				Vector3(w * 0.18, py + h * 0.005, d * 0.42),
				paint, 0.65
			)

	# ============================================================================
	# HUMAN HEAD with long flowing braided hair
	# ============================================================================
	# Neck
	var neck_top := Vector3(0, human_shoulder_y + h * 0.05, d * 0.32)
	_build_tapered_segment(root,
		Vector3(0, human_shoulder_y - h * 0.01, d * 0.30), w * 0.10,
		neck_top, w * 0.09, skin, 0.65)

	var head_w: float = w * 0.24
	var head_h: float = h * 0.13
	var head_d: float = d * 0.20
	var head_y_bot: float = neck_top.y
	var head_y_top: float = head_y_bot + head_h
	var head_center_y: float = (head_y_bot + head_y_top) * 0.5
	# Skull
	_build_box(
		root,
		Vector3(-head_w, head_y_bot, neck_top.z - head_d * 0.40),
		Vector3(head_w, head_y_top, neck_top.z + head_d * 0.45),
		skin, 0.65
	)
	# Eyes
	for side in [-1, 1]:
		_build_box(
			root,
			Vector3(side * head_w * 0.50 - w * 0.030,
				head_center_y, neck_top.z + head_d * 0.42),
			Vector3(side * head_w * 0.50 + w * 0.030,
				head_center_y + h * 0.020, neck_top.z + head_d * 0.46),
			Color(0.95, 0.92, 0.85), 0.40
		)
		_build_box(
			root,
			Vector3(side * head_w * 0.50 - w * 0.012,
				head_center_y + h * 0.003, neck_top.z + head_d * 0.44),
			Vector3(side * head_w * 0.50 + w * 0.012,
				head_center_y + h * 0.018, neck_top.z + head_d * 0.46),
			eye_color, 0.30
		)
	# Nose
	_build_box(
		root,
		Vector3(-w * 0.025, head_center_y - h * 0.020,
			neck_top.z + head_d * 0.40),
		Vector3(w * 0.025, head_center_y + h * 0.005,
			neck_top.z + head_d * 0.50),
		skin, 0.65
	)
	# Mouth slit
	_build_box(
		root,
		Vector3(-head_w * 0.20, head_y_bot + h * 0.020,
			neck_top.z + head_d * 0.43),
		Vector3(head_w * 0.20, head_y_bot + h * 0.030,
			neck_top.z + head_d * 0.46),
		Color(0.55, 0.25, 0.18), 0.85
	)

	# FACE WARPAINT — diagonal stripe under each eye (if has_warpaint)
	if has_warpaint:
		for side in [-1, 1]:
			_build_box(
				root,
				Vector3(side * head_w * 0.55 - w * 0.045,
					head_center_y - h * 0.020, neck_top.z + head_d * 0.42),
				Vector3(side * head_w * 0.55 + w * 0.045,
					head_center_y - h * 0.005, neck_top.z + head_d * 0.46),
				paint, 0.65
			)

	# LONG FLOWING HAIR + BRAID
	var hair_count: int = 8
	for hi in range(hair_count):
		var ang: float = (float(hi) / float(hair_count)) * TAU
		if cos(ang) > 0.8 and abs(sin(ang)) < 0.3:
			continue
		var hx_root: float = cos(ang) * head_w * 0.80
		var hz_root: float = sin(ang) * head_d * 0.30 - head_d * 0.05
		var root_pos := Vector3(hx_root, head_y_top - h * 0.005,
			neck_top.z + hz_root)
		var hair_len: float = h * rng.randf_range(0.18, 0.30)
		var hair_tip := Vector3(hx_root * 1.20,
			head_y_top - hair_len * 0.7,
			neck_top.z + hz_root - head_d * 0.20)
		_build_tapered_segment(root, root_pos, w * 0.025, hair_tip, w * 0.005,
			hair, 0.85)

	# Slightly POINTED EQUINE EARS on the human head — many D&D centaur
	# depictions give the human-head pointed/horse-like ears.
	for side in [-1, 1]:
		var ear_base := Vector3(side * head_w * 0.80,
			head_y_top - h * 0.005,
			neck_top.z + head_d * 0.05)
		var ear_tip := Vector3(side * head_w * 0.95,
			head_y_top + h * 0.08,
			neck_top.z - head_d * 0.02)
		_build_tapered_segment(root, ear_base, w * 0.035, ear_tip, w * 0.005,
			skin, 0.65)
		_build_tapered_segment(root,
			ear_base + Vector3(0, h * 0.005, d * 0.005), w * 0.022,
			ear_tip + Vector3(0, -h * 0.015, 0), w * 0.004,
			skin_dark, 0.65)

	# ============================================================================
	# ARMS — humanoid arms; right arm holds bow (or weapon), left arm draws
	# ============================================================================
	# Right arm — extended forward gripping bow
	var r_shoulder := Vector3(w * 0.42, human_shoulder_y - h * 0.02, d * 0.35)
	var r_elbow := Vector3(w * 0.52, human_shoulder_y - h * 0.12, d * 0.50)
	var r_wrist := Vector3(w * 0.55, human_shoulder_y - h * 0.18, d * 0.65)
	_build_tapered_segment(root, r_shoulder, w * 0.12, r_elbow, w * 0.10, skin, 0.65)
	_build_tapered_segment(root, r_elbow, w * 0.10, r_wrist, w * 0.085, skin, 0.65)
	# Right hand
	_build_box(
		root,
		Vector3(r_wrist.x - w * 0.06, r_wrist.y - h * 0.04, r_wrist.z - d * 0.04),
		Vector3(r_wrist.x + w * 0.06, r_wrist.y + h * 0.01, r_wrist.z + d * 0.05),
		skin, 0.65
	)

	# Left arm — drawing bowstring at chin
	var l_shoulder := Vector3(-w * 0.42, human_shoulder_y - h * 0.02, d * 0.35)
	var l_elbow := Vector3(-w * 0.40, human_shoulder_y - h * 0.05, d * 0.20)
	var l_wrist := Vector3(-w * 0.18, human_shoulder_y + h * 0.02, d * 0.45)
	_build_tapered_segment(root, l_shoulder, w * 0.12, l_elbow, w * 0.10, skin, 0.65)
	_build_tapered_segment(root, l_elbow, w * 0.10, l_wrist, w * 0.085, skin, 0.65)
	_build_box(
		root,
		Vector3(l_wrist.x - w * 0.06, l_wrist.y - h * 0.04, l_wrist.z - d * 0.04),
		Vector3(l_wrist.x + w * 0.06, l_wrist.y + h * 0.01, l_wrist.z + d * 0.05),
		skin, 0.65
	)

	# ============================================================================
	# LONGBOW — held vertically in right hand (canon centaur archer weapon)
	# ============================================================================
	if is_archer:
		var bow_grip := r_wrist
		# Upper/lower bow limbs — scaled UP ~30% per verify-agent (canon
		# centaur longbow should reach chin-draw to below knee).
		var bow_top := Vector3(bow_grip.x, bow_grip.y + h * 0.60,
			bow_grip.z - d * 0.05)
		var bow_bot := Vector3(bow_grip.x, bow_grip.y - h * 0.60,
			bow_grip.z - d * 0.05)
		# Bow staves
		_build_tapered_segment(root, bow_grip, w * 0.022, bow_top, w * 0.012,
			wood, 0.85)
		_build_tapered_segment(root, bow_grip, w * 0.022, bow_bot, w * 0.012,
			wood, 0.85)
		# Bowstring (thin straight line from top to bottom passing through left hand)
		_build_tapered_segment(root, bow_top, w * 0.004,
			Vector3(l_wrist.x + w * 0.05, l_wrist.y, l_wrist.z + d * 0.02), w * 0.004,
			Color(0.85, 0.78, 0.65), 0.85)
		_build_tapered_segment(root,
			Vector3(l_wrist.x + w * 0.05, l_wrist.y, l_wrist.z + d * 0.02), w * 0.004,
			bow_bot, w * 0.004,
			Color(0.85, 0.78, 0.65), 0.85)
		# Quiver on the back — strap + cylinder of arrows
		_build_box(
			root,
			Vector3(-w * 0.15, withers_y + h * 0.15, -d * 0.05),
			Vector3(w * 0.15, withers_y + h * 0.45, d * 0.05),
			leather, 0.85
		)
		# Arrow feathers visible at top of quiver
		for ai in range(5):
			var ax: float = (float(ai) - 2.0) * w * 0.025
			_build_box(
				root,
				Vector3(ax - w * 0.010, withers_y + h * 0.42, -d * 0.020),
				Vector3(ax + w * 0.010, withers_y + h * 0.52, d * 0.020),
				wood, 0.85
			)
			_build_box(
				root,
				Vector3(ax - w * 0.020, withers_y + h * 0.46, -d * 0.025),
				Vector3(ax + w * 0.020, withers_y + h * 0.55, d * 0.025),
				Color(0.85, 0.75, 0.60), 0.95
			)
	else:
		# Spear alternative — long shaft in right hand
		var spear_bot := r_wrist + Vector3(0, -h * 0.40, 0)
		var spear_top := r_wrist + Vector3(0, h * 0.85, d * 0.05)
		_build_tapered_segment(root, spear_bot, w * 0.025, spear_top, w * 0.022,
			wood, 0.85)
		# Iron spear tip
		_build_tapered_segment(root, spear_top, w * 0.022,
			spear_top + Vector3(0, h * 0.18, d * 0.02), w * 0.004,
			iron, 0.35, 0.70)


# ============================================================================
# CHAIN DEVIL (chain_devil / Kyton) — Sadistic torturer-devil (D&D MM)
#   - Gaunt humanoid devil wrapped/entangled in BARBED ANIMATED CHAINS
#   - Scarred PALE skin (canon — chains have carved them over ages)
#   - 4 ANIMATED CHAINS lashing outward in different directions (signature)
#   - Each chain ends in a HOOK / BARB / SPIKE
#   - Masked-looking face (often featureless or scarred over)
#   - Torn ragged loincloth
# ============================================================================

static func _build_chain_devil(plan: Dictionary, root: Node3D) -> void:
	var base: Dictionary = plan.get("base", {})
	var palette: Dictionary = plan.get("palette", {})
	var limbs: Dictionary = plan.get("limbs", {})
	var meta: Dictionary = plan.get("meta", {})
	var species: String = String(meta.get("species", "Chain Devil"))

	# Tall gaunt humanoid
	var w: float = _axis(base, "width", 0.60)
	var h: float = _axis(base, "height", 2.25)
	var d: float = _axis(base, "depth", 0.45)
	var leg_length: float = float(limbs.get("leg_length", 1.10))
	var clearance: float = leg_length

	var render_seed: int = int(meta.get("render_seed", 0))
	var rng := RandomNumberGenerator.new()
	rng.seed = render_seed if render_seed != 0 else hash(species)

	# Per-individual variation
	var size_jitter: float = rng.randf_range(0.92, 1.12)
	var wrap_chain_count: int = rng.randi_range(5, 8)
	var scar_count: int = rng.randi_range(4, 8)
	w *= size_jitter
	h *= size_jitter
	d *= size_jitter
	leg_length *= rng.randf_range(0.95, 1.10)
	clearance = leg_length

	# Pale scarred skin palette
	var skin_options := [
		Color(0.75, 0.68, 0.62),     # pale grey-pink
		Color(0.65, 0.55, 0.48),     # ashen
		Color(0.82, 0.72, 0.65),     # corpse-pale
		Color(0.55, 0.48, 0.45),     # weathered grey
	]
	var primary: Color = skin_options[rng.randi() % skin_options.size()]
	var skin_dark: Color = primary.darkened(0.30)
	var scar_color: Color = primary.darkened(0.25).lerp(Color(0.40, 0.15, 0.10), 0.4)
	var iron := Color(0.30, 0.30, 0.32)
	var iron_dark := Color(0.15, 0.15, 0.18)
	var iron_rust := Color(0.42, 0.22, 0.12)
	var leather := Color(0.18, 0.12, 0.08)
	# Verify-agent fix: canon kyton eyes are MILKY DEAD-WHITE (not red glow,
	# which read as imp/cambion).
	var eye_glow := Color(0.85, 0.85, 0.78)
	var mouth_dark := Color(0.10, 0.05, 0.05)

	# Helper: build a single chain link as a small ring-shaped box pair.
	# (Simplified — too detailed at low-poly scale to render true torus links.)

	# ============================================================================
	# TORSO — gaunt skeletal (similar build to bone devil but with chains)
	# ============================================================================
	var hip_y: float = clearance
	var waist_y: float = clearance + h * 0.10
	var chest_y: float = clearance + h * 0.28
	var shoulder_y: float = clearance + h * 0.44
	# Waist
	_build_box(
		root,
		Vector3(-w * 0.22, hip_y, -d * 0.18),
		Vector3(w * 0.22, waist_y, d * 0.20),
		primary, 0.65
	)
	# Mid (showing ribs)
	_build_box(
		root,
		Vector3(-w * 0.28, waist_y, -d * 0.22),
		Vector3(w * 0.28, chest_y, d * 0.24),
		primary, 0.65
	)
	# Chest
	_build_box(
		root,
		Vector3(-w * 0.40, chest_y, -d * 0.28),
		Vector3(w * 0.40, shoulder_y, d * 0.30),
		primary, 0.65
	)
	# Visible rib lines — 4 darker grooves
	for ri in range(4):
		var ry: float = lerpf(chest_y + h * 0.01, shoulder_y - h * 0.01, float(ri) / 3.0)
		_build_box(
			root,
			Vector3(-w * 0.38, ry - h * 0.005, d * 0.27),
			Vector3(w * 0.38, ry + h * 0.005, d * 0.31),
			skin_dark, 0.70
		)

	# SCARS — random horizontal/diagonal scar lines across torso and arms
	for si in range(scar_count):
		var sy: float = rng.randf_range(waist_y, shoulder_y)
		var sx_center: float = rng.randf_range(-w * 0.30, w * 0.30)
		var s_half_w: float = w * rng.randf_range(0.06, 0.16)
		_build_box(
			root,
			Vector3(sx_center - s_half_w, sy - h * 0.005, d * 0.28),
			Vector3(sx_center + s_half_w, sy + h * 0.005, d * 0.32),
			scar_color, 0.70
		)

	# Loincloth (ragged) — 3 strips around the hips
	for kang in [-0.6, 0.0, 0.6]:
		var kx: float = sin(kang) * w * 0.24
		var kz: float = cos(kang) * d * 0.22
		_build_box(
			root,
			Vector3(kx - w * 0.08, hip_y - h * 0.10, kz - d * 0.04),
			Vector3(kx + w * 0.08, waist_y - h * 0.005, kz + d * 0.04),
			leather, 0.85
		)

	# ============================================================================
	# HEAD — gaunt, scarred, featureless mask-like face
	# ============================================================================
	var neck_top := Vector3(0, shoulder_y + h * 0.06, d * 0.03)
	_build_tapered_segment(root,
		Vector3(0, shoulder_y - h * 0.01, 0.0), w * 0.10,
		neck_top, w * 0.08,
		primary, 0.65)

	var head_w: float = w * 0.26
	var head_h: float = h * 0.16
	var head_d: float = d * 0.55
	var head_y_bot: float = neck_top.y
	var head_y_top: float = head_y_bot + head_h
	var head_center_y: float = (head_y_bot + head_y_top) * 0.5
	_build_box(
		root,
		Vector3(-head_w, head_y_bot, neck_top.z - head_d * 0.40),
		Vector3(head_w, head_y_top, neck_top.z + head_d * 0.45),
		primary, 0.65
	)
	# Scarred face — 2 vertical scar marks
	for fsi in range(2):
		var fx: float = (float(fsi) - 0.5) * head_w * 0.55
		_build_box(
			root,
			Vector3(fx - w * 0.012, head_center_y - h * 0.04,
				neck_top.z + head_d * 0.43),
			Vector3(fx + w * 0.012, head_center_y + h * 0.04,
				neck_top.z + head_d * 0.46),
			scar_color, 0.70
		)
	# DEAD-WHITE MILKY EYES (sunken, pupil-less — verify-agent fix)
	for side in [-1, 1]:
		_build_box(
			root,
			Vector3(side * head_w * 0.50 - w * 0.035,
				head_center_y - h * 0.005, neck_top.z + head_d * 0.38),
			Vector3(side * head_w * 0.50 + w * 0.035,
				head_center_y + h * 0.025, neck_top.z + head_d * 0.46),
			eye_glow, 0.45
		)

	# FACE-WRAPPING CHAIN BAND across lower face (verify-agent fix:
	# canon kytons have a face bound in chains / featureless lower face;
	# stitched slit read as Pyramid Head / Slaaneshi daemon).
	for ci_face in range(4):
		var fcx: float = lerpf(-head_w * 0.55, head_w * 0.55, float(ci_face) / 3.0)
		_build_box(
			root,
			Vector3(fcx - w * 0.022, head_y_bot + h * 0.012,
				neck_top.z + head_d * 0.42),
			Vector3(fcx + w * 0.022, head_y_bot + h * 0.040,
				neck_top.z + head_d * 0.47),
			iron if ci_face % 2 == 0 else iron_rust, 0.40, 0.85
		)

	# ============================================================================
	# ARMS — gaunt long arms
	# ============================================================================
	for side in [-1, 1]:
		var shoulder := Vector3(side * w * 0.40, shoulder_y - h * 0.02, 0.0)
		var elbow := Vector3(side * w * 0.52, shoulder_y - h * 0.22, d * 0.05)
		var wrist := Vector3(side * w * 0.46, shoulder_y - h * 0.40, d * 0.18)
		_build_tapered_segment(root, shoulder, w * 0.10, elbow, w * 0.08, primary, 0.65)
		_build_tapered_segment(root, elbow, w * 0.08, wrist, w * 0.07, primary, 0.65)
		# Hand
		_build_box(
			root,
			Vector3(wrist.x - w * 0.06, wrist.y - h * 0.04, wrist.z - d * 0.04),
			Vector3(wrist.x + w * 0.06, wrist.y + h * 0.01, wrist.z + d * 0.06),
			primary, 0.65
		)
		# Scars on arms
		for asi in range(2):
			var asy: float = lerpf(shoulder_y - h * 0.05, wrist.y, (float(asi) + 1.0) / 3.0)
			var asx: float = lerp(shoulder.x, wrist.x, (float(asi) + 1.0) / 3.0)
			_build_box(
				root,
				Vector3(asx - w * 0.10, asy - h * 0.005, d * 0.04),
				Vector3(asx + w * 0.10, asy + h * 0.005, d * 0.10),
				scar_color, 0.70
			)

	# ============================================================================
	# LEGS — gaunt long legs
	# ============================================================================
	for side in [-1, 1]:
		var hip := Vector3(side * w * 0.16, hip_y + h * 0.02, 0.0)
		var knee := Vector3(side * w * 0.18, clearance * 0.50, d * 0.04)
		var ankle := Vector3(side * w * 0.16, clearance * 0.12, -d * 0.02)
		_build_tapered_segment(root, hip, w * 0.12, knee, w * 0.09, primary, 0.65)
		_build_tapered_segment(root, knee, w * 0.09, ankle, w * 0.075, primary, 0.65)
		# Foot pad
		_build_box(
			root,
			Vector3(side * w * 0.16 - w * 0.085, 0.0, -d * 0.06),
			Vector3(side * w * 0.16 + w * 0.085, h * 0.05, d * 0.16),
			skin_dark, 0.70
		)

	# ============================================================================
	# WRAPPING BODY CHAINS — barbed chains coiling around torso/limbs (signature)
	# Built as a series of small iron link boxes spiraling around the body.
	# ============================================================================
	# Helper data: each "wrap" is a chain segment of N links spiraling around
	# a specific body part. We'll do torso wraps + arm wraps.
	# Torso wrap chains (5-8 of them, at different z offsets, varied radii
	# for restraint-not-barrel-hoop feel — verify-agent fix).
	for ci in range(wrap_chain_count):
		var wrap_y_base: float = lerpf(hip_y, shoulder_y - h * 0.02,
			float(ci) / float(wrap_chain_count - 1))
		# Radius jittered ±0.08 per coil
		var wrap_radius_x: float = w * lerpf(0.34, 0.50, rng.randf())
		var wrap_radius_z: float = d * lerpf(0.22, 0.38, rng.randf())
		var link_count: int = 8
		for li in range(link_count):
			var lang: float = (float(li) / float(link_count)) * TAU + ci * 0.35
			var lx: float = cos(lang) * wrap_radius_x
			var lz: float = sin(lang) * wrap_radius_z
			_build_box(
				root,
				Vector3(lx - w * 0.025, wrap_y_base - h * 0.012, lz - d * 0.025),
				Vector3(lx + w * 0.025, wrap_y_base + h * 0.012, lz + d * 0.025),
				iron if li % 2 == 0 else iron_rust, 0.40, 0.85
			)
		# 2-3 chains TRAIL DOWN past the loincloth toward the ground
		# (verify-agent: kytons trail loose broken chain ends).
		if ci < 3:
			var trail_start_ang: float = (float(ci) * 1.2)
			var trail_x_base: float = cos(trail_start_ang) * wrap_radius_x
			var trail_z_base: float = sin(trail_start_ang) * wrap_radius_z
			var trail_link_count: int = 5
			for tli in range(trail_link_count):
				var tly: float = wrap_y_base - h * (0.08 + float(tli + 1) * 0.13)
				if tly < 0.02: break
				var jitter_x: float = trail_x_base + rng.randf_range(-w * 0.04, w * 0.04)
				var jitter_z: float = trail_z_base + rng.randf_range(-d * 0.04, d * 0.04)
				_build_box(
					root,
					Vector3(jitter_x - w * 0.022, tly - h * 0.012,
						jitter_z - d * 0.022),
					Vector3(jitter_x + w * 0.022, tly + h * 0.012,
						jitter_z + d * 0.022),
					iron if tli % 2 == 0 else iron_rust, 0.40, 0.85
				)

	# ============================================================================
	# 4 ANIMATED LASHING CHAINS — extending outward from shoulders/hips
	# Each ends in a hooked spike (signature attack chains).
	# ============================================================================
	# Chain anchor points: 2 from shoulders, 2 from hips
	var chain_anchors: Array = [
		{"pos": Vector3(w * 0.42, shoulder_y, -d * 0.10), "dir": Vector3(1, 0.3, -0.8)},
		{"pos": Vector3(-w * 0.42, shoulder_y, -d * 0.10), "dir": Vector3(-1, 0.5, -0.6)},
		{"pos": Vector3(w * 0.20, waist_y, d * 0.20), "dir": Vector3(0.8, -0.2, 1.0)},
		{"pos": Vector3(-w * 0.20, waist_y, d * 0.20), "dir": Vector3(-0.7, 0.1, 1.0)},
	]
	for ca in chain_anchors:
		var anchor: Vector3 = (ca["pos"] as Vector3)
		var direction: Vector3 = (ca["dir"] as Vector3).normalized()
		# 6 links extending outward (~length 0.85 units)
		var lash_link_count: int = 6
		var link_step: float = 0.14
		for li in range(lash_link_count):
			var link_t: float = float(li) / float(lash_link_count - 1)
			var link_pos: Vector3 = anchor + direction * (link_t * link_step * float(lash_link_count))
			# Each chain link slightly offset (alternating orientation)
			var link_size_x: float = w * 0.025
			var link_size_y: float = h * 0.015
			var link_size_z: float = d * 0.025
			if li % 2 == 0:
				link_size_x = w * 0.015
				link_size_z = d * 0.040
			_build_box(
				root,
				link_pos + Vector3(-link_size_x, -link_size_y, -link_size_z),
				link_pos + Vector3(link_size_x, link_size_y, link_size_z),
				iron_dark if li % 2 == 0 else iron, 0.40, 0.85
			)
		# HOOK at the end — sharp curved blade tip
		var hook_root: Vector3 = anchor + direction * (link_step * float(lash_link_count - 1))
		var hook_mid: Vector3 = hook_root + direction * 0.15
		# Hook curves perpendicular to direction (cross product with up)
		var hook_perp: Vector3 = direction.cross(Vector3.UP).normalized() * 0.10
		if hook_perp.length() < 0.01:
			hook_perp = direction.cross(Vector3.FORWARD).normalized() * 0.10
		var hook_tip: Vector3 = hook_mid + hook_perp - direction * 0.05
		_build_tapered_segment(root, hook_root, w * 0.025, hook_mid, w * 0.018,
			iron, 0.40, 0.85)
		_build_tapered_segment(root, hook_mid, w * 0.018, hook_tip, w * 0.004,
			iron_dark, 0.40, 0.85)
		# Small barbs along the chain (2 per chain)
		for bi in range(2):
			var bt: float = (float(bi) + 1.0) / 3.0    # 0.33, 0.67
			var b_pos: Vector3 = anchor + direction * (bt * link_step * float(lash_link_count))
			var b_perp: Vector3 = direction.cross(Vector3.UP).normalized() * 0.06
			if b_perp.length() < 0.01:
				b_perp = direction.cross(Vector3.FORWARD).normalized() * 0.06
			_build_tapered_segment(root, b_pos, w * 0.015,
				b_pos + b_perp, w * 0.003,
				iron, 0.40, 0.85)


# ============================================================================
# CHIMERA (chimera) — Three-headed monster (D&D MM)
#   - LION BODY quadruped (signature base)
#   - 3 HEADS rising from the shoulders: LION (center) + DRAGON (right) + GOAT (left)
#   - DRAGON WINGS on the back
#   - Tawny lion coat
#   - Mane around the lion head
#   - Goat horns on goat head
#   - Dragon scales on dragon head + breath (fire)
# ============================================================================

static func _build_chimera(plan: Dictionary, root: Node3D) -> void:
	var base: Dictionary = plan.get("base", {})
	var palette: Dictionary = plan.get("palette", {})
	var limbs: Dictionary = plan.get("limbs", {})
	var meta: Dictionary = plan.get("meta", {})
	var species: String = String(meta.get("species", "Chimera"))

	# Large lion-bodied predator
	var w: float = _axis(base, "width", 0.95)
	var h: float = _axis(base, "height", 1.40)
	var d: float = _axis(base, "depth", 2.30)
	var leg_length: float = float(limbs.get("leg_length", 0.70))
	var clearance: float = leg_length

	var render_seed: int = int(meta.get("render_seed", 0))
	var rng := RandomNumberGenerator.new()
	rng.seed = render_seed if render_seed != 0 else hash(species)

	# Per-individual variation
	var size_jitter: float = rng.randf_range(0.92, 1.12)
	var mane_density_jitter: float = rng.randf_range(0.85, 1.30)
	var wing_open_jitter: float = rng.randf_range(0.55, 1.00)
	var has_fire_breath: bool = rng.randf() < 0.50
	w *= size_jitter
	h *= size_jitter
	d *= size_jitter
	leg_length *= rng.randf_range(0.92, 1.10)
	clearance = leg_length

	# Lion coat — tawny gold (canon)
	var lion_color := Color(0.70, 0.50, 0.25)
	var lion_dark: Color = lion_color.darkened(0.25)
	var belly_color: Color = lion_color.lightened(0.15)
	var mane_color := Color(0.55, 0.35, 0.15)
	# Dragon scales — green-bronze (canon classic chimera)
	var dragon_color := Color(0.30, 0.42, 0.22)
	var dragon_dark: Color = dragon_color.darkened(0.30)
	# Goat — white/cream
	var goat_color := Color(0.85, 0.78, 0.65)
	var goat_dark: Color = goat_color.darkened(0.25)
	var horn_color := Color(0.25, 0.18, 0.12)
	var hoof_color := Color(0.10, 0.08, 0.06)
	var claw_color := Color(0.12, 0.10, 0.08)
	var fang_color := Color(0.92, 0.88, 0.78)
	var eye_lion := Color(0.95, 0.75, 0.10)
	var eye_dragon := Color(0.95, 0.30, 0.10)
	var eye_goat := Color(0.85, 0.78, 0.30)
	var flame_outer := Color(0.95, 0.30, 0.08)
	var flame_core := Color(1.0, 0.92, 0.55)

	# ============================================================================
	# BODY — lion body trunk
	# ============================================================================
	var body_y: float = clearance + h * 0.25
	var body_sections: Array = [
		{"center": Vector3(0, body_y - h * 0.02, -d * 0.42), "w": w * 0.32, "h": h * 0.32},  # rump
		{"center": Vector3(0, body_y, -d * 0.22), "w": w * 0.46, "h": h * 0.44},             # hip
		{"center": Vector3(0, body_y, -d * 0.05), "w": w * 0.50, "h": h * 0.46},             # mid
		{"center": Vector3(0, body_y + h * 0.02, d * 0.12), "w": w * 0.55, "h": h * 0.50},   # shoulders (broad — 3 necks attach here)
		{"center": Vector3(0, body_y + h * 0.05, d * 0.28), "w": w * 0.42, "h": h * 0.44},   # chest
	]
	_swept_body(root, body_sections, 10, lion_color, belly_color, 0.95, true)

	# ============================================================================
	# 3 HEADS — Lion (center), Dragon (right, LARGEST), Goat (left, SMALLEST).
	# Verify-agent fix: all 3 necks now CONVERGE at a single shoulder yoke
	# (x≈0, z≈+shoulder_front), only the heads splay outward — reads as one
	# chimera not three stapled creatures.
	# ============================================================================
	var shoulder_anchor := (body_sections[3]["center"] as Vector3)
	var neck_yoke := Vector3(0, shoulder_anchor.y + h * 0.08,
		shoulder_anchor.z + d * 0.12)
	# --- LION HEAD (center, slightly forward; mid-scale) ---
	var lion_neck_base := neck_yoke
	var lion_head_anchor := Vector3(0, neck_yoke.y + h * 0.12, neck_yoke.z + d * 0.18)
	_build_tapered_segment(root, lion_neck_base, w * 0.20, lion_head_anchor, w * 0.22,
		lion_color, 0.95)
	# Lion skull (mid scale = 1.0)
	var lh_w: float = w * 0.26
	var lh_h: float = h * 0.22
	var lh_d: float = d * 0.22
	var lh_y_bot: float = lion_head_anchor.y - lh_h * 0.40
	var lh_y_top: float = lh_y_bot + lh_h
	var lh_c_y: float = (lh_y_bot + lh_y_top) * 0.5
	_build_box(
		root,
		Vector3(-lh_w, lh_y_bot, lion_head_anchor.z - lh_d * 0.30),
		Vector3(lh_w, lh_y_top, lion_head_anchor.z + lh_d * 0.40),
		lion_color, 0.95
	)
	# Lion snout
	_build_box(
		root,
		Vector3(-lh_w * 0.60, lh_y_bot + h * 0.015,
			lion_head_anchor.z + lh_d * 0.40 - d * 0.005),
		Vector3(lh_w * 0.60, lh_y_top - h * 0.05,
			lion_head_anchor.z + lh_d * 0.85),
		lion_color, 0.95
	)
	# Black lion nose
	_build_box(
		root,
		Vector3(-lh_w * 0.20, lh_y_top - h * 0.10,
			lion_head_anchor.z + lh_d * 0.80),
		Vector3(lh_w * 0.20, lh_y_top - h * 0.06,
			lion_head_anchor.z + lh_d * 0.88),
		Color(0.06, 0.04, 0.04), 0.55
	)
	# Lion eyes
	for side in [-1, 1]:
		_build_box(
			root,
			Vector3(side * lh_w * 0.55 - w * 0.030,
				lh_c_y + h * 0.005, lion_head_anchor.z + lh_d * 0.30),
			Vector3(side * lh_w * 0.55 + w * 0.030,
				lh_c_y + h * 0.030, lion_head_anchor.z + lh_d * 0.40),
			eye_lion, 0.20, 0.0
		)
	# Lion jaw with fangs
	var lj_y_top: float = lh_y_bot + h * 0.01
	var lj_y_bot: float = lj_y_top - h * 0.05
	_build_box(
		root,
		Vector3(-lh_w * 0.50, lj_y_bot,
			lion_head_anchor.z + lh_d * 0.42),
		Vector3(lh_w * 0.50, lj_y_top,
			lion_head_anchor.z + lh_d * 0.82),
		lion_dark, 0.95
	)
	for side in [-1, 1]:
		_build_tapered_segment(root,
			Vector3(side * lh_w * 0.35, lj_y_top, lion_head_anchor.z + lh_d * 0.55),
			w * 0.020,
			Vector3(side * lh_w * 0.35, lj_y_top - h * 0.040,
				lion_head_anchor.z + lh_d * 0.60),
			w * 0.004,
			fang_color, 0.45)
	# Small lion ears
	for side in [-1, 1]:
		_build_box(
			root,
			Vector3(side * lh_w * 0.55, lh_y_top - h * 0.005,
				lion_head_anchor.z - lh_d * 0.10),
			Vector3(side * lh_w * 0.85, lh_y_top + h * 0.06,
				lion_head_anchor.z + lh_d * 0.05),
			lion_color, 0.95
		)

	# LION MANE — radiating tufts around the lion head/neck
	var mane_count: int = int(round(14.0 * mane_density_jitter))
	for mi in range(mane_count):
		var m_ang: float = (float(mi) / float(mane_count)) * TAU
		# Skip face area (front-center)
		if cos(m_ang) > 0.7 and abs(sin(m_ang)) < 0.4:
			continue
		var mx: float = cos(m_ang) * lh_w * 1.15
		var mz: float = sin(m_ang) * lh_d * 0.45 + lion_head_anchor.z - lh_d * 0.05
		var mane_root := Vector3(mx, lh_c_y + sin(m_ang) * h * 0.04, mz)
		var mane_tip := Vector3(mx * 1.25,
			mane_root.y + h * rng.randf_range(-0.05, 0.05),
			mz + (sin(m_ang) - 0.5) * d * 0.10)
		_build_tapered_segment(root, mane_root, w * 0.030, mane_tip, w * 0.008,
			mane_color if mi % 2 == 0 else mane_color.darkened(0.20), 0.95)

	# --- DRAGON HEAD (right, LARGEST scale 1.15 — canon: it's the threat) ---
	# Neck base converges at the yoke, only the head splays right + slightly down
	var dh_anchor_neck := neck_yoke
	var dh_anchor := Vector3(w * 0.55, neck_yoke.y + h * 0.04,
		neck_yoke.z + d * 0.20)
	_build_tapered_segment(root, dh_anchor_neck, w * 0.18, dh_anchor, w * 0.20,
		dragon_color, 0.85)
	# Dragon skull (1.15× lion scale)
	var dh_w: float = w * 0.23
	var dh_h: float = h * 0.21
	var dh_d: float = d * 0.23
	_build_box(
		root,
		Vector3(w * 0.50 - dh_w, dh_anchor.y - dh_h * 0.40,
			dh_anchor.z - dh_d * 0.30),
		Vector3(w * 0.50 + dh_w, dh_anchor.y - dh_h * 0.40 + dh_h,
			dh_anchor.z + dh_d * 0.40),
		dragon_color, 0.85
	)
	# Dragon snout (long)
	_build_box(
		root,
		Vector3(w * 0.50 - dh_w * 0.60, dh_anchor.y - dh_h * 0.35,
			dh_anchor.z + dh_d * 0.40),
		Vector3(w * 0.50 + dh_w * 0.60, dh_anchor.y + dh_h * 0.20,
			dh_anchor.z + dh_d * 0.90),
		dragon_color, 0.85
	)
	# Dragon eyes (red glow)
	for side in [-1, 1]:
		_build_box(
			root,
			Vector3(w * 0.50 + side * dh_w * 0.55 - w * 0.025,
				dh_anchor.y, dh_anchor.z + dh_d * 0.20),
			Vector3(w * 0.50 + side * dh_w * 0.55 + w * 0.025,
				dh_anchor.y + h * 0.025, dh_anchor.z + dh_d * 0.30),
			eye_dragon, 0.10, 0.0
		)
	# Dragon horns sweeping back
	for side in [-1, 1]:
		var dragon_horn_base := Vector3(w * 0.50 + side * dh_w * 0.80,
			dh_anchor.y - dh_h * 0.40 + dh_h - h * 0.005,
			dh_anchor.z + dh_d * 0.10)
		var dragon_horn_tip := Vector3(w * 0.50 + side * dh_w * 0.95,
			dh_anchor.y + h * 0.15,
			dh_anchor.z - dh_d * 0.30)
		_build_tapered_segment(root, dragon_horn_base, w * 0.035,
			dragon_horn_tip, w * 0.005,
			horn_color, 0.55)
	# Dragon jaw + 2 fangs
	var dj_y_top: float = dh_anchor.y - dh_h * 0.35
	var dj_y_bot: float = dj_y_top - h * 0.05
	_build_box(
		root,
		Vector3(w * 0.50 - dh_w * 0.55, dj_y_bot,
			dh_anchor.z + dh_d * 0.40),
		Vector3(w * 0.50 + dh_w * 0.55, dj_y_top,
			dh_anchor.z + dh_d * 0.85),
		dragon_dark, 0.85
	)
	for side in [-1, 1]:
		_build_tapered_segment(root,
			Vector3(w * 0.50 + side * dh_w * 0.40, dj_y_top,
				dh_anchor.z + dh_d * 0.60),
			w * 0.018,
			Vector3(w * 0.50 + side * dh_w * 0.40, dj_y_top - h * 0.04,
				dh_anchor.z + dh_d * 0.65),
			w * 0.003,
			fang_color, 0.45)
	# DRAGON FIRE BREATH (50% — has_fire_breath)
	if has_fire_breath:
		var fb_origin := Vector3(w * 0.50, dh_anchor.y - dh_h * 0.10,
			dh_anchor.z + dh_d * 0.85)
		var fb_mid := fb_origin + Vector3(d * 0.20, -h * 0.05, d * 0.30)
		var fb_tip := fb_origin + Vector3(d * 0.40, -h * 0.12, d * 0.65)
		_build_tapered_segment(root, fb_origin, w * 0.08, fb_mid, w * 0.05,
			flame_outer, 0.05, 0.0)
		_build_tapered_segment(root, fb_mid, w * 0.05, fb_tip, w * 0.015,
			flame_outer, 0.05, 0.0)
		_build_tapered_segment(root, fb_origin, w * 0.04, fb_mid, w * 0.025,
			flame_core, 0.05, 0.0)
		_build_tapered_segment(root, fb_mid, w * 0.025, fb_tip, w * 0.008,
			flame_core, 0.05, 0.0)

	# --- GOAT HEAD (left, SMALLEST scale 0.80 per canon hierarchy) ---
	# Neck base converges at the yoke, head splays left + slightly up
	var gh_anchor_neck := neck_yoke
	var gh_anchor := Vector3(-w * 0.50, neck_yoke.y + h * 0.10,
		neck_yoke.z + d * 0.16)
	_build_tapered_segment(root, gh_anchor_neck, w * 0.14, gh_anchor, w * 0.14,
		goat_color, 0.95)
	# Goat skull (0.80× lion scale)
	var gh_w: float = w * 0.13
	var gh_h: float = h * 0.14
	var gh_d: float = d * 0.18
	_build_box(
		root,
		Vector3(-w * 0.48 - gh_w, gh_anchor.y - gh_h * 0.40,
			gh_anchor.z - gh_d * 0.30),
		Vector3(-w * 0.48 + gh_w, gh_anchor.y + gh_h * 0.60,
			gh_anchor.z + gh_d * 0.30),
		goat_color, 0.95
	)
	# Goat muzzle (extended)
	_build_box(
		root,
		Vector3(-w * 0.48 - gh_w * 0.65, gh_anchor.y - gh_h * 0.30,
			gh_anchor.z + gh_d * 0.30),
		Vector3(-w * 0.48 + gh_w * 0.65, gh_anchor.y + gh_h * 0.10,
			gh_anchor.z + gh_d * 0.70),
		goat_color, 0.95
	)
	# Black goat nose
	_build_box(
		root,
		Vector3(-w * 0.48 - gh_w * 0.15, gh_anchor.y - gh_h * 0.10,
			gh_anchor.z + gh_d * 0.65),
		Vector3(-w * 0.48 + gh_w * 0.15, gh_anchor.y + gh_h * 0.05,
			gh_anchor.z + gh_d * 0.72),
		Color(0.10, 0.07, 0.05), 0.65
	)
	# Goat eyes (yellow with horizontal slit suggestion)
	for side in [-1, 1]:
		_build_box(
			root,
			Vector3(-w * 0.48 + side * gh_w * 0.55 - w * 0.020,
				gh_anchor.y + gh_h * 0.05, gh_anchor.z + gh_d * 0.15),
			Vector3(-w * 0.48 + side * gh_w * 0.55 + w * 0.020,
				gh_anchor.y + gh_h * 0.22, gh_anchor.z + gh_d * 0.25),
			eye_goat, 0.30, 0.0
		)
		# Horizontal slit pupil
		_build_box(
			root,
			Vector3(-w * 0.48 + side * gh_w * 0.55 - w * 0.018,
				gh_anchor.y + gh_h * 0.10, gh_anchor.z + gh_d * 0.22),
			Vector3(-w * 0.48 + side * gh_w * 0.55 + w * 0.018,
				gh_anchor.y + gh_h * 0.16, gh_anchor.z + gh_d * 0.27),
			Color(0.05, 0.04, 0.02), 0.40
		)
	# CURVED GOAT HORNS (signature — curling back over the head)
	for side in [-1, 1]:
		var gh_base := Vector3(-w * 0.48 + side * gh_w * 0.75,
			gh_anchor.y + gh_h * 0.55,
			gh_anchor.z - gh_d * 0.05)
		var gh_mid := Vector3(-w * 0.48 + side * gh_w * 1.15,
			gh_anchor.y + gh_h * 0.80,
			gh_anchor.z - gh_d * 0.30)
		var gh_tip := Vector3(-w * 0.48 + side * gh_w * 1.00,
			gh_anchor.y + gh_h * 0.55,
			gh_anchor.z - gh_d * 0.65)
		_build_tapered_segment(root, gh_base, w * 0.040, gh_mid, w * 0.024,
			horn_color, 0.55)
		_build_tapered_segment(root, gh_mid, w * 0.024, gh_tip, w * 0.006,
			horn_color.darkened(0.20), 0.55)
	# Goat beard tuft
	_build_tapered_segment(root,
		Vector3(-w * 0.48, gh_anchor.y - gh_h * 0.30, gh_anchor.z + gh_d * 0.50),
		w * 0.025,
		Vector3(-w * 0.48, gh_anchor.y - gh_h * 0.55, gh_anchor.z + gh_d * 0.45),
		w * 0.008,
		goat_dark, 0.95)

	# ============================================================================
	# DRAGON WINGS — leathery bat wings spread from the back
	# ============================================================================
	var wing_spread: float = w * 2.40 * wing_open_jitter
	for side in [-1, 1]:
		var wing_root := Vector3(side * w * 0.45,
			(body_sections[2]["center"] as Vector3).y + h * 0.18,
			(body_sections[2]["center"] as Vector3).z)
		var wing_elbow := Vector3(side * (w * 0.45 + wing_spread * 0.40),
			wing_root.y + wing_spread * h * 0.08,
			-d * 0.10)
		var wing_peak := Vector3(side * (w * 0.45 + wing_spread * 0.95),
			wing_root.y + wing_spread * h * 0.02,
			-d * 0.30)
		_build_tapered_segment(root, wing_root, w * 0.08, wing_elbow, w * 0.06,
			dragon_dark, 0.65)
		_build_tapered_segment(root, wing_elbow, w * 0.06, wing_peak, w * 0.022,
			dragon_dark, 0.65)
		# Thumb claw at peak
		_build_tapered_segment(root, wing_peak, w * 0.020,
			wing_peak + Vector3(side * w * 0.06, h * 0.04, d * 0.02), w * 0.005,
			claw_color, 0.40)
		# 4 finger struts + membrane
		var struts: int = 4
		var trails: Array = []
		for fi in range(struts):
			var ft: float = float(fi) / float(struts - 1)
			var trail := Vector3(
				lerpf(side * w * 0.40, side * (w * 0.45 + wing_spread * 0.95), ft),
				wing_root.y - h * lerpf(0.10, 0.05, ft) - wing_spread * h * 0.04,
				lerpf(-d * 0.30, -d * 0.20, ft)
			)
			trails.append(trail)
			_build_tapered_segment(root, wing_peak, w * 0.020, trail, w * 0.005,
				dragon_dark, 0.65)
		# Membrane
		var st_w := SurfaceTool.new()
		st_w.begin(Mesh.PRIMITIVE_TRIANGLES)
		_add_quad(st_w, wing_root, wing_elbow,
			trails[1] as Vector3, trails[0] as Vector3)
		_add_quad(st_w, wing_elbow, wing_peak,
			trails[2] as Vector3, trails[1] as Vector3)
		_add_tri(st_w, wing_peak, trails[3] as Vector3, trails[2] as Vector3)
		st_w.generate_normals()
		var mi_w := MeshInstance3D.new()
		mi_w.mesh = st_w.commit()
		var mat_w := StandardMaterial3D.new()
		mat_w.albedo_color = dragon_dark.darkened(0.10)
		mat_w.roughness = 0.65
		mat_w.cull_mode = BaseMaterial3D.CULL_DISABLED
		mi_w.material_override = mat_w
		root.add_child(mi_w)

	# ============================================================================
	# 4 LION LEGS with paws
	# ============================================================================
	for side in [-1, 1]:
		# Front legs
		var fhip := Vector3(side * w * 0.30, body_y, d * 0.18)
		var fknee := Vector3(side * w * 0.30, clearance * 0.55, d * 0.20)
		var fpaw := Vector3(side * w * 0.28, 0.04, d * 0.24)
		_build_tapered_segment(root, fhip, w * 0.15, fknee, w * 0.12, lion_color, 0.95)
		_build_tapered_segment(root, fknee, w * 0.12, fpaw, w * 0.10, lion_dark, 0.95)
		_build_box(
			root,
			Vector3(side * w * 0.28 - w * 0.11, 0.0, d * 0.18),
			Vector3(side * w * 0.28 + w * 0.11, h * 0.07, d * 0.34),
			lion_dark, 0.95
		)
		for ci in range(4):
			var co: float = (float(ci) - 1.5) * w * 0.05
			_build_tapered_segment(root,
				Vector3(side * w * 0.28 + co, h * 0.03, d * 0.34), w * 0.020,
				Vector3(side * w * 0.28 + co, 0.0, d * 0.42), w * 0.004,
				claw_color, 0.40)
		# Back legs (digitigrade hock)
		var rhip := Vector3(side * w * 0.30, body_y - h * 0.02, -d * 0.18)
		var rknee := Vector3(side * w * 0.32, clearance * 0.60, -d * 0.12)
		var rhock := Vector3(side * w * 0.30, clearance * 0.28, -d * 0.22)
		var rpaw := Vector3(side * w * 0.28, 0.04, -d * 0.16)
		_build_tapered_segment(root, rhip, w * 0.17, rknee, w * 0.12, lion_color, 0.95)
		_build_tapered_segment(root, rknee, w * 0.12, rhock, w * 0.11, lion_color, 0.95)
		_build_tapered_segment(root, rhock, w * 0.11, rpaw, w * 0.10, lion_dark, 0.95)
		_build_box(
			root,
			Vector3(side * w * 0.28 - w * 0.11, 0.0, -d * 0.22),
			Vector3(side * w * 0.28 + w * 0.11, h * 0.07, -d * 0.06),
			lion_dark, 0.95
		)
		for ci in range(4):
			var co: float = (float(ci) - 1.5) * w * 0.045
			_build_tapered_segment(root,
				Vector3(side * w * 0.28 + co, h * 0.03, -d * 0.06), w * 0.018,
				Vector3(side * w * 0.28 + co, 0.0, d * 0.02), w * 0.004,
				claw_color, 0.40)

	# ============================================================================
	# TAIL — LONG lion tail with tasseled tuft. Verify-agent fix: extended
	# to ~1.0× body depth so it reaches past the rear paws per canon.
	# ============================================================================
	var tail_base := Vector3(0, body_y - h * 0.02, -d * 0.42)
	var tail_mid := Vector3(0, body_y - h * 0.10, -d * 0.85)
	var tail_tip := Vector3(rng.randf_range(-w * 0.15, w * 0.15),
		body_y - h * 0.20, -d * 1.30)
	_build_tapered_segment(root, tail_base, w * 0.10, tail_mid, w * 0.065,
		lion_color, 0.95)
	_build_tapered_segment(root, tail_mid, w * 0.065, tail_tip, w * 0.025,
		lion_dark, 0.95)
	# Tassel tuft at tip
	for tu in range(4):
		var t_ang: float = (float(tu) - 1.5) * 0.40
		_build_tapered_segment(root,
			tail_tip, w * 0.025,
			tail_tip + Vector3(sin(t_ang) * w * 0.08,
				-h * rng.randf_range(0.04, 0.08),
				cos(t_ang) * d * 0.03 - d * 0.04),
			w * 0.006,
			mane_color, 0.95)


# ============================================================================
# CHUUL (chuul) — Aquatic crustacean aberration (D&D MM)
#   - Lobster-like SEGMENTED carapace body
#   - 4 walking legs (split front/rear)
#   - 2 HUGE PINCER CLAWS held forward (signature)
#   - TENTACLE MASS hanging below the mouth (paralytic — canon)
#   - Brown/rust carapace with darker plates
#   - Stalked COMPOUND EYES on top of head
#   - Long segmented tail-abdomen extending behind
# ============================================================================

static func _build_chuul(plan: Dictionary, root: Node3D) -> void:
	var base: Dictionary = plan.get("base", {})
	var palette: Dictionary = plan.get("palette", {})
	var limbs: Dictionary = plan.get("limbs", {})
	var meta: Dictionary = plan.get("meta", {})
	var species: String = String(meta.get("species", "Chuul"))

	# Large UPRIGHT lobster-aberration — verify-agent fix: was too long-low
	# (crayfish-coded); canon chuul is ~as tall as it is long, hunched but
	# bipedal-stanced with the raised claws as the widest point.
	var w: float = _axis(base, "width", 1.10)
	var h: float = _axis(base, "height", 1.80)
	var d: float = _axis(base, "depth", 1.65)
	var leg_length: float = float(limbs.get("leg_length", 0.75))
	var clearance: float = leg_length

	var render_seed: int = int(meta.get("render_seed", 0))
	var rng := RandomNumberGenerator.new()
	rng.seed = render_seed if render_seed != 0 else hash(species)

	# Per-individual variation
	var size_jitter: float = rng.randf_range(0.92, 1.15)
	var claw_size_jitter: float = rng.randf_range(0.90, 1.30)
	var tentacle_count: int = rng.randi_range(6, 10)
	w *= size_jitter
	h *= size_jitter
	d *= size_jitter
	leg_length *= rng.randf_range(0.92, 1.10)
	clearance = leg_length

	# Carapace palette — canon brown/rust crustacean
	var shell_options := [
		Color(0.45, 0.30, 0.18),     # brown (canon)
		Color(0.55, 0.32, 0.18),     # rust
		Color(0.38, 0.25, 0.15),     # dark earth
		Color(0.50, 0.35, 0.22),     # ochre-brown
		Color(0.42, 0.28, 0.20),     # muddy brown
	]
	var primary: Color = shell_options[rng.randi() % shell_options.size()]
	var shell_dark: Color = primary.darkened(0.30)
	var belly_color: Color = primary.lightened(0.12).lerp(Color(0.50, 0.40, 0.20), 0.3)
	var claw_chitin: Color = primary.darkened(0.10)
	var tentacle_color := Color(0.55, 0.45, 0.20)   # yellowish-tan tentacles (canon)
	var eye_color := Color(0.10, 0.08, 0.06)         # tiny dark compound eyes
	var eye_stalk_color: Color = primary
	var claw_inner := Color(0.85, 0.75, 0.50)       # pale claw interior
	var fang_color := Color(0.92, 0.88, 0.78)

	# ============================================================================
	# BODY — segmented carapace trunk (lobster-style)
	# ============================================================================
	var body_y: float = clearance + h * 0.20
	var body_sections: Array = [
		{"center": Vector3(0, body_y - h * 0.03, -d * 0.42), "w": w * 0.32, "h": h * 0.28},  # tail-abdomen end
		{"center": Vector3(0, body_y, -d * 0.22), "w": w * 0.42, "h": h * 0.42},             # abdomen mid
		{"center": Vector3(0, body_y, -d * 0.05), "w": w * 0.48, "h": h * 0.46},             # waist seam
		{"center": Vector3(0, body_y + h * 0.02, d * 0.15), "w": w * 0.56, "h": h * 0.52},   # thorax (widest)
		{"center": Vector3(0, body_y + h * 0.05, d * 0.32), "w": w * 0.48, "h": h * 0.46},   # head shield base
	]
	_swept_body(root, body_sections, 10, primary, belly_color, 0.65, true)

	# SEGMENT SEAMS — 4 darker bands across the abdomen (lobster tail look)
	var seam_z_positions: Array = [-d * 0.36, -d * 0.22, -d * 0.08, d * 0.06]
	for sz in seam_z_positions:
		var seam_z: float = sz as float
		var ring_w: float = w * 0.45
		_build_box(
			root,
			Vector3(-ring_w * 1.02, body_y - h * 0.24, seam_z - d * 0.012),
			Vector3(ring_w * 1.02, body_y + h * 0.24, seam_z + d * 0.012),
			shell_dark, 0.65
		)

	# HEAD SHIELD — frontal armored crest above the head
	_build_box(
		root,
		Vector3(-w * 0.45, body_y + h * 0.30, d * 0.22),
		Vector3(w * 0.45, body_y + h * 0.48, d * 0.42),
		shell_dark, 0.55
	)
	# Front edge of head shield (lighter)
	_build_box(
		root,
		Vector3(-w * 0.42, body_y + h * 0.40, d * 0.38),
		Vector3(w * 0.42, body_y + h * 0.48, d * 0.50),
		primary, 0.55
	)

	# ============================================================================
	# EYES — stalked compound eyes on top of the head shield
	# ============================================================================
	for side in [-1, 1]:
		var stalk_base := Vector3(side * w * 0.20, body_y + h * 0.45, d * 0.32)
		var stalk_tip := Vector3(side * w * 0.28, body_y + h * 0.58, d * 0.38)
		# Stalk
		_build_tapered_segment(root, stalk_base, w * 0.025, stalk_tip, w * 0.020,
			eye_stalk_color, 0.65)
		# Eye sphere at the tip
		_build_box(
			root,
			stalk_tip + Vector3(-w * 0.030, -h * 0.025, -d * 0.025),
			stalk_tip + Vector3(w * 0.030, h * 0.025, d * 0.025),
			eye_color, 0.70
		)

	# ============================================================================
	# MOUTH + TENTACLE MASS — signature paralytic tentacles hanging below the mouth
	# ============================================================================
	# Mouth opening (under the head shield, between the eyes — dark slot)
	var mouth_y_top: float = body_y + h * 0.18
	var mouth_y_bot: float = body_y + h * 0.05
	_build_box(
		root,
		Vector3(-w * 0.20, mouth_y_bot, d * 0.40),
		Vector3(w * 0.20, mouth_y_top, d * 0.48),
		Color(0.10, 0.05, 0.05), 0.85
	)
	# 2 small chitin mandibles flanking the mouth
	for side in [-1, 1]:
		_build_tapered_segment(root,
			Vector3(side * w * 0.18, mouth_y_top - h * 0.02, d * 0.40),
			w * 0.025,
			Vector3(side * w * 0.10, mouth_y_bot, d * 0.50),
			w * 0.005,
			fang_color, 0.45)

	# TENTACLE MASS — many writhing tentacles drooping from below the mouth
	for ti in range(tentacle_count):
		var t_ang_offset: float = (float(ti) / float(tentacle_count)) * PI - PI * 0.5
		# Anchor on an arc below the mouth
		var anchor_x: float = sin(t_ang_offset) * w * 0.20
		var anchor_z: float = d * 0.42 + cos(t_ang_offset) * d * 0.05
		var anchor_y: float = mouth_y_bot - h * 0.01
		var anchor := Vector3(anchor_x, anchor_y, anchor_z)
		# Tentacles droop downward + forward, with random length + curl
		var t_len: float = h * rng.randf_range(0.45, 0.75)
		var tip_x: float = anchor_x * 1.4 + rng.randf_range(-w * 0.04, w * 0.04)
		var tip_z: float = anchor_z + d * rng.randf_range(0.08, 0.20)
		var tip_y: float = anchor_y - t_len
		var tip_pos := Vector3(tip_x, tip_y, tip_z)
		# Mid-segment with droop curve
		var mid_pos := Vector3(
			(anchor_x + tip_x) * 0.5,
			anchor_y - t_len * 0.55,
			(anchor_z + tip_z) * 0.5 + d * 0.04
		)
		_build_tapered_segment(root, anchor, w * 0.025, mid_pos, w * 0.018,
			tentacle_color, 0.45)
		_build_tapered_segment(root, mid_pos, w * 0.018, tip_pos, w * 0.006,
			tentacle_color.darkened(0.15), 0.45)

	# ============================================================================
	# 2 HUGE PINCER CLAWS — held HIGH and FORWARD at thorax-top height.
	# Verify-agent fix: claws raised to shoulder height + scaled ~20% larger;
	# they should be the widest point of the silhouette.
	# ============================================================================
	for side in [-1, 1]:
		var arm_shoulder := Vector3(side * w * 0.46, body_y + h * 0.28, d * 0.20)
		var arm_elbow := Vector3(side * (w * 0.70 + 0.10), body_y + h * 0.22, d * 0.40)
		var arm_wrist := Vector3(side * (w * 0.62 + 0.05), body_y + h * 0.30, d * 0.65)
		# Upper arm (chitin segment)
		_build_tapered_segment(root, arm_shoulder, w * 0.14, arm_elbow, w * 0.12,
			primary, 0.65)
		# Forearm
		_build_tapered_segment(root, arm_elbow, w * 0.12, arm_wrist, w * 0.12,
			primary, 0.65)
		# Joint plate at elbow
		_build_box(
			root,
			arm_elbow + Vector3(-w * 0.06, -h * 0.05, -d * 0.05),
			arm_elbow + Vector3(w * 0.06, h * 0.05, d * 0.05),
			shell_dark, 0.65
		)
		# CLAW BASE — wide chitin block (scaled +20%)
		var claw_back := arm_wrist + Vector3(side * w * 0.02, 0, d * 0.02)
		var claw_size_x: float = w * 0.19 * claw_size_jitter
		var claw_size_y: float = h * 0.26 * claw_size_jitter
		var claw_size_z: float = d * 0.24 * claw_size_jitter
		_build_box(
			root,
			claw_back + Vector3(-claw_size_x, -claw_size_y, 0),
			claw_back + Vector3(claw_size_x, claw_size_y, claw_size_z),
			claw_chitin, 0.65
		)
		# Inner claw void (dark cavity where prey is crushed)
		_build_box(
			root,
			claw_back + Vector3(-claw_size_x * 0.7, -claw_size_y * 0.3,
				claw_size_z * 0.6),
			claw_back + Vector3(claw_size_x * 0.7, claw_size_y * 0.3,
				claw_size_z * 1.05),
			Color(0.15, 0.10, 0.06), 0.80
		)
		# UPPER PRONG (fixed, larger)
		var upper_prong_root := claw_back + Vector3(0, claw_size_y * 0.6, claw_size_z)
		var upper_prong_tip := claw_back + Vector3(0, claw_size_y * 0.2,
			claw_size_z * 1.85)
		_build_tapered_segment(root, upper_prong_root, w * 0.10, upper_prong_tip, w * 0.020,
			claw_chitin, 0.55)
		# Inner edge of upper prong (toothed serration suggestion)
		_build_box(
			root,
			upper_prong_root + Vector3(-w * 0.06, -h * 0.06, 0),
			upper_prong_tip + Vector3(w * 0.06, h * 0.005, 0),
			claw_inner, 0.65
		)
		# LOWER PRONG (movable, slightly smaller)
		var lower_prong_root := claw_back + Vector3(0, -claw_size_y * 0.6, claw_size_z)
		var lower_prong_tip := claw_back + Vector3(0, -claw_size_y * 0.05,
			claw_size_z * 1.70)
		_build_tapered_segment(root, lower_prong_root, w * 0.09, lower_prong_tip, w * 0.018,
			claw_chitin, 0.55)
		_build_box(
			root,
			lower_prong_root + Vector3(-w * 0.05, -h * 0.005, 0),
			lower_prong_tip + Vector3(w * 0.05, h * 0.05, 0),
			claw_inner, 0.65
		)
		# Tiny serration teeth between the prongs (3 small)
		for ti in range(3):
			var serr_t: float = (float(ti) + 0.5) / 3.0
			var serr_x_off: float = w * 0.012 * (1.0 if ti % 2 == 0 else -1.0)
			var serr_pos: Vector3 = upper_prong_root.lerp(upper_prong_tip, serr_t)
			_build_tapered_segment(root,
				serr_pos + Vector3(serr_x_off, -h * 0.005, 0), w * 0.014,
				serr_pos + Vector3(serr_x_off, -h * 0.07, 0), w * 0.003,
				fang_color, 0.45)

	# ============================================================================
	# 4 WALKING LEGS — 2 pairs of REAR-SET BIPEDAL props (verify-agent fix:
	# spider-splayed posture replaced with narrow rear-set vertical stance;
	# legs tucked under the body, not flared lateral).
	# ============================================================================
	var leg_z_positions: Array = [d * 0.05, -d * 0.10]
	for pair_idx in range(leg_z_positions.size()):
		var lz: float = leg_z_positions[pair_idx] as float
		for side in [-1, 1]:
			# Narrow hip — leg roots pulled inward ~40% (was 0.38, now 0.22)
			var hip := Vector3(side * w * 0.22, body_y - h * 0.08, lz)
			# Knee bends DOWNWARD then slightly outward (bipedal-prop angle)
			var knee := Vector3(side * w * 0.30, clearance * 0.55,
				lz - d * 0.04)
			var ankle := Vector3(side * w * 0.28, clearance * 0.22,
				lz - d * 0.05)
			var foot := Vector3(side * w * 0.28, 0.05, lz - d * 0.02)
			_build_tapered_segment(root, hip, w * 0.08, knee, w * 0.060,
				primary, 0.65)
			_build_tapered_segment(root, knee, w * 0.060, ankle, w * 0.050,
				primary, 0.65)
			_build_tapered_segment(root, ankle, w * 0.050, foot, w * 0.045,
				shell_dark, 0.65)
			# Tiny chitin claw at the foot tip
			_build_tapered_segment(root,
				foot, w * 0.035,
				foot + Vector3(side * w * 0.02, -h * 0.01, -d * 0.02),
				w * 0.005,
				Color(0.15, 0.10, 0.06), 0.50)

	# ============================================================================
	# VESTIGIAL TAIL FAN — small uropod tucked UNDER + rearward (canon chuul
	# tail is vestigial-looking, not a trailing lobster tail).
	# Verify-agent fix: brought closer to body and tucked downward.
	# ============================================================================
	var tail_tip := Vector3(0, body_y - h * 0.18, -d * 0.42)
	_build_box(
		root,
		Vector3(-w * 0.14, tail_tip.y - h * 0.03, tail_tip.z - d * 0.03),
		Vector3(w * 0.14, tail_tip.y + h * 0.06, tail_tip.z + d * 0.03),
		primary, 0.65
	)
	# 3 small fan plates radiating downward (vestigial)
	for fi in range(3):
		var fan_ang: float = lerpf(-0.5, 0.5, float(fi) / 2.0)
		var fan_tip := Vector3(sin(fan_ang) * w * 0.20, tail_tip.y - h * 0.06,
			tail_tip.z - d * 0.10)
		_build_tapered_segment(root,
			Vector3(sin(fan_ang) * w * 0.07, tail_tip.y, tail_tip.z),
			w * 0.030,
			fan_tip, w * 0.010,
			shell_dark, 0.65)


# ============================================================================
# COCKATRICE (cockatrice) — Rooster-dragon hybrid with petrifying beak
#   - Rooster body with scaled REPTILIAN TAIL (signature)
#   - Red COMB on top of head + RED WATTLE under chin (rooster signature)
#   - HOOKED BEAK with petrifying touch
#   - BAT-LIKE WINGS (often described as feathered + leathery hybrid)
#   - Bird legs with curved TALONS
#   - Brown/copper feathers with iridescent green tail
# ============================================================================

static func _build_cockatrice(plan: Dictionary, root: Node3D) -> void:
	var base: Dictionary = plan.get("base", {})
	var palette: Dictionary = plan.get("palette", {})
	var limbs: Dictionary = plan.get("limbs", {})
	var meta: Dictionary = plan.get("meta", {})
	var species: String = String(meta.get("species", "Cockatrice"))

	# Small rooster-sized (D&D 5e Small)
	var w: float = _axis(base, "width", 0.32)
	var h: float = _axis(base, "height", 0.65)
	var d: float = _axis(base, "depth", 0.55)
	var leg_length: float = float(limbs.get("leg_length", 0.30))
	var clearance: float = leg_length

	var render_seed: int = int(meta.get("render_seed", 0))
	var rng := RandomNumberGenerator.new()
	rng.seed = render_seed if render_seed != 0 else hash(species)

	# Per-individual variation
	var size_jitter: float = rng.randf_range(0.92, 1.18)
	var comb_size_jitter: float = rng.randf_range(0.85, 1.30)
	var wing_open_jitter: float = rng.randf_range(0.45, 0.95)
	w *= size_jitter
	h *= size_jitter
	d *= size_jitter
	leg_length *= rng.randf_range(0.92, 1.10)
	clearance = leg_length

	# Feather palette — canon rooster brown/copper
	var feather_options := [
		Color(0.55, 0.32, 0.18),     # copper-brown (canon)
		Color(0.45, 0.25, 0.15),     # dark rust
		Color(0.65, 0.40, 0.20),     # bright copper
		Color(0.30, 0.20, 0.15),     # near-black brown
	]
	var primary: Color = feather_options[rng.randi() % feather_options.size()]
	var feather_dark: Color = primary.darkened(0.30)
	var belly_color: Color = primary.lightened(0.15)
	# Iridescent tail scales — green/teal
	var tail_scale := Color(0.20, 0.45, 0.30)
	var tail_scale_dark: Color = tail_scale.darkened(0.30)
	# Rooster red — comb + wattle
	var comb_red := Color(0.78, 0.18, 0.18)
	var comb_dark: Color = comb_red.darkened(0.20)
	# Beak — yellow horn
	var beak_color := Color(0.85, 0.72, 0.25)
	var beak_tip := Color(0.50, 0.40, 0.15)
	# Talons — black
	var talon_color := Color(0.10, 0.08, 0.06)
	# Eye — yellow (canon "golden eyes")
	var eye_color := Color(0.95, 0.80, 0.10)

	# ============================================================================
	# BODY — wyvern/dragon-trunk that tapers REARWARD into the serpentine tail.
	# Verify-agent fix: widest section moved forward (s2 = breast), rear
	# sections compressed ~30% so the body flows into the tail.
	# ============================================================================
	var body_y: float = clearance + h * 0.20
	var body_sections: Array = [
		{"center": Vector3(0, body_y - h * 0.02, -d * 0.25), "w": w * 0.22, "h": h * 0.24},  # rear-narrow (flows to tail)
		{"center": Vector3(0, body_y, -d * 0.08), "w": w * 0.36, "h": h * 0.36},             # mid-narrow
		{"center": Vector3(0, body_y + h * 0.05, d * 0.08), "w": w * 0.55, "h": h * 0.48},   # breast (widest, forward)
		{"center": Vector3(0, body_y + h * 0.12, d * 0.18), "w": w * 0.40, "h": h * 0.38},   # upper chest
		{"center": Vector3(0, body_y + h * 0.20, d * 0.22), "w": w * 0.28, "h": h * 0.30},   # neck base
	]
	_swept_body(root, body_sections, 10, primary, belly_color, 0.95, true)

	# ============================================================================
	# NECK — S-CURVED forward-leaning striking-serpent posture (verify-agent
	# fix: rooster-upright neck replaced with 2-segment forward kink).
	# ============================================================================
	var neck_base := (body_sections[4]["center"] as Vector3)
	# First segment leans forward + up (~15° forward at base)
	var neck_mid := Vector3(0, neck_base.y + h * 0.10, neck_base.z + d * 0.10)
	# Second segment angles back slightly toward head (~10° back at head)
	var neck_top := Vector3(0, neck_mid.y + h * 0.10, neck_mid.z + d * 0.04)
	_build_tapered_segment(root, neck_base, w * 0.22, neck_mid, w * 0.20,
		primary, 0.95)
	_build_tapered_segment(root, neck_mid, w * 0.20, neck_top, w * 0.22,
		primary, 0.95)

	# ============================================================================
	# HEAD — rooster head with comb, wattle, beak
	# ============================================================================
	var head_anchor := Vector3(0, neck_top.y + h * 0.08, neck_top.z + d * 0.06)
	var head_w: float = w * 0.30
	var head_h: float = h * 0.20
	var head_d: float = d * 0.30
	var head_y_bot: float = head_anchor.y - head_h * 0.40
	var head_y_top: float = head_y_bot + head_h
	var head_center_y: float = (head_y_bot + head_y_top) * 0.5
	_build_box(
		root,
		Vector3(-head_w, head_y_bot, head_anchor.z - head_d * 0.30),
		Vector3(head_w, head_y_top, head_anchor.z + head_d * 0.35),
		primary, 0.95
	)

	# COMB — red serrated crown on top of head (signature rooster)
	var comb_segments: int = int(round(5.0 * comb_size_jitter))
	for ci in range(comb_segments):
		var ct: float = float(ci) / float(comb_segments - 1)
		var comb_z: float = lerpf(head_anchor.z - head_d * 0.20,
			head_anchor.z + head_d * 0.20, ct)
		# Serrated peaks — alternating tall/short
		var peak_h: float = h * (0.10 if ci % 2 == 0 else 0.06)
		_build_box(
			root,
			Vector3(-w * 0.020, head_y_top - h * 0.005, comb_z - d * 0.025),
			Vector3(w * 0.020, head_y_top + peak_h * comb_size_jitter,
				comb_z + d * 0.025),
			comb_red, 0.80
		)

	# WATTLE — red flap hanging under the chin
	_build_box(
		root,
		Vector3(-w * 0.035, head_y_bot - h * 0.08,
			head_anchor.z + head_d * 0.20),
		Vector3(w * 0.035, head_y_bot + h * 0.005,
			head_anchor.z + head_d * 0.30),
		comb_red, 0.80
	)
	# Secondary wattle lobe
	_build_box(
		root,
		Vector3(-w * 0.060, head_y_bot - h * 0.060,
			head_anchor.z + head_d * 0.18),
		Vector3(w * 0.060, head_y_bot - h * 0.005,
			head_anchor.z + head_d * 0.26),
		comb_dark, 0.80
	)

	# GOLDEN EYES
	for side in [-1, 1]:
		_build_box(
			root,
			Vector3(side * head_w * 0.65 - w * 0.040,
				head_center_y, head_anchor.z + head_d * 0.18),
			Vector3(side * head_w * 0.65 + w * 0.040,
				head_center_y + h * 0.035, head_anchor.z + head_d * 0.28),
			eye_color, 0.20, 0.0
		)
		# Black pupil
		_build_box(
			root,
			Vector3(side * head_w * 0.65 - w * 0.012,
				head_center_y + h * 0.005, head_anchor.z + head_d * 0.25),
			Vector3(side * head_w * 0.65 + w * 0.012,
				head_center_y + h * 0.030, head_anchor.z + head_d * 0.28),
			Color(0.05, 0.04, 0.02), 0.30
		)

	# HOOKED BEAK — short curved chicken beak
	var beak_base_y: float = head_y_bot + h * 0.04
	var beak_base_z: float = head_anchor.z + head_d * 0.35
	# Upper beak — curves slightly down
	var ubBL := Vector3(-w * 0.06, beak_base_y, beak_base_z)
	var ubBR := Vector3(w * 0.06, beak_base_y, beak_base_z)
	var ubTL := Vector3(-w * 0.06, beak_base_y + h * 0.045, beak_base_z + d * 0.02)
	var ubTR := Vector3(w * 0.06, beak_base_y + h * 0.045, beak_base_z + d * 0.02)
	var ubTip := Vector3(0, beak_base_y - h * 0.025, beak_base_z + d * 0.16)
	var st_beak := SurfaceTool.new()
	st_beak.begin(Mesh.PRIMITIVE_TRIANGLES)
	_add_quad(st_beak, ubTL, ubTR, ubBR, ubBL)
	_add_tri(st_beak, ubBL, ubBR, ubTip)
	_add_tri(st_beak, ubTL, ubBL, ubTip)
	_add_tri(st_beak, ubTR, ubTL, ubTip)
	_add_tri(st_beak, ubBR, ubTR, ubTip)
	st_beak.generate_normals()
	var mi_beak := MeshInstance3D.new()
	mi_beak.mesh = st_beak.commit()
	var mat_beak := StandardMaterial3D.new()
	mat_beak.albedo_color = beak_color
	mat_beak.roughness = 0.40
	mat_beak.cull_mode = BaseMaterial3D.CULL_DISABLED
	mi_beak.material_override = mat_beak
	root.add_child(mi_beak)
	# Darker tip
	_build_box(
		root,
		Vector3(ubTip.x - w * 0.012, ubTip.y - h * 0.005, ubTip.z - d * 0.012),
		Vector3(ubTip.x + w * 0.012, ubTip.y + h * 0.012, ubTip.z + d * 0.005),
		beak_tip, 0.40
	)
	# Lower beak (smaller)
	_build_box(
		root,
		Vector3(-w * 0.045, beak_base_y - h * 0.035, beak_base_z),
		Vector3(w * 0.045, beak_base_y - h * 0.005, beak_base_z + d * 0.13),
		beak_color.darkened(0.10), 0.40
	)

	# ============================================================================
	# WINGS — bat-like leathery wings (signature non-bird wing on bird body)
	# ============================================================================
	for side in [-1, 1]:
		var wing_span: float = w * 1.8 * wing_open_jitter
		var wing_root := Vector3(side * w * 0.45, body_y + h * 0.15, 0.0)
		var wing_elbow := Vector3(side * (w * 0.45 + wing_span * 0.40),
			body_y + h * 0.25, -d * 0.05)
		var wing_peak := Vector3(side * (w * 0.45 + wing_span * 0.85),
			body_y + h * 0.15, -d * 0.18)
		_build_tapered_segment(root, wing_root, w * 0.06, wing_elbow, w * 0.045,
			feather_dark, 0.75)
		_build_tapered_segment(root, wing_elbow, w * 0.045, wing_peak, w * 0.020,
			feather_dark, 0.75)
		# Wing thumb claw at peak
		_build_tapered_segment(root, wing_peak, w * 0.020,
			wing_peak + Vector3(side * w * 0.05, h * 0.03, d * 0.02), w * 0.005,
			talon_color, 0.40)
		# 4 finger struts + small membrane
		var struts: int = 4
		var trails: Array = []
		for fi in range(struts):
			var ft: float = float(fi) / float(struts - 1)
			var trail := Vector3(
				lerpf(side * w * 0.40, side * (w * 0.45 + wing_span * 0.85), ft),
				body_y - h * lerpf(0.05, 0.0, ft),
				lerpf(-d * 0.25, -d * 0.15, ft)
			)
			trails.append(trail)
			_build_tapered_segment(root, wing_peak, w * 0.020, trail, w * 0.005,
				feather_dark, 0.75)
		# Membrane
		var st_w := SurfaceTool.new()
		st_w.begin(Mesh.PRIMITIVE_TRIANGLES)
		_add_quad(st_w, wing_root, wing_elbow,
			trails[1] as Vector3, trails[0] as Vector3)
		_add_quad(st_w, wing_elbow, wing_peak,
			trails[2] as Vector3, trails[1] as Vector3)
		_add_tri(st_w, wing_peak, trails[3] as Vector3, trails[2] as Vector3)
		st_w.generate_normals()
		var mi_w := MeshInstance3D.new()
		mi_w.mesh = st_w.commit()
		var mat_w := StandardMaterial3D.new()
		mat_w.albedo_color = feather_dark.lerp(primary, 0.3)
		mat_w.roughness = 0.75
		mat_w.cull_mode = BaseMaterial3D.CULL_DISABLED
		mi_w.material_override = mat_w
		root.add_child(mi_w)

	# ============================================================================
	# REPTILIAN ASP-TAIL — long serpentine 5-segment tail (~equal to body
	# length) with a small barb/STING at the tip per canon.
	# Verify-agent fix: extended from 3 segs to 5, spikes distributed full
	# length, sting added.
	# ============================================================================
	var tail_base := Vector3(0, body_y, -d * 0.30)
	# 5 control points along the tail spline (~1.4× body depth)
	var tail_pts: Array = [
		tail_base,
		Vector3(rng.randf_range(-w * 0.05, w * 0.05), body_y - h * 0.04, -d * 0.50),
		Vector3(rng.randf_range(-w * 0.10, w * 0.10), body_y - h * 0.10, -d * 0.78),
		Vector3(rng.randf_range(-w * 0.15, w * 0.15), body_y - h * 0.15, -d * 1.05),
		Vector3(rng.randf_range(-w * 0.20, w * 0.20), body_y - h * 0.18, -d * 1.32),
		Vector3(rng.randf_range(-w * 0.25, w * 0.25), body_y - h * 0.16, -d * 1.55),  # tip
	]
	# Radii taper from base to tip
	var tail_radii: Array = [
		w * 0.13, w * 0.10, w * 0.075, w * 0.050, w * 0.030, w * 0.015
	]
	for tsi in range(tail_pts.size() - 1):
		var col_a: Color = tail_scale if tsi < 2 else tail_scale_dark
		_build_tapered_segment(root,
			tail_pts[tsi] as Vector3, tail_radii[tsi] as float,
			tail_pts[tsi + 1] as Vector3, tail_radii[tsi + 1] as float,
			col_a, 0.50)
	# Distribute 8 dorsal spikes across the FULL tail length
	for ts in range(8):
		var tst: float = (float(ts) + 0.5) / 8.0
		var seg_t: float = tst * float(tail_pts.size() - 1)
		var seg_i: int = int(floor(seg_t))
		seg_i = min(seg_i, tail_pts.size() - 2)
		var inner_t: float = seg_t - float(seg_i)
		var ts_pos: Vector3 = (tail_pts[seg_i] as Vector3).lerp(
			tail_pts[seg_i + 1] as Vector3, inner_t)
		var ts_h: float = h * lerpf(0.06, 0.012, tst)
		_build_tapered_segment(root,
			ts_pos, w * 0.018,
			ts_pos + Vector3(0, ts_h, -h * 0.005), w * 0.004,
			tail_scale_dark, 0.55)
	# STING at the very tip — small flat barb pointing back/down
	var sting_root: Vector3 = tail_pts[tail_pts.size() - 1] as Vector3
	var sting_tip: Vector3 = sting_root + Vector3(0, -h * 0.04, -d * 0.10)
	_build_tapered_segment(root, sting_root, w * 0.022, sting_tip, w * 0.003,
		Color(0.18, 0.12, 0.08), 0.40)

	# ============================================================================
	# LEGS + TALONS — bird-of-prey style yellow legs with curved talons
	# ============================================================================
	for side in [-1, 1]:
		var leg_top := Vector3(side * w * 0.16, body_y - h * 0.15, 0.0)
		var leg_bot := Vector3(side * w * 0.16, body_y - h * 0.40, 0.0)
		# Feathered upper leg
		_build_tapered_segment(root, leg_top, w * 0.06, leg_bot, w * 0.04,
			primary, 0.95)
		# Bare scaled lower leg
		var foot_top := Vector3(side * w * 0.16, body_y - h * 0.58, 0.02)
		_build_tapered_segment(root, leg_bot, w * 0.035, foot_top, w * 0.028,
			beak_color, 0.60)
		# Foot pad
		_build_box(
			root,
			Vector3(side * w * 0.16 - w * 0.040, foot_top.y - h * 0.020,
				foot_top.z - d * 0.04),
			Vector3(side * w * 0.16 + w * 0.040, foot_top.y + h * 0.010,
				foot_top.z + d * 0.04),
			beak_color, 0.60
		)
		# 3 forward TALONS + 1 back talon (chicken-style)
		for ti in range(3):
			var to: float = (float(ti) - 1.0) * w * 0.035
			var lateral: float = side * (float(ti) - 1.0) * w * 0.015
			var toe_tip := Vector3(side * w * 0.16 + to + lateral,
				foot_top.y - h * 0.02,
				foot_top.z + d * 0.10)
			_build_tapered_segment(root,
				Vector3(side * w * 0.16 + to, foot_top.y - h * 0.005,
					foot_top.z + d * 0.02), w * 0.012,
				toe_tip, w * 0.003,
				beak_color, 0.50)
			# Curved black talon tip
			_build_tapered_segment(root, toe_tip, w * 0.006,
				toe_tip + Vector3(lateral * 0.5, -h * 0.025, d * 0.01), w * 0.002,
				talon_color, 0.40)
		# Back talon
		var back_toe := Vector3(side * w * 0.16, foot_top.y - h * 0.02,
			foot_top.z - d * 0.06)
		_build_tapered_segment(root,
			Vector3(side * w * 0.16, foot_top.y, foot_top.z - d * 0.01),
			w * 0.011,
			back_toe, w * 0.003,
			beak_color, 0.50)
		_build_tapered_segment(root, back_toe, w * 0.004,
			back_toe + Vector3(0, -h * 0.03, -d * 0.02),
			w * 0.002,
			talon_color, 0.40)
