class_name LowPolyMeshes
extends RefCounted

## Hand-authored low-poly creature meshes built with SurfaceTool.
##
## Why this exists: primitive composition (capsule body + capsule legs + sphere
## head) has a hard visual ceiling. A capsule will always look like a capsule.
## Real character requires explicit vertex placement so a wolf has a wolf
## silhouette — pointed muzzle, perky ears, lean elongated body, bushy tail.
##
## Each builder produces a SINGLE cohesive mesh covering body + head + legs +
## tail + ears. ProceduralCreatureBody calls these instead of the compositional
## path when has_mesh_for(sub_template) returns true. Ornaments + mutations
## are still added on top from the regular system.
##
## To add a new creature: write _build_<name>(plan, root) following the wolf
## pattern, append to SUPPORTED, add a match branch in build_for.

## Sub-templates with hand-authored low-poly meshes. Add the name here when
## you implement the builder. Sub-templates NOT in this list fall back to the
## procedural compositional system.
const SUPPORTED: Array[String] = [
	"wolf_like",
	"bear_like",
	"small_humanoid",
	"adult_dragon",
	"young_dragon",
	"ancient_dragon",
	"wyrmling",
	"wyvern",
	"insect_like",
	"dinosaur_like",
	"serpent_like",
	"serpent_humanoid",
	"brute_humanoid",
	"warrior_humanoid",
	"caster_humanoid",
	"satyr_humanoid",
	"bird_like",
	"bird_like_humanoid",
	"skeleton",
	"zombie",
	"floating_eye",
	"wraith_floating",
	"tiny_floating",
	# Elementals (one builder, branches on plan.meta.element_type)
	"elemental_humanoid",
	# Split off from bear_like so Pig/Mammoth get their own anatomy.
	"swine_like",
	# Fae
	"tiny_fey",
	# Small mammals: cat / rat / weasel / squirrel / hedgehog / skunk / mole
	"small_animal",
	"small_quadruped",
	# Reptiles: crocodile / monitor / komodo dragon
	"lizard_like",
	# Plant-creature
	"treant",
	# === A-LIST (per-species dedicated builders) ===
	"aboleth",
	"abominable_yeti",
